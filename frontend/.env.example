# NoClick frontend configuration — copy to frontend/.env and fill in.
# `make local` generates all of this for a local install; this file is for
# deploying yourself. Full reference: docs/self-hosting.md
#
# Anything prefixed VITE_ is compiled into the browser bundle — never put a
# secret in one.

# ── Required ─────────────────────────────────────────────────────────────

PORT=5173

# Marks this as the self-hosted edition (mirrors the backend's NOCLICK_LOCAL).
# Hides Google sign-in, which needs an OAuth provider configured in a hosted
# Supabase project, and skips the onboarding questionnaire. Unset it if you
# have configured Google in your own Supabase project and want the button.
VITE_NOCLICK_LOCAL=1

# This app's own public URL (used for OAuth redirects and email links).
VITE_PUBLIC_URL=http://127.0.0.1:5173

# Where the browser reaches the backend.
VITE_API_URL=http://127.0.0.1:8000
# Realtime endpoint: the backend's /relay path over ws:// or wss://.
VITE_RELAY_URL=ws://127.0.0.1:8000/relay
# Supabase project — the SAME project the backend points at.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Signs this app's session cookie. Any long random string.
SESSION_SECRET=

# Optional inbound-email trigger domain. Leave unset to hide that trigger.
# Must match backend INBOUND_EMAIL_DOMAIN and is compiled into the bundle.
VITE_INBOUND_EMAIL_DOMAIN=

# Bot protection on signup. Off unless you set a Turnstile site key — only
# needed if signup is exposed to the public internet (also enable captcha in
# your Supabase auth settings so the token is verified).
# VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=

# ── Integration OAuth (optional, one block per provider you use) ──────────
# The frontend STARTS the flow, so it needs the client ID and the redirect
# URI; the backend completes it with the client secret (backend/.env).
# Redirect URI convention: {VITE_PUBLIC_URL}/api/auth/{provider}/callback

# Required by the Pipedrive callback's server-side admin lookup. Never add a
# VITE_ prefix: that would compile this service-role secret into the browser.
# SUPABASE_SECRET_KEY=

# GOOGLE_CLIENT_ID=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/auth/google/callback
# SLACK_CLIENT_ID=
# SLACK_REDIRECT_URI=http://127.0.0.1:5173/api/auth/slack/callback
# LINEAR_CLIENT_ID=
# LINEAR_REDIRECT_URI=http://127.0.0.1:5173/api/auth/linear/callback
# NOTION_CLIENT_ID=
# NOTION_REDIRECT_URI=http://127.0.0.1:5173/api/auth/notion/callback
# GITHUB_CLIENT_ID=
# GITHUB_REDIRECT_URI=http://127.0.0.1:5173/api/auth/github/callback
