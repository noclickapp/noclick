{
  "name": "frontend",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build-sdk": "cd ../sdk/typescript && npm install && node build.js",
    "copy-sdk": "mkdir -p public/noclick-sdk && cp ../sdk/typescript/dist/sdk.esm.js public/noclick-sdk/sdk.esm.js",
    "build": "npm run build-sdk && npm run copy-sdk && react-router build",
    "dev": "npm run build-sdk && npm run copy-sdk && react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --write .",
    "start": "env-cmd react-router-serve ./build/server/index.js",
    "prod": "npm run build && npm run start",
    "env": "python generate_env.py",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky",
    "generate:types": "cd ../backend && python scripts/generate_socket_types.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:integration:ui": "vitest --config vitest.integration.config.ts --ui",
    "test:integration:run": "vitest run --config vitest.integration.config.ts --browser.headless",
    "test:perf": "playwright test",
    "test:perf:headed": "HEADED=1 playwright test",
    "build:widgets": "vite build --config widgets/vite.config.ts"
  },
