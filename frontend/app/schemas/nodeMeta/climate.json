{
  "oauthProviders": [
    {
      "provider": "climate",
      "authorizeUrl": "https://climate.com/static/app-login/index.html",
      "scopes": [
        "asApplied:read",
        "asHarvested:read",
        "asPlanted:read",
        "boundaries:write",
        "exports:read",
        "fields:read",
        "fields:write",
        "operations:read",
        "plantingActivitySummary:read",
        "resourceOwners:read",
        "scouting:read"
      ],
      "pkce": false,
      "clientIdEnv": "CLIMATE_CLIENT_ID",
      "clientSecretEnv": "CLIMATE_CLIENT_SECRET",
      "redirectUriEnv": "CLIMATE_REDIRECT_URI",
      "authorizeParams": {},
      "credentialType": "climate_oauth"
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-climate",
  "nodeMeta": {
    "agentToolProvider": true,
    "triggerOperations": [
      "on_updated_planting_activity",
      "on_updated_application_activity",
      "on_updated_harvest_activity"
    ]
  },
  "credentialTypes": {
    "Climate FieldView OAuth": "climate_oauth",
    "ClimateOAuthCredential": "climate_oauth"
  },
  "providerLabels": {
    "climate": "Climate FieldView OAuth"
  },
  "autoSelectCredential": true
