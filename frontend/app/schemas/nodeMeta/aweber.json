{
  "oauthProviders": [
    {
      "provider": "aweber",
      "authorizeUrl": "https://auth.aweber.com/oauth2/authorize",
      "scopes": [
        "account.read",
        "email.read",
        "email.write",
        "landing-page.read",
        "list.read",
        "list.write",
        "subscriber.read",
        "subscriber.write"
      ],
      "pkce": false,
      "clientIdEnv": "AWEBER_CLIENT_ID",
      "clientSecretEnv": "AWEBER_CLIENT_SECRET",
      "redirectUriEnv": "AWEBER_REDIRECT_URI",
      "authorizeParams": {},
      "credentialType": "aweber_oauth"
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-aweber",
  "nodeMeta": {
    "agentToolProvider": true,
    "triggerOperations": [
      "on_new_subscriber"
    ]
  },
  "credentialTypes": {
    "AWeberOAuthCredential": "aweber_oauth",
    "Aweber OAuth": "aweber_oauth"
  },
  "providerLabels": {
    "aweber": "AWeber Account"
  },
  "autoSelectCredential": true
}
