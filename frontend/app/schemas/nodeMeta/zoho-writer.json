{
  "oauthProviders": [
    {
      "provider": "zoho_writer",
      "authorizeUrl": "https://accounts.zoho.com/oauth/v2/auth",
      "scopes": [
        "WorkDrive.files.ALL",
        "WorkDrive.organization.ALL",
        "WorkDrive.team.READ",
        "WorkDrive.users.READ",
        "WorkDrive.workspace.ALL",
        "ZohoSearch.securesearch.READ",
        "ZohoWriter.documentEditor.ALL"
      ],
      "pkce": false,
      "clientIdEnv": "ZOHO_WRITER_CLIENT_ID",
      "clientSecretEnv": "ZOHO_WRITER_CLIENT_SECRET",
      "redirectUriEnv": "ZOHO_WRITER_REDIRECT_URI",
      "authorizeParams": {
        "access_type": "offline",
        "prompt": "consent"
      },
      "credentialType": "zoho_writer_oauth",
      "scopeSeparator": ","
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-zoho-writer",
  "nodeMeta": {
    "agentToolProvider": true,
    "triggerOperations": [
      "on_new_or_updated_document"
    ]
  },
  "credentialTypes": {
    "Zoho Writer OAuth": "zoho_writer_oauth",
    "ZohoWriterOAuthCredential": "zoho_writer_oauth"
  },
  "providerLabels": {
    "zoho_writer": "Zoho Writer OAuth"
  },
  "autoSelectCredential": true
}
