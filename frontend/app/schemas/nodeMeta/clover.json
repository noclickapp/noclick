{
  "oauthProviders": [
    {
      "provider": "clover",
      "authorizeUrl": "https://www.{clover_domain}/oauth/v2/authorize",
      "scopes": [],
      "pkce": false,
      "clientIdEnv": "CLOVER_CLIENT_ID",
      "clientSecretEnv": "CLOVER_CLIENT_SECRET",
      "redirectUriEnv": "CLOVER_REDIRECT_URI",
      "authorizeParams": {},
      "credentialType": "clover_oauth",
      "contextFields": {
        "clover_domain": {
          "source": "input",
          "pattern": null,
          "choices": [
            "clover.com",
            "eu.clover.com",
            "la.clover.com"
          ],
          "kind": "host",
          "label": "Clover Region",
          "callbackName": null
        },
        "merchant_id": {
          "source": "callback",
          "pattern": "[A-Za-z0-9_-]+",
          "choices": [],
          "kind": "value",
          "label": null,
          "callbackName": null
        }
      }
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-clover",
  "nodeMeta": {
    "agentToolProvider": true,
    "triggerOperations": [
      "on_new_or_updated_order",
      "on_new_or_updated_item"
    ]
  },
  "credentialTypes": {
    "Clover API Token": "clover_api_token",
    "Clover OAuth": "clover_oauth",
    "CloverAPIKeyCredential": "clover_api_token",
    "CloverOAuthCredential": "clover_oauth"
  },
  "providerLabels": {
    "clover": "Clover Account"
  },
  "autoSelectCredential": true
}
