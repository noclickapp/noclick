{
  "oauthProviders": [
    {
      "provider": "egnyte",
      "authorizeUrl": "https://{account_host}/puboauth/token",
      "scopes": [
        "Egnyte.filesystem",
        "Egnyte.link",
        "Egnyte.webhooks"
      ],
      "pkce": false,
      "clientIdEnv": "EGNYTE_CLIENT_ID",
      "clientSecretEnv": "EGNYTE_CLIENT_SECRET",
      "redirectUriEnv": "EGNYTE_REDIRECT_URI",
      "authorizeParams": {},
      "credentialType": "egnyte_oauth",
      "contextFields": {
        "account_host": {
          "source": "input",
          "pattern": "[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.egnyte\\.com",
          "choices": [],
          "kind": "host",
          "label": "Egnyte account host",
          "callbackName": null
        }
      }
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-egnyte",
  "nodeMeta": {
    "agentToolProvider": true,
    "triggerOperations": [
      "on_file_uploaded"
    ]
  },
  "credentialTypes": {
    "Egnyte MCP": "egnyte_mcp",
    "Egnyte OAuth": "egnyte_oauth",
    "EgnyteMcpCredential": "egnyte_mcp",
    "EgnyteOAuthCredential": "egnyte_oauth"
  },
  "providerLabels": {
    "egnyte": "Egnyte Account"
  },
  "autoSelectCredential": true
}
