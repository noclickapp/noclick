{
  "oauthProviders": [
    {
      "provider": "miro",
      "authorizeUrl": "https://miro.com/oauth/authorize",
      "scopes": [
        "boards:read",
        "boards:write"
      ],
      "pkce": false,
      "clientIdEnv": "MIRO_CLIENT_ID",
      "clientSecretEnv": "MIRO_CLIENT_SECRET",
      "redirectUriEnv": "MIRO_REDIRECT_URI",
      "authorizeParams": {},
      "credentialType": "miro_oauth"
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-miro",
  "nodeMeta": {
    "agentToolProvider": true,
    "triggerOperations": [
      "on_new_board",
      "on_new_or_updated_board"
    ]
  },
  "credentialTypes": {
    "Miro MCP": "miro_mcp",
    "Miro OAuth": "miro_oauth",
    "MiroMcpCredential": "miro_mcp",
    "MiroOAuthCredential": "miro_oauth"
  },
  "providerLabels": {
    "miro": "Miro Account"
  },
  "autoSelectCredential": true
}
