{
  "oauthProviders": [
    {
      "provider": "dynatrace",
      "authorizeUrl": "https://sso.dynatrace.com/oauth2/authorize",
      "scopes": [
        "account-audit-logs-read",
        "account-env-read",
        "account-idm-read",
        "account-idm-write",
        "account-uac-read",
        "iam-policies-management",
        "offline_access",
        "openid",
        "profile"
      ],
      "pkce": true,
      "clientIdEnv": "DYNATRACE_CLIENT_ID",
      "clientSecretEnv": "DYNATRACE_CLIENT_SECRET",
      "redirectUriEnv": "DYNATRACE_REDIRECT_URI",
      "authorizeParams": {},
      "credentialType": "dynatrace_oauth",
      "contextFields": {
        "account_uuid": {
          "source": "input",
          "pattern": "[A-Za-z0-9][A-Za-z0-9_-]{0,127}",
          "choices": [],
          "kind": "value",
          "label": "Account UUID",
          "callbackName": null
        }
      }
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-dynatrace",
  "nodeMeta": {
    "agentToolProvider": true,
    "triggerOperations": [
      "on_new_audit_event"
    ]
  },
  "credentialTypes": {
    "Dynatrace OAuth": "dynatrace_oauth",
    "DynatraceOAuthCredential": "dynatrace_oauth"
  },
  "providerLabels": {
    "dynatrace": "Dynatrace OAuth"
  },
  "autoSelectCredential": true
}
