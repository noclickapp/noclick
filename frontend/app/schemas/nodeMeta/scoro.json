{
  "oauthProviders": [
    {
      "provider": "scoro",
      "authorizeUrl": "https://{site_host}/auth/oauth/authorize",
      "scopes": [
        "base:r",
        "contacts:r",
        "contacts:rw",
        "invoices:r",
        "invoices:rw",
        "offline_access",
        "projects:r",
        "projects:rw",
        "quotes:r",
        "quotes:rw",
        "tasks:r",
        "tasks:rw"
      ],
      "pkce": true,
      "clientIdEnv": "SCORO_CLIENT_ID",
      "clientSecretEnv": "SCORO_CLIENT_SECRET",
      "redirectUriEnv": "SCORO_REDIRECT_URI",
      "authorizeParams": {},
      "credentialType": "scoro_oauth",
      "contextFields": {
        "site_host": {
          "source": "input",
          "pattern": "[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.scoro\\.com",
          "choices": [],
          "kind": "host",
          "label": "Scoro site host (acme.scoro.com)",
          "callbackName": null
        },
        "company_account_id": {
          "source": "input",
          "pattern": "[A-Za-z0-9_-]{1,128}",
          "choices": [],
          "kind": "value",
          "label": "Company account ID (Settings > Integrations > API)",
          "callbackName": null
        }
      }
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-scoro",
  "nodeMeta": {
    "agentToolProvider": true
  },
  "credentialTypes": {
    "Scoro OAuth": "scoro_oauth",
    "ScoroOAuthCredential": "scoro_oauth"
  },
  "providerLabels": {
    "scoro": "Scoro OAuth"
  },
  "autoSelectCredential": true
}
