{
  "oauthProviders": [
    {
      "provider": "figma",
      "authorizeUrl": "https://www.figma.com/oauth",
      "scopes": [
        "current_user:read",
        "file_comments:read",
        "file_comments:write",
        "file_content:read",
        "file_dev_resources:read",
        "file_dev_resources:write",
        "file_metadata:read",
        "file_versions:read",
        "library_content:read",
        "webhooks:read",
        "webhooks:write"
      ],
      "pkce": true,
      "clientIdEnv": "FIGMA_CLIENT_ID",
      "clientSecretEnv": "FIGMA_CLIENT_SECRET",
      "redirectUriEnv": "FIGMA_REDIRECT_URI",
      "authorizeParams": {},
      "credentialType": "figma_oauth"
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-figma",
  "nodeMeta": {
    "agentToolProvider": true
  },
  "credentialTypes": {
    "Figma OAuth": "figma_oauth",
    "Figma Personal Access Token": "figma_pat",
    "FigmaOAuthCredential": "figma_oauth",
    "FigmaPATCredential": "figma_pat"
  },
  "providerLabels": {
    "figma": "Figma Account"
  },
  "autoSelectCredential": true
}
