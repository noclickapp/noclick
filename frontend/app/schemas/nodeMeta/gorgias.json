{
  "oauthProviders": [
    {
      "provider": "gorgias",
      "authorizeUrl": "https://{subdomain}/oauth/authorize",
      "scopes": [
        "account:read",
        "account:write",
        "custom_fields:read",
        "custom_fields:write",
        "customers:read",
        "customers:write",
        "email",
        "events:read",
        "integrations:read",
        "integrations:write",
        "jobs:read",
        "jobs:write",
        "macros:read",
        "macros:write",
        "offline",
        "openid",
        "profile",
        "rules:read",
        "rules:write",
        "satisfaction_survey:read",
        "satisfaction_survey:write",
        "statistics:read",
        "tags:read",
        "tags:write",
        "tickets:read",
        "tickets:write",
        "users:read",
        "users:write"
      ],
      "pkce": false,
      "clientIdEnv": "GORGIAS_CLIENT_ID",
      "clientSecretEnv": "GORGIAS_CLIENT_SECRET",
      "redirectUriEnv": "GORGIAS_REDIRECT_URI",
      "authorizeParams": {},
      "credentialType": "gorgias_oauth",
      "contextFields": {
        "subdomain": {
          "source": "input",
          "pattern": "[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.gorgias\\.com",
          "choices": [],
          "kind": "host",
          "label": "Gorgias account host (acme.gorgias.com)",
          "callbackName": null
        }
      }
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-gorgias",
  "nodeMeta": {
    "agentToolProvider": true
  },
  "credentialTypes": {
    "Gorgias API Key": "gorgias_api_key",
    "Gorgias MCP": "gorgias_mcp",
    "Gorgias OAuth": "gorgias_oauth",
    "GorgiasApiKeyCredential": "gorgias_api_key",
    "GorgiasMcpCredential": "gorgias_mcp",
    "GorgiasOAuthCredential": "gorgias_oauth"
  },
  "providerLabels": {
    "gorgias": "Gorgias Account"
  },
  "autoSelectCredential": true
}
