{
  "oauthProviders": [
    {
      "provider": "zoho_inventory",
      "authorizeUrl": "{accounts}/oauth/v2/auth",
      "scopes": [
        "AaaServer.profile.READ",
        "ZohoInventory.FullAccess.all",
        "email"
      ],
      "pkce": false,
      "clientIdEnv": "ZOHO_INVENTORY_CLIENT_ID",
      "clientSecretEnv": "ZOHO_INVENTORY_CLIENT_SECRET",
      "redirectUriEnv": "ZOHO_INVENTORY_REDIRECT_URI",
      "authorizeParams": {
        "access_type": "offline",
        "prompt": "consent"
      },
      "credentialType": "zoho_inventory_oauth",
      "contextFields": {
        "accounts": {
          "source": "input",
          "pattern": null,
          "choices": [
            "https://accounts.zoho.com",
            "https://accounts.zoho.eu",
            "https://accounts.zoho.in",
            "https://accounts.zoho.com.au",
            "https://accounts.zoho.jp",
            "https://accounts.zoho.sa",
            "https://accounts.zohocloud.ca",
            "https://accounts.zoho.com.cn"
          ],
          "kind": "origin",
          "label": "Data Center",
          "callbackName": null
        },
        "accounts_server": {
          "source": "callback",
          "pattern": null,
          "choices": [
            "https://accounts.zoho.com",
            "https://accounts.zoho.eu",
            "https://accounts.zoho.in",
            "https://accounts.zoho.com.au",
            "https://accounts.zoho.jp",
            "https://accounts.zoho.sa",
            "https://accounts.zohocloud.ca",
            "https://accounts.zoho.com.cn"
          ],
          "kind": "origin",
          "label": null,
          "callbackName": "accounts-server"
        },
        "api_domain": {
          "source": "token",
          "pattern": null,
          "choices": [
            "https://www.zohoapis.ca",
            "https://www.zohoapis.com",
            "https://www.zohoapis.com.au",
            "https://www.zohoapis.com.cn",
            "https://www.zohoapis.eu",
            "https://www.zohoapis.in",
            "https://www.zohoapis.jp",
            "https://www.zohoapis.sa"
          ],
          "kind": "origin",
          "label": null,
          "callbackName": null
        }
      },
      "scopeSeparator": ","
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-zoho-inventory",
  "nodeMeta": {
    "agentToolProvider": true,
    "triggerOperations": [
      "on_item_created_or_updated",
      "on_sales_order_created_or_updated",
      "on_purchase_order_created_or_updated",
      "on_invoice_created_or_updated"
    ]
  },
  "credentialTypes": {
    "Zoho Inventory OAuth": "zoho_inventory_oauth",
    "ZohoInventoryOAuthCredential": "zoho_inventory_oauth"
  },
  "providerLabels": {
    "zoho_inventory": "Zoho Inventory OAuth"
  },
  "autoSelectCredential": true
}
