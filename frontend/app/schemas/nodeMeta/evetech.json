{
  "oauthProviders": [
    {
      "provider": "evetech",
      "authorizeUrl": "https://login.eveonline.com/v2/oauth/authorize",
      "scopes": [
        "esi-assets.read_assets.v1",
        "esi-calendar.read_calendar_events.v1",
        "esi-calendar.respond_calendar_events.v1",
        "esi-location.read_location.v1",
        "esi-location.read_ship_type.v1",
        "esi-mail.organize_mail.v1",
        "esi-mail.read_mail.v1",
        "esi-mail.send_mail.v1",
        "esi-skills.read_skillqueue.v1",
        "esi-skills.read_skills.v1",
        "esi-ui.write_waypoint.v1",
        "esi-wallet.read_character_wallet.v1"
      ],
      "pkce": false,
      "clientIdEnv": "EVETECH_CLIENT_ID",
      "clientSecretEnv": "EVETECH_CLIENT_SECRET",
      "redirectUriEnv": "EVETECH_REDIRECT_URI",
      "authorizeParams": {},
      "credentialType": "evetech_oauth",
      "contextFields": {
        "character_id": {
          "source": "input",
          "pattern": "[1-9][0-9]{0,18}",
          "choices": [],
          "kind": "value",
          "label": "Character ID (choose this character during EVE sign-in)",
          "callbackName": null
        }
      }
    }
  ],
  "$comment": "Auto-generated by backend/scripts/generate_socket_types.py \u2014 do not edit.",
  "type": "automation-evetech",
  "nodeMeta": {
    "agentToolProvider": true,
    "triggerOperations": [
      "on_new_mail"
    ]
  },
  "credentialTypes": {
    "EVE Swagger Interface OAuth": "evetech_oauth",
    "EvetechOAuthCredential": "evetech_oauth"
  },
  "providerLabels": {
    "evetech": "EVE Swagger Interface OAuth"
  },
  "autoSelectCredential": true
}
