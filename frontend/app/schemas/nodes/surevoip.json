        },
        {
          "$ref": "#/$defs/SureVoIPListMobileAccounts"
        },
        {
          "$ref": "#/$defs/SureVoIPListPartners"
        },
        {
          "$ref": "#/$defs/SureVoIPListPortedNumbers"
        },
        {
          "$ref": "#/$defs/SureVoIPGetServiceStatus"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/SureVoIPCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
