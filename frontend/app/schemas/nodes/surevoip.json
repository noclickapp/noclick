{
  "$defs": {
    "AnnouncementAudio": {
      "additionalProperties": false,
      "properties": {
        "announcement_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Announcement Id",
          "type": "string"
        }
      },
      "required": [
        "announcement_id"
      ],
      "title": "AnnouncementAudio",
      "type": "object"
    },
    "CallOptions": {
      "additionalProperties": false,
      "properties": {
        "a_leg_only": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "A Leg Only"
        },
        "a_leg_caller_id": {
          "anyOf": [
            {
              "maxLength": 32,
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "A Leg Caller Id"
        },
        "connect_key": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connect Key"
        },
        "cancel_key": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancel Key"
        },
        "play_audio": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/AnnouncementAudio"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Play Audio"
        }
      },
      "title": "CallOptions",
      "type": "object"
    },
    "CreateCall": {
      "description": "Ring the from party first, then connect them to the to party.",
      "properties": {
        "operation": {
          "const": "create_call",
          "default": "create_call",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Calls",
          "x-display-name": "Create Phone Call",
          "x-is-trigger": false
        },
        "from_number": {
          "description": "First party to ring (a leg), for example 442035159999.",
          "maxLength": 32,
          "pattern": "^[0-9]+$",
          "title": "From Number",
          "type": "string"
        },
        "to_number": {
          "description": "Second party to ring (b leg), for example 442035159995.",
          "maxLength": 32,
          "pattern": "^[0-9]+$",
          "title": "To Number",
          "type": "string"
        },
        "caller_id": {
          "description": "Caller ID shown to the second party.",
          "maxLength": 32,
          "pattern": "^[0-9]+$",
          "title": "Caller ID",
          "type": "string"
        },
        "announcement_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds after answer to play the announcement.",
          "title": "Announcement At"
        },
        "announcement_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Announcement Id"
        },
        "hangup_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds after answer to hang up.",
          "title": "Hangup At"
        },
        "hangup_announcement_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hangup Announcement Id"
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "from_number",
        "to_number",
        "caller_id"
      ],
      "title": "CreateCall",
      "type": "object"
    },
    "SureVoIPCredential": {
      "properties": {
        "credential_type": {
          "const": "surevoip_basic",
          "default": "surevoip_basic",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "username": {
          "description": "Your SureVoIP API username.",
          "maxLength": 256,
          "minLength": 1,
          "title": "API Username",
          "type": "string"
        },
        "password": {
          "description": "Your SureVoIP API password.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Password",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "title": "Surevoip Account",
      "type": "object",
      "x-credential-instructions": "Enter your SureVoIP API username and password for HTTP Basic authentication. Use the credentials supplied by SureVoIP for API access. NoClick sends them only to api.surevoip.co.uk and reads your customer account location to check the connection.",
      "x-credential-url": "https://www.surevoip.co.uk/support/wiki/api_documentation"
    },
    "SureVoIPGetAnnouncement": {
      "properties": {
        "operation": {
          "const": "get_announcement",
          "default": "get_announcement",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Announcements",
          "x-display-name": "Get Announcement",
          "x-is-trigger": false
        },
        "account": {
          "minimum": 1,
          "title": "Customer Account ID",
          "type": "integer"
        },
        "announcement_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Announcement ID",
          "type": "string"
        }
      },
      "required": [
        "account",
        "announcement_id"
      ],
      "title": "SureVoIPGetAnnouncement",
      "type": "object"
    },
    "SureVoIPGetCustomer": {
      "properties": {
