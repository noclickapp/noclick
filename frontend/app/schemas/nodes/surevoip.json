  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_call": "#/$defs/CreateCall",
          "get_announcement": "#/$defs/SureVoIPGetAnnouncement",
          "get_customer": "#/$defs/SureVoIPGetCustomer",
          "get_service_status": "#/$defs/SureVoIPGetServiceStatus",
          "list_announcements": "#/$defs/SureVoIPListAnnouncements",
          "list_areacodes": "#/$defs/SureVoIPListAreacodes",
          "list_billing": "#/$defs/SureVoIPListBilling",
          "list_charges": "#/$defs/SureVoIPListCharges",
          "list_contacts": "#/$defs/SureVoIPListContacts",
          "list_customer_announcements": "#/$defs/SureVoIPListCustomerAnnouncements",
          "list_customers": "#/$defs/SureVoIPListCustomers",
          "list_hosted_domains": "#/$defs/SureVoIPListHostedDomains",
          "list_mobile_accounts": "#/$defs/SureVoIPListMobileAccounts",
          "list_numbers": "#/$defs/SureVoIPListNumbers",
          "list_partners": "#/$defs/SureVoIPListPartners",
          "list_ported_numbers": "#/$defs/SureVoIPListPortedNumbers",
          "list_sip_accounts": "#/$defs/SureVoIPListSipAccounts",
          "list_sms": "#/$defs/SureVoIPListSms",
          "list_topups": "#/$defs/SureVoIPListTopups"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CreateCall"
        },
        {
          "$ref": "#/$defs/SureVoIPListSms"
        },
        {
          "$ref": "#/$defs/SureVoIPListCustomers"
        },
        {
          "$ref": "#/$defs/SureVoIPGetCustomer"
        },
        {
