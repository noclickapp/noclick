    "BatchEnrichCompanies": {
      "additionalProperties": false,
      "description": "Enrich one to fifty domains in one request; may consume credits.",
      "properties": {
        "expand": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "financial",
                  "keywords",
                  "naicsCodes",
                  "technologies",
                  "workforce"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Additional company data to include",
          "title": "Expand"
        },
        "operation": {
          "const": "batch_enrich_companies",
          "default": "batch_enrich_companies",
          "title": "Operation",
          "type": "string"
        },
        "domains": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Domains",
          "type": "array"
        },
        "wait_for_enrichment": {
          "default": true,
          "title": "Wait For Enrichment",
          "type": "boolean"
        }
      },
      "required": [
        "domains"
      ],
      "title": "BatchEnrichCompanies",
      "type": "object"
    },
