            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The name of the customer",
          "title": "Name"
        },
        "email": {
          "description": "The email of the customer",
          "format": "email",
          "title": "Email",
          "type": "string"
        },
        "phone_number": {
          "description": "The phone number of the customer",
          "title": "Phone Number",
          "type": "string"
        },
        "phone_number_country_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The country code of the phone number",
          "title": "Phone Number Country Code"
        },
        "remark": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The remark of the customer",
          "title": "Remark"
        },
        "birth_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
