    "HitpayCreatePaymentRequestConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_payment_request",
          "default": "create_payment_request",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "amount": {
          "anyOf": [
            {
              "maximum": 999999999.99,
              "minimum": 0.3,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "It's optional field. Amount related to the payment. Example: 2500. If we pass, it should be greater than 0.3 and less than 999999999.99",
          "title": "Amount"
        },
        "currency": {
          "description": "It's required field. Currency related to the payment.",
          "maxLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "payment_methods": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "They're available payment methods supported on your account.(Example: paynow_online , card, wechat, alipay, grabpay_direct, grabpay_paylater, shopee_pay ... etc.). If we don't pass, use the available methods",
          "title": "Payment Methods"
        },
        "email": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Buyer\u2019s email",
          "title": "Email"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Buyer\u2019s name",
          "title": "Name"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Buyer\u2019s phone number and should be in E.164 format. Example: +6591234567",
          "title": "Phone"
        },
        "wifi_terminal_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "It's terminal id and it's required if payment method is wifi_card_reader",
          "title": "Wifi Terminal Id"
        },
        "staff_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "It's active staff id from the dashboard",
          "title": "Staff Id"
        },
        "location_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The active location belongs to business. Support both `location_id` and `business_location_id` for backward compatibility, but we recommend using `business_location_id` for future use.",
          "title": "Location Id"
        },
        "business_location_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The active location belongs to business.",
          "title": "Business Location Id"
        },
        "purpose": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Purpose of the Payment request.",
          "title": "Purpose"
        },
        "reference_number": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arbitrary reference number that you can map to your internal reference number. This value cannot be edited by the customer",
          "title": "Reference Number"
        },
        "redirect_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 1028,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL where we redirect the user after a payment. Query arguments reference (payment request id) and status are sent along",
          "title": "Redirect Url"
        },
        "webhook": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL where our server do POST request after a payment If done",
          "title": "Webhook"
        },
        "allow_repeated_payments": {
          "anyOf": [
            {
              "enum": [
                "true",
                "false"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If set to true, multiple payments can be paid on a payment request link. Default value is false",
          "title": "Allow Repeated Payments",
          "enum": [
            "true",
            "false"
          ],
          "x-enum-searchable": true
        },
        "expiry_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time after which the payment link will be expired (time in SG with YYYY-MM-DD HH:mm:ss format). Applicable for repeated payments.",
          "title": "Expiry Date"
        },
        "expires_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "E.g \"30 mins\" Other supported keys are \"mins\", \"hours\", \"days\"",
          "title": "Expires After"
        },
        "send_email": {
          "anyOf": [
            {
              "enum": [
                "true",
                "false"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "It's \"true\" or \"false\". If set to true, an email receipt will be sent to the customer after the payment is completed. Default is false",
          "title": "Send Email",
          "enum": [
            "true",
            "false"
          ],
          "x-enum-searchable": true
        },
        "send_sms": {
          "anyOf": [
            {
              "enum": [
                "true",
                "false"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "It's \"true\" or \"false\". If set to \"true\", SMS will be sent to the customer after the payment is completed. Default is false",
          "title": "Send Sms",
          "enum": [
            "true",
            "false"
          ],
          "x-enum-searchable": true
        },
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/HitpayAddress0"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generate_qr": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only valid for paynow_online, qrph_netbank and shopee_pay if generate_qr was true",
          "title": "Generate Qr"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Support the key-value. The value must be string type, and the max length of the value is 500 characters, up to 50 key-value. Example: {\"car_model\": \"toyota\", \"car_color\": \"red\"}",
          "title": "Metadata"
        }
      },
      "required": [
        "currency"
      ],
      "title": "HitpayCreatePaymentRequestConfig",
      "type": "object"
    },
    "HitpayCreateRefundConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_refund",
          "default": "create_refund",
