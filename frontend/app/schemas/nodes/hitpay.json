          "default": "list_charges",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "per_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
