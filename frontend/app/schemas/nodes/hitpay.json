              "type": "null"
            }
          ],
          "default": null,
          "description": "The webhook URL",
          "title": "Webhook"
        },
        "send_email": {
          "anyOf": [
            {
              "enum": [
                "true",
                "false"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Send Email",
          "enum": [
            "true",
            "false"
          ],
          "x-enum-searchable": true
        },
        "email": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        }
      },
      "required": [
        "amount",
        "payment_id"
      ],
      "title": "HitpayCreateRefundConfig",
      "type": "object"
    },
