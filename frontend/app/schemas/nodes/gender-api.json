{
  "$defs": {
    "GenderApiTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "gender_api_token",
          "default": "gender_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Gender API Token",
      "type": "object",
      "x-credential-instructions": "Open your Gender-API account's Auth Tokens page, create or copy an API token, and paste it here. NoClick uses it as a Bearer token. Connection checks read your account's usage statistics without spending query credits.",
      "x-credential-url": "https://gender-api.com/en/account/auth-tokens"
    },
    "GenderBatchEmails": {
      "additionalProperties": false,
      "description": "Extract names and query multiple email addresses in a single request.",
      "properties": {
        "entries_json": {
          "description": "JSON array, for example [{\"email\":\"sandra.miller14@gmail.com\",\"country\":\"US\",\"id\":\"1\"}]. Up to 100 entries per call.",
          "title": "Entries Json",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "operation": {
          "const": "query_emails_batch",
          "default": "query_emails_batch",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "entries_json"
      ],
      "title": "GenderBatchEmails",
      "type": "object"
    },
    "GenderBatchFirstNames": {
      "additionalProperties": false,
      "description": "Query gender for multiple first names in a single request.",
      "properties": {
        "entries_json": {
          "description": "JSON array, for example [{\"first_name\":\"sandra\",\"country\":\"US\",\"id\":\"1\"}]. Up to 100 entries per call.",
          "title": "Entries Json",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "operation": {
          "const": "query_first_names_batch",
          "default": "query_first_names_batch",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "entries_json"
      ],
      "title": "GenderBatchFirstNames",
      "type": "object"
    },
    "GenderBatchFullNames": {
      "additionalProperties": false,
      "description": "Split and query multiple full names in a single request.",
      "properties": {
        "entries_json": {
          "description": "JSON array, for example [{\"full_name\":\"Sandra Miller\",\"country\":\"US\",\"id\":\"1\"}]. Up to 100 entries per call.",
          "title": "Entries Json",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "operation": {
          "const": "query_full_names_batch",
          "default": "query_full_names_batch",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "entries_json"
      ],
      "title": "GenderBatchFullNames",
      "type": "object"
    },
    "GenderByEmail": {
      "additionalProperties": false,
      "description": "Extract a name from an email address and query gender.",
      "properties": {
        "country": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional ISO 3166 alpha-2 country code, for example US.",
          "title": "Country"
        },
        "locale": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional browser locale, for example en_US.",
          "title": "Locale"
        },
        "ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional IPv4 or IPv6 address for localization.",
          "title": "Ip"
        },
        "email": {
          "maxLength": 100,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "operation": {
          "const": "query_email",
          "default": "query_email",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "email"
      ],
      "title": "GenderByEmail",
      "type": "object"
    },
    "GenderByFirstName": {
      "additionalProperties": false,
      "description": "Query gender from one first name, optionally localized.",
      "properties": {
        "country": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional ISO 3166 alpha-2 country code, for example US.",
          "title": "Country"
        },
        "locale": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional browser locale, for example en_US.",
          "title": "Locale"
        },
        "ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional IPv4 or IPv6 address for localization.",
          "title": "Ip"
        },
        "first_name": {
          "maxLength": 50,
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        },
        "operation": {
          "const": "query_first_name",
          "default": "query_first_name",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "first_name"
      ],
      "title": "GenderByFirstName",
      "type": "object"
    },
    "GenderByFullName": {
      "additionalProperties": false,
      "description": "Split one full name and query gender.",
      "properties": {
        "country": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional ISO 3166 alpha-2 country code, for example US.",
          "title": "Country"
        },
        "locale": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional browser locale, for example en_US.",
          "title": "Locale"
        },
        "ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional IPv4 or IPv6 address for localization.",
          "title": "Ip"
        },
        "full_name": {
          "maxLength": 100,
          "minLength": 3,
          "title": "Full Name",
          "type": "string"
        },
        "operation": {
          "const": "query_full_name",
          "default": "query_full_name",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "full_name"
      ],
      "title": "GenderByFullName",
      "type": "object"
    },
    "GetStatistics": {
      "additionalProperties": false,
      "description": "Read this account's remaining credits, limit status and last month's usage (free).",
      "properties": {
        "operation": {
          "const": "get_statistics",
          "default": "get_statistics",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetStatistics",
      "type": "object"
    },
    "OriginByEmail": {
      "additionalProperties": false,
      "description": "Query likely countries of origin and gender from an email address (two credits).",
      "properties": {
        "operation": {
          "const": "query_origin_email",
          "default": "query_origin_email",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "maxLength": 100,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "OriginByEmail",
      "type": "object"
    },
    "OriginByFirstName": {
      "additionalProperties": false,
      "description": "Query likely countries of origin and gender from a first name (two credits).",
      "properties": {
        "operation": {
          "const": "query_origin_first_name",
          "default": "query_origin_first_name",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "first_name": {
          "maxLength": 50,
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        }
      },
      "required": [
        "first_name"
      ],
      "title": "OriginByFirstName",
      "type": "object"
    },
    "OriginByFullName": {
      "additionalProperties": false,
      "description": "Query likely countries of origin and gender from a full name (two credits).",
      "properties": {
        "operation": {
          "const": "query_origin_full_name",
          "default": "query_origin_full_name",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "full_name": {
          "maxLength": 100,
          "minLength": 3,
          "title": "Full Name",
          "type": "string"
        }
      },
      "required": [
        "full_name"
      ],
      "title": "OriginByFullName",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_statistics": "#/$defs/GetStatistics",
          "query_email": "#/$defs/GenderByEmail",
          "query_emails_batch": "#/$defs/GenderBatchEmails",
          "query_first_name": "#/$defs/GenderByFirstName",
          "query_first_names_batch": "#/$defs/GenderBatchFirstNames",
          "query_full_name": "#/$defs/GenderByFullName",
          "query_full_names_batch": "#/$defs/GenderBatchFullNames",
          "query_origin_email": "#/$defs/OriginByEmail",
          "query_origin_first_name": "#/$defs/OriginByFirstName",
          "query_origin_full_name": "#/$defs/OriginByFullName"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GenderByFirstName"
        },
        {
          "$ref": "#/$defs/GenderByFullName"
        },
        {
          "$ref": "#/$defs/GenderByEmail"
        },
        {
          "$ref": "#/$defs/GenderBatchFirstNames"
        },
        {
          "$ref": "#/$defs/GenderBatchFullNames"
        },
        {
          "$ref": "#/$defs/GenderBatchEmails"
        },
        {
          "$ref": "#/$defs/OriginByFirstName"
        },
        {
          "$ref": "#/$defs/OriginByFullName"
        },
        {
          "$ref": "#/$defs/OriginByEmail"
        },
        {
          "$ref": "#/$defs/GetStatistics"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/GenderApiTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Gender-api Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Enrich a new contact by full name",
    "Query a batch of email addresses",
    "Alert me when remaining query credits are low"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
