    "ListFills": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 100,
          "description": "One page only; pass next_after to after to continue.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "after": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "operation": {
          "const": "list_fills",
          "default": "list_fills",
          "title": "Operation",
          "type": "string"
        },
        "product_id": {
          "description": "Product to reconcile, for example BTC-USD.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Product Id",
