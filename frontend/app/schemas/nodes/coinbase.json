        },
        {
          "$ref": "#/$defs/ListFills"
        },
        {
          "$ref": "#/$defs/GetFees"
        },
        {
          "$ref": "#/$defs/ListProducts"
        },
        {
          "$ref": "#/$defs/GetProduct"
        },
        {
          "$ref": "#/$defs/GetTicker"
        },
        {
          "$ref": "#/$defs/GetStats"
        },
        {
          "$ref": "#/$defs/GetOrderBook"
        },
        {
          "$ref": "#/$defs/ListCurrencies"
        },
        {
          "$ref": "#/$defs/GetCurrency"
        },
        {
          "$ref": "#/$defs/ListProfiles"
        },
        {
          "$ref": "#/$defs/GetProfile"
        },
        {
          "$ref": "#/$defs/ListPaymentMethods"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoinbaseExchangeCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Coinbase Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
