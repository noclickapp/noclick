          "list_orders": "#/$defs/ListOrders",
          "list_payment_methods": "#/$defs/ListPaymentMethods",
          "list_products": "#/$defs/ListProducts",
          "list_profiles": "#/$defs/ListProfiles"
        },
        "propertyName": "operation"
      },
      "oneOf": [
