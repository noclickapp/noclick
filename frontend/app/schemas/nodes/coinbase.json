{
  "$defs": {
    "CancelOrder": {
      "additionalProperties": false,
      "description": "Cancel one open order; fills may race with cancellation.",
      "properties": {
        "operation": {
          "const": "cancel_order",
          "default": "cancel_order",
          "title": "Operation",
          "type": "string"
        },
        "order_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Order Id",
          "type": "string"
        },
        "product_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Id"
        }
      },
      "required": [
        "order_id"
      ],
      "title": "CancelOrder",
      "type": "object"
    },
    "CoinbaseExchangeCredential": {
      "properties": {
        "credential_type": {
          "const": "coinbase_exchange_api_key",
          "default": "coinbase_exchange_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_secret": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API secret",
          "type": "string",
          "ui:help": "Paste the base64 secret exactly as Coinbase Exchange issued it.",
          "ui:widget": "password"
        },
        "passphrase": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Passphrase",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key",
        "api_secret",
        "passphrase"
      ],
      "title": "Coinbase Exchange API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Coinbase Exchange API key, base64 secret and passphrase. These are Exchange credentials, not a CDP private key or Advanced Trade key. Enable View for account reads and connection verification, and Trade for order creation/cancellation. No transfer permission is needed. Requests go only to api.exchange.coinbase.com. Account reads prove access to the key's profile, not write permissions or access to every portfolio.",
      "x-credential-url": "https://exchange.coinbase.com/profile/api"
    },
    "CreateOrder": {
      "additionalProperties": false,
      "description": "Place a limit order. An accepted order does not mean it has filled.",
      "properties": {
        "operation": {
          "const": "create_order",
          "default": "create_order",
          "title": "Operation",
          "type": "string"
        },
        "product_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Product Id",
          "type": "string"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "title": "Side",
          "type": "string"
        },
        "price": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Price",
          "type": "string"
        },
        "size": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Size",
          "type": "string"
        },
        "client_oid": {
          "description": "Your unique UUID for reconciling an uncertain order outcome before retrying.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Client Oid",
          "type": "string"
        },
        "post_only": {
          "default": false,
          "title": "Post Only",
          "type": "boolean"
        }
      },
      "required": [
        "product_id",
        "side",
        "price",
        "size",
        "client_oid"
      ],
      "title": "CreateOrder",
      "type": "object"
    },
