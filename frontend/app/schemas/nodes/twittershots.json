{
  "$defs": {
    "GetAPIUsage": {
      "additionalProperties": false,
      "description": "Read the remaining requests and total quota for the supplied API key.",
      "properties": {
        "operation": {
          "const": "get_api_usage",
          "default": "get_api_usage",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetAPIUsage",
      "type": "object"
    },
    "GetTweetScreenshot": {
      "additionalProperties": false,
      "description": "Generate a public tweet screenshot as a file or temporary hosted URL.",
      "properties": {
        "operation": {
          "const": "get_tweet_screenshot",
          "default": "get_tweet_screenshot",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "tweet_id": {
          "description": "Paste the numeric status ID or an HTTPS Twitter/X status URL.",
          "examples": [
            "1981415642981888505"
          ],
          "maxLength": 2048,
          "pattern": "^(?:[0-9]{1,32}|https://(?:www\\.)?(?:x|twitter)\\.com/(?:[A-Za-z0-9_]+|i/web)/status/[0-9]{1,32}/?(?:\\?[^#\\s]*)?(?:#[^\\s]*)?)$",
          "title": "Tweet ID or URL",
          "type": "string"
        },
        "format": {
          "default": "svg",
          "enum": [
            "svg",
            "png",
            "html"
          ],
          "title": "Output format",
          "type": "string"
        },
        "theme": {
          "default": "light",
          "enum": [
            "light",
            "dark"
          ],
          "title": "Theme",
          "type": "string"
        },
        "return_type": {
          "default": "buffer",
          "description": "buffer returns a file. url returns a temporary hosted URL that may be removed by TwitterShots; save the file for permanent storage.",
          "enum": [
            "buffer",
            "url"
          ],
          "title": "Return type",
          "type": "string"
        }
      },
      "required": [
        "tweet_id"
      ],
      "title": "GetTweetScreenshot",
      "type": "object"
    },
    "TwittershotsAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "twittershots_api_key",
          "default": "twittershots_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Twittershots API Key",
      "type": "object",
      "x-credential-instructions": "Paste your TwitterShots API key from Account Settings. NoClick sends it in the X-API-KEY header to api.twittershots.com. Connecting reads your remaining quota; it does not generate a screenshot or identify your Twitter/X account.",
      "x-credential-url": "https://twittershots.com/settings/keys"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_api_usage": "#/$defs/GetAPIUsage",
          "get_tweet_screenshot": "#/$defs/GetTweetScreenshot"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetTweetScreenshot"
        },
        {
          "$ref": "#/$defs/GetAPIUsage"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TwittershotsAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Twittershots Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
