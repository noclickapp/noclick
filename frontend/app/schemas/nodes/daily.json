        "operation": {
          "const": "get_recording_link",
          "default": "get_recording_link",
          "title": "Operation",
          "type": "string"
        },
        "valid_for_secs": {
          "default": 3600,
          "description": "Requested lifetime. Daily may cap it for customer S3 storage; the returned expires is authoritative.",
          "maximum": 43200,
          "minimum": 900,
          "title": "Valid For Secs",
          "type": "integer"
        }
      },
      "required": [
        "recording_id"
      ],
      "title": "DailyRecordingLink",
      "type": "object"
