        "operation": {
          "const": "list_meeting_participants",
          "default": "list_meeting_participants",
          "title": "Operation",
          "type": "string"
        },
        "limit": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "joined_after": {
