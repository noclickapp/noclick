  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_meeting_token": "#/$defs/DailyCreateMeetingToken",
          "create_room": "#/$defs/DailyCreateRoom",
          "delete_recording": "#/$defs/DailyDeleteRecording",
