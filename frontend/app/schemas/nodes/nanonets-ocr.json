{
  "$defs": {
    "ClassifyFile": {
      "additionalProperties": false,
      "description": "Classify one uploaded image with a trained classification model.",
      "properties": {
        "model_id": {
          "description": "Copy the model ID from Nanonets model settings.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Model ID",
          "type": "string"
        },
        "file_reference": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A PNG, JPEG or PDF workflow file reference, public URL or data URI. Supply this or inline base64 bytes.",
          "title": "File Reference"
        },
        "file_base64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Alternatively, provide base64 file bytes instead of an upload or file reference.",
          "format": "byte",
          "title": "Inline File Base64"
        },
        "mime_type": {
          "default": "application/pdf",
          "enum": [
            "application/pdf",
            "image/png",
            "image/jpeg"
          ],
          "title": "Inline File Type",
          "type": "string"
        },
        "filename": {
          "default": "document.pdf",
          "maxLength": 255,
          "title": "Inline Filename",
          "type": "string"
        },
        "operation": {
          "const": "classify_file",
          "default": "classify_file",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "model_id"
      ],
      "title": "ClassifyFile",
      "type": "object"
    },
    "ClassifyUrls": {
