          "title": "Code",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "typescript"
        },
        "timeout_sec": {
          "default": 60,
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Sec",
          "type": "integer"
        },
        "executor": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Calls with the same executor name share state and run sequentially.",
          "title": "Executor"
        }
      },
      "required": [
        "browser_id",
        "code"
      ],
      "title": "ExecutePlaywright",
      "type": "object"
    },
