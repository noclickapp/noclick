    "ExecutePlaywright": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "execute_playwright",
          "default": "execute_playwright",
          "title": "Execute Playwright Code",
          "type": "string"
        },
        "browser_id": {
          "minLength": 1,
