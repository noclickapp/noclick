{
  "$defs": {
    "CreateBrowser": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_browser",
          "default": "create_browser",
          "title": "Create Browser Session",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9._-]{1,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "start_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL to open. Navigation is best effort; session creation does not prove the page loaded.",
          "title": "Start Url"
        },
        "timeout_seconds": {
          "default": 60,
          "description": "Inactivity timeout in seconds.",
          "maximum": 259200,
          "minimum": 10,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "headless": {
          "default": false,
          "title": "Headless",
          "type": "boolean"
        },
        "stealth": {
          "default": false,
          "title": "Stealth",
          "type": "boolean"
        },
        "region": {
          "anyOf": [
            {
              "enum": [
                "us-east",
                "us-west",
                "eu-west",
                "ap-southeast"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Region selection requires a Start-Up or Enterprise plan.",
          "title": "Region",
          "enum": [
            "us-east",
            "us-west",
            "eu-west",
            "ap-southeast"
          ],
          "x-enum-searchable": true
        },
        "profile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing profile ID to load.",
          "title": "Profile Id"
        },
        "save_changes": {
          "default": false,
          "description": "Save session changes back to the selected profile when it ends.",
          "title": "Save Changes",
          "type": "boolean"
        },
        "proxy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing proxy ID in the same project.",
          "title": "Proxy Id"
        }
      },
      "title": "CreateBrowser",
      "type": "object"
    },
    "CreateProfile": {
