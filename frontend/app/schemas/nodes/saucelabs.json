{
  "$defs": {
    "ApplySettings": {
      "additionalProperties": false,
      "description": "Change orientation and optional Android locale/animations during an ACTIVE session.",
      "properties": {
        "session_id": {
          "description": "Device session ID returned by Create Session or List Sessions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "operation": {
          "const": "apply_settings",
          "default": "apply_settings",
          "title": "Operation",
          "type": "string"
        },
        "orientation": {
          "enum": [
            "PORTRAIT",
            "LANDSCAPE"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "locale": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Android only, e.g. en_US.",
          "title": "Locale"
        },
        "animations": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Android only.",
          "title": "Animations"
        }
      },
      "required": [
        "session_id",
        "orientation"
      ],
      "title": "ApplySettings",
      "type": "object"
    },
    "CloseSession": {
      "additionalProperties": false,
      "description": "Release a device session; CLOSING is an acknowledgement, not completed cleanup.",
      "properties": {
        "session_id": {
          "description": "Device session ID returned by Create Session or List Sessions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "operation": {
          "const": "close_session",
          "default": "close_session",
          "title": "Operation",
          "type": "string"
        },
        "reboot_device": {
          "default": false,
          "description": "Reboot after release; private devices only.",
          "title": "Reboot Device",
          "type": "boolean"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "CloseSession",
      "type": "object"
    },
    "CreateSession": {
      "additionalProperties": false,
      "description": "Allocate a device; poll Get Session until ACTIVE before interacting. Uses your device quota.",
      "properties": {
        "operation": {
          "const": "create_session",
          "default": "create_session",
          "title": "Operation",
          "type": "string"
        },
        "device_name": {
          "description": "Device descriptor or name (regex supported).",
          "maxLength": 512,
          "minLength": 1,
          "title": "Device Name",
          "type": "string"
        },
        "os": {
          "anyOf": [
            {
              "enum": [
                "android",
                "ios"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Os",
          "enum": [
            "android",
            "ios"
          ],
          "x-enum-searchable": true
        },
        "session_duration": {
          "default": "PT1H",
          "description": "ISO-8601 duration up to 24 hours. Provider may close sessions over 6 hours early.",
          "pattern": "^PT(?:(?:[1-9]|1[0-9]|2[0-3])H(?:[0-5]?[0-9]M)?|[1-5]?[0-9]M|24H)$",
          "title": "Session Duration",
          "type": "string"
        },
        "tunnel_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tunnel Name"
        },
        "tunnel_owner": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tunnel Owner"
        }
      },
      "required": [
        "device_name"
      ],
      "title": "CreateSession",
      "type": "object"
    },
    "ExecuteShellCommand": {
      "additionalProperties": false,
      "description": "Execute a short Android adb shell command without the adb shell prefix.",
      "properties": {
        "session_id": {
          "description": "Device session ID returned by Create Session or List Sessions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "operation": {
          "const": "execute_shell_command",
          "default": "execute_shell_command",
          "title": "Operation",
          "type": "string"
        },
        "command": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Command",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "command"
      ],
      "title": "ExecuteShellCommand",
      "type": "object"
    },
    "GetAppium": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "description": "Device session ID returned by Create Session or List Sessions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "operation": {
          "const": "get_appium",
          "default": "get_appium",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "GetAppium",
      "type": "object"
    },
    "GetSession": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "description": "Device session ID returned by Create Session or List Sessions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "operation": {
          "const": "get_session",
          "default": "get_session",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "GetSession",
      "type": "object"
    },
    "InstallApp": {
      "additionalProperties": false,
      "description": "Start a background app installation; poll List App Installations for completion.",
      "properties": {
        "session_id": {
          "description": "Device session ID returned by Create Session or List Sessions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "operation": {
          "const": "install_app",
          "default": "install_app",
          "title": "Operation",
          "type": "string"
        },
        "app": {
          "description": "Sauce App Storage reference, e.g. storage:filename=myapp.apk.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "App",
          "type": "string"
        },
        "enable_instrumentation": {
          "default": true,
          "description": "Includes iOS re-signing; recommended by Sauce Labs.",
          "title": "Enable Instrumentation",
          "type": "boolean"
        },
        "launch_after_install": {
          "default": false,
          "title": "Launch After Install",
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "app"
      ],
      "title": "InstallApp",
      "type": "object"
    },
    "ListAppInstallations": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "description": "Device session ID returned by Create Session or List Sessions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "operation": {
          "const": "list_app_installations",
          "default": "list_app_installations",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "ListAppInstallations",
      "type": "object"
    },
    "ListDeviceStatus": {
      "additionalProperties": false,
      "description": "Read live device availability; public devices have aggregated states.",
      "properties": {
        "operation": {
          "const": "list_device_status",
          "default": "list_device_status",
          "title": "Operation",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "AVAILABLE",
                "IN_USE",
                "CLEANING",
                "REBOOTING",
                "MAINTENANCE",
                "OFFLINE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State",
          "enum": [
            "AVAILABLE",
            "IN_USE",
            "CLEANING",
            "REBOOTING",
            "MAINTENANCE",
            "OFFLINE"
          ],
          "x-enum-searchable": true
        },
        "private_only": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Private Only"
        },
        "device_name": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Name"
        }
      },
      "title": "ListDeviceStatus",
      "type": "object"
    },
    "ListDevices": {
      "additionalProperties": false,
      "description": "List device descriptors available to your account.",
      "properties": {
        "operation": {
          "const": "list_devices",
          "default": "list_devices",
          "title": "Operation",
          "type": "string"
        },
        "device_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Device descriptor or name filter; supports regex.",
          "title": "Device Id"
        }
      },
      "title": "ListDevices",
      "type": "object"
    },
    "ListSessions": {
      "additionalProperties": false,
      "description": "Read pending, active and recently closed sessions for the authenticated account.",
      "properties": {
        "operation": {
          "const": "list_sessions",
          "default": "list_sessions",
          "title": "Operation",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "PENDING",
                "CREATING",
                "ACTIVE",
                "CLOSING",
                "CLOSED",
                "ERRORED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State",
          "enum": [
            "PENDING",
            "CREATING",
            "ACTIVE",
            "CLOSING",
            "CLOSED",
            "ERRORED"
          ],
          "x-enum-searchable": true
        },
        "device_name": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Name"
        }
      },
      "title": "ListSessions",
      "type": "object"
    },
    "OpenUrl": {
      "additionalProperties": false,
      "description": "Open a URL or iOS deep link on an ACTIVE device; Android uses Chrome.",
      "properties": {
        "session_id": {
          "description": "Device session ID returned by Create Session or List Sessions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "operation": {
          "const": "open_url",
          "default": "open_url",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "url"
      ],
      "title": "OpenUrl",
      "type": "object"
    },
    "SauceLabsAccessKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "saucelabs_access_key",
          "default": "saucelabs_access_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "username": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Username",
          "type": "string"
        },
        "access_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Access key",
          "type": "string",
          "ui:widget": "password"
        },
        "region": {
          "default": "us-west-1",
          "enum": [
            "us-west-1",
            "eu-central-1",
            "us-east-4"
          ],
          "title": "Data center",
          "type": "string"
        }
      },
      "required": [
        "username",
        "access_key"
      ],
      "title": "Sauce Labs Access Key",
      "type": "object",
      "x-credential-instructions": "Copy your username and access key from Account > User Settings and choose your account's data center. Real Device Access API v2 is an open beta; ask your Sauce Labs representative to enable access. Connection testing reads your device sessions.",
      "x-credential-url": "https://app.saucelabs.com/user-settings"
    },
    "StartAppium": {
      "additionalProperties": false,
      "description": "Start the hosted Appium server for this device session.",
      "properties": {
        "session_id": {
          "description": "Device session ID returned by Create Session or List Sessions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "operation": {
          "const": "start_appium",
          "default": "start_appium",
          "title": "Operation",
          "type": "string"
        },
        "appium_version": {
          "default": "latest",
          "maxLength": 64,
          "title": "Appium Version",
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "StartAppium",
      "type": "object"
    },
    "TakeScreenshot": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "description": "Device session ID returned by Create Session or List Sessions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "operation": {
          "const": "take_screenshot",
          "default": "take_screenshot",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "TakeScreenshot",
      "type": "object"
    },
    "UninstallApp": {
      "additionalProperties": false,
      "description": "Uninstall the specified iOS bundle or Android package from this device.",
      "properties": {
        "session_id": {
          "description": "Device session ID returned by Create Session or List Sessions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "operation": {
          "const": "uninstall_app",
          "default": "uninstall_app",
          "title": "Operation",
          "type": "string"
        },
        "platform": {
          "default": "android",
          "enum": [
            "android",
            "ios"
          ],
          "title": "Platform",
          "type": "string"
        },
        "app_id": {
          "description": "Android package name or iOS bundle identifier.",
          "maxLength": 512,
          "minLength": 1,
          "title": "App Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "app_id"
      ],
      "title": "UninstallApp",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "apply_settings": "#/$defs/ApplySettings",
          "close_session": "#/$defs/CloseSession",
          "create_session": "#/$defs/CreateSession",
          "execute_shell_command": "#/$defs/ExecuteShellCommand",
          "get_appium": "#/$defs/GetAppium",
          "get_session": "#/$defs/GetSession",
          "install_app": "#/$defs/InstallApp",
          "list_app_installations": "#/$defs/ListAppInstallations",
          "list_device_status": "#/$defs/ListDeviceStatus",
          "list_devices": "#/$defs/ListDevices",
          "list_sessions": "#/$defs/ListSessions",
          "open_url": "#/$defs/OpenUrl",
          "start_appium": "#/$defs/StartAppium",
          "take_screenshot": "#/$defs/TakeScreenshot",
          "uninstall_app": "#/$defs/UninstallApp"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListDevices"
        },
        {
          "$ref": "#/$defs/ListDeviceStatus"
        },
        {
          "$ref": "#/$defs/CreateSession"
        },
        {
          "$ref": "#/$defs/ListSessions"
        },
        {
          "$ref": "#/$defs/GetSession"
        },
        {
          "$ref": "#/$defs/CloseSession"
        },
        {
          "$ref": "#/$defs/ExecuteShellCommand"
        },
        {
          "$ref": "#/$defs/OpenUrl"
        },
        {
          "$ref": "#/$defs/InstallApp"
        },
        {
          "$ref": "#/$defs/ListAppInstallations"
        },
        {
          "$ref": "#/$defs/UninstallApp"
        },
        {
          "$ref": "#/$defs/ApplySettings"
        },
        {
          "$ref": "#/$defs/TakeScreenshot"
        },
        {
          "$ref": "#/$defs/StartAppium"
        },
        {
          "$ref": "#/$defs/GetAppium"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/SauceLabsAccessKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Saucelabs Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
