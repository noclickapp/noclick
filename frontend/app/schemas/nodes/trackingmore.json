{
  "$defs": {
    "DetectCouriers": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "detect_couriers",
          "default": "detect_couriers",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Couriers",
          "x-display-name": "Detect Possible Couriers",
          "x-is-trigger": false
        },
        "tracking_number": {
          "description": "Read-semantic detection only; no shipment is registered and no match is automatically selected.",
          "title": "Tracking Number",
          "type": "string"
        }
      },
      "required": [
        "tracking_number"
      ],
      "title": "DetectCouriers",
      "type": "object"
    },
    "GetTrackingResult": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_limit": {
          "default": 0,
          "description": "0 omits checkpoints. Selected checkpoints include date/status/country only; names, addresses, contact details and free-form event text stay omitted.",
          "maximum": 50,
          "minimum": 0,
          "title": "Checkpoints per Origin/Destination",
          "type": "integer"
        },
        "courier_code": {
          "title": "Courier",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "courier_code",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "get_tracking_result",
          "default": "get_tracking_result",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Existing Shipments",
          "x-display-name": "Get One Existing Shipment Result",
          "x-is-trigger": false
        },
        "tracking_number": {
          "title": "Existing Tracking Number",
          "type": "string"
        }
      },
      "required": [
        "courier_code",
        "tracking_number"
      ],
      "title": "GetTrackingResult",
      "type": "object"
    },
    "GetTrackingResults": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_limit": {
          "default": 0,
          "description": "0 omits checkpoints. Selected checkpoints include date/status/country only; names, addresses, contact details and free-form event text stay omitted.",
          "maximum": 50,
          "minimum": 0,
          "title": "Checkpoints per Origin/Destination",
          "type": "integer"
        },
        "courier_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Courier",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "courier_code",
            "searchable": true
          }
        },
        "operation": {
          "const": "get_tracking_results",
          "default": "get_tracking_results",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Existing Shipments",
          "x-display-name": "Get Selected Existing Shipment Results",
          "x-is-trigger": false
        },
        "tracking_numbers": {
          "description": "1\u201340 distinct comma-separated tracking numbers; unrestricted account exports are not offered.",
          "maxLength": 4040,
          "title": "Existing Tracking Numbers",
          "type": "string",
          "ui:widget": "textarea"
        },
        "delivery_status": {
          "anyOf": [
            {
              "enum": [
                "pending",
                "notfound",
                "transit",
                "pickup",
                "delivered",
                "expired",
                "undelivered",
                "exception",
                "inforeceived"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Status",
          "enum": [
            "pending",
            "notfound",
            "transit",
            "pickup",
            "delivered",
            "expired",
            "undelivered",
            "exception",
            "inforeceived"
          ],
          "x-enum-searchable": true
        },
        "items_amount": {
          "default": 100,
          "maximum": 200,
          "minimum": 1,
          "title": "Native Items per Page",
          "type": "integer"
        },
        "pages_amount": {
          "default": 1,
          "description": "The exact V4 parameter is pages_amount. No total or has_more contract is documented.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Native Page Number",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For full native pages only. Same API key and query required; the candidate does not prove another page exists.",
          "title": "Bound Next-Page Candidate"
        }
      },
      "required": [
        "tracking_numbers"
      ],
      "title": "GetTrackingResults",
      "type": "object"
    },
    "ListCouriers": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_couriers",
          "default": "list_couriers",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Couriers",
          "x-display-name": "List Supported Couriers",
          "x-is-trigger": false
        },
        "limit": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Local Page Size",
          "type": "integer"
        },
        "search": {
          "default": "",
          "maxLength": 100,
          "title": "Courier Name or Code Contains",
          "type": "string"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Re-fetches and compares the complete catalog; no provider paging is invented.",
          "title": "Local Continuation"
        }
      },
      "title": "ListCouriers",
      "type": "object"
    },
    "OnNewOrUpdatedShipment": {
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_or_updated_shipment",
          "default": "on_new_or_updated_shipment",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On New or Updated Shipment",
          "x-is-trigger": true
        },
        "updated_date_min": {
          "description": "Update-time window, for example 2022-09-10T10:40:34+08:00. Use a recent time; TrackingMore retains 180 days.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+[0-9]{2}:[0-9]{2}$",
          "title": "Updated Since",
          "type": "string"
        },
        "courier_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Courier",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "courier_code",
            "searchable": true
          }
        }
      },
      "required": [
        "updated_date_min"
      ],
      "title": "OnNewOrUpdatedShipment",
      "type": "object",
      "x-requires-webhook": true
    },
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    },
    "TrackingMoreAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "trackingmore_api_key",
          "default": "trackingmore_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 8,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "TrackingMore API Key",
      "type": "object",
      "x-credential-instructions": "Supply an existing authorized TrackingMore V4 API key. It is sent only in Tracking-Api-Key, not the retired V2 header or URL. Courier discovery proves protected reachability, not your tenant or human identity. Existing shipment reads and polling require shipments already registered in your account; this node never registers a tracking or performs a paid real-time probe. Actual access, plan and quotas remain subject to your account.",
      "x-credential-url": "https://www.trackingmore.com/docs/trackingmore/"
    }
  },
  "properties": {
    "config": {
      "discriminator": {
        "mapping": {
          "detect_couriers": "#/$defs/DetectCouriers",
          "get_tracking_result": "#/$defs/GetTrackingResult",
          "get_tracking_results": "#/$defs/GetTrackingResults",
          "list_couriers": "#/$defs/ListCouriers",
          "on_new_or_updated_shipment": "#/$defs/OnNewOrUpdatedShipment"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListCouriers"
        },
        {
          "$ref": "#/$defs/DetectCouriers"
        },
        {
          "$ref": "#/$defs/GetTrackingResult"
        },
        {
          "$ref": "#/$defs/GetTrackingResults"
        },
        {
          "$ref": "#/$defs/OnNewOrUpdatedShipment"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrackingMoreAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "config"
  ],
  "title": "Trackingmore Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
