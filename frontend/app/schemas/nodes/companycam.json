        "limit": {
          "default": 50,
          "description": "Maximum records in this page.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "after": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cursor from the previous response's meta; leave blank for the first page.",
          "title": "After"
        },
        "operation": {
          "const": "list_project_photos",
          "default": "list_project_photos",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ListProjectPhotos",
      "type": "object"
