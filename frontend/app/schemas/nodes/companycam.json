        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "photo_id",
        "content"
      ],
      "title": "CreatePhotoComment",
      "type": "object"
    },
    "CreateProject": {
      "additionalProperties": false,
      "description": "Create a project with its required address. CompanyCam may return an existing matching project.",
      "properties": {
        "operation": {
          "const": "create_project",
          "default": "create_project",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "street_address_1": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Street Address 1",
          "type": "string"
        },
        "city": {
          "maxLength": 200,
          "minLength": 1,
          "title": "City",
          "type": "string"
        },
        "state": {
          "maxLength": 200,
          "minLength": 1,
          "title": "State",
          "type": "string"
        },
        "postal_code": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Postal Code",
          "type": "string"
        },
        "country": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Country",
          "type": "string"
        },
        "customer_id": {
          "anyOf": [
            {
              "maxLength": 32,
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Id"
        }
      },
      "required": [
        "name",
        "street_address_1",
        "city",
        "state",
        "postal_code",
        "country"
      ],
      "title": "CreateProject",
      "type": "object"
    },
    "CreateProjectComment": {
      "additionalProperties": false,
      "description": "Add a comment to a project.",
      "properties": {
        "project_id": {
          "maxLength": 32,
          "pattern": "^[1-9][0-9]*$",
