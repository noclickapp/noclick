{
  "$defs": {
    "ArchiveProject": {
      "additionalProperties": false,
      "description": "Archive a project.",
      "properties": {
        "project_id": {
          "maxLength": 32,
          "pattern": "^[1-9][0-9]*$",
          "title": "Project ID",
          "type": "string"
        },
        "operation": {
          "const": "archive_project",
          "default": "archive_project",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ArchiveProject",
      "type": "object"
    },
    "CompanycamPersonalAccessToken": {
      "properties": {
        "credential_type": {
          "const": "companycam_personal_access_token",
          "default": "companycam_personal_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Personal access token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "Companycam Personal Access Token",
      "type": "object",
      "x-credential-instructions": "In CompanyCam on the web, open Integrations > Access Tokens > New Personal Access Token. Choose Read & Write for create and update actions, then copy the token. Paste only the token, without Bearer. Tokens expire according to the expiration you choose; replace an expired token here.",
      "x-credential-url": "https://help.companycam.com/en/articles/14724612-creating-access-tokens-and-application-keys"
    },
    "CreateCustomer": {
      "additionalProperties": false,
      "description": "Create a customer with optional contact details.",
      "properties": {
        "operation": {
          "const": "create_customer",
          "default": "create_customer",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "phone_number": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone Number"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateCustomer",
      "type": "object"
    },
    "CreatePhotoComment": {
      "additionalProperties": false,
      "description": "Add a comment to a photo.",
