  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/IlertCheckConfig",
          "get_incident": "#/$defs/IlertGetIncidentConfig",
          "get_service": "#/$defs/IlertGetServiceConfig",
          "get_team": "#/$defs/IlertGetTeamConfig",
          "list_incidents": "#/$defs/IlertIncidentsConfig",
          "list_services": "#/$defs/IlertServicesConfig",
          "list_status_pages": "#/$defs/IlertStatusPagesConfig",
          "list_teams": "#/$defs/IlertTeamsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/IlertCheckConfig"
        },
        {
          "$ref": "#/$defs/IlertTeamsConfig"
        },
        {
          "$ref": "#/$defs/IlertGetTeamConfig"
        },
        {
          "$ref": "#/$defs/IlertServicesConfig"
        },
        {
          "$ref": "#/$defs/IlertGetServiceConfig"
        },
