        },
        {
          "$ref": "#/$defs/IlertGetIncidentConfig"
        },
        {
          "$ref": "#/$defs/IlertStatusPagesConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/IlertAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
