        "team_id": {
          "maxLength": 19,
          "minLength": 1,
          "title": "Team Id",
          "type": "string",
          "x-dynamic-options": {
            "field": "team_id",
            "auto_select_sole_option": true
          }
        },
        "service_id": {
          "description": "Current service whose documented team references include the selected team.",
