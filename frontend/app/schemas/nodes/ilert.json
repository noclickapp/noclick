{
  "$defs": {
    "IlertAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "ilert_api_key",
          "default": "ilert_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "description": "Supply the existing user REST key alone, not an Events integrationKey. Sent only in the Bearer header.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Existing ilert User REST API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "actor_id": {
          "description": "Existing private numeric ID from GET /users/current. Each operation verifies the actual actor; this is not a tenant ID.",
          "maxLength": 19,
          "minLength": 1,
          "title": "Expected Current User ID",
          "type": "string"
        },
        "team_context": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit for all VIEW-permitted resources independent of UI selection. Header 0 means ALL teams, -1 MY teams, a positive ID selects a team. Catalog access does not establish membership.",
          "title": "Optional Team Context"
        }
      },
      "required": [
        "access_token",
        "actor_id"
      ],
      "title": "IlertAPIKeyCredential",
      "type": "object",
      "x-credential-instructions": "Use an existing user REST API key and its actual current-user ID. No key creation or OAuth flow. REST Bearer authentication differs from Events integrationKey and Basic login context.",
      "x-credential-url": "https://docs.ilert.com/developer-docs/rest-api/api-reference/introduction/authentication"
    },
    "IlertCheckConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to resource names and incident titles. IDs/status/time are returned by default.",
          "title": "Include Names",
          "type": "boolean"
        },
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "IlertCheckConfig",
      "type": "object"
    },
    "IlertGetIncidentConfig": {
