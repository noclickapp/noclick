          "minLength": 1,
          "title": "Service Id",
          "type": "string",
          "x-dynamic-options": {
            "depends_on": "team_id",
            "field": "service_id"
          }
        },
        "operation": {
          "const": "get_incident",
          "default": "get_incident",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "incident_id": {
          "description": "Witnessed in the current service-filtered incident catalog; detail must include the selected affected service.",
          "maxLength": 19,
          "minLength": 1,
          "title": "Incident Id",
          "type": "string",
          "x-dynamic-options": {
            "depends_on": "service_id",
            "field": "incident_id"
          }
        }
      },
      "required": [
        "team_id",
        "service_id",
        "incident_id"
      ],
      "title": "IlertGetIncidentConfig",
      "type": "object"
    },
