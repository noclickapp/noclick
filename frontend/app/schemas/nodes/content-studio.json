{
  "$defs": {
    "ContentStudioAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "content_studio_api_key",
          "default": "content_studio_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Content Studio API Key",
      "type": "object",
      "x-credential-instructions": "In ContentStudio, open the API module, generate an API key on the API tab, and paste it here. NoClick sends it in the X-API-Key header and reads your workspaces to check the connection.",
      "x-credential-url": "https://docs.contentstudio.io/articles/contentstudio-api-f955a6ab"
    },
    "CreateCampaign": {
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Workspace Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "color": {
          "description": "Provider palette token: color_1 through color_20.",
          "pattern": "^color_([1-9]|1[0-9]|20)$",
          "title": "Color",
          "type": "string"
        },
        "operation": {
          "const": "create_campaign",
          "default": "create_campaign",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "name",
        "color"
      ],
      "title": "CreateCampaign",
      "type": "object"
    },
