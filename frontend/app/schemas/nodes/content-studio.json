          "default": null,
          "description": "Restrict visibility to these workspace members.",
          "title": "Allowed Member Ids"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "color": {
          "description": "Provider palette token: color_1 through color_20.",
