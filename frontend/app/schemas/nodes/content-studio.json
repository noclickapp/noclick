    "CreatePost": {
      "additionalProperties": false,
      "description": "Create a draft, scheduled or queued post with optional library media.",
      "properties": {
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Workspace Id",
          "type": "string"
        },
        "text": {
          "description": "The complete common post caption.",
          "maxLength": 5000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "accounts": {
          "description": "Social account IDs from List Accounts.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Accounts",
          "type": "array"
        },
        "publish_type": {
          "default": "draft",
          "description": "Draft saves without publishing. Scheduled requires a timestamp.",
          "enum": [
            "draft",
            "scheduled",
            "queued",
            "content_category"
          ],
          "title": "Publish Type",
          "type": "string"
        },
        "scheduled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for scheduled posts; include the timezone.",
          "title": "Scheduled At"
        },
        "operation": {
          "const": "create_post",
          "default": "create_post",
          "title": "Operation",
          "type": "string"
        },
        "media_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing content library IDs from List Media.",
          "title": "Media Ids"
        },
        "labels": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                "type": "string"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Labels"
        },
        "campaign_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign Id"
        },
        "content_category_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Category Id"
        },
        "post_type": {
          "anyOf": [
            {
              "enum": [
                "feed",
                "feed+reel",
                "reel",
                "story",
                "feed+story",
                "feed+reel+story",
                "reel+story",
                "video",
                "shorts"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Type",
          "enum": [
            "feed",
            "feed+reel",
            "reel",
            "story",
            "feed+story",
            "feed+reel+story",
            "reel+story",
            "video",
            "shorts"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "workspace_id",
        "text",
        "accounts"
      ],
      "title": "CreatePost",
      "type": "object"
    },
