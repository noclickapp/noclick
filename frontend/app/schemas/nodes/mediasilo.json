{
  "$defs": {
    "MediaSiloAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "mediasilo_api_key",
          "default": "mediasilo_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "Existing MediaSilo API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_secret": {
          "title": "Existing MediaSilo API Secret",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key",
        "api_secret"
      ],
      "title": "MediaSiloAPIKeyCredential",
      "type": "object",
      "x-credential-instructions": "Supply an existing user-tied API key and secret. They are sent only as x-key/x-secret headers to the current reference host api.mediasilo.com. The older guide uses api.shift.io; this node does not silently fall back. Protected project/folder access proves resource reachability, not principal identity, account ownership, all permissions, plan or entitlement. No credential acquisition, refresh or environment fallback.",
      "x-credential-url": "https://docs.mediasilo.com/docs/authentication"
    },
    "MediaSiloCheckConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "test_connection",
          "default": "test_connection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Connection",
          "x-display-name": "Check Protected Project Catalog Read Access",
          "x-is-trigger": false
        }
      },
      "title": "MediaSiloCheckConfig",
      "type": "object"
    },
    "MediaSiloFolderConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to project/folder names. Owner/profile/contact, descriptions, media, links, settings, credentials and capabilities are always omitted.",
          "title": "Include Names",
          "type": "boolean"
        },
        "project_id": {
          "description": "Exact returned project ID in the protected catalog. One bounded response; no published request pagination contract. IDs only in picker labels.",
          "title": "Project",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "project_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-id-path": "project_id",
          "x-resource-type": "mediasilo_project"
        },
        "operation": {
          "const": "get_folder",
          "default": "get_folder",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Folders",
          "x-display-name": "Read Selected Folder Metadata",
          "x-is-trigger": false
        },
        "folder_id": {
          "description": "Exact folder ID in the selected project's protected folder catalog. Returned folder.projectId must match the project.",
          "title": "Folder",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "depends_on": "project_id",
            "field_name": "folder_id",
            "searchable": true
          },
          "x-resource-id-path": "folder_id",
          "x-resource-type": "mediasilo_folder"
        }
      },
      "required": [
        "project_id",
        "folder_id"
      ],
      "title": "MediaSiloFolderConfig",
      "type": "object"
    },
    "MediaSiloFoldersConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to project/folder names. Owner/profile/contact, descriptions, media, links, settings, credentials and capabilities are always omitted.",
          "title": "Include Names",
          "type": "boolean"
        },
        "project_id": {
          "description": "Exact returned project ID in the protected catalog. One bounded response; no published request pagination contract. IDs only in picker labels.",
          "title": "Project",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "project_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-id-path": "project_id",
          "x-resource-type": "mediasilo_project"
        },
        "operation": {
          "const": "list_folders",
          "default": "list_folders",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Folders",
          "x-display-name": "List Selected Project Folder Metadata",
          "x-is-trigger": false
        }
      },
      "required": [
        "project_id"
      ],
      "title": "MediaSiloFoldersConfig",
      "type": "object"
    },
    "MediaSiloProjectConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to project/folder names. Owner/profile/contact, descriptions, media, links, settings, credentials and capabilities are always omitted.",
          "title": "Include Names",
          "type": "boolean"
        },
        "project_id": {
          "description": "Exact returned project ID in the protected catalog. One bounded response; no published request pagination contract. IDs only in picker labels.",
          "title": "Project",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "project_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-id-path": "project_id",
          "x-resource-type": "mediasilo_project"
        },
        "operation": {
          "const": "get_project",
          "default": "get_project",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Projects",
          "x-display-name": "Read Selected Project Metadata",
          "x-is-trigger": false
        }
      },
      "required": [
        "project_id"
      ],
      "title": "MediaSiloProjectConfig",
      "type": "object"
    },
    "MediaSiloProjectsConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to project/folder names. Owner/profile/contact, descriptions, media, links, settings, credentials and capabilities are always omitted.",
          "title": "Include Names",
          "type": "boolean"
        },
        "operation": {
          "const": "list_projects",
          "default": "list_projects",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Projects",
          "x-display-name": "List Project Metadata",
          "x-is-trigger": false
        }
      },
      "title": "MediaSiloProjectsConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_folder": "#/$defs/MediaSiloFolderConfig",
          "get_project": "#/$defs/MediaSiloProjectConfig",
          "list_folders": "#/$defs/MediaSiloFoldersConfig",
          "list_projects": "#/$defs/MediaSiloProjectsConfig",
          "test_connection": "#/$defs/MediaSiloCheckConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MediaSiloCheckConfig"
        },
        {
          "$ref": "#/$defs/MediaSiloProjectsConfig"
        },
        {
          "$ref": "#/$defs/MediaSiloProjectConfig"
        },
        {
          "$ref": "#/$defs/MediaSiloFoldersConfig"
        },
        {
          "$ref": "#/$defs/MediaSiloFolderConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MediaSiloAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Mediasilo Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Read project identifiers, times and folder counts",
    "Read folder counts within an accessible selected project",
    "Opt in to names while omitting media, owners, links and settings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
