    "SmartleadAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "smartlead_api_key",
          "default": "smartlead_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
