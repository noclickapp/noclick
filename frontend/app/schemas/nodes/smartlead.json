    "SmartleadCampaignPerformanceConfig": {
      "additionalProperties": false,
      "description": "Get Campaign Overall Stats.",
      "properties": {
        "client_ids": {
          "anyOf": [
            {
              "maxLength": 2000,
              "pattern": "^[0-9]+(?:,[0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated client IDs.",
          "title": "Client Ids"
        },
        "start_date": {
          "description": "Inclusive start date, YYYY-MM-DD.",
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "description": "End date, YYYY-MM-DD.",
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "timezone": {
          "description": "IANA timezone, for example America/New_York or UTC.",
          "maxLength": 100,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "campaign_ids": {
          "anyOf": [
            {
              "maxLength": 2000,
              "pattern": "^[0-9]+(?:,[0-9]+){0,99}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated campaign IDs, at most 100.",
          "title": "Campaign Ids"
        },
        "operation": {
          "const": "get_campaign_performance",
          "default": "get_campaign_performance",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "full_data": {
          "anyOf": [
            {
              "enum": [
                "true",
                "false"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Full Data",
          "enum": [
            "true",
            "false"
          ],
          "x-enum-searchable": true
        },
        "limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page size; use offset for further pages.",
          "title": "Limit"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        }
      },
      "required": [
        "start_date",
        "end_date",
        "timezone"
      ],
      "title": "SmartleadCampaignPerformanceConfig",
      "type": "object"
    },
