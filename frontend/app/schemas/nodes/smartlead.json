{
  "$defs": {
    "InboxFilters": {
      "additionalProperties": false,
      "properties": {
        "search": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search"
        },
        "leadCategories": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeadCategories"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "emailStatus": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "Opened",
                  "Clicked",
                  "Replied",
                  "Unsubscribed",
                  "Bounced",
                  "Accepted",
                  "Not Replied"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emailstatus"
        },
        "campaignId": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 5,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaignid"
        },
        "emailAccountId": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emailaccountid"
        },
        "campaignTeamMemberId": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaignteammemberid"
        },
        "campaignTagId": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaigntagid"
        },
        "campaignClientId": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaignclientid"
        },
        "replyTimeBetween": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replytimebetween"
        }
