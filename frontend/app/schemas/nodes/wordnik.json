          "default": "false",
          "description": "If true will try to return the correct word root ('cats' -> 'cat'). If false returns exactly what was requested.",
          "enum": [
            "false",
            "true"
          ],
          "title": "Use Canonical",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "description": "Maximum number of results to return",
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "word"
      ],
      "title": "WordnikGetAudioConfig",
      "type": "object"
    },
    "WordnikGetDefinitionsConfig": {
