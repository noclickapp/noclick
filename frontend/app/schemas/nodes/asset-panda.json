          "title": "Include Names",
          "type": "boolean"
        },
        "module_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Module",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "module_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "asset_panda_module"
        },
        "collection_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Collection",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "depends_on": [
              "module_id"
            ],
            "field_name": "collection_id",
            "searchable": true
          },
          "x-resource-type": "asset_panda_collection"
        },
        "operation": {
          "const": "get_collection",
          "default": "get_collection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Collections",
          "x-display-name": "Get Collection Metadata",
          "x-is-trigger": false
        }
      },
      "required": [
        "module_id",
        "collection_id"
