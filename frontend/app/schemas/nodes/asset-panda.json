          "x-display-name": "Search Collection Record IDs",
          "x-is-trigger": false
        },
        "column_id": {
          "description": "Exact current column ID; the documented field-name filter uses its current nonempty name.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Filter Column",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "depends_on": [
              "module_id",
              "collection_id"
            ],
            "field_name": "column_id",
            "searchable": true
          },
          "x-resource-type": "asset_panda_column"
        },
        "operator": {
          "default": "eq",
          "enum": [
            "eq",
            "contains"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "value": {
          "description": "Bounded supplied string used only with the selected current column. No raw filters or returned record values.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Search Value",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "description": "Documented zero-based pagination.from, locally capped at 10000. Results may change between calls; no snapshot or cursor guarantee.",
          "maximum": 10000,
          "minimum": 0,
          "title": "Starting Index",
          "type": "integer"
        },
        "page_size": {
          "default": 50,
          "description": "Documented pagination.size 1..100. Total and has_more are not supplied by the published envelope.",
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "module_id",
        "collection_id",
        "column_id",
        "value"
      ],
      "title": "SearchRecords",
      "type": "object"
