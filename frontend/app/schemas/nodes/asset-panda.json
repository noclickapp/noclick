  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_account": "#/$defs/GetAccount",
          "get_collection": "#/$defs/GetCollection",
          "get_collection_record": "#/$defs/GetRecord",
          "get_module": "#/$defs/GetModule",
          "list_accounts": "#/$defs/ListAccounts",
          "list_collection_columns": "#/$defs/ListColumns",
          "list_collections": "#/$defs/ListCollections",
          "list_modules": "#/$defs/ListModules",
          "search_collection_records": "#/$defs/SearchRecords"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListAccounts"
        },
        {
          "$ref": "#/$defs/GetAccount"
        },
        {
          "$ref": "#/$defs/ListModules"
        },
        {
          "$ref": "#/$defs/GetModule"
        },
        {
          "$ref": "#/$defs/ListCollections"
        },
        {
          "$ref": "#/$defs/GetCollection"
        },
        {
          "$ref": "#/$defs/ListColumns"
        },
        {
          "$ref": "#/$defs/SearchRecords"
        },
        {
          "$ref": "#/$defs/GetRecord"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetPandaAccessKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Asset-panda Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
