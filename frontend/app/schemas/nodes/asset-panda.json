{
  "$defs": {
    "AssetPandaAccessKeyCredential": {
      "additionalProperties": false,
      "properties": {
        "credential_type": {
          "const": "asset_panda_access_key",
          "default": "asset_panda_access_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_key_id": {
          "description": "Supplied Pioneer/Pro key ID sent only in Access-Key-Id to the fixed api.assetpanda.app host.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Access Key ID",
          "type": "string",
          "ui:widget": "password"
        },
        "access_key_secret": {
          "description": "Supplied Pioneer/Pro key secret sent only in Access-Key-Secret. Legacy V2/V3 OAuth credentials are incompatible.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Access Key Secret",
          "type": "string",
          "ui:widget": "password"
        },
        "account_id": {
          "description": "Exact permitted account ID. Protected GET /accounts membership is checked for every native operation; no ownership, role or expiry is inferred.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Account ID",
          "type": "string"
        }
      },
      "required": [
        "access_key_id",
        "access_key_secret",
        "account_id"
      ],
      "title": "Asset Panda Access Key",
      "type": "object",
      "x-credential-url": "https://prohelp.assetpanda.com/settings/api-configuration"
    },
    "GetAccount": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_account",
          "default": "get_account",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Accounts",
          "x-display-name": "Get Selected Account ID",
          "x-is-trigger": false
        }
      },
      "title": "GetAccount",
      "type": "object"
    },
