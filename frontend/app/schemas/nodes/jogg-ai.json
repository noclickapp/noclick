{
  "$defs": {
    "JoggAiAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "jogg_ai_api_key",
          "default": "jogg_ai_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Jogg Ai API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the JoggAI dashboard and paste it here. NoClick sends it in the x-api-key header to api.jogg.ai. Video generation uses your JoggAI credits.",
      "x-credential-url": "https://app.jogg.ai/"
    },
    "JoggAiCreateAvatarVideoConfig": {
      "additionalProperties": false,
      "description": "Create talking avatar video",
      "properties": {
        "operation": {
          "const": "create_avatar_video",
          "default": "create_avatar_video",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "avatar": {
          "description": "Avatar configuration",
          "placeholder": "{\n  \"avatar_id\": 81,\n  \"avatar_type\": 0\n}",
          "title": "Avatar",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "voice": {
          "description": "Voice configuration including script or audio input",
          "placeholder": "{\n  \"type\": \"script\",\n  \"voice_id\": \"en-US-ChristopherNeural\",\n  \"script\": \"Welcome to JoggAI! Create amazing videos with AI avatars in minutes.\"\n}",
          "title": "Voice",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "aspect_ratio": {
          "description": "Aspect ratio of the output video",
          "enum": [
            "portrait",
            "landscape",
            "square"
          ],
          "minLength": 1,
          "title": "Aspect Ratio",
          "type": "string"
        },
        "screen_style": {
          "description": "Background style:\n* 1 - Full screen\n* 2 - Split screen\n* 3 - Picture in picture\n",
          "enum": [
            1,
            2,
            3
          ],
          "title": "Screen Style",
          "type": "integer"
        },
        "caption": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enable or disable subtitles",
          "title": "Caption"
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Webhook URL for status notifications",
          "title": "Webhook Url"
        },
        "video_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom name for the video",
          "title": "Video Name"
        }
      },
      "required": [
        "avatar",
        "voice",
        "aspect_ratio",
        "screen_style"
      ],
      "title": "JoggAiCreateAvatarVideoConfig",
      "type": "object"
    },
    "JoggAiCreateProductConfig": {
