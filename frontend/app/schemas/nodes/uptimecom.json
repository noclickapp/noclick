    "UptimeComAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "uptimecom_api_token",
          "default": "uptimecom_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API Key",
          "type": "string",
          "ui:sensitive": true,
          "ui:widget": "password"
        },
        "expected_user_pk": {
          "description": "Numeric pk returned by the protected /auth/me/ endpoint. This authenticates a user witness, not account ownership or paid entitlement.",
          "title": "Expected User ID",
          "type": "string"
        },
        "approved_resources_json": {
          "default": "{\"checks\":[],\"tags\":[],\"statuspages\":[]}",
          "description": "Existing numeric IDs as JSON strings, for example {\"checks\":[\"123\"],\"tags\":[\"4\"],\"statuspages\":[\"5\"]}. Maximum 50 per family/100 total are NoClick limits.",
          "title": "Approved Monitoring IDs",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "include_labels": {
          "default": false,
          "description": "Opt in to check names, tag names and status-page/component names. User personal data, check configuration and all URLs are always omitted.",
          "title": "Include Resource Labels",
          "type": "boolean"
        }
      },
      "required": [
        "api_key",
        "expected_user_pk"
      ],
      "title": "Uptime.com API Token",
      "type": "object",
      "x-credential-instructions": "Enter an existing entitled API key, the expected numeric user pk from authenticated /auth/me/, and approved monitoring IDs. Saved restrictions narrow NoClick; provider permissions remain authoritative.",
      "x-help-url": "https://support.uptime.com/hc/en-us/articles/26061121898012-How-to-Connect-to-the-Uptime-com-API"
    }
