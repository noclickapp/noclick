          "get_status_page_current_status": "#/$defs/GetStatusPageCurrentStatus",
          "get_tag": "#/$defs/GetTag",
          "list_checks": "#/$defs/ListChecks",
          "list_outages": "#/$defs/ListOutages",
          "list_status_pages": "#/$defs/ListStatusPages",
          "list_tags": "#/$defs/ListTags"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CheckConnection"
        },
        {
          "$ref": "#/$defs/ListChecks"
        },
        {
          "$ref": "#/$defs/GetCheck"
