            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monitoring Service Type",
          "enum": [
            "API",
            "BLACKLIST",
            "CLOUDSTATUS",
            "DNS",
            "FTP",
            "SFTP",
            "GROUP",
