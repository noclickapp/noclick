        },
        {
          "$ref": "#/$defs/GetStatusPageCurrentStatus"
        },
        {
          "$ref": "#/$defs/GetCheckStatistics"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/UptimeComAPITokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
