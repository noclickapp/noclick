{
  "$defs": {
    "BatchLookup": {
      "additionalProperties": false,
      "description": "Look up up to 1,000 IPs; each successful lookup consumes quota.",
      "properties": {
        "operation": {
          "const": "batch_lookup",
          "default": "batch_lookup",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "ips": {
          "description": "IPv4 or IPv6 addresses. Requires a paid plan or credits. Results can contain per-address errors.",
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Ips",
          "type": "array"
        }
      },
      "required": [
        "ips"
      ],
      "title": "BatchLookup",
      "type": "object"
    },
    "IplocateAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "iplocate_api_key",
          "default": "iplocate_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "IPLocate API Key",
      "type": "object",
      "x-credential-instructions": "Paste your IPLocate API key from your account. The connection check reads the NoClick server's IP intelligence; it proves API reachability, not account identity. Batch lookups require a paid plan or credits.",
      "x-credential-url": "https://www.iplocate.io/account"
    },
    "Lookup": {
      "additionalProperties": false,
      "description": "Look up geolocation, ASN, privacy, hosting, company and abuse data.",
      "properties": {
        "include": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional comma-separated fields, such as asn.asn,privacy.is_vpn. Always returns JSON.",
          "title": "Include"
        },
        "ip": {
          "description": "IPv4 or IPv6 address, for example 8.8.8.8 or 2001:4860:4860::8888.",
          "maxLength": 45,
          "minLength": 2,
          "title": "Ip",
          "type": "string"
        },
        "operation": {
          "const": "lookup",
          "default": "lookup",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "ip"
      ],
      "title": "Lookup",
      "type": "object"
    },
    "LookupFiltered": {
      "additionalProperties": false,
      "description": "Read one field or object for a specified IP address.",
      "properties": {
        "filter": {
          "description": "One field path, such as ip, asn or privacy.is_vpn. Scalar fields return plain text; objects return JSON.",
          "maxLength": 200,
          "pattern": "^[a-z_]+(?:\\.[a-z_]+)*$",
          "title": "Filter",
          "type": "string"
        },
        "ip": {
          "description": "IPv4 or IPv6 address, for example 8.8.8.8 or 2001:4860:4860::8888.",
          "maxLength": 45,
          "minLength": 2,
          "title": "Ip",
          "type": "string"
        },
        "operation": {
          "const": "lookup_filtered",
          "default": "lookup_filtered",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "filter",
        "ip"
      ],
      "title": "LookupFiltered",
      "type": "object"
    },
    "LookupSelf": {
      "additionalProperties": false,
      "description": "Look up the NoClick server's public IP, not the user's device IP.",
      "properties": {
        "include": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional comma-separated fields, such as asn.asn,privacy.is_vpn. Always returns JSON.",
          "title": "Include"
        },
        "operation": {
          "const": "lookup_self",
          "default": "lookup_self",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "LookupSelf",
      "type": "object"
    },
    "LookupSelfFiltered": {
      "additionalProperties": false,
      "description": "Read one field or object for the NoClick server's public IP.",
      "properties": {
        "filter": {
          "description": "One field path, such as ip, asn or privacy.is_vpn. Scalar fields return plain text; objects return JSON.",
          "maxLength": 200,
          "pattern": "^[a-z_]+(?:\\.[a-z_]+)*$",
          "title": "Filter",
          "type": "string"
        },
        "operation": {
          "const": "lookup_self_filtered",
          "default": "lookup_self_filtered",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "filter"
      ],
      "title": "LookupSelfFiltered",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "batch_lookup": "#/$defs/BatchLookup",
          "lookup": "#/$defs/Lookup",
          "lookup_filtered": "#/$defs/LookupFiltered",
          "lookup_self": "#/$defs/LookupSelf",
          "lookup_self_filtered": "#/$defs/LookupSelfFiltered"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LookupSelf"
        },
        {
          "$ref": "#/$defs/LookupSelfFiltered"
        },
        {
          "$ref": "#/$defs/Lookup"
        },
        {
          "$ref": "#/$defs/LookupFiltered"
        },
        {
          "$ref": "#/$defs/BatchLookup"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/IplocateAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Iplocate Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
