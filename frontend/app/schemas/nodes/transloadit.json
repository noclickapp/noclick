{
  "$defs": {
    "CancelAssembly": {
      "additionalProperties": false,
      "properties": {
        "assembly_id": {
          "description": "Private Assembly ID; grants capability-based status and cancellation access.",
          "pattern": "^[a-z0-9]{32}$",
          "title": "Assembly Id",
          "type": "string"
        },
        "operation": {
          "const": "cancel_assembly",
          "default": "cancel_assembly",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "assembly_id"
      ],
      "title": "CancelAssembly",
      "type": "object"
    },
    "CreateAssembly": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_assembly",
          "default": "create_assembly",
          "title": "Operation",
          "type": "string"
        },
        "template_id": {
          "description": "Existing Template to run. Use import Steps in the Template for remote files; no local uploads are sent.",
          "minLength": 1,
          "title": "Template Id",
          "type": "string"
        },
        "fields": {
          "additionalProperties": true,
          "description": "Assembly variables used by the Template.",
          "title": "Fields",
          "type": "object"
        },
        "notify_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Webhook destination for completion notifications.",
          "title": "Notify Url"
        }
      },
      "required": [
        "template_id"
      ],
      "title": "CreateAssembly",
      "type": "object"
    },
    "CreateTemplate": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_template",
          "default": "create_template",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "template": {
          "additionalProperties": true,
          "description": "Assembly Instructions object including steps.",
          "title": "Template",
          "type": "object",
          "ui:widget": "json"
        }
      },
      "required": [
        "name",
        "template"
      ],
      "title": "CreateTemplate",
      "type": "object"
    },
    "DeleteTemplate": {
      "additionalProperties": false,
      "properties": {
        "template_id_or_name": {
          "pattern": "^[a-z0-9-]+$",
          "title": "Template Id Or Name",
          "type": "string"
        },
        "operation": {
          "const": "delete_template",
          "default": "delete_template",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "template_id_or_name"
      ],
      "title": "DeleteTemplate",
      "type": "object"
    },
    "DeleteTemplateCredential": {
      "additionalProperties": false,
      "properties": {
        "template_credential_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Template Credential Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_template_credential",
          "default": "delete_template_credential",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "template_credential_id"
      ],
      "title": "DeleteTemplateCredential",
      "type": "object"
    },
    "GetAssembly": {
      "additionalProperties": false,
      "properties": {
        "assembly_id": {
          "description": "Private Assembly ID; grants capability-based status and cancellation access.",
          "pattern": "^[a-z0-9]{32}$",
          "title": "Assembly Id",
          "type": "string"
        },
        "operation": {
          "const": "get_assembly",
          "default": "get_assembly",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "assembly_id"
      ],
      "title": "GetAssembly",
      "type": "object"
    },
    "GetTemplate": {
      "additionalProperties": false,
      "properties": {
        "template_id_or_name": {
          "pattern": "^[a-z0-9-]+$",
          "title": "Template Id Or Name",
          "type": "string"
        },
        "operation": {
          "const": "get_template",
          "default": "get_template",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "template_id_or_name"
      ],
      "title": "GetTemplate",
      "type": "object"
    },
    "GetTemplateCredential": {
      "additionalProperties": false,
      "properties": {
        "template_credential_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Template Credential Id",
          "type": "string"
        },
        "operation": {
          "const": "get_template_credential",
          "default": "get_template_credential",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "template_credential_id"
      ],
      "title": "GetTemplateCredential",
      "type": "object"
    },
    "ListAssemblies": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "default": 1,
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "pagesize": {
          "default": 50,
          "maximum": 5000,
          "minimum": 1,
          "title": "Pagesize",
          "type": "integer"
        },
        "order": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Order",
          "type": "string"
        },
        "operation": {
          "const": "list_assemblies",
          "default": "list_assemblies",
          "title": "Operation",
          "type": "string"
        },
        "type": {
          "default": "all",
          "enum": [
            "all",
            "canceled",
            "completed",
            "executing",
            "expired",
            "failed",
            "fixable",
            "problematic",
            "request_aborted",
            "uploading"
          ],
          "title": "Type",
          "type": "string"
        },
        "template_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Id"
        },
        "fromdate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fromdate"
        },
        "todate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Todate"
        }
      },
      "title": "ListAssemblies",
      "type": "object"
    },
    "ListAssemblyNotifications": {
      "additionalProperties": false,
      "properties": {
        "assembly_id": {
          "description": "Private Assembly ID; grants capability-based status and cancellation access.",
          "pattern": "^[a-z0-9]{32}$",
          "title": "Assembly Id",
          "type": "string"
        },
        "operation": {
          "const": "list_assembly_notifications",
          "default": "list_assembly_notifications",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "assembly_id"
      ],
      "title": "ListAssemblyNotifications",
      "type": "object"
    },
    "ListTemplateCredentialTypes": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_template_credential_types",
          "default": "list_template_credential_types",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListTemplateCredentialTypes",
      "type": "object"
    },
    "ListTemplateCredentials": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_template_credentials",
          "default": "list_template_credentials",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListTemplateCredentials",
      "type": "object"
    },
    "ListTemplates": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "default": 1,
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "pagesize": {
          "default": 50,
          "maximum": 850,
          "minimum": 1,
          "title": "Pagesize",
          "type": "integer"
        },
        "order": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Order",
          "type": "string"
        },
        "operation": {
          "const": "list_templates",
          "default": "list_templates",
          "title": "Operation",
          "type": "string"
        },
        "include_builtin": {
          "default": "none",
          "enum": [
            "all",
            "exclusively-all",
            "exclusively-latest",
            "latest",
            "none"
          ],
          "title": "Include Builtin",
          "type": "string"
        }
      },
      "title": "ListTemplates",
      "type": "object"
    },
    "ReplayAssembly": {
      "additionalProperties": false,
      "properties": {
        "assembly_id": {
          "description": "Private Assembly ID; grants capability-based status and cancellation access.",
          "pattern": "^[a-z0-9]{32}$",
          "title": "Assembly Id",
          "type": "string"
        },
        "operation": {
          "const": "replay_assembly",
          "default": "replay_assembly",
          "title": "Operation",
          "type": "string"
        },
        "reparse_template": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "Reparse Template",
          "type": "integer"
        },
        "fields": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "notify_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notify Url"
        }
      },
      "required": [
        "assembly_id"
      ],
      "title": "ReplayAssembly",
      "type": "object"
    },
    "ReplayAssemblyNotification": {
      "additionalProperties": false,
      "properties": {
        "assembly_id": {
          "description": "Private Assembly ID; grants capability-based status and cancellation access.",
          "pattern": "^[a-z0-9]{32}$",
          "title": "Assembly Id",
          "type": "string"
        },
        "operation": {
          "const": "replay_assembly_notification",
          "default": "replay_assembly_notification",
          "title": "Operation",
          "type": "string"
        },
        "notify_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional replacement webhook destination. Sends a notification.",
          "title": "Notify Url"
        },
        "wait": {
          "default": false,
          "title": "Wait",
          "type": "boolean"
        }
      },
      "required": [
        "assembly_id"
      ],
      "title": "ReplayAssemblyNotification",
      "type": "object"
    },
    "TransloaditTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "transloadit_token",
          "default": "transloadit_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Bearer access token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "Transloadit Bearer Token",
      "type": "object",
      "x-credential-instructions": "Paste an API2 bearer access token without the Bearer prefix. Create it server-side using your Auth Key and Auth Secret with audience api2. Request assemblies:read, assemblies:write, templates:read, templates:write, template_credentials:read, template_credentials:write and assembly_notifications:write for all operations. Tokens expire (normally after six hours); replace the token when it expires. NoClick does not renew it. Connection checks list your own Templates and require templates:read.",
      "x-credential-url": "https://transloadit.com/docs/api/token-post/"
    },
    "UpdateTemplate": {
      "additionalProperties": false,
      "properties": {
        "template_id_or_name": {
          "pattern": "^[a-z0-9-]+$",
          "title": "Template Id Or Name",
          "type": "string"
        },
        "operation": {
          "const": "update_template",
          "default": "update_template",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "template": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replacement Assembly Instructions.",
          "title": "Template",
          "ui:widget": "json"
        }
      },
      "required": [
        "template_id_or_name"
      ],
      "title": "UpdateTemplate",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "cancel_assembly": "#/$defs/CancelAssembly",
          "create_assembly": "#/$defs/CreateAssembly",
          "create_template": "#/$defs/CreateTemplate",
          "delete_template": "#/$defs/DeleteTemplate",
          "delete_template_credential": "#/$defs/DeleteTemplateCredential",
          "get_assembly": "#/$defs/GetAssembly",
          "get_template": "#/$defs/GetTemplate",
          "get_template_credential": "#/$defs/GetTemplateCredential",
          "list_assemblies": "#/$defs/ListAssemblies",
          "list_assembly_notifications": "#/$defs/ListAssemblyNotifications",
          "list_template_credential_types": "#/$defs/ListTemplateCredentialTypes",
          "list_template_credentials": "#/$defs/ListTemplateCredentials",
          "list_templates": "#/$defs/ListTemplates",
          "replay_assembly": "#/$defs/ReplayAssembly",
          "replay_assembly_notification": "#/$defs/ReplayAssemblyNotification",
          "update_template": "#/$defs/UpdateTemplate"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListAssemblies"
        },
        {
          "$ref": "#/$defs/GetAssembly"
        },
        {
          "$ref": "#/$defs/CreateAssembly"
        },
        {
          "$ref": "#/$defs/CancelAssembly"
        },
        {
          "$ref": "#/$defs/ReplayAssembly"
        },
        {
          "$ref": "#/$defs/ListAssemblyNotifications"
        },
        {
          "$ref": "#/$defs/ReplayAssemblyNotification"
        },
        {
          "$ref": "#/$defs/ListTemplates"
        },
        {
          "$ref": "#/$defs/GetTemplate"
        },
        {
          "$ref": "#/$defs/CreateTemplate"
        },
        {
          "$ref": "#/$defs/UpdateTemplate"
        },
        {
          "$ref": "#/$defs/DeleteTemplate"
        },
        {
          "$ref": "#/$defs/ListTemplateCredentials"
        },
        {
          "$ref": "#/$defs/ListTemplateCredentialTypes"
        },
        {
          "$ref": "#/$defs/GetTemplateCredential"
        },
        {
          "$ref": "#/$defs/DeleteTemplateCredential"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransloaditTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Transloadit Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
