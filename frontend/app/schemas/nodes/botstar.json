      "properties": {
        "credential_type": {
          "const": "botstar_api_token",
          "default": "botstar_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Botstar API Token",
      "type": "object",
      "x-credential-instructions": "In BotStar, open Account > Profile and copy your API Token. Paste only the token. NoClick checks it by reading your bots. See https://apis.botstar.com/docs/.",
      "x-credential-url": "https://app.botstar.com/account/profile"
    },
    "BotstarCreateBotConfig": {
      "additionalProperties": false,
      "description": "Create a new bot with a name.",
      "properties": {
        "operation": {
          "const": "create_bot",
          "default": "create_bot",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
