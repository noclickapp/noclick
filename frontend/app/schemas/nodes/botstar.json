        "name"
      ],
      "title": "BotstarCreateBotConfig",
      "type": "object"
    },
    "BotstarCreateEntityItemConfig": {
      "additionalProperties": false,
      "description": "Create a CMS item with values for the entity's custom fields.",
      "properties": {
        "bot_id": {
          "description": "Copy the ID from Bot Builder or List Bots.",
          "minLength": 1,
          "title": "Bot ID",
          "type": "string"
        },
        "env": {
          "anyOf": [
            {
              "enum": [
                "draft",
                "draft,live"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to use BotStar's default; draft,live applies to both environments.",
          "title": "Bot Environment",
          "enum": [
            "draft",
            "draft,live"
          ],
          "x-enum-searchable": true
        },
        "entity_id": {
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "custom_fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "description": "CMS values keyed by each field's unique_name, for example color: [red, yellow] and price: $10.",
          "title": "Custom Fields",
          "type": "object"
        },
        "operation": {
          "const": "create_entity_item",
          "default": "create_entity_item",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "enabled",
                "disabled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "enabled",
            "disabled"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "bot_id",
        "entity_id",
        "name"
