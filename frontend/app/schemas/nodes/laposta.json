        "in_form": {
          "default": true,
          "title": "In Form",
          "type": "boolean"
        },
        "in_list": {
          "default": true,
          "title": "In List",
          "type": "boolean"
        },
        "defaultvalue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Defaultvalue"
        }
      },
      "required": [
        "list_id",
        "name"
      ],
      "title": "LapostaCreateFieldConfig",
      "type": "object"
    },
    "LapostaCreateListConfig": {
