    "LapostaAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "laposta_api_key",
          "default": "laposta_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Laposta API Key",
      "type": "object",
      "x-credential-instructions": "In Laposta, open Koppelingen and create an API key. Copy it while it is visible and paste it here. NoClick sends it as the Basic authentication username with an empty password to api.laposta.nl.",
      "x-credential-url": "https://docs.laposta.org/hoe-kom-ik-aan-een-api-sleutel"
    },
    "LapostaCreateFieldConfig": {
      "additionalProperties": false,
      "description": "Create field.",
      "properties": {
        "operation": {
          "const": "create_field",
          "default": "create_field",
          "title": "Create Field",
          "type": "string",
          "ui:hidden": true
        },
        "list_id": {
          "title": "List Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "datatype": {
          "default": "text",
          "description": "Create a scalar custom field.",
          "enum": [
            "text",
            "numeric",
            "date"
          ],
          "title": "Datatype",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
