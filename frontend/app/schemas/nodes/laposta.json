    "LapostaCreateMemberConfig": {
      "additionalProperties": false,
      "description": "Add a subscriber. List double opt-in and notification settings apply.",
      "properties": {
        "operation": {
          "const": "create_member",
          "default": "create_member",
          "title": "Create Member",
          "type": "string",
          "ui:hidden": true
        },
        "list_id": {
          "title": "List Id",
          "type": "string"
        },
        "email": {
          "title": "Email",
          "type": "string"
        },
        "ip": {
          "description": "IP address of the subscriber who signed up, not the server.",
          "title": "Ip",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "custom_fields": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Keys are field custom_name values; arrays support multiple selections and labels.",
          "title": "Custom Fields"
        }
      },
      "required": [
        "list_id",
        "email",
        "ip"
      ],
      "title": "LapostaCreateMemberConfig",
      "type": "object"
