    "CreatePost": {
      "additionalProperties": false,
      "description": "Send a Markdown message or reply in a channel.",
      "properties": {
        "operation": {
          "const": "create_post",
          "default": "create_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "channel_id": {
          "description": "Mattermost 26-character resource ID.",
          "pattern": "^[a-z0-9]{26}$",
          "title": "Channel Id",
          "type": "string"
        },
        "message": {
          "maxLength": 16383,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "root_id": {
          "anyOf": [
            {
              "description": "Mattermost 26-character resource ID.",
              "pattern": "^[a-z0-9]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Root message ID when replying to a thread.",
          "title": "Root Id"
        },
        "file_ids": {
          "anyOf": [
            {
              "items": {
                "description": "Mattermost 26-character resource ID.",
                "pattern": "^[a-z0-9]{26}$",
                "type": "string"
              },
              "maxItems": 5,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IDs of files already uploaded to this server.",
          "title": "File Ids"
        }
      },
      "required": [
        "channel_id",
        "message"
      ],
      "title": "CreatePost",
      "type": "object"
