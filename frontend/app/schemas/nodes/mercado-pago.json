{
  "$defs": {
    "CreateCustomer": {
      "properties": {
        "email": {
          "format": "email",
          "minLength": 1,
          "title": "Email",
          "type": "string"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "operation": {
          "const": "create_customer",
          "default": "create_customer",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "CreateCustomer",
      "type": "object"
    },
    "CreatePayment": {
      "properties": {
        "idempotency_key": {
          "description": "A UUID unique to this payment/refund attempt. Reuse the same UUID when retrying the same attempt.",
          "format": "uuid",
          "title": "Idempotency Key",
          "type": "string"
        },
        "operation": {
          "const": "create_payment",
          "default": "create_payment",
          "title": "Operation",
          "type": "string"
        },
        "transaction_amount": {
          "description": "Decimal amount, not cents.",
          "exclusiveMinimum": 0,
          "title": "Transaction Amount",
          "type": "number"
        },
        "payment_method_id": {
          "description": "For example pix, visa, or a supported local method.",
          "minLength": 1,
          "title": "Payment Method Id",
          "type": "string"
        },
        "payer_email": {
          "format": "email",
          "minLength": 1,
          "title": "Payer Email",
          "type": "string"
        },
        "token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Client-side card token, required for card payments.",
          "title": "Token",
          "ui:widget": "password"
        },
        "installments": {
          "default": 1,
          "minimum": 1,
          "title": "Installments",
          "type": "integer"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "external_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Reference"
        },
        "identification_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identification Type"
        },
        "identification_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identification Number"
        }
      },
      "required": [
        "idempotency_key",
        "transaction_amount",
        "payment_method_id",
        "payer_email"
      ],
      "title": "CreatePayment",
      "type": "object"
    },
    "CreatePreference": {
      "properties": {
        "items_json": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "properties": {
                "title": {
                  "type": "string"
                },
                "quantity": {
                  "minimum": 1,
                  "type": "integer"
                },
                "unit_price": {
                  "minimum": 1,
                  "type": "number"
                }
              },
              "required": [
                "title",
                "quantity",
                "unit_price"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "description": "Array of items, for example [{\"title\":\"Premium Plan\",\"quantity\":1,\"unit_price\":99.9}].",
          "title": "Items (JSON)",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "payer_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "email",
          "title": "Payer Email"
        },
        "external_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Reference"
        },
        "operation": {
          "const": "create_preference",
          "default": "create_preference",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "items_json"
      ],
      "title": "CreatePreference",
      "type": "object"
    },
    "CreateRefund": {
      "properties": {
        "idempotency_key": {
          "description": "A UUID unique to this payment/refund attempt. Reuse the same UUID when retrying the same attempt.",
          "format": "uuid",
          "title": "Idempotency Key",
          "type": "string"
        },
        "payment_id": {
          "minimum": 1,
          "title": "Payment ID",
          "type": "integer"
        },
        "operation": {
          "const": "create_refund",
          "default": "create_refund",
          "title": "Operation",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave empty for a full refund.",
          "title": "Amount"
        }
      },
      "required": [
        "idempotency_key",
        "payment_id"
      ],
      "title": "CreateRefund",
      "type": "object"
    },
    "CreateSubscription": {
      "properties": {
        "operation": {
          "const": "create_subscription",
          "default": "create_subscription",
          "title": "Operation",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "payer_email": {
          "format": "email",
          "minLength": 1,
          "title": "Payer Email",
          "type": "string"
        },
        "frequency": {
          "default": 1,
          "minimum": 1,
          "title": "Frequency",
          "type": "integer"
        },
        "frequency_type": {
          "default": "months",
          "enum": [
            "months",
            "days"
          ],
          "title": "Frequency Type",
          "type": "string"
        },
        "transaction_amount": {
          "exclusiveMinimum": 0,
          "title": "Transaction Amount",
          "type": "number"
        },
        "currency_id": {
          "enum": [
            "ARS",
            "BRL",
            "MXN",
            "CLP",
            "COP",
            "PEN",
            "UYU",
            "USD"
          ],
          "title": "Currency Id",
          "type": "string"
        },
        "card_token_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Card Token Id",
          "ui:widget": "password"
        },
        "back_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "uri",
          "title": "Back Url"
        },
        "external_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Reference"
        },
        "preapproval_plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preapproval Plan Id"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "authorized"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "payer_email",
        "transaction_amount",
        "currency_id"
      ],
      "title": "CreateSubscription",
      "type": "object"
    },
    "GetChargeback": {
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Resource ID",
          "type": "string"
        },
        "operation": {
          "const": "get_chargeback",
          "default": "get_chargeback",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetChargeback",
      "type": "object"
    },
    "GetCustomer": {
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Resource ID",
          "type": "string"
        },
        "operation": {
          "const": "get_customer",
          "default": "get_customer",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetCustomer",
      "type": "object"
    },
    "GetMerchantOrder": {
      "properties": {
        "operation": {
          "const": "get_merchant_order",
          "default": "get_merchant_order",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Merchant Order ID",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetMerchantOrder",
      "type": "object"
    },
    "GetPayment": {
      "properties": {
        "payment_id": {
          "minimum": 1,
          "title": "Payment ID",
          "type": "integer"
        },
        "operation": {
          "const": "get_payment",
          "default": "get_payment",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "payment_id"
      ],
      "title": "GetPayment",
      "type": "object"
    },
    "GetPreference": {
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Resource ID",
          "type": "string"
        },
        "operation": {
          "const": "get_preference",
          "default": "get_preference",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetPreference",
      "type": "object"
    },
    "GetRefund": {
      "properties": {
        "payment_id": {
          "minimum": 1,
          "title": "Payment ID",
          "type": "integer"
        },
        "operation": {
          "const": "get_refund",
          "default": "get_refund",
          "title": "Operation",
          "type": "string"
        },
        "refund_id": {
          "minimum": 1,
          "title": "Refund Id",
          "type": "integer"
        }
      },
      "required": [
        "payment_id",
        "refund_id"
      ],
      "title": "GetRefund",
      "type": "object"
    },
    "GetSubscription": {
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Resource ID",
          "type": "string"
        },
        "operation": {
          "const": "get_subscription",
          "default": "get_subscription",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetSubscription",
      "type": "object"
    },
    "GetSubscriptionInvoice": {
      "properties": {
        "operation": {
          "const": "get_subscription_invoice",
          "default": "get_subscription_invoice",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Invoice ID",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetSubscriptionInvoice",
      "type": "object"
    },
    "ListRefunds": {
      "properties": {
        "payment_id": {
          "minimum": 1,
          "title": "Payment ID",
          "type": "integer"
        },
        "operation": {
          "const": "list_refunds",
          "default": "list_refunds",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "payment_id"
      ],
      "title": "ListRefunds",
      "type": "object"
    },
    "MercadoPagoAccessToken": {
      "properties": {
        "credential_type": {
          "const": "mercado_pago_access_token",
          "default": "mercado_pago_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "title": "Access Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "Mercado Pago Access Token",
      "type": "object",
      "x-credential-instructions": "Open your Mercado Pago application, choose production or test credentials, and paste its Access Token. Use the token for the account you want to automate. Do not paste a Public Key or the Bearer prefix.",
      "x-credential-url": "https://www.mercadopago.com/developers/panel/app"
    },
    "OnNewOrUpdatedPayment": {
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_or_updated_payment",
          "default": "on_new_or_updated_payment",
          "title": "On New or Updated Payment",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On New or Updated Payment",
          "x-is-trigger": true
        },
        "lookback_minutes": {
          "default": 1440,
          "description": "Poll payments updated in this rolling window. Set longer than your schedule interval and expected downtime. Baselines existing payments when armed; at most 2,000 updated payments per window.",
          "maximum": 10080,
          "minimum": 5,
          "title": "Lookback Minutes",
          "type": "integer"
        },
        "external_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Reference"
        }
      },
      "title": "OnNewOrUpdatedPayment",
      "type": "object",
      "x-requires-webhook": true
    },
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    },
    "SearchCustomers": {
      "properties": {
        "limit": {
          "default": 30,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "One page per action; increment offset by limit for the next page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "search_customers",
          "default": "search_customers",
          "title": "Operation",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
