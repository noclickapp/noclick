{
  "$defs": {
    "MinimaxAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "minimax_api_key",
          "default": "minimax_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "MiniMax API Key",
      "type": "object",
      "x-credential-instructions": "Create an API key in MiniMax Account Management \u2192 API Keys and paste it here. NoClick uses it to call api.minimax.io. Connecting reads your file list; generation operations use your MiniMax balance.",
      "x-credential-type": "api_key",
      "x-credential-url": "https://platform.minimax.io/user-center/basic-information/interface-key"
    },
    "MinimaxAsyncSpeechConfig": {
      "additionalProperties": false,
      "description": "Submit a speech synthesis task; query it in a later workflow step.",
      "properties": {
        "model": {
          "default": "speech-2.8-hd",
          "enum": [
            "speech-2.8-hd",
            "speech-2.8-turbo",
            "speech-2.6-hd",
            "speech-2.6-turbo",
            "speech-02-hd",
            "speech-02-turbo",
            "speech-01-hd",
            "speech-01-turbo"
          ],
          "title": "Model",
          "type": "string"
        },
        "text": {
          "maxLength": 1000000,
          "minLength": 1,
          "title": "Text",
          "type": "string",
          "ui:widget": "textarea"
        },
        "voice_id": {
          "description": "A system, cloned or designed voice ID from List Voices.",
          "minLength": 1,
          "title": "Voice Id",
          "type": "string"
        },
        "speed": {
          "default": 1.0,
          "maximum": 2,
          "minimum": 0.5,
          "title": "Speed",
          "type": "number"
        },
        "vol": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Vol",
          "type": "number"
        },
        "pitch": {
          "default": 0,
          "maximum": 12,
          "minimum": -12,
          "title": "Pitch",
          "type": "integer"
        },
        "operation": {
          "const": "create_speech_task",
          "default": "create_speech_task",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "text",
        "voice_id"
      ],
      "title": "MinimaxAsyncSpeechConfig",
      "type": "object"
    },
    "MinimaxChatConfig": {
      "additionalProperties": false,
      "description": "Generate a text reply using MiniMax's OpenAI-compatible API.",
      "properties": {
        "operation": {
          "const": "generate_text",
          "default": "generate_text",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "model": {
          "default": "MiniMax-M3.1-Flash",
          "enum": [
            "MiniMax-M3.1-Flash",
            "MiniMax-M3"
          ],
          "title": "Model",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string",
          "ui:widget": "textarea"
        },
        "system_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Prompt"
        },
        "max_completion_tokens": {
          "anyOf": [
            {
              "maximum": 524288,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Completion Tokens"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "prompt"
      ],
      "title": "MinimaxChatConfig",
      "type": "object"
    },
    "MinimaxCloneVoiceConfig": {
      "additionalProperties": false,
      "description": "Clone a voice from a file already uploaded to MiniMax.",
      "properties": {
        "operation": {
          "const": "clone_voice",
          "default": "clone_voice",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "exclusiveMinimum": 0,
          "title": "File Id",
          "type": "integer"
        },
        "voice_id": {
          "maxLength": 256,
          "minLength": 8,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*[A-Za-z0-9]$",
          "title": "Voice Id",
          "type": "string"
        },
        "need_noise_reduction": {
          "default": false,
          "title": "Need Noise Reduction",
          "type": "boolean"
        },
        "need_volume_normalization": {
          "default": false,
          "title": "Need Volume Normalization",
          "type": "boolean"
        }
      },
      "required": [
        "file_id",
        "voice_id"
      ],
      "title": "MinimaxCloneVoiceConfig",
      "type": "object"
    },
    "MinimaxCreateVideoConfig": {
      "additionalProperties": false,
      "description": "Create an H3 video task from text and an optional first-frame image.",
      "properties": {
        "operation": {
          "const": "create_video_task",
          "default": "create_video_task",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "model": {
          "default": "MiniMax-H3",
          "enum": [
            "MiniMax-H3",
            "MiniMax-H3-Highspeed",
            "MiniMax-H3-Lite",
            "MiniMax-H3-Max"
          ],
          "title": "Model",
          "type": "string"
        },
        "prompt": {
          "maxLength": 7000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string",
          "ui:widget": "textarea"
        },
        "first_frame_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public image URL or mm_file:// file reference. MiniMax fetches the media.",
          "title": "First Frame Url"
        },
        "resolution": {
          "default": "768P",
          "enum": [
            "480P",
            "768P",
            "2K"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "duration": {
          "default": 6,
          "maximum": 15,
          "minimum": 4,
          "title": "Duration",
          "type": "integer"
        },
        "ratio": {
          "default": "16:9",
          "enum": [
            "21:9",
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16"
          ],
          "title": "Ratio",
          "type": "string"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "MinimaxCreateVideoConfig",
      "type": "object"
    },
    "MinimaxDeleteFileConfig": {
      "additionalProperties": false,
      "description": "Delete a selected file from the MiniMax account.",
      "properties": {
        "operation": {
          "const": "delete_file",
          "default": "delete_file",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "exclusiveMinimum": 0,
          "title": "File Id",
          "type": "integer"
        },
        "purpose": {
          "enum": [
            "voice_clone",
            "prompt_audio",
            "t2a_async",
            "t2a_async_input",
            "video_generation"
          ],
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "purpose"
      ],
      "title": "MinimaxDeleteFileConfig",
      "type": "object"
    },
    "MinimaxDeleteVideoConfig": {
      "additionalProperties": false,
      "description": "Cancel a queued H3 task or delete a completed task.",
      "properties": {
        "task_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Task Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_video_task",
          "default": "delete_video_task",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "task_id"
      ],
      "title": "MinimaxDeleteVideoConfig",
      "type": "object"
    },
    "MinimaxDeleteVoiceConfig": {
      "additionalProperties": false,
      "description": "Delete a selected cloned or designed voice.",
      "properties": {
        "operation": {
          "const": "delete_voice",
          "default": "delete_voice",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "voice_type": {
          "enum": [
            "voice_cloning",
            "voice_generation"
          ],
          "title": "Voice Type",
          "type": "string"
        },
        "voice_id": {
          "minLength": 1,
          "title": "Voice Id",
          "type": "string"
        }
      },
      "required": [
        "voice_type",
        "voice_id"
      ],
      "title": "MinimaxDeleteVoiceConfig",
      "type": "object"
    },
    "MinimaxDesignVoiceConfig": {
      "additionalProperties": false,
      "description": "Design a voice from a description and generate a preview.",
      "properties": {
        "operation": {
          "const": "design_voice",
          "default": "design_voice",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "preview_text": {
          "minLength": 1,
          "title": "Preview Text",
          "type": "string"
        },
        "voice_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Id"
        }
      },
      "required": [
        "prompt",
        "preview_text"
      ],
      "title": "MinimaxDesignVoiceConfig",
      "type": "object"
    },
    "MinimaxGetFileConfig": {
      "additionalProperties": false,
      "description": "Retrieve a file's metadata and download URL.",
      "properties": {
        "operation": {
          "const": "get_file",
          "default": "get_file",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "exclusiveMinimum": 0,
          "title": "File Id",
          "type": "integer"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "MinimaxGetFileConfig",
      "type": "object"
    },
    "MinimaxGetModelConfig": {
      "additionalProperties": false,
      "description": "Retrieve one text model's metadata.",
      "properties": {
        "operation": {
          "const": "get_model",
          "default": "get_model",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "model_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Model Id",
          "type": "string"
        }
      },
      "required": [
        "model_id"
      ],
      "title": "MinimaxGetModelConfig",
      "type": "object"
    },
    "MinimaxGetSpeechTaskConfig": {
      "additionalProperties": false,
      "description": "Query an asynchronous speech task's status and file ID.",
      "properties": {
        "operation": {
          "const": "get_speech_task",
          "default": "get_speech_task",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "task_id": {
          "exclusiveMinimum": 0,
          "title": "Task Id",
          "type": "integer"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "MinimaxGetSpeechTaskConfig",
      "type": "object"
    },
    "MinimaxGetVideoConfig": {
      "additionalProperties": false,
      "description": "Query an H3 video task and retrieve its result URL when complete.",
      "properties": {
        "task_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Task Id",
          "type": "string"
        },
        "operation": {
          "const": "get_video_task",
          "default": "get_video_task",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "task_id"
      ],
      "title": "MinimaxGetVideoConfig",
      "type": "object"
    },
    "MinimaxImageConfig": {
      "additionalProperties": false,
      "description": "Generate images and return their temporary download URLs.",
      "properties": {
        "operation": {
          "const": "generate_image",
          "default": "generate_image",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "prompt": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Prompt",
          "type": "string",
          "ui:widget": "textarea"
        },
        "model": {
          "const": "image-01",
          "default": "image-01",
          "title": "Model",
          "type": "string"
        },
        "aspect_ratio": {
          "default": "1:1",
          "enum": [
            "1:1",
            "16:9",
            "4:3",
            "3:2",
            "2:3",
            "3:4",
            "9:16",
            "21:9"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "n": {
          "default": 1,
          "maximum": 9,
          "minimum": 1,
          "title": "N",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "prompt_optimizer": {
          "default": false,
          "title": "Prompt Optimizer",
          "type": "boolean"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "MinimaxImageConfig",
      "type": "object"
    },
    "MinimaxListFilesConfig": {
      "additionalProperties": false,
      "description": "List files belonging to the connected account, optionally by purpose.",
      "properties": {
        "operation": {
          "const": "list_files",
          "default": "list_files",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "voice_clone",
                "prompt_audio",
                "t2a_async_input",
                "video_generation_input"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose",
          "enum": [
            "voice_clone",
            "prompt_audio",
            "t2a_async_input",
            "video_generation_input"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "MinimaxListFilesConfig",
      "type": "object"
    },
    "MinimaxListModelsConfig": {
      "additionalProperties": false,
      "description": "List text models available through the OpenAI-compatible endpoint.",
      "properties": {
        "operation": {
          "const": "list_models",
          "default": "list_models",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "MinimaxListModelsConfig",
      "type": "object"
    },
    "MinimaxListVideoConfig": {
      "additionalProperties": false,
      "description": "List one page of H3 tasks with optional status and model filters.",
      "properties": {
        "operation": {
          "const": "list_video_tasks",
          "default": "list_video_tasks",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "page_num": {
          "default": 1,
          "minimum": 1,
          "title": "Page Num",
          "type": "integer"
        },
        "page_size": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "queued",
                "running",
                "succeeded",
                "failed",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "x-enum-searchable": true
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "task_type": {
          "anyOf": [
            {
              "enum": [
                "generation",
                "h3_context_ir",
                "regeneration"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Type",
          "enum": [
            "generation",
            "h3_context_ir",
            "regeneration"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "MinimaxListVideoConfig",
      "type": "object"
    },
    "MinimaxListVoicesConfig": {
      "additionalProperties": false,
      "description": "List system, cloned or designed voices.",
      "properties": {
        "operation": {
          "const": "list_voices",
          "default": "list_voices",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "voice_type": {
          "default": "all",
          "enum": [
            "system",
            "voice_cloning",
            "voice_generation",
            "all"
          ],
          "title": "Voice Type",
          "type": "string"
        }
      },
      "title": "MinimaxListVoicesConfig",
      "type": "object"
    },
    "MinimaxLyricsConfig": {
      "additionalProperties": false,
      "description": "Write a full song or edit existing lyrics.",
      "properties": {
        "operation": {
          "const": "generate_lyrics",
          "default": "generate_lyrics",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "mode": {
          "default": "write_full_song",
          "enum": [
            "write_full_song",
            "edit"
          ],
          "title": "Mode",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "lyrics": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lyrics"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "MinimaxLyricsConfig",
      "type": "object"
    },
    "MinimaxMusicConfig": {
      "additionalProperties": false,
      "description": "Generate music as a download URL, with lyrics or an instrumental prompt.",
      "properties": {
        "operation": {
          "const": "generate_music",
          "default": "generate_music",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "model": {
          "default": "music-3.0",
          "enum": [
            "music-3.0",
            "music-2.6",
            "music-3.0-free",
            "music-2.6-free"
          ],
          "title": "Model",
          "type": "string"
        },
        "prompt": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "lyrics": {
          "anyOf": [
            {
              "maxLength": 3500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lyrics"
        },
        "is_instrumental": {
          "default": false,
          "title": "Is Instrumental",
          "type": "boolean"
        },
        "lyrics_optimizer": {
          "default": true,
          "title": "Lyrics Optimizer",
          "type": "boolean"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "MinimaxMusicConfig",
      "type": "object"
    },
    "MinimaxSpeechConfig": {
      "additionalProperties": false,
      "description": "Synthesize speech synchronously and return an audio URL.",
      "properties": {
        "model": {
          "default": "speech-2.8-hd",
          "enum": [
            "speech-2.8-hd",
            "speech-2.8-turbo",
            "speech-2.6-hd",
            "speech-2.6-turbo",
            "speech-02-hd",
            "speech-02-turbo",
            "speech-01-hd",
            "speech-01-turbo"
          ],
          "title": "Model",
          "type": "string"
        },
        "text": {
          "maxLength": 9999,
          "minLength": 1,
          "title": "Text",
          "type": "string",
          "ui:widget": "textarea"
        },
        "voice_id": {
          "description": "A system, cloned or designed voice ID from List Voices.",
          "minLength": 1,
          "title": "Voice Id",
          "type": "string"
        },
        "speed": {
          "default": 1.0,
          "maximum": 2,
          "minimum": 0.5,
          "title": "Speed",
          "type": "number"
        },
        "vol": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Vol",
          "type": "number"
        },
        "pitch": {
          "default": 0,
          "maximum": 12,
          "minimum": -12,
          "title": "Pitch",
          "type": "integer"
        },
        "operation": {
          "const": "generate_speech",
          "default": "generate_speech",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "text",
        "voice_id"
      ],
      "title": "MinimaxSpeechConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "clone_voice": "#/$defs/MinimaxCloneVoiceConfig",
          "create_speech_task": "#/$defs/MinimaxAsyncSpeechConfig",
          "create_video_task": "#/$defs/MinimaxCreateVideoConfig",
          "delete_file": "#/$defs/MinimaxDeleteFileConfig",
          "delete_video_task": "#/$defs/MinimaxDeleteVideoConfig",
          "delete_voice": "#/$defs/MinimaxDeleteVoiceConfig",
          "design_voice": "#/$defs/MinimaxDesignVoiceConfig",
