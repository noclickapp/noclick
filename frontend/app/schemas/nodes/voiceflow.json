        },
        {
          "$ref": "#/$defs/DeleteDocument"
        },
        {
          "$ref": "#/$defs/QueryKnowledgeBase"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoiceflowPATCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
