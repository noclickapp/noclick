    "UpdateDocumentMetadata": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "document_id",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "update_document_metadata",
          "default": "update_document_metadata",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Knowledge Base",
          "x-display-name": "Update Document Metadata Tags",
          "x-is-trigger": false
        },
        "metadata_json": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "key": {
                  "minLength": 1,
                  "type": "string"
                },
                "values": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "key",
                "values"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "description": "JSON array of {\"key\":\"topic\",\"values\":[\"owned-fixture\"]}. Replaces document metadata; no text-replacement contract is assumed.",
          "examples": [
            "[]"
          ],
          "maxLength": 12000,
          "pattern": "^\\s*\\[[\\s\\S]*\\]\\s*$",
          "title": "Metadata Tags",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "document_id",
        "metadata_json"
      ],
      "title": "UpdateDocumentMetadata",
      "type": "object"
    },
    "VoiceflowPATCredential": {
      "properties": {
        "credential_type": {
          "const": "voiceflow_pat",
          "default": "voiceflow_pat",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "personal_access_token": {
          "maxLength": 4096,
          "minLength": 12,
          "title": "Personal Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "workspace_id": {
          "title": "Workspace ID",
          "type": "string"
        },
        "project_id": {
          "description": "Find the existing project ID under Settings > General > Metadata.",
          "title": "Project ID",
          "type": "string"
        },
        "environment_alias": {
          "description": "An existing environment alias such as main. No environment is created or published.",
          "title": "Knowledge Environment Alias",
          "type": "string"
        }
      },
      "required": [
        "personal_access_token",
        "workspace_id",
        "project_id",
        "environment_alias"
      ],
      "title": "Voiceflow Personal Access Token",
      "type": "object",
      "x-credential-instructions": "Create a personal access token under Voiceflow Settings > Access tokens. Supply its existing workspace/project IDs and environment alias. Current vfp_ tokens act with your account's access across its workspaces and expire; rotate manually before expiry. This node binds knowledge operations to the supplied project/environment and verifies current returned metadata. A returned project name identifies that project, not a human principal or universal write entitlement.",
      "x-credential-url": "https://www.voiceflow.com/docs/api-reference/authentication"
    }
  },
  "properties": {
    "config": {
      "discriminator": {
        "mapping": {
          "delete_document": "#/$defs/DeleteDocument",
          "get_agent_metadata": "#/$defs/GetAgent",
          "get_document": "#/$defs/GetDocument",
          "get_environment": "#/$defs/GetEnvironment",
          "get_project": "#/$defs/GetProject",
          "get_workspace": "#/$defs/GetWorkspace",
          "list_documents": "#/$defs/ListDocuments",
          "list_environments": "#/$defs/ListEnvironments",
          "list_projects": "#/$defs/ListProjects",
          "list_workspaces": "#/$defs/ListWorkspaces",
          "query_knowledge_base": "#/$defs/QueryKnowledgeBase",
          "update_document_metadata": "#/$defs/UpdateDocumentMetadata"
        },
