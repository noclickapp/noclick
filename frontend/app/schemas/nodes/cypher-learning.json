          "maximum": 9223372036854775807,
          "title": "User Id",
          "type": "integer"
        },
        "send_notification": {
          "default": false,
          "description": "Notify the learner of enrollment.",
          "title": "Send Notification",
          "type": "boolean"
        },
        "reenroll": {
          "default": "never",
          "enum": [
            "never",
            "only_completed",
            "always"
          ],
          "title": "Reenroll",
          "type": "string"
        },
        "increment_seats": {
          "default": false,
          "description": "Add a seat when no seats remain.",
          "title": "Increment Seats",
          "type": "boolean"
        }
      },
