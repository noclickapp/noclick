{
  "$defs": {
    "CallerapiAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "callerapi_api_key",
          "default": "callerapi_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "CallerAPI API Key",
      "type": "object",
      "x-credential-instructions": "Paste your CallerAPI API key. NoClick sends it in the X-Auth header and reads your account email and balance to verify the connection.",
      "x-credential-url": "https://callerapi.com/"
    },
    "DeleteWebhook": {
      "additionalProperties": false,
      "description": "Delete the webhook.",
      "properties": {
        "operation": {
          "const": "delete_webhook",
          "default": "delete_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "DeleteWebhook",
      "type": "object"
    },
    "GetAccount": {
      "additionalProperties": false,
      "description": "Balance and email.",
      "properties": {
        "operation": {
          "const": "get_account",
          "default": "get_account",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetAccount",
      "type": "object"
    },
    "GetNumber": {
      "additionalProperties": false,
      "description": "Read one number.",
      "properties": {
        "phone": {
          "description": "Monitored phone number in E.164 format, including +.",
          "pattern": "^\\+[1-9][0-9]{6,14}$",
          "title": "Phone",
          "type": "string"
        },
        "operation": {
          "const": "get_number",
          "default": "get_number",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "phone"
      ],
      "title": "GetNumber",
      "type": "object"
    },
    "GetOnlinePresence": {
      "additionalProperties": false,
      "description": "Online presence.",
      "properties": {
        "phone": {
          "description": "International phone number, digits only, without a leading plus.",
          "pattern": "^[1-9][0-9]{6,14}$",
          "title": "Phone",
          "type": "string"
        },
        "operation": {
          "const": "get_online_presence",
          "default": "get_online_presence",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "phone"
      ],
      "title": "GetOnlinePresence",
      "type": "object"
    },
    "GetPortedDate": {
      "additionalProperties": false,
      "description": "Ported date.",
      "properties": {
        "phone": {
          "description": "International phone number, digits only, without a leading plus.",
          "pattern": "^[1-9][0-9]{6,14}$",
          "title": "Phone",
          "type": "string"
        },
        "operation": {
          "const": "get_ported_date",
          "default": "get_ported_date",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "phone"
      ],
      "title": "GetPortedDate",
      "type": "object"
    },
    "GetPortingHistory": {
      "additionalProperties": false,
      "description": "Porting history.",
      "properties": {
        "phone": {
          "description": "International phone number, digits only, without a leading plus.",
          "pattern": "^[1-9][0-9]{6,14}$",
          "title": "Phone",
          "type": "string"
        },
        "operation": {
          "const": "get_porting_history",
          "default": "get_porting_history",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "phone"
      ],
      "title": "GetPortingHistory",
      "type": "object"
    },
    "GetSchedule": {
      "additionalProperties": false,
      "description": "Read the check schedule.",
      "properties": {
        "list_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Monitoring list ID; omit for the account default.",
          "title": "List Id"
        },
        "operation": {
          "const": "get_schedule",
          "default": "get_schedule",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetSchedule",
      "type": "object"
    },
    "GetVoiceSession": {
      "additionalProperties": false,
      "description": "Get one session with verdict and intel.",
      "properties": {
        "operation": {
          "const": "get_voice_session",
          "default": "get_voice_session",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "session_id": {
          "description": "Session ID from a scan or event.",
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "GetVoiceSession",
      "type": "object"
    },
    "GetWebhook": {
      "additionalProperties": false,
      "description": "Read the webhook.",
      "properties": {
        "operation": {
          "const": "get_webhook",
          "default": "get_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetWebhook",
      "type": "object"
    },
    "ListNumbers": {
      "additionalProperties": false,
      "description": "List number status.",
      "properties": {
        "list_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Monitoring list ID; omit for the account default.",
          "title": "List Id"
        },
        "operation": {
          "const": "list_numbers",
          "default": "list_numbers",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "pending",
                "clean",
                "flagged",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "pending",
            "clean",
            "flagged",
            "unknown"
          ],
          "x-enum-searchable": true
        },
        "limit": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "next_cursor from the previous page; retain the same status and list_id.",
          "title": "Cursor"
        }
      },
      "title": "ListNumbers",
      "type": "object"
    },
    "ListVoiceSessions": {
      "additionalProperties": false,
      "description": "List your recent sessions.",
      "properties": {
        "operation": {
          "const": "list_voice_sessions",
          "default": "list_voice_sessions",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "limit": {
          "default": 50,
          "description": "Maximum recent sessions to return; this endpoint has no cursor.",
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "ListVoiceSessions",
      "type": "object"
    },
    "LookupPhone": {
      "additionalProperties": false,
      "description": "Spam score + HLR.",
      "properties": {
        "phone": {
          "description": "International phone number, digits only, without a leading plus.",
          "pattern": "^[1-9][0-9]{6,14}$",
          "title": "Phone",
          "type": "string"
        },
        "operation": {
          "const": "lookup_phone",
          "default": "lookup_phone",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "hlr": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Request the optional HLR lookup; provider charges apply.",
          "title": "Hlr"
        }
      },
      "required": [
        "phone"
      ],
      "title": "LookupPhone",
      "type": "object"
    },
    "RemoveNumber": {
      "additionalProperties": false,
      "description": "Remove a number.",
      "properties": {
        "phone": {
          "description": "Monitored phone number in E.164 format, including +.",
          "pattern": "^\\+[1-9][0-9]{6,14}$",
          "title": "Phone",
          "type": "string"
        },
        "operation": {
          "const": "remove_number",
          "default": "remove_number",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "phone"
      ],
      "title": "RemoveNumber",
      "type": "object"
    },
    "RotateWebhookSecret": {
      "additionalProperties": false,
      "description": "Rotate the webhook secret.",
      "properties": {
        "operation": {
          "const": "rotate_webhook_secret",
          "default": "rotate_webhook_secret",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "RotateWebhookSecret",
      "type": "object"
    },
    "SaveWebhook": {
      "additionalProperties": false,
      "description": "Save the webhook URL.",
      "properties": {
        "operation": {
          "const": "save_webhook",
          "default": "save_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "url": {
          "description": "Public HTTPS receiver URL on port 443 or 8443. The response contains the signing secret once.",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "SaveWebhook",
      "type": "object"
    },
    "ScanTranscript": {
      "additionalProperties": false,
      "description": "Score a transcript or a recording.",
      "properties": {
        "operation": {
          "const": "scan_transcript",
          "default": "scan_transcript",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "transcript": {
          "description": "Call transcript to score. Provider charges apply.",
          "minLength": 1,
          "title": "Transcript",
          "type": "string"
        },
        "caller_number": {
          "anyOf": [
            {
              "pattern": "^\\+[1-9][0-9]{6,14}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Caller E.164 number; required when reporting.",
          "title": "Caller Number"
        },
        "called_number": {
          "anyOf": [
            {
              "pattern": "^\\+[1-9][0-9]{6,14}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Called Number"
        },
        "report": {
          "default": false,
          "description": "File complaints when the score is at least 0.8.",
          "title": "Report",
          "type": "boolean"
        }
      },
      "required": [
        "transcript"
      ],
      "title": "ScanTranscript",
      "type": "object"
    },
    "SetSchedule": {
      "additionalProperties": false,
      "description": "Set the check schedule.",
      "properties": {
        "list_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Monitoring list ID; omit for the account default.",
          "title": "List Id"
        },
        "operation": {
          "const": "set_schedule",
          "default": "set_schedule",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "interval",
                "times"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode",
          "enum": [
            "interval",
            "times"
          ],
          "x-enum-searchable": true
        },
        "interval_minutes": {
          "anyOf": [
            {
              "enum": [
                15,
                30,
                60,
                120,
                180,
                240,
                360,
                480,
                720,
                1440
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Minutes"
        },
        "times": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 24,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Times"
        },
        "weekdays": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weekdays"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IANA timezone, such as UTC or America/New_York.",
          "title": "Timezone"
        }
      },
      "title": "SetSchedule",
      "type": "object"
    },
    "SubmitNumbers": {
      "additionalProperties": false,
      "description": "Submit numbers.",
      "properties": {
        "list_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Monitoring list ID; omit for the account default.",
          "title": "List Id"
        },
        "operation": {
          "const": "submit_numbers",
          "default": "submit_numbers",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "numbers": {
          "description": "E.164 numbers, or national numbers with default_country. Each scheduled check uses credits.",
          "items": {
            "type": "string"
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Numbers",
          "type": "array"
        },
        "default_country": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 3166 two-letter country code for national numbers.",
          "title": "Default Country"
        }
      },
      "required": [
        "numbers"
      ],
      "title": "SubmitNumbers",
      "type": "object"
    },
    "TestWebhook": {
      "additionalProperties": false,
      "description": "Send a test event.",
      "properties": {
        "operation": {
          "const": "test_webhook",
          "default": "test_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "TestWebhook",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "delete_webhook": "#/$defs/DeleteWebhook",
          "get_account": "#/$defs/GetAccount",
          "get_number": "#/$defs/GetNumber",
          "get_online_presence": "#/$defs/GetOnlinePresence",
          "get_ported_date": "#/$defs/GetPortedDate",
          "get_porting_history": "#/$defs/GetPortingHistory",
          "get_schedule": "#/$defs/GetSchedule",
          "get_voice_session": "#/$defs/GetVoiceSession",
          "get_webhook": "#/$defs/GetWebhook",
          "list_numbers": "#/$defs/ListNumbers",
          "list_voice_sessions": "#/$defs/ListVoiceSessions",
          "lookup_phone": "#/$defs/LookupPhone",
          "remove_number": "#/$defs/RemoveNumber",
          "rotate_webhook_secret": "#/$defs/RotateWebhookSecret",
          "save_webhook": "#/$defs/SaveWebhook",
          "scan_transcript": "#/$defs/ScanTranscript",
          "set_schedule": "#/$defs/SetSchedule",
          "submit_numbers": "#/$defs/SubmitNumbers",
          "test_webhook": "#/$defs/TestWebhook"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetAccount"
        },
        {
          "$ref": "#/$defs/LookupPhone"
        },
        {
          "$ref": "#/$defs/GetPortedDate"
        },
        {
          "$ref": "#/$defs/GetPortingHistory"
        },
        {
          "$ref": "#/$defs/GetOnlinePresence"
        },
        {
          "$ref": "#/$defs/ScanTranscript"
        },
        {
          "$ref": "#/$defs/ListVoiceSessions"
        },
        {
          "$ref": "#/$defs/GetVoiceSession"
        },
        {
          "$ref": "#/$defs/SubmitNumbers"
        },
        {
          "$ref": "#/$defs/ListNumbers"
        },
        {
          "$ref": "#/$defs/GetNumber"
        },
        {
          "$ref": "#/$defs/RemoveNumber"
        },
        {
          "$ref": "#/$defs/GetSchedule"
        },
        {
          "$ref": "#/$defs/SetSchedule"
        },
        {
          "$ref": "#/$defs/SaveWebhook"
        },
        {
          "$ref": "#/$defs/GetWebhook"
        },
        {
          "$ref": "#/$defs/DeleteWebhook"
        },
        {
          "$ref": "#/$defs/TestWebhook"
        },
        {
          "$ref": "#/$defs/RotateWebhookSecret"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/CallerapiAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Callerapi Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
