{
  "$defs": {
    "CreateBot": {
      "additionalProperties": false,
      "description": "Send a bot now or schedule it to join a meeting; requires meeting recording consent.",
      "properties": {
        "operation": {
          "const": "create_bot",
          "default": "create_bot",
          "title": "Operation",
          "type": "string"
        },
        "meeting_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Meeting Url",
          "type": "string"
        },
        "bot_name": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit for the provider default: Meeting Notetaker.",
          "title": "Bot Name"
        },
        "join_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 time. Schedule at least 10 minutes ahead for production reliability; omit to join now.",
          "title": "Join At"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata"
        }
      },
      "required": [
        "meeting_url"
      ],
      "title": "CreateBot",
      "type": "object"
    },
