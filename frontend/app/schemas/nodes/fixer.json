{
  "$defs": {
    "ConvertCurrency": {
      "description": "Convert an amount using the latest available exchange rate.",
      "properties": {
        "from_currency": {
          "description": "Source currency code, for example EUR.",
          "title": "From currency",
          "type": "string"
        },
        "to_currency": {
          "description": "Target currency code, for example GBP.",
          "title": "To currency",
          "type": "string"
        },
        "amount": {
          "description": "Amount to convert.",
          "title": "Amount",
          "type": "number"
        },
        "operation": {
          "const": "convert_currency",
          "default": "convert_currency",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "from_currency",
        "to_currency",
        "amount"
      ],
      "title": "ConvertCurrency",
      "type": "object"
    },
    "ConvertHistoricalCurrency": {
      "description": "Convert an amount using a specified historical date.",
      "properties": {
        "from_currency": {
          "description": "Source currency code, for example EUR.",
          "title": "From currency",
          "type": "string"
        },
        "to_currency": {
          "description": "Target currency code, for example GBP.",
          "title": "To currency",
          "type": "string"
        },
        "amount": {
          "description": "Amount to convert.",
          "title": "Amount",
          "type": "number"
        },
        "operation": {
          "const": "convert_historical_currency",
          "default": "convert_historical_currency",
          "title": "Operation",
          "type": "string"
        },
        "date": {
          "description": "Conversion date, YYYY-MM-DD.",
          "title": "Date",
          "type": "string"
        }
      },
      "required": [
        "from_currency",
        "to_currency",
        "amount",
        "date"
      ],
      "title": "ConvertHistoricalCurrency",
      "type": "object"
    },
    "FixerAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "fixer_api_key",
          "default": "fixer_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Fixer API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Fixer API access key from your dashboard. NoClick sends it as access_key over HTTPS to data.fixer.io. Some operations, custom base currencies and bid/ask quotes require a paid plan. The connection read checks that the key is accepted; it does not identify an account.",
      "x-credential-url": "https://fixer.io/dashboard"
    },
    "GetFluctuations": {
      "description": "Get currency change and percentage change between two dates.",
      "properties": {
        "base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional base currency; Fixer defaults to EUR. Changing it requires a supported plan.",
          "title": "Base"
        },
        "symbols": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional comma-separated currency codes, for example USD,GBP,JPY. Omit for all currencies.",
          "title": "Symbols"
        },
        "start_date": {
          "description": "Start date, YYYY-MM-DD.",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "description": "End date, YYYY-MM-DD.",
          "title": "End Date",
          "type": "string"
        },
        "operation": {
          "const": "get_fluctuations",
          "default": "get_fluctuations",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "GetFluctuations",
      "type": "object"
    },
