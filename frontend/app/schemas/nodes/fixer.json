  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "convert_currency": "#/$defs/ConvertCurrency",
          "convert_historical_currency": "#/$defs/ConvertHistoricalCurrency",
          "get_fluctuations": "#/$defs/GetFluctuations",
          "get_historical_quotes": "#/$defs/GetHistoricalQuotes",
          "get_historical_rates": "#/$defs/GetHistoricalRates",
          "get_latest_quotes": "#/$defs/GetLatestQuotes",
          "get_latest_rates": "#/$defs/GetLatestRates",
          "get_time_series": "#/$defs/GetTimeSeries",
          "get_time_series_quotes": "#/$defs/GetTimeSeriesQuotes",
          "list_currencies": "#/$defs/ListCurrencies"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListCurrencies"
        },
        {
          "$ref": "#/$defs/GetLatestRates"
        },
        {
          "$ref": "#/$defs/GetLatestQuotes"
        },
        {
          "$ref": "#/$defs/GetHistoricalRates"
        },
        {
          "$ref": "#/$defs/GetHistoricalQuotes"
        },
        {
          "$ref": "#/$defs/ConvertCurrency"
        },
        {
          "$ref": "#/$defs/ConvertHistoricalCurrency"
        },
        {
          "$ref": "#/$defs/GetTimeSeries"
        },
        {
          "$ref": "#/$defs/GetTimeSeriesQuotes"
        },
        {
          "$ref": "#/$defs/GetFluctuations"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/FixerAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
