        "client_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Key"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "order_number"
      ],
      "title": "OrderStatus",
      "type": "object"
    },
    "ParcelLabAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "parcellab_api_token",
          "default": "parcellab_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "title": "Encoded API Token",
          "type": "string",
          "ui:widget": "password"
        },
        "region": {
          "default": "global",
          "enum": [
            "global",
            "eu",
            "us"
          ],
          "title": "API Region",
          "type": "string"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "parcelLab API Token",
      "type": "object",
      "x-credential-instructions": "Paste the complete already base64-encoded account token. No Bearer prefix, extra encoding, account ID or JWT is needed. Required permissions depend on the selected API feature.",
      "x-credential-url": "https://app.parcellab.com/service/account/apitoken/"
    },
    "Place": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_pudo_location",
          "default": "get_pudo_location",
          "title": "Operation",
          "type": "string",
          "x-display-name": "Get Pickup or Drop-Off Location"
        },
        "place_id": {
          "format": "uuid",
          "title": "Place Id",
          "type": "string"
        }
      },
      "required": [
        "place_id"
      ],
      "title": "Place",
      "type": "object"
    },
    "PredictDelivery": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "predict_delivery",
          "default": "predict_delivery",
          "title": "Operation",
          "type": "string",
          "x-display-name": "Predict Delivery Date"
        },
        "destination_country_iso3": {
          "pattern": "^[A-Z]{3}$",
          "title": "Destination Country Iso3",
          "type": "string"
        },
        "destination_postal_code": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Postal Code"
        },
        "courier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Courier"
        },
        "warehouse": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warehouse"
        },
        "service_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Level"
        },
        "calibration": {
          "default": "balanced",
          "enum": [
            "conservative",
            "balanced",
            "aggressive"
          ],
          "title": "Calibration",
          "type": "string"
        }
      },
      "required": [
        "destination_country_iso3"
      ],
      "title": "PredictDelivery",
      "type": "object"
    },
    "Return": {
      "additionalProperties": false,
