  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_tracking": "#/$defs/AddTracking",
          "create_order": "#/$defs/CreateOrder",
          "find_pudo_locations": "#/$defs/FindPlaces",
