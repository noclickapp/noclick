{
  "$defs": {
    "AddTracking": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "add_tracking",
          "default": "add_tracking",
          "title": "Operation",
          "type": "string",
          "x-display-name": "Add or Update Order Tracking"
        },
        "order_id": {
          "title": "External Order ID",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "order_id",
            "placeholder": "Select an order",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "courier": {
          "title": "Courier",
          "type": "string"
        },
        "tracking_number": {
          "title": "Tracking Number",
          "type": "string"
        },
        "notifications_inactive": {
          "default": true,
          "description": "Requests notification suppression for this tracking; actual configured effects require verification",
          "title": "Notifications Inactive",
          "type": "boolean"
        },
        "confirm_order_write": {
          "const": true,
          "description": "Registers or updates tracking and may activate configured shipment workflows",
          "title": "Confirm Tracking Update",
          "type": "boolean"
        }
      },
      "required": [
        "order_id",
        "courier",
        "tracking_number",
        "confirm_order_write"
      ],
      "title": "AddTracking",
      "type": "object"
    },
    "CreateOrder": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_order",
          "default": "create_order",
          "title": "Operation",
          "type": "string",
          "x-display-name": "Create Order"
        },
        "order_number": {
          "title": "Order Number",
          "type": "string"
        },
        "destination_country_iso3": {
          "pattern": "^[A-Z]{3}$",
          "title": "Destination Country Iso3",
          "type": "string"
        },
        "recipient_email": {
          "default": "_unset",
          "description": "Use _unset when no recipient email is available; this is an actual order record",
          "title": "Recipient Email",
          "type": "string"
        },
        "client_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Key"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Tags",
          "type": "array"
        },
        "confirm_order_write": {
          "const": true,
          "description": "Creates an order and may affect configured customer workflows; no live mutation is performed while editing",
          "title": "Confirm Order Creation",
          "type": "boolean"
        }
      },
      "required": [
        "order_number",
        "destination_country_iso3",
        "confirm_order_write"
      ],
      "title": "CreateOrder",
      "type": "object"
    },
    "FindPlaces": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "find_pudo_locations",
          "default": "find_pudo_locations",
          "title": "Operation",
          "type": "string",
          "x-display-name": "Find Pickup or Drop-Off Locations"
        },
        "courier": {
          "title": "Courier",
          "type": "string"
        },
        "country_iso3": {
          "pattern": "^[A-Z]{3}$",
          "title": "Country Iso3",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "max_distance": {
          "default": 20,
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Max Distance",
          "type": "number"
        },
        "distance_unit": {
          "default": "km",
          "enum": [
            "km",
            "mi"
          ],
          "title": "Distance Unit",
          "type": "string"
        },
        "criterion": {
          "default": "collection_point",
          "enum": [
            "dropoff_location",
            "collection_point"
          ],
          "title": "Criterion",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "courier",
        "country_iso3",
        "latitude",
        "longitude"
      ],
      "title": "FindPlaces",
      "type": "object"
    },
    "ListConfigurations": {
      "additionalProperties": false,
      "properties": {
        "page_size": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Token"
        },
        "operation": {
          "const": "list_return_configurations",
          "default": "list_return_configurations",
          "title": "Operation",
          "type": "string",
          "x-display-name": "List Return Configurations"
        }
      },
      "title": "ListConfigurations",
      "type": "object"
    },
    "ListOrders": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_orders",
          "default": "list_orders",
          "title": "Operation",
          "type": "string",
          "x-display-name": "List Orders"
        },
        "order_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Number"
        },
        "external_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Reference"
        },
        "page_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use only the next_page_token from this same filtered operation",
          "title": "Page Token"
        }
      },
      "title": "ListOrders",
      "type": "object"
    },
    "ListReturns": {
      "additionalProperties": false,
      "properties": {
        "page_size": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Token"
        },
        "operation": {
          "const": "list_returns",
          "default": "list_returns",
          "title": "Operation",
          "type": "string",
          "x-display-name": "List Return Registrations"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "search": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search"
        },
        "return_status": {
          "anyOf": [
            {
              "enum": [
                "approved",
                "cancelled",
                "closed",
                "created",
                "invalid",
                "pending_approval",
                "pending_label",
                "pending_payment",
                "processing_failed",
                "rejected",
                "submitted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Status",
          "enum": [
            "approved",
            "cancelled",
            "closed",
            "created",
            "invalid",
            "pending_approval",
            "pending_label",
            "pending_payment",
            "processing_failed",
            "rejected",
            "submitted"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "ListReturns",
      "type": "object"
    },
    "ListTemplates": {
      "additionalProperties": false,
      "properties": {
        "page_size": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Token"
        },
        "operation": {
          "const": "list_return_document_templates",
          "default": "list_return_document_templates",
