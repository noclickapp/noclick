    "Order": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_order",
          "default": "get_order",
          "title": "Operation",
          "type": "string",
          "x-display-name": "Get Order Metadata"
        },
        "order_id": {
          "title": "External Order ID",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "order_id",
            "placeholder": "Select an order",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "order_id"
      ],
      "title": "Order",
      "type": "object"
    },
    "OrderStatus": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_order_status",
          "default": "get_order_status",
          "title": "Operation",
          "type": "string",
          "x-display-name": "Get Order Delivery Status"
        },
        "order_number": {
          "title": "Order Number",
          "type": "string"
