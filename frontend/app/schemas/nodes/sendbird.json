{
  "$defs": {
    "CreateGroupChannel": {
      "additionalProperties": false,
      "description": "Create group channel in the connected Sendbird application.",
      "properties": {
        "operation": {
          "const": "create_group_channel",
          "default": "create_group_channel",
          "title": "Create Group Channel",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 191,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "user_ids": {
          "description": "Existing users to invite; sent as the documented users objects.",
          "items": {
            "description": "Sendbird ID; copied exactly from your application.",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[^/\\\\?#\\s]+$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "User Ids",
          "type": "array"
        },
        "is_distinct": {
          "default": false,
          "description": "Reuse a channel for the same members when true.",
          "title": "Is Distinct",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "user_ids"
      ],
      "title": "CreateGroupChannel",
      "type": "object"
    },
    "CreateUser": {
      "additionalProperties": false,
