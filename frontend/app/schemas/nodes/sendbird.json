        "app_id": {
          "description": "The application ID, without a URL or api- prefix.",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,99}$",
          "title": "Application ID",
          "type": "string"
