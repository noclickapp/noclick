        "nickname": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Nickname",
          "type": "string"
        },
        "profile_url": {
          "default": "",
          "description": "Profile image URL; empty uses no image.",
          "maxLength": 2048,
          "title": "Profile Url",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "nickname"
      ],
      "title": "CreateUser",
      "type": "object"
    },
