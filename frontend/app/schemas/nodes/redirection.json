    "RedirectionCreateRuleConfig": {
      "additionalProperties": false,
      "description": "Create a draft rule with redirect, header, status or HTML actions.",
      "properties": {
        "project_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Project ID",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/RuleTrigger"
        },
        "actions": {
          "items": {
            "discriminator": {
              "mapping": {
                "customHtml": "#/$defs/HtmlAction",
                "customStatus": "#/$defs/StatusAction",
                "header": "#/$defs/HeaderAction",
                "redirection": "#/$defs/RedirectAction"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RedirectAction"
              },
              {
                "$ref": "#/$defs/HeaderAction"
              },
              {
                "$ref": "#/$defs/StatusAction"
              },
              {
                "$ref": "#/$defs/HtmlAction"
              }
            ]
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata"
        },
        "operation": {
          "const": "create_rule",
          "default": "create_rule",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "project_id",
        "trigger",
        "actions"
      ],
