    "ResponsysAuthTokenCredential": {
      "additionalProperties": true,
      "properties": {
        "account_endpoint": {
          "description": "The exact REST endPoint returned with this authToken; login and AFTM hosts are not account REST origins.",
          "title": "Issued Account Endpoint",
          "type": "string"
        },
        "auth_token_expires_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
