        },
        {
          "$ref": "#/$defs/AddContactsConfig"
        },
        {
          "$ref": "#/$defs/DeleteContactsConfig"
        },
        {
          "$ref": "#/$defs/UnsubscribeContactsConfig"
        },
        {
          "$ref": "#/$defs/GetContactCountConfig"
        },
        {
          "$ref": "#/$defs/ListVariablesConfig"
        },
        {
          "$ref": "#/$defs/ListCampaignsConfig"
        },
        {
