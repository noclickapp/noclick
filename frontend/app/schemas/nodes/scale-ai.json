        "fine_tune_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$",
          "title": "Fine Tune Id",
          "type": "string"
        },
        "operation": {
          "const": "cancel_fine_tune",
          "default": "cancel_fine_tune",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "fine_tune_id"
      ],
      "title": "CancelFineTune",
      "type": "object"
    },
    "CreateAsyncTask": {
      "additionalProperties": false,
      "description": "Submit JSON model inputs for asynchronous inference.",
      "properties": {
        "model_endpoint_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$",
          "title": "Model Endpoint Id",
          "type": "string"
        },
        "operation": {
          "const": "create_async_task",
          "default": "create_async_task",
          "title": "Operation",
          "type": "string"
        },
        "args": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "description": "JSON input in the deployed model's request format.",
          "title": "Args"
        }
      },
      "required": [
        "model_endpoint_id",
        "args"
      ],
      "title": "CreateAsyncTask",
      "type": "object"
    },
    "CreateFineTune": {
      "additionalProperties": false,
      "description": "Start a paid fine-tuning job using an existing training file.",
      "properties": {
        "operation": {
          "const": "create_fine_tune",
          "default": "create_fine_tune",
          "title": "Operation",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "training_file": {
          "minLength": 1,
          "title": "Training File",
          "type": "string"
        },
        "validation_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation File"
        },
        "hyperparameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ]
          },
          "title": "Hyperparameters",
          "type": "object"
        },
        "suffix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
