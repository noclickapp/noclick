    "CreateSyncTask": {
      "additionalProperties": false,
      "description": "Run synchronous inference with JSON model inputs.",
      "properties": {
        "model_endpoint_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$",
          "title": "Model Endpoint Id",
          "type": "string"
        },
        "operation": {
          "const": "create_sync_task",
          "default": "create_sync_task",
          "title": "Operation",
          "type": "string"
        },
        "args": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "description": "JSON input in the deployed model's request format.",
          "title": "Args"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "num_retries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider-side inference retries; NoClick does not retry the HTTP request.",
          "title": "Num Retries"
        }
      },
      "required": [
        "model_endpoint_id",
        "args"
      ],
      "title": "CreateSyncTask",
      "type": "object"
    },
