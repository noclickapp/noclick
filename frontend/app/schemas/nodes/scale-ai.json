        "gpu_type": {
          "anyOf": [
            {
              "enum": [
                "nvidia-tesla-t4",
                "nvidia-ampere-a10",
                "nvidia-ampere-a100",
                "nvidia-ampere-a100e",
                "nvidia-hopper-h100",
                "nvidia-hopper-h100-1g20gb",
                "nvidia-hopper-h100-3g40gb"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Type",
          "enum": [
            "nvidia-tesla-t4",
            "nvidia-ampere-a10",
            "nvidia-ampere-a100",
            "nvidia-ampere-a100e",
            "nvidia-hopper-h100",
            "nvidia-hopper-h100-1g20gb",
            "nvidia-hopper-h100-3g40gb"
          ],
          "x-enum-searchable": true
        },
        "memory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Memory"
        },
        "storage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Storage"
        },
        "min_workers": {
          "minimum": 0,
          "title": "Min Workers",
          "type": "integer"
        },
        "max_workers": {
          "minimum": 0,
          "title": "Max Workers",
          "type": "integer"
        },
        "per_worker": {
          "exclusiveMinimum": 0,
          "title": "Per Worker",
          "type": "integer"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "operation": {
          "const": "create_model_endpoint",
          "default": "create_model_endpoint",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 63,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "endpoint_type": {
          "enum": [
            "async",
            "sync",
            "streaming"
          ],
          "title": "Endpoint Type",
          "type": "string"
        }
