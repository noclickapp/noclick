        "model",
        "training_file"
      ],
      "title": "CreateFineTune",
      "type": "object"
    },
    "CreateModelEndpoint": {
      "additionalProperties": false,
      "description": "Deploy a bundle on provisioned workers. This allocates paid compute.",
