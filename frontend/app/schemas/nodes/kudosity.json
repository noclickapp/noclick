    "SendMMS": {
      "additionalProperties": false,
      "properties": {
        "sender": {
          "description": "Sender registered on your account; RCS uses an agent ID.",
          "minLength": 1,
          "title": "Sender",
          "type": "string"
        },
        "recipient": {
          "description": "Opted-in recipient in international phone format.",
          "minLength": 1,
          "title": "Recipient",
          "type": "string"
        },
        "message_ref": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Ref"
        },
        "operation": {
          "const": "send_mms",
          "default": "send_mms",
          "title": "Operation",
          "type": "string"
        },
        "content_urls": {
          "description": "One public media URL up to 400 KB. MMS currently supports Australian recipients only.",
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Content Urls",
          "type": "array"
        },
        "subject": {
          "anyOf": [
            {
              "maxLength": 20,
              "pattern": "^[\\x00-\\x7F]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "track_links": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Links"
        }
      },
      "required": [
        "sender",
        "recipient",
        "content_urls"
      ],
      "title": "SendMMS",
      "type": "object"
    },
