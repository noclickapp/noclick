        "operation": {
          "const": "create_webhook",
          "default": "create_webhook",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "CreateWebhook",
      "type": "object"
    },
