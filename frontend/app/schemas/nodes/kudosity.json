    "CheckRcsCapabilities": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "check_rcs_capabilities",
          "default": "check_rcs_capabilities",
          "title": "Operation",
          "type": "string"
        },
        "sender": {
          "minLength": 1,
          "title": "Sender",
          "type": "string"
        },
        "phone_numbers": {
          "description": "E.164 numbers without a leading plus.",
