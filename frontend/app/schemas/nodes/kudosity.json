      ],
      "title": "Kudosity API Key",
      "type": "object",
      "x-credential-instructions": "In your Kudosity account, open Settings and scroll to API Settings. Copy your Messaging API key and paste it here. NoClick sends it in x-api-key to api.transmitmessage.com. Legacy TransmitSMS API keys and secrets use a different API.",
      "x-credential-url": "https://developers.kudosity.com/reference/authentication"
    },
    "ListRcsMessages": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 25,
          "description": "One page only. Use meta.pagination.next_cursor from the previous response.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "direction": {
          "default": "next",
          "enum": [
            "next",
            "prev"
          ],
          "title": "Direction",
          "type": "string"
        },
        "date_range": {
          "default": "all",
          "enum": [
            "last_week",
            "last_thirty",
            "last_month",
            "all"
