        "url": {
          "description": "Public HTTPS destination accepting JSON POST events.",
          "pattern": "^https://[^\\s]+$",
          "title": "Url",
          "type": "string"
        },
        "rate_limit": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
