          "maxItems": 100,
          "minItems": 1,
          "title": "Phone Numbers",
          "type": "array"
        }
      },
      "required": [
        "sender",
        "phone_numbers"
      ],
      "title": "CheckRcsCapabilities",
      "type": "object"
    },
    "CreateWebhook": {
