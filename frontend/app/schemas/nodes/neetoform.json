{
  "$defs": {
    "CloneForm": {
      "additionalProperties": false,
      "description": "Copy the published form as a new unpublished draft without submissions.",
      "properties": {
        "form_id": {
          "title": "Form",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "form_id",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "clone_form",
          "default": "clone_form",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "form_id"
      ],
      "title": "CloneForm",
      "type": "object"
    },
    "CountForms": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "count_forms",
          "default": "count_forms",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "CountForms",
      "type": "object"
    },
    "CreateForm": {
      "additionalProperties": false,
      "description": "Create an unpublished draft for an active workspace member.",
      "properties": {
        "operation": {
          "const": "create_form",
          "default": "create_form",
          "title": "Operation",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "created_by_email": {
          "description": "Email of an active workspace member. Required when using an API key.",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Created By Email",
          "type": "string"
        },
        "style": {
          "default": "single_page",
          "enum": [
            "single_page",
            "one_question_at_a_time"
          ],
          "title": "Style",
          "type": "string"
        }
      },
      "required": [
        "title",
        "created_by_email"
      ],
      "title": "CreateForm",
      "type": "object"
    },
    "CreateFormWebhook": {
      "additionalProperties": false,
      "description": "Register a callback that receives this form's submission events.",
      "properties": {
        "endpoint": {
          "description": "Public HTTPS URL that receives submission events.",
          "maxLength": 4096,
          "title": "Endpoint",
          "type": "string"
        },
        "events": {
          "items": {
            "const": "submit",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "secret": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional signing secret for webhook deliveries.",
          "title": "Secret",
          "ui:widget": "password"
        },
        "form_id": {
          "title": "Form",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "form_id",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "create_form_webhook",
          "default": "create_form_webhook",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "form_id"
      ],
      "title": "CreateFormWebhook",
      "type": "object"
    },
    "CreateWorkspaceWebhook": {
      "additionalProperties": false,
      "description": "Register a callback that receives submission events across the workspace.",
