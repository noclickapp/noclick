    "LearnWorldsAccessTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "learnworlds_access_token",
          "default": "learnworlds_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "school_url": {
          "description": "Original HTTPS school.learnworlds.com URL; /admin/api or /admin/api/v2 may be included.",
