{
  "$defs": {
    "EmailAddress": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "maxLength": 254,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "email"
      ],
      "title": "EmailAddress",
      "type": "object"
    },
    "EmailMessage": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/EmailAddress",
          "description": "Address on your verified sending domain.",
          "title": "From"
        },
        "to": {
          "items": {
            "$ref": "#/$defs/EmailAddress"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "To",
          "type": "array"
        },
        "subject": {
          "maxLength": 998,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "text": {
          "maxLength": 1000000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "html": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Html"
        }
      },
      "required": [
        "from",
        "to",
        "subject",
        "text"
      ],
      "title": "EmailMessage",
      "type": "object"
    },
    "MailerSendAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "mailersend_api_token",
          "default": "mailersend_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
