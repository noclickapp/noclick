          "add_unsubscribe_recipients": "#/$defs/MailerSendAddUnsubscribeRecipientsConfig",
          "delete_recipient": "#/$defs/MailerSendDeleteRecipientConfig",
          "delete_scheduled_message": "#/$defs/MailerSendDeleteScheduledMessageConfig",
          "get_bulk_email_status": "#/$defs/MailerSendGetBulkEmailStatusConfig",
          "get_domain": "#/$defs/MailerSendGetDomainConfig",
          "get_domain_dns_records": "#/$defs/MailerSendGetDomainDnsRecordsConfig",
          "get_message": "#/$defs/MailerSendGetMessageConfig",
          "get_recipient": "#/$defs/MailerSendGetRecipientConfig",
          "get_scheduled_message": "#/$defs/MailerSendGetScheduledMessageConfig",
          "list_blocklist": "#/$defs/MailerSendListBlocklistConfig",
          "list_domains": "#/$defs/MailerSendListDomainsConfig",
          "list_hard_bounces": "#/$defs/MailerSendListHardBouncesConfig",
          "list_messages": "#/$defs/MailerSendListMessagesConfig",
          "list_recipients": "#/$defs/MailerSendListRecipientsConfig",
          "list_scheduled_messages": "#/$defs/MailerSendListScheduledMessagesConfig",
          "list_templates": "#/$defs/MailerSendListTemplatesConfig",
          "list_unsubscribes": "#/$defs/MailerSendListUnsubscribesConfig",
          "send_bulk_email": "#/$defs/MailerSendSendBulkEmailConfig",
          "send_email": "#/$defs/MailerSendSendEmailConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MailerSendSendEmailConfig"
        },
        {
          "$ref": "#/$defs/MailerSendSendBulkEmailConfig"
        },
        {
          "$ref": "#/$defs/MailerSendGetBulkEmailStatusConfig"
        },
        {
          "$ref": "#/$defs/MailerSendListDomainsConfig"
        },
        {
          "$ref": "#/$defs/MailerSendGetDomainConfig"
        },
        {
          "$ref": "#/$defs/MailerSendGetDomainDnsRecordsConfig"
        },
        {
          "$ref": "#/$defs/MailerSendListTemplatesConfig"
        },
        {
          "$ref": "#/$defs/MailerSendListMessagesConfig"
        },
        {
          "$ref": "#/$defs/MailerSendGetMessageConfig"
        },
        {
          "$ref": "#/$defs/MailerSendListScheduledMessagesConfig"
        },
        {
          "$ref": "#/$defs/MailerSendGetScheduledMessageConfig"
        },
        {
          "$ref": "#/$defs/MailerSendDeleteScheduledMessageConfig"
        },
        {
          "$ref": "#/$defs/MailerSendListRecipientsConfig"
        },
        {
          "$ref": "#/$defs/MailerSendGetRecipientConfig"
        },
        {
          "$ref": "#/$defs/MailerSendDeleteRecipientConfig"
        },
        {
          "$ref": "#/$defs/MailerSendListBlocklistConfig"
        },
        {
          "$ref": "#/$defs/MailerSendAddBlocklistRecipientsConfig"
        },
        {
          "$ref": "#/$defs/MailerSendListHardBouncesConfig"
        },
        {
          "$ref": "#/$defs/MailerSendListUnsubscribesConfig"
        },
        {
          "$ref": "#/$defs/MailerSendAddUnsubscribeRecipientsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MailerSendAPITokenCredential"
        },
        {
          "$ref": "#/$defs/MailersendMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "Mailersend Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
