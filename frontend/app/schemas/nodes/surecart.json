{
  "$defs": {
    "SureCartAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "surecart_api_key",
          "default": "surecart_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Secret API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "SureCart API Key",
      "type": "object",
      "x-credential-instructions": "In your SureCart dashboard, copy a secret API key and paste it here. Public keys only support public endpoints and cannot run these actions. NoClick sends this key as a bearer token to api.surecart.com.",
      "x-credential-url": "https://app.surecart.com/"
    },
    "SureCartCancelSubscriptionConfig": {
      "description": "Cancel or pause a subscription. A restore time pauses it until that time.",
      "properties": {
        "operation": {
          "const": "cancel_subscription",
          "default": "cancel_subscription",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "subscription_id": {
          "title": "Subscription Id",
          "type": "string"
        },
        "cancel_behavior": {
          "anyOf": [
            {
              "enum": [
                "immediate",
                "pending"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Immediate cancellation or cancellation at period end. Omit to use the store protocol.",
          "title": "Cancel Behavior",
          "enum": [
            "immediate",
            "pending"
          ],
          "x-enum-searchable": true
        },
        "restore_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unix time to restore automatically, pausing the subscription until then.",
          "title": "Restore At"
        }
      },
      "required": [
        "subscription_id"
      ],
      "title": "SureCartCancelSubscriptionConfig",
      "type": "object"
    },
    "SureCartCreateCouponConfig": {
      "description": "Create a percentage discount coupon. A repeating coupon requires a duration in months.",
      "properties": {
        "operation": {
          "const": "create_coupon",
          "default": "create_coupon",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "percent_off": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Percent Off",
          "type": "number"
        },
        "duration": {
          "default": "once",
          "enum": [
            "once",
            "forever",
            "repeating"
          ],
          "title": "Duration",
          "type": "string"
        },
        "duration_in_months": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration In Months"
        },
        "max_redemptions": {
