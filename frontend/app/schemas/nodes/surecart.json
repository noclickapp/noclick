            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Redemptions"
        }
      },
      "required": [
        "name",
        "percent_off"
      ],
      "title": "SureCartCreateCouponConfig",
      "type": "object"
    },
