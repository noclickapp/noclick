    "AworkCreateProjectConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_project",
          "default": "create_project",
          "title": "Create Project",
          "type": "string",
          "ui:hidden": true,
          "x-is-trigger": false
        },
        "name": {
          "description": "The name of the Project. Max allowed length: 1000 characters.",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 25000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The project description. Max allowed length: 25000 characters.",
          "title": "Description"
        },
        "isPrivate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether this is a private project only visible to members and the creator.\nDefaults to false.\nCan only be changed from public to private if no times have been tracked on this project.\nCan always be made public.",
          "title": "Isprivate"
        },
        "companyId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The id of the company.",
          "title": "Companyid"
        },
        "startDate": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The start date of the project.",
          "title": "Startdate"
        },
        "dueDate": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The due date of the project.",
          "title": "Duedate"
        },
        "timeBudget": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The time budget the project has, in seconds.",
          "title": "Timebudget"
        },
        "isBillableByDefault": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether project times should be billable by default.",
          "title": "Isbillablebydefault"
        }
      },
      "required": [
        "name"
      ],
      "title": "AworkCreateProjectConfig",
      "type": "object"
    },
