    "AworkCreateTaskConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_task",
          "default": "create_task",
          "title": "Create Task",
          "type": "string",
          "ui:hidden": true,
          "x-is-trigger": false
        },
        "name": {
          "description": "The name of the task. Max allowed length: 1000 characters.",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The description of the task. Max allowed length: 25000 characters.",
          "title": "Description"
        },
        "baseType": {
          "description": "The base type of the task. Can be 'private' for a private task or 'projecttask' for a project task.",
          "enum": [
            "private",
            "projecttask"
          ],
          "title": "Basetype",
          "type": "string"
        },
        "entityId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The id of the entity the task is related to.\nFor private tasks, this is optional and will default to the current user's ID if not provided.\nFor project tasks, this is required and must be the project ID.",
          "title": "Entityid"
        },
        "taskStatusId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The id of the status for this task.\nIf not provided, defaults to the first status of type 'todo'.",
          "title": "Taskstatusid"
        },
        "typeOfWorkId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The id of the type of work for this task.\nIf not provided, defaults to the first type of work in the workspace.",
          "title": "Typeofworkid"
        },
        "isPrio": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether this task is marked as priority.",
          "title": "Isprio"
        },
        "dueOn": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The expected due date and time of the task.",
          "title": "Dueon"
        },
        "plannedDuration": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The expected planned workload of the task, in seconds.",
          "title": "Plannedduration"
        }
      },
      "required": [
        "name",
        "baseType"
      ],
      "title": "AworkCreateTaskConfig",
      "type": "object"
    },
