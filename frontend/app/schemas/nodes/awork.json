          "title": "Taskid"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The note of the time tracking.",
          "title": "Note"
        },
        "startDateUtc": {
          "description": "The date (in UTC) when the time tracking was started.",
          "format": "date-time",
          "title": "Startdateutc",
          "type": "string"
        },
        "startTimeUtc": {
          "description": "The time (in UTC) when the time tracking was started.",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
          "title": "Starttimeutc",
          "type": "string"
        },
        "duration": {
          "description": "The duration of the time tracking in seconds.\nRequired when the time tracking has already been completed and EndTime has not been set.",
          "minimum": 0,
          "title": "Duration",
          "type": "integer"
        },
        "isBillable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the time tracking is billable or not.",
          "title": "Isbillable"
        }
      },
      "required": [
        "timezone",
        "typeOfWorkId",
        "userId",
        "startDateUtc",
        "startTimeUtc",
        "duration"
      ],
      "title": "AworkCreateTimeEntryConfig",
      "type": "object"
