            "ASSIGNED",
            "IN_TRANSIT_TO_COLLECT",
            "ARRIVED_TO_COLLECT",
            "COLLECTED",
            "IN_TRANSIT_TO_DELIVER",
            "ARRIVED_TO_DELIVER",
            "DELIVERED",
            "CANCELLED",
            "RETURN_INITIATED",
            "IN_TRANSIT_TO_RETURN",
            "RETURNED"
