  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "cancel_delivery": "#/$defs/JustEatCancelDeliveryConfig",
          "create_delivery": "#/$defs/JustEatCreateDeliveryConfig",
          "create_notification_config": "#/$defs/JustEatCreateNotificationConfigConfig",
          "delete_notification_config": "#/$defs/JustEatDeleteNotificationConfigConfig",
          "estimate_delivery": "#/$defs/JustEatEstimateDeliveryConfig",
