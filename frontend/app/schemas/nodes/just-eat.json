      "oneOf": [
        {
          "$ref": "#/$defs/JustEatEstimateDeliveryConfig"
        },
        {
          "$ref": "#/$defs/JustEatCreateDeliveryConfig"
        },
        {
          "$ref": "#/$defs/JustEatGetDeliveryStatusConfig"
        },
        {
          "$ref": "#/$defs/JustEatCancelDeliveryConfig"
        },
        {
          "$ref": "#/$defs/JustEatListCollectPointsConfig"
        },
        {
          "$ref": "#/$defs/JustEatRequestAssistanceConfig"
        },
        {
          "$ref": "#/$defs/JustEatGetNotificationConfigConfig"
        },
        {
          "$ref": "#/$defs/JustEatCreateNotificationConfigConfig"
        },
        {
          "$ref": "#/$defs/JustEatUpdateNotificationConfigConfig"
        },
        {
          "$ref": "#/$defs/JustEatDeleteNotificationConfigConfig"
        },
        {
          "$ref": "#/$defs/JustEatSimulateDeliveryConfig"
