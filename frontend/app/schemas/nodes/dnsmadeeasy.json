{
  "$defs": {
    "DNSMadeEasyAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "dnsmadeeasy_api_key",
          "default": "dnsmadeeasy_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "Existing API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_secret": {
          "title": "Existing API Secret",
          "type": "string",
          "ui:widget": "password"
        },
        "environment": {
          "description": "Explicit fixed host selection. Production and sandbox need separate credentials; no automatic fallback.",
          "enum": [
            "production",
            "sandbox"
          ],
          "title": "Issued-Key Environment",
          "type": "string"
        },
        "domain_id": {
          "description": "One positive exact integer ID already accessible in the default protected catalog.",
          "title": "Independently Known Managed Domain ID",
          "type": "integer"
        }
      },
      "required": [
        "api_key",
        "api_secret",
        "environment",
        "domain_id"
      ],
      "title": "DNS Made Easy API Key and Secret",
      "type": "object",
      "x-credential-instructions": "Supply existing issued API key and secret, explicit production or sandbox environment, and independently known accessible managed domain ID. Sandbox requires its own separately issued keys; no fallback or cross-environment retry. Business/Corporate API entitlement and permissions remain unverified. Protected catalog access is reachability, not actor/account ownership. No key issue, login, exchange or rotation.",
      "x-credential-url": "https://api-docs.dnsmadeeasy.com/"
    },
    "DNSMadeEasyDomainConfig": {
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to names. All record values/RDATA, URLs and configuration remain omitted.",
          "title": "Include Domain and Record Names",
          "type": "boolean"
        },
        "domain_id": {
          "title": "Current Credential-bound Domain",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "auto_select_sole_option": false,
            "field_name": "domain_id"
          },
          "x-resource-type": "domain_id"
        },
        "operation": {
          "const": "get_domain",
          "default": "get_domain",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "DNS Made Easy Metadata",
          "x-display-name": "Get Managed Domain Metadata",
          "x-is-trigger": false
        }
      },
      "required": [
        "domain_id"
      ],
      "title": "DNSMadeEasyDomainConfig",
      "type": "object"
    },
    "DNSMadeEasyDomainsConfig": {
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to names. All record values/RDATA, URLs and configuration remain omitted.",
          "title": "Include Domain and Record Names",
          "type": "boolean"
        },
        "operation": {
          "const": "list_domains",
          "default": "list_domains",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "DNS Made Easy Metadata",
          "x-display-name": "Read Protected Managed Domain Catalog",
          "x-is-trigger": false
        }
      },
      "title": "DNSMadeEasyDomainsConfig",
      "type": "object"
    },
    "DNSMadeEasyRecordsConfig": {
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to names. All record values/RDATA, URLs and configuration remain omitted.",
          "title": "Include Domain and Record Names",
          "type": "boolean"
        },
        "domain_id": {
          "title": "Current Credential-bound Domain",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "auto_select_sole_option": false,
            "field_name": "domain_id"
          },
          "x-resource-type": "domain_id"
        },
        "operation": {
          "const": "list_records",
          "default": "list_records",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "DNS Made Easy Metadata",
          "x-display-name": "Read Domain DNS Record Metadata",
          "x-is-trigger": false
        },
        "rows": {
          "default": 20,
          "description": "Explicit local bound 1\u2013100; not a documented vendor maximum.",
          "maximum": 100,
          "minimum": 1,
          "title": "Rows",
          "type": "integer"
        },
        "page": {
          "default": 0,
          "description": "Published examples start at page0. Explicit local bound; no auto-pagination or completion inference.",
          "maximum": 1000,
          "minimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "record_type": {
          "anyOf": [
            {
              "enum": [
                "A",
                "AAAA",
                "CNAME",
                "HTTPRED",
                "MX",
                "NS",
                "PTR",
                "SRV",
                "TXT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only documented types; sent as the published type query parameter.",
          "title": "Record Type Filter",
          "enum": [
            "A",
            "AAAA",
            "CNAME",
            "HTTPRED",
            "MX",
            "NS",
            "PTR",
            "SRV",
            "TXT"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "domain_id"
      ],
      "title": "DNSMadeEasyRecordsConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_domain": "#/$defs/DNSMadeEasyDomainConfig",
          "list_domains": "#/$defs/DNSMadeEasyDomainsConfig",
          "list_records": "#/$defs/DNSMadeEasyRecordsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DNSMadeEasyDomainsConfig"
        },
        {
          "$ref": "#/$defs/DNSMadeEasyDomainConfig"
        },
        {
          "$ref": "#/$defs/DNSMadeEasyRecordsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/DNSMadeEasyAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Dnsmadeeasy Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Read metadata for my known DNS Made Easy domain without DNS values",
    "Read record IDs, types and TTLs without failover or configuration",
    "Read one explicit records page, not a complete DNS export"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
