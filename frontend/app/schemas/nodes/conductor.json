  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "archive_session": "#/$defs/ConductorArchiveSessionConfig",
          "archive_workspace": "#/$defs/ConductorArchiveWorkspaceConfig",
          "cancel_session": "#/$defs/ConductorCancelSessionConfig",
          "create_session": "#/$defs/ConductorCreateSessionConfig",
          "create_workspace": "#/$defs/ConductorCreateWorkspaceConfig",
          "get_identity": "#/$defs/ConductorGetIdentityConfig",
          "get_message": "#/$defs/ConductorGetMessageConfig",
          "get_project": "#/$defs/ConductorGetProjectConfig",
          "get_session": "#/$defs/ConductorGetSessionConfig",
          "get_session_status": "#/$defs/ConductorGetSessionStatusConfig",
          "get_workspace": "#/$defs/ConductorGetWorkspaceConfig",
          "get_workspace_status": "#/$defs/ConductorGetWorkspaceStatusConfig",
          "list_favorite_models": "#/$defs/ConductorListFavoriteModelsConfig",
          "list_messages": "#/$defs/ConductorListMessagesConfig",
          "list_project_workspaces": "#/$defs/ConductorListProjectWorkspacesConfig",
          "list_projects": "#/$defs/ConductorListProjectsConfig",
          "list_sessions": "#/$defs/ConductorListSessionsConfig",
          "list_workspaces": "#/$defs/ConductorListWorkspacesConfig",
          "rename_session": "#/$defs/ConductorRenameSessionConfig",
          "rename_workspace": "#/$defs/ConductorRenameWorkspaceConfig",
          "send_message": "#/$defs/ConductorSendMessageConfig",
          "sleep_workspace": "#/$defs/ConductorSleepWorkspaceConfig",
          "unarchive_session": "#/$defs/ConductorUnarchiveSessionConfig",
          "unarchive_workspace": "#/$defs/ConductorUnarchiveWorkspaceConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ConductorGetIdentityConfig"
        },
        {
          "$ref": "#/$defs/ConductorListProjectsConfig"
        },
        {
          "$ref": "#/$defs/ConductorGetProjectConfig"
        },
        {
          "$ref": "#/$defs/ConductorListProjectWorkspacesConfig"
        },
        {
          "$ref": "#/$defs/ConductorListWorkspacesConfig"
        },
        {
          "$ref": "#/$defs/ConductorCreateWorkspaceConfig"
