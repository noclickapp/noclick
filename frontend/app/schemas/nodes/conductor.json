            "claude",
            "codex",
            "cursor",
            "acp"
          ],
          "title": "Agent",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable session ID for deduplicating a retried create.",
          "title": "Session Id"
        },
        "message_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UUID for deduplicating an explicitly retried message. Reuse the same ID and text.",
          "title": "Message Id"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 100000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional initial prompt. Inspect initialMessage before resending.",
          "title": "Message"
        }
      },
      "required": [
        "workspace_id",
        "agent"
      ],
      "title": "ConductorCreateSessionConfig",
      "type": "object"
    },
