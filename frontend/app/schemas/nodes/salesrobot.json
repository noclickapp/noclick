{
  "$defs": {
    "AddProspect": {
      "additionalProperties": false,
      "description": "Add a single prospect to a campaign.",
      "properties": {
        "campaign_uuid": {
          "format": "uuid",
          "title": "Campaign UUID",
          "type": "string"
        },
        "operation": {
          "const": "add_prospect",
          "default": "add_prospect",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "prospect": {
          "$ref": "#/$defs/NewProspectFields"
        }
      },
      "required": [
        "campaign_uuid",
        "prospect"
      ],
      "title": "AddProspect",
      "type": "object"
    },
    "CopyBlacklist": {
      "additionalProperties": false,
      "description": "Copy a blacklist from another LinkedIn account.",
