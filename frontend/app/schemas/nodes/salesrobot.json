        "safeModeEnabled": {
          "title": "Safemodeenabled",
          "type": "boolean"
        },
        "dayOfWeeks": {
          "items": {
            "enum": [
              "MONDAY",
              "TUESDAY",
              "WEDNESDAY",
              "THURSDAY",
              "FRIDAY",
              "SATURDAY",
              "SUNDAY"
