{
  "$defs": {
    "KisiAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "kisi_api_key",
          "default": "kisi_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Paste your Kisi API key, without the Authorization header or KISI-LOGIN prefix.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Kisi API Key",
      "type": "object",
      "x-credential-instructions": "Create an API key in Kisi, then paste the key without the KISI-LOGIN prefix. Use an account with permission to manage the places, groups and members needed by your workflow.",
      "x-credential-url": "https://docs.kisi.io/platform/apis/get_started/setup_kisi_account"
    },
    "KisiCreateGroupConfig": {
      "description": "Create a Kisi group.",
      "properties": {
        "operation": {
          "const": "create_group",
          "default": "create_group",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "login_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Login Enabled"
        },
        "place_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "KisiCreateGroupConfig",
      "type": "object"
    },
    "KisiCreateGroupLockConfig": {
      "description": "Add a door to a group's access set.",
      "properties": {
        "operation": {
          "const": "create_group_lock",
          "default": "create_group_lock",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
