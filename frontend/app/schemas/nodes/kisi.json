        }
      },
      "required": [
        "group_id",
        "lock_id"
      ],
      "title": "KisiCreateGroupLockConfig",
      "type": "object"
    },
    "KisiCreateMemberConfig": {
      "description": "Create a Kisi member.",
      "properties": {
        "operation": {
          "const": "create_member",
          "default": "create_member",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "maxLength": 320,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email",
          "type": "string"
        },
        "send_emails": {
          "default": false,
          "description": "Explicitly opt in to Kisi sending member emails.",
          "title": "Send Emails",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "access_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enable or disable the member access to locks and elevators.",
          "title": "Access Enabled"
        }
      },
      "required": [
        "email"
      ],
      "title": "KisiCreateMemberConfig",
      "type": "object"
    },
    "KisiCreateRoleAssignmentConfig": {
      "description": "Assign a group access role to a user, team or guest.",
      "properties": {
        "operation": {
          "const": "create_role_assignment",
          "default": "create_role_assignment",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "applies_to_id": {
          "minimum": 1,
          "title": "Group ID",
          "type": "integer"
        },
        "assignee_type": {
          "default": "User",
          "enum": [
            "User",
            "Team",
            "Guest"
          ],
          "title": "Assignee Type",
          "type": "string"
        },
        "assignee_id": {
          "minimum": 0,
          "title": "Assignee ID",
          "type": "integer"
        },
        "role_id": {
          "default": "group_basic",
          "description": "Basic grants door access; manager grants elevated group permissions.",
          "enum": [
            "group_basic",
            "group_manager"
          ],
          "title": "Role Id",
          "type": "string"
        },
        "notify": {
          "default": false,
          "description": "Opt in to Kisi sending an access assignment email.",
          "title": "Notify",
          "type": "boolean"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional ISO 8601 access start time, with timezone.",
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional ISO 8601 access expiration, with timezone.",
          "title": "Valid Until"
        }
      },
      "required": [
        "applies_to_id",
        "assignee_id"
      ],
      "title": "KisiCreateRoleAssignmentConfig",
      "type": "object"
    },
