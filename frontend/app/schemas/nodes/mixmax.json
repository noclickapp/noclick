        "api_token": {
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Mixmax API Token",
      "type": "object",
      "x-credential-instructions": "Create an API token in Mixmax Settings > Integrations and paste it here. NoClick sends it in X-API-Token to api.mixmax.com. Use a personal API token; managed keys cannot access some account endpoints.",
      "x-credential-url": "https://app.mixmax.com/dashboard/settings/integrations"
    },
    "MixmaxAddSequenceRecipientsConfig": {
      "additionalProperties": false,
      "description": "Add sequence recipients; performs one API request.",
      "properties": {
        "operation": {
          "const": "add_sequence_recipients",
          "default": "add_sequence_recipients",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "recipients": {
          "items": {
            "$ref": "#/$defs/MixmaxRecipient"
          },
          "minItems": 1,
          "title": "Recipients",
          "type": "array"
        },
        "scheduledAt": {
          "anyOf": [
            {
              "maximum": 9999999999999,
              "minimum": 1000000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduledat"
        },
        "enrich": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enrich"
        },
        "allowMissingVariables": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowmissingvariables"
        }
      },
      "required": [
        "id",
        "recipients"
      ],
      "title": "MixmaxAddSequenceRecipientsConfig",
      "type": "object"
    },
