{
  "$defs": {
    "CreatePost": {
      "additionalProperties": false,
      "description": "Create post.",
      "properties": {
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "slug": {
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$",
          "title": "Slug",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "content_html": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inblog TipTap HTML. Send the full content when updating.",
          "title": "Content Html"
        },
        "published": {
          "default": false,
          "description": "Create a draft by default; true publishes immediately.",
          "title": "Published",
          "type": "boolean"
        },
        "meta_title": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta Title"
        },
        "meta_description": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta Description"
        },
        "operation": {
          "const": "create_post",
          "default": "create_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "title",
        "slug"
      ],
      "title": "CreatePost",
      "type": "object"
    },
    "CreateRedirect": {
      "additionalProperties": false,
      "description": "Create redirect.",
