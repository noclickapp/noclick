  "$defs": {
    "AdobeAnalyticsTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "adobe_analytics_token",
          "default": "adobe_analytics_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "title": "Issued OAuth Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "client_id": {
          "description": "The Adobe Developer client ID that issued this OAuth token.",
          "title": "API Key (Client ID)",
          "type": "string"
        },
        "global_company_id": {
          "description": "Select the Analytics company returned by discovery/me.",
          "title": "Global Company ID",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Known ISO 8601 expiry with timezone. NoClick does not mint or refresh tokens.",
          "title": "Token Expiry"
        }
      },
      "required": [
        "access_token",
        "client_id",
        "global_company_id"
      ],
      "title": "Adobe Analytics Access Token",
      "type": "object",
      "x-credential-instructions": "Use an already-issued OAuth User or Server-to-Server access token, its public client ID, and a discovery-authorized global company ID. Analytics product-profile permissions are required. Legacy JWT grants are excluded.",
      "x-credential-url": "https://developer.adobe.com/analytics-apis/docs/2.0/guides/"
    },
