{
  "$defs": {
    "GoTableAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "go_table_api_token",
          "default": "go_table_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Go Table API Token",
      "type": "object",
      "x-credential-instructions": "Paste your Go Table API token. NoClick sends it as a bearer token to gotable.app and lists your accessible restaurants to check the connection.",
      "x-credential-url": "https://gotable.app/api/docs/v1"
    },
    "GoTableCancelReservationConfig": {
      "additionalProperties": false,
      "description": "Cancel a reservation.",
      "properties": {
        "operation": {
          "const": "cancel_reservation",
          "default": "cancel_reservation",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "role": {
          "default": "restaurant",
          "description": "Role used for reservation email and SMS notifications.",
