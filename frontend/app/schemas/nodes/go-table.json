          "minimum": 1,
          "title": "Restaurant Id",
          "type": "integer"
        },
        "reservation_id": {
          "minimum": 1,
          "title": "Reservation Id",
          "type": "integer"
        }
      },
      "required": [
        "restaurant_id",
        "reservation_id"
      ],
      "title": "GoTableCancelReservationConfig",
      "type": "object"
    },
    "GoTableCreateGuestConfig": {
