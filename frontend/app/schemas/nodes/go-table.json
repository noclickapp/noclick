    "GoTableCreateReservationConfig": {
      "additionalProperties": false,
      "description": "Create a new reservation.",
      "properties": {
        "operation": {
          "const": "create_reservation",
          "default": "create_reservation",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "role": {
          "default": "restaurant",
          "description": "Role used for reservation email and SMS notifications.",
          "enum": [
            "restaurant",
            "guest"
          ],
          "title": "Role",
          "type": "string"
        },
        "skip_email": {
          "default": false,
          "description": "Set true to suppress the provider notification.",
          "title": "Skip Email",
          "type": "boolean"
        },
        "skip_sms": {
          "default": false,
          "description": "Set true to suppress the provider notification.",
          "title": "Skip Sms",
          "type": "boolean"
        },
        "restaurant_id": {
          "minimum": 1,
          "title": "Restaurant Id",
          "type": "integer"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "Reservation",
                "WalkIn"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set to \"WalkIn\" for walk-in reservations. For walk-ins, date/time defaults to current if not provided.",
          "title": "Type",
          "enum": [
            "Reservation",
            "WalkIn"
          ],
          "x-enum-searchable": true
        },
        "offer_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The (optional) ID of the offer we want to book this reservation for.",
          "title": "Offer Id"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for reservations without a type or \"Reservation\" type. Can be omitted for \"WalkIn\" reservations.",
          "title": "Date"
        },
        "time": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time (HH:MM) of reservation. Required for reservations without a type or \"Reservation\" type.",
          "title": "Time"
        },
        "party_size": {
          "description": "Number of guests in the party.",
          "minimum": 1,
          "title": "Party Size",
          "type": "integer"
        },
        "guest_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Primary guest's name",
          "title": "Guest Name"
        },
        "guest_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Primary guest's email address",
          "title": "Guest Email"
        },
        "guest_telephone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Primary guest's telephone",
          "title": "Guest Telephone"
        },
        "comments": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Primary guest's comments for the reservation.",
          "title": "Comments"
        },
        "duration_in_minutes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The duration of the reservation in minutes",
          "title": "Duration In Minutes"
        },
        "table_ids": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An array of table IDs to assign to this reservation. Ignored when `role=guest`.",
          "title": "Table Ids"
        },
        "table_lock": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set to `true` to pin the assigned tables and prevent auto-assignment. Ignored when `role=guest`.",
          "title": "Table Lock"
        }
      },
      "required": [
        "restaurant_id",
        "party_size"
      ],
      "title": "GoTableCreateReservationConfig",
      "type": "object"
    },
