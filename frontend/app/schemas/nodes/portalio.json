{
  "$defs": {
    "PortalioAddAreaConfig": {
      "additionalProperties": false,
      "description": "Creates a new area (room) within a proposal. The area name must be unique within the proposal. The system automatically creates one default option in 'Draft' status under the new area. The response includes the full updated proposal detail, including the new area and its default option.",
      "properties": {
        "operation": {
          "const": "add_area",
          "default": "add_area",
          "title": "Add Area",
          "type": "string",
          "ui:hidden": true
        },
        "proposal_id": {
          "description": "Unique ID of the proposal (not the proposal number).",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Proposal Id",
          "type": "integer"
        },
        "name": {
          "description": "Name of the area to create.",
          "maxLength": 100000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "name"
      ],
      "title": "PortalioAddAreaConfig",
      "type": "object"
    },
    "PortalioAddAreaOptionConfig": {
      "additionalProperties": false,
      "description": "Creates a new option within an existing area. Each area supports a maximum of three options. Client description and internal installer notes are optional at creation time. The new option is created with 'Draft' status. The response includes the full updated proposal detail.",
      "properties": {
        "operation": {
          "const": "add_area_option",
          "default": "add_area_option",
          "title": "Add Area Option",
          "type": "string",
          "ui:hidden": true
        },
        "proposal_id": {
          "description": "Unique ID of the proposal (not the proposal number).",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Proposal Id",
          "type": "integer"
        },
        "area_id": {
          "description": "Unique ID of the area within the proposal where the option will be created. The area must exist for the given proposal.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Area Id",
          "type": "integer"
        },
        "client_description": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(Optional) Client\u2011facing description to show to customers. Keep concise and user-focused, e.g. 'Premium Installation Package'.",
          "title": "Client Description"
        },
        "internal_notes": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(Optional) Internal notes for installers or administrators (installer description). Not shown to clients; use for technical details, special instructions, or compatibility notes.",
          "title": "Internal Notes"
        }
      },
      "required": [
        "proposal_id",
        "area_id"
      ],
      "title": "PortalioAddAreaOptionConfig",
      "type": "object"
    },
    "PortalioApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "portalio_api_key",
          "default": "portalio_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "application_key": {
          "minLength": 1,
          "title": "Application Key",
          "type": "string",
          "ui:widget": "password"
        },
        "secret_key": {
          "minLength": 1,
          "title": "Secret Key",
          "type": "string",
          "ui:widget": "password"
        },
        "user_api_key": {
          "minLength": 1,
          "title": "User API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "environment": {
          "default": "production",
          "enum": [
            "production",
            "sandbox"
          ],
          "title": "Environment",
          "type": "string"
        }
      },
      "required": [
        "application_key",
        "secret_key",
        "user_api_key"
      ],
      "title": "Portal.io API Keys",
      "type": "object",
      "x-credential-instructions": "Get an application key and secret from your Portal.io representative. Exchange your Portal.io login for a User API Key using the provider's quickstart, then paste all three keys here. Sandbox and production keys are separate; production access requires Portal.io approval.",
      "x-credential-url": "https://docs.portal.io/authentication/overview"
    },
    "PortalioAssignContactConfig": {
      "additionalProperties": false,
      "description": "Assigns an existing contact (person/client) to a proposal. The proposal and contact must belong to the same account. If the contact has a single primary location, that location is automatically assigned to the proposal as well. Assigning a contact may trigger tax recalculations based on the contact's location.",
      "properties": {
        "operation": {
          "const": "assign_contact",
          "default": "assign_contact",
          "title": "Assign Contact",
          "type": "string",
          "ui:hidden": true
        },
        "proposal_id": {
          "description": "Proposal Id.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Proposal Id",
          "type": "integer"
        },
        "contact_id": {
          "description": "Contact Id.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Contact Id",
          "type": "integer"
        }
      },
      "required": [
        "proposal_id",
        "contact_id"
      ],
      "title": "PortalioAssignContactConfig",
      "type": "object"
    },
    "PortalioAssignLocationConfig": {
      "additionalProperties": false,
      "description": "Assigns a location to a proposal that already has a contact assigned. The location must belong to the proposal's assigned contact and to the same account. Assigning a location triggers tax recalculations for the proposal. The response includes the full updated proposal detail.",
      "properties": {
        "operation": {
          "const": "assign_location",
          "default": "assign_location",
          "title": "Assign Location",
          "type": "string",
          "ui:hidden": true
        },
        "proposal_id": {
          "description": "ID of the proposal to update.  Must belong to the current account.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Proposal Id",
          "type": "integer"
        },
        "location_id": {
          "description": "ID of the location to assign to the proposal\u2019s existing person.  Must belong to the current account.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Location Id",
          "type": "integer"
        }
      },
      "required": [
        "proposal_id",
        "location_id"
      ],
      "title": "PortalioAssignLocationConfig",
      "type": "object"
    },
    "PortalioCreateContactConfig": {
      "additionalProperties": false,
      "description": "Creates a contact in the current account. PartyType, ContactType, and FirstName are required. CompanyName is also required when PartyType is Company.",
      "properties": {
        "operation": {
          "const": "create_contact",
          "default": "create_contact",
          "title": "Create Contact",
          "type": "string",
          "ui:hidden": true
        },
        "party_type": {
          "enum": [
            "Person",
            "Company"
          ],
          "title": "Party Type",
          "type": "string"
        },
        "contact_type": {
          "enum": [
            "Client",
            "Employee",
            "Contractor",
            "Other"
          ],
          "title": "Contact Type",
          "type": "string"
        },
        "first_name": {
          "description": "First Name (Maximum character length is 100)",
          "maxLength": 100,
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last Name (Maximum character length is 50)",
          "title": "Last Name"
        },
        "company_name": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Company Name (Maximum character length is 100)",
          "title": "Company Name"
        },
        "contact_email": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Email (Maximum character length is 256)",
          "title": "Contact Email"
        },
        "contact_email_cc": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Additioanl email(s) copied when a proposal is submitted",
          "title": "Contact Email Cc"
        },
        "contact_phone": {
          "anyOf": [
            {
              "maxLength": 30,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contact Phone (Maximum character length is 30)",
          "title": "Contact Phone"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "party_type",
        "contact_type",
        "first_name"
      ],
      "title": "PortalioCreateContactConfig",
      "type": "object"
    },
    "PortalioCreateContactLocationConfig": {
      "additionalProperties": false,
      "description": "Adds a location to the specified contact. Street is required. When Country is provided, State is also required. Use IsPrimary to make the new location the primary location and IsBilling to make it the billing location.",
      "properties": {
        "operation": {
          "const": "create_contact_location",
          "default": "create_contact_location",
          "title": "Create Contact Location",
          "type": "string",
          "ui:hidden": true
        },
        "contact_id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Contact Id",
          "type": "integer"
        },
        "contact_first_name": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contact First Name (Maximum character length is 50)",
          "title": "Contact First Name"
        },
        "contact_last_name": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contact Last Name (Maximum character length is 50)",
          "title": "Contact Last Name"
        },
        "contact_phone_number": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contact Phone Number (Maximum character length is 50)",
          "title": "Contact Phone Number"
        },
        "contact_email": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contact Email (Maximum character length is 100)",
          "title": "Contact Email"
        },
        "street": {
          "description": "Street (Maximum character length is 100)",
          "maxLength": 100,
          "minLength": 1,
          "title": "Street",
          "type": "string"
        },
        "suite": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Suite (Maximum character length is 100)",
          "title": "Suite"
        },
        "city": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "City (Maximum character length is 50)",
          "title": "City"
        },
        "postal_code": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Postal Code (Maximum character length is 20)",
          "title": "Postal Code"
        },
        "state": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "State (Maximum character length is 256)",
          "title": "State"
        },
        "country": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Country (Maximum character length is 256)",
          "title": "Country"
        },
        "is_primary": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Primary"
        },
        "is_billing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Billing"
        }
      },
      "required": [
        "contact_id",
        "street"
      ],
      "title": "PortalioCreateContactLocationConfig",
      "type": "object"
    },
    "PortalioCreateProposalConfig": {
      "additionalProperties": false,
      "description": "Creates a new proposal for the authenticated account. Supply a salesperson ID from the same account and, optionally, a proposal name. If no name is given, the system assigns a default name using the same logic as the Portal UI. The response includes the full proposal detail, including the new proposal ID, number, status, and financial summary.",
      "properties": {
        "operation": {
          "const": "create_proposal",
          "default": "create_proposal",
          "title": "Create Proposal",
          "type": "string",
          "ui:hidden": true
        },
        "sales_person_id": {
          "description": "ID of the salesperson (user) who will own the proposal. Must belong to the current account.",
          "title": "Sales Person Id",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional name of the proposal.  If omitted, the system will assign a default name.",
          "title": "Name"
        }
      },
      "required": [
        "sales_person_id"
      ],
      "title": "PortalioCreateProposalConfig",
      "type": "object"
    },
    "PortalioGetCatalogItemConfig": {
      "additionalProperties": false,
      "description": "Returns details for the requested catalog item. When ItemType is Labor or CustomItem, the item is returned from the current account's library; otherwise a standard catalog item is returned. ExtendedDetails adds extra information to standard catalog item responses.",
      "properties": {
        "operation": {
          "const": "get_catalog_item",
          "default": "get_catalog_item",
          "title": "Get Catalog Item",
          "type": "string",
          "ui:hidden": true
        },
        "item_id": {
          "description": "Item Id",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Item Id",
          "type": "integer"
        },
        "extended_details": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provides additional details like full description, specs, linked resources",
          "title": "Extended Details"
        },
        "item_type": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Type"
        }
      },
      "required": [
        "item_id"
      ],
      "title": "PortalioGetCatalogItemConfig",
      "type": "object"
    },
    "PortalioGetChangeOrderConfig": {
      "additionalProperties": false,
      "description": "Returns detailed information for the specified change order. The HTTP response also sets the Last-Modified header from the response LastModifiedDate. Item costs are left out when costs are not available to your account, so a null cost does not mean the item has none. A recurring-service item is left out of its area option's total and counted in that option's totalRecurringService instead. When an item has total.isCombinedPrice true, its amount already includes the totals of the items nested under it, and those nested items still report their own amounts.",
      "properties": {
        "operation": {
          "const": "get_change_order",
          "default": "get_change_order",
          "title": "Get Change Order",
          "type": "string",
          "ui:hidden": true
        },
        "proposal_id": {
          "description": "Proposal Id.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Proposal Id",
          "type": "integer"
        },
        "change_order_id": {
          "description": "Change Order Id.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Change Order Id",
          "type": "integer"
        }
      },
      "required": [
        "proposal_id",
        "change_order_id"
      ],
      "title": "PortalioGetChangeOrderConfig",
      "type": "object"
    },
    "PortalioGetContactConfig": {
      "additionalProperties": false,
      "description": "Returns the contact details for the specified person. PrimaryLocation and BillingLocation are included when available. When IncludeCounts is true, the response also includes proposal and payment counts for the contact.",
      "properties": {
        "operation": {
          "const": "get_contact",
          "default": "get_contact",
          "title": "Get Contact",
          "type": "string",
          "ui:hidden": true
        },
        "person_id": {
          "description": "Person Id.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Person Id",
          "type": "integer"
        },
        "include_counts": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Include Counts"
        }
      },
      "required": [
        "person_id"
      ],
      "title": "PortalioGetContactConfig",
      "type": "object"
    },
    "PortalioGetProposalConfig": {
      "additionalProperties": false,
      "description": "Returns detailed information for the specified proposal. The HTTP response also sets the Last-Modified header from the response LastModifiedDate. Item costs are left out when costs are not available to your account, so a null cost does not mean the item has none. A recurring-service item is left out of its area option's total and counted in that option's totalRecurringService instead. When an item has total.isCombinedPrice true, its amount already includes the totals of the items nested under it, and those nested items still report their own amounts.",
      "properties": {
        "operation": {
          "const": "get_proposal",
          "default": "get_proposal",
          "title": "Get Proposal",
          "type": "string",
          "ui:hidden": true
        },
        "proposal_id": {
          "description": "Proposal Id.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Proposal Id",
          "type": "integer"
        }
      },
      "required": [
        "proposal_id"
      ],
      "title": "PortalioGetProposalConfig",
      "type": "object"
    },
    "PortalioListCategoriesConfig": {
      "additionalProperties": false,
      "description": "Returns the catalog category hierarchy grouped by industry, including category image URLs when available.",
      "properties": {
        "operation": {
          "const": "list_categories",
          "default": "list_categories",
          "title": "List Categories",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "PortalioListCategoriesConfig",
      "type": "object"
    },
    "PortalioListChangeOrdersConfig": {
      "additionalProperties": false,
      "description": "Returns the change orders for the specified proposal, including customer details, total, status, and created and modified dates.",
      "properties": {
        "operation": {
          "const": "list_change_orders",
          "default": "list_change_orders",
          "title": "List Change Orders",
          "type": "string",
          "ui:hidden": true
        },
        "proposal_id": {
          "description": "Proposal Id.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Proposal Id",
          "type": "integer"
        }
      },
      "required": [
        "proposal_id"
      ],
      "title": "PortalioListChangeOrdersConfig",
      "type": "object"
    },
    "PortalioListContactLocationsConfig": {
      "additionalProperties": false,
      "description": "Returns the contact's locations. Results are ordered with the primary location first, then the billing location, then the most recently modified locations. Pagination defaults to PageNumber 1 and PageSize 10. When PageNumber is less than or equal to 0, all matching locations are returned.",
      "properties": {
        "operation": {
          "const": "list_contact_locations",
          "default": "list_contact_locations",
          "title": "List Contact Locations",
          "type": "string",
          "ui:hidden": true
        },
        "contact_id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Contact Id",
          "type": "integer"
        },
        "page_number": {
          "default": 1,
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "page_size": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "contact_id"
      ],
      "title": "PortalioListContactLocationsConfig",
      "type": "object"
    },
    "PortalioListContactsConfig": {
      "additionalProperties": false,
      "description": "Returns a paged list of contacts for the current account. Supports search, contact type filtering, sorting, and pagination. Pagination defaults to PageNumber 1 and PageSize 10 when values are missing or less than or equal to 0.",
      "properties": {
        "operation": {
          "const": "list_contacts",
          "default": "list_contacts",
          "title": "List Contacts",
          "type": "string",
          "ui:hidden": true
        },
        "search_text": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Search text",
          "title": "Search Text"
        },
        "contact_types": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "Person",
                  "Company"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contact Types.",
          "title": "Contact Types"
        },
        "sort_by": {
          "anyOf": [
            {
              "enum": [
                "ModifiedDate",
                "CreatedDate",
                "FirstName",
                "LastName",
                "LastActive",
                "LastActiveByMe"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort By",
          "enum": [
            "ModifiedDate",
            "CreatedDate",
            "FirstName",
            "LastName",
            "LastActive",
            "LastActiveByMe"
          ],
          "x-enum-searchable": true
        },
        "sort_direction": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort Direction"
        },
        "page_number": {
          "default": 1,
          "description": "Page number. Starting from 1",
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "page_size": {
          "default": 50,
          "description": "Page Size",
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "title": "PortalioListContactsConfig",
      "type": "object"
    },
    "PortalioListProposalsConfig": {
      "additionalProperties": false,
      "description": "Returns the proposals for the current account. Supports filtering by status, contact, modified date, search text, and archive state, along with sorting and pagination.",
      "properties": {
        "operation": {
          "const": "list_proposals",
          "default": "list_proposals",
          "title": "List Proposals",
          "type": "string",
          "ui:hidden": true
        },
        "search_text": {
