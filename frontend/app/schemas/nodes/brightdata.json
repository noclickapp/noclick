{
  "$defs": {
    "BrightdataAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "brightdata_api_key",
          "default": "brightdata_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Bright Data API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Bright Data API key from Account settings \u2192 Users and API keys. Give it access to the scrapers and datasets your workflow uses. NoClick checks the connection by listing your account's scrapers.",
      "x-credential-url": "https://brightdata.com/cp/setting/users"
    },
    "BrightdataCancelScrapeConfig": {
      "additionalProperties": false,
      "description": "Cancel a running collection.",
      "properties": {
        "operation": {
          "const": "cancel_scrape",
          "default": "cancel_scrape",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "snapshot_id": {
          "description": "Snapshot ID returned by Bright Data.",
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "BrightdataCancelScrapeConfig",
      "type": "object"
    },
    "BrightdataDownloadScrapeSnapshotConfig": {
      "additionalProperties": false,
      "description": "Download collected records as JSON data or an NDJSON/CSV file. Use a ready snapshot; large snapshots can be downloaded in parts.",
      "properties": {
        "operation": {
          "const": "download_scrape_snapshot",
          "default": "download_scrape_snapshot",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "snapshot_id": {
          "description": "Snapshot ID returned by Bright Data.",
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "format": {
          "default": "json",
          "enum": [
            "json",
            "ndjson",
            "jsonl",
            "csv"
          ],
          "title": "Format",
          "type": "string"
        },
        "batch_size": {
          "anyOf": [
            {
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Size"
        },
        "part": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "BrightdataDownloadScrapeSnapshotConfig",
      "type": "object"
    },
    "BrightdataGetDatasetSnapshotConfig": {
      "additionalProperties": false,
      "description": "Get a dataset snapshot\u2019s metadata.",
      "properties": {
        "operation": {
          "const": "get_dataset_snapshot",
          "default": "get_dataset_snapshot",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "snapshot_id": {
          "description": "Snapshot ID returned by Bright Data.",
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "BrightdataGetDatasetSnapshotConfig",
      "type": "object"
    },
    "BrightdataGetDeliveryStatusConfig": {
      "additionalProperties": false,
      "description": "Check a delivery job\u2019s status and delivered files.",
      "properties": {
        "operation": {
          "const": "get_delivery_status",
          "default": "get_delivery_status",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "delivery_id": {
          "minLength": 1,
          "title": "Delivery Id",
          "type": "string"
        }
      },
      "required": [
        "delivery_id"
      ],
      "title": "BrightdataGetDeliveryStatusConfig",
      "type": "object"
    },
    "BrightdataGetScrapeInputConfig": {
      "additionalProperties": false,
      "description": "Download the original scraper inputs as a CSV file.",
      "properties": {
        "operation": {
          "const": "get_scrape_input",
          "default": "get_scrape_input",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "snapshot_id": {
          "description": "Snapshot ID returned by Bright Data.",
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "BrightdataGetScrapeInputConfig",
      "type": "object"
    },
    "BrightdataGetScrapeLogConfig": {
      "additionalProperties": false,
      "description": "Retrieve the collection logs for a scraper snapshot.",
      "properties": {
        "operation": {
          "const": "get_scrape_log",
          "default": "get_scrape_log",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "snapshot_id": {
          "description": "Snapshot ID returned by Bright Data.",
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "BrightdataGetScrapeLogConfig",
      "type": "object"
    },
    "BrightdataGetScrapeProgressConfig": {
      "additionalProperties": false,
      "description": "Check whether a scraper snapshot is starting, running, ready, failed or canceled.",
      "properties": {
        "operation": {
          "const": "get_scrape_progress",
          "default": "get_scrape_progress",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "snapshot_id": {
          "description": "Snapshot ID returned by Bright Data.",
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "BrightdataGetScrapeProgressConfig",
      "type": "object"
    },
    "BrightdataGetSerpResponseConfig": {
      "additionalProperties": false,
      "description": "Fetch the result of an asynchronous SERP request.",
      "properties": {
        "operation": {
          "const": "get_serp_response",
          "default": "get_serp_response",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "response_id": {
          "minLength": 1,
          "title": "Response Id",
          "type": "string"
        }
      },
      "required": [
        "response_id"
      ],
      "title": "BrightdataGetSerpResponseConfig",
      "type": "object"
    },
    "BrightdataListDatasetSnapshotPartsConfig": {
      "additionalProperties": false,
      "description": "Count dataset download parts using the same format and batch size as the download.",
      "properties": {
        "operation": {
          "const": "list_dataset_snapshot_parts",
          "default": "list_dataset_snapshot_parts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "snapshot_id": {
          "description": "Snapshot ID returned by Bright Data.",
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "format": {
          "default": "json",
          "enum": [
            "json",
            "ndjson",
            "jsonl",
            "csv"
          ],
          "title": "Format",
          "type": "string"
        },
        "batch_size": {
          "anyOf": [
            {
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Size"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "BrightdataListDatasetSnapshotPartsConfig",
      "type": "object"
    },
    "BrightdataListDatasetSnapshotsConfig": {
      "additionalProperties": false,
      "description": "List dataset snapshot metadata, optionally filtered by dataset or view.",
      "properties": {
        "operation": {
          "const": "list_dataset_snapshots",
          "default": "list_dataset_snapshots",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "view_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View Id"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "canceled",
                "scheduled",
                "collecting",
                "digesting",
                "validating",
                "building",
                "delivering",
                "pending_discovery_input",
                "pending_pdp_input",
                "pending_developer_review",
                "pending_owner_review",
                "queued_for_developer_review",
                "ready",
                "failed",
                "rolling_back"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "canceled",
            "scheduled",
            "collecting",
            "digesting",
            "validating",
            "building",
            "delivering",
            "pending_discovery_input",
            "pending_pdp_input",
            "pending_developer_review",
            "pending_owner_review",
            "queued_for_developer_review",
            "ready",
            "failed",
            "rolling_back"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "BrightdataListDatasetSnapshotsConfig",
      "type": "object"
    },
    "BrightdataListDatasetViewsConfig": {
      "additionalProperties": false,
      "description": "List the account\u2019s saved dataset views.",
      "properties": {
        "operation": {
          "const": "list_dataset_views",
          "default": "list_dataset_views",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "BrightdataListDatasetViewsConfig",
      "type": "object"
    },
    "BrightdataListDatasetsConfig": {
      "additionalProperties": false,
      "description": "List the datasets available from Bright Data.",
      "properties": {
        "operation": {
          "const": "list_datasets",
          "default": "list_datasets",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "BrightdataListDatasetsConfig",
      "type": "object"
    },
    "BrightdataListScrapeSnapshotPartsConfig": {
      "additionalProperties": false,
      "description": "Count the download parts for a scraper snapshot.",
      "properties": {
        "operation": {
          "const": "list_scrape_snapshot_parts",
          "default": "list_scrape_snapshot_parts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "snapshot_id": {
          "description": "Snapshot ID returned by Bright Data.",
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "format": {
          "default": "json",
          "enum": [
            "json",
            "ndjson",
            "jsonl",
            "csv"
          ],
          "title": "Format",
          "type": "string"
        },
        "batch_size": {
          "anyOf": [
            {
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Size"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "BrightdataListScrapeSnapshotPartsConfig",
      "type": "object"
    },
    "BrightdataListScrapeSnapshotsConfig": {
      "additionalProperties": false,
      "description": "List one page of scraper snapshots. Increase skip by limit to retrieve the next page.",
      "properties": {
        "operation": {
          "const": "list_scrape_snapshots",
          "default": "list_scrape_snapshots",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "dataset_id": {
          "description": "Scraper dataset ID from Bright Data.",
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "starting",
                "running",
                "ready",
                "failed",
                "canceled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "starting",
            "running",
            "ready",
            "failed",
            "canceled"
          ],
          "x-enum-searchable": true
        },
        "skip": {
          "default": 0,
          "minimum": 0,
          "title": "Skip",
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "maximum": 5000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "from_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Date"
        },
        "to_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Date"
        }
      },
      "required": [
        "dataset_id"
      ],
      "title": "BrightdataListScrapeSnapshotsConfig",
      "type": "object"
    },
    "BrightdataListScrapersConfig": {
      "additionalProperties": false,
      "description": "List scrapers configured on the connected account, with their input schemas.",
      "properties": {
        "operation": {
          "const": "list_scrapers",
          "default": "list_scrapers",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        }
      },
      "title": "BrightdataListScrapersConfig",
      "type": "object"
    },
    "BrightdataPauseScrapeConfig": {
      "additionalProperties": false,
      "description": "Pause a running collection.",
      "properties": {
        "operation": {
          "const": "pause_scrape",
          "default": "pause_scrape",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "snapshot_id": {
          "description": "Snapshot ID returned by Bright Data.",
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "BrightdataPauseScrapeConfig",
      "type": "object"
    },
    "BrightdataRerunScrapeConfig": {
      "additionalProperties": false,
      "description": "Rerun a previous collection using its stored inputs. Bright Data bills the new collection.",
      "properties": {
        "operation": {
          "const": "rerun_scrape",
          "default": "rerun_scrape",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "snapshot_id": {
          "description": "Snapshot ID returned by Bright Data.",
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "BrightdataRerunScrapeConfig",
      "type": "object"
    },
    "BrightdataResumeScrapeConfig": {
      "additionalProperties": false,
      "description": "Resume a paused collection.",
      "properties": {
        "operation": {
          "const": "resume_scrape",
          "default": "resume_scrape",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "snapshot_id": {
          "description": "Snapshot ID returned by Bright Data.",
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "BrightdataResumeScrapeConfig",
      "type": "object"
    },
    "BrightdataSearchSerpConfig": {
      "additionalProperties": false,
      "description": "Run a search engine request using your SERP zone. Usage is billed by Bright Data.",
      "properties": {
        "operation": {
          "const": "search_serp",
          "default": "search_serp",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "zone": {
          "description": "SERP zone name from Bright Data's control panel.",
          "minLength": 1,
          "title": "Zone",
          "type": "string"
        },
        "url": {
          "description": "Full search engine URL, for example https://www.google.com/search?q=pizza.",
          "title": "Url",
          "type": "string"
        },
        "format": {
          "default": "json",
          "enum": [
            "json",
            "raw"
          ],
          "title": "Format",
          "type": "string"
        },
        "country": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "asynchronous": {
          "default": false,
          "description": "Return an async response ID; fetch it with Get SERP response.",
          "title": "Asynchronous",
          "type": "boolean"
        }
      },
      "required": [
        "zone",
        "url"
      ],
      "title": "BrightdataSearchSerpConfig",
      "type": "object"
    },
    "BrightdataTriggerScrapeConfig": {
      "additionalProperties": false,
      "description": "Start a scraper job and return its snapshot ID. Bright Data bills the collection; this operation does not wait for completion.",
      "properties": {
        "operation": {
          "const": "trigger_scrape",
          "default": "trigger_scrape",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "dataset_id": {
          "description": "Scraper dataset ID from Bright Data.",
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "inputs": {
          "description": "JSON array of input objects matching this scraper's input schema.",
          "title": "Inputs",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "include_errors": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Include Errors"
        },
        "custom_output_fields": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Output columns separated by |.",
          "title": "Custom Output Fields"
        },
        "limit_per_input": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Per Input"
        }
      },
      "required": [
        "dataset_id",
        "inputs"
      ],
      "title": "BrightdataTriggerScrapeConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "cancel_scrape": "#/$defs/BrightdataCancelScrapeConfig",
          "download_scrape_snapshot": "#/$defs/BrightdataDownloadScrapeSnapshotConfig",
          "get_dataset_snapshot": "#/$defs/BrightdataGetDatasetSnapshotConfig",
          "get_delivery_status": "#/$defs/BrightdataGetDeliveryStatusConfig",
          "get_scrape_input": "#/$defs/BrightdataGetScrapeInputConfig",
          "get_scrape_log": "#/$defs/BrightdataGetScrapeLogConfig",
          "get_scrape_progress": "#/$defs/BrightdataGetScrapeProgressConfig",
          "get_serp_response": "#/$defs/BrightdataGetSerpResponseConfig",
          "list_dataset_snapshot_parts": "#/$defs/BrightdataListDatasetSnapshotPartsConfig",
          "list_dataset_snapshots": "#/$defs/BrightdataListDatasetSnapshotsConfig",
          "list_dataset_views": "#/$defs/BrightdataListDatasetViewsConfig",
          "list_datasets": "#/$defs/BrightdataListDatasetsConfig",
          "list_scrape_snapshot_parts": "#/$defs/BrightdataListScrapeSnapshotPartsConfig",
          "list_scrape_snapshots": "#/$defs/BrightdataListScrapeSnapshotsConfig",
          "list_scrapers": "#/$defs/BrightdataListScrapersConfig",
          "pause_scrape": "#/$defs/BrightdataPauseScrapeConfig",
          "rerun_scrape": "#/$defs/BrightdataRerunScrapeConfig",
          "resume_scrape": "#/$defs/BrightdataResumeScrapeConfig",
          "search_serp": "#/$defs/BrightdataSearchSerpConfig",
          "trigger_scrape": "#/$defs/BrightdataTriggerScrapeConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BrightdataSearchSerpConfig"
        },
        {
          "$ref": "#/$defs/BrightdataGetSerpResponseConfig"
        },
        {
          "$ref": "#/$defs/BrightdataListDatasetsConfig"
        },
        {
          "$ref": "#/$defs/BrightdataListDatasetSnapshotsConfig"
        },
        {
          "$ref": "#/$defs/BrightdataGetDatasetSnapshotConfig"
        },
        {
          "$ref": "#/$defs/BrightdataListDatasetSnapshotPartsConfig"
        },
        {
          "$ref": "#/$defs/BrightdataListDatasetViewsConfig"
        },
        {
          "$ref": "#/$defs/BrightdataListScrapersConfig"
        },
        {
          "$ref": "#/$defs/BrightdataTriggerScrapeConfig"
        },
        {
          "$ref": "#/$defs/BrightdataGetScrapeProgressConfig"
        },
        {
          "$ref": "#/$defs/BrightdataDownloadScrapeSnapshotConfig"
        },
        {
          "$ref": "#/$defs/BrightdataListScrapeSnapshotsConfig"
        },
        {
          "$ref": "#/$defs/BrightdataGetScrapeLogConfig"
        },
        {
          "$ref": "#/$defs/BrightdataListScrapeSnapshotPartsConfig"
        },
        {
          "$ref": "#/$defs/BrightdataGetScrapeInputConfig"
        },
        {
          "$ref": "#/$defs/BrightdataPauseScrapeConfig"
        },
        {
          "$ref": "#/$defs/BrightdataResumeScrapeConfig"
        },
        {
          "$ref": "#/$defs/BrightdataCancelScrapeConfig"
        },
        {
          "$ref": "#/$defs/BrightdataRerunScrapeConfig"
        },
        {
          "$ref": "#/$defs/BrightdataGetDeliveryStatusConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/BrightdataAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Brightdata Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
