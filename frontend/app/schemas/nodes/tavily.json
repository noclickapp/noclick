    "TavilyCrawlConfig": {
      "description": "Traverse a website and return extracted page content.",
      "properties": {
        "url": {
          "description": "Website to explore, e.g. https://docs.example.com.",
          "title": "Root URL",
          "type": "string"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Describe which pages matter; this increases mapping credit cost.",
          "title": "Instructions"
        },
        "max_depth": {
          "default": 1,
          "maximum": 5,
          "minimum": 1,
          "title": "Maximum Depth",
          "type": "integer"
        },
        "max_breadth": {
          "default": 20,
          "maximum": 500,
          "minimum": 1,
          "title": "Maximum Breadth",
          "type": "integer"
        },
        "limit": {
          "default": 50,
          "minimum": 1,
          "title": "Page Limit",
          "type": "integer"
        },
        "select_paths": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex patterns, one per line.",
          "title": "Include Path Patterns",
          "ui:widget": "textarea"
        },
        "exclude_paths": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex patterns, one per line.",
          "title": "Exclude Path Patterns",
          "ui:widget": "textarea"
        },
        "select_domains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex patterns, one per line.",
          "title": "Include Domain Patterns"
        },
        "exclude_domains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex patterns, one per line.",
          "title": "Exclude Domain Patterns"
        },
        "allow_external": {
          "default": true,
          "title": "Include External Links",
          "type": "boolean"
        },
        "timeout": {
          "default": 150,
          "maximum": 150,
          "minimum": 10,
          "title": "Tavily Timeout (Seconds)",
          "type": "integer"
        },
        "include_usage": {
          "default": true,
          "title": "Include Credit Usage",
          "type": "boolean"
        },
        "operation": {
          "const": "crawl",
          "default": "crawl",
          "title": "Crawl",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Content",
          "x-display-name": "Crawl Website",
          "x-is-trigger": false
        },
        "chunks_per_source": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Chunks per Source",
          "type": "integer"
        },
        "extract_depth": {
          "default": "basic",
          "enum": [
            "basic",
            "advanced"
          ],
          "enumNames": [
            "Basic",
            "Advanced"
          ],
          "title": "Extract Depth",
          "type": "string",
          "x-enum-searchable": true
        },
        "format": {
          "default": "markdown",
