  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_channel": "#/$defs/GetChannelConfig",
          "get_channel_type": "#/$defs/GetChannelTypeConfig",
          "get_message": "#/$defs/GetMessageConfig",
