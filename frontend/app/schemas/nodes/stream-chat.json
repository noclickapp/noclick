        },
        {
          "$ref": "#/$defs/ListChannelMembersConfig"
        },
        {
          "$ref": "#/$defs/GetOrCreatePrivateChannelConfig"
        },
        {
          "$ref": "#/$defs/RenameChannelConfig"
        },
        {
          "$ref": "#/$defs/ListMessagesConfig"
        },
        {
          "$ref": "#/$defs/GetMessageConfig"
        },
        {
          "$ref": "#/$defs/ListMessageHistoryConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/StreamChatServerCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Connect a Stream Chat Server Key credential."
    }
