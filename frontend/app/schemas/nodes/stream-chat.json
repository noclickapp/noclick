      "properties": {
        "credential_type": {
          "const": "stream_chat_server_key",
          "default": "stream_chat_server_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_secret": {
          "description": "Server secret from the same Stream Chat application.",
          "title": "API Secret",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key",
        "api_secret"
      ],
      "title": "Stream Chat Server Key",
      "type": "object",
      "x-credential-instructions": "Use your application's API key and server secret. These are server credentials, not a user token or an OAuth grant.",
      "x-credential-url": "https://dashboard.getstream.io/"
    },
