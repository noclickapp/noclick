    "GetOrCreatePrivateChannelConfig": {
      "additionalProperties": false,
      "properties": {
        "channel_type": {
          "title": "Channel Type",
          "type": "string",
          "x-dynamic-options": true,
          "x-resource-type": "stream_chat_channel_type"
        },
        "channel_id": {
          "title": "Channel",
          "type": "string",
          "x-dynamic-options": {
            "depends_on": "channel_type"
          },
          "x-resource-type": "stream_chat_channel"
        },
        "operation": {
          "const": "get_or_create_private_channel",
          "default": "get_or_create_private_channel",
          "description": "Existing membership must match exactly. Creation subscribes members and can emit channel/member events; it is not silent.",
          "title": "Get or Create Private Channel",
          "type": "string"
        },
        "created_by_id": {
          "title": "Creator",
          "type": "string",
          "x-dynamic-options": true,
          "x-resource-type": "stream_chat_user"
        },
        "member_user_ids": {
          "description": "Explicit IDs only; the creator must be included.",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Member User IDs",
          "type": "array"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Channel Name",
          "type": "string"
        },
        "member_restricted_type_confirmed": {
          "const": true,
          "description": "Confirm this app's current channel type and overrides restrict ordinary client reads to members. Membership alone cannot prove effective app permissions.",
          "title": "Member Access Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "channel_type",
        "channel_id",
        "created_by_id",
        "member_user_ids",
        "name",
        "member_restricted_type_confirmed"
      ],
      "title": "GetOrCreatePrivateChannelConfig",
      "type": "object"
    },
