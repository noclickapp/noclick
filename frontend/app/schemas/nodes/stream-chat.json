          "list_channel_types": "#/$defs/ListChannelTypesConfig",
          "list_channels": "#/$defs/ListChannelsConfig",
          "list_message_history": "#/$defs/ListMessageHistoryConfig",
          "list_messages": "#/$defs/ListMessagesConfig",
          "list_users": "#/$defs/ListUsersConfig",
          "rename_channel": "#/$defs/RenameChannelConfig",
          "upsert_user": "#/$defs/UpsertUserConfig"
