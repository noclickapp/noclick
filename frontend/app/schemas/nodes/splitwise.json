    "SplitwiseCreateExpenseConfig": {
      "additionalProperties": false,
      "description": "Create an expense split equally in a group; the current user pays.",
      "properties": {
        "cost": {
          "description": "Decimal cost as a string, with at most two decimal places.",
          "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$",
          "title": "Cost",
          "type": "string"
        },
        "description": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "currency_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency Code"
        },
        "category_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Id"
        },
        "repeat_interval": {
          "anyOf": [
            {
              "enum": [
                "never",
                "weekly",
                "fortnightly",
                "monthly",
                "yearly"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Interval",
          "enum": [
            "never",
            "weekly",
            "fortnightly",
            "monthly",
            "yearly"
          ],
          "x-enum-searchable": true
        },
        "operation": {
          "const": "create_expense",
          "default": "create_expense",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "group_id": {
          "exclusiveMinimum": 0,
          "title": "Group Id",
          "type": "integer"
        },
        "split_equally": {
          "const": true,
          "default": true,
          "title": "Split Equally",
          "type": "boolean"
        }
      },
      "required": [
        "cost",
        "description",
        "group_id"
      ],
      "title": "SplitwiseCreateExpenseConfig",
      "type": "object"
    },
