        "skip": {
          "default": 0,
          "description": "Offset; increase by limit for the next page.",
          "minimum": 0,
          "title": "Skip",
          "type": "integer"
        },
        "limit": {
          "default": 1000,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "operation": {
          "const": "get_call_statistics",
          "default": "get_call_statistics",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "sip": {
          "anyOf": [
            {
              "pattern": "^[0-9]{5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sip"
