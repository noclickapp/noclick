      "title": "GetCallPrice",
      "type": "object"
    },
    "GetCallStatistics": {
      "additionalProperties": false,
      "description": "GET /v1/statistics \u2014 get call statistics.",
      "properties": {
        "start": {
          "description": "Start in account timezone: YYYY-MM-DD HH:MM:SS.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
          "title": "Start",
          "type": "string"
