        "type": {
          "anyOf": [
            {
              "enum": [
                "overall",
                "toll-free"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type",
          "enum": [
            "overall",
            "toll-free"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "GetCallStatistics",
      "type": "object"
    },
