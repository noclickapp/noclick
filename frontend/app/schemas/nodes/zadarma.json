        "end": {
          "description": "End in account timezone: YYYY-MM-DD HH:MM:SS.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
          "title": "End",
          "type": "string"
