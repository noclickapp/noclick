{
  "$defs": {
    "CreateBulkJob": {
      "additionalProperties": false,
      "description": "Submit addresses for asynchronous verification; charged when accepted.",
      "properties": {
        "operation": {
          "const": "create_bulk_job",
          "default": "create_bulk_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "emails": {
          "description": "Addresses in input order. Invalid addresses and empty strings are allowed and reported as invalid_format. Maximum combined size 25 MB; sandbox keys allow 1,000 rows.",
          "items": {
            "maxLength": 1000,
            "type": "string"
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Emails",
          "type": "array"
        },
        "webhook_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional public HTTPS callback URL. Save the returned webhook_secret to verify webhook signatures.",
          "title": "Webhook Url"
        },
        "catch_all": {
          "default": false,
          "description": "Enable paid-plan catch-all detection for the list.",
          "title": "Catch All",
          "type": "boolean"
        }
      },
      "required": [
        "emails"
      ],
      "title": "CreateBulkJob",
      "type": "object"
    },
    "DeleteBulkJob": {
      "additionalProperties": false,
      "description": "Permanently delete a job, its input list and its stored results.",
      "properties": {
        "job_id": {
          "description": "Bulk job ID returned by submission or listing.",
          "pattern": "^[0-9]{1,20}$",
          "title": "Job Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_bulk_job",
          "default": "delete_bulk_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "job_id"
      ],
      "title": "DeleteBulkJob",
      "type": "object"
    },
    "EmailvalidationAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "emailvalidation_api_key",
          "default": "emailvalidation_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Emailvalidation API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the Emailvalidation dashboard. NoClick sends it in the apikey header. Connection checks read your account status and quota without consuming validation credits.",
      "x-credential-url": "https://app.emailvalidation.io/"
    },
    "GetAccountStatus": {
      "additionalProperties": false,
      "description": "Read the authenticated account ID, plan and quota without consuming credits.",
      "properties": {
        "operation": {
          "const": "get_account_status",
          "default": "get_account_status",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetAccountStatus",
      "type": "object"
    },
    "GetBulkJob": {
      "additionalProperties": false,
      "description": "Read status and progress; poll about once per minute until completed.",
      "properties": {
        "job_id": {
          "description": "Bulk job ID returned by submission or listing.",
          "pattern": "^[0-9]{1,20}$",
          "title": "Job Id",
          "type": "string"
        },
        "operation": {
          "const": "get_bulk_job",
          "default": "get_bulk_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetBulkJob",
      "type": "object"
    },
    "GetBulkJobResults": {
      "additionalProperties": false,
      "description": "Download completed results as JSON or a CSV file. Pending jobs return 409.",
      "properties": {
        "job_id": {
          "description": "Bulk job ID returned by submission or listing.",
          "pattern": "^[0-9]{1,20}$",
          "title": "Job Id",
          "type": "string"
        },
        "operation": {
          "const": "get_bulk_job_results",
          "default": "get_bulk_job_results",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "format": {
          "default": "json",
          "description": "JSON preserves per-row results; CSV returns a file.",
          "enum": [
            "json",
            "csv"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetBulkJobResults",
      "type": "object"
    },
    "ListBulkJobs": {
      "additionalProperties": false,
      "description": "Read one page; pass next_before to the following request.",
      "properties": {
        "operation": {
          "const": "list_bulk_jobs",
          "default": "list_bulk_jobs",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "limit": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "before": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,20}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last job ID from the previous page.",
          "title": "Before"
        }
      },
      "title": "ListBulkJobs",
      "type": "object"
    },
    "ValidateEmail": {
      "additionalProperties": false,
      "description": "Validate one address; definitive results consume one request of quota.",
      "properties": {
        "operation": {
          "const": "validate_email",
          "default": "validate_email",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "description": "Email address to validate.",
          "minLength": 1,
          "title": "Email",
          "type": "string"
        },
        "catch_all": {
          "default": "0",
          "description": "1 enables paid-plan catch-all detection; 0 leaves it disabled.",
          "enum": [
            "0",
            "1"
          ],
          "title": "Catch All",
          "type": "string"
        },
        "timeout": {
          "default": 30,
          "description": "Provider check timeout in seconds.",
          "maximum": 60,
          "minimum": 3,
          "title": "Timeout",
          "type": "integer"
        }
      },
      "required": [
        "email"
      ],
      "title": "ValidateEmail",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_bulk_job": "#/$defs/CreateBulkJob",
          "delete_bulk_job": "#/$defs/DeleteBulkJob",
          "get_account_status": "#/$defs/GetAccountStatus",
          "get_bulk_job": "#/$defs/GetBulkJob",
          "get_bulk_job_results": "#/$defs/GetBulkJobResults",
          "list_bulk_jobs": "#/$defs/ListBulkJobs",
          "validate_email": "#/$defs/ValidateEmail"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ValidateEmail"
        },
        {
          "$ref": "#/$defs/CreateBulkJob"
        },
        {
          "$ref": "#/$defs/ListBulkJobs"
        },
        {
          "$ref": "#/$defs/GetBulkJob"
        },
        {
          "$ref": "#/$defs/DeleteBulkJob"
        },
        {
          "$ref": "#/$defs/GetBulkJobResults"
        },
        {
          "$ref": "#/$defs/GetAccountStatus"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmailvalidationAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Emailvalidation Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
