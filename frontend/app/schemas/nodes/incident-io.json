          "x-display-name": "Receive Webhook Events",
          "x-is-trigger": true
        },
        "event_type": {
          "default": "*",
          "description": "Which incident.io webhook event fires this workflow. incident.io delivers every subscribed event to one URL, so this filters the inbound payload by its `event_type`. Choose:\n- All events: fire on any delivered event\n- Incident created/updated/status updated: public incident lifecycle\n- Action created/updated, Follow-up created/updated: post-incident tasks\n- Incident membership granted/revoked: responder added/removed\n- Private incident created/updated/status updated: private-incident equivalents\nMake sure the matching event is enabled in incident.io Settings -> Webhooks.",
          "enum": [
            "*",
            "public_incident.incident_created_v2",
            "public_incident.incident_updated_v2",
            "public_incident.incident_status_updated_v2",
            "public_incident.action_created_v1",
            "public_incident.action_updated_v1",
            "public_incident.follow_up_created_v1",
            "public_incident.follow_up_updated_v1",
            "public_incident.incident_membership_granted_v1",
            "public_incident.incident_membership_revoked_v1",
            "private_incident.incident_created_v2",
            "private_incident.incident_updated_v2",
            "private_incident.incident_status_updated_v2"
          ],
          "enumNames": [
            "All events",
            "Incident created",
            "Incident updated",
            "Incident status updated",
            "Action created",
            "Action updated",
            "Follow-up created",
            "Follow-up updated",
            "Incident membership granted",
            "Incident membership revoked",
            "Private incident created",
            "Private incident updated",
            "Private incident status updated"
          ],
          "title": "Trigger On Event",
          "type": "string",
          "x-enum-searchable": true
        },
