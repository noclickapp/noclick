              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON array of attribute IDs used in the folder; omitted leaves them unchanged.",
          "title": "Attribute IDs (JSON)",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "operation": {
          "const": "create_folder",
          "default": "create_folder",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_id": {
          "title": "Workspace ID",
          "type": "string"
        },
        "board_id": {
          "title": "Board ID",
          "type": "string"
        }
      },
      "required": [
        "name",
        "workspace_id",
        "board_id"
      ],
      "title": "InfinityCreateFolderConfig",
      "type": "object"
    },
    "InfinityCreateItemConfig": {
      "description": "Create item.",
