              "type": "null"
            }
          ],
          "default": null,
          "description": "Parent folder or board ID; omit for a top level folder.",
          "title": "Parent Id"
        },
        "sort_order": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort Order"
        },
        "attribute_ids_json": {
