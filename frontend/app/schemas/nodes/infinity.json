{
  "$defs": {
    "InfinityAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "infinity_api_token",
          "default": "infinity_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Infinity API Token",
      "type": "object",
      "x-credential-instructions": "Enable developer features in Infinity profile settings, open Developer > Tokens, and create a token. Paste the token here without the Bearer prefix. Your token must have access to the workspaces and boards you automate.",
      "x-credential-url": "https://app.startinfinity.com/profile/developer/tokens"
    },
    "InfinityCreateBoardConfig": {
      "description": "Create board.",
      "properties": {
        "operation": {
          "const": "create_board",
          "default": "create_board",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_id": {
          "title": "Workspace ID",
          "type": "string"
        },
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "user_ids_json": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON array of workspace member IDs. Infinity adds the current user automatically.",
          "title": "Member IDs (JSON)",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "workspace_id",
        "name"
      ],
      "title": "InfinityCreateBoardConfig",
      "type": "object"
    },
    "InfinityCreateCommentConfig": {
      "description": "Create comment.",
      "properties": {
        "operation": {
          "const": "create_comment",
          "default": "create_comment",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_id": {
          "title": "Workspace ID",
          "type": "string"
        },
        "board_id": {
          "title": "Board ID",
          "type": "string"
        },
        "item_id": {
          "title": "Item ID",
          "type": "string"
        },
        "text": {
          "description": "Comment body; Infinity accepts HTML.",
          "maxLength": 100000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parent comment ID for a reply.",
          "title": "Parent Id"
        }
      },
      "required": [
        "workspace_id",
        "board_id",
        "item_id",
        "text"
      ],
      "title": "InfinityCreateCommentConfig",
      "type": "object"
    },
    "InfinityCreateFolderConfig": {
      "description": "Create folder.",
      "properties": {
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "color": {
          "anyOf": [
