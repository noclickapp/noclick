{
  "$defs": {
    "CreateDraftFromBlocks": {
      "properties": {
        "saved_block_id": {
          "title": "First Saved Block",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "saved_block_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "qwilr_saved_block"
        },
        "additional_saved_block_ids": {
          "description": "Existing accessible IDs only; this replaces page content for replacement operations.",
          "items": {
            "type": "string"
          },
          "maxItems": 49,
          "title": "Additional Saved Block IDs In Order",
          "type": "array"
        },
        "acknowledge_live_account_effects": {
          "description": "Qwilr has no assumed sandbox. Draft creation persists content and may inherit quote/accept/payment settings or account automation. No publish, send, sign, accept or pay request is made.",
          "title": "Confirm Live Account Draft Changes",
          "type": "boolean"
        },
        "name": {
          "maxLength": 500,
          "title": "Draft Name",
          "type": "string"
        },
        "owner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "owner_id",
            "searchable": true
          },
          "x-resource-type": "qwilr_owner"
        },
        "tags": {
          "description": "Add an owned test tag for manual cleanup; no page DELETE API is documented.",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "substitutions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array"
              }
            ]
          },
          "title": "Variable Values",
          "type": "object",
          "ui:widget": "json"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "May be returned by existing account webhooks. Do not put secrets here.",
          "title": "Page Metadata",
          "type": "object",
          "ui:widget": "json"
        },
        "operation": {
          "const": "create_draft_from_blocks",
          "default": "create_draft_from_blocks",
          "title": "Create Draft From Saved Blocks",
          "type": "string",
          "x-creates-resource": true,
          "x-resource-id-path": "record.id",
          "x-resource-type": "qwilr_page"
        }
      },
      "required": [
        "saved_block_id",
        "acknowledge_live_account_effects",
        "name"
      ],
      "title": "CreateDraftFromBlocks",
      "type": "object"
    },
    "CreateDraftFromTemplate": {
      "properties": {
        "acknowledge_live_account_effects": {
          "description": "Qwilr has no assumed sandbox. Draft creation persists content and may inherit quote/accept/payment settings or account automation. No publish, send, sign, accept or pay request is made.",
          "title": "Confirm Live Account Draft Changes",
          "type": "boolean"
        },
        "name": {
          "maxLength": 500,
          "title": "Draft Name",
          "type": "string"
        },
        "owner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "owner_id",
            "searchable": true
          },
          "x-resource-type": "qwilr_owner"
        },
        "tags": {
          "description": "Add an owned test tag for manual cleanup; no page DELETE API is documented.",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "substitutions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array"
              }
            ]
          },
          "title": "Variable Values",
          "type": "object",
          "ui:widget": "json"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "May be returned by existing account webhooks. Do not put secrets here.",
          "title": "Page Metadata",
          "type": "object",
          "ui:widget": "json"
        },
        "operation": {
          "const": "create_draft_from_template",
          "default": "create_draft_from_template",
          "title": "Create Draft From Template",
          "type": "string",
          "x-creates-resource": true,
          "x-resource-id-path": "record.id",
          "x-resource-type": "qwilr_page"
        },
        "template_id": {
          "description": "Copy the existing template's ID from the Qwilr editor. No template listing or conversion is assumed.",
          "title": "Template ID",
          "type": "string"
        }
      },
      "required": [
        "acknowledge_live_account_effects",
        "name",
        "template_id"
      ],
      "title": "CreateDraftFromTemplate",
      "type": "object"
    },
    "GetAcceptanceSummary": {
      "properties": {
        "operation": {
          "const": "get_acceptance_summary",
          "default": "get_acceptance_summary",
          "description": "Reads real acceptance counts only; does not accept, sign, pay, return signer details or request preview acceptance.",
          "title": "Get Acceptance Counts",
          "type": "string"
        },
        "page_id": {
          "title": "Page",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "page_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "qwilr_page"
        }
      },
      "required": [
        "page_id"
      ],
      "title": "GetAcceptanceSummary",
      "type": "object"
    },
    "GetPage": {
      "properties": {
        "operation": {
          "const": "get_page",
          "default": "get_page",
          "title": "Get Page Metadata",
          "type": "string"
        },
        "page_id": {
          "title": "Page",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "page_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "qwilr_page"
        }
      },
      "required": [
        "page_id"
      ],
      "title": "GetPage",
      "type": "object"
    },
    "ListPages": {
      "properties": {
        "operation": {
          "const": "list_pages",
          "default": "list_pages",
          "title": "List Page Metadata",
          "type": "string"
        },
        "limit": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use next_cursor from the last result; retain all filters and sort order.",
          "title": "Provider Cursor"
        },
        "statuses": {
          "items": {
            "enum": [
              "draft",
              "live",
              "accepting",
              "accepted",
              "disabled",
              "declined"
            ],
            "type": "string"
          },
          "title": "Statuses",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "All Tags",
          "type": "array"
        },
        "folder_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct children only. Qwilr does not document a folder-list API here.",
          "title": "Folder ID"
        },
        "owner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "owner_id",
            "searchable": true
          },
          "x-resource-type": "qwilr_owner"
        },
        "sort_direction": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Created Time Order",
          "type": "string"
        }
      },
      "title": "ListPages",
      "type": "object"
    },
    "ListSavedBlocks": {
      "properties": {
        "operation": {
          "const": "list_saved_blocks",
          "default": "list_saved_blocks",
          "title": "List Saved Block Metadata",
          "type": "string"
        }
      },
      "title": "ListSavedBlocks",
      "type": "object"
    },
    "ListUsers": {
      "properties": {
        "operation": {
          "const": "list_users",
          "default": "list_users",
          "description": "ID, name, creation date and team names only. No email, roles or current-user identity claim.",
          "title": "List Account User Metadata",
          "type": "string"
        }
      },
      "title": "ListUsers",
      "type": "object"
    },
    "QwilrAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "qwilr_api_token",
          "default": "qwilr_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "title": "Qwilr Account Access Token",
          "type": "string",
          "ui:sensitive": true,
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Qwilr Account Token",
      "type": "object",
      "x-credential-instructions": "Supply your existing Qwilr account access token from API Settings. All calls use your live account and the token owner's accessible pages. API entitlement is account dependent. No OAuth exchange, refresh or identity endpoint is assumed; reconnect with an existing replacement token when needed.",
      "x-credential-url": "https://app.qwilr.com/#/settings/api"
    },
    "QwilrMcpCredential": {
      "description": "Qwilr connected through Qwilr's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "qwilr_mcp",
          "default": "qwilr_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "Qwilr MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://mcp.qwilr.com",
      "x-mcp-transport": "shttp"
    },
    "ReplaceDraftBlocks": {
      "properties": {
        "saved_block_id": {
          "title": "First Saved Block",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "saved_block_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "qwilr_saved_block"
        },
        "additional_saved_block_ids": {
          "description": "Existing accessible IDs only; this replaces page content for replacement operations.",
          "items": {
            "type": "string"
          },
          "maxItems": 49,
          "title": "Additional Saved Block IDs In Order",
          "type": "array"
        },
        "acknowledge_live_account_effects": {
          "description": "Qwilr has no assumed sandbox. Draft creation persists content and may inherit quote/accept/payment settings or account automation. No publish, send, sign, accept or pay request is made.",
          "title": "Confirm Live Account Draft Changes",
          "type": "boolean"
        },
        "operation": {
          "const": "replace_draft_blocks",
          "default": "replace_draft_blocks",
          "description": "Full content replacement, supported by Qwilr only for pages originally created from saved blocks. No provider CAS contract is documented; concurrent edits remain possible.",
          "title": "Replace Draft Content From Saved Blocks",
          "type": "string"
        },
        "page_id": {
          "title": "Draft Page",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "page_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "qwilr_page"
        },
        "saved_block_page_confirmed": {
          "description": "Confirm the source method from your owned workflow. The API response does not expose a documented source-method marker.",
          "title": "Confirm Page Was Created From Saved Blocks",
          "type": "boolean"
        },
        "substitutions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array"
              }
            ]
          },
          "title": "Variable Values",
          "type": "object",
          "ui:widget": "json"
        }
      },
      "required": [
        "saved_block_id",
        "acknowledge_live_account_effects",
        "page_id",
        "saved_block_page_confirmed"
      ],
      "title": "ReplaceDraftBlocks",
      "type": "object"
    },
    "UpdateDraftExpiry": {
      "properties": {
        "acknowledge_live_account_effects": {
          "description": "Qwilr has no assumed sandbox. Draft creation persists content and may inherit quote/accept/payment settings or account automation. No publish, send, sign, accept or pay request is made.",
          "title": "Confirm Live Account Draft Changes",
          "type": "boolean"
        },
        "operation": {
          "const": "update_draft_expiry",
          "default": "update_draft_expiry",
          "description": "Stores expiry on an existing draft. The countdown starts when someone later publishes; expiry can then disable its link and decline the page.",
          "title": "Set Draft Link Expiry",
          "type": "string"
        },
        "page_id": {
          "title": "Draft Page",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "page_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "qwilr_page"
        },
        "expire_after_days": {
          "maximum": 365,
          "minimum": 1,
          "title": "Expire After Days",
          "type": "integer"
        }
      },
      "required": [
        "acknowledge_live_account_effects",
        "page_id",
        "expire_after_days"
      ],
      "title": "UpdateDraftExpiry",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_draft_from_blocks": "#/$defs/CreateDraftFromBlocks",
          "create_draft_from_template": "#/$defs/CreateDraftFromTemplate",
          "get_acceptance_summary": "#/$defs/GetAcceptanceSummary",
          "get_page": "#/$defs/GetPage",
          "list_pages": "#/$defs/ListPages",
          "list_saved_blocks": "#/$defs/ListSavedBlocks",
          "list_users": "#/$defs/ListUsers",
          "replace_draft_blocks": "#/$defs/ReplaceDraftBlocks",
          "update_draft_expiry": "#/$defs/UpdateDraftExpiry"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListPages"
        },
        {
          "$ref": "#/$defs/GetPage"
        },
        {
          "$ref": "#/$defs/GetAcceptanceSummary"
        },
        {
          "$ref": "#/$defs/ListSavedBlocks"
        },
        {
          "$ref": "#/$defs/ListUsers"
        },
        {
          "$ref": "#/$defs/CreateDraftFromTemplate"
        },
        {
          "$ref": "#/$defs/CreateDraftFromBlocks"
        },
        {
          "$ref": "#/$defs/ReplaceDraftBlocks"
        },
        {
          "$ref": "#/$defs/UpdateDraftExpiry"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/QwilrAPITokenCredential"
        },
        {
          "$ref": "#/$defs/QwilrMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "Qwilr Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "List proposal page statuses",
    "Create an unpublished proposal draft from an existing template",
    "Create or replace a draft from saved blocks",
    "Read acceptance counts without signer details"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
