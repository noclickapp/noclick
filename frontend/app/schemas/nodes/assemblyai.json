        },
        "format_text": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format Text"
        },
        "keyterms_prompt": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Terms"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcription Prompt",
          "ui:widget": "textarea"
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook URL"
        },
        "redact_pii": {
          "default": false,
          "title": "Redact PII",
          "type": "boolean"
        },
        "redact_pii_policies": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "PII Policies"
        },
        "redact_pii_audio": {
          "default": false,
          "title": "Redact PII Audio",
          "type": "boolean"
        },
        "max_wait_seconds": {
          "default": 180,
          "maximum": 600,
          "minimum": 10,
          "title": "Maximum Wait (seconds)",
          "type": "integer"
        },
        "poll_interval_seconds": {
          "default": 3,
          "maximum": 30,
          "minimum": 1,
          "title": "Poll Interval (seconds)",
          "type": "integer"
        }
      },
      "required": [
        "audio_url"
      ],
      "title": "Transcribe and Wait",
      "type": "object"
    },
    "AssemblyAIUploadAudioConfig": {
      "properties": {
        "operation": {
          "const": "upload_audio",
          "default": "upload_audio",
          "title": "Upload Audio",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Audio",
          "x-display-name": "Upload Audio",
          "x-is-trigger": false
        },
        "audio_base64": {
          "description": "Base64-encoded media bytes, up to 20 MB",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "title": "Base64 Audio",
          "type": "string"
        }
      },
      "required": [
        "audio_base64"
      ],
      "title": "Upload Audio",
      "type": "object"
    },
    "AssemblyAIWordSearchConfig": {
      "properties": {
        "operation": {
          "const": "word_search",
          "default": "word_search",
          "title": "Search Words",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Transcript Results",
          "x-display-name": "Search Words",
          "x-is-trigger": false
        },
        "transcript_id": {
          "title": "Transcript ID",
          "type": "string"
        },
        "words": {
          "description": "JSON array, e.g. [\"NoClick\", \"workflow\"]",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Words or Phrases",
          "type": "array"
        }
      },
      "required": [
        "transcript_id",
        "words"
      ],
      "title": "Search Transcript Words",
      "type": "object"
    },
    "AssemblyaiMcpCredential": {
      "description": "AssemblyAI connected through AssemblyAI's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "assemblyai_mcp",
          "default": "assemblyai_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "AssemblyAI MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://mcp.assemblyai.com/mcp",
      "x-mcp-transport": "shttp"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "delete_transcript": "#/$defs/AssemblyAIDeleteTranscriptConfig",
          "get_paragraphs": "#/$defs/AssemblyAIGetParagraphsConfig",
          "get_redacted_audio": "#/$defs/AssemblyAIGetRedactedAudioConfig",
          "get_sentences": "#/$defs/AssemblyAIGetSentencesConfig",
          "get_subtitles": "#/$defs/AssemblyAIGetSubtitlesConfig",
          "get_transcript": "#/$defs/AssemblyAIGetTranscriptConfig",
          "list_transcripts": "#/$defs/AssemblyAIListTranscriptsConfig",
          "submit_transcript": "#/$defs/AssemblyAISubmitTranscriptConfig",
          "transcribe_and_wait": "#/$defs/AssemblyAITranscribeAndWaitConfig",
          "upload_audio": "#/$defs/AssemblyAIUploadAudioConfig",
          "word_search": "#/$defs/AssemblyAIWordSearchConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AssemblyAIListTranscriptsConfig"
        },
        {
          "$ref": "#/$defs/AssemblyAIGetTranscriptConfig"
        },
        {
          "$ref": "#/$defs/AssemblyAISubmitTranscriptConfig"
        },
        {
          "$ref": "#/$defs/AssemblyAITranscribeAndWaitConfig"
        },
        {
          "$ref": "#/$defs/AssemblyAIUploadAudioConfig"
        },
        {
          "$ref": "#/$defs/AssemblyAIGetSentencesConfig"
        },
        {
          "$ref": "#/$defs/AssemblyAIGetParagraphsConfig"
        },
        {
          "$ref": "#/$defs/AssemblyAIGetSubtitlesConfig"
        },
        {
          "$ref": "#/$defs/AssemblyAIGetRedactedAudioConfig"
        },
        {
          "$ref": "#/$defs/AssemblyAIWordSearchConfig"
        },
        {
          "$ref": "#/$defs/AssemblyAIDeleteTranscriptConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssemblyAIAPIKeyCredential"
        },
        {
          "$ref": "#/$defs/AssemblyaiMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "Assemblyai Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Transcribe this interview and identify each speaker",
    "Find mentions of a product in a completed transcript",
    "Generate SRT subtitles from this transcript"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
