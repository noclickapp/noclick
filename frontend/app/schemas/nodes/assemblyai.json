            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Speakers"
        },
        "punctuate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
