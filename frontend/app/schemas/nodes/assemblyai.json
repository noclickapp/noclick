{
  "$defs": {
    "AssemblyAIAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "assemblyai_api_key",
          "default": "assemblyai_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "AssemblyAI API Key",
      "type": "object",
      "x-credential-instructions": "Create a project API key in the AssemblyAI dashboard and paste it here.",
      "x-credential-url": "https://www.assemblyai.com/dashboard/api-keys"
    },
    "AssemblyAIDeleteTranscriptConfig": {
      "properties": {
        "operation": {
          "const": "delete_transcript",
          "default": "delete_transcript",
          "title": "Delete Transcript",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Transcripts",
          "x-display-name": "Delete Transcript",
          "x-is-trigger": false
        },
        "transcript_id": {
          "title": "Transcript ID",
          "type": "string"
        }
      },
      "required": [
        "transcript_id"
      ],
      "title": "Delete Transcript",
      "type": "object"
    },
    "AssemblyAIGetParagraphsConfig": {
      "properties": {
        "operation": {
          "const": "get_paragraphs",
          "default": "get_paragraphs",
          "title": "Get Paragraphs",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Transcript Results",
          "x-display-name": "Get Paragraphs",
          "x-is-trigger": false
        },
        "transcript_id": {
          "title": "Transcript ID",
          "type": "string"
        }
      },
      "required": [
        "transcript_id"
      ],
      "title": "Get Transcript Paragraphs",
      "type": "object"
    },
    "AssemblyAIGetRedactedAudioConfig": {
      "properties": {
        "operation": {
          "const": "get_redacted_audio",
          "default": "get_redacted_audio",
          "title": "Get Redacted Audio",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Transcript Results",
          "x-display-name": "Get Redacted Audio",
          "x-is-trigger": false
        },
        "transcript_id": {
          "title": "Transcript ID",
          "type": "string"
        }
      },
      "required": [
        "transcript_id"
      ],
      "title": "Get Redacted Audio",
      "type": "object"
    },
    "AssemblyAIGetSentencesConfig": {
      "properties": {
        "operation": {
          "const": "get_sentences",
          "default": "get_sentences",
          "title": "Get Sentences",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Transcript Results",
          "x-display-name": "Get Sentences",
          "x-is-trigger": false
        },
        "transcript_id": {
          "title": "Transcript ID",
          "type": "string"
        }
      },
      "required": [
        "transcript_id"
      ],
      "title": "Get Transcript Sentences",
      "type": "object"
    },
    "AssemblyAIGetSubtitlesConfig": {
      "properties": {
        "operation": {
          "const": "get_subtitles",
          "default": "get_subtitles",
          "title": "Get Subtitles",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Transcript Results",
          "x-display-name": "Get Subtitles",
          "x-is-trigger": false
        },
        "transcript_id": {
          "title": "Transcript ID",
          "type": "string"
        },
        "format": {
          "default": "srt",
          "enum": [
            "srt",
            "vtt"
          ],
          "title": "Subtitle Format",
          "type": "string"
        },
        "chars_per_caption": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Characters per Caption"
        }
      },
      "required": [
        "transcript_id"
      ],
      "title": "Get Subtitles",
      "type": "object"
    },
    "AssemblyAIGetTranscriptConfig": {
      "properties": {
        "operation": {
          "const": "get_transcript",
          "default": "get_transcript",
          "title": "Get Transcript",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Transcripts",
          "x-display-name": "Get Transcript",
          "x-is-trigger": false
        },
        "transcript_id": {
          "title": "Transcript ID",
          "type": "string"
        }
      },
      "required": [
        "transcript_id"
      ],
      "title": "Get Transcript",
      "type": "object"
    },
    "AssemblyAIListTranscriptsConfig": {
      "properties": {
        "operation": {
          "const": "list_transcripts",
          "default": "list_transcripts",
          "title": "List Transcripts",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Transcripts",
          "x-display-name": "List Transcripts",
          "x-is-trigger": false
        },
        "limit": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "queued",
                "processing",
                "completed",
                "error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "queued",
            "processing",
            "completed",
            "error"
          ],
          "x-enum-searchable": true
        },
        "after_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Transcript ID"
        },
        "before_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Transcript ID"
        }
      },
      "title": "List Transcripts",
      "type": "object"
    },
    "AssemblyAISubmitTranscriptConfig": {
      "properties": {
        "operation": {
          "const": "submit_transcript",
          "default": "submit_transcript",
          "title": "Submit Transcription",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Transcripts",
          "x-display-name": "Submit Transcription",
          "x-is-trigger": false
        },
        "audio_url": {
          "description": "Public or AssemblyAI upload URL of an audio/video file",
          "title": "Audio URL",
          "type": "string"
        },
        "speech_models": {
          "description": "JSON array of models in priority order, e.g. [\"universal-3-5-pro\", \"universal-2\"]",
          "items": {
            "type": "string"
          },
          "title": "Speech Models",
          "type": "array"
        },
        "language_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language Code"
        },
        "language_detection": {
          "default": false,
          "title": "Detect Language",
          "type": "boolean"
        },
        "speaker_labels": {
          "default": false,
          "title": "Speaker Labels",
          "type": "boolean"
        },
        "speakers_expected": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Speakers"
        },
        "punctuate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Punctuate"
        },
        "format_text": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format Text"
        },
        "keyterms_prompt": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Terms"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcription Prompt",
          "ui:widget": "textarea"
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook URL"
        },
        "redact_pii": {
          "default": false,
          "title": "Redact PII",
          "type": "boolean"
        },
        "redact_pii_policies": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "PII Policies"
        },
        "redact_pii_audio": {
          "default": false,
          "title": "Redact PII Audio",
          "type": "boolean"
        }
      },
      "required": [
        "audio_url"
      ],
      "title": "Submit Transcription",
      "type": "object"
    },
    "AssemblyAITranscribeAndWaitConfig": {
