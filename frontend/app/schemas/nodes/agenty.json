        "is_enabled"
      ],
      "title": "ToggleSchedule",
      "type": "object"
    },
    "URLInput": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "url",
          "default": "url",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Data",
          "type": "array"
        }
      },
      "required": [
        "data"
      ],
      "title": "URLInput",
      "type": "object"
    },
    "UpdateInput": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "update_input",
          "default": "update_input",
          "title": "Update Input",
          "type": "string",
          "ui:hidden": true
        },
        "agent_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Agent Id",
          "type": "string"
        },
        "input_source": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "discriminator": {
              "mapping": {
                "agent": "#/$defs/AgentInput",
                "list": "#/$defs/ListInput",
                "manual": "#/$defs/ManualInput",
                "url": "#/$defs/URLInput"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ManualInput"
              },
              {
                "$ref": "#/$defs/URLInput"
              },
              {
                "$ref": "#/$defs/ListInput"
              },
              {
                "$ref": "#/$defs/AgentInput"
              }
            ]
          },
          "description": "Agenty input source JSON, for example {\"type\":\"manual\",\"data\":[\"https://example.com/page-1\"]}.",
          "title": "Input Source",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "agent_id",
        "input_source"
      ],
      "title": "UpdateInput",
      "type": "object"
    },
    "UpdateList": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "update_list",
          "default": "update_list",
          "title": "Update List",
          "type": "string",
          "ui:hidden": true
        },
        "list_id": {
          "exclusiveMinimum": 0,
          "title": "List Id",
          "type": "integer"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "list_id",
        "name"
      ],
      "title": "UpdateList",
      "type": "object"
    },
    "UpdateRow": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "update_row",
          "default": "update_row",
          "title": "Update Row",
          "type": "string",
          "ui:hidden": true
        },
        "list_id": {
          "exclusiveMinimum": 0,
          "title": "List Id",
          "type": "integer"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Row ID",
          "type": "string"
        },
        "row": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "minProperties": 1,
            "type": "object"
          },
          "description": "Values keyed by your list column names.",
          "title": "Row",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "list_id",
        "id",
        "row"
      ],
      "title": "UpdateRow",
      "type": "object"
    }
  },
