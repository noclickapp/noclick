{
  "$defs": {
    "AdjustInventory": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "adjust_inventory",
          "default": "adjust_inventory",
          "title": "Operation",
          "type": "string"
        },
        "variant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Variant Id",
          "type": "string"
        },
        "adjustment": {
          "default": "set_finite",
          "enum": [
            "increment",
            "decrement",
            "set_finite",
            "set_unlimited"
          ],
          "title": "Adjustment",
          "type": "string"
        },
        "quantity": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "idempotency_key": {
          "description": "Unique key for this logical stock change. Reuse the same key when checking/retrying an uncertain request; use a new key for a new change.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "variant_id",
        "idempotency_key"
      ],
      "title": "AdjustInventory",
      "type": "object"
    },
