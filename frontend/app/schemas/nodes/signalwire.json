    "SendSMS": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "send_sms",
          "default": "send_sms",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Messaging",
          "x-display-name": "Send SMS"
        },
        "from_number": {
          "description": "An existing SMS-capable number owned by this project; verified caller IDs are unsupported.",
          "pattern": "^\\+[1-9][0-9]{4,16}$",
          "title": "From Number",
          "type": "string"
        },
        "to_number": {
          "description": "Explicit E.164 recipient. Provider consent, registration, geographic and account restrictions still apply.",
          "pattern": "^\\+[1-9][0-9]{4,16}$",
          "title": "Recipient Number",
          "type": "string"
        },
        "message": {
          "maxLength": 1600,
          "minLength": 1,
          "title": "Message",
          "type": "string",
          "ui:widget": "textarea"
        },
        "confirm_send": {
          "const": true,
          "title": "Confirm Sending This SMS",
          "type": "boolean"
        }
      },
      "required": [
        "from_number",
        "to_number",
        "message",
        "confirm_send"
      ],
      "title": "SendSMS",
      "type": "object",
      "x-category": "Messaging",
      "x-display-name": "Send SMS",
      "x-is-trigger": false,
      "x-operation-effect": "Queues a real outbound SMS and may incur charges. 201 means queued, not delivered. No retry, receipt polling, WhatsApp, MMS, callback or consent provisioning."
    },
    "SignalWireProjectTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "signalwire_project_token",
          "default": "signalwire_project_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "space_url": {
          "description": "Your exact HTTPS <space>.signalwire.com origin. Custom domains, API routes and private hosts are unsupported.",
          "title": "SignalWire Space URL",
          "type": "string"
        },
        "project_id": {
          "description": "The UUID of the project that issued this API token; not a Compatibility SID or personal user ID.",
          "title": "Project ID",
          "type": "string"
        },
        "api_token": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Project API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "space_url",
        "project_id",
        "api_token"
      ],
      "title": "SignalWire Project Token",
      "type": "object",
      "x-credential-instructions": "Supply a Project ID and its API token. Management is needed for the connection project probe; Messaging, Voice, Numbers or the documented Fabric scopes are required for their operations. Actual enabled token scopes remain provider authoritative. Personal pat_ and subscriber/guest Bearer tokens are separate unsupported families. Paste the opaque token only, including legacy PT tokens; no OAuth, minting, rotation or SDK default credential chain is performed.",
      "x-credential-url": "https://signalwire.com/docs/platform/your-signalwire-api-space"
    }
  },
