{
  "$defs": {
    "GranolaAddLegalHoldCustodiansConfig": {
      "additionalProperties": false,
      "description": "Add legal hold custodians",
      "properties": {
        "operation": {
          "const": "add_legal_hold_custodians",
          "default": "add_legal_hold_custodians",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Legal Holds",
          "x-operation-name": "Add Legal Hold Custodians"
        },
        "custodians": {
          "description": "Users to name on this hold",
          "items": {
            "$ref": "#/$defs/GranolaLegalHoldCustodianInput"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Custodians",
          "type": "array"
        },
        "hold_id": {
          "description": "The legal hold id",
          "pattern": "^lgh_[a-zA-Z0-9]{14}$",
          "title": "Hold Id",
          "type": "string"
        }
      },
      "required": [
        "custodians",
        "hold_id"
      ],
      "title": "GranolaAddLegalHoldCustodiansConfig",
      "type": "object"
    },
    "GranolaApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "granola_api_key",
          "default": "granola_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Granola API Key",
      "type": "object",
      "x-credential-instructions": "Create a personal or workspace API key in Granola Settings \u2192 Connectors \u2192 API keys. Personal keys require Business or Enterprise; workspace keys require Enterprise. Key scopes determine accessible notes and administrative operations.",
      "x-credential-url": "https://docs.granola.ai/authentication"
    },
    "GranolaCreateLegalHoldConfig": {
      "additionalProperties": false,
      "description": "Create legal hold",
      "properties": {
        "operation": {
          "const": "create_legal_hold",
          "default": "create_legal_hold",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Legal Holds",
          "x-operation-name": "Create Legal Hold"
        },
        "name": {
          "description": "A name for the matter this hold preserves",
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free text describing the matter",
          "title": "Description"
        },
        "covers_entire_workspace": {
          "description": "Whether the hold covers every member of your workspace, current and future. Required: scope is never something a caller falls into.",
          "title": "Covers Entire Workspace",
          "type": "boolean"
        },
        "custodians": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/GranolaLegalHoldCustodianInput"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Users to name individually when the hold is created",
          "title": "Custodians"
        }
      },
      "required": [
        "name",
        "covers_entire_workspace"
      ],
      "title": "GranolaCreateLegalHoldConfig",
      "type": "object"
    },
    "GranolaCreateWebhookEndpointConfig": {
      "additionalProperties": false,
      "description": "Create webhook endpoint",
      "properties": {
        "operation": {
          "const": "create_webhook_endpoint",
          "default": "create_webhook_endpoint",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Webhooks",
          "x-operation-name": "Create Webhook Endpoint"
        },
        "url": {
          "description": "The publicly reachable HTTPS URL to deliver events to",
          "title": "Url",
          "type": "string"
        },
        "scopes": {
          "description": "Which notes to receive events for. `personal` covers notes you own, notes shared directly with you, and notes in private folders shared with you. `public` covers notes visible to everyone in the workspace. Pass both for both sets of notes. Workspace admins can disable scopes for non-admin members in the workspace's API settings. With a Workspace API key, pass exactly `[\"workspace\"]` \u2014 the key's own scope: public workspace notes plus notes in spaces with Granola API access enabled.",
          "items": {
            "enum": [
              "personal",
              "public",
              "workspace"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Scopes",
          "type": "array"
        },
        "events": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "note.access_granted",
                  "note.edited",
                  "note.generated"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": [
            "note.access_granted",
            "note.edited",
            "note.generated"
          ],
          "description": "Event names to subscribe to. Omit to subscribe to all events.",
          "title": "Events"
        },
        "folder_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict delivery to notes in these folders or any of their subfolders. Accepts folder IDs returned by `GET /v1/folders`. Omit to receive events for every note matching `scopes`. The same filter applies to all subscribed `events`.",
          "title": "Folder Ids"
        }
      },
      "required": [
        "url",
        "scopes"
      ],
      "title": "GranolaCreateWebhookEndpointConfig",
      "type": "object"
    },
    "GranolaDeleteWebhookEndpointConfig": {
      "additionalProperties": false,
      "description": "Delete webhook endpoint",
