    "GranolaGetNoteConfig": {
      "additionalProperties": false,
      "description": "Get note",
      "properties": {
        "operation": {
          "const": "get_note",
          "default": "get_note",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Notes",
          "x-operation-name": "Get Note"
        },
        "note_id": {
          "description": "The ID of the note",
          "pattern": "^not_[a-zA-Z0-9]{14}$",
          "title": "Note Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "note_id",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "include": {
          "anyOf": [
            {
              "const": "transcript",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Include the note transcript in the response. If it is too large to return inline, Get Note returns `TRANSCRIPT_TOO_LARGE`; retrieve it in pages from `/v1/notes/{note_id}/transcript`.",
          "title": "Include"
        }
      },
      "required": [
        "note_id"
      ],
      "title": "GranolaGetNoteConfig",
      "type": "object"
