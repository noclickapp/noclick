{
  "$defs": {
    "ImapCheckConnectionConfig": {
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "description": "Sign in to the IMAP and SMTP servers, sending nothing, and show the newest senders in the inbox.",
          "title": "Check connection",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Mailbox",
          "x-display-name": "Check connection",
          "x-is-trigger": false,
          "x-keywords": [
            "test login",
            "verify account"
          ]
        }
      },
      "title": "ImapCheckConnectionConfig",
      "type": "object"
    },
    "ImapCredential": {
      "description": "An email account over IMAP and SMTP, signed in with an app password.",
      "properties": {
        "credential_type": {
          "const": "imap_smtp",
          "default": "imap_smtp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "imap_host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filled in for Yahoo, AOL, iCloud, Zoho, Fastmail, GMX and mail.com addresses.",
          "title": "IMAP server",
          "ui:placeholder": "imap.example.com"
        },
        "imap_port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "IMAP port",
          "ui:placeholder": "993"
        },
        "imap_security": {
          "default": "auto",
          "enum": [
            "auto",
            "ssl",
            "starttls"
          ],
          "enumNames": [
            "Automatic (from the port)",
            "SSL/TLS",
            "STARTTLS"
          ],
          "title": "IMAP security",
          "type": "string"
        },
        "smtp_host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filled in for Yahoo, AOL, iCloud, Zoho, Fastmail, GMX and mail.com addresses.",
          "title": "SMTP server",
          "ui:placeholder": "smtp.example.com"
        },
        "smtp_port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "SMTP port",
          "ui:placeholder": "465"
        },
        "smtp_security": {
          "default": "auto",
          "enum": [
            "auto",
            "ssl",
            "starttls"
          ],
          "enumNames": [
            "Automatic (from the port)",
            "SSL/TLS",
            "STARTTLS"
          ],
          "title": "SMTP security",
          "type": "string"
        },
        "email": {
          "title": "Email address",
          "type": "string",
          "ui:placeholder": "you@yahoo.com"
        },
        "password": {
          "description": "The app password your provider made for NoClick, not your normal password.",
          "title": "App password",
          "type": "string",
          "ui:widget": "password"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only if your server signs in with something other than your email address.",
          "title": "Username"
        }
      },
      "required": [
        "email",
        "password"
      ],
      "title": "App Password",
      "type": "object",
      "x-credential-instructions": "Sign in with your email address and an app password, a password your provider makes for one app: most no longer let apps use your normal password.\n- Yahoo Mail: https://login.yahoo.com/account/security (Generate app password)\n- AOL: https://login.aol.com/account/security (Generate app password)\n- iCloud Mail: https://account.apple.com (Sign-In and Security, then App-Specific Passwords)\n- Zoho Mail: https://accounts.zoho.com/home#security/app_password (and turn on IMAP access in Zoho Mail's settings)\n- Fastmail: https://app.fastmail.com/settings/security (Manage app passwords)\n- GMX and mail.com: turn on POP3 & IMAP access in the mailbox's settings (mail.com has it with Premium).\nFor these, NoClick knows the servers. For a company or any other mailbox, open More options and enter the IMAP and SMTP servers your provider gives. Gmail and Outlook.com don't take an app password here: use NoClick's Gmail or Outlook step, which signs in with Google or Microsoft."
    },
    "ImapGetMessageConfig": {
      "properties": {
        "folder": {
          "default": "INBOX",
          "description": "The folder the message is in.",
          "title": "Folder",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Or type a folder name",
            "field_name": "folder",
            "placeholder": "Select a folder...",
            "searchable": true
          }
        },
        "uid": {
          "description": "The message's UID in its folder, from Search messages or the New email trigger.",
          "title": "Message UID",
          "type": "string"
        },
        "uidvalidity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The folder's UIDVALIDITY that came with the UID. With it, a folder rebuilt since then is refused instead of acting on another message.",
          "title": "UIDVALIDITY",
          "ui:category": "Options"
        },
        "operation": {
          "const": "get_message",
          "default": "get_message",
          "description": "One message whole: its headers, text, HTML and attachments (kept as files). Reading it doesn't mark it read.",
          "title": "Get a message",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Messages",
          "x-display-name": "Get a message",
          "x-is-trigger": false,
          "x-keywords": [
            "read email",
            "open email",
            "email body",
            "download attachment"
          ]
        },
        "download_attachments": {
          "default": true,
          "title": "Keep attachments as files",
          "type": "boolean",
          "ui:category": "Options"
        }
      },
      "required": [
        "uid"
      ],
      "title": "ImapGetMessageConfig",
      "type": "object"
    },
