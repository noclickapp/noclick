    "IssueBadge": {
      "additionalProperties": false,
      "description": "Issue a badge; Credly normally sends an earner notification.",
      "properties": {
        "organization_id": {
          "description": "UUID from List Organizations.",
          "format": "uuid",
          "title": "Organization ID",
          "type": "string"
        },
        "badge_template_id": {
          "format": "uuid",
          "title": "Badge Template Id",
          "type": "string"
        },
        "issued_at": {
          "description": "Date and time the earner earned the badge, with time zone.",
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "issued_to_first_name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Issued To First Name",
          "type": "string"
        },
        "issued_to_last_name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Issued To Last Name",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "issuer_earner_id": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer Earner Id"
        },
        "issued_to_middle_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issued To Middle Name"
        },
        "operation": {
          "const": "issue_badge",
          "default": "issue_badge",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "recipient_email": {
          "maxLength": 320,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
          "title": "Recipient Email",
          "type": "string"
        },
        "suppress_badge_notification_email": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suppress Badge Notification Email"
        }
      },
      "required": [
        "organization_id",
        "badge_template_id",
        "issued_at",
        "issued_to_first_name",
        "issued_to_last_name",
        "recipient_email"
      ],
      "title": "IssueBadge",
      "type": "object"
    },
