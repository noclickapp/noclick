{
  "$defs": {
    "Activity": {
      "additionalProperties": false,
      "properties": {
        "activity_type": {
          "enum": [
            "Application",
            "Assessment",
            "Award",
            "Badge",
            "Course",
            "Credential",
            "Education Experience",
            "Leadership",
            "Member",
            "Other",
            "Participant",
            "Payment",
            "Portfolio",
            "Presenter",
            "Project",
            "Professional Experience",
            "Schedule / Registration",
            "Volunteer"
          ],
          "title": "Activity Type",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "activity_url": {
          "anyOf": [
            {
              "maxLength": 255,
              "pattern": "^https?://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Url"
        },
        "required_badge_template_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Badge Template Id"
        }
      },
      "required": [
        "activity_type",
        "title"
      ],
      "title": "Activity",
      "type": "object"
    },
    "CreateBadgeTemplate": {
      "additionalProperties": false,
      "description": "Create a badge template with criteria, skills and an image URL.",
      "properties": {
        "organization_id": {
          "description": "UUID from List Organizations.",
          "format": "uuid",
          "title": "Organization ID",
          "type": "string"
        },
        "operation": {
          "const": "create_badge_template",
          "default": "create_badge_template",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "badge_template_activities": {
          "items": {
            "$ref": "#/$defs/Activity"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Badge Template Activities",
          "type": "array"
        },
        "image": {
          "$ref": "#/$defs/TemplateImage"
        },
        "global_activity_url": {
          "maxLength": 255,
          "pattern": "^https?://[^\\s]+$",
          "title": "Global Activity Url",
          "type": "string"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 3,
          "title": "Skills",
          "type": "array"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "active",
                "draft",
                "archived"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State",
          "enum": [
            "active",
            "draft",
            "archived"
          ],
          "x-enum-searchable": true
        },
        "reporting_tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reporting Tags"
        },
        "allow_duplicate_badges": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allow Duplicate Badges"
        }
      },
      "required": [
        "organization_id",
        "name",
        "description",
        "badge_template_activities",
        "image",
        "global_activity_url",
        "skills"
      ],
      "title": "CreateBadgeTemplate",
      "type": "object"
    },
    "CredlyTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "credly_api_token",
          "default": "credly_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Authorization token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Credly Authorization Token",
      "type": "object",
      "x-credential-instructions": "In Credly Organization Management, open Developers and copy an authorization token. Paste the token here. NoClick sends it as the HTTP Basic username with a blank password to api.credly.com. Tokens expire after 180 days by default; replace an expired token here. Write operations need a token with write permissions.",
      "x-credential-url": "https://docs.credly.com/browse/docs/authentication-methods"
    },
    "DeleteBadgeTemplate": {
      "additionalProperties": false,
