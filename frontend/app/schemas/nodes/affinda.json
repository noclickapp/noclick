    "AffindaAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "affinda_api_key",
          "default": "affinda_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "region": {
          "default": "api",
          "description": "api = Global / Australia; api.us1 = US; api.eu1 = EU",
          "enum": [
            "api",
            "api.us1",
            "api.eu1"
          ],
          "title": "Region",
          "type": "string"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Affinda API Key",
      "type": "object",
      "x-credential-instructions": "Paste your API key from Settings in the Affinda web app. Choose the region matching your account's app URL: Global (app.affinda.com), US (app.us1.affinda.com), or EU (app.eu1.affinda.com). NoClick sends the key as a Bearer token only to that region's Affinda API. Document parsing consumes your Affinda credits.",
      "x-credential-url": "https://app.affinda.com/"
    },
    "CreateDocument": {
      "additionalProperties": false,
      "description": "Have Affinda fetch and parse a document URL; consumes parsing credits.",
      "properties": {
        "operation": {
          "const": "create_document",
          "default": "create_document",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "description": "Public document URL fetched by Affinda, for example https://api.affinda.com/static/sample_resumes/example.docx",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "workspace": {
          "description": "Workspace to receive the document",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Workspace",
          "type": "string"
        },
        "collection": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection"
        },
        "document_type": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Type"
        },
        "file_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Name"
        },
        "custom_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Identifier"
        }
      },
      "required": [
        "url",
        "workspace"
      ],
      "title": "CreateDocument",
      "type": "object"
    },
