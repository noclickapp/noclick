          "type": "string"
        },
        "api_token": {
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "org_url",
        "api_token"
      ],
      "title": "Okta API Token",
      "type": "object",
      "x-credential-instructions": "In your Okta Admin Console, open Security \u2192 API \u2192 Tokens and create a token. Paste the token and your organization URL. The token inherits its creator's permissions; use an administrator permitted to manage the resources your workflow needs.",
