      "properties": {
        "credential_type": {
          "const": "okta_api_token",
          "default": "okta_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "org_url": {
          "description": "Your Okta organization URL, such as https://example.okta.com. Custom domains are supported. Use the organization host, not the -admin host.",
