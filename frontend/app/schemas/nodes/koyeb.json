{
  "$defs": {
    "KoyebAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "koyeb_api_key",
          "default": "koyeb_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Existing token sent only in the Bearer header. Its current organization must match the UUID below.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Koyeb API Token",
          "type": "string",
          "ui:widget": "password"
        },
        "organization_id": {
          "description": "Explicit organization UUID. The read-only current-organization check must match it.",
          "format": "uuid",
          "title": "Koyeb Organization ID",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "organization_id"
      ],
      "title": "Koyeb API Token",
      "type": "object",
      "x-credential-url": "https://www.koyeb.com/docs/reference/api"
    },
