{
  "$defs": {
    "QueueSlot": {
      "additionalProperties": false,
      "properties": {
        "hour": {
          "maximum": 23,
          "minimum": 0,
          "title": "Hour",
          "type": "integer"
        },
        "minute": {
          "maximum": 59,
          "minimum": 0,
          "title": "Minute",
          "type": "integer"
        }
      },
      "required": [
        "hour",
        "minute"
      ],
      "title": "QueueSlot",
      "type": "object"
    },
    "UploadPostAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "upload_post_api_key",
          "default": "upload_post_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Upload Post API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the Upload Post dashboard and paste it here. Connect your social accounts in Upload Post before publishing.",
      "x-credential-url": "https://app.upload-post.com/"
    },
    "UploadPostCancelScheduledPostConfig": {
      "additionalProperties": false,
      "description": "Cancel a scheduled post.",
      "properties": {
        "operation": {
          "const": "cancel_scheduled_post",
          "default": "cancel_scheduled_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "job_id": {
          "description": "The unique job identifier.",
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "UploadPostCancelScheduledPostConfig",
      "type": "object"
    },
    "UploadPostCreateProfileConfig": {
      "additionalProperties": false,
      "description": "Create user profile.",
      "properties": {
        "operation": {
          "const": "create_profile",
          "default": "create_profile",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "username": {
          "description": "A unique identifier for the user on your platform. It is the `user` value of every API call and cannot be changed later.",
          "minLength": 1,
          "title": "Username",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional label shown in the dashboard instead of the username. Can be changed later with PATCH /uploadposts/users/{username}.",
          "title": "Display Name"
        }
      },
      "required": [
        "username"
      ],
      "title": "UploadPostCreateProfileConfig",
      "type": "object"
    },
    "UploadPostEditScheduledPostConfig": {
      "additionalProperties": false,
      "description": "Edit a scheduled post.",
      "properties": {
        "operation": {
          "const": "edit_scheduled_post",
          "default": "edit_scheduled_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "job_id": {
          "description": "The unique job identifier.",
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "scheduled_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "New ISO-8601 date/time in UTC. Must be in the future and within 1 year.",
          "title": "Scheduled Date"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "New post title/caption, applied to every platform of the post.",
          "title": "Title"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "New caption/description, applied to every platform of the post.",
          "title": "Caption"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IANA timezone; when set, scheduled_date is read in it.",
          "title": "Timezone"
        },
        "remove_cover": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Remove the stored cover image.",
          "title": "Remove Cover"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "UploadPostEditScheduledPostConfig",
      "type": "object"
    },
    "UploadPostGetAnalyticsConfig": {
      "additionalProperties": false,
      "description": "Get analytics.",
      "properties": {
        "operation": {
          "const": "get_analytics",
          "default": "get_analytics",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "profile_username": {
          "description": "The unique username of the profile.",
          "minLength": 1,
          "title": "Profile Username",
          "type": "string"
        },
        "platforms": {
          "description": "Comma-separated list of platforms: instagram, tiktok, linkedin, facebook, x, youtube, threads, pinterest, reddit, bluesky.",
          "minLength": 1,
          "title": "Platforms",
          "type": "string"
        },
        "page_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for Facebook analytics. The Facebook Page ID.",
          "title": "Page Id"
        },
        "page_urn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "LinkedIn only. Organization/company page URN or numeric ID to fetch analytics for. LinkedIn analytics are available only for organization/company pages you administer \u2014 personal profiles are not supported, because LinkedIn's API does not expose member-level analytics. If omitted, the first administered organization page is used.",
          "title": "Page Urn"
        }
      },
      "required": [
        "profile_username",
        "platforms"
      ],
      "title": "UploadPostGetAnalyticsConfig",
      "type": "object"
    },
    "UploadPostGetCommentsConfig": {
      "additionalProperties": false,
      "description": "List post comments (multi-platform).",
      "properties": {
        "operation": {
          "const": "get_comments",
          "default": "get_comments",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "platform": {
          "anyOf": [
            {
              "enum": [
                "instagram",
                "facebook",
                "youtube",
                "linkedin",
                "tiktok"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platform to list comments from. Defaults to 'instagram'.",
          "title": "Platform",
          "enum": [
            "instagram",
            "facebook",
            "youtube",
            "linkedin",
            "tiktok"
          ],
          "x-enum-searchable": true
        },
        "user": {
          "description": "Profile username as configured in Upload-Post.",
          "minLength": 1,
          "title": "User",
          "type": "string"
        },
        "post_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Post identifier. YouTube = the video ID; LinkedIn = the post URN (urn:li:ugcPost:...); Instagram = numeric media ID. Use post_id or post_url (one is required).",
          "title": "Post Id"
        },
        "post_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Full post URL. Alternative to post_id.",
          "title": "Post Url"
        },
        "limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum comments to return per page.",
          "title": "Limit"
        },
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pagination cursor returned in `pagination.next_cursor` of the previous response. Pass it back to fetch the next page.",
          "title": "After"
        },
        "comment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TikTok only. Returns the replies hanging off this comment instead of the post's top-level comments - the same question narrowed to a parent, not a separate URL. post_id is still required. TikTok indexes a newly created comment asynchronously: listing within ~10 seconds of writing one returns a list without it.",
          "title": "Comment Id"
        }
      },
      "required": [
        "user"
      ],
      "title": "UploadPostGetCommentsConfig",
      "type": "object"
    },
    "UploadPostGetCurrentUserConfig": {
      "additionalProperties": false,
      "description": "Get current user.",
      "properties": {
        "operation": {
          "const": "get_current_user",
          "default": "get_current_user",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "UploadPostGetCurrentUserConfig",
      "type": "object"
    },
    "UploadPostGetFacebookPagesConfig": {
      "additionalProperties": false,
      "description": "Get Facebook pages.",
      "properties": {
        "operation": {
          "const": "get_facebook_pages",
          "default": "get_facebook_pages",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Profile username. If not specified, returns all pages for your account.",
          "title": "Profile"
        }
      },
      "title": "UploadPostGetFacebookPagesConfig",
      "type": "object"
    },
    "UploadPostGetLinkedinPagesConfig": {
      "additionalProperties": false,
      "description": "Get LinkedIn pages.",
      "properties": {
        "operation": {
          "const": "get_linkedin_pages",
          "default": "get_linkedin_pages",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Profile username. If omitted, returns pages from all connected LinkedIn accounts.",
          "title": "Profile"
        }
      },
      "title": "UploadPostGetLinkedinPagesConfig",
      "type": "object"
    },
    "UploadPostGetMediaConfig": {
      "additionalProperties": false,
      "description": "Get media list.",
      "properties": {
        "operation": {
          "const": "get_media",
          "default": "get_media",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "platform": {
          "description": "The platform to retrieve media from.",
          "enum": [
            "instagram",
            "tiktok",
            "youtube",
            "linkedin",
            "facebook",
            "x",
            "threads",
            "pinterest",
            "bluesky",
            "reddit"
          ],
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "user": {
          "description": "Profile username as configured in Upload-Post.",
          "minLength": 1,
          "title": "User",
          "type": "string"
        },
        "page_urn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "LinkedIn only. Selects which LinkedIn page to fetch posts from. Accepts a numeric organization ID (e.g., 12345), a full URN (e.g., urn:li:organization:12345), or 'me' to force the connected member's personal profile. If omitted, accounts connected as an organization admin auto-resolve to their first administered organization; otherwise the personal profile is used.",
          "title": "Page Urn"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of media items to return. Defaults to 25 and is clamped to 1-100, then capped again by the platform's own maximum page size: Instagram/Facebook/Threads/Bluesky/X/Pinterest/Reddit/LinkedIn 100, YouTube 50, TikTok 20.",
          "title": "Limit"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque next-page token. Pass back exactly the value returned in pagination.next_cursor by the previous response. Not supported on LinkedIn, Discord and Telegram: sending a cursor for those platforms returns 400 with a message naming the platform.",
          "title": "Cursor"
        }
      },
      "required": [
        "platform",
        "user"
      ],
      "title": "UploadPostGetMediaConfig",
      "type": "object"
    },
    "UploadPostGetNextQueueSlotConfig": {
      "additionalProperties": false,
