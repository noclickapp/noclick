    "ApptivegridAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "apptivegrid_api_key",
          "default": "apptivegrid_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_secret": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API secret",
          "type": "string",
          "ui:widget": "password"
        },
        "user_id": {
          "description": "Your account ID from /api/users/me's Location header, for example 64f1a2b3c4d5e6f708091a2b.",
          "title": "User ID",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "api_secret",
        "user_id"
      ],
      "title": "Apptivegrid API Key",
      "type": "object",
      "x-credential-instructions": "In Profile & Settings \u2192 API credentials, create a key. Paste its key and the secret shown once. Use Admin for writes or Read only for reads. Paste your user ID from the Location header of GET /api/users/me with Basic authentication. See https://docs.apptivegrid.de/api/authentifizierung.html.",
      "x-credential-url": "https://app.apptivegrid.de/settings/credentials"
    },
