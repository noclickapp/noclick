    "CreatePost": {
      "additionalProperties": false,
      "description": "Create a new post.",
      "properties": {
        "operation": {
          "const": "create_post",
          "default": "create_post",
          "title": "Create Post",
          "type": "string",
          "ui:hidden": true
        },
        "workspaceId": {
          "minLength": 1,
          "title": "Workspace ID",
          "type": "string"
        },
        "pageId": {
          "minLength": 1,
          "title": "Page ID",
          "type": "string"
        },
        "text": {
          "default": "",
          "description": "Post text. When this contains a URL and media is omitted, Facebook, LinkedIn, and X posts get a link preview card. A failed preview fetch still creates the post without a card.",
          "maxLength": 25000,
          "title": "Text",
          "type": "string"
        },
        "scheduledAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled At"
        },
        "labels": {
          "default": [],
          "description": "Label ids, as returned by `GET /labels`.",
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "media": {
          "default": [],
          "description": "Up to 20 public image or video URLs, each max 100MB. Files are downloaded server-side from the provided URLs.",
          "items": {
            "format": "uri",
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Media",
          "type": "array"
        },
        "teamOnly": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Only"
        },
        "approved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved"
        },
        "publishAtScheduledDate": {
          "default": false,
          "title": "Publish At Scheduled Date",
          "type": "boolean"
        },
        "firstComment": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comment published under the post right after it goes live. Only Facebook, Instagram and LinkedIn posts and reels support it, and the page must allow Planable to publish comments. A post whose page cannot take it is created without it, and its response has no firstComment. Grouped requests are rejected only when none of the target pages can take it.",
          "title": "First Comment"
        },
        "internalNote": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Internal Note"
        },
        "notify": {
          "default": false,
          "description": "Controls whether workspace members receive a post-added notification (email/in-app push). This is not an approval request \u2014 use POST /posts/{id}/request-approval to notify approvers.",
          "title": "Notify",
          "type": "boolean"
        },
        "campaignId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign ID"
        },
        "classification": {
          "default": "post",
          "description": "Post format. `post` (default) creates a regular feed post. `reels` creates a Reel/Short/video on facebook, twitter, instagram, linkedin, youtube, tiktok, threads only \u2014 not on googleMyBusiness, pinterest, universal. Stories stay on POST /stories. Grouped `pageIds` must all support the classification. Reels accept one video file; extra URLs return 400 before create, non-video media return 400 after the post is created. Feed posts use the composer media max per page type; extra URLs return 400. Publishing still applies platform media rules (Reels usually need a video).",
          "enum": [
            "post",
            "reels"
          ],
          "title": "Classification",
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "pageId"
      ],
      "title": "CreatePost",
      "type": "object"
    },
