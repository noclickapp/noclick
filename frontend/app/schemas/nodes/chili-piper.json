    "CancelMeeting": {
      "additionalProperties": false,
      "properties": {
        "meeting_id": {
          "description": "Chili Piper meeting UUID.",
          "format": "uuid",
          "title": "Meeting Id",
          "type": "string"
        },
        "operation": {
          "const": "cancel_meeting",
          "default": "cancel_meeting",
          "description": "Permanently cancels the meeting; may email attendees.",
          "title": "Cancel Meeting",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "meeting_id"
      ],
      "title": "CancelMeeting",
      "type": "object"
    },
    "ChiliPiperAPIKey": {
      "properties": {
        "credential_type": {
          "const": "chili_piper_api_key",
          "default": "chili_piper_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Chili Piper API Key",
      "type": "object",
      "x-credential-instructions": "In Chili Piper Admin Center \u2192 API Keys, create a tenant API key with permissions for the operations you need. Paste only the key. NoClick sends it as Authorization: Bearer to fire.chilipiper.com. Workspace reads prove the connection; individual writes may require additional key permissions.",
      "x-credential-url": "https://fire.chilipiper.com/api/fire-edge/public/org/docs/docs.yaml"
    },
    "CreateMeeting": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_meeting",
          "default": "create_meeting",
          "description": "Books immediately and sends calendar invites. Only personal meeting types owned by this host are supported. An unavailable slot can return Failure without an HTTP error.",
          "title": "Create Meeting",
          "type": "string",
          "ui:hidden": true
        },
        "host_user_id": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "[^\\s\\\\/]+",
          "title": "Host User Id",
          "type": "string"
        },
        "meeting_type_id": {
          "description": "The host's personal meeting type; obtain it with List Personal Meeting Types.",
          "format": "uuid",
          "title": "Meeting Type Id",
          "type": "string"
        },
        "start_time": {
          "description": "ISO-8601 instant in a free slot; duration comes from the meeting type.",
          "title": "Start Time",
          "type": "string"
        },
        "guest_email": {
          "maxLength": 320,
          "minLength": 3,
          "pattern": ".+@.+",
          "title": "Guest Email",
          "type": "string"
        },
        "guest_first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Personal meeting types require this by default.",
          "title": "Guest First Name"
        },
        "guest_last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Personal meeting types require this by default.",
          "title": "Guest Last Name"
        },
        "guest_timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Guest IANA timezone, e.g. America/New_York.",
          "title": "Guest Timezone"
        },
        "guest_crm_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guest Crm Id"
        },
        "meeting_notifications": {
          "anyOf": [
            {
              "enum": [
                "SendNotifications",
                "DoNotSendNotifications"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Controls internal email/Slack notifications only; guest calendar invites are always sent.",
          "title": "Meeting Notifications",
          "enum": [
            "SendNotifications",
            "DoNotSendNotifications"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "host_user_id",
        "meeting_type_id",
        "start_time",
        "guest_email"
      ],
      "title": "CreateMeeting",
      "type": "object"
    },
