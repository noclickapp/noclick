{
  "$defs": {
    "CreateAPIKey": {
      "additionalProperties": false,
      "description": "Create an additional API key; the new secret is returned once. Requires the primary key.",
      "properties": {
        "operation": {
          "const": "create_api_key",
          "default": "create_api_key",
          "title": "Operation",
          "type": "string"
        },
        "label": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
          "title": "Label",
          "type": "string"
        },
        "max_spend_per_hour_cents": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Spend Per Hour Cents"
        },
        "max_spend_total_cents": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Spend Total Cents"
        }
      },
      "required": [
        "label"
      ],
      "title": "CreateAPIKey",
      "type": "object"
    },
    "CreateAuditToken": {
      "additionalProperties": false,
      "description": "Issue a shareable audit token for a transaction you own; requires the primary key.",
      "properties": {
        "operation": {
          "const": "create_audit_token",
          "default": "create_audit_token",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "expires_in_days": {
          "default": 90,
          "maximum": 365,
          "minimum": 1,
          "title": "Expires In Days",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "CreateAuditToken",
      "type": "object"
    },
    "CreateDispute": {
      "additionalProperties": false,
      "description": "Submit a transaction dispute for human review using the primary API key.",
      "properties": {
        "operation": {
          "const": "create_dispute",
          "default": "create_dispute",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "affected_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Field"
        },
        "contact_email": {
          "anyOf": [
            {
              "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact Email"
        }
      },
      "required": [
        "id",
        "reason"
      ],
      "title": "CreateDispute",
      "type": "object"
    },
    "DeleteTransaction": {
      "additionalProperties": false,
      "description": "Redact a transaction using the provider's deletion endpoint.",
      "properties": {
        "operation": {
          "const": "delete_transaction",
          "default": "delete_transaction",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeleteTransaction",
      "type": "object"
    },
    "ExecuteBatch": {
      "additionalProperties": false,
      "description": "Run one capability on up to 100 input objects within a total price limit.",
      "properties": {
        "operation": {
          "const": "execute_batch",
          "default": "execute_batch",
          "title": "Operation",
          "type": "string"
        },
        "capability_slug": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Capability Slug",
          "type": "string"
        },
        "inputs": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "max_total_price_cents": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Total Price Cents",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        }
      },
      "required": [
        "capability_slug",
        "inputs",
        "max_total_price_cents"
      ],
      "title": "ExecuteBatch",
      "type": "object"
    },
    "ExecuteCapability": {
      "additionalProperties": false,
      "description": "Execute a named capability with a maximum EUR-cent price. Poll pending transactions separately.",
      "properties": {
        "operation": {
          "const": "execute_capability",
          "default": "execute_capability",
          "title": "Operation",
          "type": "string"
        },
        "capability_slug": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Capability Slug",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "description": "Input object from the selected capability's input_schema.",
          "title": "Inputs",
          "type": "object"
        },
        "max_price_cents": {
          "maximum": 2000,
          "minimum": 1,
          "title": "Max Price Cents",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 60,
          "minimum": 5,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        }
      },
      "required": [
        "capability_slug",
        "inputs",
        "max_price_cents"
      ],
      "title": "ExecuteCapability",
      "type": "object"
    },
    "ExecuteSolution": {
      "additionalProperties": false,
      "description": "Execute a solution using its documented inputs and a maximum EUR-cent price.",
      "properties": {
        "operation": {
          "const": "execute_solution",
          "default": "execute_solution",
          "title": "Operation",
          "type": "string"
        },
        "slug": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Slug",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "max_price_cents": {
          "minimum": 1,
          "title": "Max Price Cents",
          "type": "integer"
        }
      },
      "required": [
        "slug",
        "inputs",
        "max_price_cents"
      ],
      "title": "ExecuteSolution",
      "type": "object"
    },
    "GetCapability": {
      "additionalProperties": false,
      "description": "Read one capability's inputs, price and limits.",
      "properties": {
        "operation": {
          "const": "get_capability",
          "default": "get_capability",
          "title": "Operation",
          "type": "string"
        },
        "slug": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "slug"
      ],
      "title": "GetCapability",
      "type": "object"
    },
    "GetDispute": {
      "additionalProperties": false,
      "description": "Read a transaction's dispute status.",
      "properties": {
        "operation": {
          "const": "get_dispute",
          "default": "get_dispute",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetDispute",
      "type": "object"
    },
    "GetSolution": {
      "additionalProperties": false,
      "description": "Read one solution and its input schema.",
      "properties": {
        "operation": {
          "const": "get_solution",
          "default": "get_solution",
          "title": "Operation",
          "type": "string"
        },
        "slug": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "slug"
      ],
      "title": "GetSolution",
      "type": "object"
    },
    "GetTransaction": {
      "additionalProperties": false,
      "description": "Read one transaction, including pending async execution status and output.",
      "properties": {
        "operation": {
          "const": "get_transaction",
          "default": "get_transaction",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetTransaction",
      "type": "object"
    },
    "GetWalletBalance": {
      "additionalProperties": false,
      "description": "Read your prepaid wallet's EUR balance.",
      "properties": {
        "operation": {
          "const": "get_wallet_balance",
          "default": "get_wallet_balance",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetWalletBalance",
      "type": "object"
    },
    "ListAPIKeys": {
      "additionalProperties": false,
      "description": "List active additional keys and spending; requires the primary key.",
      "properties": {
        "operation": {
          "const": "list_api_keys",
          "default": "list_api_keys",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListAPIKeys",
      "type": "object"
    },
    "ListCapabilities": {
      "additionalProperties": false,
      "description": "Read the capability catalogue and input schemas.",
      "properties": {
        "operation": {
          "const": "list_capabilities",
          "default": "list_capabilities",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListCapabilities",
      "type": "object"
    },
    "ListSolutions": {
      "additionalProperties": false,
      "description": "Read the solution catalogue, optionally filtered by category.",
      "properties": {
        "operation": {
          "const": "list_solutions",
          "default": "list_solutions",
          "title": "Operation",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        }
      },
      "title": "ListSolutions",
      "type": "object"
    },
    "ListTransactions": {
      "additionalProperties": false,
      "description": "Read capability execution transactions as returned by Strale.",
      "properties": {
        "operation": {
          "const": "list_transactions",
          "default": "list_transactions",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListTransactions",
      "type": "object"
    },
    "ListWalletTransactions": {
      "additionalProperties": false,
      "description": "Read wallet ledger entries as returned by Strale.",
      "properties": {
        "operation": {
          "const": "list_wallet_transactions",
          "default": "list_wallet_transactions",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListWalletTransactions",
      "type": "object"
    },
    "RevokeAPIKey": {
      "additionalProperties": false,
      "description": "Revoke an additional key; requires the primary key, which cannot be revoked here.",
      "properties": {
        "operation": {
          "const": "revoke_api_key",
          "default": "revoke_api_key",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "RevokeAPIKey",
      "type": "object"
    },
    "SearchCatalogue": {
      "additionalProperties": false,
      "description": "Search the capability and solution catalogue with geography and type filters.",
      "properties": {
        "operation": {
          "const": "search_catalogue",
          "default": "search_catalogue",
          "title": "Operation",
          "type": "string"
        },
        "q": {
          "maxLength": 200,
          "minLength": 2,
          "title": "Q",
          "type": "string"
        },
        "limit": {
          "default": 6,
          "maximum": 10,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "geo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geo"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "capability",
                "solution"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type",
          "enum": [
            "capability",
            "solution"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "q"
      ],
      "title": "SearchCatalogue",
      "type": "object"
    },
    "StraleAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "strale_api_key",
          "default": "strale_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Strale API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Strale API key from your account. Use the primary key for API key management, disputes and audit tokens. Executions spend your prepaid EUR balance up to the price limit you supply.",
      "x-credential-url": "https://strale.io/docs"
    },
    "SuggestCapabilities": {
      "additionalProperties": false,
      "description": "Find capabilities using a natural-language task description.",
      "properties": {
        "operation": {
          "const": "suggest_capabilities",
          "default": "suggest_capabilities",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "maxLength": 500,
          "minLength": 2,
          "title": "Query",
          "type": "string"
        },
        "limit": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "SuggestCapabilities",
      "type": "object"
    },
    "UpdateAPIKey": {
      "additionalProperties": false,
      "description": "Update an additional key. Omit caps to retain them; explicitly set null to remove them.",
      "properties": {
        "operation": {
          "const": "update_api_key",
          "default": "update_api_key",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "max_spend_per_hour_cents": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Spend Per Hour Cents"
        },
        "max_spend_total_cents": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Spend Total Cents"
        }
      },
      "required": [
        "id"
      ],
      "title": "UpdateAPIKey",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_api_key": "#/$defs/CreateAPIKey",
          "create_audit_token": "#/$defs/CreateAuditToken",
          "create_dispute": "#/$defs/CreateDispute",
          "delete_transaction": "#/$defs/DeleteTransaction",
          "execute_batch": "#/$defs/ExecuteBatch",
          "execute_capability": "#/$defs/ExecuteCapability",
          "execute_solution": "#/$defs/ExecuteSolution",
          "get_capability": "#/$defs/GetCapability",
          "get_dispute": "#/$defs/GetDispute",
          "get_solution": "#/$defs/GetSolution",
          "get_transaction": "#/$defs/GetTransaction",
          "get_wallet_balance": "#/$defs/GetWalletBalance",
          "list_api_keys": "#/$defs/ListAPIKeys",
          "list_capabilities": "#/$defs/ListCapabilities",
          "list_solutions": "#/$defs/ListSolutions",
          "list_transactions": "#/$defs/ListTransactions",
          "list_wallet_transactions": "#/$defs/ListWalletTransactions",
          "revoke_api_key": "#/$defs/RevokeAPIKey",
          "search_catalogue": "#/$defs/SearchCatalogue",
          "suggest_capabilities": "#/$defs/SuggestCapabilities",
          "update_api_key": "#/$defs/UpdateAPIKey"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ExecuteCapability"
        },
        {
          "$ref": "#/$defs/ExecuteBatch"
        },
        {
          "$ref": "#/$defs/ExecuteSolution"
        },
        {
          "$ref": "#/$defs/ListCapabilities"
        },
        {
          "$ref": "#/$defs/GetCapability"
        },
        {
          "$ref": "#/$defs/ListSolutions"
        },
        {
          "$ref": "#/$defs/GetSolution"
        },
        {
          "$ref": "#/$defs/GetWalletBalance"
        },
        {
          "$ref": "#/$defs/ListWalletTransactions"
        },
        {
          "$ref": "#/$defs/ListTransactions"
        },
        {
          "$ref": "#/$defs/GetTransaction"
        },
        {
          "$ref": "#/$defs/GetDispute"
        },
        {
          "$ref": "#/$defs/CreateDispute"
        },
        {
          "$ref": "#/$defs/CreateAuditToken"
        },
        {
          "$ref": "#/$defs/DeleteTransaction"
        },
        {
          "$ref": "#/$defs/ListAPIKeys"
        },
        {
          "$ref": "#/$defs/CreateAPIKey"
        },
        {
          "$ref": "#/$defs/UpdateAPIKey"
        },
        {
          "$ref": "#/$defs/RevokeAPIKey"
        },
        {
          "$ref": "#/$defs/SuggestCapabilities"
        },
        {
          "$ref": "#/$defs/SearchCatalogue"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/StraleAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Strale Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
