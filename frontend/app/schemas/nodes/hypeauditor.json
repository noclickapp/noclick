{
  "$defs": {
    "HypeAuditorAPIToken": {
      "properties": {
        "credential_type": {
          "const": "hypeauditor_api_token",
          "default": "hypeauditor_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "client_id": {
          "description": "The numeric authorized user / Client ID supplied with your API token.",
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[0-9]+$",
          "title": "Client ID",
          "type": "string"
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "client_id",
        "api_token"
      ],
      "title": "HypeAuditor API Token",
      "type": "object",
      "x-credential-instructions": "Paste the Client ID and API token supplied by HypeAuditor for REST API access. NoClick sends them as X-Auth-Id and X-Auth-Hash. Connecting reads your saved media plans; endpoint availability and credits depend on your plan. Unlocking creator emails spends unlock tokens.",
      "x-credential-url": "https://hypeauditor.com/api-integration/"
    },
    "HypeAuditorAddPlanAccountsConfig": {
      "additionalProperties": false,
      "description": "Adds social network accounts to a specific media plan. Accepts up to 20 accounts per request",
      "properties": {
        "operation": {
          "const": "add_plan_accounts",
          "default": "add_plan_accounts",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "write"
        },
        "planId": {
          "description": "Media plan unique identifier",
          "maxLength": 255,
          "minLength": 1,
          "title": "Planid",
          "type": "string"
        },
        "accounts": {
          "description": "Array of accounts to add",
          "items": {
            "$ref": "#/$defs/HypeAuditorAddPlanAccountsConfigAccountsItem"
          },
          "maxItems": 20,
          "title": "Accounts",
          "type": "array"
        }
      },
      "required": [
        "planId",
        "accounts"
      ],
      "title": "HypeAuditorAddPlanAccountsConfig",
      "type": "object"
    },
    "HypeAuditorAddPlanAccountsConfigAccountsItem": {
      "additionalProperties": false,
      "properties": {
        "social_type": {
          "description": "Social network type",
          "enum": [
            "instagram",
            "youtube",
            "tiktok"
          ],
          "title": "Social Type",
          "type": "string"
        },
        "social_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Social network account ID. At least one of social_id or username must be provided",
          "title": "Social Id"
        },
        "username": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Account username. At least one of social_id or username must be provided",
          "title": "Username"
        }
      },
      "required": [
        "social_type"
      ],
      "title": "HypeAuditorAddPlanAccountsConfigAccountsItem",
      "type": "object"
    },
    "HypeAuditorCheckReportUnlockConfig": {
      "additionalProperties": false,
      "description": "Returns the unlock status for each requested influencer report, identified by social_type and social_id or username.",
      "properties": {
        "operation": {
          "const": "check_report_unlock",
          "default": "check_report_unlock",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "read"
        },
        "reports": {
          "description": "List of influencer accounts to check (1\u2013100 items)",
          "items": {
            "$ref": "#/$defs/HypeAuditorCheckReportUnlockConfigReportsItem"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Reports",
          "type": "array"
        }
      },
      "required": [
        "reports"
      ],
      "title": "HypeAuditorCheckReportUnlockConfig",
      "type": "object"
    },
    "HypeAuditorCheckReportUnlockConfigReportsItem": {
      "additionalProperties": false,
      "properties": {
        "social_type": {
          "description": "Social network type",
          "title": "Social Type",
          "type": "string"
        },
        "social_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unique social network ID of the influencer",
          "title": "Social Id"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Username of the influencer (used if social_id is not provided)",
          "title": "Username"
        }
      },
      "required": [
        "social_type"
      ],
      "title": "HypeAuditorCheckReportUnlockConfigReportsItem",
      "type": "object"
    },
    "HypeAuditorCreateListenerConfig": {
      "additionalProperties": false,
      "description": "Create a new social listening listener to track mentions, hashtags, or keywords across Instagram and TikTok. The listener will continuously monitor the specified value and collect posts from creators who use it.",
      "properties": {
        "operation": {
          "const": "create_listener",
          "default": "create_listener",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "write"
        },
        "value": {
          "description": "The value to monitor. For 'mention' type: username without @. For 'tag' type: hashtag without #. For 'keyword' type: any text string.",
          "maxLength": 255,
          "title": "Value",
          "type": "string"
        },
        "type": {
          "description": "Type of listener value",
          "enum": [
            "mention",
            "tag",
            "keyword"
          ],
          "title": "Type",
          "type": "string"
        },
        "social_types": {
          "description": "Array of social networks to monitor (at least one required)",
          "items": {
            "enum": [
              "instagram",
              "tiktok"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Social Types",
          "type": "array"
        }
      },
      "required": [
        "value",
        "type",
        "social_types"
      ],
      "title": "HypeAuditorCreateListenerConfig",
      "type": "object"
    },
    "HypeAuditorCreateMediaPlanConfig": {
      "additionalProperties": false,
      "description": "Creates a new media plan",
      "properties": {
        "operation": {
          "const": "create_media_plan",
          "default": "create_media_plan",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "write"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Title for the new media plan (max 128 characters)",
          "title": "Title"
        }
      },
      "title": "HypeAuditorCreateMediaPlanConfig",
      "type": "object"
    },
    "HypeAuditorCreatePlanEventConfig": {
      "additionalProperties": false,
      "description": "Creates a new comment event for a specific social network account in a media plan.",
      "properties": {
        "operation": {
          "const": "create_plan_event",
          "default": "create_plan_event",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "write"
        },
        "planId": {
          "description": "Media plan unique identifier",
          "maxLength": 255,
          "minLength": 1,
          "title": "Planid",
          "type": "string"
        },
        "type": {
          "const": "comment",
          "default": "comment",
          "description": "Event type",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "description": "Event content (comment text)",
          "title": "Value",
          "type": "string"
        },
        "social_type": {
          "description": "Social network type",
          "enum": [
            "instagram",
            "youtube",
            "tiktok"
          ],
          "title": "Social Type",
          "type": "string"
        },
        "social_id": {
          "description": "Social network account ID",
          "maxLength": 255,
          "title": "Social Id",
          "type": "string"
        }
      },
      "required": [
        "planId",
        "value",
        "social_type",
        "social_id"
      ],
      "title": "HypeAuditorCreatePlanEventConfig",
      "type": "object"
    },
    "HypeAuditorDeleteMediaPlanConfig": {
      "additionalProperties": false,
      "description": "Deletes a media plan by its identifier",
      "properties": {
        "operation": {
          "const": "delete_media_plan",
          "default": "delete_media_plan",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "write"
        },
        "planId": {
          "description": "Media plan identifier",
          "maxLength": 255,
          "minLength": 1,
          "title": "Planid",
          "type": "string"
        }
      },
      "required": [
        "planId"
      ],
      "title": "HypeAuditorDeleteMediaPlanConfig",
      "type": "object"
    },
    "HypeAuditorDeletePlanAccountsConfig": {
      "additionalProperties": false,
      "description": "Deletes accounts from a specific media plan. Accepts up to 20 accounts per request. Accounts that are not found in the plan will be listed in the skipped array.",
      "properties": {
        "operation": {
          "const": "delete_plan_accounts",
          "default": "delete_plan_accounts",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "write"
        },
        "planId": {
          "description": "Media plan unique identifier",
          "maxLength": 255,
          "minLength": 1,
          "title": "Planid",
          "type": "string"
        },
        "accounts": {
          "description": "Array of accounts to delete",
          "items": {
            "$ref": "#/$defs/HypeAuditorDeletePlanAccountsConfigAccountsItem"
          },
          "maxItems": 20,
          "title": "Accounts",
          "type": "array"
        }
      },
      "required": [
        "planId",
        "accounts"
      ],
      "title": "HypeAuditorDeletePlanAccountsConfig",
      "type": "object"
    },
    "HypeAuditorDeletePlanAccountsConfigAccountsItem": {
      "additionalProperties": false,
      "properties": {
        "social_type": {
          "description": "Social network type",
          "enum": [
            "instagram",
            "youtube",
            "tiktok"
          ],
          "title": "Social Type",
          "type": "string"
        },
        "social_id": {
          "description": "Social network account ID",
          "maxLength": 128,
          "title": "Social Id",
          "type": "string"
        }
      },
      "required": [
        "social_type",
        "social_id"
      ],
      "title": "HypeAuditorDeletePlanAccountsConfigAccountsItem",
      "type": "object"
    },
    "HypeAuditorDeletePlanEventConfig": {
      "additionalProperties": false,
      "description": "Deletes a specific event from a media plan.",
      "properties": {
        "operation": {
          "const": "delete_plan_event",
          "default": "delete_plan_event",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "write"
        },
        "planId": {
          "description": "Media plan unique identifier",
          "maxLength": 255,
          "minLength": 1,
          "title": "Planid",
          "type": "string"
        },
        "eventId": {
          "description": "Event unique identifier (UUID)",
          "maxLength": 255,
          "minLength": 1,
          "title": "Eventid",
          "type": "string"
        }
      },
      "required": [
        "planId",
        "eventId"
      ],
      "title": "HypeAuditorDeletePlanEventConfig",
      "type": "object"
    },
    "HypeAuditorGetCreatorMentionsConfig": {
      "additionalProperties": false,
      "description": "Retrieve all posts (mentions) from a specific creator discovered through social listening. Returns posts where the creator mentioned tracked usernames, hashtags, or keywords across Instagram and TikTok. Results can be optionally filtered by a specific listener.",
      "properties": {
        "operation": {
          "const": "get_creator_mentions",
          "default": "get_creator_mentions",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "read"
        },
        "creator_id": {
          "description": "Creator unique identifier from the social listening creators list",
          "title": "Creator Id",
          "type": "integer"
        },
        "listener_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter posts by specific listener ID. If not provided, returns all posts from all listeners for this creator.",
          "title": "Listener Id"
        }
      },
      "required": [
        "creator_id"
      ],
      "title": "HypeAuditorGetCreatorMentionsConfig",
      "type": "object"
    },
    "HypeAuditorGetLookalikesConfig": {
      "additionalProperties": false,
      "description": "Find similar creators accounts based on provided usernames or social IDs. Results are returned synchronously.",
      "properties": {
        "operation": {
          "const": "get_lookalikes",
          "default": "get_lookalikes",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "read"
        },
        "social_type": {
          "description": "Social network type",
          "enum": [
            "instagram",
            "youtube",
            "tiktok"
          ],
          "title": "Social Type",
          "type": "string"
        },
        "usernames": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Array of usernames (required for Instagram and TikTok). Not used for YouTube.",
          "title": "Usernames"
        },
        "social_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Array of social network IDs (required for YouTube, e.g., channel IDs). Not used for Instagram/TikTok.",
          "title": "Social Ids"
        },
        "page": {
          "default": 1,
          "description": "Page number for pagination",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "description": "Number of items per page",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "social_type"
      ],
      "title": "HypeAuditorGetLookalikesConfig",
      "type": "object"
    },
    "HypeAuditorGetMediaPlanConfig": {
      "additionalProperties": false,
      "description": "Returns a single media plan with full details including configuration and creators states count",
      "properties": {
        "operation": {
          "const": "get_media_plan",
          "default": "get_media_plan",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "read"
        },
        "planId": {
          "description": "Media plan unique identifier",
          "maxLength": 255,
          "minLength": 1,
          "title": "Planid",
          "type": "string"
        }
      },
      "required": [
        "planId"
      ],
      "title": "HypeAuditorGetMediaPlanConfig",
      "type": "object"
    },
    "HypeAuditorGetMediaPlanMetricsConfig": {
      "additionalProperties": false,
      "description": "Returns aggregated metrics for a media plan including overall metrics and metrics broken down by social network (Instagram, YouTube, TikTok)",
      "properties": {
        "operation": {
          "const": "get_media_plan_metrics",
          "default": "get_media_plan_metrics",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "read"
        },
        "planId": {
          "description": "Media plan unique identifier",
          "maxLength": 255,
          "minLength": 1,
          "title": "Planid",
          "type": "string"
        }
      },
      "required": [
        "planId"
      ],
      "title": "HypeAuditorGetMediaPlanMetricsConfig",
      "type": "object"
    },
    "HypeAuditorListCreatorsConfig": {
      "additionalProperties": false,
      "description": "Retrieve a paginated list of creators discovered through social listening. Returns creators who have mentioned tracked usernames, hashtags, or keywords across Instagram and TikTok. Results can be filtered by specific listener and sorted by discovery date.",
      "properties": {
        "operation": {
          "const": "list_creators",
          "default": "list_creators",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "read"
        },
        "page": {
          "default": 1,
          "description": "Page number for pagination",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "description": "Number of items per page",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "sort_order": {
          "default": "desc",
          "description": "Sort order by discovery date (asc - oldest first, desc - newest first)",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Sort Order",
          "type": "string"
        },
        "listener_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter creators by specific listener ID. If not provided, returns creators from all listeners.",
          "title": "Listener Id"
        },
        "with_disabled_listeners": {
          "default": false,
          "description": "Include creators from disabled listeners in results",
          "title": "With Disabled Listeners",
          "type": "boolean"
        }
      },
      "title": "HypeAuditorListCreatorsConfig",
      "type": "object"
    },
    "HypeAuditorListListenersConfig": {
      "additionalProperties": false,
      "description": "Retrieve a paginated list of all social listening listeners. Returns listeners with their current status, creator counts, and monitoring information.",
      "properties": {
        "operation": {
          "const": "list_listeners",
          "default": "list_listeners",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "read"
        },
        "page": {
          "default": 1,
          "description": "Page number for pagination",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 5,
          "description": "Number of items per page (maximum 10)",
          "maximum": 10,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "HypeAuditorListListenersConfig",
      "type": "object"
    },
    "HypeAuditorListMediaPlansConfig": {
      "additionalProperties": false,
      "description": "Returns a paginated list of media plans",
      "properties": {
        "operation": {
          "const": "list_media_plans",
          "default": "list_media_plans",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "read"
        },
        "page": {
          "default": 1,
          "description": "Page number",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 10,
          "description": "Number of items per page",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "order_by": {
          "anyOf": [
            {
              "enum": [
                "events",
                "created_at"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sort order for the results",
          "title": "Order By",
          "enum": [
            "events",
            "created_at"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "HypeAuditorListMediaPlansConfig",
      "type": "object"
    },
    "HypeAuditorListPlanAccountsConfig": {
      "additionalProperties": false,
      "description": "Returns a paginated list of creators\u2019 social network accounts for a specific media plan",
      "properties": {
        "operation": {
          "const": "list_plan_accounts",
          "default": "list_plan_accounts",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "read"
        },
        "planId": {
          "description": "Media plan unique identifier",
          "maxLength": 255,
          "minLength": 1,
          "title": "Planid",
          "type": "string"
        },
        "page": {
          "default": 1,
          "description": "Page number",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 10,
          "description": "Number of items per page",
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "social_type": {
          "anyOf": [
            {
              "enum": [
                "instagram",
                "youtube",
                "tiktok"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by social network type",
          "title": "Social Type",
          "enum": [
            "instagram",
            "youtube",
            "tiktok"
          ],
          "x-enum-searchable": true
        },
        "social_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by social network account ID",
          "title": "Social Id"
        }
      },
      "required": [
        "planId"
      ],
      "title": "HypeAuditorListPlanAccountsConfig",
      "type": "object"
    },
    "HypeAuditorListPlanCreatorsConfig": {
      "additionalProperties": false,
      "description": "Returns a paginated list of creators for a specific media plan, including their social network accounts in a compact format. Each creator may be associated with multiple social network accounts.",
      "properties": {
        "operation": {
          "const": "list_plan_creators",
          "default": "list_plan_creators",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "read"
        },
        "planId": {
          "description": "Media plan unique identifier",
          "maxLength": 255,
          "minLength": 1,
          "title": "Planid",
          "type": "string"
        },
        "page": {
          "default": 1,
          "description": "Page number",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 10,
          "description": "Number of items per page",
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "in_review",
                "accepted",
                "rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by creator state",
          "title": "State",
          "enum": [
            "in_review",
            "accepted",
            "rejected"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "planId"
      ],
      "title": "HypeAuditorListPlanCreatorsConfig",
      "type": "object"
    },
    "HypeAuditorListPlanEventsConfig": {
      "additionalProperties": false,
      "description": "Retrieves a paginated list of events for a specific social network account in a media plan.",
      "properties": {
        "operation": {
          "const": "list_plan_events",
          "default": "list_plan_events",
          "title": "Operation",
          "type": "string",
          "x-operation-kind": "read"
        },
        "planId": {
          "description": "Media plan unique identifier",
          "maxLength": 255,
          "minLength": 1,
          "title": "Planid",
          "type": "string"
        },
        "social_type": {
          "description": "Social network type",
          "enum": [
            "instagram",
            "youtube",
            "tiktok"
          ],
