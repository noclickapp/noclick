{
  "$defs": {
    "AddAllowanceTransactionConfig": {
      "additionalProperties": false,
      "description": "adds new allowance transaction to kidUserID.",
      "properties": {
        "operation": {
          "const": "add_allowance_transaction",
          "default": "add_allowance_transaction",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "kidUserId": {
          "description": "userID of the kid",
          "title": "Kid User ID",
          "type": "integer"
        },
        "amount": {
          "description": "amount you wish to Add/Subtract (subtract value should be a negative value)",
          "title": "Amount",
          "type": "number"
        },
        "description": {
          "description": "Description (reason) of allowance transaction",
          "maxLength": 10000,
          "title": "Description",
          "type": "string"
        },
        "transactionType": {
          "description": "Transaction Type (Add/Subtract)",
          "enum": [
            "Add",
            "Subtract"
          ],
          "title": "Transaction Type",
          "type": "string"
        }
      },
      "required": [
        "kidUserId",
        "amount",
        "description",
        "transactionType"
      ],
      "title": "AddAllowanceTransactionConfig",
      "type": "object"
    },
    "CreateChildUserConfig": {
      "additionalProperties": false,
      "description": "adds new child user.",
      "properties": {
