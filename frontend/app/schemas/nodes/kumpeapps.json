              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Authentication scope for link",
          "title": "Scope4",
          "enum": [
            "WishList",
            "WishListAdmin",
            "Chores",
            "ChoresAdmin"
