        "email": {
          "description": "email address of user to create",
          "maxLength": 10000,
          "title": "Email",
          "type": "string"
        },
        "firstName": {
          "description": "First Name of user to create",
          "maxLength": 10000,
          "title": "First Name",
          "type": "string"
        },
        "lastName": {
