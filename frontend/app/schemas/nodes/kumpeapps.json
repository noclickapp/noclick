    "CreateChoreConfig": {
      "additionalProperties": false,
      "description": "adds chore for given user.",
      "properties": {
        "operation": {
          "const": "create_chore",
          "default": "create_chore",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "kidUsername": {
          "description": "username of kid to assign the chore to.",
          "maxLength": 10000,
          "title": "Kid Username",
          "type": "string"
        },
        "day": {
          "anyOf": [
            {
              "enum": [
                "Sunday",
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday",
                "Weekly",
                "Today"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "day of week (Monday, Tuesday....) for the chore. For weekly chores put Weekly or leave blank",
          "title": "Day",
          "enum": [
            "Sunday",
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Weekly",
            "Today"
          ],
          "x-enum-searchable": true
        },
        "nfcTag": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "text field of nfc tag required to check off chore",
          "title": "NFC Tag"
        },
        "status": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "status of chore (default is todo)",
          "title": "Status"
        },
        "choreName": {
          "description": "name of chore",
          "maxLength": 10000,
          "title": "Chore Name",
          "type": "string"
        },
        "choreDescription": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "optional chore description",
          "title": "Chore Description"
        },
        "choreNumber": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "number priority of chore (default is 5)",
          "title": "Chore Number"
        },
        "blockDash": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "block dash option on this chore",
          "title": "Block Dash"
        },
        "oneTime": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "mark as one time chore (does not repeat each week)",
          "title": "One Time"
        },
        "extraAllowance": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ammount of allowance added at end of week for completing this chore",
          "title": "Extra Allowance"
        },
        "optional": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "mark as optional chore",
          "title": "Optional"
        },
        "reassignable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "mark as reassignable (default is true)",
          "title": "Reassignable"
        },
        "canSteal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "mark as sibling can steal chore",
          "title": "Can Steal"
        },
        "startDate": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "date (yyyy-mm-dd) that you wish the chore to start showing up. (default is today)",
          "title": "Start Date"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "notes added to chore (visable only on reports, kids do not see this note, this is mostly just for the developer)",
          "title": "Notes"
        },
        "requireObjectDetection": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "require use of camera to detect object detection tag order to check off chore",
          "title": "Require Object Detection"
        },
        "objectDetectionTag": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tag for object detection to search for (required if requireObjectDetection is true)",
          "title": "Object Detection Tag"
        },
        "updatedByAutomation": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "true if chore updated via API from an Automation System",
          "title": "Updated By Automation"
        },
        "aiIcon": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Notes if AI Icons should be used (n for no, y for yes, e for yes- error)",
          "title": "AI icon"
        },
        "isCalendar": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True if this is a calendar note instead of a chore.",
          "title": "Is Calendar"
        }
      },
      "required": [
        "kidUsername",
        "choreName"
      ],
      "title": "CreateChoreConfig",
      "type": "object"
    },
    "CreateShareLinkConfig": {
