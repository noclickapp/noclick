    "MemberspotSetCourseStartDateConfig": {
      "additionalProperties": false,
      "description": "Sets the start date of a course access for a user",
      "properties": {
        "operation": {
          "const": "set_course_start_date",
          "default": "set_course_start_date",
          "title": "Operation",
