        "courseId": {
          "description": "The id of the course",
          "maxLength": 512,
          "minLength": 1,
          "title": "Courseid",
          "type": "string"
        },
        "startDate": {
          "description": "New start date of the course access in ISO 8601 format: a date (2026-01-15) or a date with time and offset (2026-01-15T00:00:00.000Z, 2026-01-15T08:00:00+01:00). A time without offset is rejected. Drip content unlocks relative to this date.",
          "format": "date-time",
          "maxLength": 512,
          "minLength": 1,
          "title": "Startdate",
          "type": "string"
        },
        "deleteDueMessages": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "description": "Whether drip messages that become due through the new start date are deleted instead of sent right away. Defaults to true.",
          "title": "Deleteduemessages"
