{
  "$defs": {
    "CharlaAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "charla_api_key",
          "default": "charla_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Charla API Key",
      "type": "object",
      "x-credential-instructions": "In Charla, open your property settings and copy the API key from the Integration tab. Paste the key here. Each property has its own key; NoClick sends it in the X-Api-Key header.",
      "x-credential-url": "https://app.charla.com/swagger/index.html"
    },
    "CharlaArticleCategory": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Existing category ID from List Categories.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "CharlaArticleCategory",
      "type": "object"
    },
    "CharlaCheckConnectionConfig": {
      "additionalProperties": false,
      "description": "Read the first page of this property's contacts to verify the key.",
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "CharlaCheckConnectionConfig",
      "type": "object"
    },
    "CharlaCustomAttribute": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        }
      },
      "title": "CharlaCustomAttribute",
      "type": "object"
    },
    "CharlaDeleteArticleConfig": {
      "additionalProperties": false,
      "description": "Permanently delete a knowledge base article by ID.",
      "properties": {
        "operation": {
          "const": "delete_article",
          "default": "delete_article",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Article ID",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "CharlaDeleteArticleConfig",
      "type": "object"
    },
    "CharlaGetArticleConfig": {
      "additionalProperties": false,
      "description": "Read a knowledge base article.",
      "properties": {
        "operation": {
          "const": "get_article",
          "default": "get_article",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Article ID",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "CharlaGetArticleConfig",
      "type": "object"
    },
    "CharlaGetContactConfig": {
      "additionalProperties": false,
      "description": "Read a contact by its UUID.",
      "properties": {
        "operation": {
          "const": "get_contact",
          "default": "get_contact",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Contact ID",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "CharlaGetContactConfig",
      "type": "object"
    },
    "CharlaListArticlesConfig": {
      "additionalProperties": false,
      "description": "Read one page of articles, newest creation first (25 per page).",
      "properties": {
        "operation": {
          "const": "list_articles",
          "default": "list_articles",
          "title": "Operation",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque next_cursor returned by the previous articles page.",
          "title": "Cursor"
        }
      },
      "title": "CharlaListArticlesConfig",
      "type": "object"
    },
    "CharlaListCategoriesConfig": {
      "additionalProperties": false,
      "description": "Read all knowledge base categories for this property.",
      "properties": {
        "operation": {
          "const": "list_categories",
          "default": "list_categories",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "CharlaListCategoriesConfig",
      "type": "object"
    },
    "CharlaListContactsConfig": {
      "additionalProperties": false,
      "description": "Read one page of contacts, newest modifications first (25 per page).",
      "properties": {
        "operation": {
          "const": "list_contacts",
          "default": "list_contacts",
          "title": "Operation",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Integer next_cursor from the previous contacts page. Omit for the first page.",
          "title": "Cursor"
        }
      },
      "title": "CharlaListContactsConfig",
      "type": "object"
    },
    "CharlaListConversationsConfig": {
      "additionalProperties": false,
      "description": "Read conversations grouped per visitor, newest message first (25 per page).",
      "properties": {
        "operation": {
          "const": "list_conversations",
          "default": "list_conversations",
          "title": "Operation",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Integer next_cursor from the previous conversations page.",
          "title": "Cursor"
        }
      },
      "title": "CharlaListConversationsConfig",
      "type": "object"
    },
    "CharlaSaveArticleConfig": {
      "additionalProperties": false,
      "description": "Save or update an article; chatbot training follows your Charla AI settings.",
      "properties": {
        "operation": {
          "const": "save_article",
          "default": "save_article",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "default": 0,
          "description": "0 creates an article; use an existing ID to update.",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "slug": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slug"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "article": {
          "description": "Article HTML content.",
          "title": "Article",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "html"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/CharlaArticleCategory"
          },
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "status": {
          "default": "Draft",
          "enum": [
            "Draft",
            "Published"
          ],
          "title": "Status",
          "type": "string"
        },
        "visibility": {
          "default": "Private",
          "enum": [
            "Private",
            "Public"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "title",
        "article",
        "categories"
      ],
      "title": "CharlaSaveArticleConfig",
      "type": "object"
    },
    "CharlaSaveContactConfig": {
      "additionalProperties": false,
      "description": "Save or update a contact. Omitted fields are not sent.",
      "properties": {
        "operation": {
          "const": "save_contact",
          "default": "save_contact",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing contact UUID when updating.",
          "title": "Contact ID"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "country_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Country code in ISO 3166-1.",
          "title": "Country Code"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ip"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "browser_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Browser Language"
        },
        "tags": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated tags already added to your organization.",
          "title": "Tags"
        },
        "custom_attributes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CharlaCustomAttribute"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Attributes"
        }
      },
      "title": "CharlaSaveContactConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/CharlaCheckConnectionConfig",
          "delete_article": "#/$defs/CharlaDeleteArticleConfig",
          "get_article": "#/$defs/CharlaGetArticleConfig",
          "get_contact": "#/$defs/CharlaGetContactConfig",
          "list_articles": "#/$defs/CharlaListArticlesConfig",
          "list_categories": "#/$defs/CharlaListCategoriesConfig",
          "list_contacts": "#/$defs/CharlaListContactsConfig",
          "list_conversations": "#/$defs/CharlaListConversationsConfig",
          "save_article": "#/$defs/CharlaSaveArticleConfig",
          "save_contact": "#/$defs/CharlaSaveContactConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CharlaCheckConnectionConfig"
        },
        {
          "$ref": "#/$defs/CharlaListContactsConfig"
        },
        {
          "$ref": "#/$defs/CharlaGetContactConfig"
        },
        {
          "$ref": "#/$defs/CharlaSaveContactConfig"
        },
        {
          "$ref": "#/$defs/CharlaListConversationsConfig"
        },
        {
          "$ref": "#/$defs/CharlaGetArticleConfig"
        },
        {
          "$ref": "#/$defs/CharlaListArticlesConfig"
        },
        {
          "$ref": "#/$defs/CharlaSaveArticleConfig"
        },
        {
          "$ref": "#/$defs/CharlaDeleteArticleConfig"
        },
        {
          "$ref": "#/$defs/CharlaListCategoriesConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/CharlaAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Charla Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
