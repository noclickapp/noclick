    "NationBuilderAddListSignupsConfig": {
      "description": "Start an asynchronous addition to a custom list; no message is sent here.",
      "properties": {
        "list_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "List Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "list_id",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "signup_ids": {
          "description": "Up to 100 unique signup IDs per node request (provider supports 10,000). Returns async acceptance, not completion.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Signup Ids",
          "type": "array"
        },
        "operation": {
          "const": "add_list_signups",
          "default": "add_list_signups",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "list_id",
        "signup_ids"
      ],
      "title": "NationBuilderAddListSignupsConfig",
      "type": "object"
    },
