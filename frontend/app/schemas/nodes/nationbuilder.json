    "NationBuilderV2TokenCredential": {
      "description": "An existing v2 JWT; NoClick does not register or impersonate an OAuth app.",
      "properties": {
        "credential_type": {
          "const": "nationbuilder_v2_token",
          "default": "nationbuilder_v2_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "nation_slug": {
          "description": "Only the nation subdomain, such as acme, from acme.nationbuilder.com. Custom domains and arbitrary URLs are not supported.",
          "maxLength": 63,
          "minLength": 1,
          "title": "Nation slug",
          "type": "string"
        },
        "access_token": {
          "description": "Paste an existing v2 JWT, without Bearer. V1 tokens do not work. V2 tokens expire after 24 hours; replace an expired token. This connection does not mint or refresh tokens.",
          "maxLength": 16384,
          "minLength": 1,
          "title": "V2 access token",
          "type": "string",
          "ui:widget": "password"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional actual expiry supplied with your token, in ISO 8601 with timezone. It is not inferred from an unverified JWT.",
          "title": "Known token expiry"
        }
      },
      "required": [
        "nation_slug",
        "access_token"
      ],
      "title": "NationBuilder V2 Token",
      "type": "object",
      "x-credential-url": "https://nationbuilder.com/api/v2/reference"
    }
  },
  "properties": {
