{
  "$defs": {
    "Amount": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "description": "ISO 4217 currency code, e.g. EUR.",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "value": {
          "description": "Exact decimal string in this currency, e.g. 10.00. Do not use floating point numbers.",
          "pattern": "^\\d+(?:\\.\\d+)?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "value"
      ],
      "title": "Amount",
      "type": "object"
    },
    "CancelPayment": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[\\x21-\\x7e]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reuse this key when retrying the same request. NoClick does not retry writes automatically.",
          "title": "Idempotency Key"
        },
        "operation": {
          "const": "cancel_payment",
          "default": "cancel_payment",
          "description": "Mollie only permits cancellation for supported payment methods and states.",
          "title": "Cancel Payment",
          "type": "string"
        },
        "payment_id": {
          "pattern": "^tr_[A-Za-z0-9]+$",
          "title": "Payment Id",
          "type": "string"
        }
      },
      "required": [
        "payment_id"
      ],
      "title": "CancelPayment",
      "type": "object"
    },
