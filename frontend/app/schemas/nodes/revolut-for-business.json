          "type": "string"
        }
      },
      "required": [
        "profile_type",
        "name",
        "revtag"
      ],
      "title": "CreateCounterparty",
      "type": "object"
    },
    "CreatePayment": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_payment",
          "default": "create_payment",
