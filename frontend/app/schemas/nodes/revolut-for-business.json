          "$ref": "#/$defs/Receiver"
        },
        "amount": {
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "maxLength": 140,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "charge_bearer": {
          "anyOf": [
            {
              "enum": [
                "shared",
                "debtor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Charge Bearer",
          "enum": [
            "shared",
            "debtor"
          ],
          "x-enum-searchable": true
        },
        "transfer_reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transfer Reason Code"
        },
        "exchange_reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Reason Code"
        },
        "fiscal_code": {
          "anyOf": [
            {
              "maxLength": 50,
              "pattern": "^[a-zA-Z0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fiscal Code"
        },
        "name_validation_id": {
          "anyOf": [
            {
              "format": "uuid",
