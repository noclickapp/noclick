          "const": "create_credential_template",
          "default": "create_credential_template",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "vc_type": {
          "description": "SD-JWT VC type, for example UniversityCard. Sent as type.",
          "minLength": 1,
          "title": "Vc Type",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": true,
          "description": "Paradym attribute definitions keyed by claim name. Each definition declares type, name and optional required/alwaysDisclosed; supports nested attributes.",
          "title": "Attributes",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "revocable": {
          "default": false,
          "title": "Revocable",
          "type": "boolean"
        }
      },
      "required": [
        "wallet_id",
        "name",
        "vc_type",
        "attributes"
      ],
      "title": "CreateCredentialTemplate",
      "type": "object"
    },
    "CreateIssuanceOffer": {
