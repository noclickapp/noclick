{
  "$defs": {
    "CreateOffer": {
      "properties": {
        "shop_sku": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "Shop Sku",
          "type": "string"
        },
        "state_code": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "State Code",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "state_code",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "price": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Price",
          "type": "number"
        },
        "quantity": {
          "description": "Available stock; zero is not a documented draft state.",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "internal_description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Internal Description"
        },
        "product_tax_code": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^,|/\\\\?#\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Tax Code"
        },
        "operation": {
          "const": "create_offer",
          "default": "create_offer",
          "title": "Operation",
          "type": "string"
        },
        "product_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "Product Id",
          "type": "string"
        },
        "product_id_type": {
          "description": "Operator product reference type such as EAN or UPC. SKU and SHOP_SKU are unsupported by this node's P31 parent check.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "Product Id Type",
          "type": "string"
        }
      },
      "required": [
        "shop_sku",
        "state_code",
        "price",
        "quantity",
        "product_id",
        "product_id_type"
      ],
      "title": "CreateOffer",
      "type": "object"
    },
    "DeleteOffer": {
      "properties": {
        "operation": {
          "const": "delete_offer",
          "default": "delete_offer",
          "title": "Operation",
          "type": "string"
        },
        "offer_id": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Offer Id",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "offer_id",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "shop_sku": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "Shop Sku",
          "type": "string"
        }
      },
      "required": [
        "offer_id",
        "shop_sku"
      ],
      "title": "DeleteOffer",
      "type": "object"
    },
    "GetAccessScope": {
      "properties": {
        "operation": {
          "const": "get_access_scope",
          "default": "get_access_scope",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetAccessScope",
      "type": "object"
    },
    "GetOffer": {
      "properties": {
        "operation": {
          "const": "get_offer",
          "default": "get_offer",
          "title": "Operation",
          "type": "string"
        },
        "offer_id": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Offer Id",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "offer_id",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "product_sku": {
          "description": "Existing product SKU used to verify the selected offer belongs to the bound shop.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "Product Sku",
          "type": "string"
        }
      },
      "required": [
        "offer_id",
        "product_sku"
      ],
      "title": "GetOffer",
      "type": "object"
    },
    "GetOfferImport": {
      "properties": {
        "operation": {
          "const": "get_offer_import",
          "default": "get_offer_import",
          "title": "Operation",
          "type": "string"
        },
        "import_id": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Import Id",
          "type": "integer"
        }
      },
      "required": [
        "import_id"
      ],
      "title": "GetOfferImport",
      "type": "object"
    },
    "GetProducts": {
      "properties": {
        "operation": {
          "const": "get_products",
          "default": "get_products",
          "title": "Operation",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/ProductReference"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "references"
      ],
      "title": "GetProducts",
      "type": "object"
    },
    "GetShop": {
      "properties": {
        "operation": {
          "const": "get_shop",
          "default": "get_shop",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetShop",
      "type": "object"
    },
    "GetValuesList": {
      "properties": {
        "operation": {
          "const": "get_values_list",
          "default": "get_values_list",
          "title": "Operation",
          "type": "string"
        },
        "code": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "GetValuesList",
      "type": "object"
    },
    "ListCategories": {
      "properties": {
        "operation": {
          "const": "list_categories",
          "default": "list_categories",
          "title": "Operation",
          "type": "string"
        },
        "hierarchy": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^,|/\\\\?#\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing parent category code; empty retrieves the root.",
          "title": "Hierarchy"
        },
        "max_level": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Level",
          "type": "integer"
        }
      },
      "title": "ListCategories",
      "type": "object"
    },
    "ListChannels": {
      "properties": {
        "operation": {
          "const": "list_channels",
          "default": "list_channels",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListChannels",
      "type": "object"
    },
    "ListCurrencies": {
      "properties": {
        "operation": {
          "const": "list_currencies",
          "default": "list_currencies",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListCurrencies",
      "type": "object"
    },
    "ListLocales": {
      "properties": {
        "operation": {
          "const": "list_locales",
          "default": "list_locales",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListLocales",
      "type": "object"
    },
    "ListOfferStates": {
      "properties": {
        "operation": {
          "const": "list_offer_states",
          "default": "list_offer_states",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListOfferStates",
      "type": "object"
    },
    "ListOrders": {
      "properties": {
        "limit": {
          "default": 50,
          "description": "One bounded Mirakl max page.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_orders",
          "default": "list_orders",
          "title": "Operation",
          "type": "string"
        },
        "order_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^,|/\\\\?#\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Id"
        }
      },
      "title": "ListOrders",
      "type": "object"
    },
    "ListProductAttributes": {
      "properties": {
        "operation": {
          "const": "list_product_attributes",
          "default": "list_product_attributes",
          "title": "Operation",
          "type": "string"
        },
        "hierarchy": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "Hierarchy",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "hierarchy",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "max_level": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Level",
          "type": "integer"
        }
      },
      "required": [
        "hierarchy"
      ],
      "title": "ListProductAttributes",
      "type": "object"
    },
    "ListShopOffers": {
      "properties": {
        "limit": {
          "default": 50,
          "description": "One bounded Mirakl max page.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_shop_offers",
          "default": "list_shop_offers",
          "title": "Operation",
          "type": "string"
        },
        "sku": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^,|/\\\\?#\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku"
        }
      },
      "title": "ListShopOffers",
      "type": "object"
    },
    "MiraklMASCredential": {
      "properties": {
        "credential_type": {
          "const": "mirakl_mas_token",
          "default": "mirakl_mas_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "description": "Already issued Mirakl Authentication System OAuth2 access token. Bearer header only; legacy API keys and Connect tokens are not supported.",
          "maxLength": 16384,
          "minLength": 1,
          "title": "MAS Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "marketplace_url": {
          "description": "Exact public HTTPS origin from the MAS token response; not the Connect or auth service.",
          "title": "Marketplace URL",
          "type": "string"
        },
        "marketplace_id": {
          "description": "Tenant ID from the same MAS token response. This supplied value is a binding, not an independently proved account identity.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "Marketplace ID",
          "type": "string"
        },
        "role": {
          "description": "Role of the granted Platform resource. Seller operations use the token's single selected shop.",
          "enum": [
            "seller",
            "operator"
          ],
          "title": "Role",
          "type": "string"
        },
        "shop_id": {
          "description": "Seller: exact shop_id from MAS. Operator: one existing shop to restrict order and product-offer reads.",
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Bound Shop ID",
          "type": "integer"
        },
        "expires_at": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional actual expiry from the issued grant. No TTL is guessed; expired supplied tokens must be replaced. This node does not mint or refresh grants.",
          "title": "Expiry (Unix Seconds)"
        }
      },
      "required": [
        "access_token",
        "marketplace_url",
        "marketplace_id",
        "role",
        "shop_id"
      ],
      "title": "Mirakl Platform",
      "type": "object",
      "x-credential-type": "api_key",
      "x-credential-url": "https://developer.mirakl.com/"
    },
    "ProductReference": {
      "properties": {
        "type": {
          "description": "Operator reference type such as EAN or UPC. SKU and SHOP_SKU are invalid for P31.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "ProductReference",
      "type": "object"
    },
    "ReplaceOffer": {
      "properties": {
        "shop_sku": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "Shop Sku",
          "type": "string"
        },
        "state_code": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^,|/\\\\?#\\s]+$",
          "title": "State Code",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "state_code",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "price": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Price",
          "type": "number"
        },
        "quantity": {
          "description": "Available stock; zero is not a documented draft state.",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "internal_description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Internal Description"
        },
        "product_tax_code": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^,|/\\\\?#\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Tax Code"
        },
        "operation": {
          "const": "replace_offer",
          "default": "replace_offer",
          "title": "Operation",
          "type": "string"
        },
        "offer_id": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Offer Id",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "offer_id",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "acknowledge_field_resets": {
          "const": true,
          "description": "Full OF24 replacement resets omitted prices, discounts, availability, custom fields and other options. This is not a partial metadata patch.",
          "title": "Acknowledge Field Resets",
          "type": "boolean"
        }
      },
      "required": [
        "shop_sku",
        "state_code",
        "price",
        "quantity",
        "offer_id",
        "acknowledge_field_resets"
      ],
      "title": "ReplaceOffer",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "discriminator": {
        "mapping": {
          "create_offer": "#/$defs/CreateOffer",
          "delete_offer": "#/$defs/DeleteOffer",
          "get_access_scope": "#/$defs/GetAccessScope",
          "get_offer": "#/$defs/GetOffer",
          "get_offer_import": "#/$defs/GetOfferImport",
          "get_products": "#/$defs/GetProducts",
          "get_shop": "#/$defs/GetShop",
          "get_values_list": "#/$defs/GetValuesList",
          "list_categories": "#/$defs/ListCategories",
          "list_channels": "#/$defs/ListChannels",
          "list_currencies": "#/$defs/ListCurrencies",
          "list_locales": "#/$defs/ListLocales",
          "list_offer_states": "#/$defs/ListOfferStates",
          "list_orders": "#/$defs/ListOrders",
          "list_product_attributes": "#/$defs/ListProductAttributes",
          "list_shop_offers": "#/$defs/ListShopOffers",
          "replace_offer": "#/$defs/ReplaceOffer"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetAccessScope"
        },
        {
          "$ref": "#/$defs/GetShop"
        },
        {
          "$ref": "#/$defs/ListCategories"
        },
        {
          "$ref": "#/$defs/ListProductAttributes"
        },
        {
          "$ref": "#/$defs/ListChannels"
        },
        {
          "$ref": "#/$defs/ListCurrencies"
        },
        {
          "$ref": "#/$defs/ListLocales"
        },
        {
          "$ref": "#/$defs/ListOfferStates"
        },
        {
          "$ref": "#/$defs/GetValuesList"
        },
        {
          "$ref": "#/$defs/GetProducts"
        },
        {
          "$ref": "#/$defs/ListShopOffers"
        },
        {
          "$ref": "#/$defs/GetOffer"
        },
        {
          "$ref": "#/$defs/ListOrders"
        },
        {
          "$ref": "#/$defs/CreateOffer"
        },
        {
          "$ref": "#/$defs/ReplaceOffer"
        },
        {
          "$ref": "#/$defs/DeleteOffer"
        },
        {
          "$ref": "#/$defs/GetOfferImport"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MiraklMASCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "config"
  ],
  "title": "Mirakl Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
