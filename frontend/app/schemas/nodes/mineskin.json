{
  "$defs": {
    "GenerateRequest": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PNG image URL or base64 data URL. MineSkin fetches it; NoClick does not download it.",
          "title": "Url"
        },
        "user": {
          "anyOf": [
            {
              "maxLength": 36,
              "minLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minecraft player UUID. Supply either URL or player UUID.",
          "title": "User"
        },
        "variant": {
          "anyOf": [
            {
              "enum": [
                "classic",
                "slim",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant",
          "enum": [
            "classic",
            "slim",
            "unknown"
          ],
          "x-enum-searchable": true
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 48,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "visibility": {
          "anyOf": [
            {
              "enum": [
                "public",
                "unlisted",
                "private"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MineSkin defaults to public. Private skins require the corresponding grant.",
          "title": "Visibility",
          "enum": [
            "public",
            "unlisted",
            "private"
          ],
          "x-enum-searchable": true
        },
        "cape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cape UUID; availability depends on account grants and ownership.",
          "title": "Cape"
        }
      },
      "title": "GenerateRequest",
      "type": "object"
    },
    "GenerateSkin": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PNG image URL or base64 data URL. MineSkin fetches it; NoClick does not download it.",
          "title": "Url"
        },
        "user": {
          "anyOf": [
            {
              "maxLength": 36,
              "minLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minecraft player UUID. Supply either URL or player UUID.",
          "title": "User"
        },
        "variant": {
          "anyOf": [
            {
              "enum": [
                "classic",
                "slim",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant",
          "enum": [
            "classic",
            "slim",
            "unknown"
          ],
          "x-enum-searchable": true
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 48,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "visibility": {
          "anyOf": [
            {
              "enum": [
                "public",
                "unlisted",
                "private"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MineSkin defaults to public. Private skins require the corresponding grant.",
          "title": "Visibility",
          "enum": [
            "public",
            "unlisted",
            "private"
          ],
          "x-enum-searchable": true
        },
        "cape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cape UUID; availability depends on account grants and ownership.",
          "title": "Cape"
        },
        "operation": {
          "const": "generate_skin",
          "default": "generate_skin",
          "description": "Wait for skin generation. Queue Skin is recommended for asynchronous workflows.",
          "title": "Generate Skin",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GenerateSkin",
      "type": "object"
    },
    "GetAPIKey": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_api_key",
          "default": "get_api_key",
          "title": "Get API Key Details",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetAPIKey",
      "type": "object"
    },
    "GetClient": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_client",
          "default": "get_client",
          "title": "Get Current Client",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetClient",
      "type": "object"
    },
    "GetJob": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_job",
          "default": "get_job",
          "title": "Get Job Status",
          "type": "string",
          "ui:hidden": true
        },
        "job_id": {
          "description": "Job ID returned by submission. Check at most once per second. Job IDs need not be UUIDs.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetJob",
      "type": "object"
    },
    "GetSkin": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_skin",
          "default": "get_skin",
          "title": "Get Skin",
          "type": "string",
          "ui:hidden": true
        },
        "uuid": {
          "description": "Skin UUID, with or without hyphens.",
          "title": "Uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid"
      ],
      "title": "GetSkin",
      "type": "object"
    },
    "GetUser": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_user",
          "default": "get_user",
          "title": "Get Current User",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetUser",
      "type": "object"
    },
    "ListCapes": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_capes",
          "default": "list_capes",
          "title": "List Known Capes",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListCapes",
      "type": "object"
    },
    "ListJobs": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_jobs",
          "default": "list_jobs",
          "title": "List Recent Queue Jobs",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListJobs",
      "type": "object"
    },
    "ListSkins": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_skins",
          "default": "list_skins",
          "title": "List Skins",
          "type": "string",
          "ui:hidden": true
        },
        "after": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference of the last skin on the previous page. Returns one page and provider pagination links.",
          "title": "After"
        }
      },
      "title": "ListSkins",
      "type": "object"
    },
    "ListUserCapes": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_user_capes",
          "default": "list_user_capes",
          "title": "List My Capes",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListUserCapes",
      "type": "object"
    },
    "MineSkinAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "mineskin_api_key",
          "default": "mineskin_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "MineSkin API Key",
      "type": "object",
      "x-credential-instructions": "Paste your MineSkin API key without the Bearer prefix. NoClick checks the user associated with this key. Generation may consume your MineSkin allowance; batch generation requires the Pro+ batch_generation grant.",
      "x-credential-url": "https://account.mineskin.org/keys"
    },
    "QueueBatch": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "queue_batch",
          "default": "queue_batch",
          "title": "Queue Batch Generation",
          "type": "string",
          "ui:hidden": true
        },
        "batch": {
          "description": "One to 24 URL or player requests; each result can fail independently. Counts against your rate allowance.",
          "items": {
            "$ref": "#/$defs/GenerateRequest"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Batch",
          "type": "array"
        }
      },
      "required": [
        "batch"
      ],
      "title": "QueueBatch",
      "type": "object",
      "x-requires-tier": "batch_generation",
      "x-tier-label": "Pro+"
    },
    "QueueSkin": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PNG image URL or base64 data URL. MineSkin fetches it; NoClick does not download it.",
          "title": "Url"
        },
        "user": {
          "anyOf": [
            {
              "maxLength": 36,
              "minLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minecraft player UUID. Supply either URL or player UUID.",
          "title": "User"
        },
        "variant": {
          "anyOf": [
            {
              "enum": [
                "classic",
                "slim",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant",
          "enum": [
            "classic",
            "slim",
            "unknown"
          ],
          "x-enum-searchable": true
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 48,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "visibility": {
          "anyOf": [
            {
              "enum": [
                "public",
                "unlisted",
                "private"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MineSkin defaults to public. Private skins require the corresponding grant.",
          "title": "Visibility",
          "enum": [
            "public",
            "unlisted",
            "private"
          ],
          "x-enum-searchable": true
        },
        "cape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cape UUID; availability depends on account grants and ownership.",
          "title": "Cape"
        },
        "operation": {
          "const": "queue_skin",
          "default": "queue_skin",
          "title": "Queue Skin Generation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "QueueSkin",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "generate_skin": "#/$defs/GenerateSkin",
          "get_api_key": "#/$defs/GetAPIKey",
          "get_client": "#/$defs/GetClient",
          "get_job": "#/$defs/GetJob",
          "get_skin": "#/$defs/GetSkin",
          "get_user": "#/$defs/GetUser",
          "list_capes": "#/$defs/ListCapes",
          "list_jobs": "#/$defs/ListJobs",
          "list_skins": "#/$defs/ListSkins",
          "list_user_capes": "#/$defs/ListUserCapes",
          "queue_batch": "#/$defs/QueueBatch",
          "queue_skin": "#/$defs/QueueSkin"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GenerateSkin"
        },
        {
          "$ref": "#/$defs/QueueSkin"
        },
        {
          "$ref": "#/$defs/QueueBatch"
        },
        {
          "$ref": "#/$defs/ListJobs"
        },
        {
          "$ref": "#/$defs/GetJob"
        },
        {
          "$ref": "#/$defs/GetSkin"
        },
        {
          "$ref": "#/$defs/ListSkins"
        },
        {
          "$ref": "#/$defs/ListCapes"
        },
        {
          "$ref": "#/$defs/GetUser"
        },
        {
          "$ref": "#/$defs/ListUserCapes"
        },
        {
          "$ref": "#/$defs/GetAPIKey"
        },
        {
          "$ref": "#/$defs/GetClient"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MineSkinAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Mineskin Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
