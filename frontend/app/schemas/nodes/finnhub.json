{
  "$defs": {
    "FinnhubAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "finnhub_api_key",
          "default": "finnhub_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Finnhub API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Finnhub API key from the dashboard. Your subscription determines available endpoints. NoClick sends it as the token query parameter to finnhub.io. Connecting checks public market news access, not account identity or premium permissions.",
      "x-credential-url": "https://finnhub.io/dashboard"
    },
    "FinnhubAiChatConfig": {
      "additionalProperties": false,
      "description": "AI Copilot.",
      "properties": {
        "operation": {
          "const": "ai_chat",
          "default": "ai_chat",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/FinnhubChatMessage"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        }
      },
      "required": [
        "messages"
      ],
      "title": "FinnhubAiChatConfig",
      "type": "object"
    },
