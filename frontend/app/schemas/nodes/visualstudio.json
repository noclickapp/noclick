        {
          "$ref": "#/$defs/VisualstudioGetEnvironmentConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioCreateEnvironmentConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioUpdateEnvironmentConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioDeleteEnvironmentConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioStartEnvironmentConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioShutdownEnvironmentConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioArchiveEnvironmentConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioGetEnvironmentArchiveConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioExportEnvironmentConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioRestoreEnvironmentConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioUpdateRecentFoldersConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioGetEnvironmentStateConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioGetBillingConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioListLocationsConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioGetLocationConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioGetAgentConfig"
        },
        {
          "$ref": "#/$defs/VisualstudioGetPortInfoConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisualstudioTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
