            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The issuer-claimed expiration date. Omit it or set it to null to derive the credential template's expiration period at issuance; it stays null when no period is configured (YYYY-MM-DD).",
          "title": "Expirydate"
        },
        "customAttributes": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The key-value object of your custom attributes where key is your attribute's tag and value is just your value",
          "title": "Customattributes"
        }
      },
      "required": [
        "groupId",
        "recipient"
      ],
      "title": "CreateIssueSendCredentialConfig",
      "type": "object"
    },
    "CreateIssueSendCredentialConfigRecipient": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "The name of the credential's recipient",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The email of the credential's recipient",
          "title": "Email"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateIssueSendCredentialConfigRecipient",
      "type": "object"
    },
    "DeleteCredentialConfig": {
      "additionalProperties": false,
      "description": "Delete a credential",
      "properties": {
        "operation": {
          "const": "delete_credential",
          "default": "delete_credential",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "The unique ID of the credential",
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeleteCredentialConfig",
      "type": "object"
    },
