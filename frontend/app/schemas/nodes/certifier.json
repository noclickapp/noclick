{
  "$defs": {
    "CertifierMcpCredential": {
      "description": "Certifier connected through Certifier's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "certifier_mcp",
          "default": "certifier_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "Certifier MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://api.certifier.io/v1/mcp",
      "x-mcp-transport": "shttp"
    },
    "CertifierTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "certifier_api_token",
          "default": "certifier_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Certifier API Token",
      "type": "object",
      "x-credential-instructions": "Create an access token in Certifier Dashboard settings and paste it here. NoClick sends it as a bearer token to api.certifier.io. Template reads verify access; issuing and sending credentials require the corresponding account permissions.",
      "x-credential-url": "https://app.certifier.io/settings/access-tokens"
    },
    "CreateCredentialConfig": {
      "additionalProperties": false,
      "description": "Create a credential",
      "properties": {
        "operation": {
          "const": "create_credential",
          "default": "create_credential",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "groupId": {
          "description": "The group's (credential template's) ID you want to issue the credential to. Check the Group (Credential Template) object.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Groupid",
          "type": "string"
        },
        "recipient": {
          "$ref": "#/$defs/CreateCredentialConfigRecipient",
          "description": "The recipient of the credential"
        },
        "issueDate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The issuer-claimed issue date. Omit it or set it to null to resolve it to the UTC date at issuance (YYYY-MM-DD).",
          "title": "Issuedate"
        },
        "expiryDate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The issuer-claimed expiration date. Omit it or set it to null to derive the credential template's expiration period at issuance; it stays null when no period is configured (YYYY-MM-DD).",
          "title": "Expirydate"
        },
        "customAttributes": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The key-value object of your custom attributes, where key is your attribute's tag and value is the text value you want to store",
          "title": "Customattributes"
        }
      },
      "required": [
        "groupId",
        "recipient"
      ],
      "title": "CreateCredentialConfig",
      "type": "object"
    },
    "CreateCredentialConfigRecipient": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "The name of the credential's recipient",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The email of the credential's recipient",
          "title": "Email"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateCredentialConfigRecipient",
      "type": "object"
    },
    "CreateCredentialInteractionConfig": {
      "additionalProperties": false,
      "description": "Create a credential interaction",
      "properties": {
        "operation": {
          "const": "create_credential_interaction",
          "default": "create_credential_interaction",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "credentialId": {
          "description": "The unique credential's identifier, to which this credential interaction belongs",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Credentialid",
          "type": "string"
        },
        "eventType": {
          "description": "Specifies the type of user interaction event related to the credential",
          "enum": [
            "credential_viewed",
            "credential_shared_to_linkedin",
            "credential_added_to_linkedin_profile",
            "credential_shared_to_facebook",
            "credential_shared_to_twitter",
            "credential_shared_to_messenger",
            "credential_shared_to_whatsapp",
            "credential_shared_to_pinterest",
            "credential_shared_to_telegram",
            "credential_shared_to_weibo",
            "credential_downloaded",
            "credential_link_copied",
            "credential_verified"
          ],
          "maxLength": 8192,
          "minLength": 1,
          "title": "Eventtype",
          "type": "string"
        },
        "triggeredBy": {
          "description": "The actor that triggered this credential interaction. Currently one of two values: recipient or guest",
          "enum": [
            "recipient",
            "guest"
          ],
          "maxLength": 8192,
          "minLength": 1,
          "title": "Triggeredby",
          "type": "string"
        },
        "triggeredAt": {
          "description": "The date and time when this credential interaction happened. Formatted as an ISO 8601 date and time string",
          "format": "date-time",
          "title": "Triggeredat",
          "type": "string"
        }
      },
      "required": [
        "credentialId",
        "eventType",
        "triggeredBy",
        "triggeredAt"
      ],
      "title": "CreateCredentialInteractionConfig",
      "type": "object"
    },
    "CreateGroupConfig": {
      "additionalProperties": false,
      "description": "Create a credential template",
      "properties": {
        "operation": {
          "const": "create_group",
          "default": "create_group",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "description": "The name of the credential template (group) that is used as [group.name] attribute later on",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "designIds": {
          "description": "The ordered list of design template IDs associated with the credential template..",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Designids",
          "type": "array"
        },
        "learningEventUrl": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The learning event's URL that is shown in the digital wallet",
          "title": "Learningeventurl"
        }
      },
      "required": [
        "name",
        "designIds"
      ],
      "title": "CreateGroupConfig",
      "type": "object"
    },
    "CreateIssueSendCredentialConfig": {
      "additionalProperties": false,
