        }
      },
      "required": [
        "customer"
      ],
      "title": "VoucherifyCreateCustomerConfig",
      "type": "object"
    },
    "VoucherifyCreateProductConfig": {
      "description": "Create catalog metadata without setting a price or image URL.",
      "properties": {
        "operation": {
          "const": "create_product",
          "default": "create_product",
