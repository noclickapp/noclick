{
  "$defs": {
    "VoucherifyApplicationKeysCredential": {
      "description": "Existing server Application keys for one shared-cluster project.",
      "properties": {
        "credential_type": {
          "const": "voucherify_application_keys",
          "default": "voucherify_application_keys",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "region": {
          "default": "eu",
          "description": "Europe, US, or Singapore shared cluster. Dedicated custom clusters are not supported.",
          "enum": [
            "eu",
            "us",
            "asia"
          ],
          "title": "Project region",
          "type": "string"
        },
        "application_id": {
          "description": "Existing server Application ID. Client-side and management keys are separate families.",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Application ID",
          "type": "string",
          "ui:widget": "password"
        },
        "application_secret": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Application secret",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "application_id",
        "application_secret"
      ],
      "title": "Voucherify Application Keys",
      "type": "object",
      "x-credential-url": "https://docs.voucherify.io/guides/authentication"
    },
    "VoucherifyCreateCustomerConfig": {
      "description": "Create or match customer metadata; may trigger project automation.",
      "properties": {
        "operation": {
          "const": "create_customer",
          "default": "create_customer",
          "title": "Operation",
          "type": "string"
        },
        "customer": {
