          "minProperties": 1,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "campaign_id",
        "metadata"
      ],
      "title": "VoucherifyUpdateCampaignMetadataConfig",
      "type": "object"
    },
    "VoucherifyUpdateCustomerConfig": {
      "description": "Update selected customer metadata; may trigger project automation.",
      "properties": {
        "operation": {
          "const": "update_customer",
          "default": "update_customer",
          "title": "Operation",
          "type": "string"
        },
        "customer_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Customer Id",
          "type": "string"
        },
        "customer": {
          "$ref": "#/$defs/VoucherifyCustomerChanges"
        }
      },
      "required": [
        "customer_id",
        "customer"
      ],
      "title": "VoucherifyUpdateCustomerConfig",
      "type": "object"
    },
    "VoucherifyUpdateProductConfig": {
      "description": "Update a product's name, attribute names or metadata.",
      "properties": {
        "operation": {
          "const": "update_product",
          "default": "update_product",
          "title": "Operation",
          "type": "string"
        },
        "product_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "product": {
          "$ref": "#/$defs/VoucherifyProductChanges"
        }
      },
      "required": [
        "product_id",
        "product"
      ],
      "title": "VoucherifyUpdateProductConfig",
      "type": "object"
    },
    "VoucherifyUpdateSKUConfig": {
      "description": "Update a verified product-scoped SKU's ordinary metadata.",
      "properties": {
        "operation": {
          "const": "update_sku",
          "default": "update_sku",
          "title": "Operation",
          "type": "string"
        },
        "product_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "sku_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Sku Id",
          "type": "string"
        },
        "sku": {
          "$ref": "#/$defs/VoucherifySKUChanges"
        }
      },
      "required": [
        "product_id",
        "sku_id",
        "sku"
      ],
      "title": "VoucherifyUpdateSKUConfig",
      "type": "object"
    },
    "VoucherifyUpdateVoucherMetadataConfig": {
      "description": "Update a verified voucher's custom metadata without changing discount or balance.",
      "properties": {
        "operation": {
          "const": "update_voucher_metadata",
          "default": "update_voucher_metadata",
          "title": "Operation",
          "type": "string"
        },
        "campaign_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Campaign Id",
          "type": "string"
        },
        "voucher_code": {
          "description": "Existing voucher code; a URL or path is not accepted.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Voucher Code",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              }
            ]
          },
          "maxProperties": 50,
          "minProperties": 1,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "campaign_id",
        "voucher_code",
        "metadata"
      ],
      "title": "VoucherifyUpdateVoucherMetadataConfig",
      "type": "object"
    },
    "VoucherifyValidateDiscountsConfig": {
      "description": "Validate existing discount coupons/tiers without redemption or a session lock. Records history and uses API quota.",
      "properties": {
        "operation": {
          "const": "validate_discounts",
          "default": "validate_discounts",
          "title": "Operation",
          "type": "string"
        },
        "redeemables": {
          "items": {
            "$ref": "#/$defs/VoucherifyValidationRedeemable"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Redeemables",
          "type": "array"
        },
        "customer_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Id"
        },
        "order_amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Order amount in the smallest currency unit, used only for validation calculation.",
          "title": "Order Amount"
        }
      },
      "required": [
        "redeemables"
      ],
      "title": "VoucherifyValidateDiscountsConfig",
      "type": "object"
    },
    "VoucherifyValidationRedeemable": {
      "additionalProperties": false,
      "properties": {
        "object": {
          "enum": [
            "voucher",
            "promotion_tier"
          ],
          "title": "Object",
          "type": "string"
        },
        "id": {
          "description": "Voucher code or promotion-tier ID, as selected above.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "campaign_id": {
          "description": "Existing campaign association verified before validation.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Campaign Id",
          "type": "string"
        }
      },
      "required": [
        "object",
        "id",
        "campaign_id"
      ],
      "title": "VoucherifyValidationRedeemable",
      "type": "object"
    }
  },
