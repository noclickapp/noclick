              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Includedirectorycontent"
        }
      },
      "required": [
        "resource_id"
      ],
      "title": "StartonGetPinConfig",
      "type": "object"
    },
