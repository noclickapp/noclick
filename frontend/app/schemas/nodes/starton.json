{
  "$defs": {
    "StartonAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "starton_api_key",
          "default": "starton_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Starton API Key",
      "type": "object",
      "x-credential-instructions": "Create an API key in your Starton project's developer settings and paste it here. The key can access your project; choose a project with the wallets and contracts your workflow needs.",
      "x-credential-url": "https://app.starton.com/projects/default/developer"
    },
    "StartonCallSmartContractConfig": {
      "additionalProperties": false,
      "description": "Execute Smart Contract Function",
      "properties": {
        "operation": {
          "const": "call_smart_contract",
          "default": "call_smart_contract",
          "title": "Call Smart Contract",
          "type": "string",
          "ui:hidden": true
        },
        "network": {
          "description": "EVM starton supported network.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Network",
          "type": "string"
        },
        "address": {
          "description": "Smart contract address.",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Address",
          "type": "string"
        },
        "simulate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Boolean for transaction simulation. Will estimate gas price.",
          "title": "Simulate"
        },
        "functionName": {
          "maxLength": 8192,
          "title": "Functionname",
          "type": "string"
        },
        "params": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "object"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "array"
          },
          "description": "Smart-contract arguments as a JSON array, in ABI order.",
          "title": "Params",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "speed": {
          "anyOf": [
            {
              "enum": [
                "low",
                "average",
                "fast",
                "fastest"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed",
          "enum": [
            "low",
            "average",
            "fast",
            "fastest"
          ],
          "x-enum-searchable": true
        },
        "gasLimit": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gaslimit"
        },
        "signerWallet": {
          "description": "Existing Starton signerWallet.",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Signerwallet",
          "type": "string"
        },
        "nonce": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nonce"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "network",
        "address",
        "functionName",
        "params",
        "signerWallet"
      ],
      "title": "StartonCallSmartContractConfig",
      "type": "object"
    },
    "StartonCreateTransactionConfig": {
      "additionalProperties": false,
      "description": "Create a new transaction",
      "properties": {
        "operation": {
          "const": "create_transaction",
          "default": "create_transaction",
          "title": "Create Transaction",
          "type": "string",
          "ui:hidden": true
        },
        "simulate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Boolean for transaction simulation. Will estimate gas price.",
          "title": "Simulate"
        },
        "data": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Transaction data.",
          "title": "Data"
        },
        "gasLimit": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gaslimit"
        },
        "speed": {
          "anyOf": [
            {
              "enum": [
                "low",
                "average",
                "fast",
                "fastest"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gas speed. Starton defaults to average.",
          "title": "Speed",
          "enum": [
            "low",
            "average",
            "fast",
            "fastest"
          ],
          "x-enum-searchable": true
        },
        "metadata": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "contentMediaType": "application/json",
          "contentSchema": {
            "type": "object"
          },
          "default": null,
          "title": "Metadata",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "network": {
          "description": "Your network you want to perform transaction.",
          "maxLength": 8192,
          "title": "Network",
          "type": "string"
        },
        "nonce": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Your transaction nonce. Don't fill this value if you want to use relayer nonce auto assignation.",
          "title": "Nonce"
        },
        "signerWallet": {
          "description": "Your kms address. It's also the from of your transaction.",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Signerwallet",
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The address you want to send to.",
          "title": "To"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The value of the transaction in wei.",
          "title": "Value"
        }
      },
      "required": [
        "network",
        "signerWallet"
      ],
      "title": "StartonCreateTransactionConfig",
      "type": "object"
    },
    "StartonCreateWalletConfig": {
      "additionalProperties": false,
      "description": "Create a new wallet",
      "properties": {
        "operation": {
          "const": "create_wallet",
          "default": "create_wallet",
          "title": "Create Wallet",
          "type": "string",
          "ui:hidden": true
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "metadata": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "contentMediaType": "application/json",
          "contentSchema": {
            "type": "object"
          },
          "default": null,
          "title": "Metadata",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "kmsId": {
          "maxLength": 8192,
          "title": "Kmsid",
          "type": "string"
        }
      },
      "required": [
        "kmsId"
      ],
      "title": "StartonCreateWalletConfig",
      "type": "object"
    },
    "StartonDeletePinConfig": {
      "additionalProperties": false,
      "description": "Deletes pinned file referenced by {id}",
      "properties": {
        "operation": {
          "const": "delete_pin",
          "default": "delete_pin",
          "title": "Delete Pin",
          "type": "string",
          "ui:hidden": true
        },
        "resource_id": {
          "description": "The unique identifier of the pinned file on Starton",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "resource_id"
      ],
      "title": "StartonDeletePinConfig",
      "type": "object"
    },
    "StartonDeployFromTemplateConfig": {
      "additionalProperties": false,
      "description": "Deploy Smart Contract from Template",
      "properties": {
        "operation": {
          "const": "deploy_from_template",
          "default": "deploy_from_template",
          "title": "Deploy From Template",
          "type": "string",
          "ui:hidden": true
        },
        "simulate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Boolean for transaction simulation. Will estimate gas price.",
          "title": "Simulate"
        },
        "network": {
          "description": "Network of the smart contract you want to deploy.",
          "maxLength": 8192,
          "title": "Network",
          "type": "string"
        },
        "signerWallet": {
          "description": "Signer wallet of the transaction.",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Signerwallet",
          "type": "string"
        },
        "templateId": {
          "description": "Starton Library template to deploy.",
          "maxLength": 8192,
          "title": "Templateid",
          "type": "string"
        },
        "name": {
          "description": "Contract name on Starton database (off-chain).",
          "maxLength": 255,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contract description on Starton database (off-chain).",
          "title": "Description"
        },
        "params": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "object"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "array"
          },
          "description": "Smart-contract arguments as a JSON array, in ABI order.",
          "title": "Params",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "gasLimit": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional gas limit",
          "title": "Gaslimit"
        },
        "speed": {
          "anyOf": [
            {
              "enum": [
                "low",
                "average",
                "fast",
                "fastest"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gas speed. Starton defaults to average.",
          "title": "Speed",
          "enum": [
            "low",
            "average",
            "fast",
            "fastest"
          ],
          "x-enum-searchable": true
        },
        "nonce": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nonce manual setting, if nonce referenced, Starton relayer will not automaticly assign nonce.",
          "title": "Nonce"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If you want to put value in your smart contract deployment (Example: payable constructor)",
          "title": "Value"
        },
        "metadata": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "contentMediaType": "application/json",
          "contentSchema": {
            "type": "object"
          },
          "default": null,
          "title": "Metadata",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "network",
        "signerWallet",
        "templateId",
        "name",
        "params"
      ],
      "title": "StartonDeployFromTemplateConfig",
      "type": "object"
    },
    "StartonGetGasPriceConfig": {
