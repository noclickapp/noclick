{
  "$defs": {
    "AddSubscribersToList": {
      "additionalProperties": false,
      "description": "Add up to 500 emails to a list, retaining per-email processing outcomes.",
      "properties": {
        "operation": {
          "const": "add_subscribers_to_list",
          "default": "add_subscribers_to_list",
          "title": "Operation",
          "type": "string"
        },
        "list_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "List Id",
          "type": "string"
        },
        "emails": {
          "items": {
            "format": "email",
            "maxLength": 320,
            "minLength": 3,
            "pattern": "^[^\\s/@?#%]+@[^\\s/@?#%]+\\.[^\\s/@?#%]+$",
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Emails",
          "type": "array"
        },
        "duplicate_strategy": {
          "default": "skip",
          "enum": [
            "skip",
            "merge",
            "overwrite"
          ],
          "title": "Duplicate Strategy",
          "type": "string"
        },
        "opt_in_mode": {
          "default": "default",
          "enum": [
            "default",
            "confirmed",
            "double_opt_in"
          ],
          "title": "Opt In Mode",
          "type": "string"
        },
        "enroll_in_sequences": {
          "default": false,
          "title": "Enroll In Sequences",
          "type": "boolean"
        }
      },
      "required": [
        "list_id",
        "emails"
      ],
      "title": "AddSubscribersToList",
      "type": "object"
    },
