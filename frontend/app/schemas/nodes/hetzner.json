            "nbg1"
          ],
          "title": "Location"
        },
        "ssh_keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing SSH key names or IDs as strings. Without SSH keys Hetzner returns a root password.",
