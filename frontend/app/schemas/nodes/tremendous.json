{
  "$defs": {
    "ApproveOrderConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "approve_order",
          "default": "approve_order",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "order_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Order Id",
          "type": "string"
        }
      },
      "required": [
        "order_id"
      ],
      "title": "ApproveOrderConfig",
      "type": "object"
    },
    "CreateInvoiceConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_invoice",
          "default": "create_invoice",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "amount": {
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "po_number": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Po Number"
        },
        "orders": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orders"
        }
      },
      "required": [
        "amount"
      ],
      "title": "CreateInvoiceConfig",
      "type": "object"
    },
    "CreateOrderConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_order",
          "default": "create_order",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "external_id": {
          "description": "Stable unique reference for idempotence. Reuse this value when resolving an uncertain result; never create a new reference to retry.",
          "maxLength": 256,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "payment": {
          "$ref": "#/$defs/Payment"
        },
        "reward": {
          "$ref": "#/$defs/Reward"
        }
      },
      "required": [
        "external_id",
        "payment",
        "reward"
      ],
      "title": "CreateOrderConfig",
      "type": "object"
    },
    "CustomField": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "value": {
          "maxLength": 10000,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "id",
        "value"
      ],
      "title": "CustomField",
      "type": "object"
    },
    "DeleteInvoiceConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "delete_invoice",
          "default": "delete_invoice",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "invoice_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Invoice Id",
          "type": "string"
        }
      },
      "required": [
        "invoice_id"
      ],
      "title": "DeleteInvoiceConfig",
      "type": "object"
    },
    "Delivery": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "default": "EMAIL",
          "enum": [
            "EMAIL",
            "PHONE",
            "LINK"
          ],
          "title": "Method",
          "type": "string"
        }
      },
      "title": "Delivery",
      "type": "object"
    },
    "GenerateRewardLinkConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "generate_reward_link",
          "default": "generate_reward_link",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "reward_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Reward Id",
          "type": "string"
        }
      },
      "required": [
        "reward_id"
      ],
      "title": "GenerateRewardLinkConfig",
      "type": "object"
    },
    "GetCampaignConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_campaign",
          "default": "get_campaign",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "campaign_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Campaign Id",
          "type": "string"
        }
      },
      "required": [
        "campaign_id"
      ],
      "title": "GetCampaignConfig",
      "type": "object"
    },
    "GetFundingSourceConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_funding_source",
          "default": "get_funding_source",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "funding_source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Funding Source Id",
          "type": "string"
        }
      },
      "required": [
        "funding_source_id"
      ],
      "title": "GetFundingSourceConfig",
      "type": "object"
    },
    "GetInvoiceConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_invoice",
          "default": "get_invoice",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "invoice_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Invoice Id",
          "type": "string"
        }
      },
      "required": [
        "invoice_id"
      ],
      "title": "GetInvoiceConfig",
      "type": "object"
    },
    "GetOrderConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_order",
          "default": "get_order",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "order_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Order Id",
          "type": "string"
        }
      },
      "required": [
        "order_id"
      ],
      "title": "GetOrderConfig",
      "type": "object"
    },
    "GetOrganizationConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_organization",
          "default": "get_organization",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "organization_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Organization Id",
          "type": "string"
        }
      },
      "required": [
        "organization_id"
      ],
      "title": "GetOrganizationConfig",
      "type": "object"
    },
    "GetProductConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_product",
          "default": "get_product",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "product_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Product Id",
          "type": "string"
        }
      },
      "required": [
        "product_id"
      ],
      "title": "GetProductConfig",
      "type": "object"
    },
    "GetRewardConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_reward",
          "default": "get_reward",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "reward_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Reward Id",
          "type": "string"
        }
      },
      "required": [
        "reward_id"
      ],
      "title": "GetRewardConfig",
      "type": "object"
    },
    "ListCampaignsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_campaigns",
          "default": "list_campaigns",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListCampaignsConfig",
      "type": "object"
    },
    "ListFieldsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_fields",
          "default": "list_fields",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListFieldsConfig",
      "type": "object"
    },
    "ListFundingSourcesConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_funding_sources",
          "default": "list_funding_sources",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListFundingSourcesConfig",
      "type": "object"
    },
    "ListInvoicesConfig": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "default": 0,
          "description": "Return one page starting at this offset. Advance by the number of rows returned.",
          "maximum": 10000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 10,
          "maximum": 10,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "operation": {
          "const": "list_invoices",
          "default": "list_invoices",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListInvoicesConfig",
      "type": "object"
    },
    "ListOrdersConfig": {
      "additionalProperties": false,
      "description": "Return the first order page; this collection publishes no enabled order-list filters.",
      "properties": {
        "operation": {
          "const": "list_orders",
          "default": "list_orders",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListOrdersConfig",
      "type": "object"
    },
    "ListOrganizationsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_organizations",
          "default": "list_organizations",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListOrganizationsConfig",
      "type": "object"
    },
    "ListProductsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_products",
          "default": "list_products",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated alpha-2 country codes",
          "title": "Country"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated currency codes",
          "title": "Currency"
        }
      },
      "title": "ListProductsConfig",
      "type": "object"
    },
    "ListRewardsConfig": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "default": 0,
          "description": "Return one page starting at this offset. Advance by the number of rows returned.",
          "maximum": 10000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_rewards",
          "default": "list_rewards",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListRewardsConfig",
      "type": "object"
    },
    "Payment": {
      "additionalProperties": false,
      "properties": {
        "funding_source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Funding Source Id",
          "type": "string"
        }
      },
      "required": [
        "funding_source_id"
      ],
      "title": "Payment",
      "type": "object"
    },
    "Recipient": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "email": {
          "anyOf": [
            {
              "maxLength": 320,
              "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "phone": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        }
      },
      "title": "Recipient",
      "type": "object"
    },
    "RejectOrderConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "reject_order",
          "default": "reject_order",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "order_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Order Id",
          "type": "string"
        }
      },
      "required": [
        "order_id"
      ],
      "title": "RejectOrderConfig",
      "type": "object"
    },
    "ResendRewardConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "resend_reward",
          "default": "resend_reward",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "reward_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Reward Id",
          "type": "string"
        }
      },
      "required": [
        "reward_id"
      ],
      "title": "ResendRewardConfig",
      "type": "object"
    },
    "Reward": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/RewardValue"
        },
        "recipient": {
          "$ref": "#/$defs/Recipient"
        },
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "products": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Products"
        },
        "campaign_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign Id"
        },
        "custom_fields": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CustomField"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Fields"
        }
      },
      "required": [
        "value",
        "recipient",
        "delivery"
      ],
      "title": "Reward",
      "type": "object"
    },
    "RewardValue": {
      "additionalProperties": false,
      "properties": {
        "denomination": {
          "exclusiveMinimum": 0,
          "title": "Denomination",
          "type": "number"
        },
        "currency_code": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency Code",
          "type": "string"
        }
      },
      "required": [
        "denomination"
      ],
      "title": "RewardValue",
      "type": "object"
    },
    "TremendousAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "tremendous_api_key",
          "default": "tremendous_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "environment": {
          "default": "sandbox",
          "enum": [
            "sandbox",
            "production"
          ],
          "title": "Environment",
          "type": "string"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Tremendous API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Tremendous API key without the Bearer prefix. Choose the environment that issued the key. Sandbox rewards use test funds; production orders spend real funds and can email or text recipients.",
      "x-credential-url": "https://developers.tremendous.com/reference/authentication"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "approve_order": "#/$defs/ApproveOrderConfig",
          "create_invoice": "#/$defs/CreateInvoiceConfig",
          "create_order": "#/$defs/CreateOrderConfig",
          "delete_invoice": "#/$defs/DeleteInvoiceConfig",
          "generate_reward_link": "#/$defs/GenerateRewardLinkConfig",
          "get_campaign": "#/$defs/GetCampaignConfig",
          "get_funding_source": "#/$defs/GetFundingSourceConfig",
          "get_invoice": "#/$defs/GetInvoiceConfig",
          "get_order": "#/$defs/GetOrderConfig",
          "get_organization": "#/$defs/GetOrganizationConfig",
          "get_product": "#/$defs/GetProductConfig",
          "get_reward": "#/$defs/GetRewardConfig",
          "list_campaigns": "#/$defs/ListCampaignsConfig",
          "list_fields": "#/$defs/ListFieldsConfig",
          "list_funding_sources": "#/$defs/ListFundingSourcesConfig",
          "list_invoices": "#/$defs/ListInvoicesConfig",
          "list_orders": "#/$defs/ListOrdersConfig",
          "list_organizations": "#/$defs/ListOrganizationsConfig",
          "list_products": "#/$defs/ListProductsConfig",
          "list_rewards": "#/$defs/ListRewardsConfig",
          "reject_order": "#/$defs/RejectOrderConfig",
          "resend_reward": "#/$defs/ResendRewardConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListRewardsConfig"
        },
        {
          "$ref": "#/$defs/GetRewardConfig"
        },
        {
          "$ref": "#/$defs/ResendRewardConfig"
        },
        {
          "$ref": "#/$defs/GenerateRewardLinkConfig"
        },
        {
          "$ref": "#/$defs/ListOrdersConfig"
        },
        {
          "$ref": "#/$defs/GetOrderConfig"
        },
        {
          "$ref": "#/$defs/CreateOrderConfig"
        },
        {
          "$ref": "#/$defs/ApproveOrderConfig"
        },
        {
          "$ref": "#/$defs/RejectOrderConfig"
        },
        {
          "$ref": "#/$defs/ListProductsConfig"
        },
        {
          "$ref": "#/$defs/GetProductConfig"
        },
        {
          "$ref": "#/$defs/ListCampaignsConfig"
        },
        {
          "$ref": "#/$defs/GetCampaignConfig"
        },
        {
          "$ref": "#/$defs/ListFundingSourcesConfig"
        },
        {
          "$ref": "#/$defs/GetFundingSourceConfig"
        },
        {
          "$ref": "#/$defs/ListInvoicesConfig"
        },
        {
          "$ref": "#/$defs/GetInvoiceConfig"
        },
        {
          "$ref": "#/$defs/CreateInvoiceConfig"
        },
        {
          "$ref": "#/$defs/DeleteInvoiceConfig"
        },
        {
          "$ref": "#/$defs/ListOrganizationsConfig"
        },
        {
          "$ref": "#/$defs/GetOrganizationConfig"
        },
        {
          "$ref": "#/$defs/ListFieldsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TremendousAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Tremendous Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
