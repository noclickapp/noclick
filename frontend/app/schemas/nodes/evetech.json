    "EvetechOAuthCredential": {
      "properties": {
        "credential_type": {
          "const": "evetech_oauth",
          "default": "evetech_oauth",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "character_id": {
          "pattern": "^[1-9][0-9]{0,18}$",
          "title": "Character ID",
          "type": "string"
        },
        "access_token": {
          "minLength": 1,
          "title": "Access Token",
          "type": "string",
          "ui:widget": "password"
