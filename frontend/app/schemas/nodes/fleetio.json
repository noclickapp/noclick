          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key",
        "account_token"
      ],
      "title": "Fleetio API Key",
      "type": "object",
      "x-credential-instructions": "In Fleetio, open Settings \u2192 API Keys. Paste an API key and the Account Token for the account you want to automate. The key's permissions must allow each selected operation. NoClick checks access by listing that account's vehicles.",
