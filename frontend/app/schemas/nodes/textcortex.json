          "x-display-name": "Get File Metadata"
        },
        "file_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetFile",
      "type": "object"
    },
    "GetModel": {
      "properties": {
        "operation": {
          "const": "get_model",
          "default": "get_model",
          "title": "Get Model",
          "type": "string",
          "ui:hidden": true,
