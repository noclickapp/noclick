    "SearchWeb": {
      "properties": {
        "operation": {
          "const": "search_web",
          "default": "search_web",
          "title": "Search the Web",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Search",
          "x-display-name": "Search the Web"
        },
        "query": {
          "description": "Search text. Search may consume credits.",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "website": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Website"
