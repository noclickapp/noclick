    "QueryKnowledgeBase": {
      "properties": {
        "operation": {
          "const": "query_knowledge_base",
          "default": "query_knowledge_base",
          "title": "Query Knowledge Base",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Knowledge",
          "x-display-name": "Query Knowledge Base"
        },
        "kb_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Kb Id",
          "type": "string"
