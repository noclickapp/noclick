    },
    "InsertKnowledgeBaseFile": {
      "properties": {
        "operation": {
          "const": "insert_knowledge_base_file",
          "default": "insert_knowledge_base_file",
          "title": "Add File to Knowledge Base",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Knowledge",
          "x-display-name": "Add File to Knowledge Base"
        },
        "kb_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Kb Id",
          "type": "string"
        },
        "file_id": {
          "description": "An existing uploaded file ID, not a URL. Acknowledgement does not mean indexing has finished.",
          "maxLength": 64,
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "kb_id",
        "file_id"
      ],
      "title": "InsertKnowledgeBaseFile",
      "type": "object"
    },
    "ListFiles": {
      "properties": {
        "page": {
          "default": 0,
          "description": "Zero-based page. Use next_page from the previous result; one page per execution.",
          "minimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "operation": {
          "const": "list_files",
          "default": "list_files",
          "title": "List Owned Files",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Files",
          "x-display-name": "List Owned Files"
        },
        "q": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q"
        }
      },
      "title": "ListFiles",
      "type": "object"
    },
    "ListKnowledgeBaseFiles": {
