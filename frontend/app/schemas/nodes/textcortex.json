        "query": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "top_k": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "verbatim": {
          "default": false,
          "description": "Use plain-text lexical query parsing.",
          "title": "Verbatim",
          "type": "boolean"
        }
      },
      "required": [
        "kb_id",
        "query"
      ],
      "title": "QueryKnowledgeBase",
      "type": "object"
    },
    "SearchKnowledgeBaseFiles": {
      "properties": {
        "page": {
          "default": 0,
          "description": "Zero-based page. Use next_page from the previous result; one page per execution.",
