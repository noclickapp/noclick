{
  "$defs": {
    "CreateChatCompletion": {
      "properties": {
        "operation": {
          "const": "create_chat_completion",
          "default": "create_chat_completion",
          "title": "Create Chat Completion",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Generation",
          "x-display-name": "Create Chat Completion"
        },
        "model": {
          "description": "An available ID from List Chat Models.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt": {
          "description": "User message. Generation may consume credits.",
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "system_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Prompt"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "enum": [
                "none",
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "model",
        "prompt"
      ],
      "title": "CreateChatCompletion",
      "type": "object"
    },
    "CreateResponse": {
      "properties": {
        "operation": {
          "const": "create_response",
          "default": "create_response",
          "title": "Create Text Response",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Generation",
          "x-display-name": "Create Text Response"
        },
        "model": {
          "description": "An available ID from List Chat Models. Uses the model's default reasoning.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "input": {
          "description": "Text input. Generation may consume credits.",
          "minLength": 1,
          "title": "Input",
          "type": "string"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "model",
        "input"
      ],
      "title": "CreateResponse",
      "type": "object"
    },
    "DeleteFile": {
      "properties": {
        "operation": {
          "const": "delete_file",
          "default": "delete_file",
          "title": "Delete Owned File",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Files",
          "x-display-name": "Delete Owned File"
        },
        "file_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "DeleteFile",
      "type": "object"
    },
    "GenerateImage": {
      "properties": {
        "operation": {
          "const": "generate_image",
          "default": "generate_image",
          "title": "Generate Image",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Generation",
          "x-display-name": "Generate Image"
        },
        "prompt": {
          "description": "Image description. Generation may consume credits. Returns a provider image URL.",
          "maxLength": 8000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Image model from the provider's image guide, or omit for its deployment default. List Chat Models does not list image models.",
          "title": "Model"
        },
        "size": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A model-supported pixel size, e.g. 1024x1024.",
          "title": "Size"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "GenerateImage",
      "type": "object"
    },
    "GetBalance": {
      "properties": {
        "operation": {
          "const": "get_balance",
