    "TextcortexAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "textcortex_api_key",
          "default": "textcortex_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "TextCortex API Key",
      "type": "object",
      "x-credential-instructions": "Create an API key in your TextCortex account's API settings, then paste the key here. NoClick sends it as a Bearer token to api.textcortex.com. Connecting reads your owned file list; generation and search can consume credits.",
      "x-credential-url": "https://app.textcortex.com/user/settings/api"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_chat_completion": "#/$defs/CreateChatCompletion",
          "create_response": "#/$defs/CreateResponse",
          "delete_file": "#/$defs/DeleteFile",
          "generate_image": "#/$defs/GenerateImage",
          "get_balance": "#/$defs/GetBalance",
          "get_capabilities": "#/$defs/GetCapabilities",
          "get_file": "#/$defs/GetFile",
          "get_model": "#/$defs/GetModel",
          "insert_knowledge_base_file": "#/$defs/InsertKnowledgeBaseFile",
          "list_files": "#/$defs/ListFiles",
          "list_knowledge_base_files": "#/$defs/ListKnowledgeBaseFiles",
          "list_knowledge_bases": "#/$defs/ListKnowledgeBases",
          "list_models": "#/$defs/ListModels",
          "query_knowledge_base": "#/$defs/QueryKnowledgeBase",
          "search_knowledge_base_files": "#/$defs/SearchKnowledgeBaseFiles",
          "search_web": "#/$defs/SearchWeb"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListFiles"
        },
        {
          "$ref": "#/$defs/GetFile"
        },
        {
          "$ref": "#/$defs/DeleteFile"
        },
        {
          "$ref": "#/$defs/ListKnowledgeBases"
        },
        {
          "$ref": "#/$defs/SearchKnowledgeBaseFiles"
        },
        {
          "$ref": "#/$defs/ListKnowledgeBaseFiles"
        },
        {
          "$ref": "#/$defs/InsertKnowledgeBaseFile"
        },
        {
          "$ref": "#/$defs/QueryKnowledgeBase"
        },
        {
          "$ref": "#/$defs/GetBalance"
        },
        {
          "$ref": "#/$defs/GetCapabilities"
        },
        {
          "$ref": "#/$defs/ListModels"
        },
        {
          "$ref": "#/$defs/GetModel"
        },
        {
          "$ref": "#/$defs/CreateChatCompletion"
        },
        {
          "$ref": "#/$defs/CreateResponse"
        },
        {
          "$ref": "#/$defs/GenerateImage"
        },
        {
          "$ref": "#/$defs/SearchWeb"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TextcortexAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Textcortex Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
