{
  "$defs": {
    "DadataRuCleanData": {
      "additionalProperties": false,
      "description": "Submit data for paid standardization; returns parsed fields and quality codes.",
      "properties": {
        "operation": {
          "const": "clean_data",
          "default": "clean_data",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "data_type": {
          "description": "Data type to standardize.",
          "enum": [
            "name",
            "address",
            "phone",
            "birthdate",
            "email",
            "vehicle",
            "passport"
          ],
          "title": "Data Type",
          "type": "string"
        },
        "data": {
          "description": "The cleaner API accepts one source string per call.",
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Data",
          "type": "array"
        }
      },
      "required": [
        "data_type",
        "data"
      ],
      "title": "DadataRuCleanData",
      "type": "object"
    },
    "DadataRuCleanRecord": {
      "additionalProperties": false,
      "description": "Submit one composite record, keeping the structure and cell order.",
      "properties": {
        "operation": {
          "const": "clean_record",
          "default": "clean_record",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "structure": {
          "items": {
            "enum": [
              "NAME",
              "ADDRESS",
              "PHONE",
              "AS_IS",
              "BIRTHDATE",
              "EMAIL",
              "VEHICLE",
              "PASSPORT",
              "SIMPLE_PARTY_NAME"
            ],
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Structure",
          "type": "array"
        },
        "data": {
          "description": "One record; cells must match the structure order.",
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Data",
          "type": "array"
        }
      },
      "required": [
        "structure",
        "data"
      ],
      "title": "DadataRuCleanRecord",
      "type": "object"
    },
