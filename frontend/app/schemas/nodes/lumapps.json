    "LumAppsAccessTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "lumapps_access_token",
          "default": "lumapps_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Issued Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "api_origin": {
          "description": "Use your actual platform cell, for example https://go-cell-001.api.lumapps.com.",
          "title": "Platform Cell API Origin",
          "type": "string"
        },
        "customer_id": {
          "description": "Actual LumApps customer/organization ID. Token owner and instances are checked against it.",
          "title": "Organization ID",
          "type": "string"
        },
        "expires_at": {
          "description": "ISO 8601 timestamp with timezone. Renew externally; no inferred token lifetime.",
          "title": "Actual Token Expiry",
          "type": "string"
        }
      },
      "required": [
        "access_token",
        "api_origin",
        "customer_id",
        "expires_at"
      ],
      "title": "LumApps Supplied Access Token",
      "type": "object",
      "x-credential-instructions": "Supply an already issued LumApps bearer token, its actual expiry, organization ID and production cell API origin. The node does not create tokens, impersonate users or run browser OAuth.",
      "x-credential-url": "https://developer.lumapps.com/documentation.html"
    },
