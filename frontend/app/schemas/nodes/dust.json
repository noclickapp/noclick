        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_or_updated_document",
          "default": "on_new_or_updated_document",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "New or Updated Matching Document",
          "x-is-trigger": true
        },
        "space_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Space Id",
          "type": "string"
        },
        "data_source_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Data Source Id",
          "type": "string"
        },
        "query": {
          "description": "Semantic search query defining which documents to watch. This watches matching results, not the whole data source.",
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "since_timestamp": {
          "default": 0,
          "description": "Only documents with a newer document timestamp (Unix milliseconds). Writers must advance that timestamp for updates. Existing results are baselined when armed.",
          "minimum": 0,
          "title": "Since Timestamp",
          "type": "number"
        },
        "top_k": {
          "default": 100,
          "description": "Maximum matching documents. If results fill this bound, narrow the query or raise the limit before polling can continue.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "space_id",
        "data_source_id",
        "query"
      ],
      "title": "DustOnDocumentUpdatedConfig",
      "type": "object",
      "x-requires-webhook": true
    },
