{
  "$defs": {
    "DeleteImageConfig": {
      "additionalProperties": false,
      "description": "Remove one uploaded image from a search request, not from the web index.",
      "properties": {
        "id_search": {
          "description": "id_search returned by Upload Search Image.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Search ID",
          "type": "string"
        },
        "operation": {
          "const": "delete_image",
          "default": "delete_image",
          "title": "Remove Search Image",
          "type": "string",
          "ui:hidden": true
        },
        "id_pic": {
          "description": "id_pic from the upload response's input images.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Image ID",
          "type": "string"
        }
      },
      "required": [
        "id_search",
        "id_pic"
      ],
      "title": "DeleteImageConfig",
      "type": "object"
    },
    "FaceCheckAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "facecheck_api_token",
          "default": "facecheck_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "facecheck.id API Token",
      "type": "object",
      "x-credential-instructions": "Paste the API token from your FaceCheck API account. Omit any Bearer prefix. Connecting reads remaining credits and engine status without submitting a search.",
      "x-credential-url": "https://facecheck.id/en/Face-Search/API"
    },
    "GetInfoConfig": {
      "additionalProperties": false,
      "description": "Read remaining account credits, engine availability and indexed face count.",
      "properties": {
        "operation": {
          "const": "get_info",
          "default": "get_info",
          "title": "Get Credits and Engine Status",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetInfoConfig",
      "type": "object"
    },
    "GetSearchStatusConfig": {
      "additionalProperties": false,
      "description": "Read progress or results without submitting a new search.",
      "properties": {
        "id_search": {
          "description": "id_search returned by Upload Search Image.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Search ID",
          "type": "string"
        },
        "operation": {
          "const": "get_search_status",
          "default": "get_search_status",
          "title": "Get Search Status and Results",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "id_search"
      ],
      "title": "GetSearchStatusConfig",
      "type": "object"
    },
    "SearchConfig": {
      "additionalProperties": false,
      "description": "Submit or continue a search; one request returns progress or results.",
      "properties": {
        "id_search": {
          "description": "id_search returned by Upload Search Image.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Search ID",
          "type": "string"
        },
        "operation": {
          "const": "search",
          "default": "search",
          "title": "Run Face Search",
          "type": "string",
          "ui:hidden": true
        },
        "with_progress": {
          "default": true,
          "description": "True returns progress immediately; false waits for completion at the provider.",
          "title": "Return Progress Immediately",
          "type": "boolean"
        },
        "demo": {
          "default": true,
          "description": "Search only the testing subset. Turn off to run a production search using account credits.",
          "title": "Testing Mode",
          "type": "boolean"
        },
        "shady_only": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional shady_only filter from the published API contract.",
          "title": "Shady Only"
        }
      },
      "required": [
        "id_search"
      ],
      "title": "SearchConfig",
      "type": "object"
    },
    "UploadImageConfig": {
      "additionalProperties": false,
      "description": "Upload one image; use the returned id_search for subsequent operations.",
      "properties": {
        "operation": {
          "const": "upload_image",
          "default": "upload_image",
          "title": "Upload Search Image",
          "type": "string",
          "ui:hidden": true
        },
        "image_base64": {
          "contentEncoding": "base64",
          "description": "Raw base64 image bytes, without a data URL prefix. Upload one image per call; supply id_search to add to an existing search.",
          "maxLength": 14000000,
          "minLength": 1,
          "title": "Image (Base64)",
          "type": "string"
        },
        "filename": {
          "default": "image.png",
          "maxLength": 255,
          "title": "Image Filename",
          "type": "string"
        },
        "mime_type": {
          "default": "image/png",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Image Content Type",
          "type": "string"
        },
        "id_search": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave empty to create a new search bundle.",
          "title": "Existing Search ID"
        },
        "reset_prev_images": {
          "default": false,
          "description": "Remove previously uploaded images from this search bundle.",
          "title": "Reset Previous Images",
          "type": "boolean"
        }
      },
      "required": [
        "image_base64"
      ],
      "title": "UploadImageConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "delete_image": "#/$defs/DeleteImageConfig",
          "get_info": "#/$defs/GetInfoConfig",
          "get_search_status": "#/$defs/GetSearchStatusConfig",
          "search": "#/$defs/SearchConfig",
          "upload_image": "#/$defs/UploadImageConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetInfoConfig"
        },
        {
          "$ref": "#/$defs/UploadImageConfig"
        },
        {
          "$ref": "#/$defs/SearchConfig"
        },
        {
          "$ref": "#/$defs/GetSearchStatusConfig"
        },
        {
          "$ref": "#/$defs/DeleteImageConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/FaceCheckAPITokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Facecheck Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
