{
  "$defs": {
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    },
    "SmilyAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "smily_api_key",
          "default": "smily_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "host": {
          "description": "The HTTPS host supplied by Smily, for example https://my-channel.platforms.bookingsync.com.",
          "title": "Channel API Host",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "host"
      ],
      "title": "Smily API Key",
      "type": "object",
      "x-credential-instructions": "Paste the Channel API key and host supplied by the Smily Partners Team (partners@smily.com). This integration uses the Channel API; API v3 OAuth tokens belong to a different API.",
      "x-credential-url": "https://channel-api.developers.bookingsync.com/guides/getting-started/"
    },
    "SmilyCancelBookingConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "cancel_booking",
          "default": "cancel_booking",
          "title": "Cancel Booking",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Bookings",
          "x-display-name": "Cancel Booking",
          "x-is-trigger": false
        },
        "booking_id": {
          "exclusiveMinimum": 0,
          "title": "Booking Id",
          "type": "integer"
        },
        "cancelation_description": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancelation Description"
        },
        "cancelation_reason": {
          "enum": [
            "canceled_by_owner_other",
            "canceled_by_traveller_other",
            "canceled_by_owner_incorrect_price",
            "canceled_by_owner_rental_unbookable",
            "canceled_by_traveller_minimum_age_not_met",
            "canceled_by_traveller_travel_arrangements_infeasible",
            "canceled_by_traveller_travel_arrangements_infeasible_due_to_visa",
            "canceled_by_traveller_travel_arrangements_infeasible_due_to_covid",
            "canceled_by_traveller_host_request_book_elsewhere",
            "canceled_by_traveller_property_quality",
            "canceled_by_owner_no_payment",
            "canceled_by_owner_rental_overbooked",
            "canceled_by_traveller_wrong_price",
            "canceled_by_traveller_wrong_facilities",
            "canceled_by_traveller_rebooking",
            "canceled_by_traveller_personal"
          ],
          "title": "Cancelation Reason",
          "type": "string"
        },
        "channel_cancelation_cost": {
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
          "title": "Channel Cancelation Cost",
          "type": "string"
        },
        "currency": {
          "description": "ISO currency from the quote or original booking.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "booking_id",
        "cancelation_reason",
        "channel_cancelation_cost",
        "currency"
      ],
      "title": "SmilyCancelBookingConfig",
      "type": "object"
    },
