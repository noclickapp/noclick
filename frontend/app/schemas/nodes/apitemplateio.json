          "title": "Output Format",
          "type": "string"
        },
        "settings": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PDF generation settings JSON object (paper_size, margins, header/footer).",
          "title": "Settings",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "operation": {
          "const": "create_pdf_from_html",
          "default": "create_pdf_from_html",
          "title": "Create PDF from HTML",
          "type": "string",
          "ui:hidden": true
        },
        "body": {
          "description": "HTML body, optionally with Jinja2 variables.",
          "maxLength": 2000000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "css": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CSS including style tags.",
          "title": "Css"
        },
        "data": {
          "anyOf": [
            {
              "maxLength": 2000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON object of template variables.",
          "title": "Data",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "body"
      ],
      "title": "CreatePdfFromHtml",
      "type": "object"
    },
