        "template_id"
      ],
      "title": "UpdateTemplate",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_image": "#/$defs/CreateImage",
          "create_pdf": "#/$defs/CreatePdf",
          "create_pdf_from_html": "#/$defs/CreatePdfFromHtml",
          "create_pdf_from_url": "#/$defs/CreatePdfFromUrl",
          "delete_object": "#/$defs/DeleteObject",
          "get_template": "#/$defs/GetTemplate",
          "list_objects": "#/$defs/ListObjects",
          "list_templates": "#/$defs/ListTemplates",
          "merge_pdfs": "#/$defs/MergePdfs",
          "update_template": "#/$defs/UpdateTemplate"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CreatePdf"
        },
        {
          "$ref": "#/$defs/CreateImage"
        },
        {
          "$ref": "#/$defs/CreatePdfFromHtml"
        },
        {
          "$ref": "#/$defs/CreatePdfFromUrl"
        },
        {
          "$ref": "#/$defs/ListObjects"
        },
        {
          "$ref": "#/$defs/DeleteObject"
        },
        {
          "$ref": "#/$defs/ListTemplates"
        },
        {
          "$ref": "#/$defs/GetTemplate"
        },
        {
          "$ref": "#/$defs/UpdateTemplate"
        },
        {
          "$ref": "#/$defs/MergePdfs"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/APITemplateIOApiKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Apitemplateio Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Create a PDF from this template",
    "Generate a social image",
    "Merge these PDFs"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
