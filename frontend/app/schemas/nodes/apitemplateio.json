    "DeleteObject": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "delete_object",
          "default": "delete_object",
          "description": "Deletes a generated file using the provider's documented GET endpoint.",
          "title": "Delete Generated Object",
          "type": "string",
          "ui:hidden": true
        },
        "transaction_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Transaction Ref",
          "type": "string"
        }
      },
      "required": [
        "transaction_ref"
      ],
      "title": "DeleteObject",
      "type": "object"
    },
    "GetTemplate": {
      "additionalProperties": false,
      "properties": {
        "template_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Template ID",
          "type": "string"
        },
        "operation": {
          "const": "get_template",
          "default": "get_template",
          "title": "Get PDF Template",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "template_id"
      ],
      "title": "GetTemplate",
      "type": "object"
    },
    "ListObjects": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 100,
          "description": "One page only. Increase offset by the number of returned records for another page.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_objects",
          "default": "list_objects",
          "title": "List Generated Objects",
          "type": "string",
          "ui:hidden": true
        },
        "template_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Id"
        },
        "transaction_type": {
          "anyOf": [
            {
              "enum": [
                "PDF",
                "JPEG",
                "MERGE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transaction Type",
          "enum": [
            "PDF",
            "JPEG",
            "MERGE"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "ListObjects",
      "type": "object"
    },
    "ListTemplates": {
      "additionalProperties": false,
