          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_templates",
          "default": "list_templates",
          "title": "List Templates",
          "type": "string",
          "ui:hidden": true
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "PDF",
                "JPEG"
              ],
              "type": "string"
            },
