        "urls": {
          "description": "PDF URLs in merge order.",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Urls",
          "type": "array"
        }
      },
      "required": [
        "urls"
      ],
      "title": "MergePdfs",
      "type": "object"
    },
    "UpdateTemplate": {
      "additionalProperties": false,
      "properties": {
        "template_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Template ID",
          "type": "string"
        },
        "operation": {
          "const": "update_template",
          "default": "update_template",
          "title": "Update PDF Template",
          "type": "string",
          "ui:hidden": true
        },
        "body": {
          "anyOf": [
            {
              "maxLength": 2000000,
              "type": "string"
            },
