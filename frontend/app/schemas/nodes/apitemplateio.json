          "default": null,
          "description": "External reference for list objects.",
          "title": "Meta"
        },
        "filename": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom filename ending in .pdf.",
          "title": "Filename"
        },
        "output_format": {
          "default": "pdf",
          "enum": [
            "pdf",
            "html"
          ],
          "title": "Output Format",
          "type": "string"
        },
        "template_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Template ID",
          "type": "string"
        },
        "operation": {
          "const": "create_pdf",
          "default": "create_pdf",
          "title": "Create PDF",
          "type": "string",
          "ui:hidden": true
        },
        "data": {
          "description": "Template JSON data object.",
          "maxLength": 2000000,
          "title": "Data",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "template_id",
        "data"
      ],
      "title": "CreatePdf",
      "type": "object"
    },
