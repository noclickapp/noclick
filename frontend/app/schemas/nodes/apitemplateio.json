{
  "$defs": {
    "APITemplateIOApiKey": {
      "properties": {
        "credential_type": {
          "const": "apitemplateio_api_key",
          "default": "apitemplateio_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "region": {
          "default": "singapore",
          "enum": [
            "singapore",
            "australia",
            "europe",
            "us"
          ],
          "title": "Processing region",
          "type": "string"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "APITemplate.io API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the APITemplate.io web console. Paste the key without a header prefix, and choose your processing region. NoClick checks your account's templates using X-API-KEY.",
      "x-credential-url": "https://app.apitemplate.io/"
    },
    "CreateImage": {
      "additionalProperties": false,
      "properties": {
        "expiration": {
          "default": 60,
          "description": "File lifetime in minutes; 0 stores permanently.",
          "maximum": 10080,
          "minimum": 0,
          "title": "Expiration",
          "type": "integer"
        },
        "cloud_storage": {
          "default": 1,
          "description": "Store on provider CDN (1), or use configured post actions (0).",
          "enum": [
            0,
            1
          ],
          "title": "Cloud Storage",
          "type": "integer"
        },
        "meta": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "External reference for list objects.",
          "title": "Meta"
        },
        "template_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Template ID",
          "type": "string"
        },
        "operation": {
          "const": "create_image",
          "default": "create_image",
          "title": "Create Image",
          "type": "string",
          "ui:hidden": true
        },
        "data": {
          "description": "JSON object with an overrides array of named template layers.",
          "maxLength": 2000000,
          "title": "Data",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "output_image_type": {
          "default": "all",
          "enum": [
            "jpegOnly",
            "pngOnly",
            "all"
          ],
          "title": "Output Image Type",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "data"
      ],
      "title": "CreateImage",
      "type": "object"
    },
