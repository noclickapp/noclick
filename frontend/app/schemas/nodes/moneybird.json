          "$ref": "#/$defs/CreateProductConfig"
        },
        {
          "$ref": "#/$defs/ListLedgerAccountsConfig"
        },
        {
          "$ref": "#/$defs/ListTaxRatesConfig"
        },
        {
          "$ref": "#/$defs/ListFinancialAccountsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneybirdTokenCredential"
        },
