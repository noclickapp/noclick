  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_contact": "#/$defs/CreateContactConfig",
          "create_estimate": "#/$defs/CreateEstimateConfig",
          "create_product": "#/$defs/CreateProductConfig",
          "create_sales_invoice": "#/$defs/CreateSalesInvoiceConfig",
          "list_administrations": "#/$defs/ListAdministrationsConfig",
          "list_contacts": "#/$defs/ListContactsConfig",
          "list_estimates": "#/$defs/ListEstimatesConfig",
          "list_financial_accounts": "#/$defs/ListFinancialAccountsConfig",
          "list_ledger_accounts": "#/$defs/ListLedgerAccountsConfig",
          "list_products": "#/$defs/ListProductsConfig",
          "list_sales_invoices": "#/$defs/ListSalesInvoicesConfig",
          "list_tax_rates": "#/$defs/ListTaxRatesConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
