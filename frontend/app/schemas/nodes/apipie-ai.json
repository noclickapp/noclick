                "pinecone",
                "qdrant"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vector provider to use to store the collection",
          "title": "Vector Provider",
          "enum": [
            "pinecone",
            "qdrant"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "collection_name",
        "dimension"
      ],
      "title": "CreateVectorCollectionConfig",
      "type": "object"
    },
    "DeleteStateConfig": {
      "additionalProperties": false,
