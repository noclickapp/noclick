        "operation": {
          "const": "update_state",
          "default": "update_state",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "enable_user_states": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If true, scope is per-user (user_id + user). If false, scope is per-app (user_id + app label).",
          "title": "Enable User States"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when enable_user_states=true. Identifies the end-user.",
          "title": "User"
        },
        "enable_inline_cli": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enable a command line CLI for state management at the prompt, use ':help' in the prompt to any LLM for more details",
          "title": "Enable Inline Cli"
        },
        "gui_only": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, state configuration can only be performed through the APIpie GUI and cannot be edited via API or inline cli for this API key.",
          "title": "Gui Only"
        },
        "settings": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settings"
        },
        "delete": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Keys to remove from the existing settings (partial delete). Use POST to perform partial key deletes.",
          "title": "Delete"
        },
        "app_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9 _+-]{1,256}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App Name"
        }
      },
      "title": "UpdateStateConfig",
      "type": "object"
    },
    "UpsertVectorConfig": {
      "additionalProperties": false,
      "description": "Update or insert a vector into a collection.",
      "properties": {
        "operation": {
          "const": "upsert_vector",
          "default": "upsert_vector",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "collection_name": {
          "title": "Collection Name",
          "type": "string"
        },
        "vector_id": {
          "title": "Vector Id",
          "type": "string"
        },
        "metatag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metatag"
        },
        "data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "embedding": {
          "items": {
            "type": "number"
