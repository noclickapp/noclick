{
  "$defs": {
    "ApipieAICredential": {
      "properties": {
        "credential_type": {
          "const": "apipie_ai_api_key",
          "default": "apipie_ai_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Apipie AI API Key",
      "type": "object",
      "x-credential-instructions": "Paste your APIpie API key from your profile. NoClick verifies it by reading the app's current state settings.",
      "x-credential-type": "api_key",
      "x-credential-url": "https://apipie.ai/profile"
    },
    "CreateChatCompletionConfig": {
      "additionalProperties": false,
      "description": "Chat Completions.",
      "properties": {
        "operation": {
          "const": "create_chat_completion",
          "default": "create_chat_completion",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "title": "Messages",
          "type": "array"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unique identifier for the user, enabling tenant observability for usage and billing, and providing tenant services for memory and inline_cli.",
          "title": "User"
        },
        "model": {
          "description": "Language Model to use, comma separated, up to 5 models. Check our /models route for list of language models. Cannot use provider option with multi-model.",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "AI Service Provider to use, omit provider and we will automatically use the most responsive provider. Optionally you can include provider with the model instead such as model: provider/model",
          "title": "Provider"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Influences the randomness in the selection process of the next token. Lower values make the model more deterministic, while higher values increase diversity but might reduce coherence.",
          "title": "Temperature"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Max tokens used to generate a response",
          "title": "Max Tokens"
        }
      },
      "required": [
        "messages",
        "model"
      ],
      "title": "CreateChatCompletionConfig",
      "type": "object"
    },
    "CreateEmbeddingConfig": {
      "additionalProperties": false,
      "description": "Embeddings LLM.",
      "properties": {
        "operation": {
          "const": "create_embedding",
          "default": "create_embedding",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "model": {
          "description": "Model to use for generating embeddings.",
          "title": "Model",
          "type": "string"
        },
        "input": {
          "description": "Input text to generate embeddings for.",
          "title": "Input",
          "type": "string"
        },
        "encoding_format": {
          "anyOf": [
            {
              "enum": [
                "float",
                "np"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Format of the output encoding. Only supported by OpenAI",
          "title": "Encoding Format",
          "enum": [
            "float",
            "np"
          ],
          "x-enum-searchable": true
        },
        "dimensions": {
          "anyOf": [
            {
              "maximum": 1536,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of dimensions for the embedding vector. Maximum value is 384-1536 check the models route for max_tokens per model. Only supported by OpenAI",
          "title": "Dimensions"
        }
      },
      "required": [
        "model",
        "input"
      ],
      "title": "CreateEmbeddingConfig",
      "type": "object"
    },
    "CreateVectorCollectionConfig": {
      "additionalProperties": false,
      "description": "Create a new vector collection.",
      "properties": {
        "operation": {
          "const": "create_vector_collection",
          "default": "create_vector_collection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "collection_name": {
          "title": "Collection Name",
          "type": "string"
