    "GenerateImageConfig": {
      "additionalProperties": false,
      "description": "Image Generation.",
      "properties": {
        "operation": {
          "const": "generate_image",
          "default": "generate_image",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "prompt": {
          "description": "Text description of the desired image(s)",
