          "default": null,
          "description": "The model to use for image generation",
          "title": "Model"
        },
        "n": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The number of images to generate, we currently only support one at a time",
          "title": "N"
        },
        "size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The size of the generated images",
          "title": "Size"
        },
        "quality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The quality of the image that will be generated",
          "title": "Quality"
        },
        "style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The style of the generated images the options are vivid and natural and does not apply to all providers",
          "title": "Style"
        },
        "seed": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A randomness initializer for image reproducibility. Check specific models for compatibility.",
          "title": "Seed"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "GenerateImageConfig",
      "type": "object"
