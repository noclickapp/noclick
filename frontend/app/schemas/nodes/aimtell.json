          ],
          "default": null,
          "title": "Alias"
        },
        "push_ttl": {
          "default": 604800,
          "minimum": 0,
          "title": "Push Ttl",
          "type": "integer"
        },
        "auto_hide": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
