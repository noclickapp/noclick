      "additionalProperties": false,
      "description": "Queue one push for an explicit audience; delivery is not verified.",
      "properties": {
        "operation": {
          "const": "send_push",
          "default": "send_push",
          "title": "Operation",
          "type": "string"
        },
        "site_id": {
          "minimum": 1,
