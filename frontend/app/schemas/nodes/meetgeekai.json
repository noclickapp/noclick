          "default": "meetgeekai_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_base_url": {
          "default": "https://api.meetgeek.ai",
          "enum": [
            "https://api.meetgeek.ai",
            "https://api-eu.meetgeek.ai",
            "https://api-us.meetgeek.ai"
          ],
          "title": "API region",
          "type": "string"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Meetgeek.ai API Key",
      "type": "object",
      "x-credential-instructions": "In MeetGeek, open Integrations \u2192 Public API and copy your API key. Paste the key without the Bearer prefix. Choose the API region used by your account.",
      "x-credential-url": "https://app.meetgeek.ai/integrations"
    },
