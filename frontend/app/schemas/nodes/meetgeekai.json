  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "delete_meeting": "#/$defs/DeleteMeetingConfig",
          "download_recording": "#/$defs/DownloadRecordingConfig",
          "get_highlights": "#/$defs/GetHighlightsConfig",
          "get_insights": "#/$defs/GetInsightsConfig",
          "get_meeting": "#/$defs/GetMeetingConfig",
          "get_summary": "#/$defs/GetSummaryConfig",
          "get_transcript": "#/$defs/GetTranscriptConfig",
          "join_meeting": "#/$defs/JoinMeetingConfig",
          "list_meetings": "#/$defs/ListMeetingsConfig",
          "list_team_meetings": "#/$defs/ListTeamMeetingsConfig",
          "list_teams": "#/$defs/ListTeamsConfig",
          "upload_recording": "#/$defs/UploadRecordingConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListMeetingsConfig"
        },
        {
          "$ref": "#/$defs/GetMeetingConfig"
        },
        {
          "$ref": "#/$defs/DeleteMeetingConfig"
        },
        {
          "$ref": "#/$defs/GetInsightsConfig"
        },
        {
          "$ref": "#/$defs/GetHighlightsConfig"
        },
        {
          "$ref": "#/$defs/GetSummaryConfig"
        },
        {
          "$ref": "#/$defs/GetTranscriptConfig"
        },
        {
          "$ref": "#/$defs/DownloadRecordingConfig"
        },
        {
          "$ref": "#/$defs/ListTeamsConfig"
        },
        {
          "$ref": "#/$defs/ListTeamMeetingsConfig"
        },
        {
          "$ref": "#/$defs/JoinMeetingConfig"
        },
        {
          "$ref": "#/$defs/UploadRecordingConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeetGeekAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Meetgeekai Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
