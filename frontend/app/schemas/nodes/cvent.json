        },
        "client_id": {
          "minLength": 1,
          "title": "Client ID",
          "type": "string"
        },
        "client_secret": {
          "minLength": 1,
          "title": "Client Secret",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "client_id",
        "client_secret"
      ],
      "title": "Cvent Client",
      "type": "object",
      "x-credential-instructions": "Create a Cvent application in the developer portal, associate the required API scopes, and paste its client ID and client secret. NoClick obtains a short-lived access token using the client credentials grant. This method uses the North America API region.",
      "x-credential-url": "https://developers.cvent.com/docs/rest-api/tutorials/developer-quickstart"
    },
    "CventCreateAttendeesConfig": {
      "additionalProperties": false,
      "description": "Add Attendees",
      "properties": {
        "operation": {
          "const": "create_attendees",
          "default": "create_attendees",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Attendees",
          "x-display-name": "Add Attendees"
        },
        "payload": {
          "description": "This endpoint supports both the invite and the ability to push registered attendees into Cvent.\nThere are some slight differences in how you use each path.\n\n**Invite**\n\nFields supported for invite:\n* event.id *(required)*\n* contact.id *(required)*\n* invitationList.id\n\n**Note:** Up to 100 attendees can be invited per call. Sending a *status* of `No Response` will invite the attendee.\n\n**Register**\n\n* All fields are supported for register.\n* admissionItem.id *(required)*\n\n**Note:** When sending registration, one attendee per call is supported. Sending a status of `Accepted` will register the attendee.\n See the Cvent REST API reference for all fields. Send the complete intended record for updates.",
          "title": "Request JSON",
          "type": "string",
          "ui:widget": "textarea"
        }
      },
      "required": [
        "payload"
      ],
      "title": "CventCreateAttendeesConfig",
      "type": "object"
    },
