      "type": "object"
    },
    "CradlAIAccessTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "cradl_ai_access_token",
          "default": "cradl_ai_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Access token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "Cradl AI Access Token",
      "type": "object",
      "x-credential-instructions": "Paste a Cradl AI bearer access token obtained using your application's client credentials, as described in the API introduction. Give the application read access to agents for the connection check, plus the read/write scopes needed by your operations. Tokens expire: replace this token when it expires. NoClick does not refresh it or ask for your application secret.",
      "x-credential-url": "https://docs.cradl.ai/api-reference/introduction"
    },
    "CreateAgentRun": {
      "additionalProperties": false,
      "description": "Start a run, optionally passing variables through to its output.",
