          "title": "Variables"
        }
      },
      "required": [
        "agent_id"
      ],
      "title": "CreateAgentRun",
      "type": "object"
    },
    "CreateDocument": {
      "additionalProperties": false,
      "description": "Create a document record with optional inline base64 file content.\n\nIf content is omitted, upload separately to the returned fileUrl before\nexpecting predictions. Creating the record alone does not upload a file.",
      "properties": {
        "operation": {
          "const": "create_document",
          "default": "create_document",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 4096,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "agent_run_id": {
          "anyOf": [
            {
              "pattern": "^((cradl|las):organization:[a-z0-9_-]+/)?cradl:agent:[a-z0-9_-]+/cradl:run:[a-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Run Id"
        },
        "dataset_id": {
          "anyOf": [
            {
              "pattern": "^(cradl|las):dataset:[a-f0-9]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "content_type": {
          "anyOf": [
            {
              "enum": [
                "application/pdf",
                "image/jpeg",
                "image/png",
                "image/tiff",
                "image/webp",
                "message/rfc822"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type",
          "enum": [
            "application/pdf",
            "image/jpeg",
            "image/png",
            "image/tiff",
            "image/webp",
            "message/rfc822"
          ],
          "x-enum-searchable": true
        },
        "content": {
          "anyOf": [
            {
              "maxLength": 6250000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional base64 document content, as accepted by POST /documents. Without it, this creates metadata only.",
          "title": "Content"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata"
        },
        "retention_in_days": {
          "anyOf": [
            {
              "maximum": 1825,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention In Days"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateDocument",
      "type": "object"
    },
