{
  "$defs": {
    "FormsparkAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "formspark_api_token",
          "default": "formspark_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Formspark API Token",
      "type": "object",
      "x-credential-instructions": "Create an API token in the Formspark dashboard under API tokens and paste it here without the Bearer prefix. Include workspaces:read for the connection check, plus forms:read, forms:write, submissions:read, submissions:write or workspaces:write for the operations you use. Form and submission access requires an upgraded workspace. Tokens expire unless you choose Never; replace expired or revoked tokens manually.",
      "x-credential-url": "https://dashboard.formspark.io/"
    },
    "FormsparkCreateFormConfig": {
      "additionalProperties": false,
      "description": "Create a form.",
      "properties": {
        "operation": {
          "const": "create_form",
          "default": "create_form",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "technology": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technology"
        },
        "notificationEmails": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Complete replacement list of notification email addresses (at most 100).",
          "title": "Notificationemails"
        },
        "emailThreading": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emailthreading"
        },
        "automaticSpamFilter": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether submissions to this form are screened by the automatic spam filter. Defaults to true. Setting it to false stores every submission, including the ones the filter would have held back, and each of those counts against the workspace's quota.",
          "title": "Automaticspamfilter"
        },
        "webhookUrl": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where each submission is delivered. Must be an http or https URL, and must resolve to a public address when called.",
          "title": "Webhookurl"
        },
        "slackChannel": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slackchannel"
        },
        "customHoneypot": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customhoneypot"
        },
        "customSpamWords": {
          "anyOf": [
            {
              "maxLength": 2560,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customspamwords",
          "ui:widget": "textarea"
        },
        "allowedDomains": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The sites a submission may be sent from. Each entry also covers its subdomains, and a pasted address is reduced to its host. Once the list is set, a submission must carry an Origin or Referer header naming one of them, so a server-side request is rejected unless it sends one. An empty list or null accepts submissions from anywhere.",
          "title": "Alloweddomains"
        },
        "spamProtection": {
          "anyOf": [
            {
              "enum": [
                "BOTPOISON",
                "GOOGLE_RECAPTCHA_V2",
                "HCAPTCHA",
                "TURNSTILE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The challenge a submitter must pass. Requires the provider's secret key, stored on the form earlier or sent in the same request. Null disables it.",
          "title": "Spamprotection",
          "enum": [
            "BOTPOISON",
            "GOOGLE_RECAPTCHA_V2",
            "HCAPTCHA",
            "TURNSTILE"
          ],
          "x-enum-searchable": true
        },
        "botpoisonSecretKey": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The Botpoison secret key the form verifies challenges with. Write-only: it is stored on the form and never returned. Null removes it, which is refused while the form's spamProtection uses it.",
          "title": "Botpoisonsecretkey",
          "ui:widget": "password"
        },
        "recaptchaV2SecretKey": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
