          "default": null,
          "description": "The Turnstile secret key the form verifies challenges with. Write-only: it is stored on the form and never returned. Null removes it, which is refused while the form's spamProtection uses it.",
          "title": "Turnstilesecretkey",
          "ui:widget": "password"
