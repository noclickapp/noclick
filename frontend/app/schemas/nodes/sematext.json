{
  "$defs": {
    "CheckConnection": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "CheckConnection",
      "type": "object"
    },
    "GetApp": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "title": "App",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "app_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "sematext_app"
        },
        "operation": {
          "const": "get_app",
          "default": "get_app",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "app_id"
      ],
      "title": "GetApp",
      "type": "object"
    },
    "ListAlertRules": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "title": "App",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "app_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "sematext_app"
        },
        "operation": {
          "const": "list_alert_rules",
          "default": "list_alert_rules",
          "title": "Operation",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "description": "Local output bound only. Alert rules are unpaged in the documented contract; global completion remains unknown.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "app_id"
      ],
      "title": "ListAlertRules",
      "type": "object"
    },
    "ListAppTypes": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 50,
          "description": "Local output bound, not an API page size. No pagination is documented for these routes; global completion remains unknown.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "operation": {
          "const": "list_app_types",
          "default": "list_app_types",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListAppTypes",
      "type": "object"
    },
    "ListApps": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 50,
          "description": "Local output bound, not an API page size. No pagination is documented for these routes; global completion remains unknown.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "operation": {
          "const": "list_apps",
          "default": "list_apps",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListApps",
      "type": "object"
    },
    "SematextAccountAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "sematext_account_api_key",
          "default": "sematext_account_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "Account API Key",
          "type": "string",
          "ui:sensitive": true,
          "ui:widget": "password"
        },
        "region": {
          "default": "US",
          "description": "Use the region in which the key and apps already exist. No cross-region fallback is performed.",
          "enum": [
            "US",
            "EU"
          ],
          "title": "Account Region",
          "type": "string"
        },
        "approved_app_ids_json": {
          "default": "[]",
          "description": "JSON string array of existing positive app IDs, at most 50. Example: [\"123\",\"456\"].",
          "title": "Approved App IDs",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "include_labels": {
          "default": false,
          "description": "Opt in to names only. Messages, tokens, emails, integration configuration, queries, runbooks and all links are always omitted.",
          "title": "Include App and Rule Names",
          "type": "boolean"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Sematext Account API Key",
      "type": "object",
      "x-credential-instructions": "Enter an existing account API key, its US or EU region, and approved existing app IDs. This is distinct from an app ingestion/read/write token. Protected catalog access does not identify a principal or prove account ownership.",
      "x-help-url": "https://sematext.com/docs/api/"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/CheckConnection",
          "get_app": "#/$defs/GetApp",
          "list_alert_rules": "#/$defs/ListAlertRules",
          "list_app_types": "#/$defs/ListAppTypes",
          "list_apps": "#/$defs/ListApps"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CheckConnection"
        },
        {
          "$ref": "#/$defs/ListApps"
        },
        {
          "$ref": "#/$defs/GetApp"
        },
        {
          "$ref": "#/$defs/ListAppTypes"
        },
        {
          "$ref": "#/$defs/ListAlertRules"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/SematextAccountAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Sematext Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Read metadata for an approved Sematext app",
    "List alert-rule status for an approved app",
    "List supported app types"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
