          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetCredits",
      "type": "object"
    },
    "GetUsage": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_usage",
          "default": "get_usage",
