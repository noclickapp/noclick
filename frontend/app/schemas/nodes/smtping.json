          "title": "Submit Email Check Job",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "check",
        "emails"
      ],
      "title": "CreateCheckJob",
      "type": "object"
    },
    "GetBulkJob": {
      "additionalProperties": false,
      "properties": {
