          "description": "List to check: spamtrap, disposable, spambot or complainer.",
          "enum": [
            "spamtrap",
            "disposable",
            "spambot",
            "complainer"
          ],
          "title": "Check",
          "type": "string"
        },
        "email": {
          "format": "email",
          "minLength": 3,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email Address",
          "type": "string"
        },
        "operation": {
          "const": "check_one",
          "default": "check_one",
          "title": "Check One Email",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "check",
        "email"
      ],
      "title": "CheckOne",
      "type": "object"
    },
    "CreateBulkJob": {
      "additionalProperties": false,
      "properties": {
        "emails": {
          "description": "JSON list of addresses; up to 100,000 for an asynchronous job.",
          "items": {
            "format": "email",
            "minLength": 3,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "type": "string"
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Email Addresses",
          "type": "array"
        },
        "operation": {
          "const": "create_bulk_job",
          "default": "create_bulk_job",
          "title": "Submit Bulk Verification Job",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "emails"
      ],
      "title": "CreateBulkJob",
      "type": "object"
    },
    "CreateCheckJob": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "description": "List to check: spamtrap, disposable, spambot or complainer.",
          "enum": [
            "spamtrap",
            "disposable",
            "spambot",
            "complainer"
          ],
          "title": "Check",
          "type": "string"
        },
        "emails": {
