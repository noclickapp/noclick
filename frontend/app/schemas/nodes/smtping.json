          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetUsage",
      "type": "object"
    },
    "SmtpingApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "smtping_api_key",
          "default": "smtping_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Smtping API Key",
      "type": "object",
      "x-credential-instructions": "In the Smtping dashboard, open API Keys and create a key. Copy the secret shown once. Paste only the key; NoClick sends it as X-API-Key. Keys share your account credits and rate limits.",
      "x-credential-url": "https://app.smtping.com"
    },
    "VerifySingle": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "format": "email",
          "minLength": 3,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email Address",
          "type": "string"
        },
        "operation": {
          "const": "verify_single",
          "default": "verify_single",
          "title": "Verify Email",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "email"
      ],
      "title": "VerifySingle",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_batch": "#/$defs/CheckBatch",
          "check_flags": "#/$defs/CheckFlags",
          "check_one": "#/$defs/CheckOne",
          "create_bulk_job": "#/$defs/CreateBulkJob",
          "create_check_job": "#/$defs/CreateCheckJob",
          "get_bulk_job": "#/$defs/GetBulkJob",
          "get_bulk_job_result": "#/$defs/GetBulkJobResult",
          "get_check_job": "#/$defs/GetCheckJob",
          "get_check_job_result": "#/$defs/GetCheckJobResult",
          "get_credits": "#/$defs/GetCredits",
          "get_usage": "#/$defs/GetUsage",
          "verify_single": "#/$defs/VerifySingle"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/VerifySingle"
        },
        {
          "$ref": "#/$defs/CreateBulkJob"
        },
        {
          "$ref": "#/$defs/GetBulkJob"
        },
        {
          "$ref": "#/$defs/GetBulkJobResult"
        },
        {
          "$ref": "#/$defs/CheckOne"
        },
        {
          "$ref": "#/$defs/CheckBatch"
        },
        {
          "$ref": "#/$defs/CreateCheckJob"
        },
        {
          "$ref": "#/$defs/GetCheckJob"
        },
        {
          "$ref": "#/$defs/GetCheckJobResult"
        },
        {
          "$ref": "#/$defs/CheckFlags"
        },
        {
          "$ref": "#/$defs/GetCredits"
        },
        {
          "$ref": "#/$defs/GetUsage"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/SmtpingApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Smtping Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Verify an email address",
    "Submit a list for bulk verification",
    "Check for disposable emails",
    "Get my remaining credits"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
