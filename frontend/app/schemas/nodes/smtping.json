{
  "$defs": {
    "CheckBatch": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "description": "List to check: spamtrap, disposable, spambot or complainer.",
          "enum": [
            "spamtrap",
            "disposable",
            "spambot",
            "complainer"
          ],
          "title": "Check",
          "type": "string"
        },
        "emails": {
          "description": "Synchronous batch: at most 1,000 addresses. Use a check job for larger lists.",
          "items": {
            "format": "email",
            "minLength": 3,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Email Addresses",
          "type": "array"
        },
        "operation": {
          "const": "check_batch",
          "default": "check_batch",
          "title": "Check Email Batch",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "check",
        "emails"
      ],
      "title": "CheckBatch",
      "type": "object"
    },
    "CheckFlags": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "format": "email",
          "minLength": 3,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email Address",
          "type": "string"
        },
        "operation": {
          "const": "check_flags",
          "default": "check_flags",
          "title": "Get All Email Flags",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "email"
      ],
      "title": "CheckFlags",
      "type": "object"
    },
    "CheckOne": {
      "additionalProperties": false,
