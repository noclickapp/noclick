{
  "$defs": {
    "GriptapeAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "griptape_api_key",
          "default": "griptape_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Griptape API Key",
      "type": "object",
      "x-credential-instructions": "Create an API key in Griptape Cloud and paste it here. NoClick sends it as a Bearer token only to cloud.griptape.ai. The connection check lists your conversation threads. The key must have access to the resources your workflow uses.",
      "x-credential-url": "https://help.griptape.ai/en/articles/10509294-api-keys"
    },
    "GriptapeCancelAssistantRunConfig": {
      "additionalProperties": false,
      "description": "Request cancellation of an assistant run.",
      "properties": {
        "operation": {
          "const": "cancel_assistant_run",
          "default": "cancel_assistant_run",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "assistant_run_id": {
          "description": "Griptape resource UUID (version 4).",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
          "title": "Assistant Run Id",
          "type": "string"
        }
      },
      "required": [
        "assistant_run_id"
      ],
      "title": "GriptapeCancelAssistantRunConfig",
      "type": "object"
    },
    "GriptapeCancelStructureRunConfig": {
