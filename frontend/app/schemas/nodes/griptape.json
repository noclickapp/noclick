    "GriptapeCreateAssistantRunConfig": {
      "additionalProperties": false,
      "description": "Start a non-streaming assistant run; may incur provider charges.",
      "properties": {
        "operation": {
          "const": "create_assistant_run",
          "default": "create_assistant_run",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "assistant_id": {
          "description": "Griptape resource UUID (version 4).",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
          "title": "Assistant Id",
          "type": "string"
        },
        "input": {
          "description": "Prompt to send to the assistant.",
          "title": "Input",
          "type": "string"
        },
        "thread_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "new_thread": {
          "default": false,
          "description": "Create a thread if no thread_id is supplied.",
          "title": "New Thread",
          "type": "boolean"
        }
      },
      "required": [
        "assistant_id",
        "input"
      ],
      "title": "GriptapeCreateAssistantRunConfig",
      "type": "object"
    },
    "GriptapeCreateMessageConfig": {
      "additionalProperties": false,
      "description": "Store a conversation input and output pair in a thread.",
      "properties": {
        "operation": {
          "const": "create_message",
          "default": "create_message",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "thread_id": {
          "description": "Griptape resource UUID (version 4).",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
          "title": "Thread Id",
          "type": "string"
        },
        "input": {
          "description": "Stored user input.",
          "title": "Input",
          "type": "string"
        },
        "output": {
          "description": "Stored assistant response.",
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "thread_id",
        "input",
        "output"
      ],
      "title": "GriptapeCreateMessageConfig",
      "type": "object"
    },
    "GriptapeCreateStructureRunConfig": {
      "additionalProperties": false,
      "description": "Start a structure run; returns immediately and may incur provider charges.",
      "properties": {
        "operation": {
          "const": "create_structure_run",
          "default": "create_structure_run",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "structure_id": {
          "description": "Griptape resource UUID (version 4).",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
          "title": "Structure Id",
          "type": "string"
        },
        "args": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "default": "[]",
          "description": "JSON array of string arguments, for example [\"arg1\"].",
          "title": "Args",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "structure_id"
      ],
      "title": "GriptapeCreateStructureRunConfig",
      "type": "object"
    },
    "GriptapeCreateThreadConfig": {
      "additionalProperties": false,
      "description": "Create a named conversation thread.",
      "properties": {
        "operation": {
          "const": "create_thread",
          "default": "create_thread",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
