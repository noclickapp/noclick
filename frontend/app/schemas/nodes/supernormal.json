{
  "$defs": {
    "SupernormalAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "supernormal_api_key",
          "default": "supernormal_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "title": "Existing Scoped Supernormal API Token",
          "type": "string",
          "ui:widget": "password"
        },
        "scopes": {
          "description": "Enter only these scopes actually issued to the key. This is not an API scope-grant request; unknown scope requires issuer clarification.",
          "items": {
            "enum": [
              "user:read",
              "recordings:read",
              "calendar_events:read"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Actual Granted Read Scopes",
          "type": "array"
        },
        "expected_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional actual /user ID. If supplied, every operation refuses a different principal. Absence is unknown, not filled from the current app or a guessed account.",
          "title": "Expected User ID (if known)"
        }
      },
      "required": [
        "api_token",
        "scopes"
      ],
      "title": "Supernormal API Token",
      "type": "object",
      "x-credential-instructions": "Supply an already-issued Supernormal scoped API key and its actual granted read scopes. The fixed v1 API sends X-API-TOKEN, not Bearer/Basic. user:read is required for the real identity probe; add recordings:read or calendar_events:read only when issued for those operations. API entitlement is account-dependent and not verified here. No OAuth/global client or key creation is automated.",
      "x-credential-url": "https://app.supernormal.com/settings"
    },
    "SupernormalCalendarConfig": {
      "properties": {
        "operation": {
          "const": "list_upcoming_calendar_events",
          "default": "list_upcoming_calendar_events",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Calendar",
          "x-display-name": "List Upcoming Calendar Metadata",
          "x-is-trigger": false
        },
        "from_date": {
          "description": "Explicit timezone-aware bounded calendar window; sent as the documented from parameter.",
          "format": "date-time",
          "title": "From Date (ISO8601)",
          "type": "string"
        },
        "to_date": {
          "description": "Sent as to. Node window is at most31 days; this is a local privacy bound, not a claimed provider limit.",
          "format": "date-time",
          "title": "Through Date (ISO8601)",
          "type": "string"
        }
      },
      "required": [
        "from_date",
        "to_date"
      ],
      "title": "SupernormalCalendarConfig",
      "type": "object"
    },
    "SupernormalMcpCredential": {
      "description": "Supernormal connected through Supernormal's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "supernormal_mcp",
          "default": "supernormal_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "Supernormal MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://api.supernormal.com/mcp",
      "x-mcp-transport": "shttp"
    },
    "SupernormalRecordingConfig": {
      "properties": {
        "visibility": {
          "default": "all",
          "description": "Documented list filter. all may include organization/shared recordings; it is not a private-only flag. The direct get route uses provider access to the selected ID, not a fabricated visibility parameter.",
          "enum": [
            "all",
            "organization",
            "shared_with_me"
          ],
          "title": "Recording Picker Visibility",
          "type": "string"
        },
        "operation": {
          "const": "get_recording",
          "default": "get_recording",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Recordings",
          "x-display-name": "Get Selected Recording Metadata",
          "x-is-trigger": false
        },
        "recording_id": {
          "title": "Explicit Accessible Recording ID",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "auto_select_sole_option": false,
            "depends_on": "visibility",
            "field_name": "recording_id"
          },
          "x-resource-type": "recording_id"
        },
        "include_meeting_text": {
          "default": false,
          "description": "False returns metadata only. True includes documented summary/notes/meeting_summary, with links omitted and bounded text.",
          "title": "Include Meeting Summary and Notes",
          "type": "boolean"
        }
      },
      "required": [
        "recording_id"
      ],
      "title": "SupernormalRecordingConfig",
      "type": "object"
    },
    "SupernormalRecordingsConfig": {
      "properties": {
        "visibility": {
          "default": "all",
          "description": "Documented list filter. all may include organization/shared recordings; it is not a private-only flag. The direct get route uses provider access to the selected ID, not a fabricated visibility parameter.",
          "enum": [
            "all",
            "organization",
            "shared_with_me"
          ],
          "title": "Recording Picker Visibility",
          "type": "string"
        },
        "operation": {
          "const": "list_recordings",
          "default": "list_recordings",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Recordings",
          "x-display-name": "List Recording Metadata",
          "x-is-trigger": false
        },
        "page": {
          "default": 1,
          "description": "One page; subsequent numeric page comes only from meta.next_page. No page-size parameter is documented.",
          "maximum": 10000,
          "minimum": 1,
          "title": "Numeric Page",
          "type": "integer"
        },
        "include_meeting_text": {
          "default": false,
          "description": "Explicit opt-in to summary text; URLs are omitted and text remains bounded. Owner email/avatar is always omitted.",
          "title": "Include Meeting Summary",
          "type": "boolean"
        }
      },
      "title": "SupernormalRecordingsConfig",
      "type": "object"
    },
    "SupernormalTranscriptConfig": {
      "properties": {
        "visibility": {
          "default": "all",
          "description": "Documented list filter. all may include organization/shared recordings; it is not a private-only flag. The direct get route uses provider access to the selected ID, not a fabricated visibility parameter.",
          "enum": [
            "all",
            "organization",
            "shared_with_me"
          ],
          "title": "Recording Picker Visibility",
          "type": "string"
        },
        "operation": {
          "const": "get_transcript",
          "default": "get_transcript",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Recordings",
          "x-display-name": "Read Selected Recording Transcript",
          "x-is-trigger": false
        },
        "recording_id": {
          "title": "Explicit Accessible Recording ID",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "auto_select_sole_option": false,
            "depends_on": "visibility",
            "field_name": "recording_id"
          },
          "x-resource-type": "recording_id"
        },
        "include_text": {
          "default": false,
          "description": "False returns segment timing only. True deliberately returns bounded spoken content with links omitted.",
          "title": "Include Spoken Text",
          "type": "boolean"
        },
        "include_speaker_names": {
          "default": false,
          "description": "Explicit opt-in to original_speaker, assigned_speaker_name and author_name. None are returned by default.",
          "title": "Include Speaker Labels/Names",
          "type": "boolean"
        }
      },
      "required": [
        "recording_id"
      ],
      "title": "SupernormalTranscriptConfig",
      "type": "object"
    },
    "SupernormalUserConfig": {
      "properties": {
        "operation": {
          "const": "get_user",
          "default": "get_user",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Account",
          "x-display-name": "Get Verified User Identity",
          "x-is-trigger": false
        }
      },
      "title": "SupernormalUserConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_recording": "#/$defs/SupernormalRecordingConfig",
          "get_transcript": "#/$defs/SupernormalTranscriptConfig",
          "get_user": "#/$defs/SupernormalUserConfig",
          "list_recordings": "#/$defs/SupernormalRecordingsConfig",
          "list_upcoming_calendar_events": "#/$defs/SupernormalCalendarConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SupernormalUserConfig"
        },
        {
          "$ref": "#/$defs/SupernormalCalendarConfig"
        },
        {
          "$ref": "#/$defs/SupernormalRecordingsConfig"
        },
        {
          "$ref": "#/$defs/SupernormalRecordingConfig"
        },
        {
          "$ref": "#/$defs/SupernormalTranscriptConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/SupernormalAPITokenCredential"
        },
        {
          "$ref": "#/$defs/SupernormalMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "Supernormal Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Show my verified Supernormal user",
    "Read recording metadata without notes or signed links",
    "Read transcript segment timings for a selected recording"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
