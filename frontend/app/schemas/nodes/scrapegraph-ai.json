          "title": "Timeout Ms",
          "type": "integer"
        },
        "wait_ms": {
          "default": 0,
          "maximum": 30000,
          "minimum": 0,
          "title": "Wait Ms",
          "type": "integer"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional SGAI-Session-Id groups requests in history.",
          "title": "Session Id"
        },
        "operation": {
          "const": "search",
          "default": "search",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "maxLength": 500,
