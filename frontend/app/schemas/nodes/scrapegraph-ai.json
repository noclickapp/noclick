      "title": "Search",
      "type": "object"
    },
    "StartCrawl": {
      "additionalProperties": false,
      "description": "Start a bounded asynchronous crawl; poll get_crawl for progress.",
      "properties": {
        "fetch_mode": {
          "default": "auto",
          "description": "auto chooses the provider; js renders JavaScript.",
          "enum": [
            "auto",
            "fast",
            "js"
          ],
          "title": "Fetch Mode",
          "type": "string"
        },
        "timeout_ms": {
          "default": 60000,
          "maximum": 60000,
          "minimum": 1000,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "wait_ms": {
          "default": 0,
          "maximum": 30000,
          "minimum": 0,
          "title": "Wait Ms",
          "type": "integer"
        },
        "formats": {
          "description": "Requested output types. Screenshot output is a provider URL.",
          "items": {
            "enum": [
              "markdown",
              "html",
              "links",
              "images",
              "summary",
              "json",
              "branding",
              "screenshot"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        },
        "operation": {
          "const": "start_crawl",
          "default": "start_crawl",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "max_depth": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 2,
          "description": "Null allows unlimited depth within the page limit.",
          "title": "Max Depth"
        },
        "max_pages": {
          "default": 50,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "max_links_per_page": {
          "default": 10,
          "minimum": 1,
          "title": "Max Links Per Page",
          "type": "integer"
        },
        "allow_external": {
          "default": false,
          "title": "Allow External",
          "type": "boolean"
        },
        "include_patterns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Include Patterns"
        },
        "exclude_patterns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclude Patterns"
        }
      },
      "required": [
        "url"
      ],
      "title": "StartCrawl",
      "type": "object"
    },
    "StopCrawl": {
      "additionalProperties": false,
      "description": "Request a running crawl to stop; this is an acknowledgement.",
      "properties": {
        "crawl_id": {
          "description": "UUID returned by ScrapeGraphAI.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Crawl Id",
          "type": "string"
        },
        "operation": {
          "const": "stop_crawl",
          "default": "stop_crawl",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "crawl_id"
      ],
      "title": "StopCrawl",
      "type": "object"
    },
    "UpdateMonitor": {
      "additionalProperties": false,
      "description": "Change a monitor name, interval, output formats or notification destination.",
      "properties": {
        "monitor_id": {
          "description": "UUID returned by ScrapeGraphAI.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Monitor Id",
          "type": "string"
        },
        "operation": {
          "const": "update_monitor",
          "default": "update_monitor",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "interval": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval"
        },
        "formats": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "markdown",
                  "html",
                  "links",
                  "images",
                  "summary",
                  "json",
                  "branding",
                  "screenshot"
                ],
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formats"
        },
        "webhook_url": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url"
        },
        "clear_webhook": {
          "default": false,
          "description": "Send webhookUrl: null to remove the destination.",
          "title": "Clear Webhook",
          "type": "boolean"
        }
      },
      "required": [
        "monitor_id"
      ],
      "title": "UpdateMonitor",
      "type": "object"
    }
  },
