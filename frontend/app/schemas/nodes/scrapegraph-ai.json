{
  "$defs": {
    "CreateMonitor": {
      "additionalProperties": false,
      "description": "Create a recurring scrape. The provider bills scheduled runs.",
      "properties": {
        "fetch_mode": {
          "default": "auto",
          "description": "auto chooses the provider; js renders JavaScript.",
          "enum": [
            "auto",
            "fast",
            "js"
          ],
          "title": "Fetch Mode",
          "type": "string"
        },
        "timeout_ms": {
          "default": 60000,
          "maximum": 60000,
          "minimum": 1000,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "wait_ms": {
          "default": 0,
          "maximum": 30000,
          "minimum": 0,
          "title": "Wait Ms",
          "type": "integer"
        },
        "formats": {
          "description": "Requested output types. Screenshot output is a provider URL.",
          "items": {
            "enum": [
              "markdown",
              "html",
              "links",
              "images",
              "summary",
              "json",
              "branding",
              "screenshot"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        },
        "operation": {
          "const": "create_monitor",
          "default": "create_monitor",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "interval": {
          "description": "5-field cron expression, for example 0 */6 * * *.",
          "maxLength": 100,
          "minLength": 1,
          "title": "Interval",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "webhook_url": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional destination for provider change notifications.",
          "title": "Webhook Url"
        }
      },
      "required": [
        "url",
        "interval",
        "name"
      ],
      "title": "CreateMonitor",
      "type": "object"
    },
    "DeleteCrawl": {
      "additionalProperties": false,
      "description": "Delete the selected crawl.",
      "properties": {
        "crawl_id": {
          "description": "UUID returned by ScrapeGraphAI.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Crawl Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_crawl",
          "default": "delete_crawl",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "crawl_id"
      ],
      "title": "DeleteCrawl",
      "type": "object"
    },
    "DeleteMonitor": {
      "additionalProperties": false,
      "description": "Delete a monitor and stop its future scheduled runs.",
      "properties": {
        "monitor_id": {
          "description": "UUID returned by ScrapeGraphAI.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Monitor Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_monitor",
          "default": "delete_monitor",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "monitor_id"
      ],
      "title": "DeleteMonitor",
      "type": "object"
    },
    "Extract": {
      "additionalProperties": false,
      "description": "Extract structured JSON from exactly one URL, HTML or Markdown source.",
      "properties": {
        "fetch_mode": {
          "default": "auto",
          "description": "auto chooses the provider; js renders JavaScript.",
          "enum": [
            "auto",
            "fast",
            "js"
          ],
          "title": "Fetch Mode",
          "type": "string"
        },
        "timeout_ms": {
          "default": 60000,
          "maximum": 60000,
          "minimum": 1000,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "wait_ms": {
          "default": 0,
          "maximum": 30000,
          "minimum": 0,
          "title": "Wait Ms",
          "type": "integer"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional SGAI-Session-Id groups requests in history.",
          "title": "Session Id"
        },
        "operation": {
          "const": "extract",
          "default": "extract",
          "title": "Operation",
          "type": "string"
        },
        "prompt": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "html": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Html",
          "ui:widget": "textarea"
        },
        "markdown": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown",
          "ui:widget": "textarea"
        },
        "mode": {
          "default": "normal",
          "enum": [
            "normal",
            "reader",
            "prune"
          ],
          "title": "Mode",
          "type": "string"
        },
        "json_schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional JSON Schema object as JSON text.",
          "title": "Json Schema",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "Extract",
      "type": "object"
    },
    "GetAccount": {
      "additionalProperties": false,
      "description": "Validate the key and read its account email.",
      "properties": {
        "operation": {
          "const": "get_account",
          "default": "get_account",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetAccount",
      "type": "object"
    },
    "GetCrawl": {
      "additionalProperties": false,
      "description": "Read crawl status and the provider's current page summary.",
      "properties": {
        "crawl_id": {
          "description": "UUID returned by ScrapeGraphAI.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Crawl Id",
          "type": "string"
        },
        "operation": {
          "const": "get_crawl",
          "default": "get_crawl",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "crawl_id"
      ],
      "title": "GetCrawl",
      "type": "object"
    },
    "GetCredits": {
      "additionalProperties": false,
      "description": "Read remaining and used credits and crawl/monitor job limits.",
      "properties": {
        "operation": {
          "const": "get_credits",
          "default": "get_credits",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetCredits",
      "type": "object"
    },
    "GetHistory": {
      "additionalProperties": false,
      "description": "Read a single request, including its stored parameters and result.",
      "properties": {
        "operation": {
          "const": "get_history",
          "default": "get_history",
          "title": "Operation",
          "type": "string"
        },
        "history_id": {
          "description": "UUID returned by ScrapeGraphAI.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "History Id",
          "type": "string"
        }
      },
      "required": [
        "history_id"
      ],
      "title": "GetHistory",
      "type": "object"
    },
    "GetMonitor": {
      "additionalProperties": false,
      "description": "Read one monitor and its schedule configuration.",
      "properties": {
        "monitor_id": {
          "description": "UUID returned by ScrapeGraphAI.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Monitor Id",
          "type": "string"
        },
        "operation": {
          "const": "get_monitor",
          "default": "get_monitor",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "monitor_id"
      ],
      "title": "GetMonitor",
      "type": "object"
    },
    "GetMonitorActivity": {
      "additionalProperties": false,
      "description": "Read one page of monitor ticks; pass nextCursor to the next call.",
      "properties": {
        "monitor_id": {
          "description": "UUID returned by ScrapeGraphAI.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Monitor Id",
          "type": "string"
        },
        "operation": {
          "const": "get_monitor_activity",
          "default": "get_monitor_activity",
          "title": "Operation",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 timestamp returned as nextCursor.",
          "title": "Cursor"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "monitor_id"
      ],
      "title": "GetMonitorActivity",
      "type": "object"
    },
    "ListCrawlPages": {
      "additionalProperties": false,
      "description": "Read one page of crawl results using the provider's numeric cursor.",
      "properties": {
        "crawl_id": {
          "description": "UUID returned by ScrapeGraphAI.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Crawl Id",
          "type": "string"
        },
        "operation": {
          "const": "list_crawl_pages",
          "default": "list_crawl_pages",
          "title": "Operation",
          "type": "string"
        },
        "cursor": {
          "default": 0,
          "minimum": 0,
          "title": "Cursor",
          "type": "integer"
        },
        "limit": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "crawl_id"
      ],
      "title": "ListCrawlPages",
      "type": "object"
    },
    "ListHistory": {
      "additionalProperties": false,
      "description": "Read one page of this account's request history.",
      "properties": {
        "operation": {
          "const": "list_history",
          "default": "list_history",
          "title": "Operation",
          "type": "string"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "service": {
          "anyOf": [
            {
              "enum": [
                "scrape",
                "extract",
                "search",
                "monitor",
                "crawl"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service",
          "enum": [
            "scrape",
            "extract",
            "search",
            "monitor",
            "crawl"
          ],
          "x-enum-searchable": true
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        }
      },
      "title": "ListHistory",
      "type": "object"
    },
    "ListMonitors": {
      "additionalProperties": false,
      "description": "List this account's monitors (the API returns an unpaginated array).",
      "properties": {
        "operation": {
          "const": "list_monitors",
          "default": "list_monitors",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListMonitors",
      "type": "object"
    },
