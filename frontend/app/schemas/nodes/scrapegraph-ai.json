              "screenshot"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        }
      },
      "required": [
        "url"
      ],
      "title": "ScrapeURL",
      "type": "object"
    },
    "ScrapegraphAIAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "scrapegraph_ai_api_key",
          "default": "scrapegraph_ai_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
