        "fetch_mode": {
          "default": "auto",
          "description": "auto chooses the provider; js renders JavaScript.",
          "enum": [
            "auto",
            "fast",
            "js"
          ],
          "title": "Fetch Mode",
          "type": "string"
        },
        "timeout_ms": {
          "default": 60000,
