      "required": [
        "monitor_id"
      ],
      "title": "PauseMonitor",
      "type": "object"
    },
    "ResumeCrawl": {
      "additionalProperties": false,
      "description": "Request a paused crawl to resume; poll get_crawl for progress.",
      "properties": {
        "crawl_id": {
          "description": "UUID returned by ScrapeGraphAI.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Crawl Id",
          "type": "string"
        },
        "operation": {
          "const": "resume_crawl",
          "default": "resume_crawl",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "crawl_id"
      ],
      "title": "ResumeCrawl",
      "type": "object"
    },
    "ResumeMonitor": {
      "additionalProperties": false,
      "description": "Resume a paused monitor's scheduled ticks.",
      "properties": {
        "monitor_id": {
          "description": "UUID returned by ScrapeGraphAI.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Monitor Id",
          "type": "string"
        },
        "operation": {
          "const": "resume_monitor",
          "default": "resume_monitor",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "monitor_id"
      ],
      "title": "ResumeMonitor",
      "type": "object"
    },
    "ScrapeURL": {
      "additionalProperties": false,
