    "BokunAppTokenCredential": {
      "properties": {
        "environment": {
          "default": "sandbox",
          "description": "Use the environment belonging to this existing credential; the node never changes it automatically.",
          "enum": [
            "sandbox",
            "production"
          ],
          "title": "Environment",
          "type": "string"
        },
        "credential_type": {
          "const": "bokun_app_token",
          "default": "bokun_app_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "tenant": {
          "description": "The existing vendor's single subdomain label, without a URL or suffix.",
          "maxLength": 63,
          "minLength": 1,
          "title": "Vendor Tenant",
          "type": "string"
        },
        "access_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "App Access Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "tenant",
        "access_token"
      ],
      "title": "B\u00f3kun Existing App Token",
      "type": "object",
      "x-credential-instructions": "Supply an already issued App Store access token and its vendor tenant label. GraphQL uses X-Bokun-App-Access-Token on that tenant's host. Catalog reads require the actual PRODUCTS_READ grant; booking reads require BOOKINGS_READ. Installation/consent, callback verification, REST-secret retrieval and token issuance are not performed by this supplied-token method. Keep the token private; no token is sent in provider URLs or output.",
      "x-credential-url": "https://bokun.dev/"
    },
    "BokunRESTHMACCredential": {
      "properties": {
        "environment": {
          "default": "sandbox",
          "description": "Use the environment belonging to this existing credential; the node never changes it automatically.",
          "enum": [
            "sandbox",
            "production"
          ],
          "title": "Environment",
          "type": "string"
        },
        "credential_type": {
          "const": "bokun_rest_hmac",
          "default": "bokun_rest_hmac",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "REST Access Key",
          "type": "string",
          "ui:widget": "password"
        },
        "secret_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "REST Secret Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_key",
        "secret_key"
      ],
      "title": "B\u00f3kun REST HMAC Key Pair",
      "type": "object",
      "x-credential-instructions": "Existing direct REST key pair for B\u00f3kun's documented X-Bokun-Date/AccessKey/Signature HmacSHA1 scheme. The signature covers UTC date, access key, verb and encoded path including query. The current schema also documents direct key headers; choose the family actually enabled for your key. No automatic authentication fallback.",
      "x-credential-url": "https://bokun.dev/"
    },
    "BokunRESTKeysCredential": {
      "properties": {
        "environment": {
          "default": "sandbox",
