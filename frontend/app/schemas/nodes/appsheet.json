  "description": "Full configuration for the AppSheet node including credentials.",
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_rows": "#/$defs/AppSheetAddRowsConfig",
          "delete_rows": "#/$defs/AppSheetDeleteRowsConfig",
          "edit_rows": "#/$defs/AppSheetEditRowsConfig",
          "find_all_rows": "#/$defs/AppSheetFindAllRowsConfig",
          "find_rows": "#/$defs/AppSheetFindRowsConfig",
          "find_with_selector": "#/$defs/AppSheetFindWithSelectorConfig",
          "invoke_action": "#/$defs/AppSheetInvokeActionConfig",
          "on_data_change": "#/$defs/AppSheetOnDataChangeConfig",
          "on_rows_added": "#/$defs/AppSheetOnRowsAddedConfig",
          "on_rows_deleted": "#/$defs/AppSheetOnRowsDeletedConfig",
          "on_rows_updated": "#/$defs/AppSheetOnRowsUpdatedConfig",
          "on_schedule": "#/$defs/AppSheetOnScheduleConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AppSheetAddRowsConfig"
        },
        {
          "$ref": "#/$defs/AppSheetEditRowsConfig"
        },
        {
          "$ref": "#/$defs/AppSheetDeleteRowsConfig"
        },
        {
          "$ref": "#/$defs/AppSheetFindRowsConfig"
        },
        {
          "$ref": "#/$defs/AppSheetFindAllRowsConfig"
        },
        {
          "$ref": "#/$defs/AppSheetFindWithSelectorConfig"
        },
        {
          "$ref": "#/$defs/AppSheetInvokeActionConfig"
        },
        {
          "$ref": "#/$defs/AppSheetOnRowsAddedConfig"
        },
        {
          "$ref": "#/$defs/AppSheetOnRowsUpdatedConfig"
        },
        {
          "$ref": "#/$defs/AppSheetOnRowsDeletedConfig"
        },
        {
          "$ref": "#/$defs/AppSheetOnDataChangeConfig"
        },
        {
          "$ref": "#/$defs/AppSheetOnScheduleConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/AppSheetApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Appsheet Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Add a new row to the Orders table in AppSheet",
    "Edit a customer record by its key column",
    "Delete rows from a table when a deal is lost",
    "Find all rows where Age is at least 21 using a FILTER selector",
    "Trigger a workflow when an AppSheet bot posts a row-change webhook"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}