{
  "$defs": {
    "AppSheetAddRowsConfig": {
      "description": "Insert one or more new rows into a table.",
      "properties": {
        "operation": {
          "const": "add_rows",
          "default": "add_rows",
          "title": "Add Rows",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Rows",
          "x-display-name": "Add Rows",
          "x-is-trigger": false
        },
        "table_name": {
          "description": "Name of the table to add rows to (column names are case-sensitive)",
          "title": "Table Name",
          "type": "string"
        },
        "rows": {
          "description": "JSON array of row objects keyed by column name, e.g. [{\"FirstName\": \"Jane\", \"LastName\": \"Doe\"}]",
          "title": "Rows",
          "type": "string",
          "ui:widget": "textarea"
        },
        "run_as_user_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Execute as this app user so security filters / USEREMAIL() resolve correctly",
          "title": "Run As User Email"
        },
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Locale used to validate Date/Time/Decimal values, e.g. en-US",
          "title": "Locale"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timezone used to validate DateTime values, e.g. Pacific Standard Time",
          "title": "Timezone"
        }
      },
      "required": [
        "table_name",
        "rows"
      ],
      "title": "AppSheetAddRowsConfig",
      "type": "object"
    },
    "AppSheetApiKeyCredential": {
      "description": "Application Access Key credential for a single AppSheet app.",
      "properties": {
        "credential_type": {
          "const": "appsheet_api_key",
          "default": "appsheet_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "app_id": {
          "description": "The AppSheet app's unique identifier (shown in the editor URL). The access key is scoped to this app.",
          "title": "App ID",
          "type": "string"
        },
        "application_access_key": {
          "description": "Per-app key from Settings -> Integrations -> 'IN: from cloud services to your app' -> Create Application Access Key (looks like V2-...). Enterprise plan required.",
          "title": "Application Access Key",
          "type": "string",
          "ui:widget": "password"
        },
        "region": {
          "default": "global",
          "description": "Data-residency region of the app. EU/APAC apps must use their regional host.",
          "enum": [
            "global",
            "eu",
            "asia-southeast"
          ],
          "enumNames": [
            "Global (www.appsheet.com)",
            "EU (eu.appsheet.com)",
            "Asia-Pacific (asia-southeast.appsheet.com)"
          ],
          "title": "Region",
          "type": "string",
          "x-enum-searchable": true
        }
      },
      "required": [
        "app_id",
        "application_access_key"
      ],
      "title": "AppSheetApiKeyCredential",
      "type": "object",
      "x-credential-url": "https://support.google.com/appsheet/answer/10105769"
    },
