{
  "$defs": {
    "MatillionBearerTokenCredential": {
      "properties": {
        "region": {
          "description": "Select the actual account region. Current official OpenAPI lists EU1, US1 and AU1; hosts are fixed and never inferred from token claims.",
          "enum": [
            "eu1",
            "us1",
            "au1"
          ],
          "title": "Account Region",
          "type": "string"
        },
        "credential_type": {
          "const": "matillion_bearer_token",
          "default": "matillion_bearer_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "title": "Existing API Bearer Token",
          "type": "string",
          "ui:widget": "password"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only a known timezone-aware expiry. Issued API tokens last 30 minutes; no guessed mint time or JWT identity proof.",
          "title": "Actual Expiry (Optional)"
        }
      },
      "required": [
        "region",
        "access_token"
      ],
      "title": "Maia (Matillion) Bearer Token",
      "type": "object",
      "x-credential-instructions": "Supply an existing issued Maia/DPC API access token for this region. Exact Authorization: Bearer TOKEN. Token lifetime is 30 minutes; supply a new current token when needed. No token mint, refresh or environment fallback for this family. GitHub repository PATs are different credentials. Protected metadata reads do not prove execution privileges or account identity.",
      "x-credential-url": "https://docs.maia.ai/docs/api-reference/maia-api-authentication"
    },
