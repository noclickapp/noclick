          "default": "cancel_pipeline_execution",
          "title": "Cancel Scoped Pipeline Execution",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Execution Lifecycle",
          "x-display-name": "Cancel Scoped Pipeline Execution",
          "x-is-trigger": false
        },
        "force_termination": {
          "default": false,
          "description": "Forceful termination may leave partially completed external data effects. Default is graceful cancellation.",
          "title": "Force Termination",
          "type": "boolean"
        },
        "confirm_execution": {
          "default": false,
          "description": "Confirm cancellation of this exact owned execution. An acknowledgement does not establish completion or rolled-back data effects.",
          "title": "Confirm Execution",
          "type": "boolean"
        }
      },
      "required": [
        "project_id",
        "pipeline_execution_id"
      ],
      "title": "MatillionCancelConfig",
      "type": "object"
    },
