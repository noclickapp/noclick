    "RoezanSMSAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "roezan_sms_api_key",
          "default": "roezan_sms_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Roezan SMS API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Roezan account API key. NoClick sends it in the x-api-key header to app.roezan.com. The connection check reads your account's sending numbers.",
      "x-credential-url": "https://developer.roezan.com/docs"
    },
    "ScheduleBroadcast": {
      "additionalProperties": false,
      "description": "Confirm a draft's stored time, supply a new time, or explicitly send now.",
      "properties": {
        "broadcast_id": {
          "exclusiveMinimum": 0,
          "title": "Broadcast Id",
          "type": "integer"
        },
        "operation": {
          "const": "schedule_broadcast",
          "default": "schedule_broadcast",
          "title": "Operation",
          "type": "string"
        },
        "scheduled_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled Time"
        },
        "scheduled_timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled Timezone"
        },
        "send_now": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set true only to send immediately. Omit to use the draft's stored intent.",
