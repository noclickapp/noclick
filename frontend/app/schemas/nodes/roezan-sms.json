    "GetContactMessages": {
      "additionalProperties": false,
      "description": "Read one page of conversation history; pass next_cursor back unchanged.",
      "properties": {
        "contact_id": {
          "exclusiveMinimum": 0,
          "title": "Contact Id",
          "type": "integer"
        },
        "operation": {
          "const": "get_contact_messages",
          "default": "get_contact_messages",
          "title": "Operation",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "limit": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "conversation",
                "broadcast",
                "automation",
                "event_reminder",
                "bot",
                "keyword",
                "list_autoresponse",
                "activecampaign",
                "highlevel",
                "hubspot",
                "make",
                "zapier",
                "integration"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source",
          "enum": [
            "conversation",
            "broadcast",
            "automation",
            "event_reminder",
            "bot",
            "keyword",
            "list_autoresponse",
            "activecampaign",
            "highlevel",
            "hubspot",
            "make",
            "zapier",
            "integration"
          ],
          "x-enum-searchable": true
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "inbound",
                "outbound"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction",
          "enum": [
            "inbound",
            "outbound"
          ],
          "x-enum-searchable": true
        },
        "createdAtFrom": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Createdatfrom"
        },
        "createdAtTo": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Createdatto"
        }
      },
      "required": [
        "contact_id"
      ],
      "title": "GetContactMessages",
      "type": "object"
    },
    "ListFields": {
