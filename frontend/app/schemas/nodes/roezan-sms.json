{
  "$defs": {
    "AddContactTags": {
      "additionalProperties": false,
      "description": "Queue the addition of tags to a contact.",
      "properties": {
        "operation": {
          "const": "add_contact_tags",
          "default": "add_contact_tags",
          "title": "Operation",
          "type": "string"
        },
        "phone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Phone",
          "type": "string"
        },
        "tagIds": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Tagids",
          "type": "array"
        }
      },
      "required": [
        "phone",
        "tagIds"
      ],
      "title": "AddContactTags",
      "type": "object"
    },
    "CancelBroadcast": {
      "additionalProperties": false,
      "description": "Cancel a pending broadcast, reverting it to a draft.",
      "properties": {
        "broadcast_id": {
          "exclusiveMinimum": 0,
          "title": "Broadcast Id",
          "type": "integer"
        },
        "operation": {
          "const": "cancel_broadcast",
          "default": "cancel_broadcast",
          "title": "Operation",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        }
      },
      "required": [
        "broadcast_id"
      ],
      "title": "CancelBroadcast",
      "type": "object"
    },
    "CreateBroadcast": {
      "additionalProperties": false,
      "description": "Create a draft. This operation does not schedule or send the broadcast.",
      "properties": {
        "operation": {
          "const": "create_broadcast",
          "default": "create_broadcast",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "list_ids": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "List Ids",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "media": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media"
        },
        "scheduled_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional intended time stored on the draft, not a send request. Use YYYY-MM-DD HH:mm[:ss] or ISO date/time.",
          "title": "Scheduled Time"
        },
        "scheduled_timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IANA timezone; provider defaults to America/New_York.",
          "title": "Scheduled Timezone"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        }
      },
      "required": [
        "name",
        "list_ids",
        "message"
      ],
      "title": "CreateBroadcast",
      "type": "object"
    },
    "GetBroadcast": {
      "additionalProperties": false,
      "description": "Read status and delivery, reply and opt-out counts.",
      "properties": {
        "broadcast_id": {
          "exclusiveMinimum": 0,
          "title": "Broadcast Id",
          "type": "integer"
        },
        "operation": {
          "const": "get_broadcast",
          "default": "get_broadcast",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "broadcast_id"
      ],
      "title": "GetBroadcast",
      "type": "object"
    },
    "GetBroadcastRecipients": {
      "additionalProperties": false,
      "description": "Read one page of broadcast recipients and delivery results.",
      "properties": {
        "broadcast_id": {
          "exclusiveMinimum": 0,
          "title": "Broadcast Id",
          "type": "integer"
        },
        "operation": {
          "const": "get_broadcast_recipients",
          "default": "get_broadcast_recipients",
          "title": "Operation",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "limit": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "broadcast_id"
      ],
      "title": "GetBroadcastRecipients",
      "type": "object"
    },
    "GetContact": {
      "additionalProperties": false,
      "description": "Find a contact by phone, with email as a fallback.",
      "properties": {
        "operation": {
          "const": "get_contact",
          "default": "get_contact",
          "title": "Operation",
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
