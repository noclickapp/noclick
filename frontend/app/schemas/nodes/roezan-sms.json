        },
        "idempotency_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        }
      },
      "required": [
        "broadcast_id"
      ],
      "title": "ScheduleBroadcast",
      "type": "object"
    },
    "SendMessage": {
      "additionalProperties": false,
      "description": "Queue one SMS or MMS; acknowledgement does not confirm delivery.",
      "properties": {
        "phone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Phone",
          "type": "string"
        },
        "firstName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Firstname"
        },
        "lastName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastname"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "operation": {
          "const": "send_message",
          "default": "send_message",
          "title": "Operation",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "media": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media"
        },
        "countryCode": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Countrycode"
        },
        "from": {
          "anyOf": [
            {
              "pattern": "^\\+[1-9]\\d{1,14}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional sending number from list_senders, in E.164 format.",
          "title": "From"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unique per request. Reuse only for an identical retry within 24 hours.",
          "title": "Idempotency Key"
        }
      },
      "required": [
        "phone"
      ],
      "title": "SendMessage",
      "type": "object"
    },
