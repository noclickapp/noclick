    "CakemailOnComplianceConfig": {
      "properties": {
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "external_webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Webhook Id",
          "ui:hidden": true
        },
        "signing_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signing Secret",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_compliance_event",
          "default": "on_compliance_event",
          "title": "On Compliance Event",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-is-trigger": true
        },
        "event_type": {
          "default": "Email.Bounced",
          "enum": [
            "Email.Bounced",
            "Email.ReportedAsSpam",
            "Email.Unsubscribed",
            "Email.GlobalUnsubscribed",
            "Email.Rejected",
            "Email.Error",
            "Contact.Removed",
            "SuppressedEmail.Added"
          ],
          "title": "Event",
          "type": "string"
        }
      },
      "title": "CakemailOnComplianceConfig",
      "type": "object",
      "x-requires-webhook": true
    },
    "CakemailTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "cakemail_token",
          "default": "cakemail_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "title": "Personal access token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Cakemail Personal Access Token",
      "type": "object",
      "x-credential-instructions": "Paste a personal access token created with POST /users/self/pats. Grant the read/write scopes for the operations you use; triggers need webhooks:read and webhooks:write. Tokens are sent only to api.cakemail.dev.",
      "x-credential-url": "https://api.cakemail.dev/docs"
    },
