        "mapping": {
          "cancel_campaign": "#/$defs/CakemailCancelCampaignConfig",
          "create_campaign": "#/$defs/CakemailCreateCampaignConfig",
          "create_contact": "#/$defs/CakemailCreateContactConfig",
          "delete_contact": "#/$defs/CakemailDeleteContactConfig",
          "get_account": "#/$defs/CakemailGetAccountConfig",
          "get_campaign": "#/$defs/CakemailGetCampaignConfig",
          "get_campaign_stats": "#/$defs/CakemailGetCampaignStatsConfig",
          "get_contact": "#/$defs/CakemailGetContactConfig",
          "get_list": "#/$defs/CakemailGetListConfig",
          "get_template": "#/$defs/CakemailGetTemplateConfig",
          "list_campaigns": "#/$defs/CakemailListCampaignsConfig",
          "list_contacts": "#/$defs/CakemailListContactsConfig",
          "list_lists": "#/$defs/CakemailListListsConfig",
          "list_segments": "#/$defs/CakemailListSegmentsConfig",
          "list_senders": "#/$defs/CakemailListSendersConfig",
          "list_suppressed_emails": "#/$defs/CakemailListSuppressedEmailsConfig",
          "list_templates": "#/$defs/CakemailListTemplatesConfig",
          "on_compliance_event": "#/$defs/CakemailOnComplianceConfig",
          "unsubscribe_contact": "#/$defs/CakemailUnsubscribeContactConfig",
          "update_campaign": "#/$defs/CakemailUpdateCampaignConfig",
          "update_contact": "#/$defs/CakemailUpdateContactConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CakemailGetAccountConfig"
        },
        {
          "$ref": "#/$defs/CakemailListListsConfig"
        },
        {
          "$ref": "#/$defs/CakemailGetListConfig"
        },
        {
          "$ref": "#/$defs/CakemailListContactsConfig"
        },
        {
          "$ref": "#/$defs/CakemailCreateContactConfig"
        },
        {
          "$ref": "#/$defs/CakemailGetContactConfig"
        },
        {
          "$ref": "#/$defs/CakemailUpdateContactConfig"
        },
        {
          "$ref": "#/$defs/CakemailDeleteContactConfig"
        },
        {
          "$ref": "#/$defs/CakemailUnsubscribeContactConfig"
        },
        {
          "$ref": "#/$defs/CakemailListCampaignsConfig"
        },
        {
          "$ref": "#/$defs/CakemailGetCampaignConfig"
        },
        {
          "$ref": "#/$defs/CakemailCreateCampaignConfig"
        },
        {
          "$ref": "#/$defs/CakemailUpdateCampaignConfig"
        },
        {
          "$ref": "#/$defs/CakemailCancelCampaignConfig"
        },
        {
          "$ref": "#/$defs/CakemailListTemplatesConfig"
        },
        {
          "$ref": "#/$defs/CakemailGetTemplateConfig"
        },
        {
          "$ref": "#/$defs/CakemailListSendersConfig"
        },
        {
          "$ref": "#/$defs/CakemailGetCampaignStatsConfig"
        },
        {
          "$ref": "#/$defs/CakemailListSegmentsConfig"
        },
        {
          "$ref": "#/$defs/CakemailListSuppressedEmailsConfig"
        },
        {
          "$ref": "#/$defs/CakemailOnComplianceConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/CakemailTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Cakemail Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
