      "x-display-name": "Create external contact",
      "x-is-trigger": false,
      "x-operation-effect": "Creates a separate Cliniko external contact using only name/company/email fields. Does not create a patient, booking, treatment note or communication. POST is not retried; a later confirmation failure can leave a created record."
    },
