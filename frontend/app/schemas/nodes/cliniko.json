{
  "$defs": {
    "ArchiveContact": {
      "additionalProperties": false,
      "properties": {
        "contact_id": {
          "title": "External contact",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "contact_id",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "archive_contact",
          "default": "archive_contact",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "confirm_archive": {
          "const": true,
          "title": "Confirm archiving this external contact",
          "type": "boolean"
        }
      },
      "required": [
        "contact_id",
        "confirm_archive"
      ],
      "title": "ArchiveContact",
      "type": "object",
      "x-category": "External contacts",
      "x-display-name": "Archive external contact",
      "x-is-trigger": false,
      "x-operation-effect": "POST /archive returns bodyless 204, followed by a GET archive-status check. This archives an external contact; it does not delete a patient. The deprecated DELETE alias and undocumented unarchive are not used."
    },
    "ClinikoApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "cliniko_api_key",
          "default": "cliniko_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Issued Cliniko API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "admin_contact_email": {
          "description": "Sent in the required NoClick User-Agent contact header. Use an address where your integration administrator can be contacted.",
          "maxLength": 254,
          "title": "Application Administrator Contact",
          "type": "string"
        },
        "shard": {
          "default": "au1",
          "description": "Derived from the issued key suffix. Legacy keys without a suffix use documented au1.",
          "enum": [
            "au1",
            "au2",
            "au3",
            "au4",
            "au5",
            "ca1",
            "uk1",
            "uk2",
            "uk3",
            "us1",
            "eu1"
          ],
          "title": "Account shard",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "api_key",
        "admin_contact_email"
      ],
      "title": "ClinikoApiKeyCredential",
      "type": "object",
      "x-credential-instructions": "Create your user API key under My Info \u2192 Manage API keys. Paste the issued value only, retaining its shard suffix. Permissions match that user's current role. The key is the Basic username with an empty password; this is not a Bearer token or an OAuth flow. Supply an administrator contact for NoClick's required User-Agent.",
      "x-credential-url": "https://docs.api.cliniko.com/#authentication"
    },
