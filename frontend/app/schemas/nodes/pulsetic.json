  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_downtime": "#/$defs/GetDowntimeConfig",
          "get_heartbeat": "#/$defs/GetHeartbeatConfig",
          "get_monitor": "#/$defs/GetMonitorConfig",
          "get_stats": "#/$defs/GetStatsConfig",
