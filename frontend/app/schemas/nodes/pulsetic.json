{
  "$defs": {
    "GetDowntimeConfig": {
      "description": "Read the documented numeric downtime-in-seconds response, not an object wrapper.",
      "properties": {
        "include_names": {
          "default": false,
          "description": "Include monitor/heartbeat names or status-page titles. Names can disclose business resources.",
          "title": "Include Names",
          "type": "boolean"
        },
        "operation": {
          "const": "get_downtime",
          "default": "get_downtime",
          "title": "Operation",
          "type": "string"
        },
        "monitor_id": {
          "description": "Exact monitor ID. Enter an explicit ID or resolved workflow reference.",
          "maxLength": 19,
          "pattern": "^[1-9][0-9]{0,18}$",
          "title": "Monitor Id",
          "type": "string",
          "x-resource-type": "pulsetic_monitor_id"
        },
        "seconds": {
          "default": 3600,
          "description": "Documented seconds filter. Native maximum is 90 days; no provider maximum is inferred.",
          "maximum": 7776000,
          "minimum": 1,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "required": [
        "monitor_id"
      ],
      "title": "GetDowntimeConfig",
      "type": "object"
    },
    "GetHeartbeatConfig": {
