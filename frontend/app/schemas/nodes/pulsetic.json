    "PulseticAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "pulsetic_api_key",
          "default": "pulsetic_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Existing Pulsetic API key, sent as the raw Authorization header without Bearer. A read-only issued key supports GET; actual grants and entitlement are not inferred.",
          "title": "Api Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Pulsetic API Key",
      "type": "object",
      "x-credential-instructions": "Supply an existing API key, preferably one issued read-only. NoClick does not issue keys or assume their grants. Confirm your account's API entitlement separately; public documentation places API access on Team and above.",
      "x-credential-type": "pulsetic_api_key",
      "x-credential-url": "https://app.pulsetic.com/api"
    },
