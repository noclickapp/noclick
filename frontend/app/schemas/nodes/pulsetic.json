        "page": {
          "default": 1,
          "description": "One provider page; the native page-number cap is 1,000,000, not a documented provider maximum.",
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 20,
          "description": "Requested provider rows, with a local cap of 100. No loop, totals or completion are invented.",
