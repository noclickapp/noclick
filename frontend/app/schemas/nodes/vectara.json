{
  "$defs": {
    "VectaraAPIKeyCredential": {
      "additionalProperties": true,
      "properties": {
        "credential_type": {
          "const": "vectara_api_key",
          "default": "vectara_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "corpus_key": {
          "description": "Every operation is restricted to this existing or deliberately new corpus key.",
          "title": "Bound Corpus Key",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "corpus_key"
      ],
      "title": "Vectara API Key",
      "type": "object",
      "x-credential-instructions": "Supply an existing API key and its explicitly allowed corpus. Viewer/editor/API roles determine availability. No key creation, OAuth bootstrap or account identity is claimed.",
      "x-credential-url": "https://console.vectara.com"
    },
    "VectaraClientCredentials": {
      "additionalProperties": true,
      "properties": {
        "credential_type": {
          "const": "vectara_client_credentials",
          "default": "vectara_client_credentials",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "client_id": {
          "title": "Client ID",
          "type": "string"
        },
        "client_secret": {
          "title": "Client Secret",
          "type": "string",
          "ui:widget": "password"
        },
        "token_endpoint": {
          "description": "Select the exact official authentication URL shown for your existing app client. No automatic host fallback.",
          "enum": [
            "https://auth.vectara.io/oauth2/token",
            "https://auth.vectara.com/oauth2/token"
          ],
          "title": "Token Endpoint",
          "type": "string"
        },
        "corpus_key": {
          "description": "Every operation is restricted to this existing or deliberately new corpus key.",
          "title": "Bound Corpus Key",
          "type": "string"
        }
      },
      "required": [
        "client_id",
        "client_secret",
        "token_endpoint",
        "corpus_key"
      ],
      "title": "Vectara OAuth Client",
      "type": "object",
      "x-credential-instructions": "Supply an existing app client's ID, secret, exact official token endpoint and allowed corpus. The server obtains short-lived machine tokens; no browser consent or refresh token. The bound corpus read proves reachability, not account identity.",
      "x-credential-url": "https://console.vectara.com/console/apiAccess/appClients"
    },
    "VectaraCreateCorpusConfig": {
      "properties": {
        "corpus_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to the credential's bound corpus; another key is refused.",
          "title": "Corpus Key",
          "x-resource-type": "vectara_corpus_key"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
