        "description": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description",
          "ui:widget": "textarea"
        },
        "operation": {
          "const": "create_corpus",
          "default": "create_corpus",
          "description": "Create the credential-bound corpus key. Requires account creation permission and may consume account resources.",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Corpora",
          "x-display-name": "Create Bound Corpus",
          "x-is-trigger": false
        }
