  "$defs": {
    "CreateCustomerManagedKey": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_customer_managed_key",
          "default": "create_customer_managed_key",
          "description": "Creates a new customer managed key Asynchronous: poll the resource afterward.",
          "title": "Create Customer Managed Key",
          "type": "string",
          "ui:hidden": true
        },
        "region": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Region",
          "type": "string"
        },
        "name": {
          "description": "The name of the key (any UTF-8 characters with no trailing or leading whitespace).",
          "maxLength": 30,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "instance_type": {
          "enum": [
            "enterprise-db",
            "enterprise-ds"
          ],
          "maxLength": 1024,
          "minLength": 1,
          "title": "Instance Type",
          "type": "string"
        },
        "tenant_id": {
          "description": "Project ID",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "cloud_provider": {
          "enum": [
            "gcp",
            "aws",
            "azure"
          ],
          "maxLength": 1024,
          "minLength": 1,
          "title": "Cloud Provider",
          "type": "string"
        },
        "key_id": {
          "description": "Cloud KMS key ID, such as an AWS key ARN",
          "maxLength": 1024,
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        }
      },
      "required": [
        "region",
        "name",
        "instance_type",
        "tenant_id",
        "cloud_provider",
        "key_id"
      ],
      "title": "CreateCustomerManagedKey",
      "type": "object"
    },
    "CreateInstance": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_instance",
          "default": "create_instance",
