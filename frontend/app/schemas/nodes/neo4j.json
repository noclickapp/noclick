          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "enterprise-db",
            "enterprise-ds",
            "business-critical",
            "professional-db",
            "professional-ds",
            "free-db"
          ],
          "maxLength": 1024,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "tenant_id": {
          "description": "Project ID",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "source_instance_id": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The ID of the source instance when cloning.",
          "title": "Source Instance Id"
        },
        "source_snapshot_id": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An optional snapshot ID to create an instance from a specific snapshot. `source_instance_id` must also be provided. Note that the snapshot must be exportable in order to create a new instance with it.",
          "title": "Source Snapshot Id"
        },
        "cloud_provider": {
          "enum": [
            "gcp",
            "aws",
            "azure"
          ],
          "maxLength": 1024,
          "minLength": 1,
          "title": "Cloud Provider",
          "type": "string"
        },
        "customer_managed_key_id": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An optional customer managed key to be used for instance creation.",
          "title": "Customer Managed Key Id"
        },
        "vector_optimized": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An optional vector optimization configuration to be set during instance creation.",
          "title": "Vector Optimized"
        },
        "graph_analytics_plugin": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An optional graph analytics plugin configuration to be set during instance creation.",
          "title": "Graph Analytics Plugin"
        }
      },
      "required": [
        "version",
        "region",
        "memory",
        "name",
        "type",
        "tenant_id",
        "cloud_provider"
      ],
      "title": "CreateInstance",
      "type": "object"
