{
  "$defs": {
    "CreateApp": {
      "additionalProperties": false,
      "description": "Create an app; optionally assign it to this token.",
      "properties": {
        "operation": {
          "const": "create_app",
          "default": "create_app",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "assign_token": {
          "default": false,
          "description": "Assign the newly created app to the user token.",
          "title": "Assign Token",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateApp",
      "type": "object"
    },
    "CreateField": {
      "additionalProperties": false,
      "description": "Create a field using one of the documented field types.",
      "properties": {
        "table_id": {
          "description": "Table database ID from its Quickbase URL.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_]+$",
          "title": "Table Id",
          "type": "string"
        },
        "operation": {
          "const": "create_field",
          "default": "create_field",
          "title": "Operation",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "field_type": {
          "enum": [
            "text",
            "text-multiple-choice",
            "text-multi-line",
            "rich-text",
            "numeric",
            "currency",
            "rating",
            "percent",
            "multitext",
            "email",
            "url",
            "duration",
            "date",
            "datetime",
            "timestamp",
            "timeofday",
            "checkbox",
            "user",
            "multiuser",
            "address",
            "phone",
            "file"
          ],
          "title": "Field Type",
          "type": "string"
        },
        "field_help": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Help"
        }
      },
      "required": [
        "table_id",
        "label",
        "field_type"
      ],
      "title": "CreateField",
      "type": "object"
    },
    "CreateTable": {
      "additionalProperties": false,
