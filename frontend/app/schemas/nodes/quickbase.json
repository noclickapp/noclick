        "app_id": {
          "description": "An existing app assigned to this token. Find its ID in the app URL after /db/.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_]+$",
          "title": "Connection app ID",
          "type": "string"
        }
