        "user_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "User token",
          "type": "string",
          "ui:widget": "password"
        },
        "realm_hostname": {
          "description": "Your realm hostname, for example demo.quickbase.com, without https:// or a path.",
          "title": "Realm hostname",
          "type": "string"
