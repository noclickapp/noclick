{
  "$defs": {
    "CreatePrompt": {
      "description": "Save a reusable prompt in the connected project.",
      "properties": {
        "operation": {
          "const": "create_prompt",
          "default": "create_prompt",
          "title": "Operation",
          "type": "string"
        },
        "prompt": {
          "maxLength": 500000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "inputs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PromptInput"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs"
        },
        "return_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Prompt"
        },
        "optimize_prompt": {
          "default": true,
          "title": "Optimize Prompt",
          "type": "boolean"
        },
        "use_internet": {
          "default": false,
          "title": "Use Internet",
          "type": "boolean"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "CreatePrompt",
      "type": "object"
    },
    "DeletePrompt": {
      "description": "Delete the explicitly selected saved prompt.",
      "properties": {
        "operation": {
          "const": "delete_prompt",
          "default": "delete_prompt",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeletePrompt",
      "type": "object"
    },
    "DetectObjects": {
      "description": "Detect objects in an image; annotated images are returned as URLs.",
      "properties": {
        "operation": {
          "const": "detect_objects",
          "default": "detect_objects",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "prompts": {
          "anyOf": [
            {
              "items": {
                "maxLength": 150,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompts"
        },
        "features": {
          "items": {
            "enum": [
              "object_detection",
              "object",
              "gui"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "annotated_image": {
          "default": false,
          "title": "Annotated Image",
          "type": "boolean"
        }
      },
      "required": [
        "url"
      ],
      "title": "DetectObjects",
      "type": "object"
    },
    "Embedding": {
      "description": "Generate a text embedding with the v1 embedding endpoint.",
      "properties": {
        "operation": {
          "const": "create_embedding",
          "default": "create_embedding",
          "title": "Operation",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "default": "text",
          "enum": [
            "text",
            "text-other"
          ],
          "title": "Type",
          "type": "string"
        },
        "dimensions": {
          "default": 4096,
          "maximum": 4096,
          "minimum": 32,
          "title": "Dimensions",
          "type": "integer"
        },
        "query": {
          "default": false,
          "title": "Query",
          "type": "boolean"
        },
        "token_overflow_mode": {
          "default": "error",
          "enum": [
            "truncate",
            "error"
          ],
          "title": "Token Overflow Mode",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Embedding",
      "type": "object"
    },
    "JigsawstackAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "jigsawstack_api_key",
          "default": "jigsawstack_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Jigsawstack API Key",
      "type": "object",
      "x-credential-instructions": "Paste your project's secret API key from the JigsawStack dashboard. NoClick sends it in x-api-key to api.jigsawstack.com. Listing saved prompts checks project access; AI operations consume your JigsawStack credits.",
      "x-credential-url": "https://jigsawstack.com/dashboard"
    },
    "ListPrompts": {
      "description": "Read one page of prompts saved in the connected project.",
      "properties": {
        "operation": {
          "const": "list_prompts",
          "default": "list_prompts",
          "title": "Operation",
          "type": "string"
        },
        "limit": {
          "default": 30,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "title": "ListPrompts",
      "type": "object"
    },
    "OCR": {
      "description": "Extract text or structured fields from an image or document URL.",
      "properties": {
        "operation": {
          "const": "extract_document",
          "default": "extract_document",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "fine_grained": {
          "default": false,
          "title": "Fine Grained",
          "type": "boolean"
        },
        "return_bounds": {
          "default": true,
          "title": "Return Bounds",
          "type": "boolean"
        }
      },
      "required": [
        "url"
      ],
      "title": "OCR",
      "type": "object"
    },
    "Profanity": {
      "description": "Detect profanity and return censored text.",
      "properties": {
        "operation": {
          "const": "check_profanity",
          "default": "check_profanity",
          "title": "Operation",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "censor_replacement": {
          "default": "*",
          "title": "Censor Replacement",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Profanity",
      "type": "object"
    },
    "PromptInput": {
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "initial_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Value"
        }
      },
      "required": [
        "key"
      ],
      "title": "PromptInput",
      "type": "object"
    },
    "RunPrompt": {
      "description": "Run one saved prompt with non-streaming string inputs.",
      "properties": {
        "operation": {
          "const": "run_prompt",
          "default": "run_prompt",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "input_values": {
          "anyOf": [
            {
              "additionalProperties": {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Values"
        }
      },
      "required": [
        "id"
      ],
      "title": "RunPrompt",
      "type": "object"
    },
    "Scrape": {
      "description": "Extract requested elements from a web page.",
      "properties": {
        "operation": {
          "const": "scrape_page",
          "default": "scrape_page",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "element_prompts": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Element Prompts",
          "type": "array"
        },
        "root_element_selector": {
          "default": "main",
          "title": "Root Element Selector",
          "type": "string"
        },
        "scroll": {
          "default": false,
          "title": "Scroll",
          "type": "boolean"
        }
      },
      "required": [
        "url",
        "element_prompts"
      ],
      "title": "Scrape",
      "type": "object"
    },
    "Search": {
      "description": "Search the web; returns a single bounded provider result set.",
      "properties": {
        "operation": {
          "const": "search_web",
          "default": "search_web",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "max_results": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Results",
          "type": "integer"
        },
        "safe_search": {
          "default": "moderate",
          "enum": [
            "strict",
            "moderate",
            "off"
          ],
          "title": "Safe Search",
          "type": "string"
        },
        "spell_check": {
          "default": true,
          "title": "Spell Check",
          "type": "boolean"
        },
        "ai_overview": {
          "default": true,
          "title": "Ai Overview",
          "type": "boolean"
        },
        "auto_scrape": {
          "default": false,
          "title": "Auto Scrape",
          "type": "boolean"
        }
      },
      "required": [
        "query"
      ],
      "title": "Search",
      "type": "object"
    },
    "Sentiment": {
      "description": "Analyze the sentiment of text.",
      "properties": {
        "operation": {
          "const": "analyze_sentiment",
          "default": "analyze_sentiment",
          "title": "Operation",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Sentiment",
      "type": "object"
    },
    "Spam": {
      "description": "Check text for spam.",
      "properties": {
        "operation": {
          "const": "check_spam",
          "default": "check_spam",
          "title": "Operation",
          "type": "string"
        },
        "text": {
          "maxLength": 5000,
          "minLength": 5,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Spam",
      "type": "object"
    },
    "Spelling": {
      "description": "Check text spelling in a language.",
      "properties": {
        "operation": {
          "const": "check_spelling",
          "default": "check_spelling",
          "title": "Operation",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "language_code": {
          "default": "en",
          "title": "Language Code",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Spelling",
      "type": "object"
    },
    "Suggest": {
      "description": "Get web-search suggestions for a query.",
      "properties": {
        "operation": {
          "const": "suggest_search",
          "default": "suggest_search",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "Suggest",
      "type": "object"
    },
    "TextToSQL": {
      "description": "Generate SQL from a prompt; does not execute the SQL.",
      "properties": {
        "operation": {
          "const": "generate_sql",
          "default": "generate_sql",
          "title": "Operation",
          "type": "string"
        },
        "prompt": {
          "minLength": 10,
          "title": "Prompt",
          "type": "string"
        },
        "sql_schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sql Schema"
        },
        "database": {
          "anyOf": [
            {
              "enum": [
                "postgresql",
                "mysql",
                "sqlite"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Database",
          "enum": [
            "postgresql",
            "mysql",
            "sqlite"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "prompt"
      ],
      "title": "TextToSQL",
      "type": "object"
    },
    "Transcribe": {
      "description": "Synchronously transcribe an audio/video URL without streaming or a webhook.",
      "properties": {
        "operation": {
          "const": "transcribe_audio",
          "default": "transcribe_audio",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "by_speaker": {
          "default": false,
          "title": "By Speaker",
          "type": "boolean"
        },
        "word_timestamps": {
          "default": false,
          "title": "Word Timestamps",
          "type": "boolean"
        },
        "translate": {
          "default": false,
          "title": "Translate",
          "type": "boolean"
        }
      },
      "required": [
        "url"
      ],
      "title": "Transcribe",
      "type": "object"
    },
