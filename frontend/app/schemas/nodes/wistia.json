{
  "$defs": {
    "CopyMedia": {
      "additionalProperties": false,
      "description": "Copy media and assets. Wistia may fall back to the original folder if the target is invalid.",
      "properties": {
        "media_id": {
          "description": "Wistia media hashed ID, not its numeric ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Media Id",
          "type": "string"
        },
        "operation": {
          "const": "copy_media",
          "default": "copy_media",
          "title": "Operation",
          "type": "string"
        },
        "folder_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Destination numeric folder ID; omitted uses source folder.",
          "title": "Folder Id"
        }
      },
      "required": [
        "media_id"
      ],
      "title": "CopyMedia",
      "type": "object"
    },
    "CreateCaptions": {
      "additionalProperties": false,
      "description": "Create captions from SRT text; omit language to let Wistia detect it.",
      "properties": {
        "media_id": {
          "description": "Wistia media hashed ID, not its numeric ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Media Id",
          "type": "string"
        },
        "operation": {
          "const": "create_captions",
          "default": "create_captions",
          "title": "Operation",
          "type": "string"
        },
        "caption_file": {
          "description": "SRT file contents, not a file path or URL.",
          "maxLength": 1000000,
          "minLength": 1,
          "title": "Caption File",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "pattern": "^[a-z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO-639-2 three-letter language code.",
          "title": "Language"
        }
      },
      "required": [
        "media_id",
        "caption_file"
      ],
      "title": "CreateCaptions",
      "type": "object"
    },
    "CreateFolder": {
      "additionalProperties": false,
      "description": "Create a private folder with anonymous uploads and downloads disabled.",
      "properties": {
        "operation": {
          "const": "create_folder",
          "default": "create_folder",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 50000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateFolder",
      "type": "object"
    },
    "CreateTag": {
      "additionalProperties": false,
      "description": "Create a tag; Wistia lowercases and normalizes whitespace in the name.",
      "properties": {
        "operation": {
          "const": "create_tag",
          "default": "create_tag",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateTag",
      "type": "object"
    },
    "DeleteFolder": {
      "additionalProperties": false,
      "description": "Delete a folder AND all media inside it.",
      "properties": {
        "folder_id": {
          "description": "Wistia folder hashed ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Folder Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_folder",
          "default": "delete_folder",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "folder_id"
      ],
      "title": "DeleteFolder",
      "type": "object"
    },
    "DeleteMedia": {
      "additionalProperties": false,
      "description": "Move a media to Recently Deleted; this does not prove permanent purging.",
      "properties": {
        "media_id": {
          "description": "Wistia media hashed ID, not its numeric ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Media Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_media",
          "default": "delete_media",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "media_id"
      ],
      "title": "DeleteMedia",
      "type": "object"
    },
    "DeleteTag": {
      "additionalProperties": false,
      "description": "Delete an account tag by its name.",
      "properties": {
        "operation": {
          "const": "delete_tag",
          "default": "delete_tag",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "DeleteTag",
      "type": "object"
    },
    "GetAccount": {
      "additionalProperties": false,
      "description": "Get the current account's name, URL and record counts.",
      "properties": {
        "operation": {
          "const": "get_account",
          "default": "get_account",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetAccount",
      "type": "object"
    },
    "GetFolder": {
      "additionalProperties": false,
      "description": "Read a folder and its media link without following the link.",
      "properties": {
        "folder_id": {
          "description": "Wistia folder hashed ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Folder Id",
          "type": "string"
        },
        "operation": {
          "const": "get_folder",
          "default": "get_folder",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "folder_id"
      ],
      "title": "GetFolder",
      "type": "object"
    },
    "GetJob": {
      "additionalProperties": false,
      "description": "Read the status of a background import or other asynchronous job.",
      "properties": {
        "operation": {
          "const": "get_job",
          "default": "get_job",
          "title": "Operation",
          "type": "string"
        },
        "job_id": {
          "description": "Prefer the job's hashed_id returned by import_media.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetJob",
      "type": "object"
    },
    "GetMedia": {
      "additionalProperties": false,
      "description": "Fetch a media's metadata and processing status.",
      "properties": {
        "media_id": {
          "description": "Wistia media hashed ID, not its numeric ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Media Id",
          "type": "string"
        },
        "operation": {
          "const": "get_media",
          "default": "get_media",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "media_id"
      ],
      "title": "GetMedia",
      "type": "object"
    },
    "GetMediaStats": {
      "additionalProperties": false,
      "description": "Read aggregated embed statistics for a media.",
      "properties": {
        "media_id": {
          "description": "Wistia media hashed ID, not its numeric ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Media Id",
          "type": "string"
        },
        "operation": {
          "const": "get_media_stats",
          "default": "get_media_stats",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "media_id"
      ],
      "title": "GetMediaStats",
      "type": "object"
    },
    "GetToken": {
      "additionalProperties": false,
      "description": "Inspect the current token's permissions without returning its secret value.",
      "properties": {
        "operation": {
          "const": "get_token",
          "default": "get_token",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetToken",
      "type": "object"
    },
    "ImportMedia": {
      "additionalProperties": false,
      "description": "Queue a media import from a publicly accessible URL; poll the returned job separately.",
      "properties": {
        "operation": {
          "const": "import_media",
          "default": "import_media",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "description": "Public HTTPS media file URL. Wistia fetches the file.",
          "maxLength": 4096,
          "title": "Url",
          "type": "string"
        },
        "folder_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Destination folder hashed ID; omitted creates a new folder.",
          "title": "Folder Id"
        }
      },
      "required": [
        "url"
      ],
      "title": "ImportMedia",
      "type": "object"
    },
    "ListCaptions": {
      "additionalProperties": false,
      "description": "List the caption tracks on a media.",
      "properties": {
        "media_id": {
          "description": "Wistia media hashed ID, not its numeric ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Media Id",
          "type": "string"
        },
        "operation": {
          "const": "list_captions",
          "default": "list_captions",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "media_id"
      ],
      "title": "ListCaptions",
      "type": "object"
    },
    "ListFolders": {
      "additionalProperties": false,
      "description": "List folders in the connected account.",
      "properties": {
        "page": {
          "default": 1,
          "description": "Explicit page number. Lists return one page only.",
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "operation": {
          "const": "list_folders",
          "default": "list_folders",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListFolders",
      "type": "object"
    },
    "ListMedia": {
      "additionalProperties": false,
      "description": "List or find media by exact name, folder, type or archive status.",
      "properties": {
        "page": {
          "default": 1,
          "description": "Explicit page number. Lists return one page only.",
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "operation": {
          "const": "list_media",
          "default": "list_media",
          "title": "Operation",
          "type": "string"
        },
        "folder_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Folder hashed ID.",
          "title": "Folder Id"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "Video",
                "Audio",
                "Image",
                "PdfDocument",
                "MicrosoftOfficeDocument",
                "Swf",
                "UnknownType"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type",
          "enum": [
            "Video",
            "Audio",
            "Image",
            "PdfDocument",
            "MicrosoftOfficeDocument",
            "Swf",
            "UnknownType"
          ],
          "x-enum-searchable": true
        },
        "archived": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archived"
        },
        "sort_by": {
          "anyOf": [
            {
              "enum": [
                "name",
                "created",
                "updated",
                "position"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort By",
          "enum": [
            "name",
            "created",
            "updated",
            "position"
          ],
          "x-enum-searchable": true
        },
        "sort_direction": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort Direction"
        }
      },
      "title": "ListMedia",
      "type": "object"
    },
    "ListTags": {
      "additionalProperties": false,
      "description": "List account tags and their usage counts.",
      "properties": {
        "page": {
          "default": 1,
          "description": "Explicit page number. Lists return one page only.",
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "operation": {
          "const": "list_tags",
          "default": "list_tags",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListTags",
      "type": "object"
    },
    "OnNewMedia": {
      "description": "Watch new media; the first poll records existing media without firing.\n\nMonitors up to 2,000 media per scope; choose a folder for larger libraries.",
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_media",
          "default": "on_new_media",
          "title": "Operation",
          "type": "string",
          "x-category": "Triggers",
          "x-display-name": "On New Media",
          "x-is-trigger": true
        },
        "folder_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional folder hashed ID to monitor.",
          "title": "Folder Id"
        }
      },
      "title": "OnNewMedia",
      "type": "object",
      "x-requires-webhook": true
    },
