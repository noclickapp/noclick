    "KontentAiAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "kontent_ai_api_key",
          "default": "kontent_ai_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "environment_id": {
          "description": "The environment UUID from Kontent.ai API keys.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Environment ID",
          "type": "string"
        },
        "api_key": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Management API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "environment_id",
        "api_key"
      ],
      "title": "Kontent.ai Management API Key",
      "type": "object",
      "x-credential-instructions": "In Kontent.ai, open your environment's API keys and copy a Management API key and the environment ID. Paste the key without the Bearer prefix. The key must permit the operations you use. NoClick reads environment information to verify this connection. Replace expired keys manually.",
      "x-credential-url": "https://app.kontent.ai/"
    },
