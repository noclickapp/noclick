    "LeexiGetCallConfig": {
      "additionalProperties": false,
      "description": "Get call. Getting a single call or meeting. This returns the same attributes as the [LIST calls](/reference/list-calls) endpoint with additionally the call topics and the call transcript. The simple_transcript has paragraph-level timestamps, while the transcript also has word-level timestamps. The call must be within the API key's access scope, otherwise the endpoint responds with 404.",
      "properties": {
        "operation": {
          "const": "get_call",
          "default": "get_call",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "uuid": {
          "description": "",
          "title": "Uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid"
      ],
      "title": "LeexiGetCallConfig",
      "type": "object"
    },
