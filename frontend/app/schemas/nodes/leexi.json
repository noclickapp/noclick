    "LeexiDeactivateUserConfig": {
      "additionalProperties": false,
      "description": "Deactivate a user. Deactivate a user. Users are never permanently deleted: their calls and history are kept, their sessions are revoked and they stop consuming a license. Reactivate them with a `PATCH` setting `active` to `true`.",
