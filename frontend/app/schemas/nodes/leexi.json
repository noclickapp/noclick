    "LeexiListCallNotesConfig": {
      "additionalProperties": false,
      "description": "List call notes. List call notes for a given call. `call_uuid` is required. You can optionally filter by `prompt_uuid`. Only call notes generated from prompts in the `summary` or `text` categories are returned. The call must be within the API key's access scope, otherwise no notes are returned.",
      "properties": {
        "operation": {
          "const": "list_call_notes",
          "default": "list_call_notes",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "page": {
          "default": 1,
          "description": "",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "items": {
          "default": 10,
          "description": "",
          "maximum": 100,
          "minimum": 1,
          "title": "Items",
          "type": "integer"
        },
        "call_uuid": {
          "description": "",
          "title": "Call Uuid",
          "type": "string"
        },
        "prompt_uuid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "",
          "title": "Prompt Uuid"
        }
      },
      "required": [
        "call_uuid"
      ],
      "title": "LeexiListCallNotesConfig",
      "type": "object"
    },
    "LeexiListCallsConfig": {
