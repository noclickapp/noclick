{
  "$defs": {
    "LeexiCreateCallConfig": {
      "additionalProperties": false,
      "description": "Create a call. Create a call or meeting asynchronously (creation time is typically a few minutes). You must first finish uploading the recording of the call using a presigned recording url retrieved with the [Request a presigned url](/reference/request-a-presigned-url) endpoint. Use the [LIST users](/reference/list-users) endpoint to find the user_uuid to use in this request.",
      "properties": {
        "operation": {
          "const": "create_call",
          "default": "create_call",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "custom_fields": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-form key/value pairs stored on the call and returned as-is by the [LIST calls](/reference/list-calls) and [GET call](/reference/get-call) endpoints. Only for custom integrations agreed with Leexi: the keys and their meaning must be defined with the Leexi team beforehand, otherwise the values are stored but never used. Values must be scalars (string, number, boolean or null).",
          "title": "Custom Fields"
        },
        "customers": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/LeexiCustomer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The external participants (customers) of the call. An array of objects, each accepting any of `name`, `email`, `phone_number` and `uuid` (only one attribute is required per object). When `uuid` is set it links an existing customer and the other attributes are ignored; unknown uuids are skipped. The provided names are used to help identify the speakers in the transcript. Prefer this over the deprecated `emails` and `raw_phone_number` params. \u26a0\ufe0f Cannot be combined with the deprecated `emails` or `raw_phone_number` params in the same request (returns a 400).",
          "title": "Customers"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "",
          "title": "Description"
        },
        "direction": {
          "description": "inbound or outbound",
          "title": "Direction",
          "type": "string"
        },
        "external_id": {
          "description": "the id of the call in your system",
          "title": "External Id",
          "type": "string"
        },
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fr-FR en-US de-DE es-ES nl-NL ar-AE da-DK hi-IN id-ID it-IT ja-JP ko-KR nb-NO pl-PL pt-PT ru-RU sv-SE tr-TR uk-UA zh-CN fr-CA he-IL th-TH bg-BG cs-CZ el-GR et-EE fi-FI hr-HR hu-HU lt-LT lv-LV ro-RO vi-VN en-AU en-GB en-NZ en-IN ca-ES",
          "title": "Locale"
        },
        "participating_user_uuids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "uuids of fellow Leexi users participating in the call (in addition to the owner set via `user_uuid`). Use the [LIST users](/reference/list-users) endpoint to find them. \u26a0\ufe0f Cannot be combined with the deprecated `emails` or `raw_phone_number` params in the same request (returns a 400).",
          "title": "Participating User Uuids"
        },
        "performed_at": {
          "description": "iso8601 format",
          "title": "Performed At",
          "type": "string"
        },
        "recording_s3_key": {
          "description": "the recording_s3_key returned by the [Request a presigned url](/reference/request-a-presigned-url) endpoint",
          "title": "Recording S3 Key",
          "type": "string"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "an array of tag names",
          "title": "Tags"
        },
        "title": {
          "default": "Meeting XYZ",
          "description": "The title of the call or meeting",
          "title": "Title",
          "type": "string"
        },
        "user_uuid": {
          "description": "The uuid of the user associated to the call, must have an active license.",
          "title": "User Uuid",
          "type": "string"
        }
      },
      "required": [
        "direction",
        "external_id",
        "performed_at",
        "recording_s3_key",
        "user_uuid"
      ],
      "title": "LeexiCreateCallConfig",
      "type": "object"
    },
    "LeexiCreateTeamConfig": {
      "additionalProperties": false,
      "description": "Create a team. Create a team in your workspace. The team inherits your company settings and gets the default email templates.",
      "properties": {
        "operation": {
          "const": "create_team",
          "default": "create_team",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to `true` on creation. A team can only be deactivated once it has no active users.",
          "title": "Active"
        },
        "name": {
          "description": "The team name. It must be unique within your workspace.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "LeexiCreateTeamConfig",
      "type": "object"
    },
    "LeexiCreateUserConfig": {
      "additionalProperties": false,
      "description": "Create a user. Create a user in your workspace. The user receives a welcome email with a link to set their password, unless `send_welcome_email` is `false`.",
      "properties": {
        "operation": {
          "const": "create_user",
          "default": "create_user",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to `true` on creation. Set to `false` to deactivate the user.",
          "title": "Active"
        },
        "email": {
          "description": "The user's email address. It must be deliverable and not already used in any Leexi company.",
          "title": "Email",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Either `free` or your company's own license category. Any other value is ignored.",
          "title": "License"
        },
        "name": {
          "description": "The user's full name.",
          "title": "Name",
          "type": "string"
        },
        "roles": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Role names. Defaults to `[\"member\"]` on creation. Privileged roles (`super_admin`, `system_admin`, `billing_manager`) cannot be assigned through the API; grant them from Leexi > Settings > Users.",
          "title": "Roles"
        },
        "send_welcome_email": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to `true`. Set to `false` to create the user without sending them the welcome email.",
          "title": "Send Welcome Email"
        },
        "team_uuid": {
          "description": "The uuid of the team the user belongs to.",
          "title": "Team Uuid",
          "type": "string"
        }
      },
      "required": [
        "email",
        "name",
        "team_uuid"
      ],
      "title": "LeexiCreateUserConfig",
      "type": "object"
    },
    "LeexiCredential": {
      "properties": {
        "credential_type": {
          "const": "leexi_api_key",
          "default": "leexi_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key_signature": {
          "minLength": 1,
          "title": "API key signature",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key_signature"
      ],
      "title": "Leexi API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Leexi API key signature, without the Basic prefix. Enable read_teams for the connection check and the read/write permissions needed by your operations. NoClick sends Authorization: Basic followed by this signature.",
      "x-credential-url": "https://app.leexi.ai/settings/integrations"
    },
