          "default": 1,
          "description": "Page to read; use next_page from the previous response.",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 100,
          "maximum": 500,
          "minimum": 25,
          "title": "Page Size",
          "type": "integer"
