          "default": null,
          "title": "Booted"
        },
        "private_ip": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Private Ip"
        },
        "backups_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enrolling in backups incurs an additional charge.",
          "title": "Backups Enabled"
        }
