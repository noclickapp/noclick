{
  "$defs": {
    "BootInstance": {
      "additionalProperties": false,
      "description": "Start booting an instance; completion is asynchronous.",
      "properties": {
        "operation": {
          "const": "boot_instance",
          "default": "boot_instance",
          "title": "Operation",
          "type": "string"
        },
        "linode_id": {
          "exclusiveMinimum": 0,
          "title": "Linode Id",
          "type": "integer"
        },
        "config_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Id"
        }
      },
      "required": [
        "linode_id"
      ],
      "title": "BootInstance",
      "type": "object"
    },
    "CreateDomain": {
      "additionalProperties": false,
      "description": "Create a primary DNS zone for a domain you own.",
      "properties": {
        "operation": {
          "const": "create_domain",
          "default": "create_domain",
          "title": "Operation",
          "type": "string"
        },
        "domain": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "type": {
          "const": "master",
          "default": "master",
          "title": "Type",
          "type": "string"
        },
        "soa_email": {
          "format": "email",
          "title": "Soa Email",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 253,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "ttl_sec": {
          "anyOf": [
            {
              "maximum": 2419200,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttl Sec"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        }
      },
      "required": [
        "domain",
        "soa_email"
      ],
      "title": "CreateDomain",
      "type": "object"
    },
    "CreateInstance": {
      "additionalProperties": false,
      "description": "Create a billable Linode, optionally deploying an image.",
