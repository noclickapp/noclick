        "operation": {
          "const": "create_instance",
          "default": "create_instance",
          "title": "Operation",
          "type": "string"
        },
        "region": {
          "description": "Region ID from List Regions, such as us-east.",
          "maxLength": 255,
          "minLength": 1,
          "title": "Region",
          "type": "string"
        },
        "type": {
          "description": "Plan ID from List Types, such as g6-standard-2. Creation incurs provider charges.",
          "maxLength": 255,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Image ID from List Images; omit for an empty instance.",
          "title": "Image"
        },
        "root_pass": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 7,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when deploying an image under this API contract.",
          "title": "Root Pass",
          "ui:widget": "password",
          "writeOnly": true
        },
        "authorized_keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public SSH keys to install when deploying an image.",
          "title": "Authorized Keys"
        },
        "booted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
