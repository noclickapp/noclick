        "tags": {
          "anyOf": [
            {
              "items": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
