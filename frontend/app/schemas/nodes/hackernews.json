  "description": "Full configuration for Hacker News node (no credentials needed - public API)",
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "fetch_ask_hn_stories": "#/$defs/HNGetAskStoriesConfig",
          "fetch_best_stories": "#/$defs/HNGetBestStoriesConfig",
          "fetch_changed_items_and_profiles": "#/$defs/HNGetUpdatesConfig",
          "fetch_item_by_id": "#/$defs/HNGetItemConfig",
          "fetch_job_postings": "#/$defs/HNGetJobStoriesConfig",
          "fetch_largest_item_id": "#/$defs/HNGetMaxItemConfig",
          "fetch_newest_stories": "#/$defs/HNGetNewStoriesConfig",
          "fetch_show_hn_stories": "#/$defs/HNGetShowStoriesConfig",
          "fetch_top_stories": "#/$defs/HNGetTopStoriesConfig",
          "fetch_user_profile": "#/$defs/HNGetUserConfig",
          "search_by_recent_date": "#/$defs/HNSearchByDateConfig",
          "search_by_relevance": "#/$defs/HNSearchConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HNGetItemConfig"
        },
        {
          "$ref": "#/$defs/HNGetUserConfig"
        },
        {
          "$ref": "#/$defs/HNGetTopStoriesConfig"
        },
        {
          "$ref": "#/$defs/HNGetNewStoriesConfig"
        },
        {
          "$ref": "#/$defs/HNGetBestStoriesConfig"
        },
        {
          "$ref": "#/$defs/HNGetAskStoriesConfig"
        },
        {
          "$ref": "#/$defs/HNGetShowStoriesConfig"
        },
        {
          "$ref": "#/$defs/HNGetJobStoriesConfig"
        },
        {
          "$ref": "#/$defs/HNGetMaxItemConfig"
        },
        {
          "$ref": "#/$defs/HNGetUpdatesConfig"
        },
        {
          "$ref": "#/$defs/HNSearchConfig"
        },
        {
          "$ref": "#/$defs/HNSearchByDateConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials",
      "type": "null"
    }
  },
  "required": [
    "config"
