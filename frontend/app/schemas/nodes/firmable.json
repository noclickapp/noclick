    "ListFilterOptions": {
      "additionalProperties": false,
      "description": "Read accepted filter codes and markets. This endpoint is not charged.",
      "properties": {
        "operation": {
          "const": "list_filter_options",
          "default": "list_filter_options",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "identifiers": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "industry",
                  "location",
                  "hq_location",
                  "company_size",
                  "global_company_size",
                  "revenue",
                  "company_type",
                  "year_founded",
                  "is_mnc",
                  "b2b_vs_b2c",
                  "target_market",
                  "multiple_locations",
                  "job_posts",
                  "keywords",
                  "services",
                  "products",
                  "position",
                  "seniority",
                  "department",
                  "skills",
                  "current_role_duration",
                  "people_location"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit for every filter; sent comma-separated.",
          "title": "Identifiers"
        },
        "search": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page offset; pages contain 20 values.",
          "title": "Offset"
        },
        "level_one": {
          "anyOf": [
            {
              "pattern": "^l1:[A-Za-z]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Top-level industry code, for example l1:J.",
          "title": "Level One"
        }
      },
      "title": "ListFilterOptions",
      "type": "object"
    },
