{
  "$defs": {
    "LoftyAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "lofty_api_key",
          "default": "lofty_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Lofty API Key",
      "type": "object",
      "x-credential-instructions": "In Lofty, open Settings \u2192 Integrations \u2192 API and create a personal API key with the VIEW, ADD, EDIT, DEL or RUN permissions needed for your operations. Paste only the key, without the token prefix. NoClick verifies your current-user profile on connect.",
      "x-credential-url": "https://developer.lofty.com/authentication/api-keys"
    },
    "LoftyCreateLead": {
      "additionalProperties": false,
      "description": "Create a lead; omitted assignee uses Lofty routing and omitted ownership defaults to the caller.",
      "properties": {
        "firstName": {
          "maxLength": 30,
          "minLength": 1,
          "title": "First name",
          "type": "string"
        },
        "lastName": {
          "anyOf": [
            {
              "maxLength": 30,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last name"
        },
        "emails": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email addresses"
        },
        "phones": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone numbers"
        },
        "leadTypes": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  -1,
                  1,
                  2,
                  5,
                  6,
                  7,
                  8,
                  9
                ],
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Other -1, Seller 1, Buyer 2, Renter 5, Investor 6, Agent 7, Homeowner 8, Landlord 9.",
          "title": "Lead types"
        },
        "assignedUserId": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned user ID"
        },
        "stage": {
          "anyOf": [
            {
              "maxLength": 19,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replace all existing tags; omit to preserve them.",
          "title": "Tags"
        },
        "tagsAdd": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Append tags while retaining existing tags.",
          "title": "Tags to add"
        },
        "segments": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segments"
        },
        "cannotText": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cannot text"
        },
        "cannotCall": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cannot call"
        },
        "cannotEmail": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cannot email"
        },
        "operation": {
          "const": "create_lead",
          "default": "create_lead",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "firstName"
      ],
      "title": "LoftyCreateLead",
      "type": "object"
    },
    "LoftyCreateNote": {
      "additionalProperties": false,
      "description": "Add a note to a lead; returns the note ID, whose read may be briefly delayed.",
      "properties": {
        "leadId": {
          "minimum": 1,
          "title": "Lead ID",
          "type": "integer"
        },
        "content": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "isPin": {
          "default": false,
          "title": "Pin note",
          "type": "boolean"
        },
        "operation": {
          "const": "create_note",
          "default": "create_note",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "leadId",
        "content"
      ],
      "title": "LoftyCreateNote",
      "type": "object"
    },
    "LoftyCreateTask": {
      "additionalProperties": false,
      "description": "Create a follow-up task or appointment on a lead.",
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "startAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO8601 timestamp with timezone offset.",
          "title": "Start time"
        },
        "endAt": {
          "description": "ISO8601 timestamp with timezone offset; task deadline.",
          "title": "End time",
          "type": "string"
        },
        "timeZoneCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IANA timezone, for example America/Los_Angeles.",
          "title": "Timezone"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "operation": {
          "const": "create_task",
          "default": "create_task",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "leadId": {
          "minimum": 1,
          "title": "Lead ID",
          "type": "integer"
        },
        "type": {
          "enum": [
            "Other",
            "Call",
            "Email",
            "Text",
            "Appointment"
          ],
          "title": "Task type",
          "type": "string"
        },
        "assignedRole": {
          "enum": [
            "Agent",
            "Assistant"
          ],
          "title": "Assigned role",
          "type": "string"
        }
      },
      "required": [
        "content",
        "endAt",
        "leadId",
        "type",
        "assignedRole"
      ],
      "title": "LoftyCreateTask",
      "type": "object"
    },
    "LoftyDeleteLead": {
