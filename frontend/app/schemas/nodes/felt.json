    "FeltAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "felt_api_token",
          "default": "felt_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Felt API Token",
      "type": "object",
      "x-credential-instructions": "Create an API token in Workspace Settings \u2192 Developers and paste it here. Felt REST API access requires a Business or Enterprise plan, or a trial. The token is sent as a Bearer token to felt.com.",
      "x-credential-url": "https://felt.com/maps/latest/developers"
    },
    "FeltCreateMapConfig": {
      "additionalProperties": false,
      "description": "Create map.",
      "properties": {
        "operation": {
          "const": "create_map",
          "default": "create_map",
