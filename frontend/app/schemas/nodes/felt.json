        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "public_access": {
          "default": "private",
          "enum": [
            "private",
            "view_only",
            "view_and_comment",
            "view_comment_and_edit"
          ],
          "title": "Public Access",
          "type": "string"
        },
        "workspace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        },
        "basemap": {
          "anyOf": [
            {
              "enum": [
                "default",
                "light",
                "dark",
                "satellite"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basemap",
          "enum": [
            "default",
            "light",
            "dark",
            "satellite"
          ],
          "x-enum-searchable": true
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "zoom": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zoom"
        }
      },
      "required": [
        "title"
      ],
      "title": "FeltCreateMapConfig",
      "type": "object"
    },
