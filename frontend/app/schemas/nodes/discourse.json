    "DiscourseApiKeyCredential": {
      "description": "Admin API key credential for a Discourse instance.\n\nDiscourse has no central API host: every install exposes its own REST API at\nits own domain, and authenticates with two headers together \u2014 `Api-Key` and\n`Api-Username` (the latter selects which user the request acts as).",
      "properties": {
        "credential_type": {
          "const": "discourse_api_key",
          "default": "discourse_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "site_url": {
          "description": "Your Discourse site base URL, e.g. https://meta.discourse.org (no trailing /admin)",
          "title": "Forum URL",
          "type": "string"
        },
        "api_key": {
          "description": "Admin API key from Admin -> API -> Keys (/admin/api/keys)",
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_username": {
          "default": "system",
          "description": "Username the request acts as. Use 'system' or an admin for full access.",
          "title": "API Username",
          "type": "string"
        }
      },
      "required": [
        "site_url",
        "api_key"
      ],
      "title": "Discourse API Key",
      "type": "object",
      "x-credential-url": "https://meta.discourse.org/t/create-and-configure-an-api-key/230124"
    },
