      "properties": {
        "envelope_fingerprint": {
          "description": "Envelope fingerprint from Signable.",
          "minLength": 1,
          "title": "Envelope Fingerprint",
          "type": "string"
        },
        "operation": {
          "const": "send_draft_envelope",
          "default": "send_draft_envelope",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "envelope_fingerprint"
      ],
      "title": "SignableSendDraftEnvelopeConfig",
      "type": "object"
    },
    "SignableTemplateDocument": {
      "additionalProperties": false,
      "properties": {
        "document_title": {
          "minLength": 1,
          "title": "Document Title",
          "type": "string"
        },
        "document_template_fingerprint": {
          "minLength": 1,
          "title": "Document Template Fingerprint",
          "type": "string"
        },
        "document_merge_fields": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SignableMergeField"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Merge Fields"
        }
      },
      "required": [
        "document_title",
        "document_template_fingerprint"
      ],
      "title": "SignableTemplateDocument",
      "type": "object"
    },
    "SignableUpdateContactConfig": {
      "additionalProperties": false,
      "properties": {
        "contact_id": {
          "minimum": 1,
          "title": "Contact Id",
          "type": "integer"
        },
        "operation": {
          "const": "update_contact",
          "default": "update_contact",
          "title": "Operation",
          "type": "string"
        },
        "contact_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
