{
  "$defs": {
    "BindDevice": {
      "description": "Register a device/owner association in the Plaud cloud registry.",
      "properties": {
        "operation": {
          "const": "bind_device",
          "default": "bind_device",
          "title": "Operation",
          "type": "string"
        },
        "sn": {
          "description": "Device serial number.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Sn",
          "type": "string"
        },
        "type": {
          "default": "notepro",
          "description": "Use notepro for SN prefix 881, notepins for 882.",
          "enum": [
            "notepro",
            "notepins"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "sn"
      ],
      "title": "BindDevice",
      "type": "object"
    },
    "CompleteUpload": {
      "description": "Finalize previously uploaded parts. The returned download URL lasts 24 hours.",
      "properties": {
        "operation": {
          "const": "complete_upload",
          "default": "complete_upload",
          "title": "Operation",
          "type": "string"
        },
        "file_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "upload_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Upload Id",
          "type": "string"
        },
        "part_list": {
          "items": {
            "$ref": "#/$defs/UploadPart"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Part List",
          "type": "array"
        },
        "filetype": {
          "default": "mp3",
          "enum": [
            "mp3",
            "opus"
          ],
          "title": "Filetype",
          "type": "string"
        },
        "file_md5": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Md5"
        }
      },
      "required": [
        "file_id",
        "upload_id",
        "part_list"
      ],
      "title": "CompleteUpload",
      "type": "object"
    },
    "GeneratePresignedUrls": {
      "description": "Generate multipart upload URLs. Upload the raw chunks separately and keep each ETag.",
      "properties": {
        "operation": {
          "const": "generate_presigned_urls",
          "default": "generate_presigned_urls",
          "title": "Operation",
          "type": "string"
        },
        "filesize": {
          "description": "Full audio size in bytes; Plaud returns one URL per 5 MB part.",
          "exclusiveMinimum": 0,
          "title": "Filesize",
          "type": "integer"
        },
        "filetype": {
          "default": "mp3",
          "enum": [
            "mp3",
            "opus"
          ],
          "title": "Filetype",
          "type": "string"
        }
      },
      "required": [
        "filesize"
      ],
      "title": "GeneratePresignedUrls",
      "type": "object"
    },
    "GetDeviceBinding": {
      "description": "Read remote device binding and app history; this does not prove ownership.",
      "properties": {
        "operation": {
          "const": "get_device_binding",
          "default": "get_device_binding",
          "title": "Operation",
          "type": "string"
        },
        "sn": {
          "description": "Device serial number.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Sn",
          "type": "string"
        },
        "type": {
          "default": "notepro",
          "description": "Use notepro for SN prefix 881, notepins for 882.",
          "enum": [
            "notepro",
            "notepins"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "sn"
      ],
      "title": "GetDeviceBinding",
      "type": "object"
    },
    "GetFile": {
      "description": "Read recording metadata.",
      "properties": {
        "operation": {
          "const": "get_file",
          "default": "get_file",
          "title": "Operation",
          "type": "string"
        },
        "file_id": {
          "description": "Recording ID from the file change feed.",
          "maxLength": 512,
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetFile",
      "type": "object"
    },
    "GetFileAudio": {
      "description": "Get the expiring audio URL, without downloading the audio.",
      "properties": {
        "operation": {
          "const": "get_file_audio",
          "default": "get_file_audio",
          "title": "Operation",
          "type": "string"
        },
        "file_id": {
          "description": "Recording ID from the file change feed.",
          "maxLength": 512,
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetFileAudio",
      "type": "object"
    },
    "GetFileSummaries": {
      "description": "Read all generated summaries for a recording.",
      "properties": {
        "operation": {
          "const": "get_file_summaries",
          "default": "get_file_summaries",
          "title": "Operation",
          "type": "string"
        },
        "file_id": {
          "description": "Recording ID from the file change feed.",
          "maxLength": 512,
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetFileSummaries",
      "type": "object"
    },
    "GetFileTranscript": {
      "description": "Read the recording's speaker-labelled transcript.",
      "properties": {
        "operation": {
          "const": "get_file_transcript",
          "default": "get_file_transcript",
          "title": "Operation",
          "type": "string"
        },
        "file_id": {
          "description": "Recording ID from the file change feed.",
          "maxLength": 512,
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetFileTranscript",
      "type": "object"
    },
    "ListFileChanges": {
      "description": "Read one page of changed recordings; retain next_checkpoint to resume.",
      "properties": {
        "operation": {
          "const": "list_file_changes",
          "default": "list_file_changes",
          "title": "Operation",
          "type": "string"
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use next_cursor from the previous page.",
          "title": "Cursor"
        },
        "checkpoint": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint"
        }
      },
      "title": "ListFileChanges",
      "type": "object"
    },
    "ListMembers": {
      "description": "Read one page of members, including inactive members.",
      "properties": {
        "operation": {
          "const": "list_members",
          "default": "list_members",
          "title": "Operation",
          "type": "string"
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use next_cursor from the previous page.",
          "title": "Cursor"
        }
      },
      "title": "ListMembers",
      "type": "object"
    },
    "ListWorkspaces": {
      "description": "Read the workspace belonging to the supplied US workspace token.",
      "properties": {
        "operation": {
          "const": "list_workspaces",
          "default": "list_workspaces",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListWorkspaces",
      "type": "object"
    },
    "OnNewOrUpdatedRecording": {
      "description": "Watch the workspace change feed; existing recordings are baselined when armed.",
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_or_updated_recording",
          "default": "on_new_or_updated_recording",
          "title": "On New or Updated Recording",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On New or Updated Recording",
          "x-is-trigger": true
        },
        "checkpoint": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional starting checkpoint from the file change feed. Watches changes after this checkpoint. Each poll scans up to 10,000 changes; use a recent checkpoint for larger workspaces.",
          "title": "Checkpoint"
        }
      },
      "title": "OnNewOrUpdatedRecording",
      "type": "object",
      "x-requires-webhook": true
    },
    "PlaudMcpCredential": {
      "description": "Plaud connected through Plaud's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "plaud_mcp",
          "default": "plaud_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "Plaud MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://mcp.plaud.ai/mcp",
      "x-mcp-transport": "shttp"
    },
    "PlaudUserCredential": {
      "properties": {
        "access_token": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Access token",
          "type": "string",
          "ui:widget": "password"
        },
        "credential_type": {
          "const": "plaud_user_token",
          "default": "plaud_user_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "region": {
          "default": "us",
          "enum": [
            "us",
            "jp"
          ],
          "title": "API region",
          "type": "string"
        },
        "device_sn": {
          "description": "A device SN for the read-only connection check (881 = Note Pro, 882 = NotePin S).",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^(881|882)[0-9]+$",
          "title": "Device serial number",
          "type": "string"
        }
      },
      "required": [
        "access_token",
        "device_sn"
      ],
      "title": "Plaud Embedded User Token",
      "type": "object",
      "x-credential-instructions": "Paste an existing Embedded user access token, not a partner token. Choose the token's region and enter a device serial number for the read-only binding check. Replace expired tokens yourself. Binding reads prove token acceptance, not device ownership.",
      "x-credential-url": "https://docs.plaud.ai/plaud-embedded/auth-api-overview"
    },
    "PlaudWorkspaceCredential": {
      "properties": {
        "access_token": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Access token",
          "type": "string",
          "ui:widget": "password"
        },
        "credential_type": {
          "const": "plaud_workspace_token",
          "default": "plaud_workspace_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "access_token"
      ],
      "title": "Plaud Workspace Token",
      "type": "object",
      "x-credential-instructions": "Paste an existing US workspace access token from Plaud's workspace token endpoint. Tokens expire after one hour; replace the token when it expires. Connection reads your own workspace. Japan workspace endpoints are not supported by this credential.",
      "x-credential-url": "https://docs.plaud.ai/openapi/enterprise.json"
    },
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    },
    "UnbindDevice": {
      "description": "Remove the cloud binding. Also call depair(clear: true) in the device SDK to clear the local BLE binding.",
      "properties": {
        "operation": {
          "const": "unbind_device",
          "default": "unbind_device",
          "title": "Operation",
          "type": "string"
        },
        "sn": {
          "description": "Device serial number.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Sn",
          "type": "string"
        },
        "type": {
          "default": "notepro",
          "description": "Use notepro for SN prefix 881, notepins for 882.",
          "enum": [
            "notepro",
