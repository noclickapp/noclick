{
  "$defs": {
    "AudioSettings": {
      "additionalProperties": false,
      "properties": {
        "audio_format": {
          "default": "wav",
          "enum": [
            "wav",
            "mp3"
          ],
          "title": "Audio Format",
          "type": "string"
        },
        "audio_pitch": {
          "default": 0,
          "maximum": 12,
          "minimum": -12,
          "title": "Audio Pitch",
          "type": "integer"
        },
        "audio_tempo": {
          "default": 1,
          "maximum": 2,
          "minimum": 0.5,
          "title": "Audio Tempo",
          "type": "number"
        },
        "target_lufs": {
          "anyOf": [
            {
              "maximum": 0,
              "minimum": -70,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Lufs"
        },
        "remove_silence_ms": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remove Silence Ms"
        }
      },
      "title": "AudioSettings",
      "type": "object"
    },
    "ComposeSpeech": {
      "additionalProperties": false,
      "description": "Compose speech with multiple voices and pauses into one audio file.",
      "properties": {
        "operation": {
          "const": "compose_speech",
          "default": "compose_speech",
          "title": "Operation",
          "type": "string"
        },
        "segments": {
          "items": {
            "discriminator": {
              "mapping": {
                "pause": "#/$defs/PauseSegment",
                "tts": "#/$defs/SpeechSegment"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SpeechSegment"
              },
              {
                "$ref": "#/$defs/PauseSegment"
              }
            ]
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "segments"
      ],
      "title": "ComposeSpeech",
      "type": "object"
    },
    "DeleteCustomVoice": {
      "additionalProperties": false,
      "description": "Permanently delete an owned custom voice and free its slot.",
      "properties": {
        "voice_id": {
          "description": "Typecast voice ID from List Voices or List Custom Voices.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Voice Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_custom_voice",
          "default": "delete_custom_voice",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "voice_id"
      ],
      "title": "DeleteCustomVoice",
      "type": "object"
    },
    "GetCustomVoice": {
      "additionalProperties": false,
      "description": "Get an owned custom voice, including pending or failed training.",
      "properties": {
        "voice_id": {
          "description": "Typecast voice ID from List Voices or List Custom Voices.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Voice Id",
          "type": "string"
        },
        "operation": {
          "const": "get_custom_voice",
          "default": "get_custom_voice",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "voice_id"
      ],
      "title": "GetCustomVoice",
      "type": "object"
    },
    "GetSubscription": {
      "additionalProperties": false,
      "description": "Read your current plan, credit usage and voice-slot limits.",
      "properties": {
        "operation": {
          "const": "get_subscription",
          "default": "get_subscription",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetSubscription",
      "type": "object"
    },
    "GetVoice": {
      "additionalProperties": false,
      "description": "Get one available voice's metadata, models and emotions.",
      "properties": {
        "voice_id": {
          "description": "Typecast voice ID from List Voices or List Custom Voices.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Voice Id",
          "type": "string"
        },
        "operation": {
          "const": "get_voice",
          "default": "get_voice",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "voice_id"
      ],
      "title": "GetVoice",
      "type": "object"
    },
    "LegacyPrompt": {
      "additionalProperties": false,
      "properties": {
        "emotion_preset": {
          "default": "normal",
          "enum": [
            "normal",
            "sad",
            "happy",
            "angry"
          ],
          "title": "Emotion Preset",
          "type": "string"
        },
        "emotion_intensity": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "title": "Emotion Intensity",
          "type": "number"
        }
      },
      "title": "LegacyPrompt",
      "type": "object"
    },
    "ListCustomVoices": {
      "additionalProperties": false,
      "description": "List the authenticated account's cloned voices and training status.",
      "properties": {
        "operation": {
          "const": "list_custom_voices",
          "default": "list_custom_voices",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListCustomVoices",
      "type": "object"
    },
    "ListVoices": {
      "additionalProperties": false,
      "description": "List available voices with localized names, previews and model support.",
      "properties": {
        "operation": {
          "const": "list_voices",
          "default": "list_voices",
          "title": "Operation",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "enum": [
                "ssfm-v31",
                "ssfm-v30",
                "ssfm-v21"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model",
          "enum": [
            "ssfm-v31",
            "ssfm-v30",
            "ssfm-v21"
          ],
          "x-enum-searchable": true
        },
        "gender": {
          "anyOf": [
            {
              "enum": [
                "male",
                "female"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gender",
          "enum": [
            "male",
            "female"
          ],
          "x-enum-searchable": true
        },
        "age": {
          "anyOf": [
            {
              "enum": [
                "child",
                "teenager",
                "young_adult",
                "middle_age",
                "elder"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age",
          "enum": [
            "child",
            "teenager",
            "young_adult",
            "middle_age",
            "elder"
          ],
          "x-enum-searchable": true
        },
        "use_cases": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use-case keyword, such as Ads.",
          "title": "Use Cases"
        },
        "voice_type": {
          "anyOf": [
            {
              "enum": [
                "original",
                "custom"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Type",
          "enum": [
            "original",
            "custom"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "ListVoices",
      "type": "object"
    },
    "OutputSettings": {
      "additionalProperties": false,
      "properties": {
        "audio_format": {
          "default": "wav",
          "enum": [
            "wav",
            "mp3"
          ],
          "title": "Audio Format",
          "type": "string"
        },
        "audio_pitch": {
          "default": 0,
          "maximum": 12,
          "minimum": -12,
          "title": "Audio Pitch",
          "type": "integer"
        },
        "audio_tempo": {
          "default": 1,
          "maximum": 2,
          "minimum": 0.5,
          "title": "Audio Tempo",
          "type": "number"
        },
        "target_lufs": {
          "anyOf": [
            {
              "maximum": 0,
              "minimum": -70,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Lufs"
        },
        "remove_silence_ms": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remove Silence Ms"
        },
        "volume": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        }
      },
      "title": "OutputSettings",
      "type": "object"
    },
    "PauseSegment": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "pause",
          "default": "pause",
          "title": "Type",
          "type": "string"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Duration Seconds",
          "type": "number"
        }
      },
      "required": [
        "duration_seconds"
      ],
      "title": "PauseSegment",
      "type": "object"
    },
    "PresetPrompt": {
      "additionalProperties": false,
      "properties": {
        "emotion_type": {
          "const": "preset",
          "default": "preset",
          "title": "Emotion Type",
          "type": "string"
        },
        "emotion_preset": {
          "default": "normal",
          "enum": [
            "normal",
            "sad",
            "happy",
            "angry",
            "whisper",
            "toneup",
            "tonedown"
          ],
          "title": "Emotion Preset",
          "type": "string"
        },
        "emotion_intensity": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "title": "Emotion Intensity",
          "type": "number"
        }
      },
      "title": "PresetPrompt",
      "type": "object"
    },
    "RecommendVoices": {
      "additionalProperties": false,
      "description": "Find voices matching a style, mood, language or use case.",
      "properties": {
        "operation": {
          "const": "recommend_voices",
          "default": "recommend_voices",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "count": {
          "default": 5,
          "maximum": 10,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "RecommendVoices",
      "type": "object"
    },
    "SmartPrompt": {
      "additionalProperties": false,
      "properties": {
        "emotion_type": {
          "const": "smart",
          "default": "smart",
          "title": "Emotion Type",
          "type": "string"
        },
        "previous_text": {
          "default": "",
          "maxLength": 2000,
          "title": "Previous Text",
          "type": "string"
        },
        "next_text": {
          "default": "",
          "maxLength": 2000,
          "title": "Next Text",
          "type": "string"
        }
      },
      "title": "SmartPrompt",
      "type": "object"
    },
    "SpeechSegment": {
      "additionalProperties": false,
      "properties": {
        "voice_id": {
          "description": "Typecast voice ID from List Voices or List Custom Voices.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Voice Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "model": {
          "default": "ssfm-v31",
          "enum": [
            "ssfm-v31",
            "ssfm-v30",
            "ssfm-v21"
          ],
          "title": "Model",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 639-3 language code; omitted means auto-detect.",
          "title": "Language"
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresetPrompt"
            },
            {
              "$ref": "#/$defs/SmartPrompt"
            },
            {
              "$ref": "#/$defs/LegacyPrompt"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "type": {
          "const": "tts",
          "default": "tts",
          "title": "Type",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "voice_id",
        "text"
      ],
      "title": "SpeechSegment",
      "type": "object"
    },
    "StreamSpeech": {
      "additionalProperties": false,
      "description": "Generate streaming speech, collecting its audio into a workflow file.",
      "properties": {
        "voice_id": {
          "description": "Typecast voice ID from List Voices or List Custom Voices.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Voice Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "model": {
          "default": "ssfm-v31",
          "enum": [
            "ssfm-v31",
            "ssfm-v30",
            "ssfm-v21"
          ],
          "title": "Model",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 639-3 language code; omitted means auto-detect.",
          "title": "Language"
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresetPrompt"
            },
            {
              "$ref": "#/$defs/SmartPrompt"
            },
            {
              "$ref": "#/$defs/LegacyPrompt"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "operation": {
          "const": "stream_speech",
          "default": "stream_speech",
          "title": "Operation",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "voice_id",
        "text"
      ],
      "title": "StreamSpeech",
      "type": "object"
    },
    "TextToSpeech": {
      "additionalProperties": false,
      "description": "Generate a WAV or MP3 audio file from text.",
      "properties": {
        "voice_id": {
          "description": "Typecast voice ID from List Voices or List Custom Voices.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Voice Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "model": {
          "default": "ssfm-v31",
          "enum": [
            "ssfm-v31",
            "ssfm-v30",
            "ssfm-v21"
          ],
          "title": "Model",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 639-3 language code; omitted means auto-detect.",
          "title": "Language"
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresetPrompt"
            },
            {
              "$ref": "#/$defs/SmartPrompt"
            },
            {
              "$ref": "#/$defs/LegacyPrompt"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "operation": {
          "const": "text_to_speech",
          "default": "text_to_speech",
          "title": "Operation",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "voice_id",
        "text"
      ],
      "title": "TextToSpeech",
      "type": "object"
    },
    "TypecastAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "typecast_api_key",
          "default": "typecast_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Typecast API Key",
      "type": "object",
      "x-credential-instructions": "Create an API key in the Typecast API Console and paste it here. NoClick sends it in X-API-KEY to api.typecast.ai. Connecting reads your subscription plan and credit usage.",
      "x-credential-url": "https://studio.typecast.ai/"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "compose_speech": "#/$defs/ComposeSpeech",
          "delete_custom_voice": "#/$defs/DeleteCustomVoice",
          "get_custom_voice": "#/$defs/GetCustomVoice",
          "get_subscription": "#/$defs/GetSubscription",
          "get_voice": "#/$defs/GetVoice",
          "list_custom_voices": "#/$defs/ListCustomVoices",
          "list_voices": "#/$defs/ListVoices",
          "recommend_voices": "#/$defs/RecommendVoices",
          "stream_speech": "#/$defs/StreamSpeech",
          "text_to_speech": "#/$defs/TextToSpeech"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListVoices"
        },
        {
          "$ref": "#/$defs/GetVoice"
        },
        {
          "$ref": "#/$defs/ListCustomVoices"
        },
        {
          "$ref": "#/$defs/GetCustomVoice"
        },
        {
          "$ref": "#/$defs/DeleteCustomVoice"
        },
        {
          "$ref": "#/$defs/RecommendVoices"
        },
        {
          "$ref": "#/$defs/GetSubscription"
        },
        {
          "$ref": "#/$defs/TextToSpeech"
        },
        {
          "$ref": "#/$defs/StreamSpeech"
        },
        {
          "$ref": "#/$defs/ComposeSpeech"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TypecastAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Typecast Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
