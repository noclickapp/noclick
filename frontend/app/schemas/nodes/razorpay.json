{
  "$defs": {
    "CreateCustomer": {
      "additionalProperties": false,
      "description": "Create a customer record. This does not charge the customer.",
      "properties": {
        "notes": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Up to 15 notes; each value is at most 256 characters.",
          "title": "Notes"
        },
        "operation": {
          "const": "create_customer",
          "default": "create_customer",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "maxLength": 254,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "contact": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact"
        },
        "gstin": {
          "anyOf": [
            {
              "maxLength": 15,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gstin"
        },
        "fail_existing": {
          "default": "1",
          "description": "1 rejects an existing customer; 0 allows Razorpay to return the existing customer.",
          "enum": [
            "0",
            "1"
          ],
          "title": "Fail Existing",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateCustomer",
      "type": "object"
    },
    "CreateItem": {
      "additionalProperties": false,
      "description": "Create a reusable invoice item with an amount and description.",
      "properties": {
        "amount": {
          "description": "Amount in the smallest currency unit, for example 10000 paise for INR 100.",
          "minimum": 100,
          "title": "Amount",
          "type": "integer"
        },
        "currency": {
          "default": "INR",
          "description": "Three-letter supported currency code. The amount uses that currency's subunit.",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "operation": {
          "const": "create_item",
          "default": "create_item",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "amount",
        "name"
      ],
      "title": "CreateItem",
      "type": "object"
    },
    "CreateOrder": {
      "additionalProperties": false,
      "description": "Create an order for checkout; this does not itself capture a payment.",
      "properties": {
        "notes": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Up to 15 notes; each value is at most 256 characters.",
          "title": "Notes"
        },
        "amount": {
          "description": "Amount in the smallest currency unit, for example 10000 paise for INR 100.",
          "minimum": 100,
          "title": "Amount",
          "type": "integer"
        },
        "currency": {
          "default": "INR",
          "description": "Three-letter supported currency code. The amount uses that currency's subunit.",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "operation": {
          "const": "create_order",
          "default": "create_order",
          "title": "Operation",
          "type": "string"
        },
        "receipt": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Your unique receipt reference, up to 40 characters.",
          "title": "Receipt"
        }
      },
      "required": [
        "amount"
      ],
      "title": "CreateOrder",
      "type": "object"
    },
    "CreatePaymentLink": {
      "additionalProperties": false,
      "description": "Create a standard payment link with explicit notification choices.",
      "properties": {
        "notes": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Up to 15 notes; each value is at most 256 characters.",
          "title": "Notes"
        },
        "amount": {
          "description": "Amount in the smallest currency unit, for example 10000 paise for INR 100.",
          "minimum": 100,
          "title": "Amount",
          "type": "integer"
        },
        "currency": {
          "default": "INR",
          "description": "Three-letter supported currency code. The amount uses that currency's subunit.",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "operation": {
          "const": "create_payment_link",
          "default": "create_payment_link",
          "title": "Operation",
          "type": "string"
        },
        "description": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "reference_id": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Id"
        },
        "customer": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkCustomer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notify": {
          "$ref": "#/$defs/LinkNotifications"
        },
        "reminder_enable": {
          "default": false,
          "description": "Enable provider payment reminders only when explicitly requested.",
          "title": "Reminder Enable",
          "type": "boolean"
        },
        "accept_partial": {
          "default": false,
          "title": "Accept Partial",
          "type": "boolean"
        },
        "first_min_partial_amount": {
          "anyOf": [
            {
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Min Partial Amount"
        },
        "expire_by": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Link expiry in Unix seconds; must be a future timestamp accepted by Razorpay.",
          "title": "Expire By"
        }
      },
      "required": [
        "amount",
        "description"
      ],
      "title": "CreatePaymentLink",
      "type": "object"
    },
    "CreatePlan": {
      "additionalProperties": false,
      "description": "Create a recurring billing plan; no subscription or charge is created.",
      "properties": {
        "notes": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Up to 15 notes; each value is at most 256 characters.",
          "title": "Notes"
        },
        "operation": {
          "const": "create_plan",
          "default": "create_plan",
          "title": "Operation",
          "type": "string"
        },
        "period": {
          "default": "monthly",
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly",
            "yearly"
          ],
          "title": "Period",
          "type": "string"
        },
        "interval": {
          "default": 1,
          "minimum": 1,
          "title": "Interval",
          "type": "integer"
        },
        "item": {
          "$ref": "#/$defs/PlanItem"
        }
      },
      "required": [
        "item"
      ],
      "title": "CreatePlan",
      "type": "object"
    },
    "CreateSubscription": {
      "additionalProperties": false,
      "description": "Create a subscription requiring customer authorization before charging.",
      "properties": {
        "notes": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Up to 15 notes; each value is at most 256 characters.",
          "title": "Notes"
        },
        "operation": {
          "const": "create_subscription",
          "default": "create_subscription",
          "title": "Operation",
          "type": "string"
        },
        "plan_id": {
          "description": "Existing plan ID from list_plans or create_plan.",
          "pattern": "^plan_[A-Za-z0-9]+$",
          "title": "Plan Id",
          "type": "string"
        },
        "total_count": {
          "description": "Number of billing cycles.",
          "minimum": 1,
          "title": "Total Count",
          "type": "integer"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "start_at": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unix seconds; omit for the provider's immediate-start behavior.",
          "title": "Start At"
        },
        "expire_by": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unix seconds by which customer authorization must complete.",
          "title": "Expire By"
        },
        "customer_notify": {
          "default": false,
          "description": "Ask Razorpay to notify the customer; false suppresses the notification request.",
          "title": "Customer Notify",
          "type": "boolean"
        }
      },
      "required": [
        "plan_id",
        "total_count"
      ],
      "title": "CreateSubscription",
      "type": "object"
    },
    "LinkCustomer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "contact": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact"
        },
        "email": {
          "anyOf": [
            {
              "maxLength": 254,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        }
      },
      "title": "LinkCustomer",
      "type": "object"
    },
    "LinkNotifications": {
      "additionalProperties": false,
      "properties": {
        "sms": {
          "default": false,
          "description": "Explicitly request an SMS containing the payment link.",
          "title": "Sms",
          "type": "boolean"
        },
        "email": {
          "default": false,
          "description": "Explicitly request an email containing the payment link.",
          "title": "Email",
          "type": "boolean"
        }
      },
      "title": "LinkNotifications",
      "type": "object"
    },
    "ListCustomers": {
      "additionalProperties": false,
      "description": "Fetch one page of customers belonging to the connected merchant.",
      "properties": {
        "operation": {
          "const": "list_customers",
          "default": "list_customers",
          "title": "Operation",
          "type": "string"
        },
        "count": {
          "default": 10,
          "description": "Maximum customers in this page; this operation does not fetch subsequent pages.",
          "maximum": 100,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "title": "ListCustomers",
      "type": "object"
    },
    "ListInvoices": {
      "additionalProperties": false,
      "description": "Fetch the default page of invoices; no invoice is issued or emailed.",
      "properties": {
        "operation": {
          "const": "list_invoices",
          "default": "list_invoices",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListInvoices",
      "type": "object"
    },
    "ListItems": {
      "additionalProperties": false,
      "description": "Fetch the provider's default page of invoice items.",
      "properties": {
        "operation": {
          "const": "list_items",
          "default": "list_items",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListItems",
      "type": "object"
    },
    "ListOrders": {
      "additionalProperties": false,
      "description": "Fetch one page of merchant orders, without expanded payments.",
      "properties": {
        "operation": {
          "const": "list_orders",
          "default": "list_orders",
          "title": "Operation",
          "type": "string"
        },
        "count": {
          "default": 10,
          "description": "Maximum orders in this page; this operation does not fetch subsequent pages.",
          "maximum": 100,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "title": "ListOrders",
      "type": "object"
    },
    "ListPaymentLinks": {
      "additionalProperties": false,
      "description": "Fetch the default page of standard payment links; no notifications are sent.",
      "properties": {
        "operation": {
          "const": "list_payment_links",
          "default": "list_payment_links",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListPaymentLinks",
      "type": "object"
    },
    "ListPayments": {
      "additionalProperties": false,
      "description": "Fetch the provider's default page of payments, not the whole history.",
      "properties": {
        "operation": {
          "const": "list_payments",
          "default": "list_payments",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListPayments",
      "type": "object"
    },
    "ListPlans": {
      "additionalProperties": false,
      "description": "Fetch the provider's default page of subscription plans.",
      "properties": {
        "operation": {
          "const": "list_plans",
          "default": "list_plans",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListPlans",
      "type": "object"
    },
    "ListRefunds": {
      "additionalProperties": false,
      "description": "Fetch one page of refunds without initiating a refund.",
      "properties": {
        "operation": {
          "const": "list_refunds",
          "default": "list_refunds",
          "title": "Operation",
          "type": "string"
        },
        "count": {
          "default": 10,
          "description": "Maximum refunds in this page; this operation does not fetch subsequent pages.",
          "maximum": 100,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "title": "ListRefunds",
      "type": "object"
    },
    "ListSubscriptions": {
      "additionalProperties": false,
      "description": "Fetch the provider's default page of subscriptions.",
      "properties": {
        "operation": {
          "const": "list_subscriptions",
          "default": "list_subscriptions",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListSubscriptions",
      "type": "object"
    },
    "PlanItem": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Amount in the smallest currency unit, for example 10000 paise for INR 100.",
          "minimum": 100,
          "title": "Amount",
          "type": "integer"
        },
        "currency": {
          "default": "INR",
          "description": "Three-letter supported currency code. The amount uses that currency's subunit.",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "amount",
        "name"
      ],
      "title": "PlanItem",
      "type": "object"
    },
    "RazorpayAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "razorpay_api_key",
          "default": "razorpay_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "key_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key ID",
          "type": "string",
          "ui:widget": "password"
        },
        "key_secret": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key Secret",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "key_id",
        "key_secret"
      ],
      "title": "Razorpay API Key",
      "type": "object",
      "x-credential-instructions": "In Razorpay Dashboard, select Test or Live mode, then Account & Settings \u2192 API Keys. Paste the key ID and key secret from the same pair. Test keys operate on test data; live keys can create live orders, payment links and subscriptions. NoClick sends Basic authentication only to api.razorpay.com. Connecting reads your customers; it does not verify write permissions.",
      "x-credential-url": "https://dashboard.razorpay.com/app/keys"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_customer": "#/$defs/CreateCustomer",
          "create_item": "#/$defs/CreateItem",
          "create_order": "#/$defs/CreateOrder",
          "create_payment_link": "#/$defs/CreatePaymentLink",
          "create_plan": "#/$defs/CreatePlan",
          "create_subscription": "#/$defs/CreateSubscription",
          "list_customers": "#/$defs/ListCustomers",
          "list_invoices": "#/$defs/ListInvoices",
          "list_items": "#/$defs/ListItems",
          "list_orders": "#/$defs/ListOrders",
          "list_payment_links": "#/$defs/ListPaymentLinks",
          "list_payments": "#/$defs/ListPayments",
          "list_plans": "#/$defs/ListPlans",
          "list_refunds": "#/$defs/ListRefunds",
          "list_subscriptions": "#/$defs/ListSubscriptions"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListCustomers"
        },
        {
          "$ref": "#/$defs/CreateCustomer"
        },
        {
          "$ref": "#/$defs/ListOrders"
        },
        {
          "$ref": "#/$defs/CreateOrder"
        },
        {
          "$ref": "#/$defs/ListPayments"
        },
        {
          "$ref": "#/$defs/ListRefunds"
        },
        {
          "$ref": "#/$defs/ListInvoices"
        },
        {
          "$ref": "#/$defs/CreateItem"
        },
        {
          "$ref": "#/$defs/ListItems"
        },
        {
          "$ref": "#/$defs/CreatePlan"
        },
        {
          "$ref": "#/$defs/ListPlans"
        },
        {
          "$ref": "#/$defs/CreateSubscription"
        },
        {
          "$ref": "#/$defs/ListSubscriptions"
        },
        {
          "$ref": "#/$defs/CreatePaymentLink"
        },
        {
          "$ref": "#/$defs/ListPaymentLinks"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/RazorpayAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Razorpay Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
