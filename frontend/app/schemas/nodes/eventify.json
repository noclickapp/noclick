{
  "$defs": {
    "EventifyCreateAttendeeConfig": {
      "description": "Add an attendee.",
      "properties": {
        "operation": {
          "const": "create_attendee",
          "default": "create_attendee",
          "title": "Create Attendee",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Users"
        },
        "eventid": {
          "exclusiveMinimum": 0,
          "title": "Event ID",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Enter event ID",
            "field_name": "eventid",
            "placeholder": "Choose an Eventify event",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        },
        "firstname": {
          "minLength": 1,
          "title": "First name",
          "type": "string"
        },
        "lastname": {
          "minLength": 1,
          "title": "Last name",
          "type": "string"
        },
        "userpassword": {
          "minLength": 6,
          "pattern": "^[A-Za-z0-9]+$",
          "title": "Attendee password",
          "type": "string",
          "ui:widget": "password"
        },
        "form_number": {
          "description": "Attendee form_number from List Forms. Keep the answer items in that form's order.",
          "exclusiveMinimum": 0,
          "title": "Form number",
          "type": "integer"
        },
        "details_form": {
          "description": "Paste the ordered details_form JSON array from List Forms. Supply ordinary items' values; omit for sections and dynamic fields.",
          "title": "Form answers",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "usercategory": {
          "description": "Comma separated IDs from List User Categories, including an attendee category.",
          "minLength": 1,
          "title": "User category IDs",
          "type": "string"
        },
        "userinterests": {
          "default": "",
          "description": "Comma separated IDs from List Interests, or empty.",
          "title": "Interest IDs",
          "type": "string"
        },
        "isadmin": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "Administrator",
          "type": "integer"
        },
        "isactive": {
          "default": 1,
          "enum": [
            0,
            1
          ],
          "title": "Active",
          "type": "integer"
        },
        "isnetworking": {
          "default": 1,
          "enum": [
            0,
            1
          ],
          "title": "Networking",
          "type": "integer"
        },
        "userwaitlistmode": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "Waitlisted",
          "type": "integer"
        },
        "profileurl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile image URL"
        },
        "exhibitoridfk": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Associated exhibitor ID"
        },
        "speakeridfk": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Associated speaker ID"
        },
        "sponsoridfk": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Associated sponsor ID"
        },
        "sendwelcomeemail": {
          "default": false,
          "title": "Send welcome email",
          "type": "boolean"
        }
      },
      "required": [
        "eventid",
        "email",
        "firstname",
        "lastname",
        "userpassword",
        "form_number",
        "details_form",
        "usercategory"
      ],
      "title": "EventifyCreateAttendeeConfig",
      "type": "object"
    },
    "EventifyCreateSessionConfig": {
