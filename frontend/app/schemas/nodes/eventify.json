        "endtime": {
          "description": "Event-local time as yyyy-MM-dd HH:mm:ss.",
          "title": "End time",
          "type": "string"
        },
        "sessiontype": {
          "default": "general",
          "enum": [
            "general",
            "private",
            "additional",
            "addprivate",
            "rsvp"
          ],
          "title": "Session type",
          "type": "string"
        },
        "colorid": {
          "exclusiveMinimum": 0,
          "title": "Session color ID",
          "type": "integer"
        },
        "checkintype": {
          "default": "showqr",
          "enum": [
            "nocheckinneeded",
            "showqr",
            "scanqr"
          ],
          "title": "Check-in type",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "rsvp": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rsvp"
        },
        "rsvp_capacity": {
          "anyOf": [
            {
              "enum": [
                "unlimited",
                "fixed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rsvp Capacity",
          "enum": [
            "unlimited",
            "fixed"
          ],
          "x-enum-searchable": true
        },
        "capacity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity"
        },
        "tags": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma separated tag IDs.",
          "title": "Tags"
        }
      },
      "required": [
        "eventid",
        "apptabid",
        "scheduledateid",
        "scheduletrackid",
        "title",
        "starttime",
        "endtime",
        "colorid"
