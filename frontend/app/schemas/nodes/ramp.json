    "RampAccessTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "ramp_access_token",
          "default": "ramp_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "description": "Ramp Developer API bearer access token. Paste the token without the Bearer prefix.",
          "minLength": 1,
          "title": "Access Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "RampAccessTokenCredential",
      "type": "object",
      "x-credential-instructions": "Create a Ramp Developer API app and obtain an access token using client credentials. Include business:read, cards:read, cards:write, transactions:read, transactions:write, reimbursements:read, reimbursements:write, bills:read and bills:write for all operations. Paste only the access token. Client-credentials tokens expire after 10 days; obtain and paste a replacement when expired. Other token lifetimes follow expires_in.",
      "x-credential-url": "https://docs.ramp.com/developer-api/v1/guides/getting-started"
    },
    "RampCreateBillConfig": {
      "properties": {
        "operation": {
          "const": "create_bill",
          "default": "create_bill",
          "title": "Create Bill",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Bills",
          "x-display-name": "Create Bill",
          "x-is-trigger": false
        },
        "vendor_id": {
          "description": "UUID of the bill vendor.",
          "title": "Vendor ID",
          "type": "string"
        },
        "entity_id": {
          "description": "UUID of the associated business entity.",
          "title": "Entity ID",
          "type": "string"
        },
        "due_at": {
          "format": "date",
          "title": "Due Date",
          "type": "string"
        },
        "issued_at": {
          "format": "date",
          "title": "Issued Date",
          "type": "string"
        },
        "invoice_currency": {
          "default": "USD",
          "description": "Three-letter invoice currency code, such as USD.",
          "title": "Invoice Currency",
          "type": "string"
        },
        "invoice_number": {
          "title": "Invoice Number",
          "type": "string"
        },
        "line_items": {
          "description": "JSON array of bill line items: amount, memo and accounting_field_selections. Ramp bill amounts are decimal major currency units.",
          "title": "Line Items",
          "type": "string",
          "ui:widget": "textarea"
        },
        "payment_method": {
          "enum": [
            "ACH",
            "CARD",
            "CHECK",
            "DOMESTIC_WIRE",
            "INTERNATIONAL",
            "PAID_MANUALLY",
            "ONE_TIME_CARD",
            "ONE_TIME_CARD_DELIVERY",
            "LOCAL_BANK_TRANSFER",
            "SWIFT",
            "CRYPTO_WALLET_TRANSFER"
          ],
          "title": "Payment Method",
          "type": "string"
        },
        "payment_details": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON payment details matching payment_method. For ACH, source_bank_account_id and vendor_account_id; see Ramp's API reference.",
          "title": "Payment Details",
          "ui:widget": "textarea"
        },
        "vendor_contact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vendor Contact ID"
        },
        "payment_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Date"
        },
        "memo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memo"
        }
      },
      "required": [
        "vendor_id",
        "entity_id",
        "due_at",
        "issued_at",
        "invoice_number",
        "line_items",
        "payment_method"
