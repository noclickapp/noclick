    "PromptLayerRecalculateSheetConfig": {
      "additionalProperties": false,
      "description": "Queue recalculation; preserve any confirmation request instead of approving it automatically.",
      "properties": {
        "table_id": {
          "description": "Table UUID from PromptLayer.",
          "format": "uuid",
          "title": "Table Id",
          "type": "string"
