    },
    "PromptLayerAddRowsConfig": {
      "additionalProperties": false,
      "description": "Append rows; computed cells remain stale until explicitly recalculated.",
      "properties": {
        "table_id": {
          "description": "Table UUID from PromptLayer.",
          "format": "uuid",
          "title": "Table Id",
          "type": "string"
        },
        "sheet_id": {
          "description": "Sheet UUID within the table.",
          "format": "uuid",
          "title": "Sheet Id",
          "type": "string"
        },
        "operation": {
          "const": "add_rows",
          "default": "add_rows",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "count": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One map of text-column UUID to value per appended row.",
          "title": "Values"
        }
      },
      "required": [
        "table_id",
        "sheet_id"
      ],
      "title": "PromptLayerAddRowsConfig",
      "type": "object"
    },
