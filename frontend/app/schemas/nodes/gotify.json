{
  "$defs": {
    "GotifyClientToken": {
      "properties": {
        "credential_type": {
          "const": "gotify_client_token",
          "default": "gotify_client_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "server_url": {
          "description": "Public HTTPS server URL, including a reverse-proxy path prefix if used.",
          "title": "Server URL",
          "type": "string"
        },
        "client_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Client token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "server_url",
        "client_token"
      ],
      "title": "Gotify Client Token",
      "type": "object",
      "x-credential-instructions": "Enter your public HTTPS Gotify server URL and an existing client token (not an application token). Obtain a client token with POST /client using the Gotify API. NoClick checks access by listing your applications. Some administrative actions require session elevation on Gotify 3. Sending a message requires an application ID owned by your account.",
      "x-credential-url": "https://gotify.net/docs/api-docs"
    },
    "GotifyCreateApplicationConfig": {
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Application name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "defaultPriority": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default priority"
        },
        "sortKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gotify fractional indexing key.",
          "title": "Sort key"
        },
        "operation": {
          "const": "create_application",
          "default": "create_application",
          "title": "Create Application",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "name"
      ],
      "title": "GotifyCreateApplicationConfig",
      "type": "object"
    },
