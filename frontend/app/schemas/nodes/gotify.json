    "GotifyOnNewMessageConfig": {
      "description": "Poll retained message history; first run baselines. Requires at most 4,000 retained messages. Messages deleted between polls cannot fire.",
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_message",
          "default": "on_new_message",
          "title": "On New Message",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-is-trigger": true
        }
      },
      "title": "GotifyOnNewMessageConfig",
      "type": "object",
      "x-requires-webhook": true
    },
    "GotifyRemoveApplicationImageConfig": {
      "properties": {
        "application_id": {
          "minimum": 1,
          "title": "Application ID",
          "type": "integer"
        },
        "operation": {
          "const": "remove_application_image",
          "default": "remove_application_image",
          "title": "Remove Application Image",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "application_id"
      ],
      "title": "GotifyRemoveApplicationImageConfig",
      "type": "object"
    },
    "GotifySendMessageConfig": {
      "properties": {
        "appid": {
          "description": "An application owned by the client token's account; required for client-token authentication.",
          "minimum": 1,
          "title": "Application ID",
          "type": "integer"
        },
        "message": {
          "description": "Message text; Markdown is supported.",
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "priority": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority"
        },
        "extras": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gotify message extras, sent as JSON.",
          "title": "Extras"
        },
        "operation": {
          "const": "send_message",
          "default": "send_message",
          "title": "Send Message",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "appid",
        "message"
      ],
      "title": "GotifySendMessageConfig",
      "type": "object"
    },
    "GotifyUpdateApplicationConfig": {
      "properties": {
        "application_id": {
          "minimum": 1,
          "title": "Application ID",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Application name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "defaultPriority": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default priority"
        },
        "sortKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gotify fractional indexing key.",
          "title": "Sort key"
        },
        "operation": {
          "const": "update_application",
          "default": "update_application",
          "title": "Update Application",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "application_id",
        "name"
      ],
      "title": "GotifyUpdateApplicationConfig",
      "type": "object"
    },
    "GotifyUpdateClientConfig": {
      "properties": {
        "client_id": {
          "minimum": 1,
          "title": "Client Id",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Client name",
          "type": "string"
        },
        "expiresAfterInactivitySeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0 means never expire.",
          "title": "Expire after inactivity (seconds)"
        },
        "operation": {
          "const": "update_client",
          "default": "update_client",
          "title": "Update Client",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "client_id",
        "name"
      ],
      "title": "GotifyUpdateClientConfig",
      "type": "object"
    },
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_application": "#/$defs/GotifyCreateApplicationConfig",
          "create_client": "#/$defs/GotifyCreateClientConfig",
          "delete_all_messages": "#/$defs/GotifyDeleteAllMessagesConfig",
          "delete_application": "#/$defs/GotifyDeleteApplicationConfig",
          "delete_application_messages": "#/$defs/GotifyDeleteApplicationMessagesConfig",
          "delete_client": "#/$defs/GotifyDeleteClientConfig",
          "delete_message": "#/$defs/GotifyDeleteMessageConfig",
          "disable_plugin": "#/$defs/GotifyDisablePluginConfig",
          "enable_plugin": "#/$defs/GotifyEnablePluginConfig",
          "get_current_user": "#/$defs/GotifyGetCurrentUserConfig",
          "list_application_messages": "#/$defs/GotifyListApplicationMessagesConfig",
          "list_applications": "#/$defs/GotifyListApplicationsConfig",
          "list_clients": "#/$defs/GotifyListClientsConfig",
          "list_messages": "#/$defs/GotifyListMessagesConfig",
          "list_plugins": "#/$defs/GotifyListPluginsConfig",
          "on_new_message": "#/$defs/GotifyOnNewMessageConfig",
          "remove_application_image": "#/$defs/GotifyRemoveApplicationImageConfig",
          "send_message": "#/$defs/GotifySendMessageConfig",
          "update_application": "#/$defs/GotifyUpdateApplicationConfig",
          "update_client": "#/$defs/GotifyUpdateClientConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GotifySendMessageConfig"
        },
        {
          "$ref": "#/$defs/GotifyListMessagesConfig"
        },
        {
          "$ref": "#/$defs/GotifyDeleteMessageConfig"
        },
