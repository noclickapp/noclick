        "direction": {
          "default": "NEXT",
          "enum": [
            "NEXT",
            "PREVIOUS"
          ],
          "title": "Direction",
          "type": "string"
        },
        "sort_order": {
          "default": "DESC",
          "enum": [
            "ASC",
            "DESC"
          ],
          "title": "Sort Order",
          "type": "string"
        },
        "account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        },
        "resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 date and time",
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 date and time",
          "title": "End Date"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "SUCCESS",
                "FAILURE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "SUCCESS",
            "FAILURE"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "ListAuditLogs",
      "type": "object"
