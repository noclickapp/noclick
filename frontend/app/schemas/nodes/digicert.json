    "ListAuditLogs": {
      "additionalProperties": false,
      "description": "List audit logs using cursor pagination.",
      "properties": {
        "operation": {
          "const": "list_audit_logs",
          "default": "list_audit_logs",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
