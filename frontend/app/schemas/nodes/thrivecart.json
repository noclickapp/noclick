{
  "$defs": {
    "CancelSubscription": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "live",
          "description": "Choose live or test-mode transactions; live writes affect real subscriptions and payments.",
          "enum": [
            "live",
            "test"
          ],
          "title": "Mode",
          "type": "string"
        },
        "order_id": {
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[0-9]+$",
          "title": "Order Id",
          "type": "string"
        },
        "subscription_id": {
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[0-9]+$",
          "title": "Subscription Id",
          "type": "string"
        },
        "operation": {
          "const": "cancel_subscription",
          "default": "cancel_subscription",
          "title": "Cancel Subscription",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "order_id",
        "subscription_id"
      ],
      "title": "CancelSubscription",
      "type": "object"
    },
    "CreateStudent": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_student",
          "default": "create_student",
          "title": "Create Learn Student",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "maxLength": 254,
          "minLength": 3,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email",
          "type": "string"
        },
        "course_id": {
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[0-9]+$",
          "title": "Course Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 150,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "tags": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Tags",
          "type": "array"
        },
        "order_id": {
          "anyOf": [
            {
              "maxLength": 20,
              "minLength": 1,
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Id"
        },
        "purchase_type": {
          "anyOf": [
            {
              "enum": [
                "product",
                "bump",
                "upsell",
                "downsell"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purchase Type",
          "enum": [
            "product",
            "bump",
            "upsell",
            "downsell"
          ],
          "x-enum-searchable": true
        },
        "purchase_id": {
          "anyOf": [
            {
              "maxLength": 20,
              "minLength": 1,
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purchase Id"
        },
        "trigger_emails": {
          "default": true,
          "description": "Send the provider's student email; defaults to true as in ThriveCart.",
          "title": "Trigger Emails",
          "type": "boolean"
        }
      },
      "required": [
        "email",
        "course_id"
      ],
      "title": "CreateStudent",
      "type": "object"
    },
    "GetAccount": {
      "additionalProperties": false,
