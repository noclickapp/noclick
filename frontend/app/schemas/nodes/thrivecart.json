    "SearchAffiliates": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "search_affiliates",
          "default": "search_affiliates",
          "title": "Search Affiliates",
          "type": "string",
          "ui:hidden": true
        },
        "page": {
          "default": 1,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 5,
          "maximum": 25,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "product_id": {
          "anyOf": [
            {
              "maxLength": 20,
              "minLength": 1,
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Id"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        }
      },
      "title": "SearchAffiliates",
      "type": "object"
    },
    "SearchTransactions": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "live",
          "description": "Choose live or test-mode transactions; live writes affect real subscriptions and payments.",
          "enum": [
            "live",
            "test"
          ],
          "title": "Mode",
          "type": "string"
        },
        "operation": {
          "const": "search_transactions",
          "default": "search_transactions",
          "title": "Search Transactions",
          "type": "string",
          "ui:hidden": true
        },
        "page": {
          "default": 1,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 10,
          "description": "Results per page; at most 100.",
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "transaction_type": {
          "default": "any",
          "enum": [
            "any",
            "charge",
            "rebill",
            "refund",
            "cancel"
          ],
          "title": "Transaction Type",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[a-z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lowercase three-letter currency, such as usd.",
          "title": "Currency"
        }
      },
      "title": "SearchTransactions",
      "type": "object"
    },
    "ThriveCartAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "thrivecart_api_key",
          "default": "thrivecart_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "ThriveCart API Key",
      "type": "object",
      "x-credential-instructions": "In ThriveCart, open Settings \u2192 API & webhooks \u2192 API tokens. Create an API key for your account and paste it here. NoClick verifies it by reading your account information.",
      "x-credential-url": "https://developers.thrivecart.com/documentation/intro/authentication-via-api-key/"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "cancel_subscription": "#/$defs/CancelSubscription",
          "create_student": "#/$defs/CreateStudent",
          "get_account": "#/$defs/GetAccount",
          "get_affiliate": "#/$defs/GetAffiliate",
          "get_bump": "#/$defs/GetBump",
          "get_customer": "#/$defs/GetCustomer",
          "get_downsell": "#/$defs/GetDownsell",
          "get_product": "#/$defs/GetProduct",
          "get_upsell": "#/$defs/GetUpsell",
          "list_bumps": "#/$defs/ListBumps",
          "list_downsells": "#/$defs/ListDownsells",
          "list_products": "#/$defs/ListProducts",
          "list_upsells": "#/$defs/ListUpsells",
          "pause_subscription": "#/$defs/PauseSubscription",
          "refund_transaction": "#/$defs/RefundTransaction",
          "resume_subscription": "#/$defs/ResumeSubscription",
          "search_affiliates": "#/$defs/SearchAffiliates",
          "search_transactions": "#/$defs/SearchTransactions"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetAccount"
        },
        {
          "$ref": "#/$defs/ListProducts"
        },
        {
          "$ref": "#/$defs/ListBumps"
        },
        {
          "$ref": "#/$defs/ListUpsells"
        },
        {
          "$ref": "#/$defs/ListDownsells"
        },
        {
          "$ref": "#/$defs/GetProduct"
        },
        {
          "$ref": "#/$defs/GetBump"
        },
        {
          "$ref": "#/$defs/GetUpsell"
        },
        {
          "$ref": "#/$defs/GetDownsell"
        },
        {
          "$ref": "#/$defs/SearchTransactions"
        },
        {
          "$ref": "#/$defs/GetCustomer"
        },
        {
          "$ref": "#/$defs/CancelSubscription"
        },
        {
          "$ref": "#/$defs/PauseSubscription"
        },
        {
          "$ref": "#/$defs/ResumeSubscription"
        },
        {
          "$ref": "#/$defs/RefundTransaction"
        },
        {
          "$ref": "#/$defs/SearchAffiliates"
        },
        {
          "$ref": "#/$defs/GetAffiliate"
        },
        {
          "$ref": "#/$defs/CreateStudent"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThriveCartAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Thrivecart Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
