    "PauseSubscription": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "live",
          "description": "Choose live or test-mode transactions; live writes affect real subscriptions and payments.",
          "enum": [
            "live",
            "test"
          ],
          "title": "Mode",
          "type": "string"
        },
        "order_id": {
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[0-9]+$",
          "title": "Order Id",
          "type": "string"
        },
        "subscription_id": {
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[0-9]+$",
          "title": "Subscription Id",
          "type": "string"
        },
        "operation": {
          "const": "pause_subscription",
          "default": "pause_subscription",
          "title": "Pause Subscription",
          "type": "string",
          "ui:hidden": true
        },
        "auto_resume": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional Unix timestamp at least 24 hours in the future. Omit to pause indefinitely.",
          "title": "Auto Resume"
        }
      },
      "required": [
        "order_id",
        "subscription_id"
      ],
      "title": "PauseSubscription",
      "type": "object"
    },
    "RefundTransaction": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "live",
          "description": "Choose live or test-mode transactions; live writes affect real subscriptions and payments.",
          "enum": [
            "live",
            "test"
          ],
          "title": "Mode",
          "type": "string"
        },
        "operation": {
          "const": "refund_transaction",
          "default": "refund_transaction",
          "title": "Refund Transaction",
          "type": "string",
          "ui:hidden": true
        },
        "order_id": {
          "maxLength": 20,
