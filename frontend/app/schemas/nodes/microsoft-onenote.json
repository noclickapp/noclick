        },
        {
          "$ref": "#/$defs/OneNoteReplacePageContentConfig"
        },
        {
          "$ref": "#/$defs/OneNoteDeletePageConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/OneNoteOAuthCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
