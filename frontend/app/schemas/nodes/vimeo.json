        },
        {
          "$ref": "#/$defs/GetComment"
        },
        {
          "$ref": "#/$defs/UpdateComment"
        },
        {
          "$ref": "#/$defs/DeleteComment"
        },
        {
          "$ref": "#/$defs/ListFolders"
        },
        {
          "$ref": "#/$defs/CreateFolder"
        },
        {
          "$ref": "#/$defs/GetFolder"
        },
        {
          "$ref": "#/$defs/UpdateFolder"
        },
        {
