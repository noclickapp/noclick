{
  "$defs": {
    "GetCollection": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to collection/tag names. Owners, members, permissions, URLs, link content and parent metadata remain omitted.",
          "title": "Include Names",
          "type": "boolean"
        },
        "operation": {
          "const": "get_collection",
          "default": "get_collection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Metadata",
          "x-display-name": "Get Collection Metadata",
          "x-is-trigger": false
        },
        "collection_id": {
          "description": "Positive current token-visible collection ID. Current catalog/detail/catalog witnesses must match; access is not ownership.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Collection",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "collection_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "linkwarden_collection"
        }
      },
      "required": [
        "collection_id"
      ],
      "title": "GetCollection",
      "type": "object"
    },
    "LinkwardenAccessTokenCredential": {
      "additionalProperties": false,
      "properties": {
        "credential_type": {
          "const": "linkwarden_access_token",
          "default": "linkwarden_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "instance_origin": {
          "description": "One public HTTPS origin, with no credentials/path/query/fragment. API paths are fixed /api/v1. Hosted/self-hosted instance version parity is unverified.",
          "title": "Instance HTTPS Origin",
          "type": "string"
        },
        "access_token": {
          "description": "Supplied existing access token, Authorization Bearer header only. No login, JWT parsing, token mint/refresh or alternate auth.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Existing Access Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "instance_origin",
        "access_token"
      ],
      "title": "Linkwarden Access Token",
      "type": "object",
      "x-credential-type": "linkwarden_access_token",
      "x-credential-url": "https://docs.linkwarden.app/usage/profile-settings"
    },
    "ListCollections": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to collection/tag names. Owners, members, permissions, URLs, link content and parent metadata remain omitted.",
          "title": "Include Names",
          "type": "boolean"
        },
        "operation": {
          "const": "list_collections",
          "default": "list_collections",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Metadata",
          "x-display-name": "List Collection Metadata",
          "x-is-trigger": false
        }
      },
      "title": "ListCollections",
      "type": "object"
    },
    "ListTags": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to collection/tag names. Owners, members, permissions, URLs, link content and parent metadata remain omitted.",
          "title": "Include Names",
          "type": "boolean"
        },
        "operation": {
          "const": "list_tags",
          "default": "list_tags",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Metadata",
          "x-display-name": "List Tag Metadata",
          "x-is-trigger": false
        }
      },
      "title": "ListTags",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_collection": "#/$defs/GetCollection",
          "list_collections": "#/$defs/ListCollections",
          "list_tags": "#/$defs/ListTags"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListCollections"
        },
        {
          "$ref": "#/$defs/GetCollection"
        },
        {
          "$ref": "#/$defs/ListTags"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/LinkwardenAccessTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Linkwarden Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
