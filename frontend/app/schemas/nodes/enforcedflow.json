{
  "$defs": {
    "ActivateAgent": {
      "additionalProperties": false,
      "description": "Provider upsert by ID with active=true; a missing ID may fail or create.",
      "properties": {
        "group_id": {
          "exclusiveMinimum": 0,
          "title": "Group ID",
          "type": "integer"
        },
        "operation": {
          "const": "activate_agent",
          "default": "activate_agent",
          "title": "Operation",
          "type": "string"
        },
        "agent_id": {
          "exclusiveMinimum": 0,
          "title": "Agent Id",
          "type": "integer"
        }
      },
      "required": [
        "group_id",
        "agent_id"
      ],
      "title": "ActivateAgent",
      "type": "object"
    },
    "AgentData": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active"
        },
        "meta": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta"
        },
        "fields": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Evaluator values: option label arrays, numeric weights, or timezone configuration objects.",
          "title": "Fields"
        }
      },
      "title": "AgentData",
      "type": "object"
    },
    "AgentFilter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active"
        },
        "meta": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta"
        }
      },
      "title": "AgentFilter",
      "type": "object"
    },
    "CreateAgent": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "exclusiveMinimum": 0,
          "title": "Group ID",
          "type": "integer"
        },
        "operation": {
          "const": "create_agent",
          "default": "create_agent",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        },
        "fields": {
          "additionalProperties": true,
          "title": "Fields",
          "type": "object"
        }
      },
      "required": [
        "group_id",
        "name"
      ],
      "title": "CreateAgent",
      "type": "object"
    },
    "DeactivateAgent": {
      "additionalProperties": false,
      "description": "Provider upsert by ID with active=false; inspect the provider's created flag.",
      "properties": {
        "group_id": {
          "exclusiveMinimum": 0,
          "title": "Group ID",
          "type": "integer"
        },
        "operation": {
          "const": "deactivate_agent",
          "default": "deactivate_agent",
          "title": "Operation",
          "type": "string"
        },
        "agent_id": {
          "exclusiveMinimum": 0,
          "title": "Agent Id",
          "type": "integer"
        }
      },
      "required": [
        "group_id",
        "agent_id"
      ],
      "title": "DeactivateAgent",
      "type": "object"
    },
    "EmailNextAgent": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "exclusiveMinimum": 0,
          "title": "Group ID",
          "type": "integer"
        },
        "operation": {
          "const": "email_next_agent",
          "default": "email_next_agent",
          "title": "Operation",
          "type": "string"
        },
        "content": {
          "description": "Message to send. EnforcedFlow extracts routing criteria and queues delivery.",
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "content"
      ],
      "title": "EmailNextAgent",
      "type": "object"
    },
    "EnforcedflowCredential": {
      "properties": {
        "credential_type": {
          "const": "enforcedflow_provider_key",
          "default": "enforcedflow_provider_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "provider_key": {
          "minLength": 1,
          "title": "Provider key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "provider_key"
      ],
      "title": "Enforcedflow Provider Key",
      "type": "object",
      "x-credential-instructions": "Generate a Provider Key in your EnforcedFlow account dashboard and paste it here. The key is sent directly in the Authorization header.",
      "x-credential-url": "https://app.enforcedflow.com"
    },
    "GetFields": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "exclusiveMinimum": 0,
          "title": "Group ID",
          "type": "integer"
        },
        "operation": {
          "const": "get_fields",
          "default": "get_fields",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "group_id"
      ],
      "title": "GetFields",
      "type": "object"
    },
    "ListAgents": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "exclusiveMinimum": 0,
          "title": "Group ID",
          "type": "integer"
        },
        "operation": {
          "const": "list_agents",
          "default": "list_agents",
          "title": "Operation",
          "type": "string"
        },
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by active status; omit to list all agents.",
          "title": "Active"
        }
      },
      "required": [
        "group_id"
      ],
      "title": "ListAgents",
      "type": "object"
    },
    "ListGroups": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_groups",
          "default": "list_groups",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListGroups",
      "type": "object"
    },
    "NextAgent": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "exclusiveMinimum": 0,
          "title": "Group ID",
          "type": "integer"
        },
        "operation": {
          "const": "next_agent",
          "default": "next_agent",
          "title": "Operation",
          "type": "string"
        },
        "criteria": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "description": "Field names mapped to MultiSelect string arrays or AISelect raw text. Empty matches any agent.",
          "title": "Criteria",
          "type": "object"
        }
      },
      "required": [
        "group_id"
      ],
      "title": "NextAgent",
      "type": "object"
    },
    "UpdateAgent": {
      "additionalProperties": false,
      "description": "Provider upsert by ID: a missing ID may create an agent; inspect created.",
      "properties": {
        "group_id": {
          "exclusiveMinimum": 0,
          "title": "Group ID",
          "type": "integer"
        },
        "operation": {
          "const": "update_agent",
          "default": "update_agent",
          "title": "Operation",
          "type": "string"
        },
        "agent_id": {
          "exclusiveMinimum": 0,
          "title": "Agent Id",
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/AgentData"
        }
      },
      "required": [
        "group_id",
        "agent_id",
        "data"
      ],
      "title": "UpdateAgent",
      "type": "object"
    },
    "UpsertAgent": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "exclusiveMinimum": 0,
          "title": "Group ID",
          "type": "integer"
        },
        "operation": {
          "const": "upsert_agent",
          "default": "upsert_agent",
          "title": "Operation",
          "type": "string"
        },
        "filter": {
          "$ref": "#/$defs/AgentFilter"
        },
        "data": {
          "$ref": "#/$defs/AgentData"
        }
      },
      "required": [
        "group_id",
        "data"
      ],
      "title": "UpsertAgent",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "activate_agent": "#/$defs/ActivateAgent",
          "create_agent": "#/$defs/CreateAgent",
          "deactivate_agent": "#/$defs/DeactivateAgent",
          "email_next_agent": "#/$defs/EmailNextAgent",
          "get_fields": "#/$defs/GetFields",
          "list_agents": "#/$defs/ListAgents",
          "list_groups": "#/$defs/ListGroups",
          "next_agent": "#/$defs/NextAgent",
          "update_agent": "#/$defs/UpdateAgent",
          "upsert_agent": "#/$defs/UpsertAgent"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListGroups"
        },
        {
          "$ref": "#/$defs/GetFields"
        },
        {
          "$ref": "#/$defs/ListAgents"
        },
        {
          "$ref": "#/$defs/NextAgent"
        },
        {
          "$ref": "#/$defs/EmailNextAgent"
        },
        {
          "$ref": "#/$defs/UpsertAgent"
        },
        {
          "$ref": "#/$defs/CreateAgent"
        },
        {
          "$ref": "#/$defs/UpdateAgent"
        },
        {
          "$ref": "#/$defs/ActivateAgent"
        },
        {
          "$ref": "#/$defs/DeactivateAgent"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnforcedflowCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Enforcedflow Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
