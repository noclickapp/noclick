{
  "$defs": {
    "AddReceiverTags": {
      "additionalProperties": false,
      "description": "Add tags; a group ID is required by CleverReach to trigger THEA automations.",
      "properties": {
        "receiver_id": {
          "description": "Receiver ID or email address.",
          "maxLength": 320,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_@.+-]+$",
          "title": "Receiver Id",
          "type": "string"
        },
        "operation": {
          "const": "add_receiver_tags",
          "default": "add_receiver_tags",
          "title": "Operation",
          "type": "string"
        },
        "tags": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        },
        "group_id": {
          "anyOf": [
            {
              "maxLength": 320,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_@.+-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        }
      },
      "required": [
        "receiver_id",
        "tags"
      ],
      "title": "AddReceiverTags",
      "type": "object"
    },
    "CleverreachAccessTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "cleverreach_access_token",
          "default": "cleverreach_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Access token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "CleverReach Access Token",
      "type": "object",
      "x-credential-instructions": "In CleverReach, open My Account \u2192 Interfaces \u2192 REST API and use Test process now to get an API token, then paste it here. NoClick sends it as a Bearer token to rest.cleverreach.com. Use a token with access to the lists and actions you need. If it expires, replace it with a new token; NoClick does not refresh pasted tokens.",
      "x-credential-url": "https://github.com/CleverReach/php-sdk#quick-start"
    },
