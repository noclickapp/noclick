    "CreateReceiver": {
      "additionalProperties": false,
      "description": "Add a receiver. Supply only recipients whose consent you have recorded.\n\nOmitting registered/activated activates the receiver immediately, as the\nprovider documents. This action does not send a double opt-in email.",
      "properties": {
        "group_id": {
          "maxLength": 320,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_@.+-]+$",
          "title": "Group Id",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "attributes": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List-specific attribute names and values.",
          "title": "Attributes"
        },
        "global_attributes": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Global attribute names and values.",
          "title": "Global Attributes"
        },
        "operation": {
          "const": "create_receiver",
          "default": "create_receiver",
          "title": "Operation",
          "type": "string"
        },
        "email": {
          "maxLength": 254,
          "minLength": 3,
          "pattern": "^[^\\s@/]+@[^\\s@/]+\\.[^\\s@/]+$",
          "title": "Email",
          "type": "string"
        },
        "registered": {
          "anyOf": [
            {
              "maximum": 253402300799,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registered"
        },
        "activated": {
          "anyOf": [
            {
              "maximum": 253402300799,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activated"
        },
        "deactivated": {
          "anyOf": [
            {
              "maximum": 253402300799,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deactivated"
        },
        "check_blacklist": {
          "default": true,
          "title": "Check Blacklist",
          "type": "boolean"
        }
      },
      "required": [
        "group_id",
        "email"
      ],
      "title": "CreateReceiver",
      "type": "object"
    },
