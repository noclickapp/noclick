{
  "$defs": {
    "PolygonAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "polygon_api_key",
          "default": "polygon_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Polygon API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Polygon API key from the dashboard. NoClick sends it as apiKey to api.polygon.io. These legacy v1 market-data reads require the appropriate plan. Connection checks list available currencies and prove key acceptance, not account identity.",
      "x-credential-url": "https://polygon.io/dashboard/keys"
    },
    "PolygonHistoricAggregatesConfig": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "Trading day in YYYY-MM-DD format.",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timestamp offset for the next page; returned tick timestamps are preserved.",
          "title": "Offset"
        },
        "limit": {
          "default": 100,
          "description": "Maximum ticks in this request; manually request subsequent pages with offset.",
          "maximum": 10000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "symbol": {
          "description": "Stock ticker, for example AAPL.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "operation": {
          "const": "get_historic_aggregates",
          "default": "get_historic_aggregates",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "size": {
          "default": "minute",
          "description": "Aggregation interval.",
          "enum": [
            "second",
            "minute"
          ],
          "title": "Size",
          "type": "string"
        }
      },
      "required": [
        "date",
        "symbol"
      ],
      "title": "PolygonHistoricAggregatesConfig",
      "type": "object"
    },
    "PolygonHistoricForexConfig": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "Trading day in YYYY-MM-DD format.",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timestamp offset for the next page; returned tick timestamps are preserved.",
          "title": "Offset"
        },
        "limit": {
          "default": 100,
          "description": "Maximum ticks in this request; manually request subsequent pages with offset.",
          "maximum": 10000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "from_currency": {
          "description": "From currency symbol, for example USD; sent as from in the path.",
          "maxLength": 32,
          "minLength": 1,
          "title": "From Currency",
          "type": "string"
        },
        "to_currency": {
          "description": "To currency symbol, for example JPY; sent as to in the path.",
          "maxLength": 32,
          "minLength": 1,
          "title": "To Currency",
          "type": "string"
        },
        "operation": {
          "const": "get_historic_forex",
          "default": "get_historic_forex",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "date",
        "from_currency",
        "to_currency"
      ],
      "title": "PolygonHistoricForexConfig",
      "type": "object"
    },
    "PolygonHistoricQuotesConfig": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "Trading day in YYYY-MM-DD format.",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timestamp offset for the next page; returned tick timestamps are preserved.",
          "title": "Offset"
        },
        "limit": {
          "default": 100,
          "description": "Maximum ticks in this request; manually request subsequent pages with offset.",
          "maximum": 10000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "symbol": {
          "description": "Stock ticker, for example AAPL.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "operation": {
          "const": "get_historic_quotes",
          "default": "get_historic_quotes",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "date",
        "symbol"
      ],
      "title": "PolygonHistoricQuotesConfig",
      "type": "object"
    },
    "PolygonHistoricTradesConfig": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "Trading day in YYYY-MM-DD format.",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timestamp offset for the next page; returned tick timestamps are preserved.",
          "title": "Offset"
        },
        "limit": {
          "default": 100,
          "description": "Maximum ticks in this request; manually request subsequent pages with offset.",
          "maximum": 10000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "symbol": {
          "description": "Stock ticker, for example AAPL.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "operation": {
          "const": "get_historic_trades",
          "default": "get_historic_trades",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "date",
        "symbol"
      ],
      "title": "PolygonHistoricTradesConfig",
      "type": "object"
    },
    "PolygonLastForexQuoteConfig": {
      "additionalProperties": false,
      "properties": {
        "from_currency": {
          "description": "From currency symbol, for example USD; sent as from in the path.",
          "maxLength": 32,
          "minLength": 1,
          "title": "From Currency",
          "type": "string"
        },
        "to_currency": {
          "description": "To currency symbol, for example JPY; sent as to in the path.",
          "maxLength": 32,
          "minLength": 1,
          "title": "To Currency",
          "type": "string"
        },
        "operation": {
          "const": "get_last_forex_quote",
          "default": "get_last_forex_quote",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "from_currency",
        "to_currency"
      ],
      "title": "PolygonLastForexQuoteConfig",
      "type": "object"
    },
    "PolygonLastForexTradeConfig": {
      "additionalProperties": false,
      "properties": {
        "from_currency": {
          "description": "From currency symbol, for example USD; sent as from in the path.",
          "maxLength": 32,
          "minLength": 1,
          "title": "From Currency",
          "type": "string"
        },
        "to_currency": {
          "description": "To currency symbol, for example JPY; sent as to in the path.",
          "maxLength": 32,
          "minLength": 1,
          "title": "To Currency",
          "type": "string"
        },
        "operation": {
          "const": "get_last_forex_trade",
          "default": "get_last_forex_trade",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "from_currency",
        "to_currency"
      ],
      "title": "PolygonLastForexTradeConfig",
      "type": "object"
    },
    "PolygonLastStockQuoteConfig": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "description": "Stock ticker, for example AAPL.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "operation": {
          "const": "get_last_stock_quote",
          "default": "get_last_stock_quote",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "symbol"
      ],
      "title": "PolygonLastStockQuoteConfig",
      "type": "object"
    },
    "PolygonLastStockTradeConfig": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "description": "Stock ticker, for example AAPL.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "operation": {
          "const": "get_last_stock_trade",
          "default": "get_last_stock_trade",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "symbol"
      ],
      "title": "PolygonLastStockTradeConfig",
      "type": "object"
    },
    "PolygonListCompaniesConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_companies",
          "default": "list_companies",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "sort": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sort field; prefix with - for descending, for example -marketcap.",
          "title": "Sort"
        },
        "perpage": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Companies per page.",
          "title": "Perpage"
        },
        "page": {
          "default": 1,
          "description": "Page number; request subsequent pages explicitly.",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "title": "PolygonListCompaniesConfig",
      "type": "object"
    },
    "PolygonListCurrenciesConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_currencies",
          "default": "list_currencies",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "PolygonListCurrenciesConfig",
      "type": "object"
    },
    "PolygonOnNewOrUpdatedCompanyConfig": {
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_or_updated_company",
          "default": "on_new_or_updated_company",
          "title": "On New or Updated Company",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On New or Updated Company",
          "x-is-trigger": true
        },
        "perpage": {
          "default": 100,
          "description": "Watch this many most recently updated companies each poll. Increase the window or poll more frequently for busy markets. Existing records are baselined when armed.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Recent company window",
          "type": "integer"
        }
      },
      "title": "PolygonOnNewOrUpdatedCompanyConfig",
      "type": "object",
      "x-requires-webhook": true
    },
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_historic_aggregates": "#/$defs/PolygonHistoricAggregatesConfig",
          "get_historic_forex": "#/$defs/PolygonHistoricForexConfig",
          "get_historic_quotes": "#/$defs/PolygonHistoricQuotesConfig",
          "get_historic_trades": "#/$defs/PolygonHistoricTradesConfig",
          "get_last_forex_quote": "#/$defs/PolygonLastForexQuoteConfig",
          "get_last_forex_trade": "#/$defs/PolygonLastForexTradeConfig",
          "get_last_stock_quote": "#/$defs/PolygonLastStockQuoteConfig",
          "get_last_stock_trade": "#/$defs/PolygonLastStockTradeConfig",
          "list_companies": "#/$defs/PolygonListCompaniesConfig",
          "list_currencies": "#/$defs/PolygonListCurrenciesConfig",
          "on_new_or_updated_company": "#/$defs/PolygonOnNewOrUpdatedCompanyConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PolygonListCompaniesConfig"
        },
        {
          "$ref": "#/$defs/PolygonListCurrenciesConfig"
        },
        {
          "$ref": "#/$defs/PolygonHistoricAggregatesConfig"
        },
        {
          "$ref": "#/$defs/PolygonHistoricForexConfig"
        },
        {
          "$ref": "#/$defs/PolygonHistoricQuotesConfig"
        },
        {
          "$ref": "#/$defs/PolygonHistoricTradesConfig"
        },
        {
          "$ref": "#/$defs/PolygonLastForexTradeConfig"
        },
        {
          "$ref": "#/$defs/PolygonLastStockTradeConfig"
        },
        {
          "$ref": "#/$defs/PolygonLastForexQuoteConfig"
        },
        {
          "$ref": "#/$defs/PolygonLastStockQuoteConfig"
        },
        {
          "$ref": "#/$defs/PolygonOnNewOrUpdatedCompanyConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolygonAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Polygon Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
