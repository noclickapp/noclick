        }
      },
      "title": "ListTemplates",
      "type": "object"
    },
    "SetNotifyRespondent": {
      "additionalProperties": false,
      "properties": {
        "form_key": {
          "description": "Form key from List Forms or the Cabinpanda form URL.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Form Key",
          "type": "string"
        },
        "operation": {
          "const": "set_notify_respondent",
          "default": "set_notify_respondent",
          "title": "Operation",
          "type": "string"
        },
        "notify_respondent": {
          "title": "Notify Respondent",
          "type": "boolean"
        }
      },
      "required": [
        "form_key",
        "notify_respondent"
      ],
      "title": "SetNotifyRespondent",
      "type": "object"
    },
    "SubmitForm": {
      "additionalProperties": false,
      "properties": {
        "form_key": {
          "description": "Form key from List Forms or the Cabinpanda form URL.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Form Key",
          "type": "string"
        },
        "operation": {
          "const": "submit_form",
          "default": "submit_form",
          "title": "Operation",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map form field keys to submitted string values. Use an empty object for a form without input fields.",
          "title": "Fields",
          "type": "object"
        }
      },
      "required": [
        "form_key",
        "fields"
      ],
      "title": "SubmitForm",
      "type": "object"
    },
    "UpdateForm": {
      "additionalProperties": false,
      "properties": {
