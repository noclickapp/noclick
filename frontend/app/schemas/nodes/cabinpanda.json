          "description": "Form key from List Forms or the Cabinpanda form URL.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Form Key",
          "type": "string"
        },
        "operation": {
          "const": "update_form",
          "default": "update_form",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "publish": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publish"
        }
      },
      "required": [
        "form_key",
        "name"
      ],
      "title": "UpdateForm",
      "type": "object"
    },
    "UpdateTemplate": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "update_template",
          "default": "update_template",
          "title": "Operation",
          "type": "string"
        },
        "template_id": {
          "minimum": 1,
          "title": "Template Id",
          "type": "integer"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "is_public": {
          "default": false,
          "title": "Is Public",
          "type": "boolean"
        },
        "variables": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variables"
        }
      },
      "required": [
        "template_id",
        "name"
      ],
      "title": "UpdateTemplate",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_form": "#/$defs/CreateForm",
          "create_template": "#/$defs/CreateTemplate",
          "delete_form": "#/$defs/DeleteForm",
          "delete_submission": "#/$defs/DeleteSubmission",
          "get_form": "#/$defs/GetForm",
          "get_respondent_email_template": "#/$defs/GetRespondentEmailTemplate",
          "list_field_types": "#/$defs/ListFieldTypes",
          "list_form_receivers": "#/$defs/ListFormReceivers",
          "list_form_types": "#/$defs/ListFormTypes",
          "list_forms": "#/$defs/ListForms",
          "list_public_templates": "#/$defs/ListPublicTemplates",
          "list_submissions": "#/$defs/ListSubmissions",
          "list_team_members": "#/$defs/ListTeamMembers",
          "list_teams": "#/$defs/ListTeams",
          "list_templates": "#/$defs/ListTemplates",
          "set_notify_respondent": "#/$defs/SetNotifyRespondent",
          "submit_form": "#/$defs/SubmitForm",
          "update_form": "#/$defs/UpdateForm",
          "update_template": "#/$defs/UpdateTemplate"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListForms"
        },
        {
          "$ref": "#/$defs/GetForm"
        },
        {
          "$ref": "#/$defs/CreateForm"
        },
        {
          "$ref": "#/$defs/UpdateForm"
        },
        {
          "$ref": "#/$defs/DeleteForm"
        },
        {
          "$ref": "#/$defs/ListSubmissions"
        },
        {
          "$ref": "#/$defs/SubmitForm"
        },
        {
          "$ref": "#/$defs/DeleteSubmission"
        },
        {
          "$ref": "#/$defs/ListFormReceivers"
        },
        {
          "$ref": "#/$defs/ListFormTypes"
        },
        {
          "$ref": "#/$defs/ListFieldTypes"
        },
        {
          "$ref": "#/$defs/ListTemplates"
        },
        {
          "$ref": "#/$defs/ListPublicTemplates"
        },
        {
          "$ref": "#/$defs/CreateTemplate"
        },
        {
          "$ref": "#/$defs/UpdateTemplate"
        },
        {
          "$ref": "#/$defs/SetNotifyRespondent"
        },
        {
          "$ref": "#/$defs/GetRespondentEmailTemplate"
        },
        {
          "$ref": "#/$defs/ListTeamMembers"
        },
        {
          "$ref": "#/$defs/ListTeams"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/CabinpandaAPITokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Cabinpanda Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
