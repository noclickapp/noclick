{
  "$defs": {
    "CabinpandaAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "cabinpanda_api_token",
          "default": "cabinpanda_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Cabinpanda API Token",
      "type": "object",
      "x-credential-instructions": "In Cabinpanda, open Profile > API and create a token. Paste the token without the Bearer prefix. Connecting reads your forms from the production account.",
      "x-credential-url": "https://dashboard.cabinpanda.com",
      "x-help-url": "https://api.cabinpanda.com/api/docs/swagger.yaml"
    },
    "CreateForm": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_form",
          "default": "create_form",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "template_id": {
          "minimum": 1,
          "title": "Template Id",
          "type": "integer"
        },
        "type_id": {
          "minimum": 1,
          "title": "Type Id",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "template_id",
        "type_id"
      ],
      "title": "CreateForm",
      "type": "object"
    },
    "CreateTemplate": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_template",
          "default": "create_template",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "is_public": {
          "default": false,
          "title": "Is Public",
          "type": "boolean"
        },
        "variables": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variables"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateTemplate",
      "type": "object"
    },
    "DeleteForm": {
      "additionalProperties": false,
      "properties": {
        "form_key": {
          "description": "Form key from List Forms or the Cabinpanda form URL.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Form Key",
          "type": "string"
        },
        "operation": {
          "const": "delete_form",
          "default": "delete_form",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "form_key"
      ],
      "title": "DeleteForm",
      "type": "object"
    },
    "DeleteSubmission": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "delete_submission",
          "default": "delete_submission",
          "title": "Operation",
          "type": "string"
        },
        "submission_id": {
          "minimum": 1,
          "title": "Submission Id",
          "type": "integer"
        }
      },
      "required": [
        "submission_id"
      ],
      "title": "DeleteSubmission",
      "type": "object"
    },
    "GetForm": {
      "additionalProperties": false,
      "properties": {
        "form_key": {
          "description": "Form key from List Forms or the Cabinpanda form URL.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Form Key",
          "type": "string"
        },
        "operation": {
          "const": "get_form",
          "default": "get_form",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "form_key"
      ],
      "title": "GetForm",
      "type": "object"
    },
    "GetRespondentEmailTemplate": {
      "additionalProperties": false,
      "properties": {
        "form_key": {
          "description": "Form key from List Forms or the Cabinpanda form URL.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Form Key",
          "type": "string"
        },
        "operation": {
          "const": "get_respondent_email_template",
          "default": "get_respondent_email_template",
