          "type": "string"
        }
      },
      "required": [
        "form_key"
      ],
      "title": "GetRespondentEmailTemplate",
      "type": "object"
    },
    "ListFieldTypes": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_field_types",
          "default": "list_field_types",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListFieldTypes",
      "type": "object"
    },
    "ListFormReceivers": {
      "additionalProperties": false,
      "properties": {
        "form_key": {
          "description": "Form key from List Forms or the Cabinpanda form URL.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Form Key",
          "type": "string"
        },
        "operation": {
          "const": "list_form_receivers",
          "default": "list_form_receivers",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "form_key"
      ],
      "title": "ListFormReceivers",
      "type": "object"
    },
    "ListFormTypes": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_form_types",
          "default": "list_form_types",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListFormTypes",
      "type": "object"
    },
    "ListForms": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "default": 1,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 25,
          "description": "Page size; request subsequent pages explicitly.",
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "operation": {
          "const": "list_forms",
          "default": "list_forms",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListForms",
      "type": "object"
    },
    "ListPublicTemplates": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_public_templates",
          "default": "list_public_templates",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListPublicTemplates",
      "type": "object"
    },
    "ListSubmissions": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "default": 1,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 25,
          "description": "Page size; request subsequent pages explicitly.",
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "form_key": {
          "description": "Form key from List Forms or the Cabinpanda form URL.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Form Key",
          "type": "string"
        },
        "operation": {
          "const": "list_submissions",
          "default": "list_submissions",
          "title": "Operation",
          "type": "string"
        },
        "search": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "finish": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish"
        }
      },
      "required": [
        "form_key"
      ],
      "title": "ListSubmissions",
      "type": "object"
    },
    "ListTeamMembers": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_team_members",
          "default": "list_team_members",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListTeamMembers",
      "type": "object"
    },
    "ListTeams": {
      "additionalProperties": false,
      "properties": {
        "operation": {
