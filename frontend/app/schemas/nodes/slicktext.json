    "SlickTextCreateCampaignConfig": {
      "additionalProperties": false,
      "description": "Create campaign.",
      "properties": {
        "brand_id": {
          "description": "Brand ID returned by Get brand.",
          "exclusiveMinimum": 0,
          "title": "Brand Id",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "media_url": {
          "anyOf": [
            {
              "pattern": "^https?://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Url"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "scheduled",
            "send"
          ],
          "title": "Status",
          "type": "string"
        },
        "scheduled": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider date/time YYYY-MM-DD HH:MM:SS.",
          "title": "Scheduled"
        },
        "audience": {
          "$ref": "#/$defs/SlickTextAudience"
        },
        "operation": {
          "const": "create_campaign",
          "default": "create_campaign",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "brand_id",
        "name",
        "body",
        "audience"
      ],
      "title": "SlickTextCreateCampaignConfig",
      "type": "object"
    },
    "SlickTextCreateContactConfig": {
      "additionalProperties": false,
      "description": "Create contact.",
      "properties": {
        "brand_id": {
          "description": "Brand ID returned by Get brand.",
          "exclusiveMinimum": 0,
          "title": "Brand Id",
          "type": "integer"
        },
        "mobile_number": {
          "pattern": "^\\+?[0-9]{10,15}$",
          "title": "Mobile Number",
          "type": "string"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "email": {
          "anyOf": [
            {
              "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "birthdate": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Birthdate"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "zip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zip"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "timezone": {
          "anyOf": [
            {
              "enum": [
                "America/New_York",
                "America/Chicago",
                "America/Denver",
                "America/Los_Angeles"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone",
          "enum": [
            "America/New_York",
            "America/Chicago",
            "America/Denver",
            "America/Los_Angeles"
          ],
          "x-enum-searchable": true
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "opt_in_status": {
          "anyOf": [
            {
              "enum": [
                "not subscribed",
                "subscribed",
                "unsubscribed",
                "blocked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set subscribed only for contacts who explicitly consented to text messages.",
          "title": "Opt In Status",
          "enum": [
            "not subscribed",
            "subscribed",
            "unsubscribed",
            "blocked"
          ],
          "x-enum-searchable": true
        },
        "custom_fields": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Internal custom field names and values; sent as top-level request fields.",
          "title": "Custom Fields"
        },
        "operation": {
          "const": "create_contact",
          "default": "create_contact",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "force_double_opt_in": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Force Double Opt In"
        }
      },
      "required": [
        "brand_id",
        "mobile_number"
      ],
      "title": "SlickTextCreateContactConfig",
      "type": "object"
    },
