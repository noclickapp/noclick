          "minItems": 1,
          "title": "Contacts",
          "type": "array"
        },
        "operation": {
          "const": "add_contacts_to_lists",
          "default": "add_contacts_to_lists",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "brand_id",
        "contacts"
      ],
      "title": "SlickTextAddContactsToListsConfig",
      "type": "object"
    },
    "SlickTextAudience": {
      "additionalProperties": false,
      "properties": {
        "segments": {
          "anyOf": [
            {
              "items": {
                "exclusiveMinimum": 0,
