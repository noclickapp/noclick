{
  "$defs": {
    "AdvancedImageConfig": {
      "description": "Run forensic analysis on a public image. Costs 500 credits.",
      "properties": {
        "operation": {
          "const": "analyze_image_forensics",
          "default": "analyze_image_forensics",
          "title": "Operation",
          "type": "string"
        },
        "image_url": {
          "format": "uri",
          "title": "Image URL",
          "type": "string"
        }
      },
      "required": [
        "image_url"
      ],
      "title": "AdvancedImageConfig",
      "type": "object"
    },
    "CheckConnectionConfig": {
      "description": "List MCP tools without invoking them or spending analysis credits.",
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "CheckConnectionConfig",
      "type": "object"
    },
    "CompareTextConfig": {
      "description": "Compare two texts. Costs half the total word count in credits.",
      "properties": {
        "operation": {
          "const": "compare_texts",
          "default": "compare_texts",
          "title": "Operation",
          "type": "string"
        },
        "first_text": {
          "maxLength": 120000,
          "minLength": 1,
          "title": "First Text",
          "type": "string"
        },
        "second_text": {
          "maxLength": 120000,
          "minLength": 1,
          "title": "Second Text",
          "type": "string"
        }
      },
      "required": [
        "first_text",
        "second_text"
      ],
      "title": "CompareTextConfig",
      "type": "object"
    },
    "DetectFileConfig": {
      "description": "Detect AI-generated content in a public PDF, DOC or DOCX.",
      "properties": {
        "language": {
          "default": "auto",
          "description": "Supported two-letter language code, or auto.",
          "pattern": "^(auto|[a-z]{2})$",
          "title": "Language",
          "type": "string"
        },
        "version": {
          "default": "latest",
          "description": "Winston text detection model version, e.g. 5.2 or latest.",
          "title": "Version",
          "type": "string"
        },
        "sentences": {
          "default": true,
          "description": "Include sentence-level scores.",
          "title": "Sentences",
          "type": "boolean"
        },
        "operation": {
          "const": "detect_ai_file",
          "default": "detect_ai_file",
          "title": "Operation",
          "type": "string"
        },
        "file_url": {
          "description": "Public PDF, DOC or DOCX URL.",
          "format": "uri",
          "title": "File URL",
          "type": "string"
        }
      },
      "required": [
        "file_url"
      ],
      "title": "DetectFileConfig",
      "type": "object"
    },
    "DetectTextConfig": {
      "description": "Detect AI-generated text. Consumes one credit per word.",
      "properties": {
        "language": {
          "default": "auto",
          "description": "Supported two-letter language code, or auto.",
          "pattern": "^(auto|[a-z]{2})$",
          "title": "Language",
          "type": "string"
        },
        "version": {
          "default": "latest",
          "description": "Winston text detection model version, e.g. 5.2 or latest.",
          "title": "Version",
          "type": "string"
        },
        "sentences": {
          "default": true,
          "description": "Include sentence-level scores.",
          "title": "Sentences",
          "type": "boolean"
        },
        "operation": {
          "const": "detect_ai_text",
          "default": "detect_ai_text",
          "title": "Operation",
          "type": "string"
        },
        "text": {
          "description": "Text to analyze; 600+ characters recommended.",
          "maxLength": 150000,
          "minLength": 300,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "DetectTextConfig",
      "type": "object"
    },
    "DetectWebsiteConfig": {
      "description": "Detect AI-generated content on a public webpage.",
      "properties": {
        "language": {
          "default": "auto",
          "description": "Supported two-letter language code, or auto.",
          "pattern": "^(auto|[a-z]{2})$",
          "title": "Language",
          "type": "string"
        },
        "version": {
          "default": "latest",
          "description": "Winston text detection model version, e.g. 5.2 or latest.",
          "title": "Version",
          "type": "string"
        },
        "sentences": {
          "default": true,
          "description": "Include sentence-level scores.",
          "title": "Sentences",
          "type": "boolean"
        },
        "operation": {
          "const": "detect_ai_website",
          "default": "detect_ai_website",
          "title": "Operation",
          "type": "string"
        },
        "website": {
          "format": "uri",
          "title": "Website URL",
          "type": "string"
        }
      },
      "required": [
        "website"
      ],
      "title": "DetectWebsiteConfig",
      "type": "object"
    },
    "FactCheckConfig": {
      "description": "Fact-check text against trusted sources. Consumes two credits per word.",
      "properties": {
        "operation": {
          "const": "fact_check_text",
          "default": "fact_check_text",
          "title": "Operation",
          "type": "string"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 300,
          "title": "Text",
          "type": "string"
        },
        "language": {
          "default": "auto",
          "pattern": "^(auto|[a-z]{2})$",
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "FactCheckConfig",
      "type": "object"
    },
    "ImageDataConfig": {
      "description": "Detect AI-generated images from existing encoded image data. Costs 300 credits.",
      "properties": {
        "operation": {
          "const": "detect_ai_image_data",
          "default": "detect_ai_image_data",
          "title": "Operation",
          "type": "string"
        },
        "image": {
          "description": "Base64 image or data:image/...;base64,... supplied by your workflow. Original file about 4 MB or less.",
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "version": {
          "default": "latest",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "image"
      ],
      "title": "ImageDataConfig",
      "type": "object"
    },
    "ImageURLConfig": {
      "description": "Detect AI-generated images from a public URL. Costs 300 credits.",
      "properties": {
        "operation": {
          "const": "detect_ai_image_url",
          "default": "detect_ai_image_url",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "description": "Public JPG, JPEG, PNG or WEBP, at least 256 by 256 pixels.",
          "format": "uri",
          "title": "Url",
          "type": "string"
        },
        "version": {
          "default": "latest",
          "description": "Image model version, e.g. 5 or latest.",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "ImageURLConfig",
      "type": "object"
    },
    "PlagiarismFileConfig": {
      "description": "Check a public PDF, DOC or DOCX for plagiarism.",
      "properties": {
        "language": {
          "default": "auto",
          "pattern": "^(auto|[a-z]{2})$",
          "title": "Language",
          "type": "string"
        },
        "country": {
          "default": "us",
          "pattern": "^[a-z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "excluded_sources": {
          "description": "Case-sensitive domains or URLs to exclude.",
          "items": {
            "type": "string"
          },
          "title": "Excluded Sources",
          "type": "array"
        },
        "operation": {
          "const": "check_plagiarism_file",
          "default": "check_plagiarism_file",
          "title": "Operation",
          "type": "string"
        },
        "file_url": {
          "format": "uri",
          "title": "File URL",
          "type": "string"
        }
      },
      "required": [
        "file_url"
      ],
      "title": "PlagiarismFileConfig",
      "type": "object"
    },
    "PlagiarismTextConfig": {
      "description": "Check text for plagiarism. Consumes two credits per word.",
      "properties": {
        "language": {
          "default": "auto",
          "pattern": "^(auto|[a-z]{2})$",
          "title": "Language",
          "type": "string"
        },
        "country": {
          "default": "us",
          "pattern": "^[a-z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "excluded_sources": {
          "description": "Case-sensitive domains or URLs to exclude.",
          "items": {
            "type": "string"
          },
          "title": "Excluded Sources",
          "type": "array"
        },
        "operation": {
          "const": "check_plagiarism_text",
          "default": "check_plagiarism_text",
          "title": "Operation",
          "type": "string"
        },
        "text": {
          "maxLength": 120000,
          "minLength": 100,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "PlagiarismTextConfig",
      "type": "object"
    },
    "PlagiarismWebsiteConfig": {
      "description": "Check a public webpage for plagiarism.",
      "properties": {
        "language": {
          "default": "auto",
          "pattern": "^(auto|[a-z]{2})$",
          "title": "Language",
          "type": "string"
        },
        "country": {
          "default": "us",
          "pattern": "^[a-z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "excluded_sources": {
          "description": "Case-sensitive domains or URLs to exclude.",
          "items": {
            "type": "string"
          },
          "title": "Excluded Sources",
          "type": "array"
        },
        "operation": {
          "const": "check_plagiarism_website",
          "default": "check_plagiarism_website",
          "title": "Operation",
          "type": "string"
        },
        "website": {
          "format": "uri",
          "title": "Website URL",
          "type": "string"
        }
      },
      "required": [
        "website"
      ],
      "title": "PlagiarismWebsiteConfig",
      "type": "object"
    },
    "WinstonAIApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "winston_ai_api_key",
          "default": "winston_ai_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Winston AI API Key",
      "type": "object",
      "x-credential-instructions": "Create an API token in the Winston AI developer dashboard and paste it here. Analysis actions consume your Winston credits. The connection check only lists MCP tools to verify key acceptance; it does not run an analysis or identify your account.",
      "x-credential-url": "https://dev.gowinston.ai"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "analyze_image_forensics": "#/$defs/AdvancedImageConfig",
          "check_connection": "#/$defs/CheckConnectionConfig",
          "check_plagiarism_file": "#/$defs/PlagiarismFileConfig",
          "check_plagiarism_text": "#/$defs/PlagiarismTextConfig",
          "check_plagiarism_website": "#/$defs/PlagiarismWebsiteConfig",
          "compare_texts": "#/$defs/CompareTextConfig",
          "detect_ai_file": "#/$defs/DetectFileConfig",
          "detect_ai_image_data": "#/$defs/ImageDataConfig",
          "detect_ai_image_url": "#/$defs/ImageURLConfig",
          "detect_ai_text": "#/$defs/DetectTextConfig",
          "detect_ai_website": "#/$defs/DetectWebsiteConfig",
          "fact_check_text": "#/$defs/FactCheckConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DetectTextConfig"
        },
        {
          "$ref": "#/$defs/DetectFileConfig"
        },
        {
          "$ref": "#/$defs/DetectWebsiteConfig"
        },
        {
          "$ref": "#/$defs/PlagiarismTextConfig"
        },
        {
          "$ref": "#/$defs/PlagiarismFileConfig"
        },
        {
          "$ref": "#/$defs/PlagiarismWebsiteConfig"
        },
        {
          "$ref": "#/$defs/FactCheckConfig"
        },
        {
          "$ref": "#/$defs/ImageURLConfig"
        },
        {
          "$ref": "#/$defs/ImageDataConfig"
        },
        {
          "$ref": "#/$defs/AdvancedImageConfig"
        },
        {
          "$ref": "#/$defs/CompareTextConfig"
        },
        {
          "$ref": "#/$defs/CheckConnectionConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/WinstonAIApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Winston-ai Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
