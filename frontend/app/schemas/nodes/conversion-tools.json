{
  "$defs": {
    "ConversionToolsAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "conversion_tools_api_token",
          "default": "conversion_tools_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Conversion Tools API Token",
      "type": "object",
      "x-credential-instructions": "Copy the API token from your Conversion Tools Profile and paste it here. NoClick sends it as a Bearer token to api.conversiontools.io and checks your account with GET /auth. Creating tasks uses your quota unless options include sandbox: true. Retention changes and deleting task files may require a paid plan.",
      "x-credential-url": "https://conversiontools.io/profile"
    },
    "CreateTask": {
      "additionalProperties": false,
      "description": "Start a conversion; the returned task ID can be polled separately.",
      "properties": {
        "operation": {
          "const": "create_task",
          "default": "create_task",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "conversion_type": {
          "description": "Type from List conversions, e.g. convert.xml_to_excel.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
          "title": "Conversion Type",
          "type": "string"
        },
        "options_json": {
          "description": "JSON object from the conversion definition, including file_id or url. Add \"sandbox\": true for free sandbox testing. Multi-file conversions use their documented file input keys.",
          "title": "Conversion options (JSON)",
          "type": "string",
          "ui:language": "json",
          "ui:widget": "code_editor"
        },
        "callback_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional HTTP(S) URL for the provider to notify when the task completes.",
          "title": "Completion webhook URL"
        }
      },
      "required": [
        "conversion_type",
        "options_json"
      ],
      "title": "CreateTask",
      "type": "object"
    },
    "DeleteTaskFiles": {
      "additionalProperties": false,
      "description": "Schedule irreversible removal of source, result and artifact files (paid).",
      "properties": {
        "operation": {
          "const": "delete_task_files",
          "default": "delete_task_files",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "DeleteTaskFiles",
      "type": "object"
    },
    "DownloadFile": {
      "additionalProperties": false,
      "description": "Download source or converted bytes using a file ID.",
      "properties": {
        "operation": {
          "const": "download_file",
          "default": "download_file",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "DownloadFile",
      "type": "object"
    },
    "GetAuthInfo": {
      "additionalProperties": false,
      "description": "Read the authenticated account email to verify the pasted token.",
      "properties": {
        "operation": {
          "const": "get_auth_info",
          "default": "get_auth_info",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetAuthInfo",
      "type": "object"
    },
    "GetConfig": {
      "additionalProperties": false,
      "description": "Read custom and published AI Studio converters enabled for the account.",
      "properties": {
        "operation": {
          "const": "get_config",
          "default": "get_config",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetConfig",
      "type": "object"
    },
    "GetConversion": {
      "additionalProperties": false,
      "description": "Read a public conversion definition, options and multi-file inputs.",
      "properties": {
        "operation": {
          "const": "get_conversion",
          "default": "get_conversion",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "conversion_type": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
          "title": "Conversion Type",
          "type": "string"
        }
      },
      "required": [
        "conversion_type"
      ],
      "title": "GetConversion",
      "type": "object"
    },
    "GetFileInfo": {
      "additionalProperties": false,
      "description": "Read file size, name and available text preview.",
      "properties": {
        "operation": {
          "const": "get_file_info",
          "default": "get_file_info",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetFileInfo",
      "type": "object"
    },
    "GetTaskStatus": {
      "additionalProperties": false,
      "description": "Poll one task; SUCCESS provides a file ID, ERROR includes the failure.",
      "properties": {
        "operation": {
          "const": "get_task_status",
          "default": "get_task_status",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "GetTaskStatus",
      "type": "object"
    },
    "ListConversions": {
      "additionalProperties": false,
      "description": "Browse the public conversion catalog and supported format options.",
      "properties": {
        "operation": {
          "const": "list_conversions",
          "default": "list_conversions",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "input_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Format or alias such as xml or pdf.",
          "title": "Input format"
        },
        "output_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Format or alias such as excel or xlsx.",
          "title": "Output format"
        },
        "ai": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Yes: AI conversions only; No: exclude AI; Default: both.",
          "title": "Ai"
        }
      },
      "title": "ListConversions",
      "type": "object"
    },
    "ListTasks": {
      "additionalProperties": false,
      "description": "List up to the 50 most recent account tasks; no pagination is documented.",
      "properties": {
        "operation": {
          "const": "list_tasks",
          "default": "list_tasks",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "PENDING",
                "RUNNING",
                "SUCCESS",
                "ERROR"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "PENDING",
            "RUNNING",
            "SUCCESS",
            "ERROR"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "ListTasks",
      "type": "object"
    },
    "UpdateTaskRetention": {
      "additionalProperties": false,
      "description": "Change artifact lifetime; 15-minute retention requires a paid plan.",
      "properties": {
        "operation": {
          "const": "update_task_retention",
          "default": "update_task_retention",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
          "title": "Task Id",
          "type": "string"
        },
        "retention_mode": {
          "enum": [
            "standard_24h",
            "ttl_15m"
          ],
          "title": "Retention mode",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "retention_mode"
      ],
      "title": "UpdateTaskRetention",
      "type": "object"
    },
    "UploadFile": {
      "additionalProperties": false,
      "description": "Upload arbitrary file bytes as multipart data without consuming task quota.",
      "properties": {
        "operation": {
          "const": "upload_file",
          "default": "upload_file",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_base64": {
          "contentEncoding": "base64",
          "contentMediaType": "application/octet-stream",
          "description": "Base64-encoded file bytes, without a data URL prefix. Maximum decoded size is 50 MiB; the provider plan may allow less.",
          "maxLength": 70000000,
          "minLength": 1,
          "title": "File contents (base64)",
          "type": "string"
        },
        "filename": {
          "default": "input.bin",
          "maxLength": 255,
          "pattern": "^[^/\\\\\\r\\n]+$",
          "title": "File name",
          "type": "string"
        }
      },
      "required": [
        "file_base64"
      ],
      "title": "UploadFile",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_task": "#/$defs/CreateTask",
          "delete_task_files": "#/$defs/DeleteTaskFiles",
          "download_file": "#/$defs/DownloadFile",
          "get_auth_info": "#/$defs/GetAuthInfo",
          "get_config": "#/$defs/GetConfig",
          "get_conversion": "#/$defs/GetConversion",
          "get_file_info": "#/$defs/GetFileInfo",
          "get_task_status": "#/$defs/GetTaskStatus",
          "list_conversions": "#/$defs/ListConversions",
          "list_tasks": "#/$defs/ListTasks",
          "update_task_retention": "#/$defs/UpdateTaskRetention",
          "upload_file": "#/$defs/UploadFile"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/UploadFile"
        },
        {
          "$ref": "#/$defs/DownloadFile"
        },
        {
          "$ref": "#/$defs/GetFileInfo"
        },
        {
          "$ref": "#/$defs/CreateTask"
        },
        {
          "$ref": "#/$defs/ListTasks"
        },
        {
          "$ref": "#/$defs/GetTaskStatus"
        },
        {
          "$ref": "#/$defs/UpdateTaskRetention"
        },
        {
          "$ref": "#/$defs/DeleteTaskFiles"
        },
        {
          "$ref": "#/$defs/GetConfig"
        },
        {
          "$ref": "#/$defs/ListConversions"
        },
        {
          "$ref": "#/$defs/GetConversion"
        },
        {
          "$ref": "#/$defs/GetAuthInfo"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConversionToolsAPITokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Conversion-tools Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
