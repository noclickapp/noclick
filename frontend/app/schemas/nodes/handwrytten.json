    "HandwryttenSendCardConfig": {
      "additionalProperties": false,
      "description": "Send and pay for a physical handwritten card using a saved payment method. No automatic retries.",
      "properties": {
        "operation": {
          "const": "send_card",
          "default": "send_card",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "card_id": {
          "description": "the id of the card you want to send",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Card Id",
          "type": "integer"
        },
        "denomination_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional. Use if sending a gift card",
          "title": "Denomination Id"
        },
        "message": {
          "description": "the full message body. Use '\\n' for new lines",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "font_label": {
          "description": "the colloquial name of the font, such as 'Fancy Jenna' or 'Casual David'",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Font Label",
          "type": "string"
        },
        "sender_name": {
          "description": "the name on the return address",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Sender Name",
          "type": "string"
        },
        "sender_business_name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the second line of the return address. Optional.",
          "title": "Sender Business Name"
        },
        "sender_address1": {
          "description": "the first address line of the return address",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Sender Address1",
          "type": "string"
        },
        "sender_address2": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the second line of the address, such as suite, apartment, building, etc. Optional",
          "title": "Sender Address2"
        },
        "sender_city": {
          "description": "the city of the sender, to appear in the return address",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Sender City",
          "type": "string"
        },
        "sender_state": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the ABBREVIATED state or province of the sender. This is required for US and Canada addresses and optional for all other countries",
          "title": "Sender State"
        },
        "sender_zip": {
          "description": "The postal code or zip code of the sender.",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Sender Zip",
          "type": "string"
        },
        "sender_country": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the country of the recipient. Optional and defaults to usa",
          "title": "Sender Country"
        },
        "sender_country_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "alternate way to specify country. Optional and defaults to 1",
          "title": "Sender Country Id"
        },
        "recipient_name": {
          "description": "the name on the recipient address",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Recipient Name",
          "type": "string"
        },
        "recipient_business_name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the second line of the recipient address. Optional.",
          "title": "Recipient Business Name"
        },
        "recipient_address1": {
          "description": "the first address line of the return address",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Recipient Address1",
          "type": "string"
        },
        "recipient_address2": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the second line of the address, such as suite, apartment, building, etc. Optional",
          "title": "Recipient Address2"
        },
        "recipient_city": {
          "description": "the city of the recipient, to appear in the address",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Recipient City",
          "type": "string"
        },
        "recipient_state": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the ABBREVIATED state or province of the recipient. This is required for US and Canada addresses and optional for all other countries",
          "title": "Recipient State"
        },
        "recipient_zip": {
          "description": "the zip code or postal code of the recipient",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Recipient Zip",
          "type": "string"
        },
        "recipient_country": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the country of the recipient. Optional and defaults to usa",
          "title": "Recipient Country"
        },
        "recipient_country_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "alternate way to specify country. Optional and defaults to 1",
          "title": "Recipient Country Id"
        },
        "credit_card_id": {
          "description": "the credit card id to charge for the order. Currently this is required, even for invoiced accounts, it just won't be charged.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Credit Card Id",
          "type": "integer"
        }
      },
      "required": [
        "card_id",
        "message",
        "font_label",
        "sender_name",
        "sender_address1",
        "sender_city",
        "sender_zip",
        "recipient_name",
        "recipient_address1",
        "recipient_city",
        "recipient_zip",
        "credit_card_id"
      ],
      "title": "HandwryttenSendCardConfig",
      "type": "object"
    },
    "HandwryttenSessionToken": {
