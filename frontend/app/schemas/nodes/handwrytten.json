{
  "$defs": {
    "HandwryttenCreateCustomCardConfig": {
      "additionalProperties": false,
      "description": "Create a new custom card.",
      "properties": {
        "operation": {
          "const": "create_custom_card",
          "default": "create_custom_card",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "card_id": {
          "description": "the card id of the card template you're starting with. You can find this by logging into Handwrytten, clicking \"customize\" next to any customizable card, and pulling the card ID from the end of the URL",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Card Id",
          "type": "integer"
        },
        "name": {
          "description": "the name of the new card",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "description": "Defines the top of the back of the card. Set to either \"logo\" or \"text\".",
          "enum": [
            "logo",
            "text"
          ],
          "title": "Type",
          "type": "string"
        },
        "logo_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional. If setting \"type\" to \"logo\", set the id of the logo here.",
          "title": "Logo Id"
        },
        "header_align": {
          "anyOf": [
            {
              "enum": [
                "left",
                "center",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set to \"left\", \"center\", or \"right\" to align the header appropriately",
          "title": "Header Align",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "x-enum-searchable": true
        },
        "header_text": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "text in the header, if type is set to \"text\"",
          "title": "Header Text"
        },
        "header_font_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "font ID of the text in the header, found by using ListFontForCustomizer",
          "title": "Header Font Id"
        },
        "header_font_size": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "font size of the text in the header of the card",
          "title": "Header Font Size"
        },
        "header_auto_size": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "if set to true, the header will be maximized to fill the header area",
          "title": "Header Auto Size"
        },
        "footer_text": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "optional text for the footer of the customizable card",
          "title": "Footer Text"
        },
        "footer_align": {
          "anyOf": [
            {
              "enum": [
                "left",
                "center",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set to \"left\", \"center\", or \"right\" to align the footer appropriately",
          "title": "Footer Align",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "x-enum-searchable": true
        },
        "footer_font_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "font ID of the text in the footer, found by using ListFontForCustomizer",
          "title": "Footer Font Id"
        },
        "footer_font_size": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Font size of the text in the footer",
          "title": "Footer Font Size"
        },
        "logo_size_percent": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set to the desired scaling of the logo on the header",
          "title": "Logo Size Percent"
        },
        "cover_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the id of the image you want to use for the \"cover\". The cover is the large image on the front of the flat card.",
          "title": "Cover Id"
        },
        "cover_size_percent": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the size of the image to use as the cover.",
          "title": "Cover Size Percent"
        }
      },
      "required": [
        "card_id",
        "name",
        "type"
      ],
      "title": "HandwryttenCreateCustomCardConfig",
      "type": "object"
    },
    "HandwryttenCreateRecipientConfig": {
      "additionalProperties": false,
      "description": "add a new recipient address.",
      "properties": {
        "operation": {
          "const": "create_recipient",
          "default": "create_recipient",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "description": "the name on the address",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "business_name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the optional business name on the address",
          "title": "Business Name"
        },
        "address1": {
          "description": "the first line of the address",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Address1",
          "type": "string"
        },
        "address2": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the second (optional) line of the address",
          "title": "Address2"
        },
        "city": {
          "description": "the city of the address",
          "maxLength": 1000,
          "minLength": 1,
          "title": "City",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the abbreviated state or province of the address",
          "title": "State"
        },
        "zip": {
          "description": "the zip or postal code of the address",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Zip",
          "type": "string"
        },
        "country": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the name of the country of the address, or use country_id",
          "title": "Country"
        },
        "country_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the country id code of the recipient",
          "title": "Country Id"
        }
      },
      "required": [
        "name",
        "address1",
        "city",
        "zip"
      ],
      "title": "HandwryttenCreateRecipientConfig",
      "type": "object"
    },
    "HandwryttenCreateTemplateConfig": {
      "additionalProperties": false,
