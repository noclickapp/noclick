  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "enrich_batch": "#/$defs/DropcontactEnrichBatchConfig",
          "enrich_contact": "#/$defs/DropcontactEnrichContactConfig",
          "get_credits": "#/$defs/DropcontactCreditsConfig",
          "get_results": "#/$defs/DropcontactGetResultsConfig",
          "get_status": "#/$defs/DropcontactGetStatusConfig",
          "test_connection": "#/$defs/DropcontactCheckConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DropcontactCheckConfig"
        },
        {
          "$ref": "#/$defs/DropcontactCreditsConfig"
        },
        {
