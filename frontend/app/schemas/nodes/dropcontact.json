          "default": null,
          "description": "Optional dictionary of strings preserved by the API; no nested values, callbacks or arbitrary request fields.",
          "title": "Custom Fields (JSON)",
          "ui:widget": "textarea"
        }
      },
      "title": "DropcontactEnrichContactConfig",
      "type": "object"
    },
    "DropcontactGetResultsConfig": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "description": "Exact returned or supplied request ID. Lookup checks that one protected route; the API has no documented history list. No original-submission ancestry is inferred.",
          "title": "Existing Request ID",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Exact existing request ID",
            "field_name": "request_id",
            "placeholder": "Paste the full existing request ID",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-id-path": "request_id",
          "x-resource-type": "dropcontact_request"
        },
        "expected_contact_count": {
          "anyOf": [
            {
              "maximum": 250,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional caller-known batch size. Reports missing response rows without inventing IDs, original order or submission ancestry.",
          "title": "Expected Contact Count"
        },
        "operation": {
          "const": "get_results",
          "default": "get_results",
          "title": "Read Existing Enrichment Results Once",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Results",
          "x-display-name": "Read Existing Enrichment Results Once",
          "x-is-trigger": false
        },
        "include_contact_data": {
          "default": false,
          "description": "Opt in to private supported contact/company result fields; no unknown output fields or raw diagnostics.",
          "title": "Include Contact Data",
          "type": "boolean"
        },
        "include_custom_fields": {
          "default": false,
          "description": "Opt in to returned string custom fields, which can contain private data; omitted by default.",
          "title": "Include Custom Fields",
          "type": "boolean"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "DropcontactGetResultsConfig",
      "type": "object"
