    },
    "DropcontactEnrichBatchConfig": {
      "additionalProperties": false,
      "properties": {
        "siren": {
          "default": false,
          "description": "Request documented French company information; availability is provider-dependent.",
          "title": "Siren",
          "type": "boolean"
        },
        "language": {
          "default": "en",
          "description": "English sends language=en; French omits language and uses the documented provider default.",
          "enum": [
            "en",
            "fr"
          ],
          "title": "Language",
          "type": "string"
        },
        "confirm_existing_credits": {
          "default": false,
          "description": "Confirm processing owned B2B contacts with existing credits. Verification/enrichment may consume credits; no purchase, immediate refund or silent webhook-effect guarantee.",
          "title": "Confirm Existing Credits",
          "type": "boolean"
        },
        "operation": {
          "const": "enrich_batch",
          "default": "enrich_batch",
          "title": "Submit Owned B2B Batch",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Enrichment",
          "x-display-name": "Submit Owned B2B Batch",
          "x-is-trigger": false
        },
        "contacts_json": {
          "description": "1\u2013250 closed supported contact objects, each exact compact on-wire UTF8 JSON below 15000 bytes. Every contact requires company context and a supported contact identity combination.",
          "maxLength": 4194304,
          "title": "Contacts (JSON Array)",
          "type": "string",
          "ui:widget": "textarea"
        }
      },
      "required": [
        "contacts_json"
      ],
      "title": "DropcontactEnrichBatchConfig",
      "type": "object"
    },
