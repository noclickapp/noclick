        "monitor_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Monitor Id",
          "type": "string"
        },
        "operation": {
          "const": "get_monitor_run",
          "default": "get_monitor_run",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "run_id": {
          "maxLength": 200,
          "minLength": 1,
