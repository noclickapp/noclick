    "GetUsageHistory": {
      "description": "Read usage buckets; omitted dates use the provider's documented window.",
      "properties": {
        "operation": {
          "const": "get_usage_history",
          "default": "get_usage_history",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "interval": {
          "default": "day",
          "enum": [
            "hour",
            "day",
            "month"
          ],
          "title": "Interval",
          "type": "string"
        },
        "group_by": {
          "anyOf": [
            {
              "enum": [
                "path",
                "key_id",
                "status_code"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group By",
          "enum": [
            "path",
            "key_id",
            "status_code"
          ],
          "x-enum-searchable": true
        },
        "from_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive ISO 8601 start timestamp.",
          "title": "From Time"
        },
        "to_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 end timestamp.",
          "title": "To Time"
        }
      },
      "title": "GetUsageHistory",
      "type": "object"
    },
