{
  "$defs": {
    "AnswerResearch": {
      "description": "Research a task with source URLs and an optional example answer shape.",
      "properties": {
        "operation": {
          "const": "answer_research",
          "default": "answer_research",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "task": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "mode": {
          "default": "fast",
          "enum": [
            "fast",
            "ultra"
          ],
          "title": "Mode",
          "type": "string"
        },
        "json_format": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Example answer object, not JSON Schema.",
          "title": "Json Format"
        }
      },
      "required": [
        "task"
      ],
      "title": "AnswerResearch",
      "type": "object"
    },
    "ContextDevAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "context_dev_api_key",
          "default": "context_dev_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Context Dev API Key",
      "type": "object",
      "x-credential-instructions": "Paste a secret API key from Context.dev \u2192 Dashboard \u2192 API keys. Use a full-access key or enable the permissions for your selected operations, including logs:read for the connection usage read. Requests that research websites or run monitors can consume credits.",
      "x-credential-url": "https://context.dev/dashboard/api-keys"
    },
    "CrawlWebsite": {
      "description": "Crawl a bounded number of pages; partial results remain visible.",
      "properties": {
        "url": {
          "description": "Public HTTP or HTTPS URL.",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "operation": {
          "const": "crawl_website",
          "default": "crawl_website",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "max_pages": {
          "default": 10,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "max_depth": {
          "default": 1,
          "minimum": 0,
          "title": "Max Depth",
          "type": "integer"
        },
        "use_main_content_only": {
          "default": true,
          "title": "Use Main Content Only",
          "type": "boolean"
        }
      },
      "required": [
        "url"
      ],
      "title": "CrawlWebsite",
      "type": "object"
    },
    "CreateMonitor": {
      "description": "Create a page monitor with a daily schedule; Context.dev queues its baseline run.",
      "properties": {
        "url": {
          "description": "Public HTTP or HTTPS URL.",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "operation": {
          "const": "create_monitor",
          "default": "create_monitor",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "instructions": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional semantic change goal; omitted uses exact detection.",
          "title": "Instructions"
        },
        "frequency_days": {
          "default": 1,
          "description": "Run every this many days.",
          "maximum": 365,
          "minimum": 1,
          "title": "Frequency Days",
          "type": "integer"
        }
      },
      "required": [
        "url",
        "name"
      ],
      "title": "CreateMonitor",
      "type": "object"
    },
    "DeleteMonitor": {
      "description": "Delete a monitor and stop future runs and webhook retries.",
      "properties": {
        "monitor_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Monitor Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_monitor",
          "default": "delete_monitor",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "monitor_id"
      ],
      "title": "DeleteMonitor",
      "type": "object"
    },
    "EnrichPerson": {
      "description": "Enrich a person identified by a business email; free emails are rejected by Context.dev.",
      "properties": {
        "operation": {
          "const": "enrich_person",
          "default": "enrich_person",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "maxLength": 320,
          "minLength": 3,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "EnrichPerson",
      "type": "object"
    },
