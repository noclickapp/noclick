              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "private": {
          "default": false,
          "title": "Private",
          "type": "boolean"
        },
        "enforceThreads": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enforcethreads"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/GroupMember"
