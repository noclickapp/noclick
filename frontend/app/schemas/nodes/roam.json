{
  "$defs": {
    "AddReaction": {
      "additionalProperties": false,
      "description": "Add a message reaction. Requires chat:send_message and chat membership.",
      "properties": {
        "chatId": {
          "format": "uuid",
          "title": "Chat ID",
          "type": "string"
        },
        "timestamp": {
          "title": "Message timestamp (microseconds)",
          "type": "integer"
        },
        "threadTimestamp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent thread timestamp (microseconds)"
        },
        "name": {
          "description": "Roam reaction name, e.g. thumbs_up or heart",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "operation": {
          "const": "add_reaction",
          "default": "add_reaction",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "chatId",
        "timestamp",
        "name"
      ],
      "title": "AddReaction",
      "type": "object"
    },
    "CreateGroup": {
      "additionalProperties": false,
      "description": "Create a group with explicit initial members. Requires group:write.",
