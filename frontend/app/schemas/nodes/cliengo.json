    "CliengoAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "cliengo_api_token",
          "default": "cliengo_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Cliengo API Token",
      "type": "object",
      "x-credential-instructions": "In Cliengo, open Integrations \u2192 API, generate a token with the permissions your operations need, and paste it here. Contacts need clients_read/clients_write; conversations, tags and phases need conversations_read/conversations_write; channels need websites_read; users need users_read. Account reads prove the connection. Production tokens use connect.cliengo.com; sk_test_ tokens use connect.stagecliengo.com.",
      "x-credential-url": "https://dash.cliengo.com/integrations/connect_api"
    },
