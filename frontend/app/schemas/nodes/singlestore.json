      "oneOf": [
        {
          "$ref": "#/$defs/GetOrganization"
        },
        {
          "$ref": "#/$defs/ListProjects"
        },
        {
          "$ref": "#/$defs/GetProject"
        },
        {
          "$ref": "#/$defs/RenameProject"
        },
        {
          "$ref": "#/$defs/ListRegions"
        },
        {
          "$ref": "#/$defs/ListSharedTierRegions"
        },
        {
          "$ref": "#/$defs/ListClusters"
        },
        {
          "$ref": "#/$defs/GetCluster"
        },
        {
          "$ref": "#/$defs/ListStageFolder"
        },
        {
          "$ref": "#/$defs/GetStageFileMetadata"
        },
        {
          "$ref": "#/$defs/CreateStageFolder"
        },
        {
          "$ref": "#/$defs/MoveEmptyStageFolder"
        },
        {
          "$ref": "#/$defs/DeleteEmptyStageFolder"
