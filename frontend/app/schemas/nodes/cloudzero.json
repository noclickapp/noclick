{
  "$defs": {
    "CloudZeroAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "cloudzero_api_key",
          "default": "cloudzero_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "Existing API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "CloudZeroAPIKeyCredential",
      "type": "object",
      "x-credential-instructions": "Supply an existing CloudZero key with fixed read scopes: billing:read_dimensions, billing:read_costs, views:read_views and views:read_view for the operations used. Raw Authorization header without Bearer on fixed api.cloudzero.com. Managed send-only telemetry keys do not imply read access. The protected dimensions check proves reachability only, never principal/organization identity, all scopes or plan entitlement. HTTP403 is a request refusal with unknown key/scope/role/plan cause. No key issuance, environment fallback, OAuth, ingestion or account action.",
      "x-credential-url": "https://docs.cloudzero.com/reference/authorization"
    },
    "CloudZeroCheckConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "test_connection",
          "default": "test_connection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Connection",
          "x-display-name": "Check Dimensions Read Access",
          "x-is-trigger": false
        }
      },
      "title": "CloudZeroCheckConfig",
      "type": "object"
    },
    "CloudZeroCostsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_costs",
          "default": "get_costs",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Costs",
          "x-display-name": "Read One Cost or Usage Page",
          "x-is-trigger": false
        },
        "start_date": {
          "description": "YYYY-MM-DD or ISO8601 date and time with explicit timezone; exact value is encoded by the HTTP client.",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit for the documented current-time default. Native continuations retain the original cached query.",
          "title": "End Date"
        },
        "granularity": {
          "default": "daily",
          "enum": [
            "hourly",
            "daily",
            "weekly",
            "monthly",
            "yearly"
          ],
          "title": "Granularity",
          "type": "string"
        },
        "group_by": {
          "default": [],
          "description": "Dynamic dimension IDs; each sends a separate group_by query parameter. Use List Available Dimensions to discover current IDs.",
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Group By",
          "type": "array",
          "ui:widget": "list"
        },
        "filters_json": {
          "anyOf": [
            {
              "maxLength": 65536,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional mapping of exact dimension IDs to string arrays, e.g. {\"Region\":[\"us-east-1\"],\"!Account\":[\"123456789012\"]}. Blank omits filters; ! negates a dimension.",
          "title": "Dimension Filters (JSON)",
          "ui:widget": "textarea"
        },
        "cost_type": {
          "default": "real_cost",
          "enum": [
            "billed_cost",
            "discounted_cost",
            "amortized_cost",
            "discounted_amortized_cost",
            "real_cost",
            "on_demand_cost",
            "invoiced_amortized_cost",
            "usage_amount"
          ],
          "title": "Cost Type",
          "type": "string"
        },
        "align_to_granularity": {
          "default": true,
          "description": "Provider default expands dates to period boundaries. False requests the exact date range.",
          "title": "Align To Granularity",
          "type": "boolean"
        },
        "include_projected_row_count": {
          "default": false,
          "description": "Include documented underlying-record count where supplied; omitted for hourly granularity.",
          "title": "Include Projected Row Count",
          "type": "boolean"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Native token from this exact saved credential/query. Cost cache expires after 24 hours; no automatic rerun, retry or traversal.",
          "title": "Next Page Token"
        },
        "confirm_query_quota": {
          "default": false,
          "description": "Confirm this cost query against the documented 60-query/day allowance and 30-second timeout. Cursor reads use the existing 24-hour cache and do not count as new queries. Account entitlement is unverified.",
          "title": "Confirm Query Quota",
          "type": "boolean"
        }
      },
      "required": [
        "start_date"
      ],
      "title": "CloudZeroCostsConfig",
      "type": "object"
    },
    "CloudZeroDimensionConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_dimension",
          "default": "get_dimension",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Dimensions",
          "x-display-name": "Read One Dimension Metadata",
          "x-is-trigger": false
        },
        "dimension_id": {
          "description": "Exact dimension ID from the protected dimensions read, including dynamic CostFormation IDs.",
          "title": "Dimension",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "dimension_id",
            "placeholder": "Select an available dimension",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-id-path": "dimension_id",
          "x-resource-type": "cloudzero_dimension"
        },
        "include_hidden": {
          "default": false,
          "description": "Include hidden dimensions in this lookup only when explicitly requested.",
          "title": "Include Hidden",
          "type": "boolean"
        }
      },
      "required": [
        "dimension_id"
      ],
      "title": "CloudZeroDimensionConfig",
      "type": "object"
    },
    "CloudZeroDimensionsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_dimensions",
          "default": "list_dimensions",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Dimensions",
          "x-display-name": "List Available Dimensions",
          "x-is-trigger": false
        },
        "include_hidden": {
          "default": false,
          "description": "Explicitly include dimensions hidden in CostFormation; omitted by default.",
          "title": "Include Hidden",
          "type": "boolean"
        }
      },
      "title": "CloudZeroDimensionsConfig",
      "type": "object"
    },
    "CloudZeroViewConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_view",
          "default": "get_view",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Views",
          "x-display-name": "Read Saved View Metadata",
          "x-is-trigger": false
        },
        "view_id": {
          "title": "Saved View",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "view_id",
            "placeholder": "Select a saved view",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-id-path": "view_id",
          "x-resource-type": "cloudzero_view"
        },
        "include_filters": {
          "default": false,
          "description": "Opt in to private dimension filter values. Notification destinations and connection details are never returned.",
          "title": "Include Filters",
          "type": "boolean"
        }
      },
      "required": [
        "view_id"
      ],
      "title": "CloudZeroViewConfig",
      "type": "object"
    },
    "CloudZeroViewsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_views",
          "default": "list_views",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Views",
          "x-display-name": "List Saved View Metadata",
          "x-is-trigger": false
        },
        "limit": {
          "default": 100,
          "description": "Local bounded page size; public API does not publish a maximum.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "sort_order": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Sort Order",
          "type": "string"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Native continuation bound to current credential and this page configuration.",
          "title": "Next Page Token"
        },
        "include_filters": {
          "default": false,
          "description": "Opt in to private saved-view filter values. Email/Slack connections and unknown fields remain omitted.",
          "title": "Include Filters",
          "type": "boolean"
        }
      },
      "title": "CloudZeroViewsConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_costs": "#/$defs/CloudZeroCostsConfig",
          "get_dimension": "#/$defs/CloudZeroDimensionConfig",
          "get_view": "#/$defs/CloudZeroViewConfig",
          "list_dimensions": "#/$defs/CloudZeroDimensionsConfig",
          "list_views": "#/$defs/CloudZeroViewsConfig",
          "test_connection": "#/$defs/CloudZeroCheckConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CloudZeroCheckConfig"
        },
        {
          "$ref": "#/$defs/CloudZeroDimensionsConfig"
        },
        {
          "$ref": "#/$defs/CloudZeroDimensionConfig"
        },
        {
          "$ref": "#/$defs/CloudZeroCostsConfig"
        },
        {
          "$ref": "#/$defs/CloudZeroViewsConfig"
        },
        {
          "$ref": "#/$defs/CloudZeroViewConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/CloudZeroAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "CloudZero Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Read monthly costs grouped by current dimensions",
    "List saved-view metadata without notification destinations",
    "Continue one cached cost page with the same query"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
