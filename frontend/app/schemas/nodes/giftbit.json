{
  "$defs": {
    "AddFunds": {
      "additionalProperties": false,
      "description": "Charge the card on file to add funds. Requires a card saved in Giftbit.",
      "properties": {
        "operation": {
          "const": "add_funds",
          "default": "add_funds",
          "title": "Operation",
          "type": "string"
        },
        "currencyisocode": {
          "enum": [
            "CAD",
            "USD"
          ],
          "title": "Currencyisocode",
          "type": "string"
        },
        "fund_amount_in_cents": {
          "description": "Funding amount in cents, subject to Giftbit's minimum and maximum.",
          "exclusiveMinimum": 0,
          "title": "Fund Amount In Cents",
          "type": "integer"
        },
        "id": {
          "description": "Unique client-assigned funding event ID.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "currencyisocode",
        "fund_amount_in_cents",
        "id"
      ],
      "title": "AddFunds",
      "type": "object"
    },
    "CancelReward": {
      "additionalProperties": false,
      "description": "Cancel an unclaimed reward. Embedded or already claimed rewards are ineligible.",
      "properties": {
        "operation": {
          "const": "cancel_reward",
          "default": "cancel_reward",
          "title": "Operation",
          "type": "string"
        },
        "uuid": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid"
      ],
      "title": "CancelReward",
      "type": "object"
    },
    "CreateDirectLinkOrder": {
      "additionalProperties": false,
      "description": "Order direct reward links with minimal branding.",
      "properties": {
        "id": {
          "description": "Unique client-assigned order ID. Keep the same ID when reconciling or retrying this order.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "price_in_cents": {
          "exclusiveMinimum": 0,
          "title": "Price In Cents",
          "type": "integer"
        },
        "brand_codes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON array of brand codes, e.g. [\"itunesus\", \"amazonus\"]. Omit when choosing a full catalog region.",
          "title": "Brand Codes",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Full Catalog region, such as USA or Canada. Omit when specifying brand codes.",
          "title": "Region"
        },
        "expiry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Claim-before date, YYYY-MM-dd. Provider enforces the one-year maximum.",
          "title": "Expiry"
        },
        "operation": {
          "const": "create_direct_link_order",
          "default": "create_direct_link_order",
          "title": "Operation",
          "type": "string"
        },
        "link_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link Count"
        }
      },
      "required": [
        "id",
        "price_in_cents"
      ],
      "title": "CreateDirectLinkOrder",
      "type": "object"
    },
    "CreateEmbeddedReward": {
      "additionalProperties": false,
      "description": "Create a single immediately claimed in-app reward; it cannot be cancelled.",
      "properties": {
        "operation": {
          "const": "create_embedded_reward",
          "default": "create_embedded_reward",
          "title": "Operation",
          "type": "string"
        },
