    "GiftbitAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "giftbit_api_token",
          "default": "giftbit_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        },
        "environment": {
          "default": "testbed",
          "description": "Use the environment where this token was created. Production orders spend real funds.",
          "enum": [
            "testbed",
            "production"
          ],
          "title": "Environment",
          "type": "string"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Giftbit API Token",
      "type": "object",
      "x-credential-instructions": "In your Giftbit account, open Account \u2192 API keys and generate an API token. Paste the token without the Bearer prefix and select its environment. Testbed and Production use separate tokens. NoClick checks the connected account with Giftbit's read-only ping endpoint.",
      "x-credential-url": "https://docs.giftbit.com/guides/authentication"
    },
