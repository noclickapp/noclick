        "expiry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Claim-before date, YYYY-MM-dd. Provider enforces the one-year maximum.",
          "title": "Expiry"
        },
        "operation": {
          "const": "create_order",
          "default": "create_order",
          "title": "Operation",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
