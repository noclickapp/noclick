    "DeleteMessage": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "delete_message",
          "default": "delete_message",
          "title": "Delete Scheduled Message",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Messages",
          "x-display-name": "Delete Scheduled Message",
          "x-is-trigger": false
        },
        "message_id": {
          "description": "ID of a scheduled SMS to cancel. MessageBird only permits deletion of scheduled messages.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Message Id",
          "type": "string"
        }
      },
      "required": [
        "message_id"
      ],
      "title": "DeleteMessage",
      "type": "object"
    },
