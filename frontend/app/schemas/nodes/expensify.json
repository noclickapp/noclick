    "ExpensifyOnNewReportConfig": {
      "description": "Poll the report exporter for newly submitted/created reports.\n\nExpensify has no outbound webhooks, so the trigger polls the Integration\nServer on a schedule. Each poll runs the two-step export (generate a JSON\nreport-metadata file, then download it) and emits only reports not seen on a\nprevious poll. Webhook + schedule provisioning, seen-set persistence, and\nteardown come from ``ScheduledPollTriggerMixin``.",
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_report",
          "default": "on_new_report",
          "description": "Trigger the workflow when a new report is submitted/created",
          "title": "On New Report",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On New Report",
          "x-is-trigger": true
        },
        "report_state": {
          "default": "SUBMITTED",
          "description": "Only trigger on reports in this approval state",
          "enum": [
            "",
            "OPEN",
            "SUBMITTED",
            "APPROVED",
            "REIMBURSED",
            "ARCHIVED"
          ],
          "enumNames": [
            "Any",
            "Open",
            "Submitted",
            "Approved",
            "Reimbursed",
            "Archived"
          ],
          "title": "Report State",
          "type": "string",
          "x-enum-searchable": true
        }
      },
      "title": "ExpensifyOnNewReportConfig",
      "type": "object",
      "x-requires-webhook": true
    },
