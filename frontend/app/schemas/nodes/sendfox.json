      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_contact_to_list": "#/$defs/AddContactToListConfig",
          "attach_contact_tag": "#/$defs/AttachContactTagConfig",
          "create_contact": "#/$defs/CreateContactConfig",
          "create_contact_list": "#/$defs/CreateContactListConfig",
          "create_contact_tag": "#/$defs/CreateContactTagConfig",
          "delete_contact": "#/$defs/DeleteContactConfig",
