          "type": "string"
        },
        "list_id": {
          "minimum": 1,
          "title": "List Id",
          "type": "integer"
        },
        "contact_id": {
          "minimum": 1,
          "title": "Contact Id",
          "type": "integer"
        }
      },
      "required": [
        "list_id",
        "contact_id"
      ],
      "title": "RemoveContactFromListConfig",
      "type": "object"
    },
    "SendfoxTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "sendfox_token",
          "default": "sendfox_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "minLength": 1,
          "title": "Personal access token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "SendFox Personal Access Token",
      "type": "object",
      "x-credential-instructions": "Create a personal access token in SendFox Account \u2192 OAuth and paste it here. Your plan controls API access; some operations require Lifetime or Pro.",
      "x-credential-url": "https://sendfox.com/account/oauth"
    },
    "UnsubscribeContactConfig": {
      "additionalProperties": false,
      "description": "Unsubscribe a contact by email.",
      "properties": {
        "operation": {
          "const": "unsubscribe_contact",
          "default": "unsubscribe_contact",
          "title": "Operation",
          "type": "string"
        },
        "email": {
          "format": "email",
          "minLength": 1,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "UnsubscribeContactConfig",
      "type": "object"
    },
    "UpdateContactConfig": {
      "additionalProperties": false,
      "description": "Update a contact.",
      "properties": {
        "operation": {
          "const": "update_contact",
          "default": "update_contact",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "lists": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Array of list IDs (replaces all current list memberships)",
          "title": "Lists"
        }
      },
      "required": [
        "id"
      ],
      "title": "UpdateContactConfig",
      "type": "object"
    },
    "UpdateContactListConfig": {
      "additionalProperties": false,
      "description": "Update a contact list.",
      "properties": {
        "operation": {
          "const": "update_contact_list",
          "default": "update_contact_list",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 191,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "public_description": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The name subscribers see on the unsubscribe and preference pages. Blank uses the list's own name.",
          "title": "Public Description"
        },
        "subscriber_description": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What subscribers can expect from this list, shown below its name on those pages. Blank clears it.",
          "title": "Subscriber Description"
        }
      },
      "required": [
        "id"
      ],
      "title": "UpdateContactListConfig",
      "type": "object"
    },
    "UpdateContactTagConfig": {
      "additionalProperties": false,
      "description": "Update a contact tag.",
      "properties": {
        "operation": {
          "const": "update_contact_tag",
