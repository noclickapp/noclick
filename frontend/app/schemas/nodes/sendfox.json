        "operation": {
          "const": "list_contact_tags",
          "default": "list_contact_tags",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListContactTagsConfig",
      "type": "object"
    },
    "ListContactsConfig": {
      "additionalProperties": false,
      "description": "List contacts.",
      "properties": {
        "operation": {
          "const": "list_contacts",
          "default": "list_contacts",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "unsubscribed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsubscribed"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "per_page": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 100,
          "title": "Per Page"
        },
        "count_only": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count Only"
        }
      },
      "title": "ListContactsConfig",
      "type": "object"
    },
    "ListContactsInListConfig": {
      "additionalProperties": false,
      "description": "Get contacts in a list.",
      "properties": {
        "operation": {
          "const": "list_contacts_in_list",
          "default": "list_contacts_in_list",
          "title": "Operation",
          "type": "string"
        },
        "list_id": {
          "minimum": 1,
          "title": "List Id",
          "type": "integer"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "subscribed",
                "unsubscribed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "subscribed",
            "unsubscribed"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "list_id"
      ],
      "title": "ListContactsInListConfig",
      "type": "object"
    },
    "RemoveContactFromListConfig": {
      "additionalProperties": false,
