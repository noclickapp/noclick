        "operation": {
          "const": "list_contact_lists",
          "default": "list_contact_lists",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        }
      },
      "title": "ListContactListsConfig",
      "type": "object"
    },
    "ListContactTagsConfig": {
      "additionalProperties": false,
      "description": "List contact tags.",
