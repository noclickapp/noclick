        },
        {
          "$ref": "#/$defs/GetContactTagConfig"
        },
        {
          "$ref": "#/$defs/UpdateContactTagConfig"
        },
        {
          "$ref": "#/$defs/DeleteContactTagConfig"
        },
        {
          "$ref": "#/$defs/AttachContactTagConfig"
        },
        {
          "$ref": "#/$defs/DetachContactTagConfig"
        },
        {
          "$ref": "#/$defs/ListCampaignsConfig"
        },
        {
          "$ref": "#/$defs/GetCampaignConfig"
        },
        {
          "$ref": "#/$defs/GetCampaignStatsConfig"
        },
        {
          "$ref": "#/$defs/GetCurrentUserConfig"
        },
        {
          "$ref": "#/$defs/ListContactListsConfig"
        },
        {
          "$ref": "#/$defs/CreateContactListConfig"
        },
        {
          "$ref": "#/$defs/GetContactListConfig"
        },
        {
          "$ref": "#/$defs/UpdateContactListConfig"
        },
        {
          "$ref": "#/$defs/DeleteContactListConfig"
        },
        {
          "$ref": "#/$defs/ListContactsInListConfig"
        },
        {
          "$ref": "#/$defs/AddContactToListConfig"
        },
        {
          "$ref": "#/$defs/RemoveContactFromListConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/SendfoxTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
