{
  "$defs": {
    "AddContactToListConfig": {
      "additionalProperties": false,
      "description": "Add a contact to a list.",
      "properties": {
        "operation": {
          "const": "add_contact_to_list",
          "default": "add_contact_to_list",
          "title": "Operation",
          "type": "string"
        },
        "list_id": {
          "minimum": 1,
          "title": "List Id",
          "type": "integer"
        },
        "contact_id": {
          "description": "ID of the contact to add",
          "title": "Contact Id",
          "type": "integer"
        }
      },
      "required": [
        "list_id",
        "contact_id"
      ],
      "title": "AddContactToListConfig",
      "type": "object"
    },
    "AttachContactTagConfig": {
      "additionalProperties": false,
      "description": "Attach a tag to a contact.",
      "properties": {
        "operation": {
          "const": "attach_contact_tag",
          "default": "attach_contact_tag",
          "title": "Operation",
          "type": "string"
        },
        "contact_id": {
          "minimum": 1,
          "title": "Contact Id",
          "type": "integer"
        },
        "tag_id": {
          "minimum": 1,
          "title": "Tag Id",
          "type": "integer"
        }
      },
      "required": [
        "contact_id",
        "tag_id"
      ],
      "title": "AttachContactTagConfig",
      "type": "object"
    },
    "CreateContactConfig": {
      "additionalProperties": false,
      "description": "Create a new contact.",
      "properties": {
        "operation": {
          "const": "create_contact",
          "default": "create_contact",
          "title": "Operation",
          "type": "string"
        },
        "email": {
          "format": "email",
          "minLength": 1,
          "title": "Email",
          "type": "string"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "lists": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Array of list IDs to add the contact to",
          "title": "Lists"
        },
        "contact_tags": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IDs of contact tags (see `/contact-tags`) to add, up to 100. Applies to existing and\nunsubscribed contacts too; a tag the contact already has is left alone. An ID the account\ndoesn't own returns 400 and nothing is written.\n",
          "title": "Contact Tags"
        }
      },
      "required": [
        "email"
      ],
      "title": "CreateContactConfig",
      "type": "object"
    },
    "CreateContactListConfig": {
      "additionalProperties": false,
      "description": "Create a new contact list.",
      "properties": {
        "operation": {
          "const": "create_contact_list",
          "default": "create_contact_list",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateContactListConfig",
      "type": "object"
    },
    "CreateContactTagConfig": {
      "additionalProperties": false,
      "description": "Create a contact tag.",
      "properties": {
        "operation": {
          "const": "create_contact_tag",
          "default": "create_contact_tag",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 191,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional brand palette hex color; auto-assigned when omitted.",
          "title": "Color"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateContactTagConfig",
      "type": "object"
    },
    "DeleteContactConfig": {
      "additionalProperties": false,
      "description": "Delete a contact.",
      "properties": {
        "operation": {
          "const": "delete_contact",
          "default": "delete_contact",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeleteContactConfig",
      "type": "object"
    },
    "DeleteContactListConfig": {
      "additionalProperties": false,
      "description": "Delete a contact list.",
      "properties": {
        "operation": {
          "const": "delete_contact_list",
          "default": "delete_contact_list",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeleteContactListConfig",
      "type": "object"
    },
    "DeleteContactTagConfig": {
      "additionalProperties": false,
      "description": "Delete a contact tag.",
      "properties": {
        "operation": {
          "const": "delete_contact_tag",
          "default": "delete_contact_tag",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeleteContactTagConfig",
      "type": "object"
    },
    "DetachContactTagConfig": {
      "additionalProperties": false,
      "description": "Remove a tag from a contact.",
      "properties": {
        "operation": {
          "const": "detach_contact_tag",
          "default": "detach_contact_tag",
          "title": "Operation",
          "type": "string"
        },
        "contact_id": {
          "minimum": 1,
          "title": "Contact Id",
          "type": "integer"
        },
        "tag_id": {
          "minimum": 1,
          "title": "Tag Id",
          "type": "integer"
        }
      },
      "required": [
        "contact_id",
        "tag_id"
      ],
      "title": "DetachContactTagConfig",
      "type": "object"
    },
    "GetCampaignConfig": {
      "additionalProperties": false,
      "description": "Get a specific campaign.",
      "properties": {
        "operation": {
          "const": "get_campaign",
          "default": "get_campaign",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetCampaignConfig",
      "type": "object"
    },
    "GetCampaignStatsConfig": {
      "additionalProperties": false,
      "description": "Get campaign performance statistics.",
      "properties": {
        "operation": {
          "const": "get_campaign_stats",
          "default": "get_campaign_stats",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "include_link_stats": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": false,
          "title": "Include Link Stats"
        },
        "link_limit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 50,
          "title": "Link Limit"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetCampaignStatsConfig",
      "type": "object"
    },
    "GetContactConfig": {
      "additionalProperties": false,
      "description": "Get a specific contact.",
      "properties": {
        "operation": {
          "const": "get_contact",
          "default": "get_contact",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetContactConfig",
      "type": "object"
    },
    "GetContactListConfig": {
      "additionalProperties": false,
      "description": "Get a specific contact list.",
      "properties": {
        "operation": {
          "const": "get_contact_list",
          "default": "get_contact_list",
          "title": "Operation",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetContactListConfig",
      "type": "object"
    },
    "GetContactTagConfig": {
      "additionalProperties": false,
      "description": "Get a contact tag.",
      "properties": {
        "operation": {
          "const": "get_contact_tag",
          "default": "get_contact_tag",
          "title": "Operation",
