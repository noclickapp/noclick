            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        }
      },
      "required": [
        "id"
      ],
      "title": "UpdateContactTagConfig",
      "type": "object"
    }
