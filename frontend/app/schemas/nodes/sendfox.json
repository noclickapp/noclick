        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetContactTagConfig",
      "type": "object"
    },
    "GetCurrentUserConfig": {
      "additionalProperties": false,
      "description": "Get current user information.",
      "properties": {
        "operation": {
          "const": "get_current_user",
          "default": "get_current_user",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetCurrentUserConfig",
      "type": "object"
    },
    "ListCampaignsConfig": {
      "additionalProperties": false,
      "description": "List campaigns.",
      "properties": {
        "operation": {
          "const": "list_campaigns",
          "default": "list_campaigns",
          "title": "Operation",
          "type": "string"
        },
        "list_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "List Id"
        }
      },
      "title": "ListCampaignsConfig",
      "type": "object"
