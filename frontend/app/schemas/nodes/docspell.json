{
  "$defs": {
    "DocspellAuthTokenCredential": {
      "additionalProperties": false,
      "properties": {
        "credential_type": {
          "const": "docspell_auth_token",
          "default": "docspell_auth_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "instance_origin": {
          "description": "One public HTTPS origin, with no credentials/path/query/fragment. API paths are fixed /api/v1. Hosted/self-hosted instance version parity is unverified.",
          "title": "Instance HTTPS Origin",
          "type": "string"
        },
        "auth_token": {
          "description": "Supplied existing authenticated-user token, X-Docspell-Auth header only. No login, admin/share token, JWT parsing or mint/refresh/extend.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Existing User Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "instance_origin",
        "auth_token"
      ],
      "title": "Docspell Auth Token",
      "type": "object",
      "x-credential-url": "https://docspell.org/docs/api/intro/"
    },
    "GetFolder": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to folder/tag names. Owners, members, permission metadata and tag categories are omitted.",
          "title": "Include Names",
          "type": "boolean"
        },
        "operation": {
          "const": "get_folder",
          "default": "get_folder",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Metadata",
          "x-display-name": "Get Folder Metadata",
          "x-is-trigger": false
        },
        "folder_id": {
          "description": "Exact current token-visible opaque string ID; no vendor grammar or numeric conversion. Catalog/detail/catalog witnesses access, not ownership.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Folder",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "folder_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "docspell_folder"
        }
      },
      "required": [
        "folder_id"
      ],
      "title": "GetFolder",
      "type": "object"
    },
    "ListFolders": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to folder/tag names. Owners, members, permission metadata and tag categories are omitted.",
          "title": "Include Names",
          "type": "boolean"
        },
        "operation": {
          "const": "list_folders",
          "default": "list_folders",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Metadata",
          "x-display-name": "List Folder Metadata",
          "x-is-trigger": false
        }
      },
      "title": "ListFolders",
      "type": "object"
    },
    "ListTags": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to folder/tag names. Owners, members, permission metadata and tag categories are omitted.",
          "title": "Include Names",
          "type": "boolean"
        },
        "operation": {
          "const": "list_tags",
          "default": "list_tags",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Metadata",
          "x-display-name": "List Tag Metadata",
          "x-is-trigger": false
        }
      },
      "title": "ListTags",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_folder": "#/$defs/GetFolder",
          "list_folders": "#/$defs/ListFolders",
          "list_tags": "#/$defs/ListTags"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListFolders"
        },
        {
          "$ref": "#/$defs/GetFolder"
        },
        {
          "$ref": "#/$defs/ListTags"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocspellAuthTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Docspell Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
