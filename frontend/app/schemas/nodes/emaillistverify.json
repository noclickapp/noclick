{
  "$defs": {
    "CheckBlacklistsConfig": {
      "additionalProperties": false,
      "description": "Check IP or domain against blacklists.",
      "properties": {
        "operation": {
          "const": "check_blacklists",
          "default": "check_blacklists",
          "title": "Check Blacklists",
          "type": "string",
          "ui:hidden": true
        },
        "value": {
          "examples": [
            "172.75.233.15"
          ],
          "maxLength": 255,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "CheckBlacklistsConfig",
      "type": "object"
    },
    "CheckDisposableConfig": {
      "additionalProperties": false,
      "description": "Verify if a domain is disposable.",
      "properties": {
        "operation": {
          "const": "check_disposable",
          "default": "check_disposable",
          "title": "Check Disposable",
          "type": "string",
          "ui:hidden": true
        },
        "domain": {
          "examples": [
            "temporarydomain.net"
          ],
          "maxLength": 255,
          "title": "Domain",
          "type": "string"
        }
      },
      "required": [
        "domain"
      ],
      "title": "CheckDisposableConfig",
      "type": "object"
    },
    "CreateEmailJobConfig": {
      "additionalProperties": false,
      "description": "Create asynchronous job that verifies email deliverability.",
      "properties": {
        "operation": {
          "const": "create_email_job",
          "default": "create_email_job",
          "title": "Create Email Job",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "examples": [
            "john.smith@gmail.com"
          ],
          "title": "Email",
          "type": "string"
        },
        "quality": {
          "default": "standard",
          "enum": [
            "standard",
            "high"
          ],
          "examples": [
            "high"
          ],
          "title": "Quality",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "CreateEmailJobConfig",
      "type": "object"
    },
    "CreatePlacementTestConfig": {
      "additionalProperties": false,
      "description": "Create inbox placement test.",
      "properties": {
        "operation": {
          "const": "create_placement_test",
          "default": "create_placement_test",
          "title": "Create Placement Test",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "anyOf": [
            {
              "minLength": 5,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "examples": [
            "Q1 2025 Campaign Test"
          ],
          "title": "Name"
        },
        "webhookUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "examples": [
            "https://yourapp.com/webhooks/placement-test"
          ],
          "title": "Webhookurl"
        }
      },
      "title": "CreatePlacementTestConfig",
      "type": "object"
    },
    "DeleteListConfig": {
      "additionalProperties": false,
      "description": "Delete finished email list.",
      "properties": {
        "operation": {
          "const": "delete_list",
          "default": "delete_list",
          "title": "Delete List",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "examples": [
            "2200875"
          ],
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeleteListConfig",
      "type": "object"
    },
    "EmaillistverifyApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "emaillistverify_api_key",
          "default": "emaillistverify_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "EmailListVerify API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the API section of EmailListVerify and paste it here.",
      "x-credential-url": "https://apps.emaillistverify.com/api"
    },
    "FindContactConfig": {
      "additionalProperties": false,
      "description": "Search for email address of a contact.",
      "properties": {
        "operation": {
          "const": "find_contact",
          "default": "find_contact",
          "title": "Find Contact",
          "type": "string",
          "ui:hidden": true
        },
        "firstName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "examples": [
            "Adela"
          ],
          "title": "Firstname"
        },
        "lastName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "examples": [
            "Franey"
          ],
          "title": "Lastname"
        },
        "domain": {
          "examples": [
            "connelycorp.com"
          ],
          "title": "Domain",
          "type": "string"
        }
      },
      "required": [
        "domain"
      ],
      "title": "FindContactConfig",
      "type": "object"
    },
    "GetCreditsConfig": {
      "additionalProperties": false,
      "description": "Retrieve details regarding your available credits.",
      "properties": {
        "operation": {
          "const": "get_credits",
          "default": "get_credits",
          "title": "Get Credits",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetCreditsConfig",
      "type": "object"
    },
    "GetEmailJobConfig": {
      "additionalProperties": false,
      "description": "Verify email deliverability.",
      "properties": {
        "operation": {
          "const": "get_email_job",
          "default": "get_email_job",
          "title": "Get Email Job",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetEmailJobConfig",
      "type": "object"
    },
    "GetFileInfoConfig": {
      "additionalProperties": false,
      "description": "Retrieve progress information of email list.",
      "properties": {
        "operation": {
          "const": "get_file_info",
          "default": "get_file_info",
          "title": "Get File Info",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "examples": [
            "2200875"
          ],
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetFileInfoConfig",
      "type": "object"
    },
    "GetListProgressConfig": {
      "additionalProperties": false,
      "description": "Retrieve progress information of email list.",
      "properties": {
        "operation": {
          "const": "get_list_progress",
          "default": "get_list_progress",
          "title": "Get List Progress",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetListProgressConfig",
      "type": "object"
    },
    "GetPlacementTestConfig": {
      "additionalProperties": false,
      "description": "Get placement test results.",
      "properties": {
        "operation": {
          "const": "get_placement_test",
          "default": "get_placement_test",
          "title": "Get Placement Test",
          "type": "string",
          "ui:hidden": true
        },
        "code": {
          "examples": [
            "ELV-A1B2C3D4E5"
          ],
          "minLength": 1,
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "GetPlacementTestConfig",
      "type": "object"
    },
    "ReverifyListConfig": {
      "additionalProperties": false,
      "description": "Start Deep Scan of finished email list.",
      "properties": {
        "operation": {
          "const": "reverify_list",
          "default": "reverify_list",
          "title": "Reverify List",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "examples": [
            "2200875"
          ],
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ReverifyListConfig",
      "type": "object"
    },
    "VerifyEmailConfig": {
      "additionalProperties": false,
      "description": "Verify email deliverability.",
      "properties": {
        "operation": {
          "const": "verify_email",
          "default": "verify_email",
          "title": "Verify Email",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "examples": [
            "john.smith@gmail.com"
          ],
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "VerifyEmailConfig",
      "type": "object"
    },
    "VerifyEmailDetailedConfig": {
      "additionalProperties": false,
      "description": "Verify email deliverability.",
      "properties": {
        "operation": {
          "const": "verify_email_detailed",
          "default": "verify_email_detailed",
          "title": "Verify Email Detailed",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "examples": [
            "john.smith@gmail.com"
          ],
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "VerifyEmailDetailedConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_blacklists": "#/$defs/CheckBlacklistsConfig",
          "check_disposable": "#/$defs/CheckDisposableConfig",
          "create_email_job": "#/$defs/CreateEmailJobConfig",
          "create_placement_test": "#/$defs/CreatePlacementTestConfig",
          "delete_list": "#/$defs/DeleteListConfig",
          "find_contact": "#/$defs/FindContactConfig",
          "get_credits": "#/$defs/GetCreditsConfig",
          "get_email_job": "#/$defs/GetEmailJobConfig",
          "get_file_info": "#/$defs/GetFileInfoConfig",
          "get_list_progress": "#/$defs/GetListProgressConfig",
          "get_placement_test": "#/$defs/GetPlacementTestConfig",
          "reverify_list": "#/$defs/ReverifyListConfig",
          "verify_email": "#/$defs/VerifyEmailConfig",
          "verify_email_detailed": "#/$defs/VerifyEmailDetailedConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/VerifyEmailConfig"
        },
        {
          "$ref": "#/$defs/VerifyEmailDetailedConfig"
        },
        {
          "$ref": "#/$defs/CreateEmailJobConfig"
        },
        {
          "$ref": "#/$defs/GetEmailJobConfig"
        },
        {
          "$ref": "#/$defs/FindContactConfig"
        },
        {
          "$ref": "#/$defs/CheckDisposableConfig"
        },
        {
          "$ref": "#/$defs/CheckBlacklistsConfig"
        },
        {
          "$ref": "#/$defs/GetListProgressConfig"
        },
        {
          "$ref": "#/$defs/ReverifyListConfig"
        },
        {
          "$ref": "#/$defs/DeleteListConfig"
        },
        {
          "$ref": "#/$defs/GetCreditsConfig"
        },
        {
          "$ref": "#/$defs/CreatePlacementTestConfig"
        },
        {
          "$ref": "#/$defs/GetPlacementTestConfig"
        },
        {
          "$ref": "#/$defs/GetFileInfoConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmaillistverifyApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Emaillistverify Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
