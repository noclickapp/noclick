    "AgiledAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "agiled_api_token",
          "default": "agiled_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        },
        "brand_url": {
          "description": "Your account's HTTPS origin, for the Brand header.",
          "title": "Agiled account URL",
          "type": "string"
        }
      },
      "required": [
        "api_token",
        "brand_url"
      ],
      "title": "Agiled API Token",
      "type": "object",
      "x-credential-instructions": "In Agiled, open Settings > API Settings and copy your API token. Paste it here with your Agiled account URL. NoClick sends the token as api_token and the account URL as the Brand header to my.agiled.app. Agiled documents 180 requests per hour.",
      "x-credential-url": "https://my.agiled.app/docs/"
    },
