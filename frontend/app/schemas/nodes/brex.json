{
  "$defs": {
    "BrexAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "brex_api_token",
          "default": "brex_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "description": "User token generated in Brex Developer settings.",
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Brex API Token",
      "type": "object",
      "x-credential-instructions": "In Brex Developer settings, create a token with companies.readonly for the connection check. Enable expenses.card, cards, accounts.cash.readonly, accounts.card.readonly, transactions.card.readonly, transactions.cash.readonly, transfers, transfers.readonly and vendors.readonly for the operations you use. Copy the token when it is created; Brex only shows it once.",
      "x-credential-url": "https://dashboard.brex.com/settings/developer",
      "x-help-url": "https://developer.brex.com/guides/authentication"
    },
    "BrexCreateCardConfig": {
      "properties": {
        "operation": {
          "const": "create_card",
          "default": "create_card",
          "title": "Create Card",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Cards",
          "x-display-name": "Create Card",
          "x-is-trigger": false
        },
        "idempotency_key": {
          "description": "Unique retry key. Reuse for retries of this same creation, change for a new card.",
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "user_id": {
          "description": "Brex user who owns the card.",
          "minLength": 1,
          "title": "User Id",
          "type": "string"
        },
        "card_name": {
          "description": "Name for the new card.",
          "minLength": 1,
          "title": "Card Name",
          "type": "string"
        },
        "card_type": {
          "default": "VIRTUAL",
          "description": "Physical cards require a mailing address.",
          "enum": [
            "VIRTUAL",
            "PHYSICAL"
          ],
          "title": "Card Type",
          "type": "string"
        },
        "limit_type": {
          "default": "USER",
          "description": "CARD creates a virtual vendor card with spend controls; USER uses the owner's limit.",
          "enum": [
            "CARD",
            "USER"
          ],
          "title": "Limit Type",
          "type": "string"
        },
        "spend_controls": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON object, required for CARD: {\"spend_limit\":{\"amount\":10000,\"currency\":\"USD\"},\"spend_duration\":\"MONTHLY\"}. Omit for USER.",
          "title": "Spend Controls",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "mailing_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shipping address JSON object, required for physical cards.",
          "title": "Mailing Address",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "metadata": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON object of string key/value pairs. Do not include sensitive information.",
          "title": "Metadata",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "idempotency_key",
        "user_id",
        "card_name"
      ],
      "title": "BrexCreateCardConfig",
      "type": "object"
    },
    "BrexCreateTransferConfig": {
      "properties": {
        "operation": {
          "const": "create_transfer",
          "default": "create_transfer",
          "title": "Create Transfer",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Transfers",
          "x-display-name": "Create Transfer",
          "x-is-trigger": false
        },
        "idempotency_key": {
          "description": "Unique key for this transfer; reuse for retries to avoid duplicate payments.",
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "account_id": {
          "description": "Originating Brex cash account ID.",
          "minLength": 1,
          "title": "Account Id",
          "type": "string"
        },
        "payment_instrument_id": {
          "description": "Vendor payment instrument ID from the vendor's payment_accounts details.",
          "minLength": 1,
          "title": "Payment Instrument Id",
          "type": "string"
        },
        "amount": {
          "description": "Positive amount in USD cents; 100000 is $1,000. Brex supports USD transfers here.",
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "integer"
        },
        "description": {
          "description": "Internal description.",
          "title": "Description",
          "type": "string"
        },
        "external_memo": {
          "description": "External memo, at most 90 characters for ACH/wire and 40 for cheques.",
          "maxLength": 90,
          "title": "External Memo",
          "type": "string"
        },
        "approval_type": {
          "anyOf": [
            {
              "const": "MANUAL",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Require a cash admin to approve, or omit to apply the account's default policy.",
          "title": "Approval Type"
        }
      },
      "required": [
        "idempotency_key",
        "account_id",
        "payment_instrument_id",
        "amount",
        "description",
        "external_memo"
      ],
      "title": "BrexCreateTransferConfig",
      "type": "object"
    },
