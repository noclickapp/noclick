        },
        "custom_fields": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CustomField"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Fields"
        },
        "due_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due At"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_\\-:.]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A unique request key. Same-key retries return the first response for 10 minutes; later retries run again.",
          "title": "Idempotency Key"
        }
      },
      "required": [
        "template_id"
      ],
      "title": "StartFlow",
      "type": "object"
    },
    "TimeEntry": {
      "additionalProperties": false,
      "properties": {
        "minutes": {
          "maximum": 1439,
          "minimum": 1,
          "title": "Minutes",
          "type": "integer"
        },
        "billable": {
          "title": "Billable",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "minutes",
        "billable"
      ],
      "title": "TimeEntry",
      "type": "object"
    },
    "UnarchiveFlow": {
      "additionalProperties": false,
      "properties": {
        "flow_id": {
          "description": "The flow id from List Flows.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Flow Id",
          "type": "string"
        },
        "operation": {
          "const": "unarchive_flow",
          "default": "unarchive_flow",
          "title": "Unarchive Flow",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "flow_id"
      ],
      "title": "UnarchiveFlow",
      "type": "object"
    },
    "UpdateFlow": {
      "additionalProperties": false,
      "properties": {
        "flow_id": {
          "description": "The flow id from List Flows.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Flow Id",
          "type": "string"
        },
        "operation": {
          "const": "update_flow",
          "default": "update_flow",
          "title": "Update Flow",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "custom_fields": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CustomField"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Fields"
        },
        "due_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due At"
        },
        "clear_due_date": {
          "default": false,
          "description": "Remove the flow due date by sending dueAt: null.",
          "title": "Clear Due Date",
          "type": "boolean"
        }
      },
      "required": [
        "flow_id"
      ],
      "title": "UpdateFlow",
      "type": "object"
    }
  },
