      "description": "An existing approved TenantToken/UserToken pair; no login password.",
      "properties": {
        "credential_type": {
          "const": "skuvault_api_tokens",
          "default": "skuvault_api_tokens",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "tenant_token": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Tenant token",
          "type": "string",
          "ui:widget": "password"
        },
        "user_token": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "User token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "tenant_token",
        "user_token"
      ],
      "title": "SkuVault API Tokens",
      "type": "object",
      "x-credential-url": "https://dev.skuvault.com/reference/gettokens"
    },
