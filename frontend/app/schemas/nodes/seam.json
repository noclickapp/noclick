    "SeamAPIKeyCredential": {
      "additionalProperties": false,
      "properties": {
        "credential_type": {
          "const": "seam_api_key",
          "default": "seam_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
