{
  "$defs": {
    "CreateAccessCode": {
      "additionalProperties": false,
      "description": "Create an ongoing or scheduled access code for a device.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 12,
              "minLength": 4,
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Numeric access code; omit on creation to let Seam generate it.",
          "title": "Code"
        },
        "starts_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 timestamp including timezone.",
          "title": "Starts At"
        },
        "ends_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 timestamp including timezone, after starts_at.",
          "title": "Ends At"
        },
        "device_id": {
          "description": "Seam device ID, from List Devices.",
          "format": "uuid",
          "title": "Device Id",
          "type": "string"
        },
        "operation": {
          "const": "create_access_code",
          "default": "create_access_code",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "device_id"
      ],
      "title": "CreateAccessCode",
      "type": "object"
    },
    "DeleteAccessCode": {
