    "ListAccessCodes": {
      "additionalProperties": false,
      "description": "Return one page of access codes, optionally restricted to a device.",
      "properties": {
        "limit": {
          "default": 100,
          "description": "Maximum records on this page.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "page_cursor": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use pagination.next_page_cursor from the previous response; only one page is returned.",
          "title": "Page Cursor"
        },
        "operation": {
          "const": "list_access_codes",
          "default": "list_access_codes",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "device_id": {
          "anyOf": [
