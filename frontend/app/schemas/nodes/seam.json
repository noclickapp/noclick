        },
        {
          "$ref": "#/$defs/GetAccessCode"
        },
        {
          "$ref": "#/$defs/CreateAccessCode"
        },
        {
          "$ref": "#/$defs/UpdateAccessCode"
        },
        {
          "$ref": "#/$defs/DeleteAccessCode"
        },
        {
          "$ref": "#/$defs/ListConnectedAccounts"
        },
        {
          "$ref": "#/$defs/GetConnectedAccount"
        },
        {
