    "PredictLeadsAPIKeyTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "predictleads_api_key_token",
          "default": "predictleads_api_key_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API Key",
          "type": "string",
          "ui:sensitive": true,
          "ui:widget": "password"
        },
        "api_token": {
          "title": "API Token",
          "type": "string",
          "ui:sensitive": true,
          "ui:widget": "password"
        },
        "allowed_companies_json": {
          "description": "JSON string array of company UUIDs or bare domains. The picker uses this saved list without spending credits. Maximum 50 is a NoClick limit.",
          "title": "Approved Companies",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "allow_credit_reads": {
          "default": false,
          "description": "Permit this node to request company and signal datasets. Each company witness and dataset page costs one credit according to the current API spec.",
          "title": "Allow Credit-Consuming Reads",
          "type": "boolean"
        }
      },
      "required": [
        "api_key",
        "api_token",
        "allowed_companies_json"
      ],
      "title": "PredictLeads API Key and Token",
      "type": "object",
      "x-credential-instructions": "Enter the supplied key and token. Subscription checks use no credits; company and signal reads consume credits. Approved companies are a local workflow restriction, not vendor OAuth scopes.",
      "x-help-url": "https://docs.predictleads.com/swagger"
    },
