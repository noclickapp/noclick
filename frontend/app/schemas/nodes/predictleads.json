  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/CheckConnection",
          "get_company": "#/$defs/GetCompany",
          "list_job_openings": "#/$defs/ListJobOpenings",
          "list_news_events": "#/$defs/ListNewsEvents",
          "list_technology_detections": "#/$defs/ListTechnologyDetections"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CheckConnection"
        },
        {
          "$ref": "#/$defs/GetCompany"
        },
        {
          "$ref": "#/$defs/ListJobOpenings"
        },
        {
          "$ref": "#/$defs/ListNewsEvents"
        },
        {
          "$ref": "#/$defs/ListTechnologyDetections"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/PredictLeadsAPIKeyTokenCredential"
        },
        {
          "$ref": "#/$defs/PredictleadsMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
