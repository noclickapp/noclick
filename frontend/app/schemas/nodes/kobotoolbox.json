    "CreateExport": {
      "additionalProperties": false,
      "description": "Queue a CSV, XLS, GeoJSON or SPSS labels export; poll Get Export for completion.",
      "properties": {
        "project_id": {
          "description": "Project asset UID from the KoboToolbox project URL.",
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
