          "default": "_xml",
          "title": "Lang",
          "type": "string"
        },
        "multiple_select": {
          "default": "both",
          "enum": [
            "both",
            "summary",
            "details"
          ],
          "title": "Multiple Select",
          "type": "string"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "flatten": {
          "default": true,
          "title": "Flatten",
          "type": "boolean"
        },
        "xls_types_as_text": {
          "default": false,
          "title": "Xls Types As Text",
          "type": "boolean"
        },
        "include_media_url": {
          "default": false,
          "title": "Include Media Url",
          "type": "boolean"
        }
