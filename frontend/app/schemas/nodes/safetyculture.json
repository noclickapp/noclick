    },
    "GetTemplate": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_template",
          "default": "get_template",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        },
        "locale": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locale"
        }
      },
      "required": [
        "template_id"
      ],
      "title": "GetTemplate",
      "type": "object"
    },
    "ListActions": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_actions",
          "default": "list_actions",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "page_size": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use next_page_token from the previous response with the same page size.",
          "title": "Page Token"
        }
      },
      "title": "ListActions",
      "type": "object"
    },
    "ListGroups": {
      "additionalProperties": false,
      "description": "Read groups and organizations belonging to the token owner.",
      "properties": {
        "operation": {
          "const": "list_groups",
          "default": "list_groups",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListGroups",
      "type": "object"
    },
    "SafetyCultureAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "safetyculture_api_token",
          "default": "safetyculture_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "SafetyCulture API Token",
      "type": "object",
      "x-credential-instructions": "SafetyCulture is now Mitti. In your web app, open My Profile, Settings, API tokens and generate a user API token, or use an existing service user API token. Paste the token alone. Requests run with the token owner's permissions and access. Connection verification requires Platform management: Groups permission. User tokens expire after 30 days of inactivity. NoClick sends your token only to api.mitti.com.",
      "x-credential-url": "https://developer.mitti.com/reference/authentication"
    },
    "SearchInspections": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 100,
          "description": "One page only. Compare count and total; advance modified_after to continue. Equal timestamps may overlap: deduplicate IDs.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "order": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Order",
          "type": "string"
        },
        "modified_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modified After"
        },
        "modified_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modified Before"
        },
        "archived": {
          "default": "false",
          "enum": [
            "false",
            "true",
            "both"
          ],
          "title": "Archived",
          "type": "string"
        },
        "owner": {
          "default": "all",
          "enum": [
            "all",
            "me",
            "other"
          ],
          "title": "Owner",
          "type": "string"
        },
        "operation": {
          "const": "search_inspections",
          "default": "search_inspections",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "completed": {
          "default": "both",
          "enum": [
            "both",
            "false",
            "true"
          ],
          "title": "Completed",
          "type": "string"
        },
        "template": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template IDs. Sent as repeated query parameters.",
          "title": "Template"
        }
      },
      "title": "SearchInspections",
      "type": "object"
    },
