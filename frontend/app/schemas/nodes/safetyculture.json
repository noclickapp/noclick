        "operation": {
          "const": "search_templates",
          "default": "search_templates",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "SearchTemplates",
      "type": "object"
    },
    "UpdateActionDescription": {
