      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "complete_inspection",
          "default": "complete_inspection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "inspection_id": {
          "title": "Inspection Id",
          "type": "string"
        }
      },
      "required": [
        "inspection_id"
      ],
      "title": "CompleteInspection",
      "type": "object"
    },
    "CreateAction": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_action",
          "default": "create_action",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "title": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 30000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "due_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due At"
        },
        "site_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site Id"
        },
        "inspection_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inspection Id"
        },
        "priority_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority Id"
        },
        "status_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Id"
        }
      },
      "required": [
        "title"
      ],
      "title": "CreateAction",
      "type": "object"
    },
    "CreateInspection": {
      "additionalProperties": false,
      "description": "Create an inspection from a template without pre-filled answers.",
      "properties": {
        "operation": {
          "const": "create_inspection",
          "default": "create_inspection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        }
      },
      "required": [
        "template_id"
      ],
      "title": "CreateInspection",
      "type": "object"
    },
    "GetAction": {
