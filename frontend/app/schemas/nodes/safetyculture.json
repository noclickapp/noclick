  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "complete_inspection": "#/$defs/CompleteInspection",
          "create_action": "#/$defs/CreateAction",
          "create_inspection": "#/$defs/CreateInspection",
          "get_action": "#/$defs/GetAction",
          "get_inspection": "#/$defs/GetInspection",
          "get_template": "#/$defs/GetTemplate",
          "list_actions": "#/$defs/ListActions",
          "list_groups": "#/$defs/ListGroups",
          "search_inspections": "#/$defs/SearchInspections",
          "search_templates": "#/$defs/SearchTemplates",
          "update_action_description": "#/$defs/UpdateActionDescription",
          "update_action_due_date": "#/$defs/UpdateActionDueDate",
          "update_action_priority": "#/$defs/UpdateActionPriority",
          "update_action_status": "#/$defs/UpdateActionStatus",
          "update_action_title": "#/$defs/UpdateActionTitle"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListGroups"
        },
        {
          "$ref": "#/$defs/SearchInspections"
        },
        {
          "$ref": "#/$defs/SearchTemplates"
        },
        {
          "$ref": "#/$defs/GetTemplate"
        },
        {
          "$ref": "#/$defs/GetInspection"
        },
        {
          "$ref": "#/$defs/CreateInspection"
        },
        {
          "$ref": "#/$defs/CompleteInspection"
        },
        {
          "$ref": "#/$defs/ListActions"
        },
        {
          "$ref": "#/$defs/GetAction"
        },
        {
          "$ref": "#/$defs/CreateAction"
        },
        {
          "$ref": "#/$defs/UpdateActionTitle"
        },
        {
          "$ref": "#/$defs/UpdateActionDescription"
        },
        {
          "$ref": "#/$defs/UpdateActionStatus"
        },
        {
          "$ref": "#/$defs/UpdateActionPriority"
        },
        {
          "$ref": "#/$defs/UpdateActionDueDate"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/SafetyCultureAPITokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
