  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_rows": "#/$defs/BotpressCreateRows",
          "create_table": "#/$defs/BotpressCreateTable",
          "delete_rows": "#/$defs/BotpressDeleteRows",
          "delete_table": "#/$defs/BotpressDeleteTable",
          "find_rows": "#/$defs/BotpressFindRows",
          "get_bound_bot": "#/$defs/BotpressGetBoundBot",
          "get_file": "#/$defs/BotpressGetFile",
          "get_row": "#/$defs/BotpressGetRow",
          "get_table": "#/$defs/BotpressGetTable",
          "get_workspace": "#/$defs/BotpressGetWorkspace",
          "list_bots": "#/$defs/BotpressListBots",
          "list_files": "#/$defs/BotpressListFiles",
          "list_tables": "#/$defs/BotpressListTables",
          "update_rows": "#/$defs/BotpressUpdateRows"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BotpressGetWorkspace"
        },
        {
          "$ref": "#/$defs/BotpressListBots"
        },
        {
          "$ref": "#/$defs/BotpressGetBoundBot"
        },
        {
          "$ref": "#/$defs/BotpressListTables"
        },
        {
          "$ref": "#/$defs/BotpressGetTable"
        },
        {
          "$ref": "#/$defs/BotpressCreateTable"
        },
        {
          "$ref": "#/$defs/BotpressDeleteTable"
        },
        {
          "$ref": "#/$defs/BotpressFindRows"
        },
        {
          "$ref": "#/$defs/BotpressGetRow"
        },
        {
          "$ref": "#/$defs/BotpressCreateRows"
        },
        {
          "$ref": "#/$defs/BotpressUpdateRows"
        },
        {
          "$ref": "#/$defs/BotpressDeleteRows"
        },
        {
          "$ref": "#/$defs/BotpressListFiles"
        },
        {
          "$ref": "#/$defs/BotpressGetFile"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/BotpressPATCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Botpress Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
