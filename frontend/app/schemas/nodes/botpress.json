    "BotpressListBots": {
      "additionalProperties": false,
      "properties": {
        "next_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque next_token from the previous result. One complete bounded provider page is returned; no invented server page size.",
          "title": "Next Page Token"
        },
        "sort_direction": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Sort Direction",
          "type": "string"
        },
        "operation": {
          "const": "list_bots",
          "default": "list_bots",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Administration",
          "x-display-name": "List Workspace Bots",
          "x-is-trigger": false
        },
        "dev": {
          "default": false,
          "description": "False lists production bots; true lists development bots.",
          "title": "Development Bots",
          "type": "boolean"
        },
        "sort_field": {
          "default": "createdAt",
          "enum": [
            "createdAt",
            "updatedAt"
          ],
          "title": "Sort Field",
          "type": "string"
        }
      },
      "title": "BotpressListBots",
      "type": "object"
    },
    "BotpressListFiles": {
      "additionalProperties": false,
      "properties": {
        "next_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque next_token from the previous result. One complete bounded provider page is returned; no invented server page size.",
          "title": "Next Page Token"
        },
        "sort_direction": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Sort Direction",
          "type": "string"
        },
        "operation": {
          "const": "list_files",
          "default": "list_files",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Files",
          "x-display-name": "List Bot File Metadata",
          "x-is-trigger": false
        },
        "sort_field": {
          "default": "createdAt",
          "enum": [
            "key",
            "size",
            "createdAt",
            "updatedAt",
            "status"
          ],
          "title": "Sort Field",
          "type": "string"
        },
        "indexed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indexed Files Filter"
        }
      },
      "title": "BotpressListFiles",
      "type": "object"
