          "minLength": 1,
          "title": "Table",
          "type": "string",
          "x-dynamic-options": {
            "field": "table",
            "type": "botpress",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "update_rows",
          "default": "update_rows",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Rows",
          "x-display-name": "Update Table Rows",
          "x-is-trigger": false
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/BotpressUpdatedRow"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Existing Rows",
          "type": "array"
        }
      },
      "required": [
        "table",
        "rows"
      ],
      "title": "BotpressUpdateRows",
      "type": "object"
    },
    "BotpressUpdatedRow": {
      "additionalProperties": false,
      "properties": {
        "values": {
          "additionalProperties": true,
          "description": "Top-level string, number, boolean or null values only, at most 4KB per row. No computed or credential fields.",
          "maxProperties": 20,
          "minProperties": 1,
          "title": "Scalar Values",
          "type": "object"
        },
        "row_id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Existing Row ID",
          "type": "integer"
        }
      },
      "required": [
        "values",
        "row_id"
      ],
      "title": "BotpressUpdatedRow",
      "type": "object"
    }
