{
  "$defs": {
    "BotpressColumn": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Column Name",
          "type": "string"
        },
        "value_type": {
          "default": "string",
          "enum": [
            "string",
            "number",
            "boolean"
          ],
          "title": "Scalar Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "BotpressColumn",
      "type": "object"
    },
    "BotpressCreateRows": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Table",
          "type": "string",
          "x-dynamic-options": {
            "field": "table",
            "type": "botpress",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "create_rows",
          "default": "create_rows",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Rows",
          "x-display-name": "Create Table Rows",
          "x-is-trigger": false
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/BotpressRow"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "table",
        "rows"
      ],
      "title": "BotpressCreateRows",
      "type": "object"
    },
    "BotpressCreateTable": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_table",
          "default": "create_table",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Tables",
          "x-display-name": "Create Plain Data Table",
          "x-is-trigger": false
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Table Name",
          "type": "string"
        },
        "columns": {
          "description": "Creates a factor-1 table with computation disabled and no searchable/computed columns. Stores data and consumes normal table quota.",
          "items": {
            "$ref": "#/$defs/BotpressColumn"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Scalar Columns",
          "type": "array"
        }
      },
      "required": [
        "name",
        "columns"
      ],
      "title": "BotpressCreateTable",
      "type": "object"
    },
    "BotpressDeleteRows": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Table",
          "type": "string",
          "x-dynamic-options": {
            "field": "table",
            "type": "botpress",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "delete_rows",
          "default": "delete_rows",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Rows",
          "x-display-name": "Delete Selected Table Rows",
          "x-is-trigger": false
        },
        "row_ids": {
          "items": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Existing Row IDs",
          "type": "array"
        }
      },
      "required": [
        "table",
        "row_ids"
      ],
      "title": "BotpressDeleteRows",
      "type": "object"
    },
    "BotpressDeleteTable": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Table",
          "type": "string",
          "x-dynamic-options": {
            "field": "table",
            "type": "botpress",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "delete_table",
          "default": "delete_table",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Tables",
          "x-display-name": "Delete Plain Data Table",
          "x-is-trigger": false
        },
        "confirm_delete": {
          "const": true,
          "description": "Permanently removes this table and its rows; workflows using it can be affected.",
          "title": "Confirm Permanent Table Deletion",
          "type": "boolean"
        }
      },
      "required": [
        "table",
        "confirm_delete"
      ],
      "title": "BotpressDeleteTable",
      "type": "object"
    },
    "BotpressFindRows": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Table",
          "type": "string",
          "x-dynamic-options": {
            "field": "table",
            "type": "botpress",
            "auto_select_sole_option": true
          }
        },
        "columns": {
          "description": "Explicit top-level projection. System IDs/timestamps remain; secrets, configuration, computed diagnostics and nested values are omitted.",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Returned Scalar Columns",
          "type": "array"
        },
        "operation": {
          "const": "find_rows",
          "default": "find_rows",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Rows",
          "x-display-name": "Find Table Rows",
          "x-is-trigger": false
        },
        "limit": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "order_direction": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "ID Sort Direction",
          "type": "string"
        }
      },
      "required": [
        "table",
        "columns"
      ],
      "title": "BotpressFindRows",
      "type": "object"
    },
    "BotpressGetBoundBot": {
