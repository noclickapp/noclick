{
  "$defs": {
    "FormstepAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "formstep_api_token",
          "default": "formstep_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Formstep API Token",
      "type": "object",
      "x-credential-instructions": "In Formstep, open OAuth and API Keys in the sidebar. Create a token for the workspace you want to automate and paste it here. Tokens can access one workspace only.",
      "x-credential-url": "https://docs.formstep.io/developers/api-tokens/"
    },
    "FormstepCancelRequestConfig": {
