            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Your note for why, kept on the request and sent in the callback.",
          "title": "Reason"
        }
      },
      "required": [
        "requestId"
      ],
      "title": "FormstepCancelRequestConfig",
      "type": "object"
    },
    "FormstepCreateFolderConfig": {
      "additionalProperties": false,
