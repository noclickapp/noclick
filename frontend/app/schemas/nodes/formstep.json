    "FormstepCreateRequestConfig": {
      "additionalProperties": false,
      "description": "Create a request.",
      "properties": {
        "operation": {
          "const": "create_request",
          "default": "create_request",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Requests",
          "x-display-name": "Create Request"
        },
        "formId": {
          "description": "The published form to assign.",
          "title": "Form id",
          "type": "string"
        },
        "recipient": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An email is required when `delivery` is `\"email\"`; otherwise it only identifies the person in the Requests page and on their answers.",
          "title": "Recipient",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "prefill": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Initial answers by field key. The recipient sees them and can change them.",
          "title": "Prefill",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "readonly": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prefilled keys the recipient cannot change. Every key here must also appear in `prefill`, and a locked required field must be prefilled with a non-empty value.",
          "title": "Readonly",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "context": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Values for the form's hidden fields, by field key. Trusted, unchangeable, and echoed back in the callback. An unknown key is rejected with `UNKNOWN_FIELD_KEY`.",
          "title": "Context",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "metadata": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Your own bookkeeping. Never reaches the form; comes back in callbacks and reads.",
          "title": "Metadata",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One of the form's published languages. Defaults to the form's own default.",
          "title": "Language"
        },
        "delivery": {
          "anyOf": [
            {
              "enum": [
                "none",
                "email"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "none",
          "description": "`\"email\"` to have Formstep send the invitation (needs a recipient email, and Pro or Business or one of a Free account's 10 free invitations, which go only to the account's own address), or `\"none\"` to deliver the link yourself.",
          "title": "Delivery",
          "enum": [
            "none",
            "email"
          ],
          "x-enum-searchable": true
        },
        "reminders": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the form's reminder schedule for this request. An empty array switches reminders off.",
          "title": "Reminders",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Epoch milliseconds. Defaults to 30 days out; 365 days is the maximum.",
          "title": "Expires at"
        },
        "callbackUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where Formstep POSTs the callback when the request ends. HTTPS only, and the host must resolve to a public address.",
          "title": "Callback url"
        },
        "externalId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Your own id for this request. Filterable in `requests.list`.",
          "title": "External id"
        },
        "idempotencyKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeating it with the same body returns the original request with `deduplicated: true`. A different body is rejected. Keys live 30 days.",
          "title": "Idempotency key"
        },
        "domainId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mint the link on one of your custom domains. REST API only.",
          "title": "Domain id"
        },
        "documents": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "items": {
                  "$ref": "#/$defs/FormstepDocument"
                },
                "type": "array"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Files handed to this one recipient, uploaded first with `documents.create`.",
          "title": "Documents",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "test": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": false,
          "description": "A dry run: nothing is emailed, the callback carries `\"test\": true`, and the submission counts nowhere.",
          "title": "Test"
        }
      },
      "required": [
        "formId"
      ],
      "title": "FormstepCreateRequestConfig",
      "type": "object"
    },
