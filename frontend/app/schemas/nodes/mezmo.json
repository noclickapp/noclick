{
  "$defs": {
    "MezmoAccessKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "mezmo_access_key",
          "default": "mezmo_access_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Access key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_key"
      ],
      "title": "Mezmo Access Key",
      "type": "object",
      "x-credential-instructions": "Paste a Mezmo enterprise access key with permission for the operations you use. Create an enterprise service account access key in Mezmo, or use a personal access key with enterprise access. Paste only the key, without the Token prefix. NoClick checks it by reading your enterprise and child accounts.",
      "x-credential-url": "https://docs.mezmo.com/docs/api"
    },
    "MezmoAccountFields": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "anyOf": [
            {
              "maxLength": 250,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company"
        },
        "owneremail": {
          "anyOf": [
            {
              "format": "email",
              "maxLength": 320,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner email"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/MezmoPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retention": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Log retention in days.",
          "title": "Retention"
        },
        "enable_syslog": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enable Syslog"
        },
        "include_admins": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Include Admins"
        }
      },
      "title": "MezmoAccountFields",
      "type": "object"
    },
    "MezmoAttachAccountConfig": {
      "additionalProperties": false,
      "description": "Link an existing account to the enterprise, optionally changing its owner or plan.",
      "properties": {
        "account_id": {
          "description": "Mezmo child account ID.",
          "maxLength": 24,
          "minLength": 1,
          "title": "Account Id",
          "type": "string"
        },
        "operation": {
          "const": "attach_account",
          "default": "attach_account",
          "title": "Operation",
          "type": "string"
        },
        "plan": {
          "anyOf": [
            {
              "maxLength": 50,
              "minLength": 4,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan"
        },
        "owner": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New owner email"
        }
      },
      "required": [
        "account_id"
      ],
      "title": "MezmoAttachAccountConfig",
      "type": "object"
    },
    "MezmoBulkAccountsConfig": {
      "additionalProperties": false,
      "description": "Create, update or delete up to 100 child accounts; inspect each returned outcome.",
      "properties": {
        "operation": {
          "const": "bulk_account_operations",
          "default": "bulk_account_operations",
          "title": "Operation",
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/MezmoBulkOperation"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        }
      },
      "required": [
        "operations"
      ],
      "title": "MezmoBulkAccountsConfig",
      "type": "object"
    },
    "MezmoBulkOperation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "CREATE",
            "UPDATE",
            "DELETE"
          ],
          "title": "Action",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "entity": {
          "anyOf": [
            {
              "$ref": "#/$defs/MezmoAccountFields"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action"
      ],
      "title": "MezmoBulkOperation",
      "type": "object"
    },
    "MezmoCreateAccountConfig": {
      "additionalProperties": false,
      "description": "Create a child organization; may provision its owner and billing plan.",
      "properties": {
        "operation": {
          "const": "create_account",
          "default": "create_account",
          "title": "Operation",
          "type": "string"
        },
        "account": {
          "$ref": "#/$defs/MezmoAccountFields",
          "description": "Fields for the new child organization."
        }
      },
      "required": [
        "account"
      ],
      "title": "MezmoCreateAccountConfig",
      "type": "object"
    },
    "MezmoDetachAccountConfig": {
      "additionalProperties": false,
      "description": "Unlink a child account and downgrade it to trial, optionally deactivating it.",
      "properties": {
        "account_id": {
          "description": "Mezmo child account ID.",
          "maxLength": 24,
          "minLength": 1,
          "title": "Account Id",
          "type": "string"
        },
        "operation": {
          "const": "detach_account",
          "default": "detach_account",
          "title": "Operation",
          "type": "string"
        },
        "deactivate": {
          "default": false,
          "description": "Also deactivate the account after detaching it.",
          "title": "Deactivate",
          "type": "boolean"
        }
      },
      "required": [
        "account_id"
      ],
      "title": "MezmoDetachAccountConfig",
      "type": "object"
    },
    "MezmoGetAccountConfig": {
      "additionalProperties": false,
      "description": "Retrieve one child account of your enterprise.",
      "properties": {
        "account_id": {
          "description": "Mezmo child account ID.",
          "maxLength": 24,
          "minLength": 1,
          "title": "Account Id",
          "type": "string"
        },
        "operation": {
          "const": "get_account",
          "default": "get_account",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "account_id"
      ],
      "title": "MezmoGetAccountConfig",
      "type": "object"
    },
    "MezmoGetEnterpriseConfig": {
      "additionalProperties": false,
      "description": "Get your enterprise identity and its child accounts.",
      "properties": {
        "operation": {
          "const": "get_enterprise",
          "default": "get_enterprise",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "MezmoGetEnterpriseConfig",
      "type": "object"
    },
    "MezmoListPipelinesConfig": {
      "additionalProperties": false,
      "description": "List pipelines across all child organizations.",
      "properties": {
        "operation": {
          "const": "list_pipelines",
          "default": "list_pipelines",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "MezmoListPipelinesConfig",
      "type": "object"
    },
    "MezmoPipelineHealthConfig": {
      "additionalProperties": false,
      "description": "Read pipeline health across all child organizations, optionally including transform logs.",
      "properties": {
        "operation": {
          "const": "get_pipeline_health",
          "default": "get_pipeline_health",
          "title": "Operation",
          "type": "string"
        },
        "include_logs": {
          "default": true,
          "title": "Include Logs",
          "type": "boolean"
        }
      },
      "title": "MezmoPipelineHealthConfig",
      "type": "object"
    },
    "MezmoPipelineNodeSchemasConfig": {
      "additionalProperties": false,
      "description": "Get pipeline node types, operators and alert schemas.",
      "properties": {
        "operation": {
          "const": "get_pipeline_node_schemas",
          "default": "get_pipeline_node_schemas",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "MezmoPipelineNodeSchemasConfig",
      "type": "object"
    },
    "MezmoPipelineUsageConfig": {
      "additionalProperties": false,
      "description": "Read pipeline usage for a time window across child organizations.",
      "properties": {
        "operation": {
          "const": "get_pipeline_usage",
          "default": "get_pipeline_usage",
          "title": "Operation",
          "type": "string"
        },
        "from_time": {
          "description": "Beginning of the window as an RFC 3339 date-time with timezone.",
          "title": "From Time",
          "type": "string"
        },
        "to_time": {
          "description": "End of the window as an RFC 3339 date-time with timezone.",
          "title": "To Time",
          "type": "string"
        },
        "bucket": {
          "description": "Size of the interval represented by each returned metric result.",
          "title": "Bucket",
          "type": "integer"
        },
        "include_deleted": {
          "default": true,
          "title": "Include Deleted",
          "type": "boolean"
        },
        "pipeline_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipeline Id"
        },
        "traffic": {
          "anyOf": [
            {
              "enum": [
                "ingress",
                "egress"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traffic",
          "enum": [
            "ingress",
            "egress"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "from_time",
        "to_time",
        "bucket"
      ],
      "title": "MezmoPipelineUsageConfig",
      "type": "object"
    },
    "MezmoPlan": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "Billing plan type, for example enterprise.",
          "maxLength": 50,
          "minLength": 4,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "MezmoPlan",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "attach_account": "#/$defs/MezmoAttachAccountConfig",
          "bulk_account_operations": "#/$defs/MezmoBulkAccountsConfig",
          "create_account": "#/$defs/MezmoCreateAccountConfig",
          "detach_account": "#/$defs/MezmoDetachAccountConfig",
          "get_account": "#/$defs/MezmoGetAccountConfig",
          "get_enterprise": "#/$defs/MezmoGetEnterpriseConfig",
          "get_pipeline_health": "#/$defs/MezmoPipelineHealthConfig",
          "get_pipeline_node_schemas": "#/$defs/MezmoPipelineNodeSchemasConfig",
          "get_pipeline_usage": "#/$defs/MezmoPipelineUsageConfig",
          "list_pipelines": "#/$defs/MezmoListPipelinesConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MezmoGetEnterpriseConfig"
        },
        {
          "$ref": "#/$defs/MezmoBulkAccountsConfig"
        },
        {
          "$ref": "#/$defs/MezmoCreateAccountConfig"
        },
        {
          "$ref": "#/$defs/MezmoGetAccountConfig"
        },
        {
          "$ref": "#/$defs/MezmoAttachAccountConfig"
        },
        {
          "$ref": "#/$defs/MezmoDetachAccountConfig"
        },
        {
          "$ref": "#/$defs/MezmoListPipelinesConfig"
        },
        {
          "$ref": "#/$defs/MezmoPipelineHealthConfig"
        },
        {
          "$ref": "#/$defs/MezmoPipelineUsageConfig"
        },
        {
          "$ref": "#/$defs/MezmoPipelineNodeSchemasConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MezmoAccessKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Mezmo Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
