            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom callback reference; check_idx prevents duplicate sends for this reference within 24 hours.",
          "title": "Idx"
        },
        "check_idx": {
          "default": false,
          "title": "Check Idx",
          "type": "boolean"
        },
        "max_parts": {
          "default": 6,
          "maximum": 6,
          "minimum": 1,
          "title": "Max Parts",
          "type": "integer"
        }
