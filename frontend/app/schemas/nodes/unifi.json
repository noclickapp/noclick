{
  "$defs": {
    "UnifiAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "unifi_api_key",
          "default": "unifi_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "UniFi API Key",
      "type": "object",
      "x-credential-instructions": "Create an API key in UniFi Site Manager Settings > API Keys and paste it here. Inventory and metrics use the key owner's access. Console requests require firmware 5.0.3 or later and access to the owner's console, or a console in the key's organization.",
      "x-credential-url": "https://unifi.ui.com/"
    },
    "UnifiConnectorDeleteConfig": {
      "additionalProperties": false,
      "description": "Forward one DELETE request to a console application. Consult the application API contract for its payload.",
      "properties": {
        "id": {
          "description": "Host or SD-WAN configuration ID from its list operation.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "path": {
          "description": "Application API path, e.g. network/integration/v1/sites. No host, /proxy prefix, query or fragment. Requires firmware >=5.0.3 and access to the console.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "operation": {
          "const": "connector_delete",
          "default": "connector_delete",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "id",
        "path"
      ],
      "title": "UnifiConnectorDeleteConfig",
      "type": "object"
    },
    "UnifiConnectorGetConfig": {
      "additionalProperties": false,
      "description": "Forward one GET request to a console application. Consult the application API contract for its payload.",
      "properties": {
        "id": {
          "description": "Host or SD-WAN configuration ID from its list operation.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "path": {
          "description": "Application API path, e.g. network/integration/v1/sites. No host, /proxy prefix, query or fragment. Requires firmware >=5.0.3 and access to the console.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "operation": {
          "const": "connector_get",
          "default": "connector_get",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "id",
        "path"
      ],
      "title": "UnifiConnectorGetConfig",
      "type": "object"
    },
    "UnifiConnectorPatchConfig": {
      "additionalProperties": false,
      "description": "Forward one PATCH request to a console application. Consult the application API contract for its payload.",
      "properties": {
        "id": {
          "description": "Host or SD-WAN configuration ID from its list operation.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "path": {
          "description": "Application API path, e.g. network/integration/v1/sites. No host, /proxy prefix, query or fragment. Requires firmware >=5.0.3 and access to the console.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "body": {
          "additionalProperties": true,
          "description": "JSON object for the target application's documented endpoint. Sent unchanged. No automatic retries.",
          "title": "Body",
          "type": "object"
        },
        "operation": {
          "const": "connector_patch",
          "default": "connector_patch",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "id",
        "path",
        "body"
      ],
      "title": "UnifiConnectorPatchConfig",
      "type": "object"
    },
    "UnifiConnectorPostConfig": {
      "additionalProperties": false,
      "description": "Forward one POST request to a console application. Consult the application API contract for its payload.",
      "properties": {
        "id": {
          "description": "Host or SD-WAN configuration ID from its list operation.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "path": {
          "description": "Application API path, e.g. network/integration/v1/sites. No host, /proxy prefix, query or fragment. Requires firmware >=5.0.3 and access to the console.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "body": {
          "additionalProperties": true,
          "description": "JSON object for the target application's documented endpoint. Sent unchanged. No automatic retries.",
          "title": "Body",
          "type": "object"
        },
        "operation": {
          "const": "connector_post",
          "default": "connector_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "id",
        "path",
        "body"
      ],
      "title": "UnifiConnectorPostConfig",
      "type": "object"
    },
    "UnifiConnectorPutConfig": {
      "additionalProperties": false,
      "description": "Forward one PUT request to a console application. Consult the application API contract for its payload.",
      "properties": {
        "id": {
          "description": "Host or SD-WAN configuration ID from its list operation.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "path": {
          "description": "Application API path, e.g. network/integration/v1/sites. No host, /proxy prefix, query or fragment. Requires firmware >=5.0.3 and access to the console.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "body": {
          "additionalProperties": true,
          "description": "JSON object for the target application's documented endpoint. Sent unchanged. No automatic retries.",
          "title": "Body",
          "type": "object"
        },
        "operation": {
          "const": "connector_put",
          "default": "connector_put",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "id",
        "path",
        "body"
      ],
      "title": "UnifiConnectorPutConfig",
      "type": "object"
    },
    "UnifiGetHostConfig": {
      "additionalProperties": false,
      "description": "Get a host by ID.",
      "properties": {
        "id": {
          "description": "Host or SD-WAN configuration ID from its list operation.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "const": "get_host",
          "default": "get_host",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "id"
      ],
      "title": "UnifiGetHostConfig",
      "type": "object"
    },
    "UnifiGetISPMetricsConfig": {
      "additionalProperties": false,
      "description": "Get ISP metrics across all sites.",
      "properties": {
        "begin_timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Begin Timestamp"
        },
        "end_timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Timestamp"
        },
        "type": {
          "default": "5m",
          "enum": [
            "5m",
            "1h"
          ],
          "title": "Metric interval",
          "type": "string"
        },
        "operation": {
          "const": "get_isp_metrics",
          "default": "get_isp_metrics",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "duration": {
          "anyOf": [
            {
              "enum": [
                "24h",
                "7d",
                "30d"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration",
          "enum": [
            "24h",
            "7d",
            "30d"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "UnifiGetISPMetricsConfig",
      "type": "object"
    },
    "UnifiGetSDWanConfigConfig": {
      "additionalProperties": false,
      "description": "Get a SD-WAN configuration.",
      "properties": {
        "id": {
          "description": "Host or SD-WAN configuration ID from its list operation.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "const": "get_sd_wan_config",
          "default": "get_sd_wan_config",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "id"
      ],
      "title": "UnifiGetSDWanConfigConfig",
      "type": "object"
    },
    "UnifiGetSDWanConfigStatusConfig": {
      "additionalProperties": false,
      "description": "Get SD-WAN deployment status.",
      "properties": {
        "id": {
          "description": "Host or SD-WAN configuration ID from its list operation.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "const": "get_sd_wan_config_status",
          "default": "get_sd_wan_config_status",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "id"
      ],
      "title": "UnifiGetSDWanConfigStatusConfig",
      "type": "object"
    },
    "UnifiListDevicesConfig": {
      "additionalProperties": false,
      "description": "List devices managed by your hosts.",
      "properties": {
        "page_size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Items per page (pageSize).",
          "title": "Page Size"
        },
        "next_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque nextToken from the previous response. One page per execution.",
          "title": "Next Token"
        },
        "operation": {
          "const": "list_devices",
          "default": "list_devices",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "host_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host Ids"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last processed timestamp in RFC3339 format.",
          "title": "Time"
        }
      },
      "title": "UnifiListDevicesConfig",
      "type": "object"
    },
    "UnifiListHostsConfig": {
      "additionalProperties": false,
      "description": "List hosts associated with your UI account.",
      "properties": {
        "page_size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Items per page (pageSize).",
          "title": "Page Size"
        },
        "next_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque nextToken from the previous response. One page per execution.",
          "title": "Next Token"
        },
        "operation": {
          "const": "list_hosts",
          "default": "list_hosts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "UnifiListHostsConfig",
      "type": "object"
    },
    "UnifiListSDWanConfigsConfig": {
      "additionalProperties": false,
      "description": "List SD-WAN configurations.",
      "properties": {
        "operation": {
          "const": "list_sd_wan_configs",
          "default": "list_sd_wan_configs",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "UnifiListSDWanConfigsConfig",
      "type": "object"
    },
    "UnifiListSitesConfig": {
      "additionalProperties": false,
      "description": "List Network sites and statistics.",
      "properties": {
        "page_size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Items per page (pageSize).",
          "title": "Page Size"
        },
        "next_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque nextToken from the previous response. One page per execution.",
          "title": "Next Token"
        },
        "operation": {
          "const": "list_sites",
          "default": "list_sites",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "UnifiListSitesConfig",
      "type": "object"
    },
    "UnifiMetricSite": {
      "additionalProperties": false,
      "properties": {
        "begin_timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Begin Timestamp"
        },
        "end_timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Timestamp"
        },
        "host_id": {
          "minLength": 1,
          "title": "Host Id",
          "type": "string"
        },
        "site_id": {
          "minLength": 1,
          "title": "Site Id",
          "type": "string"
        }
      },
      "required": [
        "host_id",
        "site_id"
      ],
      "title": "UnifiMetricSite",
      "type": "object"
    },
    "UnifiQueryISPMetricsConfig": {
      "additionalProperties": false,
      "description": "Query ISP metrics for host/site pairs; partialSuccess is preserved.",
      "properties": {
        "type": {
          "default": "5m",
          "enum": [
            "5m",
            "1h"
          ],
          "title": "Metric interval",
          "type": "string"
        },
        "operation": {
          "const": "query_isp_metrics",
          "default": "query_isp_metrics",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "sites": {
          "items": {
            "$ref": "#/$defs/UnifiMetricSite"
          },
          "minItems": 1,
          "title": "Sites",
          "type": "array"
        }
      },
      "required": [
        "sites"
      ],
      "title": "UnifiQueryISPMetricsConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "connector_delete": "#/$defs/UnifiConnectorDeleteConfig",
          "connector_get": "#/$defs/UnifiConnectorGetConfig",
          "connector_patch": "#/$defs/UnifiConnectorPatchConfig",
          "connector_post": "#/$defs/UnifiConnectorPostConfig",
          "connector_put": "#/$defs/UnifiConnectorPutConfig",
          "get_host": "#/$defs/UnifiGetHostConfig",
          "get_isp_metrics": "#/$defs/UnifiGetISPMetricsConfig",
          "get_sd_wan_config": "#/$defs/UnifiGetSDWanConfigConfig",
          "get_sd_wan_config_status": "#/$defs/UnifiGetSDWanConfigStatusConfig",
          "list_devices": "#/$defs/UnifiListDevicesConfig",
          "list_hosts": "#/$defs/UnifiListHostsConfig",
          "list_sd_wan_configs": "#/$defs/UnifiListSDWanConfigsConfig",
          "list_sites": "#/$defs/UnifiListSitesConfig",
          "query_isp_metrics": "#/$defs/UnifiQueryISPMetricsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/UnifiListHostsConfig"
        },
        {
          "$ref": "#/$defs/UnifiGetHostConfig"
        },
        {
          "$ref": "#/$defs/UnifiListSitesConfig"
        },
        {
          "$ref": "#/$defs/UnifiListDevicesConfig"
        },
        {
          "$ref": "#/$defs/UnifiGetISPMetricsConfig"
        },
        {
          "$ref": "#/$defs/UnifiQueryISPMetricsConfig"
        },
        {
          "$ref": "#/$defs/UnifiListSDWanConfigsConfig"
        },
        {
          "$ref": "#/$defs/UnifiGetSDWanConfigConfig"
        },
        {
          "$ref": "#/$defs/UnifiGetSDWanConfigStatusConfig"
        },
        {
          "$ref": "#/$defs/UnifiConnectorGetConfig"
        },
        {
          "$ref": "#/$defs/UnifiConnectorPostConfig"
        },
        {
          "$ref": "#/$defs/UnifiConnectorPutConfig"
        },
        {
          "$ref": "#/$defs/UnifiConnectorPatchConfig"
        },
        {
          "$ref": "#/$defs/UnifiConnectorDeleteConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnifiAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Unifi Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
