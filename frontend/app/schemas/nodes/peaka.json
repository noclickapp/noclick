  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_catalog": "#/$defs/PeakaCreateCatalogConfig",
          "create_internal_table": "#/$defs/PeakaCreateInternalTableConfig",
          "create_query": "#/$defs/PeakaCreateQueryConfig",
          "delete_catalog": "#/$defs/PeakaDeleteCatalogConfig",
          "delete_internal_table": "#/$defs/PeakaDeleteInternalTableConfig",
          "delete_query": "#/$defs/PeakaDeleteQueryConfig",
          "execute_query": "#/$defs/PeakaExecuteQueryConfig",
          "get_catalog": "#/$defs/PeakaGetCatalogConfig",
          "get_query": "#/$defs/PeakaGetQueryConfig",
          "list_catalogs": "#/$defs/PeakaListCatalogsConfig",
          "list_columns": "#/$defs/PeakaListColumnsConfig",
          "list_internal_columns": "#/$defs/PeakaListInternalColumnsConfig",
          "list_internal_tables": "#/$defs/PeakaListInternalTablesConfig",
          "list_queries": "#/$defs/PeakaListQueriesConfig",
          "list_schemas": "#/$defs/PeakaListSchemasConfig",
          "list_tables": "#/$defs/PeakaListTablesConfig",
          "update_query": "#/$defs/PeakaUpdateQueryConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PeakaListCatalogsConfig"
        },
        {
          "$ref": "#/$defs/PeakaCreateCatalogConfig"
        },
        {
          "$ref": "#/$defs/PeakaGetCatalogConfig"
        },
        {
          "$ref": "#/$defs/PeakaDeleteCatalogConfig"
        },
        {
          "$ref": "#/$defs/PeakaListSchemasConfig"
        },
        {
          "$ref": "#/$defs/PeakaListTablesConfig"
        },
        {
          "$ref": "#/$defs/PeakaListColumnsConfig"
        },
        {
          "$ref": "#/$defs/PeakaListInternalTablesConfig"
        },
        {
          "$ref": "#/$defs/PeakaCreateInternalTableConfig"
        },
        {
          "$ref": "#/$defs/PeakaDeleteInternalTableConfig"
        },
        {
          "$ref": "#/$defs/PeakaListInternalColumnsConfig"
        },
        {
          "$ref": "#/$defs/PeakaListQueriesConfig"
        },
        {
          "$ref": "#/$defs/PeakaCreateQueryConfig"
        },
        {
          "$ref": "#/$defs/PeakaGetQueryConfig"
        },
        {
          "$ref": "#/$defs/PeakaUpdateQueryConfig"
        },
        {
          "$ref": "#/$defs/PeakaDeleteQueryConfig"
        },
        {
          "$ref": "#/$defs/PeakaExecuteQueryConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/PeakaAPIKeyCredential"
        },
        {
          "$ref": "#/$defs/PeakaMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "Peaka Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
