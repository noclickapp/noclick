    "PeakaExecuteQueryConfig": {
      "additionalProperties": false,
      "description": "Execute query in the connected project.",
      "properties": {
        "operation": {
          "const": "execute_query",
          "default": "execute_query",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "statement": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "bindings": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bindings"
        },
        "timeout": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "format": {
          "default": "SIMPLE",
          "enum": [
            "CELL_TYPED",
            "SIMPLE",
            "COMPACT"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "statement"
      ],
      "title": "PeakaExecuteQueryConfig",
      "type": "object"
    },
    "PeakaGetCatalogConfig": {
