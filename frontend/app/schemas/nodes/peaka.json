{
  "$defs": {
    "PeakaAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "peaka_api_key",
          "default": "peaka_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "project_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Project ID",
          "type": "string"
        },
        "region": {
          "default": "us",
          "enum": [
            "us",
            "eu"
          ],
          "title": "Region",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "project_id"
      ],
      "title": "Peaka API Key",
      "type": "object",
      "x-credential-instructions": "Paste a Project API Key (or Partner API Key), the project ID it can access, and its region. NoClick sends Bearer authentication to Peaka's regional Gateway API. Connection verification lists this project's catalogs.",
      "x-credential-url": "https://docs.peaka.com/api-reference/authentication"
    },
    "PeakaCreateCatalogConfig": {
      "additionalProperties": false,
      "description": "Create catalog in the connected project.",
      "properties": {
        "operation": {
          "const": "create_catalog",
          "default": "create_catalog",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "connection_id": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Connection Id",
          "type": "string"
        },
        "extra_parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extra Parameters"
        }
      },
      "required": [
        "name",
        "connection_id"
      ],
      "title": "PeakaCreateCatalogConfig",
      "type": "object"
    },
    "PeakaCreateInternalTableConfig": {
