          "default": null,
          "title": "Instructions"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkupResponseText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response text format"
        }
      },
      "required": [
        "input"
      ],
      "title": "LinkupCreateResponseConfig",
      "type": "object"
    },
    "LinkupCreateTasksConfig": {
      "description": "Submit up to 100 search, fetch, research or extract tasks in one batch.",
      "properties": {
        "operation": {
          "const": "create_tasks",
          "default": "create_tasks",
          "title": "Operation",
          "type": "string"
        },
        "tasks": {
          "items": {
            "discriminator": {
              "mapping": {
                "extract": "#/$defs/LinkupExtractTask",
                "fetch": "#/$defs/LinkupFetchTask",
                "research": "#/$defs/LinkupResearchTask",
                "search": "#/$defs/LinkupSearchTask"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LinkupSearchTask"
              },
              {
                "$ref": "#/$defs/LinkupFetchTask"
              },
              {
                "$ref": "#/$defs/LinkupResearchTask"
              },
              {
                "$ref": "#/$defs/LinkupExtractTask"
              }
            ]
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "tasks"
      ],
      "title": "LinkupCreateTasksConfig",
      "type": "object"
    },
