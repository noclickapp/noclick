{
  "$defs": {
    "LinkupAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "linkup_api_key",
          "default": "linkup_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Linkup API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the Linkup dashboard and paste it here. NoClick sends it as a Bearer token to api.linkup.so. Extract is a closed-beta feature that requires access from Linkup.",
      "x-credential-url": "https://app.linkup.so"
    },
    "LinkupCreateExtractConfig": {
      "description": "Create a closed-beta extraction task returning structured rows.",
      "properties": {
        "q": {
          "minLength": 1,
          "title": "Extraction query",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Seed URL",
          "type": "string"
        },
        "schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row schema"
        },
        "verifyUrls": {
          "default": false,
          "title": "Verify URLs",
          "type": "boolean"
        },
        "operation": {
          "const": "create_extract",
          "default": "create_extract",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "q",
        "url"
      ],
      "title": "LinkupCreateExtractConfig",
      "type": "object"
    },
    "LinkupCreateResearchConfig": {
      "description": "Start an asynchronous web research task; poll with Get Research.",
      "properties": {
        "q": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "outputType": {
          "default": "sourcedAnswer",
          "enum": [
            "sourcedAnswer",
            "structured"
          ],
          "title": "Output type",
          "type": "string"
        },
        "structuredOutputSchema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON schema string with an object root; required for structured output.",
          "title": "Structured output schema",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "includeDomains": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Include domains"
        },
        "excludeDomains": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclude domains"
        },
        "fromDate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From date"
        },
        "toDate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To date"
        },
        "mode": {
          "default": "auto",
          "enum": [
            "answer",
            "auto",
            "investigate",
            "research"
          ],
          "title": "Research mode",
          "type": "string"
        },
        "reasoningDepth": {
          "default": "L",
          "enum": [
            "L",
            "M",
            "S",
            "XL"
          ],
          "title": "Reasoning depth",
          "type": "string"
        },
        "operation": {
          "const": "create_research",
          "default": "create_research",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "q"
      ],
      "title": "LinkupCreateResearchConfig",
      "type": "object"
    },
    "LinkupCreateResponseConfig": {
      "description": "Generate a web-grounded answer using Linkup's Responses-compatible API.",
      "properties": {
        "operation": {
          "const": "create_response",
          "default": "create_response",
          "title": "Operation",
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/LinkupResponseMessage"
              },
              "type": "array"
            }
          ],
          "title": "Input"
        },
        "model": {
          "default": "linkup-standard",
          "enum": [
            "linkup-deep",
            "linkup-standard"
          ],
          "title": "Model",
          "type": "string"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
