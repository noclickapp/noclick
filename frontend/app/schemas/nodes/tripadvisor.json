    "TripadvisorListReviewsConfig": {
      "description": "Location Reviews.",
      "properties": {
        "operation": {
          "const": "list_reviews",
          "default": "list_reviews",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "the Tripadvisor Location ID to retrieve reviews for",
          "title": "Id",
          "type": "integer"
        },
        "rating_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "when set, only return reviews with an overall rating of at least this\n                               value",
          "title": "Rating Min"
        },
        "trip_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "when set, only return reviews tagged with this trip type (e.g. business,\n                               family, couples)",
          "title": "Trip Type"
        },
        "published_after_ts": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "when set, only return reviews published on or after this date\n                               (format: <code>YYYY-MM-DD</code>)",
          "title": "Published After Ts"
        },
        "sort_by": {
          "anyOf": [
            {
              "enum": [
                "MOST_RECENT",
                "HIGHEST_RATED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ordering to apply to the reviews (defaults to most recent)",
          "title": "Sort By",
          "enum": [
            "MOST_RECENT",
            "HIGHEST_RATED"
          ],
          "x-enum-searchable": true
        },
        "published_after_review_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cursor for keyset pagination; returns reviews published after the review\n                               with this ID",
          "title": "Published After Review Id"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UGC language code (e.g. <code>en</code>, <code>fr</code>) or the special keyword\n                               <code>primary</code> to return reviews in their original written language.\n                               Defaults to <code>en</code> when absent.",
          "title": "Language"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page index (1-based).",
          "title": "Page"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page size.",
          "title": "Size"
        }
      },
      "required": [
        "id"
      ],
      "title": "TripadvisorListReviewsConfig",
      "type": "object"
    },
    "TripadvisorSearchCatalogConfig": {
      "description": "Search Locations Catalog.",
      "properties": {
        "operation": {
          "const": "search_catalog",
          "default": "search_catalog",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "description": "Text search query.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "search_type": {
          "default": "NAME",
          "description": "Searching type.",
          "title": "Search Type",
          "type": "string"
        },
        "country_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Alpha-2 country code.",
          "title": "Country Code"
        },
        "geo_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "City, Town, or Country Geo Name.",
          "title": "Geo Name"
        },
        "postal_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Postal/zip code to further narrow results.\n <p>\n If both `geo_name` and `postal_code` are given, the `postal_code` takes precedence in case they do not resolve.",
          "title": "Postal Code"
        },
        "category": {
          "anyOf": [
            {
              "enum": [
                "RESTAURANT",
                "ATTRACTION",
                "HOTEL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter based on Tripadvisor\u2019s top-level categories (eat & drink, accommodations, attractions).",
          "title": "Category",
          "enum": [
            "RESTAURANT",
            "ATTRACTION",
            "HOTEL"
          ],
          "x-enum-searchable": true
        },
        "locale": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "preferred locales for localized fields (e.g. names, descriptions), in priority order;\n               falls back to the default locale when omitted",
          "title": "Locale"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page index (1-based).",
          "title": "Page"
        },
        "size": {
          "default": 20,
          "description": "Page size.",
          "maximum": 20,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "TripadvisorSearchCatalogConfig",
      "type": "object"
    },
