    "TripadvisorSearchNearbyCatalogConfig": {
      "description": "Search Nearby Locations Catalog.",
      "properties": {
        "operation": {
          "const": "search_nearby_catalog",
          "default": "search_nearby_catalog",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "location_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The ID of the Location to use as a reference for the radius-based search.\n <p>\n Required if `lat` or `lon` is not given.",
          "title": "Location Id"
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The latitude of the center point for the radius-based search.\n <p>\n Required if `location_id` not given.",
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The longitude of the center point for the radius-based search.\n <p>\n Required if `location_id` not given.",
          "title": "Lon"
        },
        "radius": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The radius for the radius-based search.\n <p>\n Required if \"Bounding Box\" criteria is not given (`sw_lat`, `sw_lon`, `ne_lat`, `ne_lon`).",
          "title": "Radius"
        },
        "unit": {
          "default": "MI",
          "description": "Unit of length for distance. If none specified defaults to miles.",
          "title": "Unit",
          "type": "string"
        },
        "sw_lat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bounding Box southwest latitude coordinate.\n <p>\n Required if `radius` is not given.",
          "title": "Sw Lat"
        },
        "sw_lon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bounding Box southwest longitude coordinate.\n <p>\n Required if `radius` is not given.",
          "title": "Sw Lon"
        },
        "ne_lat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bounding Box northeast latitude coordinate.\n <p>\n Required if `radius` is not given.",
          "title": "Ne Lat"
        },
        "ne_lon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bounding Box northeast longitude coordinate.\n <p>\n Required if `radius` is not given.",
          "title": "Ne Lon"
        },
        "category": {
          "anyOf": [
            {
              "enum": [
                "RESTAURANT",
                "ATTRACTION",
                "HOTEL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter based on Tripadvisor\u2019s top-level categories (eat & drink, accommodations, attractions).",
          "title": "Category",
          "enum": [
            "RESTAURANT",
            "ATTRACTION",
            "HOTEL"
          ],
          "x-enum-searchable": true
        },
