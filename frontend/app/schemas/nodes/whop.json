{
  "$defs": {
    "WhopAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "whop_api_key",
          "default": "whop_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Whop API Key",
      "type": "object",
      "x-credential-instructions": "Paste a production Account API key from Whop Developer settings, without Bearer. Grant company:balance:read for the account connection check, plus the permissions needed by your operations. Sandbox keys cannot be used here. Whop enforces the key's permissions on each request.",
      "x-credential-url": "https://whop.com/dashboard/developer"
    },
    "WhopActivatePromoCodeConfig": {
      "additionalProperties": false,
      "description": "Activate Promo Code. Permissions: [{'bearerAuth': ['promo_code:update']}]",
      "properties": {
        "operation": {
          "const": "activate_promo_code",
          "default": "activate_promo_code",
