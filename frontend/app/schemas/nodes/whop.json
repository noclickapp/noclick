          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "WhopActivatePromoCodeConfig",
      "type": "object"
    },
    "WhopCancelMembershipConfig": {
      "additionalProperties": false,
      "description": "Cancel Membership. Permissions: [{'bearerAuth': ['membership:cancel']}, {'bearerAuth': ['member:manage']}]",
      "properties": {
        "operation": {
          "const": "cancel_membership",
          "default": "cancel_membership",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Resource ID",
          "type": "string"
        },
        "cancel_at_period_end": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`true` stops auto-renewal and keeps access until the current billing period ends. Omit or `false` revokes access immediately.",
          "title": "Cancel At Period End"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-form note recording why the membership was canceled.",
          "title": "Reason"
        }
      },
      "required": [
        "id"
      ],
      "title": "WhopCancelMembershipConfig",
      "type": "object"
    },
    "WhopCreateProductConfig": {
      "additionalProperties": false,
      "description": "Create Product. Permissions: [{'bearerAuth': ['access_pass:create']}]",
      "properties": {
        "operation": {
          "const": "create_product",
          "default": "create_product",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "account_id": {
          "anyOf": [
            {
              "maxLength": 1500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The unique identifier of the account to create this product for.",
          "title": "Account Id"
        },
        "title": {
          "description": "The display name of the product. Maximum 80 characters.",
          "maxLength": 80,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A written description displayed on the product page. Maximum 1,500 characters.",
          "title": "Description"
        },
        "headline": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A short marketing headline for the product page. Maximum 80 characters.",
          "title": "Headline"
        },
        "visibility": {
          "anyOf": [
            {
              "maxLength": 1500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the product is visible to customers.",
          "title": "Visibility"
        },
        "send_welcome_message": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether to send an automated welcome message via support chat when a user joins this product. Defaults to true.",
          "title": "Send Welcome Message"
        }
      },
      "required": [
        "title"
      ],
      "title": "WhopCreateProductConfig",
      "type": "object"
    },
