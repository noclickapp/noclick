    "WhopListMembershipsConfig": {
      "additionalProperties": false,
      "description": "List Memberships. Permissions: [{'bearerAuth': ['member:basic:read']}]",
      "properties": {
        "operation": {
          "const": "list_memberships",
          "default": "list_memberships",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "account_id": {
          "anyOf": [
            {
              "maxLength": 1500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Narrow to one account (`biz_` tag). With read access to the account this lists all of its memberships; without, only the caller's own memberships in it.",
          "title": "Account Id"
        },
        "first": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of results to return from the start of the range.",
          "title": "First"
        },
        "after": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return results after this cursor. Use `page_info.end_cursor` from the previous response to fetch the next page.",
          "title": "After"
