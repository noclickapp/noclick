    "WhopRefundPaymentConfig": {
      "additionalProperties": false,
      "description": "Refund Payment. Permissions: [{'bearerAuth': ['payment:manage']}]",
      "properties": {
        "operation": {
          "const": "refund_payment",
          "default": "refund_payment",
          "title": "Operation",
          "type": "string",
