{
  "$defs": {
    "AdafruitIOAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "adafruit_io_api_key",
          "default": "adafruit_io_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "username": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Adafruit IO username",
          "type": "string"
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Adafruit IO key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "username",
        "api_key"
      ],
      "title": "Adafruit IO API Key",
      "type": "object",
      "x-credential-instructions": "In Adafruit IO, click the gold key icon or View Adafruit IO Key. Paste your username and active account key. NoClick sends the key in the X-AIO-Key header to io.adafruit.com. Connection checks show the account returned by the key.",
      "x-credential-url": "https://io.adafruit.com/"
    },
    "CreateData": {
      "additionalProperties": false,
      "description": "Append a data point to a feed; this can activate feed automations.",
      "properties": {
        "feed_key": {
          "description": "Feed key, including its group prefix when present.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Feed Key",
          "type": "string"
        },
        "value": {
          "description": "Value to store. History-enabled feeds accept at most 1 KB; feeds without history accept at most 100 KB.",
          "maxLength": 102400,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "lat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latitude as a decimal string.",
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Longitude as a decimal string.",
          "title": "Lon"
        },
        "ele": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Elevation as a decimal string.",
          "title": "Ele"
        },
        "operation": {
          "const": "create_data",
          "default": "create_data",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "feed_key",
        "value"
      ],
      "title": "CreateData",
      "type": "object"
    },
    "CreateFeed": {
      "additionalProperties": false,
      "description": "Create a feed, optionally in a selected group.",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "license": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "operation": {
          "const": "create_feed",
          "default": "create_feed",
          "title": "Operation",
          "type": "string"
        },
        "group_key": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Key"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateFeed",
      "type": "object"
    },
    "CreateGroup": {
      "additionalProperties": false,
      "description": "Create a named group for organizing feeds.",
      "properties": {
        "operation": {
          "const": "create_group",
          "default": "create_group",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateGroup",
      "type": "object"
    },
    "DeleteData": {
      "additionalProperties": false,
      "description": "Permanently delete a selected data point.",
      "properties": {
        "feed_key": {
          "description": "Feed key, including its group prefix when present.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Feed Key",
          "type": "string"
