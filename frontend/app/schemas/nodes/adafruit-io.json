        "value": {
          "description": "Value to store. History-enabled feeds accept at most 1 KB; feeds without history accept at most 100 KB.",
          "maxLength": 102400,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "lat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latitude as a decimal string.",
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
