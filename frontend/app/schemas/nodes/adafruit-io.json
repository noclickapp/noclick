      },
      "required": [
        "group_key"
      ],
      "title": "GetGroup",
      "type": "object"
    },
    "GetLastData": {
      "additionalProperties": false,
      "description": "Read the newest point and move the API queue pointer to the end.",
      "properties": {
        "feed_key": {
          "description": "Feed key, including its group prefix when present.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
