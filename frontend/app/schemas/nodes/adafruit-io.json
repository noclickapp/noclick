          "default": "list_groups",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListGroups",
      "type": "object"
    },
    "UpdateData": {
      "additionalProperties": false,
      "description": "Update the value and optional location of a stored data point.",
