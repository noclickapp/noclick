      "properties": {
        "feed_key": {
          "description": "Feed key, including its group prefix when present.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Feed Key",
          "type": "string"
        },
        "operation": {
          "const": "get_first_data",
          "default": "get_first_data",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "feed_key"
      ],
      "title": "GetFirstData",
      "type": "object"
    },
    "GetGroup": {
