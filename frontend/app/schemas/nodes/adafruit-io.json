          "default": null,
          "description": "Elevation as a decimal string.",
          "title": "Ele"
        },
        "operation": {
          "const": "update_data",
          "default": "update_data",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "feed_key",
        "data_id",
        "value"
      ],
      "title": "UpdateData",
      "type": "object"
    },
