        "data_id": {
          "description": "ID of the data point in this feed.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Data Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_data",
          "default": "delete_data",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "feed_key",
        "data_id"
      ],
      "title": "DeleteData",
      "type": "object"
    },
    "DeleteFeed": {
      "additionalProperties": false,
      "description": "Permanently delete a feed and its stored data.",
      "properties": {
        "feed_key": {
          "description": "Feed key, including its group prefix when present.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Feed Key",
          "type": "string"
        },
        "operation": {
          "const": "delete_feed",
          "default": "delete_feed",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "feed_key"
      ],
      "title": "DeleteFeed",
      "type": "object"
    },
    "GetCurrentUser": {
      "additionalProperties": false,
      "description": "Get the identity belonging to the supplied account key.",
      "properties": {
        "operation": {
          "const": "get_current_user",
          "default": "get_current_user",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetCurrentUser",
      "type": "object"
    },
    "GetData": {
      "additionalProperties": false,
      "description": "Read a selected data point.",
