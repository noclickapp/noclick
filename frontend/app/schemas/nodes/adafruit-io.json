          "const": "update_feed",
          "default": "update_feed",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "feed_key"
      ],
      "title": "UpdateFeed",
      "type": "object"
    },
    "UpdateGroup": {
      "additionalProperties": false,
      "description": "Update a group's name or description.",
      "properties": {
        "group_key": {
          "maxLength": 128,
          "minLength": 1,
