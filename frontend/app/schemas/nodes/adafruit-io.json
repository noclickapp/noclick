        "feed_key": {
          "description": "Feed key, including its group prefix when present.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Feed Key",
          "type": "string"
        },
        "operation": {
          "const": "get_feed_details",
          "default": "get_feed_details",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "feed_key"
      ],
      "title": "GetFeedDetails",
      "type": "object"
    },
    "GetFirstData": {
      "additionalProperties": false,
