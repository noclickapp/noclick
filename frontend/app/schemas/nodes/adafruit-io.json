        "operation": {
          "const": "get_throttle",
          "default": "get_throttle",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetThrottle",
      "type": "object"
    },
    "ListData": {
      "additionalProperties": false,
      "description": "Read one page of data; use next_end_time for an older page.",
      "properties": {
        "feed_key": {
          "description": "Feed key, including its group prefix when present.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Feed Key",
          "type": "string"
        },
        "operation": {
          "const": "list_data",
          "default": "list_data",
          "title": "Operation",
          "type": "string"
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "start_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date-time",
          "title": "Start Time"
        },
        "end_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date-time",
          "title": "End Time"
        }
      },
      "required": [
        "feed_key"
      ],
      "title": "ListData",
      "type": "object"
    },
    "ListFeeds": {
      "additionalProperties": false,
      "description": "List one API page of feeds and their latest values.",
      "properties": {
        "operation": {
          "const": "list_feeds",
          "default": "list_feeds",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListFeeds",
      "type": "object"
    },
    "ListGroupFeeds": {
      "additionalProperties": false,
      "description": "List one API page of feeds belonging to a group.",
      "properties": {
        "group_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Group Key",
