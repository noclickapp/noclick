          "title": "Data Id",
          "type": "string"
        },
        "operation": {
          "const": "get_data",
          "default": "get_data",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "feed_key",
        "data_id"
      ],
      "title": "GetData",
      "type": "object"
    },
    "GetFeed": {
      "additionalProperties": false,
      "description": "Read feed settings and its latest value.",
      "properties": {
        "feed_key": {
          "description": "Feed key, including its group prefix when present.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Feed Key",
          "type": "string"
        },
        "operation": {
          "const": "get_feed",
          "default": "get_feed",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "feed_key"
      ],
      "title": "GetFeed",
      "type": "object"
    },
    "GetFeedDetails": {
      "additionalProperties": false,
