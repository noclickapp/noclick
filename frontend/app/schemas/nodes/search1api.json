    "Search1ApiSearchMapsConfig": {
      "additionalProperties": false,
      "description": "Search Google Maps for local businesses and places",
      "properties": {
        "operation": {
          "const": "search_maps",
          "default": "search_maps",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "description": "Google Maps search phrase; leading and trailing whitespace is removed.",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "country": {
          "default": "us",
          "description": "Two-letter country code, normalized to lowercase. Defaults to us.",
          "pattern": "^[a-zA-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "language": {
          "default": "en",
          "description": "Result language, for example en, de or zh-CN. Defaults to en.",
          "pattern": "^[a-z]{2,3}(-[a-zA-Z]{2,4})?$",
          "title": "Language",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Search1ApiSearchMapsConfigLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Search origin coordinates and map zoom (default 14). Required for page > 1. Latitude must be -90 to 90, longitude -180 to 180, and zoom 3 to 30. Example: {\"latitude\":40.7455,\"longitude\":-74.0083,\"zoom\":15}."
        },
        "page": {
          "default": 1,
          "description": "Page number, 1\u20136; default 1. Accepts an integer or canonical integer string such as \"2\". Empty strings use the default. Pages after the first require location.",
          "maximum": 6,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "max_results": {
          "default": 20,
          "description": "Maximum places to return from this page, 1\u201320; default 20. Accepts an integer or canonical integer string such as \"10\". Empty strings use the default. Truncation does not reduce the page charge or carry places to the next page.",
          "maximum": 20,
          "minimum": 1,
          "title": "Max Results",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "Search1ApiSearchMapsConfig",
      "type": "object"
    },
    "Search1ApiSearchMapsConfigLocation": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "zoom": {
          "default": 14,
          "maximum": 30,
          "minimum": 3,
