    "Search1ApiStartDeepcrawlConfig": {
      "additionalProperties": false,
      "description": "Deep crawl a website across multiple pages",
      "properties": {
        "operation": {
          "const": "start_deepcrawl",
          "default": "start_deepcrawl",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "url": {
          "format": "uri",
          "title": "Url",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "sitemap",
                "all"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type",
          "enum": [
            "sitemap",
            "all"
          ],
          "x-enum-searchable": true
        },
        "max_pages": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum number of pages to crawl, 1\u20131000; default 1000. Applied after include_paths/exclude_paths, in discovery order.",
          "title": "Max Pages"
        },
        "include_paths": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only crawl URLs whose path matches one of these rules (up to 20). A rule without * is a path prefix on segment boundaries: \"/docs\" matches /docs and /docs/api but not /docsearch. A rule with * must match the whole path, and * matches any characters including /, e.g. \"/blog/*\". Empty or omitted means every discovered URL.",
          "title": "Include Paths"
        },
        "exclude_paths": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Skip URLs whose path matches one of these rules (up to 20), using the same syntax as include_paths. Exclusion wins over inclusion.",
          "title": "Exclude Paths"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "zip",
                "json"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Result format; default \"zip\". \"zip\" packages the pages as Markdown files behind zipUrl. \"json\" returns pages: [{url, title, content}] in the completed status response, plus resultUrl for the same JSON file.",
          "title": "Format",
          "enum": [
            "zip",
            "json"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "url"
      ],
      "title": "Search1ApiStartDeepcrawlConfig",
      "type": "object"
    },
