    "Search1ApiAskConfig": {
      "additionalProperties": false,
      "description": "Search the engines a natural-language request calls for",
      "properties": {
        "operation": {
          "const": "ask",
          "default": "ask",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "description": "What you are looking for, in natural language. Platform hints (\"on Reddit\", \"papers\") and time hints (\"this week\") steer engine and time-range selection.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "Search1ApiAskConfig",
      "type": "object"
    },
