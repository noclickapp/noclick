{
  "$defs": {
    "AbortJourney": {
      "additionalProperties": false,
      "description": "Abort a contact's journey, optionally selecting an instance.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "journey_id": {
          "description": "Journey ID from Mailmodo's trigger URL.",
          "format": "uuid",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Journey Id",
          "type": "string"
        },
        "operation": {
          "const": "abort_journey",
          "default": "abort_journey",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "instanceId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "uuid",
          "title": "Instanceid"
        }
      },
      "required": [
        "email",
        "journey_id"
      ],
      "title": "AbortJourney",
      "type": "object"
    },
    "AddContactToList": {
      "additionalProperties": false,
      "description": "Add or update a contact and add it to a named list.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "operation": {
          "const": "add_contact_to_list",
          "default": "add_contact_to_list",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "listName": {
          "minLength": 1,
          "title": "List name",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contact properties, including custom properties.",
          "title": "Data"
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "last_click": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Click"
        },
        "last_open": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Open"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "email",
        "listName"
      ],
      "title": "AddContactToList",
      "type": "object"
    },
    "AddEvent": {
      "additionalProperties": false,
      "description": "Record a custom event for a contact.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "operation": {
          "const": "add_event",
          "default": "add_event",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "event_name": {
          "minLength": 1,
          "title": "Event Name",
          "type": "string"
        },
        "ts": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UNIX timestamp in seconds; omit for provider current time.",
          "title": "Ts"
        },
        "event_properties": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Properties"
        }
      },
      "required": [
        "email",
        "event_name"
      ],
      "title": "AddEvent",
      "type": "object"
    },
    "ArchiveContact": {
      "additionalProperties": false,
      "description": "Archive an existing contact.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "operation": {
          "const": "archive_contact",
          "default": "archive_contact",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "email"
      ],
      "title": "ArchiveContact",
      "type": "object"
    },
    "BatchContact": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "description": "Contact email address.",
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        }
      },
      "required": [
        "email"
      ],
      "title": "BatchContact",
      "type": "object"
    },
    "BroadcastCampaign": {
      "additionalProperties": false,
      "description": "Schedule a campaign for a list or segment.",
      "properties": {
        "campaign_id": {
          "description": "Campaign ID from Mailmodo's API trigger URL.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Campaign Id",
          "type": "string"
        },
        "operation": {
          "const": "broadcast_campaign",
          "default": "broadcast_campaign",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "listId": {
          "minLength": 1,
          "title": "List or segment ID",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "idempotencyKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unique value to permit repeating a campaign to the same list within 24 hours; do not generate a new value when retrying.",
          "title": "Idempotencykey"
        },
        "campaign_data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign Data"
        }
      },
      "required": [
        "campaign_id",
        "listId"
      ],
      "title": "BroadcastCampaign",
      "type": "object"
    },
    "BulkAddContacts": {
      "additionalProperties": false,
      "description": "Add a batch of contacts; partial failures remain visible in the response.",
      "properties": {
        "operation": {
          "const": "bulk_add_contacts",
          "default": "bulk_add_contacts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "listName": {
          "minLength": 1,
          "title": "List name",
          "type": "string"
        },
        "values": {
          "description": "Contacts with email and optional data properties.",
          "items": {
            "$ref": "#/$defs/BatchContact"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "listName",
        "values"
      ],
      "title": "BulkAddContacts",
      "type": "object"
    },
    "GetContact": {
      "additionalProperties": false,
      "description": "Read a contact's properties and subscription status.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "operation": {
          "const": "get_contact",
          "default": "get_contact",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "email"
      ],
      "title": "GetContact",
      "type": "object"
    },
    "ListContactLists": {
      "additionalProperties": false,
      "description": "Read the account's contact lists and their IDs.",
      "properties": {
        "operation": {
          "const": "list_contact_lists",
          "default": "list_contact_lists",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListContactLists",
      "type": "object"
    },
    "ListTemplates": {
      "additionalProperties": false,
      "description": "Read the account's templates and personalization parameters.",
      "properties": {
        "operation": {
          "const": "list_templates",
          "default": "list_templates",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListTemplates",
      "type": "object"
    },
    "MailmodoAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "mailmodo_api_key",
          "default": "mailmodo_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Mailmodo API Key",
      "type": "object",
      "x-credential-instructions": "In Mailmodo, open Settings \u2192 API Keys \u2192 Show API Key, then paste the key. NoClick checks access by reading your contact lists.",
      "x-credential-url": "https://manage.mailmodo.com/app/settings/apikey"
    },
    "RemoveContactFromList": {
      "additionalProperties": false,
      "description": "Remove a contact from a named list.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "operation": {
          "const": "remove_contact_from_list",
          "default": "remove_contact_from_list",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "listName": {
          "minLength": 1,
          "title": "List name",
          "type": "string"
        }
      },
      "required": [
        "email",
        "listName"
      ],
      "title": "RemoveContactFromList",
      "type": "object"
    },
    "ResubscribeContact": {
      "additionalProperties": false,
      "description": "Resubscribe a contact with appropriate consent.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "operation": {
          "const": "resubscribe_contact",
          "default": "resubscribe_contact",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "email"
      ],
      "title": "ResubscribeContact",
      "type": "object"
    },
    "SendCampaignEmail": {
      "additionalProperties": false,
      "description": "Schedule a campaign email for one contact.",
      "properties": {
        "campaign_id": {
          "description": "Campaign ID from Mailmodo's API trigger URL.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Campaign Id",
          "type": "string"
        },
        "operation": {
          "const": "send_campaign_email",
          "default": "send_campaign_email",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "replyTo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replyto"
        },
        "fromName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fromname"
        },
        "campaign_data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Transient personalization variables.",
          "title": "Campaign Data"
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Personalization saved to the contact profile.",
          "title": "Data"
        },
        "addToList": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Addtolist"
        }
      },
      "required": [
        "campaign_id",
        "email"
      ],
      "title": "SendCampaignEmail",
      "type": "object"
    },
    "StartJourney": {
      "additionalProperties": false,
      "description": "Start a journey for a contact.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "journey_id": {
          "description": "Journey ID from Mailmodo's trigger URL.",
          "format": "uuid",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Journey Id",
          "type": "string"
        },
        "operation": {
          "const": "start_journey",
          "default": "start_journey",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "allowDuplicateEmail": {
          "default": false,
          "title": "Allowduplicateemail",
          "type": "boolean"
        }
      },
      "required": [
        "email",
        "journey_id"
      ],
      "title": "StartJourney",
      "type": "object"
    },
    "UnsubscribeContact": {
      "additionalProperties": false,
      "description": "Suppress a contact from further email communication.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "operation": {
          "const": "unsubscribe_contact",
          "default": "unsubscribe_contact",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "email"
      ],
      "title": "UnsubscribeContact",
      "type": "object"
    },
    "UpdateSubscription": {
      "additionalProperties": false,
      "description": "Change subscriptions for specific Mailmodo email types.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "format": "email",
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "operation": {
          "const": "update_subscription",
          "default": "update_subscription",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "reSubscribeTo": {
          "items": {
            "type": "string"
          },
          "title": "Resubscribe to email types",
          "type": "array"
        },
        "unsubscribeFrom": {
          "items": {
            "type": "string"
          },
          "title": "Unsubscribe from email types",
          "type": "array"
        }
      },
      "required": [
        "email"
      ],
      "title": "UpdateSubscription",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "abort_journey": "#/$defs/AbortJourney",
          "add_contact_to_list": "#/$defs/AddContactToList",
          "add_event": "#/$defs/AddEvent",
          "archive_contact": "#/$defs/ArchiveContact",
          "broadcast_campaign": "#/$defs/BroadcastCampaign",
          "bulk_add_contacts": "#/$defs/BulkAddContacts",
          "get_contact": "#/$defs/GetContact",
          "list_contact_lists": "#/$defs/ListContactLists",
          "list_templates": "#/$defs/ListTemplates",
          "remove_contact_from_list": "#/$defs/RemoveContactFromList",
          "resubscribe_contact": "#/$defs/ResubscribeContact",
          "send_campaign_email": "#/$defs/SendCampaignEmail",
          "start_journey": "#/$defs/StartJourney",
          "unsubscribe_contact": "#/$defs/UnsubscribeContact",
          "update_subscription": "#/$defs/UpdateSubscription"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListContactLists"
        },
        {
          "$ref": "#/$defs/GetContact"
        },
        {
          "$ref": "#/$defs/AddContactToList"
        },
        {
          "$ref": "#/$defs/BulkAddContacts"
        },
        {
          "$ref": "#/$defs/UnsubscribeContact"
        },
        {
          "$ref": "#/$defs/ResubscribeContact"
        },
        {
          "$ref": "#/$defs/UpdateSubscription"
        },
        {
          "$ref": "#/$defs/RemoveContactFromList"
        },
        {
          "$ref": "#/$defs/ArchiveContact"
        },
        {
          "$ref": "#/$defs/SendCampaignEmail"
        },
        {
          "$ref": "#/$defs/BroadcastCampaign"
        },
        {
          "$ref": "#/$defs/StartJourney"
        },
        {
          "$ref": "#/$defs/AbortJourney"
        },
        {
          "$ref": "#/$defs/AddEvent"
        },
        {
          "$ref": "#/$defs/ListTemplates"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MailmodoAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Mailmodo Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
