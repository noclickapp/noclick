{
  "$defs": {
    "CodesearchAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "codesearch_api_key",
          "default": "codesearch_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Debian Code Search API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Debian Code Search API key. NoClick sends it in the x-dcs-apikey header. A search checks that the key is accepted; the public corpus does not identify your account.",
      "x-credential-url": "https://codesearch.debian.net/apikeys/"
    },
    "SearchConfig": {
      "properties": {
        "query": {
          "description": "Search text or an RE2 regular expression. Supports package:, path: and filetype: keywords; see https://codesearch.debian.net/faq#keywords.",
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "match_mode": {
          "default": "regexp",
          "enum": [
            "literal",
            "regexp"
          ],
          "title": "Match mode",
          "type": "string"
        },
        "operation": {
          "const": "search_code",
          "default": "search_code",
          "title": "Search source code",
          "type": "string",
          "x-operation-kind": "read"
        }
      },
      "required": [
        "query"
      ],
      "title": "SearchConfig",
      "type": "object"
    },
    "SearchPerPackageConfig": {
      "properties": {
        "query": {
          "description": "Search text or an RE2 regular expression. Supports package:, path: and filetype: keywords; see https://codesearch.debian.net/faq#keywords.",
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "match_mode": {
          "default": "regexp",
          "enum": [
            "literal",
            "regexp"
          ],
          "title": "Match mode",
          "type": "string"
        },
        "operation": {
          "const": "search_per_package",
          "default": "search_per_package",
          "title": "Search grouped by package",
          "type": "string",
          "x-operation-kind": "read"
        }
      },
      "required": [
        "query"
      ],
      "title": "SearchPerPackageConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "search_code": "#/$defs/SearchConfig",
          "search_per_package": "#/$defs/SearchPerPackageConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SearchConfig"
        },
        {
          "$ref": "#/$defs/SearchPerPackageConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodesearchAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Codesearch Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
