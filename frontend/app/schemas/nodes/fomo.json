{
  "$defs": {
    "CreateEvent": {
      "description": "Create a social proof notification event.",
      "properties": {
        "event_type_id": {
          "description": "The Fomo event_type_id for this notification template.",
          "exclusiveMinimum": 0,
          "title": "Template ID",
          "type": "integer"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "email_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email Address"
        },
        "ip_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ip Address"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "province": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Province"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "custom_event_fields_attributes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CustomEventField"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Event Fields Attributes"
        },
        "operation": {
          "const": "create_event",
          "default": "create_event",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "event_type_id"
      ],
      "title": "CreateEvent",
      "type": "object"
    },
    "CreateTemplate": {
      "description": "Create a reusable notification template.",
      "properties": {
        "operation": {
          "const": "create_template",
          "default": "create_template",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "message": {
          "description": "Fomo template text, including any Fomo placeholders.",
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "markdown_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown Enabled"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "use_avatar": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Use Avatar"
        },
        "use_ip_mapping": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Use Ip Mapping"
        }
      },
      "required": [
        "name",
        "message"
      ],
      "title": "CreateTemplate",
      "type": "object"
    },
    "CustomEventField": {
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing custom field ID when updating.",
          "title": "Id"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "CustomEventField",
      "type": "object"
    },
    "DeleteEvent": {
      "description": "Delete one event by its Fomo ID.",
      "properties": {
        "operation": {
          "const": "delete_event",
          "default": "delete_event",
          "title": "Operation",
          "type": "string"
        },
        "event_id": {
          "exclusiveMinimum": 0,
          "title": "Event Id",
          "type": "integer"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "DeleteEvent",
      "type": "object"
    },
    "FomoTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "fomo_api_token",
          "default": "fomo_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Fomo API Token",
      "type": "object",
      "x-credential-instructions": "Select your website in Fomo and open Settings > Site. Copy the Auth Token near the bottom and paste it here. API access requires a paid plan. Each token belongs to one application.",
      "x-credential-url": "https://docs.usefomo.com/reference/fomo-api-auth-token"
    },
    "GetEvent": {
      "description": "Get an event by its Fomo ID.",
      "properties": {
        "operation": {
          "const": "get_event",
          "default": "get_event",
          "title": "Operation",
          "type": "string"
        },
        "event_id": {
          "exclusiveMinimum": 0,
          "title": "Event Id",
          "type": "integer"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "GetEvent",
      "type": "object"
    },
    "GetStatistics": {
      "description": "Read application impressions, clicks and conversions in a date range.",
      "properties": {
        "operation": {
          "const": "get_statistics",
          "default": "get_statistics",
          "title": "Operation",
          "type": "string"
        },
        "date_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date From"
        },
        "date_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date To"
        }
      },
      "title": "GetStatistics",
      "type": "object"
    },
    "ListEvents": {
      "description": "Read one page of events for the connected application.",
      "properties": {
        "operation": {
          "const": "list_events",
          "default": "list_events",
          "title": "Operation",
          "type": "string"
        },
        "show_meta": {
          "default": false,
          "description": "Include Fomo's pagination metadata.",
          "title": "Show Meta",
          "type": "boolean"
        },
        "per_page": {
          "default": 100,
          "description": "Number of events in this page. Request subsequent pages explicitly.",
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "order_by": {
          "default": "created_at",
          "enum": [
            "created_at",
            "event_type_id"
          ],
          "title": "Order By",
          "type": "string"
        },
        "order_direction": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Order Direction",
          "type": "string"
        }
      },
      "title": "ListEvents",
      "type": "object"
    },
    "SearchEventByEmail": {
      "description": "Find an event by the customer's email address.",
      "properties": {
        "operation": {
          "const": "search_event_by_email",
          "default": "search_event_by_email",
