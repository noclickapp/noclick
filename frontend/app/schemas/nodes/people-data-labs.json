{
  "$defs": {
    "BoolClause": {
      "additionalProperties": false,
      "properties": {
        "must": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CompanyClause"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Must"
        },
        "must_not": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CompanyClause"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Must Not"
        },
        "filter": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CompanyClause"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter"
        },
        "should": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CompanyClause"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Should"
        }
      },
      "title": "BoolClause",
      "type": "object"
    },
    "CheckConnection": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "description": "Checks API-key reachability with the free Company Cleaner API; does not verify enrichment/search access or credits.",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "CheckConnection",
      "type": "object"
    },
    "CompanyClause": {
      "additionalProperties": false,
      "properties": {
        "term": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "maxProperties": 1,
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "id",
                  "name",
                  "website",
                  "industry",
                  "size",
                  "type",
                  "ticker",
                  "founded",
                  "employee_count",
                  "linkedin_slug",
                  "location.country",
                  "location.region",
                  "location.locality",
                  "location.metro",
                  "tags"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Term"
        },
        "terms": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "type": "array"
              },
              "maxProperties": 1,
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "id",
                  "name",
                  "website",
                  "industry",
                  "size",
                  "type",
                  "ticker",
                  "founded",
                  "employee_count",
                  "linkedin_slug",
                  "location.country",
                  "location.region",
                  "location.locality",
                  "location.metro",
                  "tags"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms"
        },
        "exists": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExistsClause"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bool": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoolClause"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "match": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "maxProperties": 1,
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "id",
                  "name",
                  "website",
                  "industry",
                  "size",
                  "type",
                  "ticker",
                  "founded",
                  "employee_count",
                  "linkedin_slug",
                  "location.country",
                  "location.region",
                  "location.locality",
                  "location.metro",
                  "tags"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        },
        "range": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/RangeBounds"
              },
              "maxProperties": 1,
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "employee_count",
                  "founded"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range"
        },
        "match_phrase": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "maxProperties": 1,
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "id",
                  "name",
                  "website",
                  "industry",
                  "size",
                  "type",
                  "ticker",
                  "founded",
                  "employee_count",
                  "linkedin_slug",
                  "location.country",
                  "location.region",
                  "location.locality",
                  "location.metro",
                  "tags"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Phrase"
        },
        "wildcard": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "maxProperties": 1,
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "id",
                  "name",
                  "website",
                  "industry",
                  "size",
                  "type",
                  "ticker",
                  "founded",
                  "employee_count",
                  "linkedin_slug",
                  "location.country",
                  "location.region",
                  "location.locality",
                  "location.metro",
                  "tags"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wildcard"
        },
        "prefix": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "maxProperties": 1,
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "id",
                  "name",
                  "website",
                  "industry",
                  "size",
                  "type",
                  "ticker",
                  "founded",
                  "employee_count",
                  "linkedin_slug",
                  "location.country",
                  "location.region",
                  "location.locality",
                  "location.metro",
                  "tags"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix"
        },
        "match_all": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "maxProperties": 0,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match All"
        }
      },
      "title": "CompanyClause",
      "type": "object"
    },
    "CompanyQuery": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "$ref": "#/$defs/CompanyClause"
        }
      },
      "required": [
        "query"
      ],
      "title": "CompanyQuery",
      "type": "object"
    },
    "EnrichCompany": {
      "additionalProperties": false,
      "properties": {
        "confirm_credit_use": {
          "const": true,
          "description": "This explicit request can consume People Data Labs company credits. Search charges per returned record; no automatic paging or retry occurs.",
          "title": "Confirm Credit Use",
          "type": "boolean"
        },
        "fields": {
          "description": "Native output allowlist. Search's SQL projection is ignored by the vendor; unselected fields are removed locally.",
          "items": {
            "enum": [
              "name",
              "display_name",
              "website",
              "industry",
              "size",
              "type",
              "ticker",
              "founded",
              "employee_count",
              "linkedin_url",
              "linkedin_slug",
              "location.country",
              "location.region",
              "location.locality",
              "location.metro",
              "tags"
            ],
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "operation": {
          "const": "enrich_company",
          "default": "enrich_company",
          "title": "Operation",
          "type": "string"
        },
        "pdl_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Takes precedence over all other match inputs. No paid picker request is sent.",
          "title": "Company PDL ID or LinkedIn Slug",
          "x-resource-type": "people_data_labs_company"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "ticker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ticker"
        },
        "website": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Website"
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "locality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locality"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "min_likelihood": {
          "default": 6,
          "description": "Native default 6; vendor default is 2. A score is confidence, not an exact identity guarantee.",
          "maximum": 10,
          "minimum": 1,
          "title": "Min Likelihood",
          "type": "integer"
        },
        "include_if_matched": {
          "default": true,
          "title": "Include If Matched",
          "type": "boolean"
        }
      },
      "required": [
        "confirm_credit_use"
      ],
      "title": "EnrichCompany",
      "type": "object"
    },
    "ExistsClause": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "id",
            "name",
            "website",
            "industry",
            "size",
            "type",
            "ticker",
            "founded",
            "employee_count",
            "linkedin_slug",
            "location.country",
            "location.region",
            "location.locality",
            "location.metro",
            "tags"
          ],
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "ExistsClause",
      "type": "object"
    },
    "PeopleDataLabsAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "people_data_labs_api_key",
          "default": "people_data_labs_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "People Data Labs API Key",
      "type": "object",
      "x-credential-instructions": "Paste an issued API key without a header prefix. It is sent only in X-Api-Key. Saving checks the key with the free Company Cleaner API. Enrichment/search access and credits remain unverified until an explicit operation. No account identity or token mint is inferred.",
      "x-credential-url": "https://docs.peopledatalabs.com/docs/authentication"
    },
    "RangeBounds": {
      "additionalProperties": false,
      "properties": {
        "gt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gt"
        },
        "gte": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gte"
        },
        "lt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lt"
        },
        "lte": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lte"
        }
      },
      "title": "RangeBounds",
      "type": "object"
    },
    "SearchCompanies": {
      "additionalProperties": false,
      "properties": {
        "confirm_credit_use": {
          "const": true,
          "description": "This explicit request can consume People Data Labs company credits. Search charges per returned record; no automatic paging or retry occurs.",
          "title": "Confirm Credit Use",
          "type": "boolean"
        },
        "fields": {
          "description": "Native output allowlist. Search's SQL projection is ignored by the vendor; unselected fields are removed locally.",
          "items": {
            "enum": [
              "name",
              "display_name",
              "website",
              "industry",
              "size",
              "type",
              "ticker",
              "founded",
              "employee_count",
              "linkedin_url",
              "linkedin_slug",
              "location.country",
              "location.region",
              "location.locality",
              "location.metro",
              "tags"
            ],
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "operation": {
          "const": "search_companies",
          "default": "search_companies",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompanyQuery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sql": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SELECT * FROM company WHERE ... only. Vendor ignores projection and LIMIT; use Size and native fields. No legacy from, joins, aggregations or extra statements.",
          "title": "Sql"
        },
        "size": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "max_pages": {
          "default": 10,
          "description": "Native continuation cap; each run still requests exactly one page. This is not a vendor total-result limit.",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 16000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Native bound continuation from this exact query/key/size/fields; raw vendor scroll tokens are not accepted.",
          "title": "Page Token"
        }
      },
      "required": [
        "confirm_credit_use"
      ],
      "title": "SearchCompanies",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/CheckConnection",
          "enrich_company": "#/$defs/EnrichCompany",
          "search_companies": "#/$defs/SearchCompanies"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CheckConnection"
        },
        {
          "$ref": "#/$defs/EnrichCompany"
        },
        {
          "$ref": "#/$defs/SearchCompanies"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/PeopleDataLabsAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "People-data-labs Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Enrich company by website",
    "Search company firmographics",
    "Check API key using the free Company Cleaner"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
