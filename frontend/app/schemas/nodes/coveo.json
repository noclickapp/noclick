{
  "$defs": {
    "CoveoAPIKeyCredential": {
      "additionalProperties": false,
      "properties": {
        "credential_type": {
          "const": "coveo_api_key",
          "default": "coveo_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Already issued Coveo API key, kept on the backend and sent only as Bearer. No browser token, OAuth flow, search-token mint or refresh is configured.",
          "title": "Api Key",
          "type": "string",
          "ui:widget": "password"
        },
        "organization_id": {
          "description": "Exact permanent organization ID; determines fixed Search/Admin host and path. Never a caller URL.",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Organization Id",
          "type": "string"
        },
        "region": {
          "default": "us",
          "description": "Actual primary deployment region. Push requires this region; current Search/Admin roots route by organization. HIPAA explicitly selects orghipaa hosts.",
          "enum": [
            "us",
            "ca",
            "eu",
            "au",
            "hipaa"
          ],
          "title": "Region",
          "type": "string"
        },
        "connection_probe": {
          "default": "search",
          "description": "Search performs an empty protected query and does not claim a person or organization name. Organization performs a protected organization read and requires Organization - View.",
          "enum": [
            "search",
            "organization"
          ],
          "title": "Connection Probe",
          "type": "string"
        },
        "search_hub": {
          "default": "NoClick",
          "description": "Use the search hub enforced by your key if it has one. Actual key/pipeline restrictions remain authoritative.",
          "maxLength": 128,
          "title": "Search Hub",
          "type": "string"
        },
        "allow_management_writes": {
          "default": false,
          "description": "Off by default. Allows source refresh/rebuild/pause/resume and Push status updates, which affect indexed content/jobs and activity logs; notifications are not assumed suppressed.",
          "title": "Allow Management Writes",
          "type": "boolean"
        },
        "allow_content_read": {
          "default": false,
          "description": "Off by default. Explicit search excerpts may reveal indexed private text. Document/media URLs, raw fields, content and credentials are always withheld.",
          "title": "Allow Content Read",
          "type": "boolean"
        }
      },
      "required": [
        "api_key",
        "organization_id"
      ],
      "title": "Coveo API Key",
      "type": "object",
      "x-credential-url": "https://docs.coveo.com/en/1718/"
    },
    "CoveoFacetConfig": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "default": "",
          "description": "Basic indexed query. Advanced query syntax is disabled; no additional JSON, identities or permission flags.",
          "maxLength": 1024,
          "title": "Query",
          "type": "string"
