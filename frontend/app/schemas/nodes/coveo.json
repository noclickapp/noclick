          "x-category": "Search",
          "x-display-name": "Query Specific Facet Values",
          "x-is-trigger": false
        },
        "field_id": {
          "description": "An actual facet-enabled index field; provider remains authoritative.",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$",
          "title": "Field Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "field_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "coveo_field"
        },
        "number_of_values": {
          "default": 8,
          "maximum": 100,
          "minimum": 1,
          "title": "Number Of Values",
          "type": "integer"
        },
        "selected_values": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Selected Values",
          "type": "array"
        }
      },
      "required": [
        "field_id"
      ],
      "title": "CoveoFacetConfig",
      "type": "object"
    },
