        "job_id": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Job Id",
          "type": "string"
        },
        "operation": {
          "const": "add_tasks",
          "default": "add_tasks",
          "title": "Operation",
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/Task"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        },
        "last_batch": {
          "default": false,
          "title": "Last Batch",
          "type": "boolean"
        }
      },
      "required": [
        "job_id",
        "tasks"
      ],
      "title": "AddTasks",
      "type": "object"
    },
