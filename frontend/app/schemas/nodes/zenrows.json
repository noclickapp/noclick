    "AddTasks": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[\\x21-\\x7e]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional retry key. Same key and body replays the original response for 24 hours; inspect failures before retrying.",
