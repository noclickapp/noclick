{
  "$defs": {
    "AhaAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "aha_api_key",
          "default": "aha_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "subdomain": {
          "description": "The company part of https://company.aha.io.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Account subdomain",
          "type": "string"
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "subdomain",
        "api_key"
      ],
      "title": "Aha! API Key",
      "type": "object",
      "x-credential-instructions": "Create a personal API key in Aha! under Settings \u2192 Personal \u2192 Developer \u2192 API keys. Paste the key and your account subdomain. The key uses your Aha! permissions; connect reads your workspaces and current user.",
      "x-credential-url": "https://secure.aha.io/settings/api_keys"
    },
    "AhaCreateEpicConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 1000,
