            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text or HTML description.",
          "title": "Description"
        },
        "operation": {
          "const": "create_epic",
          "default": "create_epic",
          "title": "Create Epic",
          "type": "string",
          "ui:hidden": true
        },
        "product_id": {
          "description": "Aha! numeric ID or reference key.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        }
      },
      "required": [
        "name",
        "product_id"
      ],
      "title": "AhaCreateEpicConfig",
      "type": "object"
    },
