        "country_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "US",
          "description": "Look up the product in a specific shipping country's catalog. Products are scoped to a country (default US), so a product that only ships elsewhere \u2014 e.g. an international gift card \u2014 404s unless its country is passed here.",
          "title": "Country Code"
        },
        "use_custom_catalog": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Limit to custom catalog only (for approved API partners)",
          "title": "Use Custom Catalog"
        }
      },
      "required": [
        "id"
      ],
      "title": "GoodyGetProductConfig",
      "type": "object"
    },
