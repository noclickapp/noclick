          "ui:hidden": true
        },
        "name": {
          "description": "Task name. 1\u20131024 characters after trimming. Content that reads as promotional (link-farm text, bulk marketing copy) is rejected with a 400.",
          "maxLength": 1024,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
