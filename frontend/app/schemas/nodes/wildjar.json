{
  "$defs": {
    "CreateSmsContactListConfig": {
      "additionalProperties": false,
      "description": "Create an SMS contact list.",
      "properties": {
        "operation": {
          "const": "create_sms_contact_list",
          "default": "create_sms_contact_list",
          "title": "Create an SMS contact list",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "account": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Account",
          "type": "string"
        },
        "contacts": {
          "items": {
            "pattern": "^[0-9]{6,15}$",
            "type": "string"
          },
          "maxItems": 2000,
          "minItems": 1,
          "title": "Contacts",
          "type": "array"
        }
      },
      "required": [
        "name",
        "account",
        "contacts"
      ],
      "title": "CreateSmsContactListConfig",
      "type": "object"
    },
    "CreateTransferConfig": {
      "additionalProperties": false,
      "description": "Create transfer.",
      "properties": {
        "operation": {
          "const": "create_transfer",
          "default": "create_transfer",
          "title": "Create transfer",
          "type": "string",
          "ui:hidden": true
        },
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "target": {
          "pattern": "[+][0-9]{6,15}",
          "title": "Target",
          "type": "string"
        },
        "timeout": {
          "default": 25,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        },
        "next_action": {
          "anyOf": [
            {
              "enum": [
                "hangup",
                "voicemail",
                "transfer",
                "ivr"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Action",
          "enum": [
            "hangup",
            "voicemail",
            "transfer",
            "ivr"
          ],
          "x-enum-searchable": true
        },
        "next_action_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Action Id"
        },
        "record": {
          "default": "no",
          "enum": [
            "yes",
            "no"
          ],
          "title": "Record",
          "type": "string"
        },
        "recording": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider preamble audio URL; NoClick does not fetch this URL.",
          "title": "Recording"
        },
        "whisper": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Whisper"
        },
        "force_caller": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Force Caller"
        },
        "notify": {
          "default": "no",
          "enum": [
            "yes",
            "no",
            "missed"
          ],
          "title": "Notify",
          "type": "string"
        },
        "group_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        }
      },
      "required": [
        "account_id",
        "name",
        "target"
      ],
      "title": "CreateTransferConfig",
      "type": "object"
    },
    "GetIvrConfig": {
