    "SendSmsConfig": {
      "additionalProperties": false,
      "description": "Send a single SMS.",
      "properties": {
        "operation": {
          "const": "send_sms",
          "default": "send_sms",
          "title": "Send a single SMS",
          "type": "string",
          "ui:hidden": true
        },
        "account": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Account",
          "type": "string"
        },
        "sender": {
          "description": "Sending tracking number in international format without plus.",
          "pattern": "[0-9]{6,15}",
          "title": "Sender",
          "type": "string"
        },
        "target": {
          "description": "Recipient in international format without plus.",
          "pattern": "[0-9]{6,15}",
          "title": "Target",
          "type": "string"
        },
        "content": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "account",
        "sender",
        "target",
        "content"
      ],
      "title": "SendSmsConfig",
      "type": "object"
    },
