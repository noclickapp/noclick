{
  "$defs": {
    "CreateAsset": {
      "additionalProperties": false,
      "description": "Create an asset with provenance behaviours and application attributes.",
      "properties": {
        "operation": {
          "const": "create_asset",
          "default": "create_asset",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "behaviours": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Behaviours",
          "type": "array",
          "ui:widget": "list"
        },
        "attributes": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "Attribute names and string values, for example arc_display_name and arc_display_type.",
          "title": "Attributes",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "proof_mechanism": {
          "default": "MERKLE_LOG",
          "enum": [
            "MERKLE_LOG",
            "SIMPLE_HASH"
          ],
          "title": "Proof Mechanism",
          "type": "string"
        },
        "public": {
          "default": false,
          "description": "Public assets and all their events are visible to everyone.",
          "title": "Public",
          "type": "boolean"
        }
      },
      "required": [
        "attributes"
      ],
      "title": "CreateAsset",
      "type": "object"
    },
    "CreateEvent": {
      "additionalProperties": false,
      "description": "Record evidence and optionally update asset attributes in the same event.",
      "properties": {
        "asset_id": {
          "description": "Bare asset UUID, without assets/.",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "operation": {
          "const": "create_event",
          "default": "create_event",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "behaviour": {
          "default": "RecordEvidence",
          "maxLength": 1024,
          "title": "Behaviour",
          "type": "string"
        },
        "event_operation": {
          "default": "Record",
          "description": "Provider event operation.",
          "maxLength": 1024,
          "title": "Event Operation",
          "type": "string"
        },
        "event_attributes": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "Event attribute names and string values.",
          "title": "Event Attributes",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "asset_attributes": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Attributes",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "asset_id",
        "event_attributes"
      ],
      "title": "CreateEvent",
      "type": "object"
    },
    "CreateLocation": {
      "additionalProperties": false,
      "description": "Create a named geographic location for assets.",
      "properties": {
        "operation": {
          "const": "create_location",
          "default": "create_location",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 8096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "attributes": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attributes",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "display_name",
        "latitude",
        "longitude"
      ],
      "title": "CreateLocation",
      "type": "object"
    },
    "DeleteLocation": {
      "additionalProperties": false,
      "description": "Delete a location; the response acknowledges the request only.",
      "properties": {
        "location_id": {
          "description": "Bare location UUID, without locations/.",
