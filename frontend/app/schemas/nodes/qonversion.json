{
  "$defs": {
    "CheckConnection": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "description": "Protected read of the credential's exact product witness; no witness means provider acceptance remains unknown.",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "CheckConnection",
      "type": "object"
    },
    "GetEntitlementDefinition": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_entitlement_definition",
          "default": "get_entitlement_definition",
          "title": "Operation",
          "type": "string"
        },
        "entitlement_id": {
          "title": "Entitlement Id",
          "type": "string",
          "x-resource-type": "qonversion_entitlement"
        }
      },
      "required": [
        "entitlement_id"
      ],
      "title": "GetEntitlementDefinition",
      "type": "object"
    },
    "GetProduct": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_product",
          "default": "get_product",
          "title": "Operation",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string",
          "x-resource-type": "qonversion_product"
        }
      },
      "required": [
        "product_id"
      ],
      "title": "GetProduct",
      "type": "object"
    },
    "GetRemoteConfiguration": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_remote_configuration",
          "default": "get_remote_configuration",
          "title": "Operation",
          "type": "string"
        },
        "configuration_id": {
          "description": "Existing UUID; payload and targeting values are omitted from output.",
          "title": "Configuration Id",
          "type": "string",
          "x-resource-type": "qonversion_remote_configuration"
        }
      },
      "required": [
        "configuration_id"
      ],
      "title": "GetRemoteConfiguration",
      "type": "object"
    },
    "GetUser": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_user",
          "default": "get_user",
          "title": "Operation",
          "type": "string"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        },
        "expected_environment": {
          "description": "Explicit response binding; Get User has no documented environment query/header. The key is never rewritten.",
          "enum": [
            "prod",
            "sandbox"
          ],
          "title": "Expected Environment",
          "type": "string"
        },
        "confirm_user_metadata": {
          "const": true,
          "description": "Read pseudonymous user ID/environment/created_at metadata. External identity, properties, contacts and payment data are excluded.",
          "title": "Confirm User Metadata",
          "type": "boolean"
        }
      },
      "required": [
        "user_id",
        "expected_environment",
        "confirm_user_metadata"
      ],
      "title": "GetUser",
      "type": "object"
    },
    "ListEntitlementDefinitions": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "max_pages": {
          "default": 10,
          "description": "Native continuation cap. Each run requests one page; no automatic fetching.",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Native continuation bound to this exact endpoint, filters, limit, key and saved authority. No raw starting_after or URL escape.",
          "title": "Page Token"
        },
        "operation": {
          "const": "list_entitlement_definitions",
          "default": "list_entitlement_definitions",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListEntitlementDefinitions",
      "type": "object"
    },
    "ListProducts": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "max_pages": {
          "default": 10,
          "description": "Native continuation cap. Each run requests one page; no automatic fetching.",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Native continuation bound to this exact endpoint, filters, limit, key and saved authority. No raw starting_after or URL escape.",
          "title": "Page Token"
        },
        "operation": {
          "const": "list_products",
          "default": "list_products",
          "title": "Operation",
          "type": "string"
        },
        "product_types": {
          "description": "Repeated filter[type] values use documented OR semantics.",
          "items": {
            "enum": [
              "subscription_with_promo",
              "subscription",
              "consumable",
              "lifetime"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Product Types",
          "type": "array"
        }
      },
      "title": "ListProducts",
      "type": "object"
    },
    "ListRemoteConfigurations": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "max_pages": {
          "default": 10,
          "description": "Native continuation cap. Each run requests one page; no automatic fetching.",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Native continuation bound to this exact endpoint, filters, limit, key and saved authority. No raw starting_after or URL escape.",
          "title": "Page Token"
        },
        "operation": {
          "const": "list_remote_configurations",
          "default": "list_remote_configurations",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListRemoteConfigurations",
      "type": "object"
    },
    "QonversionSecretKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "qonversion_secret_key",
          "default": "qonversion_secret_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "secret_key": {
          "title": "Project Secret Key",
          "type": "string",
          "ui:widget": "password"
        },
        "witness_product_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional protected GET used when connecting/checking. No product is created and no project identity is inferred.",
          "title": "Existing Witness Product ID"
        }
      },
      "required": [
        "secret_key"
      ],
      "title": "Qonversion Secret Key",
      "type": "object",
      "x-credential-instructions": "Paste the issued project sk_ Secret Key unchanged, without Bearer. SDK/public keys and historical test_sk_ prefixes are distinct. Native v4 GET reads only; no key mint, environment-prefix rewriting or refresh. Optionally supply an existing Product ID for a protected connection read; this proves that resource's reachability, not project/account identity. Without it provider acceptance remains unknown.",
      "x-credential-url": "https://documentation.qonversion.io/reference/v4/authentication"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/CheckConnection",
          "get_entitlement_definition": "#/$defs/GetEntitlementDefinition",
          "get_product": "#/$defs/GetProduct",
          "get_remote_configuration": "#/$defs/GetRemoteConfiguration",
          "get_user": "#/$defs/GetUser",
          "list_entitlement_definitions": "#/$defs/ListEntitlementDefinitions",
          "list_products": "#/$defs/ListProducts",
          "list_remote_configurations": "#/$defs/ListRemoteConfigurations"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CheckConnection"
        },
        {
          "$ref": "#/$defs/ListProducts"
        },
        {
          "$ref": "#/$defs/GetProduct"
        },
        {
          "$ref": "#/$defs/ListEntitlementDefinitions"
        },
        {
          "$ref": "#/$defs/GetEntitlementDefinition"
        },
        {
          "$ref": "#/$defs/ListRemoteConfigurations"
        },
        {
          "$ref": "#/$defs/GetRemoteConfiguration"
        },
        {
          "$ref": "#/$defs/GetUser"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/QonversionSecretKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Qonversion Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Inspect product metadata",
    "List entitlement definitions",
    "Read remote configuration status",
    "Read an existing user with explicit environment binding"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
