{
  "$defs": {
    "TalkableApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "talkable_api_key",
          "default": "talkable_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "site_slug": {
          "description": "Talkable Site ID from your dashboard, such as my-store. This scopes every request.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Site ID",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "site_slug"
      ],
      "title": "Talkable API Key",
      "type": "object",
      "x-credential-instructions": "In Talkable Site Settings \u2192 API Integration, copy your API Key and Site ID. Use a REST API key, not an MCP credential.",
      "x-credential-url": "https://www.talkable.com/"
    },
    "TalkableCalculateSharingRate": {
      "additionalProperties": false,
      "description": "Calculate the documented sharing_rate metric for a bounded date range.",
      "properties": {
        "operation": {
          "const": "calculate_sharing_rate",
          "default": "calculate_sharing_rate",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Reports",
          "x-display-name": "Calculate Sharing Rate",
          "x-is-trigger": false
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "campaign_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "campaign_id",
            "searchable": true
          },
          "x-resource-type": "talkable_campaign"
        },
        "exclude_qa_generated": {
          "default": true,
          "title": "Exclude QA Records",
          "type": "boolean"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "TalkableCalculateSharingRate",
      "type": "object"
    },
    "TalkableGetAsset": {
      "additionalProperties": false,
      "description": "Read a selected asset's metadata, without downloading or exposing its URL.",
      "properties": {
        "operation": {
          "const": "get_asset",
          "default": "get_asset",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Assets",
          "x-display-name": "Get Asset Metadata",
          "x-is-trigger": false
        },
        "asset_id": {
          "minimum": 1,
          "title": "Asset",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "asset_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "talkable_asset"
        }
      },
      "required": [
        "asset_id"
      ],
      "title": "TalkableGetAsset",
      "type": "object"
    },
    "TalkableGetPerson": {
      "additionalProperties": false,
      "description": "Find one person, returning selected profile and count fields.",
      "properties": {
        "person_slug": {
          "description": "Existing person's email, E.164 phone number, customer ID or username. No undocumented person-list API is used.",
          "maxLength": 320,
          "minLength": 1,
          "title": "Person Identifier",
          "type": "string"
        },
        "operation": {
          "const": "get_person",
          "default": "get_person",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "People",
          "x-display-name": "Get Person",
          "x-is-trigger": false
        }
      },
      "required": [
        "person_slug"
      ],
      "title": "TalkableGetPerson",
      "type": "object"
    },
    "TalkableListAdvocateReferrals": {
      "additionalProperties": false,
      "description": "Read referrals where the person is the advocate. No referral approval.",
      "properties": {
        "limit": {
          "default": 100,
          "description": "Local output bound. These report endpoints do not document server pagination.",
          "maximum": 100,
          "minimum": 1,
          "title": "Maximum Results",
          "type": "integer"
        },
        "person_slug": {
          "description": "Existing person's email, E.164 phone number, customer ID or username. No undocumented person-list API is used.",
          "maxLength": 320,
          "minLength": 1,
          "title": "Person Identifier",
          "type": "string"
        },
        "operation": {
          "const": "list_advocate_referrals",
          "default": "list_advocate_referrals",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Referrals",
          "x-display-name": "List Advocate Referrals",
          "x-is-trigger": false
        }
      },
      "required": [
        "person_slug"
      ],
      "title": "TalkableListAdvocateReferrals",
      "type": "object"
    },
    "TalkableListAssets": {
      "additionalProperties": false,
      "description": "List asset metadata using documented page/per_page; excludes asset URLs.",
      "properties": {
        "operation": {
          "const": "list_assets",
          "default": "list_assets",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Assets",
          "x-display-name": "List Asset Metadata",
          "x-is-trigger": false
        },
        "page": {
          "default": 1,
          "maximum": 10000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "content_type": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional MIME type or prefix, such as image or image/png.",
          "title": "Content Type"
        }
      },
      "title": "TalkableListAssets",
      "type": "object"
    },
    "TalkableListCampaigns": {
      "additionalProperties": false,
      "description": "List campaign metadata for the connected site. Does not activate campaigns.",
      "properties": {
        "limit": {
          "default": 100,
          "description": "Local output bound. These report endpoints do not document server pagination.",
          "maximum": 100,
          "minimum": 1,
          "title": "Maximum Results",
          "type": "integer"
        },
        "operation": {
          "const": "list_campaigns",
          "default": "list_campaigns",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Campaigns",
          "x-display-name": "List Campaigns",
          "x-is-trigger": false
        }
      },
      "title": "TalkableListCampaigns",
      "type": "object"
    },
    "TalkableListFriendReferrals": {
      "additionalProperties": false,
      "description": "Read referrals where the person is the friend. No referral approval.",
      "properties": {
        "limit": {
          "default": 100,
          "description": "Local output bound. These report endpoints do not document server pagination.",
          "maximum": 100,
          "minimum": 1,
          "title": "Maximum Results",
          "type": "integer"
        },
        "person_slug": {
          "description": "Existing person's email, E.164 phone number, customer ID or username. No undocumented person-list API is used.",
          "maxLength": 320,
          "minLength": 1,
          "title": "Person Identifier",
          "type": "string"
        },
        "operation": {
          "const": "list_friend_referrals",
          "default": "list_friend_referrals",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Referrals",
          "x-display-name": "List Friend Referrals",
          "x-is-trigger": false
        }
      },
      "required": [
        "person_slug"
      ],
      "title": "TalkableListFriendReferrals",
      "type": "object"
    },
    "TalkableListPersonRewards": {
      "additionalProperties": false,
      "description": "Read reward metadata and status, excluding coupon codes and redeemable URLs.",
      "properties": {
        "limit": {
          "default": 100,
          "description": "Local output bound. These report endpoints do not document server pagination.",
          "maximum": 100,
          "minimum": 1,
          "title": "Maximum Results",
          "type": "integer"
        },
        "person_slug": {
          "description": "Existing person's email, E.164 phone number, customer ID or username. No undocumented person-list API is used.",
          "maxLength": 320,
          "minLength": 1,
          "title": "Person Identifier",
          "type": "string"
        },
        "operation": {
          "const": "list_person_rewards",
          "default": "list_person_rewards",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Reports",
          "x-display-name": "List Person Reward Metadata",
          "x-is-trigger": false
        }
      },
      "required": [
        "person_slug"
      ],
      "title": "TalkableListPersonRewards",
      "type": "object"
    },
    "TalkableListPersonShares": {
      "additionalProperties": false,
      "description": "Read historical share metadata. Does not share or invite anybody.",
      "properties": {
        "limit": {
          "default": 100,
          "description": "Local output bound. These report endpoints do not document server pagination.",
          "maximum": 100,
          "minimum": 1,
          "title": "Maximum Results",
          "type": "integer"
        },
        "person_slug": {
          "description": "Existing person's email, E.164 phone number, customer ID or username. No undocumented person-list API is used.",
          "maxLength": 320,
          "minLength": 1,
          "title": "Person Identifier",
          "type": "string"
        },
        "operation": {
          "const": "list_person_shares",
          "default": "list_person_shares",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Reports",
          "x-display-name": "List Person Share Metadata",
          "x-is-trigger": false
        }
      },
      "required": [
        "person_slug"
      ],
      "title": "TalkableListPersonShares",
      "type": "object"
    },
    "TalkableListTrafficSources": {
      "additionalProperties": false,
      "description": "List reporting traffic-source identifiers for the connected site.",
      "properties": {
        "limit": {
          "default": 100,
          "description": "Local output bound. These report endpoints do not document server pagination.",
          "maximum": 100,
          "minimum": 1,
          "title": "Maximum Results",
          "type": "integer"
        },
        "operation": {
          "const": "list_traffic_sources",
          "default": "list_traffic_sources",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Reports",
          "x-display-name": "List Traffic Sources",
          "x-is-trigger": false
        }
      },
      "title": "TalkableListTrafficSources",
      "type": "object"
    },
    "TalkableUpsertPersonMetadata": {
      "additionalProperties": false,
      "description": "Update first/last name and custom properties; creates a person if absent.\n\nDoes not set subscription/consent, change contact identifiers, or issue a reward.\nCustom properties may affect merchant-defined segmentation; execution is a write.",
      "properties": {
        "person_slug": {
          "description": "Existing person's email, E.164 phone number, customer ID or username. No undocumented person-list API is used.",
          "maxLength": 320,
          "minLength": 1,
          "title": "Person Identifier",
          "type": "string"
        },
        "operation": {
          "const": "upsert_person_metadata",
          "default": "upsert_person_metadata",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "People",
          "x-display-name": "Upsert Person Metadata",
          "x-is-trigger": false
        },
        "first_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "custom_properties": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Up to 50 flat metadata values. Merchant-defined segments can use these values.",
          "title": "Custom Properties"
        }
      },
      "required": [
        "person_slug"
      ],
      "title": "TalkableUpsertPersonMetadata",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "calculate_sharing_rate": "#/$defs/TalkableCalculateSharingRate",
          "get_asset": "#/$defs/TalkableGetAsset",
          "get_person": "#/$defs/TalkableGetPerson",
          "list_advocate_referrals": "#/$defs/TalkableListAdvocateReferrals",
          "list_assets": "#/$defs/TalkableListAssets",
          "list_campaigns": "#/$defs/TalkableListCampaigns",
          "list_friend_referrals": "#/$defs/TalkableListFriendReferrals",
          "list_person_rewards": "#/$defs/TalkableListPersonRewards",
          "list_person_shares": "#/$defs/TalkableListPersonShares",
          "list_traffic_sources": "#/$defs/TalkableListTrafficSources",
          "upsert_person_metadata": "#/$defs/TalkableUpsertPersonMetadata"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TalkableListCampaigns"
        },
        {
          "$ref": "#/$defs/TalkableGetPerson"
        },
        {
          "$ref": "#/$defs/TalkableUpsertPersonMetadata"
        },
        {
          "$ref": "#/$defs/TalkableListAdvocateReferrals"
        },
        {
          "$ref": "#/$defs/TalkableListFriendReferrals"
        },
        {
          "$ref": "#/$defs/TalkableListPersonRewards"
        },
        {
          "$ref": "#/$defs/TalkableListPersonShares"
        },
        {
          "$ref": "#/$defs/TalkableCalculateSharingRate"
        },
        {
          "$ref": "#/$defs/TalkableListTrafficSources"
        },
        {
          "$ref": "#/$defs/TalkableListAssets"
        },
        {
          "$ref": "#/$defs/TalkableGetAsset"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TalkableApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Talkable Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
