          ],
          "default": null,
          "description": "Description of the watchlist",
          "title": "Description"
        },
        "people": {
          "description": "List of people to include in the watchlist",
          "items": {
            "$ref": "#/$defs/WatchlistPerson"
          },
          "maxItems": 100,
          "minItems": 0,
          "placeholder": "[{\"name\": \"Sam Altman\", \"wikidataId\": \"Q7411063\"}]",
          "title": "People",
          "type": "array",
          "ui:widget": "state_editor"
        },
        "companies": {
          "description": "List of companies to include in the watchlist",
          "items": {
            "$ref": "#/$defs/WatchlistCompany"
          },
          "maxItems": 100,
          "minItems": 0,
          "placeholder": "[{\"name\": \"OpenAI\", \"domain\": \"openai.com\"}]",
          "title": "Companies",
          "type": "array",
          "ui:widget": "state_editor"
