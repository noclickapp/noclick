    "CreateWatchlistConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_watchlist",
          "default": "create_watchlist",
          "title": "Create watchlist",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "description": "Unique name for the watchlist within the organization",
