    "CreateCustomer": {
      "additionalProperties": false,
      "description": "Create a customer without a password; Magento may send its account email.",
      "properties": {
        "email": {
          "maxLength": 254,
          "minLength": 3,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email",
          "type": "string"
        },
        "firstname": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Firstname",
          "type": "string"
        },
        "lastname": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Lastname",
          "type": "string"
        },
        "website_id": {
          "description": "Existing customer website ID in this store.",
          "minimum": 0,
          "title": "Website Id",
          "type": "integer"
        },
        "store_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Store Id"
        },
        "group_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "operation": {
          "const": "create_customer",
          "default": "create_customer",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "email",
        "firstname",
        "lastname",
        "website_id"
      ],
      "title": "CreateCustomer",
      "type": "object"
    },
    "CreateProduct": {
      "additionalProperties": false,
      "description": "Create a simple product with the store's required attribute set.",
      "properties": {
        "sku": {
          "description": "Exact product SKU; it is percent-encoded as one path component.",
          "maxLength": 64,
          "minLength": 1,
          "title": "Sku",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "price": {
          "minimum": 0,
          "title": "Price",
          "type": "number"
        },
        "status": {
          "default": 2,
          "enum": [
            1,
            2
          ],
          "title": "Status",
          "type": "integer"
        },
        "visibility": {
          "default": 4,
          "enum": [
            1,
            2,
            3,
            4
          ],
          "title": "Visibility",
          "type": "integer"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "operation": {
          "const": "create_product",
          "default": "create_product",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "attribute_set_id": {
          "description": "Existing attribute set ID in this store.",
          "minimum": 1,
          "title": "Attribute Set Id",
          "type": "integer"
        }
