    "ListCustomers": {
      "additionalProperties": false,
      "description": "List customers using the matching Magento REST endpoint.",
      "properties": {
        "page_size": {
          "default": 50,
          "description": "Maximum results per page; no automatic fetching of later pages.",
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "current_page": {
          "default": 1,
          "description": "One-based page number; use next_page from the previous result.",
          "maximum": 1000000,
          "minimum": 1,
          "title": "Current Page",
          "type": "integer"
        },
        "filter_field": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One search filter, for example sku, email, status or updated_at.",
          "title": "Filter Field"
        },
        "filter_value": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter Value"
        },
        "condition_type": {
          "default": "eq",
          "enum": [
            "eq",
            "neq",
            "like",
            "gt",
            "gteq",
            "lt",
            "lteq",
            "in",
            "nin"
          ],
          "title": "Condition Type",
          "type": "string"
        },
        "sort_field": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort Field"
        },
        "sort_direction": {
          "default": "ASC",
          "enum": [
            "ASC",
            "DESC"
          ],
          "title": "Sort Direction",
          "type": "string"
        },
        "operation": {
          "const": "list_customers",
          "default": "list_customers",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListCustomers",
      "type": "object"
    },
