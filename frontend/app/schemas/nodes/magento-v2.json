    "AddOrderComment": {
      "additionalProperties": false,
      "description": "Add order history with explicit customer-notification and storefront visibility choices.",
      "properties": {
        "order_id": {
          "description": "Internal entity ID, not the displayed increment/order number.",
          "minimum": 1,
          "title": "Order Id",
          "type": "integer"
        },
        "operation": {
          "const": "add_order_comment",
          "default": "add_order_comment",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "comment": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Comment",
          "type": "string"
        },
        "notify_customer": {
          "default": false,
          "title": "Notify Customer",
          "type": "boolean"
        },
        "visible_on_front": {
          "default": false,
          "title": "Visible On Front",
          "type": "boolean"
        }
      },
      "required": [
        "order_id",
        "comment"
      ],
      "title": "AddOrderComment",
      "type": "object"
    },
