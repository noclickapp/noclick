    "CustomFieldValue": {
      "additionalProperties": false,
      "properties": {
        "custom_field": {
          "exclusiveMinimum": 0,
          "title": "Custom Field",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
