    "FareHarborAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "fareharbor_api_key",
          "default": "fareharbor_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "app_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Application key",
          "type": "string",
          "ui:widget": "password"
        },
        "user_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "User key",
          "type": "string",
          "ui:widget": "password"
        },
        "company_shortname": {
          "description": "Company shortname in your FareHarbor dashboard URL, for example hawaiianadventures.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Company shortname",
          "type": "string"
        }
      },
      "required": [
        "app_key",
        "user_key",
        "company_shortname"
      ],
      "title": "FareHarbor API Keys",
      "type": "object",
      "x-credential-instructions": "Paste the application key and user key issued by FareHarbor, and the company shortname from your FareHarbor dashboard URL. API access must be enabled by FareHarbor. These keys are sent only to fareharbor.com.",
      "x-credential-url": "https://developer.fareharbor.com/api/external/v1/"
    },
    "FareHarborCancelBookingConfig": {
      "additionalProperties": false,
      "description": "Cancel a booking using FareHarbor cancellation rules.",
