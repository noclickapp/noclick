{
  "$defs": {
    "BookingCheckin": {
      "additionalProperties": false,
      "properties": {
        "checkin_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": "auto",
          "description": "auto, unchanged, a status PK, or explicit null to reset.",
          "title": "Checkin Status"
        },
        "customer": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Customer PK; null checks in all customers.",
          "title": "Customer"
        }
      },
      "title": "BookingCheckin",
      "type": "object"
    },
    "BookingData": {
      "additionalProperties": false,
      "properties": {
        "contact": {
          "$ref": "#/$defs/Contact"
        },
        "customers": {
          "items": {
            "$ref": "#/$defs/Customer"
          },
          "minItems": 1,
          "title": "Customers",
          "type": "array"
        },
        "custom_field_values": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CustomFieldValue"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Field Values"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "voucher_number": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voucher Number"
        },
        "amount_paid": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Amount already collected in minor currency units; omitted uses FareHarbor's default. Explicit null creates full payment.",
          "title": "Amount Paid"
        },
        "agent": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "agent_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Name"
        },
        "desk": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desk"
        },
        "desk_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desk Name"
        },
        "lodging": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lodging"
        },
        "rebooking": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rebooking"
        },
        "orderize_booking": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orderize Booking"
        }
      },
      "required": [
        "contact",
        "customers"
      ],
      "title": "BookingData",
      "type": "object"
    },
    "BookingNote": {
      "additionalProperties": false,
