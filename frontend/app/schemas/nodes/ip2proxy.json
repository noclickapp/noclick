{
  "$defs": {
    "Ip2ProxyAPIKey": {
      "properties": {
        "credential_type": {
          "const": "ip2proxy_api_key",
          "default": "ip2proxy_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "IP2Proxy API Key",
      "type": "object",
      "x-credential-instructions": "Paste your existing IP2Proxy web-service API key. New registrations for this legacy service are closed; IP2Location.io keys belong to a different service. Connecting looks up 201.42.237.89 with PX1 and consumes one credit. This proves key acceptance, not account identity. Package queries cost 1 to 11 credits each.",
      "x-credential-url": "https://www.ip2location.com/web-service/ip2proxy"
    },
    "Ip2ProxyPX10Config": {
      "additionalProperties": false,
      "description": "Residential proxy detection, including lower-package data; 10 credit(s).",
      "properties": {
        "ip": {
          "description": "IPv4 or IPv6 address, for example 201.42.237.89. Each package includes the data from lower packages.",
          "title": "IP address",
          "type": "string"
        },
        "operation": {
          "const": "get_residential_proxy",
          "default": "get_residential_proxy",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-operation-kind": "read"
        }
      },
      "required": [
        "ip"
      ],
      "title": "Ip2ProxyPX10Config",
      "type": "object"
    },
