{
  "$defs": {
    "EncircleAssignUser": {
      "additionalProperties": false,
      "description": "Assign a user to a property claim.",
      "properties": {
        "operation": {
          "const": "assign_user",
          "default": "assign_user",
          "title": "Operation",
          "type": "string"
        },
        "property_claim_id": {
          "minimum": 1,
          "title": "Property Claim Id",
          "type": "integer"
        },
        "id": {
          "description": "Assignment grants this user access to the claim; unassignment removes it",
          "maxLength": 320,
          "minLength": 1,
          "title": "User email address",
          "type": "string"
        }
      },
      "required": [
        "property_claim_id",
        "id"
      ],
      "title": "EncircleAssignUser",
      "type": "object"
    },
    "EncircleCreateClaim": {
      "additionalProperties": false,
      "description": "Create a property claim.",
      "properties": {
        "type_of_loss": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type Of Loss"
        },
        "locale": {
          "anyOf": [
            {
              "enum": [
                "fr",
                "da",
                "es",
                "en"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A [BCP47](https://tools.ietf.org/html/bcp47#section-2.1)\n`language` tag without any subtags.\n\nEncircle currently only supports a subset of the languages of\nthe world, the allowed values are expected to expand in the\nfuture.",
          "title": "Locale",
          "enum": [
            "fr",
            "da",
            "es",
            "en"
          ],
          "x-enum-searchable": true
        },
        "adjuster_name": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjuster Name"
        },
        "assignment_identifier": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Empty strings get coerced to null",
          "title": "Assignment Identifier"
        },
        "cat_code": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cat Code"
        },
        "contents_estimate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Represents a monetary amount as an integer in hundredths of\na dollar. For example, `550` would represent `$5.50`.",
          "title": "Contents Estimate"
        },
        "contractor_identifier": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Empty strings get coerced to null",
          "title": "Contractor Identifier"
        },
        "date_claim_created": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A [RFC 3339](https://tools.ietf.org/html/rfc3339#section-5.6)\ncompliant `full-date` string.",
          "title": "Date Claim Created"
        },
        "date_of_loss": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A [RFC 3339](https://tools.ietf.org/html/rfc3339#section-5.6)\ncompliant `full-date` string.\n\nThe provided date MUST be in the past.",
          "title": "Date Of Loss"
        },
        "default_depreciation": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Represents a percentage value like sales tax or depreciation.\n\nMust be a number greater or equal to 0.\n\nFor example, `0.05` represents `5%`.",
          "title": "Default Depreciation"
        },
        "emergency_estimate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Represents a monetary amount as an integer in hundredths of\na dollar. For example, `550` would represent `$5.50`.",
          "title": "Emergency Estimate"
        },
        "full_address": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Full Address"
        },
        "insurer_identifier": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Empty strings get coerced to null",
          "title": "Insurer Identifier"
        },
        "loss_details": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loss Details"
        },
        "max_depreciation": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Represents a percentage value like sales tax or depreciation.\n\nMust be a number greater or equal to 0.\n\nFor example, `0.05` represents `5%`.",
          "title": "Max Depreciation"
        },
        "policyholder_email_address": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policyholder Email Address"
        },
        "policyholder_name": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policyholder Name"
        },
        "policyholder_phone_number": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policyholder Phone Number"
        },
        "project_manager_name": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Manager Name"
        },
        "repair_estimate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Represents a monetary amount as an integer in hundredths of\na dollar. For example, `550` would represent `$5.50`.",
          "title": "Repair Estimate"
        },
        "sales_tax": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Represents a percentage value like sales tax or depreciation.\n\nMust be a number greater or equal to 0.\n\nFor example, `0.05` represents `5%`.",
          "title": "Sales Tax"
        },
        "broker_or_agent_name": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Broker Or Agent Name"
        },
        "insurance_company_name": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Insurance Company Name"
        },
        "policy_number": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Number"
        },
        "operation": {
          "const": "create_claim",
          "default": "create_claim",
          "title": "Operation",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Organization Id",
          "type": "string"
        },
        "brand_id": {
          "minimum": 1,
          "title": "Brand Id",
          "type": "integer"
        }
      },
      "required": [
        "organization_id",
        "brand_id"
      ],
      "title": "EncircleCreateClaim",
      "type": "object"
    },
