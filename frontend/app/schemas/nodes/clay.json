{
  "$defs": {
    "ClayApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "clay_api_key",
          "default": "clay_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Clay Public API key from API and CLI \u2192 API keys.",
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "ClayApiKeyCredential",
      "type": "object",
      "x-credential-url": "https://app.clay.com/"
    },
    "ClayCreateSearchConfig": {
      "properties": {
        "operation": {
          "const": "create_search",
          "default": "create_search",
          "title": "Create Search",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Searches",
          "x-display-name": "Create Search",
          "x-is-trigger": false
        },
        "query": {
          "description": "Advanced Clay search query. Returns a search ID for paging results.",
          "minLength": 1,
          "title": "Clay Search Query",
          "type": "string",
          "ui:widget": "textarea"
        }
      },
      "required": [
        "query"
      ],
      "title": "ClayCreateSearchConfig",
      "type": "object"
    },
    "ClayGetCreditBalanceConfig": {
      "properties": {
        "operation": {
          "const": "get_credit_balance",
          "default": "get_credit_balance",
          "title": "Get Credit Balance",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Workspace",
          "x-display-name": "Get Credit Balance",
          "x-is-trigger": false
        }
      },
      "title": "ClayGetCreditBalanceConfig",
      "type": "object"
    },
    "ClayGetMeConfig": {
      "properties": {
        "operation": {
          "const": "get_me",
          "default": "get_me",
          "title": "Get Authenticated User",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Workspace",
          "x-display-name": "Get Authenticated User",
          "x-is-trigger": false
        }
      },
      "title": "ClayGetMeConfig",
      "type": "object"
    },
    "ClayGetRoutineResultsConfig": {
      "properties": {
        "operation": {
          "const": "get_routine_results",
          "default": "get_routine_results",
          "title": "Get Routine Results",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Routines",
          "x-display-name": "Get Routine Results",
          "x-is-trigger": false
        },
        "routine_run_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Routine Run ID",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "routine_run_id"
      ],
      "title": "ClayGetRoutineResultsConfig",
      "type": "object"
    },
    "ClayGetSearchResultsConfig": {
      "properties": {
        "operation": {
          "const": "get_search_results",
          "default": "get_search_results",
          "title": "Get Search Results",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Searches",
          "x-display-name": "Get Search Results",
          "x-is-trigger": false
        },
        "search_id": {
          "minLength": 1,
          "title": "Search ID",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "search_id"
      ],
      "title": "ClayGetSearchResultsConfig",
      "type": "object"
    },
    "ClayMcpCredential": {
      "description": "Clay connected through Clay's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "clay_mcp",
          "default": "clay_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "Clay MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://api.clay.com/v3/mcp",
      "x-mcp-transport": "shttp"
    },
    "ClayQueryTablesConfig": {
      "properties": {
        "operation": {
          "const": "query_tables",
          "default": "query_tables",
          "title": "Query Tables",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Tables",
          "x-display-name": "Query Tables",
          "x-is-trigger": false
        },
        "query_json": {
          "description": "Clay structured query, e.g. {\"tables\":[{\"id\":\"table-id\"}]}. Enterprise plan required; tables are read-only.",
          "title": "Structured Query (JSON)",
          "type": "string",
          "ui:widget": "textarea"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "limit": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "query_json"
      ],
      "title": "ClayQueryTablesConfig",
      "type": "object"
    },
    "ClayRunRoutineConfig": {
      "properties": {
        "operation": {
          "const": "run_routine",
          "default": "run_routine",
          "title": "Run Routine",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Routines",
          "x-display-name": "Run Routine",
          "x-is-trigger": false
        },
        "routine_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Routine ID",
          "type": "string"
        },
        "items_json": {
          "description": "Array of 1\u2013100 objects, each with an id and inputs object, e.g. [{\"id\":\"lead-1\",\"inputs\":{\"domain\":\"example.com\"}}].",
          "title": "Items (JSON)",
          "type": "string",
          "ui:widget": "textarea"
        }
      },
      "required": [
        "routine_id",
        "items_json"
      ],
      "title": "ClayRunRoutineConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_search": "#/$defs/ClayCreateSearchConfig",
          "get_credit_balance": "#/$defs/ClayGetCreditBalanceConfig",
          "get_me": "#/$defs/ClayGetMeConfig",
          "get_routine_results": "#/$defs/ClayGetRoutineResultsConfig",
          "get_search_results": "#/$defs/ClayGetSearchResultsConfig",
          "query_tables": "#/$defs/ClayQueryTablesConfig",
          "run_routine": "#/$defs/ClayRunRoutineConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ClayGetMeConfig"
        },
        {
          "$ref": "#/$defs/ClayGetCreditBalanceConfig"
        },
        {
          "$ref": "#/$defs/ClayCreateSearchConfig"
        },
        {
          "$ref": "#/$defs/ClayGetSearchResultsConfig"
        },
        {
          "$ref": "#/$defs/ClayRunRoutineConfig"
        },
        {
          "$ref": "#/$defs/ClayGetRoutineResultsConfig"
        },
        {
          "$ref": "#/$defs/ClayQueryTablesConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClayApiKeyCredential"
        },
        {
          "$ref": "#/$defs/ClayMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "Clay Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Search Clay for companies matching our ideal customer profile",
    "Run a Clay enrichment function against incoming leads",
    "Fetch the results of a Clay routine run",
    "Read rows from an Enterprise Clay table"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
