            "investigating",
            "identified",
            "monitoring",
            "resolved",
            "scheduled",
            "in_progress",
            "verifying",
            "completed"
          ],
          "x-enum-searchable": true
        },
        "body": {
          "anyOf": [
            {
              "maxLength": 25000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Message to publish as an incident update",
          "title": "Body",
          "ui:widget": "textarea"
        },
        "impact_override": {
          "anyOf": [
            {
              "enum": [
                "none",
                "maintenance",
                "minor",
                "major",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
