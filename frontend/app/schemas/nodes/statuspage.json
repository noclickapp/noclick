    "CreateIncidentConfig": {
      "properties": {
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "investigating",
                "identified",
                "monitoring",
                "resolved",
