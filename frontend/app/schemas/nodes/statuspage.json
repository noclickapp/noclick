          "default": null,
          "description": "Maintenance end, ISO 8601 with timezone",
          "format": "date-time",
          "title": "Scheduled Until"
        },
        "scheduled_remind_prior": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
