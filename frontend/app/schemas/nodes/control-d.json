    "ControlDAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "control_d_api_token",
          "default": "control_d_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Control D API Token",
      "type": "object",
      "x-credential-instructions": "Create an API token in your Control D account and paste it here without the Bearer prefix. Read access is sufficient for reads; writes require a token with write access and the relevant account permissions.",
      "x-credential-url": "https://docs.controld.com/reference"
    },
    "CreateDevice": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_device",
          "default": "create_device",
