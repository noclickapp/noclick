          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "client_count": {
          "description": "Number of clients using this endpoint.",
          "maxLength": 10,
          "pattern": "^[0-9]+$",
          "title": "Client Count",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "icon": {
          "description": "Control D endpoint type, e.g. mobile-android.",
