                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacy Ipv4 Status"
        },
        "desc": {
          "anyOf": [
            {
              "maxLength": 4096,
