    "TikTokInput": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": "TIKTOK",
          "title": "Platform",
          "type": "string"
        },
        "socialAccountId": {
          "description": "Connected social account identifier.",
          "title": "Socialaccountid",
          "type": "string"
        },
        "contentOverride": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PostContentItemInput"
              },
