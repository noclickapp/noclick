{
  "$defs": {
    "BlueskyInput": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": "BLUESKY",
          "title": "Platform",
          "type": "string"
        },
        "socialAccountId": {
          "description": "Connected social account identifier.",
          "title": "Socialaccountid",
          "type": "string"
        },
        "contentOverride": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PostContentItemInput"
              },
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contentoverride"
        }
      },
      "required": [
        "platform",
        "socialAccountId"
      ],
      "title": "BlueskyInput",
      "type": "object"
    },
    "CreatePostConfig": {
      "additionalProperties": false,
      "description": "Creates a (parent) post with one or more social account (child) posts.\n\nAll referenced social accounts must belong to the same project.\n\nThe request is validated atomically. If any social account fails validation, the post is not created.",
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/PostContentItemInput"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Content",
          "type": "array"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftPostSchedule"
            },
            {
              "$ref": "#/$defs/PublishNowPostSchedule"
            },
            {
              "$ref": "#/$defs/ScheduleForLaterPostSchedule"
            }
          ],
          "title": "Schedule"
        },
        "autoDeleteMediaAfterPublish": {
          "default": false,
          "description": "When true, all media referenced by this post is automatically\ndeleted from the media library after all social account deliveries\nfor the post have published successfully.",
          "title": "Autodeletemediaafterpublish",
          "type": "boolean"
        },
        "retryPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PostRetryPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Automatic retry policy. Omit to disable automatic retries."
        },
        "socialAccounts": {
          "description": "Social account targets for this post.\n\nAll referenced social accounts must belong to the same project.\nDuplicate `socialAccountId` values are invalid.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/BlueskyInput"
              },
              {
                "$ref": "#/$defs/FacebookInput"
              },
              {
                "$ref": "#/$defs/InstagramInput"
              },
              {
                "$ref": "#/$defs/LinkedInInput"
              },
              {
                "$ref": "#/$defs/LinkedInPagesInput"
              },
              {
                "$ref": "#/$defs/PinterestInput"
              },
              {
                "$ref": "#/$defs/ThreadsInput"
              },
              {
                "$ref": "#/$defs/TikTokInput"
              },
              {
                "$ref": "#/$defs/WoopTestInput"
              },
              {
                "$ref": "#/$defs/XInput"
              },
              {
                "$ref": "#/$defs/YouTubeInput"
              }
            ]
          },
          "minItems": 1,
          "title": "Socialaccounts",
          "type": "array"
        },
        "operation": {
          "const": "create_post",
          "default": "create_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "content",
        "schedule",
        "socialAccounts"
      ],
      "title": "CreatePostConfig",
      "type": "object"
    },
    "CreateProjectConfig": {
      "additionalProperties": false,
      "description": "Creates a project in the API key's organization.\n\nUse projects to isolate social accounts, media, and posts for a\nspecific user, client, or brand in your application.",
      "properties": {
        "name": {
          "description": "Human-readable project name.",
          "title": "Name",
          "type": "string"
        },
        "operation": {
          "const": "create_project",
          "default": "create_project",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateProjectConfig",
      "type": "object"
    },
    "CreateWebhookConfig": {
      "additionalProperties": false,
      "description": "Registers a URL to receive webhook events for the specified event types.\n\nThe response includes a `signingSecret` (base64-encoded, 32 bytes) that is\nreturned **once only**. Use it to verify the `X-Woop-Signature` header on\nincoming webhook payloads.\n\n**Signature format:** `t=<unix>,v1=<hmac-sha256-hex>`\n**Signed payload:** `<unix>.<json-body>`",
      "properties": {
        "url": {
          "description": "The HTTPS URL to POST webhook events to.",
          "title": "Url",
          "type": "string"
        },
        "eventTypes": {
          "description": "Webhook event types this endpoint should receive.",
          "items": {
            "enum": [
              "socialAccountPost.delivery.published",
              "socialAccountPost.delivery.failed"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Eventtypes",
          "type": "array"
        },
        "operation": {
          "const": "create_webhook",
          "default": "create_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "url",
        "eventTypes"
      ],
      "title": "CreateWebhookConfig",
      "type": "object"
    },
    "DeleteMediaConfig": {
      "additionalProperties": false,
      "description": "Deletes one media item by ID.",
      "properties": {
        "operation": {
          "const": "delete_media",
          "default": "delete_media",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "mediaId": {
          "description": "Media identifier.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Mediaid",
          "type": "string"
        }
      },
      "required": [
        "mediaId"
      ],
      "title": "DeleteMediaConfig",
      "type": "object"
    },
    "DeletePostConfig": {
      "additionalProperties": false,
      "description": "Deletes one scheduled post by post ID.\n\nA post can only be deleted when all of its social account deliveries are\nstill `NOT_STARTED`.",
      "properties": {
        "operation": {
          "const": "delete_post",
          "default": "delete_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "postId": {
          "description": "Post identifier.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Postid",
          "type": "string"
        }
      },
      "required": [
        "postId"
      ],
      "title": "DeletePostConfig",
      "type": "object"
    },
    "DeleteProjectConfig": {
      "additionalProperties": false,
      "description": "Permanently deletes one project and its related data, including\nconnected social accounts, OAuth grants, media references, and posts.",
      "properties": {
        "operation": {
          "const": "delete_project",
          "default": "delete_project",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "projectId": {
          "description": "Project identifier.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Projectid",
          "type": "string"
        }
      },
      "required": [
        "projectId"
      ],
      "title": "DeleteProjectConfig",
      "type": "object"
    },
    "DeleteSocialAccountConfig": {
      "additionalProperties": false,
      "description": "Deletes one social account connection by ID.\n\nThis removes the associated OAuth grant, including stored access and\nrefresh tokens, so the account no longer counts toward the\norganization's active connected-account allowance.",
      "properties": {
        "operation": {
          "const": "delete_social_account",
          "default": "delete_social_account",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "socialAccountId": {
          "description": "Connected social account identifier.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Socialaccountid",
          "type": "string"
        }
      },
      "required": [
        "socialAccountId"
      ],
      "title": "DeleteSocialAccountConfig",
      "type": "object"
    },
    "DeleteSocialAccountPostConfig": {
      "additionalProperties": false,
      "description": "Deletes one social account post by ID.",
      "properties": {
        "operation": {
          "const": "delete_social_account_post",
          "default": "delete_social_account_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "socialAccountPostId": {
          "description": "Social account post identifier.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Socialaccountpostid",
          "type": "string"
        }
      },
      "required": [
        "socialAccountPostId"
      ],
      "title": "DeleteSocialAccountPostConfig",
      "type": "object"
    },
    "DeleteWebhookConfig": {
      "additionalProperties": false,
      "description": "Delete webhook endpoint.",
      "properties": {
        "operation": {
          "const": "delete_webhook",
          "default": "delete_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "webhookId": {
          "description": "Webhook endpoint identifier.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Webhookid",
          "type": "string"
        }
      },
      "required": [
        "webhookId"
      ],
      "title": "DeleteWebhookConfig",
      "type": "object"
    },
    "DraftPostSchedule": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "DRAFT",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "DraftPostSchedule",
      "type": "object"
    },
    "FacebookInput": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": "FACEBOOK",
          "title": "Platform",
          "type": "string"
        },
        "socialAccountId": {
          "description": "Connected social account identifier.",
          "title": "Socialaccountid",
          "type": "string"
        },
        "contentOverride": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PostContentItemInput"
              },
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contentoverride"
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link"
        },
        "locationId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Facebook place ID to attach to the post.",
          "title": "Locationid"
        },
        "postType": {
          "enum": [
            "TEXT_ONLY",
            "IMAGE",
            "VIDEO",
            "REEL",
            "STORY"
          ],
          "title": "Posttype",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "socialAccountId",
        "postType"
      ],
      "title": "FacebookInput",
      "type": "object"
    },
    "GetPostConfig": {
      "additionalProperties": false,
      "description": "Returns one post with its social account posts inline.",
      "properties": {
        "operation": {
          "const": "get_post",
          "default": "get_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "postId": {
          "description": "Post identifier.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Postid",
          "type": "string"
        }
      },
      "required": [
        "postId"
      ],
      "title": "GetPostConfig",
      "type": "object"
    },
    "GetSocialAccountPlatformInputsConfig": {
      "additionalProperties": false,
      "description": "Returns platform-specific input options for a connected social account.\n\nUse this endpoint to discover valid values for flattened post-target\nfields such as `pinterestBoardId` and `privacyLevel`.",
      "properties": {
        "operation": {
          "const": "get_social_account_platform_inputs",
          "default": "get_social_account_platform_inputs",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "socialAccountId": {
          "description": "Connected social account identifier.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Socialaccountid",
          "type": "string"
        }
      },
      "required": [
        "socialAccountId"
      ],
      "title": "GetSocialAccountPlatformInputsConfig",
      "type": "object"
    },
    "InstagramInput": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": "INSTAGRAM",
          "title": "Platform",
          "type": "string"
        },
        "socialAccountId": {
          "description": "Connected social account identifier.",
          "title": "Socialaccountid",
          "type": "string"
        },
        "contentOverride": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PostContentItemInput"
              },
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contentoverride"
        },
        "postType": {
          "enum": [
            "POST",
            "REEL",
            "STORY"
          ],
          "title": "Posttype",
          "type": "string"
        },
        "cover": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaLibraryPostContentMediaInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional image media reference to use as the cover image for an Instagram Reel.\n\nThis field applies only to `postType=REEL`."
        },
        "trialParams": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstagramTrialParams"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional Trial Reel settings. When provided, `postType` must be `REEL`.\n\nOmit this field to publish a regular Reel."
        }
      },
      "required": [
        "platform",
        "socialAccountId",
        "postType"
      ],
      "title": "InstagramInput",
      "type": "object"
    },
    "InstagramTrialParams": {
      "additionalProperties": false,
      "properties": {
        "graduationStrategy": {
          "enum": [
            "MANUAL",
            "SS_PERFORMANCE"
          ],
          "title": "Graduationstrategy",
          "type": "string"
        }
      },
      "required": [
        "graduationStrategy"
      ],
      "title": "InstagramTrialParams",
      "type": "object"
    },
    "LinkedInInput": {
      "additionalProperties": false,
