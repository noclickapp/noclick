      ],
      "title": "LinkedInInput",
      "type": "object"
    },
    "LinkedInPagesInput": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": "LINKEDIN_PAGES",
          "title": "Platform",
          "type": "string"
        },
        "socialAccountId": {
          "description": "Connected social account identifier.",
          "title": "Socialaccountid",
          "type": "string"
        },
        "contentOverride": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PostContentItemInput"
              },
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contentoverride"
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL to publish as a LinkedIn link preview card.",
          "title": "Link"
        }
      },
      "required": [
        "platform",
        "socialAccountId"
      ],
      "title": "LinkedInPagesInput",
      "type": "object"
    },
    "ListMediaConfig": {
      "additionalProperties": false,
      "description": "Returns media library items that belong to the API key's organization.\n\nWhen `projectId` is provided, only media in that project is returned.",
      "properties": {
        "operation": {
          "const": "list_media",
          "default": "list_media",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter to resources that belong to a specific project.",
          "title": "Projectid"
        },
        "mediaId": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter to one or more media items. Provide a comma-separated list of media IDs.",
          "title": "Mediaid"
        },
        "limit": {
          "default": 50,
          "description": "Number of items to return.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque cursor for the next page of results.",
          "title": "Cursor"
        }
      },
      "title": "ListMediaConfig",
      "type": "object"
    },
    "ListProjectsConfig": {
      "additionalProperties": false,
      "description": "Returns projects that belong to the same organization as the API key. A project corresponds to a \"Business Profile\" in the UI.",
      "properties": {
        "operation": {
          "const": "list_projects",
          "default": "list_projects",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListProjectsConfig",
      "type": "object"
    },
    "ListSocialAccountPostsConfig": {
      "additionalProperties": false,
      "description": "Returns standalone social account posts for the API key's organization.\n\nEach item includes the content, schedule, delivery status and latest stored analytics for a given social account target.",
      "properties": {
        "operation": {
          "const": "list_social_account_posts",
          "default": "list_social_account_posts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "projectId": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter to one or more projects. Provide a comma-separated list of project IDs.",
          "title": "Projectid"
        },
        "socialAccountId": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter to one or more connected social accounts. Provide a comma-separated list of social account IDs.",
          "title": "Socialaccountid"
        },
        "postId": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter to one or more parent posts. Provide a comma-separated list of post IDs.",
          "title": "Postid"
        },
        "platform": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "PINTEREST",
                  "LINKEDIN",
                  "LINKEDIN_PAGES",
                  "INSTAGRAM",
                  "FACEBOOK",
                  "THREADS",
                  "TIKTOK",
                  "X",
                  "YOUTUBE",
                  "BLUESKY",
                  "WOOPTEST"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter to one or more social platforms. Provide a comma-separated list of platform values.",
          "title": "Platform"
        },
        "deliveryStatus": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "NOT_STARTED",
                  "SENDING",
                  "PUBLISHED",
                  "FAILED"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter to one or more delivery statuses. Provide a comma-separated list of delivery status values.",
          "title": "Deliverystatus"
        },
        "limit": {
          "default": 50,
          "description": "Number of items to return.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque cursor for the next page of results.",
          "title": "Cursor"
        }
      },
      "title": "ListSocialAccountPostsConfig",
      "type": "object"
    },
    "ListSocialAccountsConfig": {
      "additionalProperties": false,
      "description": "Returns social accounts that can currently be used for publishing.\n\nWhen `projectId` is provided, only social accounts usable within that project are returned.",
      "properties": {
        "operation": {
          "const": "list_social_accounts",
          "default": "list_social_accounts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string"
