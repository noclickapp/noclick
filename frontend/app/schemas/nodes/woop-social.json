            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contentoverride"
        },
        "postType": {
          "enum": [
            "VIDEO",
            "PHOTO"
          ],
          "title": "Posttype",
          "type": "string"
        },
        "cover": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaLibraryPostContentMediaInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional image media reference to use as a custom cover for\n`postType=VIDEO`. WoopSocial stitches the image as a single\nframe at the beginning of the video before sending it to TikTok."
        },
        "postMode": {
          "default": "DIRECT_POST",
          "description": "TikTok posting mode.\n\nDefaults to `DIRECT_POST` when omitted.\n\n`DIRECT_POST` publishes directly to TikTok.\n\n`MEDIA_UPLOAD` uploads the media to TikTok so the creator can\nfinish and publish it in TikTok. Users will receive an inbox notification.\n\nFields not used by the selected mode may be ignored by TikTok.",
          "enum": [
            "DIRECT_POST",
            "MEDIA_UPLOAD"
          ],
          "title": "Postmode",
          "type": "string"
        },
        "privacyLevel": {
          "anyOf": [
            {
              "enum": [
                "PUBLIC_TO_EVERYONE",
                "SELF_ONLY",
                "MUTUAL_FOLLOW_FRIENDS",
                "FOLLOWER_OF_CREATOR"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when `postMode=DIRECT_POST`. Not used for `MEDIA_UPLOAD`.",
          "title": "Privacylevel",
          "enum": [
            "PUBLIC_TO_EVERYONE",
            "SELF_ONLY",
            "MUTUAL_FOLLOW_FRIENDS",
            "FOLLOWER_OF_CREATOR"
          ],
          "x-enum-searchable": true
        },
        "allowComment": {
          "description": "Whether comments should be allowed for this TikTok post.",
          "title": "Allowcomment",
          "type": "boolean"
        },
        "allowDuet": {
          "description": "Whether duets should be allowed for this TikTok post.\n\nThis field applies to `postType=VIDEO`.\n\nWhen `postType=PHOTO`, this field is required by the API contract\nbut is not used by TikTok.",
          "title": "Allowduet",
          "type": "boolean"
        },
        "allowStitch": {
          "description": "Whether stitches should be allowed for this TikTok post.\n\nThis field applies to `postType=VIDEO`.\n\nWhen `postType=PHOTO`, this field is required by the API contract\nbut is not used by TikTok.",
          "title": "Allowstitch",
          "type": "boolean"
        },
        "isYourBrand": {
          "description": "Whether the post should be disclosed as \"Your brand\" content on TikTok.",
          "title": "Isyourbrand",
          "type": "boolean"
        },
        "isBrandedContent": {
          "description": "Whether the post should be disclosed as branded content on TikTok.",
          "title": "Isbrandedcontent",
          "type": "boolean"
        },
        "isAiGeneratedContent": {
          "default": false,
          "description": "Whether the TikTok post contains AI-generated content. This field applies to video posts.",
          "title": "Isaigeneratedcontent",
          "type": "boolean"
        },
        "autoAddMusic": {
          "description": "Whether TikTok should automatically add music to this post.\n\nThis field applies to `postType=PHOTO`.\n\nWhen `postType=VIDEO`, this field is required by the API contract\nbut is not used by TikTok.",
          "title": "Autoaddmusic",
          "type": "boolean"
        }
