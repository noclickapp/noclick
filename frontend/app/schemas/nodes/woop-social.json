            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter to resources that belong to a specific project.",
          "title": "Projectid"
        }
      },
      "title": "ListSocialAccountsConfig",
      "type": "object"
    },
    "ListWebhooksConfig": {
      "additionalProperties": false,
      "description": "Returns all registered webhook endpoints for the organization. The `signingSecret` field is omitted.",
      "properties": {
        "operation": {
          "const": "list_webhooks",
          "default": "list_webhooks",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListWebhooksConfig",
      "type": "object"
    },
    "MediaLibraryPostContentMediaInput": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MEDIA_LIBRARY",
          "title": "Type",
          "type": "string"
        },
        "mediaId": {
          "description": "Media identifier create by calling [`POST /media/upload-sessions`](/api-reference/media/start-media-upload-session) or [`POST /media`](/api-reference/media/upload-media).",
          "title": "Mediaid",
          "type": "string"
        }
      },
      "required": [
        "type",
