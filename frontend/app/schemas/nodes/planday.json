          "$ref": "#/$defs/GetPortalInfo"
        },
        {
          "$ref": "#/$defs/ListDepartments"
        },
        {
          "$ref": "#/$defs/GetDepartment"
        },
        {
          "$ref": "#/$defs/ListEmployeeGroups"
