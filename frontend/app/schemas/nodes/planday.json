    "PlandayAccessTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "planday_access_token",
          "default": "planday_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "client_id": {
          "title": "Client ID",
          "type": "string",
          "ui:widget": "password"
        },
        "access_token": {
          "title": "Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "expires_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional exact issuer expiry with timezone. An expired value prevents any API request; no expiry is invented from the time of entry.",
          "title": "Access Token Expiry"
        },
        "expected_portal_id": {
          "anyOf": [
            {
              "maxLength": 16,
              "pattern": "^[1-9][0-9]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional exact protected /portal/v1.0/info data.id, checked before accepting other operation results.",
          "title": "Expected Portal ID"
        }
      },
      "required": [
        "client_id",
        "access_token"
      ],
      "title": "Planday Access Token",
      "type": "object",
      "x-credential-help-url": "https://developer.planday.com/gettingstarted/authorization/",
      "x-credential-instructions": "Supply an already issued access token and its exact client ID. Calls send X-ClientId and Authorization: Bearer to openapi.planday.com. Connection reads protected portal info; it proves a portal resource, not human identity or every permission. Reads require department:read, employeegroup:read, employee:read and shift:read where used. No app creation, consent, refresh exchange or generic OAuth callback is performed. Documented access lifetime is one hour; replace expired tokens through their issuing flow.",
      "x-credential-type": "api_key"
    }
  },
