{
  "$defs": {
    "BitriseAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "bitrise_api_token",
          "default": "bitrise_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "description": "Sent directly as the Authorization header. Do not include Bearer or use an add-on token. No token issuance, exchange or assumed lifetime.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Existing Bitrise Personal or Workspace API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "BitriseAPITokenCredential",
      "type": "object",
      "x-credential-instructions": "Use an existing personal access token or Workspace API token. Protected app catalog access proves reachability, not an actor ID or workspace membership. No OAuth flow or add-on key is implemented.",
      "x-credential-url": "https://docs.bitrise.io/en/bitrise-ci/api/authenticating-with-the-bitrise-api"
    },
    "BitriseAppsConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to app titles and branch names. Owner, repository, commit and capability fields are always excluded.",
          "title": "Include Names",
          "type": "boolean"
        },
        "limit": {
          "default": 50,
          "description": "Documented per-page limit, capped at 50.",
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NoClick continuation wrapping the provider's same-endpoint paging.next anchor; bound to current token, operation and app.",
          "title": "Page Token"
        },
        "operation": {
          "const": "list_apps",
          "default": "list_apps",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "BitriseAppsConfig",
      "type": "object"
    },
    "BitriseBranchesConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to app titles and branch names. Owner, repository, commit and capability fields are always excluded.",
          "title": "Include Names",
          "type": "boolean"
        },
        "app_slug": {
          "description": "Must be witnessed in the current protected accessible-app catalog; does not imply ownership.",
          "maxLength": 128,
          "minLength": 1,
          "title": "App Slug",
          "type": "string",
          "x-dynamic-options": {
            "field": "app_slug",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "list_branches",
          "default": "list_branches",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "max_names": {
          "default": 100,
          "description": "Local output bound only; this route has no documented paging. Names require Include Names and only branches with existing builds are listed.",
          "maximum": 500,
          "minimum": 1,
          "title": "Max Names",
          "type": "integer"
        }
      },
      "required": [
        "app_slug"
      ],
      "title": "BitriseBranchesConfig",
      "type": "object"
    },
    "BitriseBuildsConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to app titles and branch names. Owner, repository, commit and capability fields are always excluded.",
          "title": "Include Names",
          "type": "boolean"
        },
        "app_slug": {
          "description": "Must be witnessed in the current protected accessible-app catalog; does not imply ownership.",
          "maxLength": 128,
          "minLength": 1,
          "title": "App Slug",
          "type": "string",
          "x-dynamic-options": {
            "field": "app_slug",
            "auto_select_sole_option": true
          }
        },
        "limit": {
          "default": 50,
          "description": "Documented per-page limit, capped at 50.",
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NoClick continuation wrapping the provider's same-endpoint paging.next anchor; bound to current token, operation and app.",
          "title": "Page Token"
        },
        "operation": {
          "const": "list_builds",
          "default": "list_builds",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "app_slug"
      ],
      "title": "BitriseBuildsConfig",
      "type": "object"
    },
    "BitriseCheckConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to app titles and branch names. Owner, repository, commit and capability fields are always excluded.",
          "title": "Include Names",
          "type": "boolean"
        },
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "BitriseCheckConfig",
      "type": "object"
    },
    "BitriseGetAppConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to app titles and branch names. Owner, repository, commit and capability fields are always excluded.",
          "title": "Include Names",
          "type": "boolean"
        },
        "app_slug": {
          "description": "Must be witnessed in the current protected accessible-app catalog; does not imply ownership.",
          "maxLength": 128,
          "minLength": 1,
          "title": "App Slug",
          "type": "string",
          "x-dynamic-options": {
            "field": "app_slug",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "get_app",
          "default": "get_app",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "app_slug"
      ],
      "title": "BitriseGetAppConfig",
      "type": "object"
    },
    "BitriseGetBuildConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to app titles and branch names. Owner, repository, commit and capability fields are always excluded.",
          "title": "Include Names",
          "type": "boolean"
        },
        "app_slug": {
          "description": "Must be witnessed in the current protected accessible-app catalog; does not imply ownership.",
          "maxLength": 128,
          "minLength": 1,
          "title": "App Slug",
          "type": "string",
          "x-dynamic-options": {
            "field": "app_slug",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "get_build",
          "default": "get_build",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "build_slug": {
          "description": "Witnessed in the selected app's current build catalog before the app-bound detail read.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Build Slug",
          "type": "string",
          "x-dynamic-options": {
            "depends_on": "app_slug",
            "field": "build_slug"
          }
        }
      },
      "required": [
        "app_slug",
        "build_slug"
      ],
      "title": "BitriseGetBuildConfig",
      "type": "object"
    },
    "BitriseMcpCredential": {
      "description": "Bitrise connected through Bitrise's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "bitrise_mcp",
          "default": "bitrise_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "Bitrise MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://mcp.bitrise.io/",
      "x-mcp-transport": "shttp"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/BitriseCheckConfig",
          "get_app": "#/$defs/BitriseGetAppConfig",
          "get_build": "#/$defs/BitriseGetBuildConfig",
          "list_apps": "#/$defs/BitriseAppsConfig",
          "list_branches": "#/$defs/BitriseBranchesConfig",
          "list_builds": "#/$defs/BitriseBuildsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BitriseCheckConfig"
        },
        {
          "$ref": "#/$defs/BitriseAppsConfig"
        },
        {
          "$ref": "#/$defs/BitriseGetAppConfig"
        },
        {
          "$ref": "#/$defs/BitriseBranchesConfig"
        },
        {
          "$ref": "#/$defs/BitriseBuildsConfig"
        },
        {
          "$ref": "#/$defs/BitriseGetBuildConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/BitriseAPITokenCredential"
        },
        {
          "$ref": "#/$defs/BitriseMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "Bitrise Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
