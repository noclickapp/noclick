          "description": "Single label before .dam.aprimo.com; no URL or path",
          "title": "Tenant",
          "type": "string"
        },
        "classification_id": {
          "description": "Readable classification UUID; all record and schema reads stay bound to this classification",
          "title": "Bound Classification ID",
          "type": "string"
        }
      },
      "required": [
        "access_token",
        "tenant",
        "classification_id"
      ],
      "title": "Aprimo DAM Bearer Token",
      "type": "object",
      "x-credential-instructions": "Supply an existing Aprimo DAM bearer token, its single tenant label, and one readable classification UUID. No token exchange or refresh is performed. DAM API entitlement and API scope must already be granted. The connection proves selected resource reachability, not account identity.",
