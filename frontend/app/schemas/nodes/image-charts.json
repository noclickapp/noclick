{
  "$defs": {
    "CheckConnection": {
      "additionalProperties": false,
      "description": "Render a small signed QR image to check credential acceptance.",
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "CheckConnection",
      "type": "object"
    },
    "ImageChartsAPIKey": {
      "properties": {
        "credential_type": {
          "const": "image_charts_api_key",
          "default": "image_charts_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "account_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Account ID",
          "type": "string"
        },
        "secret_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Secret Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "account_id",
        "secret_key"
      ],
      "title": "Image-Charts API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Enterprise account ID and secret key. NoClick signs requests on the server; the secret key is never sent. The connection check renders a small signed QR image to prove the provider accepts the credentials, without claiming an account identity.",
      "x-credential-url": "https://documentation.image-charts.com/enterprise/"
    },
    "RenderBar": {
      "additionalProperties": false,
      "description": "Render grouped vertical bars.",
      "properties": {
        "width": {
          "default": 500,
          "maximum": 999,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 300,
          "maximum": 999,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "chd": {
          "description": "Text-encoded numeric series, for example t:10,20,30|15,25,35. Use pipes between series and commas between values. Up to 1,000 series and 10,080 points.",
          "maxLength": 100000,
          "minLength": 3,
          "pattern": "^[at]:[0-9_.\\-,|]+$",
          "title": "Chart Data",
          "type": "string"
        },
        "chl": {
          "default": "",
          "description": "Pipe-separated labels; leave empty to use the provider's default labels.",
          "maxLength": 10000,
          "title": "Labels",
          "type": "string"
        },
        "chco": {
          "anyOf": [
            {
              "maxLength": 10000,
              "pattern": "^([0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?,?\\|?)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hex colors separated by commas (series) or pipes (points).",
          "title": "Colors"
        },
        "chtt": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "chdl": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pipe-separated series names.",
          "title": "Legend"
        },
        "operation": {
          "const": "render_bar",
          "default": "render_bar",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "chd"
      ],
      "title": "RenderBar",
      "type": "object"
    },
    "RenderChartJS": {
      "additionalProperties": false,
      "description": "Render a Chart.js 2.8.0 configuration as a PNG image.",
      "properties": {
        "width": {
          "default": 500,
          "maximum": 999,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
