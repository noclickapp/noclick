    "IONOSCloudBearerCredential": {
      "properties": {
        "credential_type": {
          "const": "ionoscloud_bearer",
          "default": "ionoscloud_bearer",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "token": {
          "title": "Bearer Token",
          "type": "string",
          "ui:sensitive": true,
          "ui:widget": "password"
        },
        "contract_number": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional exact existing X-Contract-Number integer. Bound to every request; no contract fallback.",
          "title": "Contract Number"
        },
        "approved_datacenter_ids_json": {
          "default": "[]",
          "description": "JSON string array of existing resource IDs, at most 50. Example: [\"15f67991-0f51-4efc-a8ad-ef1fb31a480c\"].",
          "title": "Approved Datacenter IDs",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "include_labels": {
          "default": false,
          "description": "Opt in to datacenter/server names only. All links, entities, hostnames, users, network, boot and configuration data remain excluded.",
          "title": "Include Resource Names",
          "type": "boolean"
        }
      },
      "required": [
        "token"
      ],
      "title": "IONOS Cloud Bearer Token",
      "type": "object",
      "x-credential-instructions": "Enter an existing Cloud API Bearer token and approved existing datacenter IDs. Supply a contract number only when your existing account requires one. Protected catalog access does not identify a principal or prove ownership.",
      "x-help-url": "https://api.ionos.com/docs/cloud/v6/"
    },
    "ListDatacenters": {
      "additionalProperties": false,
