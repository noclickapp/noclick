      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/CheckConnection",
          "get_datacenter": "#/$defs/GetDatacenter",
          "get_server": "#/$defs/GetServer",
          "list_datacenters": "#/$defs/ListDatacenters",
          "list_servers": "#/$defs/ListServers"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CheckConnection"
        },
        {
          "$ref": "#/$defs/ListDatacenters"
        },
        {
          "$ref": "#/$defs/GetDatacenter"
        },
        {
          "$ref": "#/$defs/ListServers"
        },
        {
          "$ref": "#/$defs/GetServer"
        }
