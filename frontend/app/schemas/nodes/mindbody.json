    "MindbodyAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "mindbody_api_key",
          "default": "mindbody_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Developer API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "site_id": {
          "description": "The activated business site. Mindbody's documented developer test site is -99; no environment is inferred from a key.",
          "title": "Site ID",
          "type": "integer"
        },
        "user_authorization": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The complete Authorization header value accepted for this staff user. It is sent verbatim; no Bearer prefix is added.",
          "title": "Staff Authorization",
          "ui:widget": "password"
        },
        "user_expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional UTC/offset ISO timestamp from the token issuer. Expired supplied tokens require replacement.",
          "title": "Staff Token Expiry"
        }
      },
      "required": [
        "api_key",
        "site_id"
      ],
      "title": "Mindbody Public API",
      "type": "object",
      "x-credential-instructions": "Supply a developer API key activated for this Site ID. Protected client reads, appointments and client writes also require an authorized staff user's complete Authorization header value. No login, token issue, renewal or activation request is made. Public metadata does not establish staff identity or account ownership.",
      "x-credential-url": "https://developers.mindbodyonline.com/"
    },
