    "IroncladAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "ironclad_api_token",
          "default": "ironclad_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Access token",
          "type": "string",
          "ui:widget": "password"
        },
        "user_email": {
          "anyOf": [
            {
              "maxLength": 254,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An existing Ironclad user email, required for client-credentials tokens. Omit for a personal user token.",
          "title": "Act as user email"
        },
        "api_host": {
          "default": "ironcladapp.com",
          "description": "Production, EU production, or demo.",
          "enum": [
            "ironcladapp.com",
            "eu1.ironcladapp.com",
            "demo.ironcladapp.com"
          ],
          "title": "API region",
          "type": "string"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Ironclad API Token",
      "type": "object",
      "x-credential-instructions": "Paste an existing Ironclad access token without the Bearer prefix. Replace it when it expires; NoClick does not refresh pasted tokens. Legacy access tokens are deprecated by Ironclad. For client-credentials or legacy tokens, enter the Ironclad user email whose permissions apply. For a personal user token, leave the email blank to use its own identity. Select the same region where the token was issued. A successful read verifies access to records, not all write permissions.",
      "x-credential-url": "https://developer.ironcladapp.com/reference/authenticate-a-request"
    },
