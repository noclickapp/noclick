              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact Preference",
          "enum": [
            "noPreference",
            "any",
            "email",
            "mail",
            "phone",
            "text",
            "noEmail",
            "noContact"
