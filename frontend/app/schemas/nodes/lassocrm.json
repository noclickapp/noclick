    "LassoCRMCreateActivityConfig": {
      "additionalProperties": false,
      "description": "Book a follow-up activity. Completed activities without completedBy are attributed to Lasso Autobot.",
      "properties": {
        "operation": {
          "const": "create_activity",
          "default": "create_activity",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
