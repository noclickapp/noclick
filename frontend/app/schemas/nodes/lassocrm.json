          "type": "string"
        },
        "start_time": {
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        },
        "end_time": {
          "format": "date-time",
          "title": "End Time",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "appointment_status": {
          "anyOf": [
            {
              "enum": [
                "Open",
                "Tentative",
                "Confirmed",
                "Cancelled",
                "Completed",
                "No Show"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
