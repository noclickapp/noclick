      "type": "object"
    },
    "LassoCRMCreateAppointmentConfig": {
      "additionalProperties": false,
      "description": "Create an appointment using UTC-offset times. Does not request email confirmations or SMS reminders.",
      "properties": {
        "operation": {
          "const": "create_appointment",
          "default": "create_appointment",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
