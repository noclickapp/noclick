        },
        {
          "$ref": "#/$defs/CreateChannel"
        },
        {
          "$ref": "#/$defs/UpdateChannel"
        },
        {
          "$ref": "#/$defs/ListChannelMembers"
        },
        {
          "$ref": "#/$defs/AddChannelMembers"
        },
        {
          "$ref": "#/$defs/RemoveChannelMember"
        },
        {
          "$ref": "#/$defs/SendChatMessage"
