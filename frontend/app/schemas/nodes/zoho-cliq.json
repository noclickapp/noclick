      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "search_messages",
          "default": "search_messages",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
