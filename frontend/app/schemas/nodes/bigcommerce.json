    "BigCommerceAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "bigcommerce_api_token",
          "default": "bigcommerce_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "store_hash": {
          "description": "The store hash from your API path: api.bigcommerce.com/stores/STORE_HASH/v3.",
          "title": "Store Hash",
          "type": "string"
        },
        "access_token": {
          "description": "Paste the access token from your store-level API account.",
          "minLength": 1,
          "title": "Access Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "store_hash",
        "access_token"
      ],
      "title": "BigCommerce API Token",
      "type": "object",
      "x-credential-instructions": "In your BigCommerce control panel, open Settings \u2192 Store-level API accounts and create an API account. Copy its store hash and access token. Grant Orders, Products, Customers and Store Inventory modify permissions for write actions, or read-only for reads. Information & Settings read-only is needed for the store identity check.",
      "x-credential-url": "https://docs.bigcommerce.com/developer/docs/overview/api-fundamentals/api-accounts"
    },
