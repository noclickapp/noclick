    "ListBranchBookings": {
      "additionalProperties": false,
      "properties": {
        "page_size": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use a continuation from this operation with the same credential, branch and filters.",
          "title": "Next Page Token"
        },
        "operation": {
          "const": "list_branch_bookings",
          "default": "list_branch_bookings",
          "description": "Branch booking start/finish values are local datetime strings; financial fields are excluded.",
          "title": "List Branch Bookings",
          "type": "string",
          "ui:hidden": true
        },
        "booking_status": {
          "anyOf": [
            {
              "enum": [
                "BOOKED",
                "WAITING",
                "CANCELED",
                "RESERVED",
                "FAILED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Filter",
          "enum": [
            "BOOKED",
            "WAITING",
            "CANCELED",
            "RESERVED",
            "FAILED"
          ],
          "x-enum-searchable": true
        },
        "modified_since": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UTC Unix seconds; inclusive modified-time filter.",
          "title": "Modified Since"
        }
      },
      "title": "ListBranchBookings",
      "type": "object"
    },
