    "AddNote": {
      "additionalProperties": false,
      "properties": {
        "member_id": {
          "pattern": "^[a-f0-9]{24}$",
          "title": "Member or Lead",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "member_id",
            "placeholder": "Select a branch member or lead",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "glofox_member"
        },
        "operation": {
          "const": "add_note",
          "default": "add_note",
          "description": "Adds a NOTE, never a MANUAL_EMAIL interaction. The documented acknowledgement does not provide a created ID or deletion contract.",
          "title": "Add Lead Note",
          "type": "string",
          "ui:hidden": true
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Note",
          "type": "string",
          "ui:widget": "textarea"
