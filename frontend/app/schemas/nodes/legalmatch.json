{
  "$defs": {
    "LegalMatchAcknowledgeReviewConfig": {
      "additionalProperties": false,
      "description": "Admin Acknowledge Review: Accept a finding as reviewed-and-correct.",
      "properties": {
        "operation": {
          "const": "acknowledge_review",
          "default": "acknowledge_review",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "sf_account": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Sf Account",
          "type": "string"
        },
        "qbo_customer_id": {
          "default": "",
          "maxLength": 4096,
          "title": "Qbo Customer Id",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 4096,
          "title": "Reason",
          "type": "string"
        },
        "finding_type": {
          "default": "owner_mismatch",
          "maxLength": 4096,
          "title": "Finding Type",
          "type": "string"
        },
        "redirect_to": {
          "default": "/admin/sf-validation",
          "maxLength": 4096,
          "title": "Redirect To",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "sf_account"
      ],
      "title": "LegalMatchAcknowledgeReviewConfig",
      "type": "object"
    },
    "LegalMatchAdjustMappingConfidenceConfig": {
      "additionalProperties": false,
      "description": "Admin Adjust Confidence: Trigger L1 confidence adjustment: apply learned feedback to mapping confidence scores.",
      "properties": {
        "operation": {
          "const": "adjust_mapping_confidence",
          "default": "adjust_mapping_confidence",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "LegalMatchAdjustMappingConfidenceConfig",
      "type": "object"
    },
    "LegalMatchAssignMappingConfig": {
      "additionalProperties": false,
      "description": "Admin Assign Mapping: Form handler: manually assign a QBO customer to an SF account.",
      "properties": {
        "operation": {
          "const": "assign_mapping",
          "default": "assign_mapping",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "qbo_customer_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Qbo Customer Id",
          "type": "string"
        },
        "sf_account": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Sf Account",
          "type": "string"
        },
        "match_method": {
          "default": "manual",
          "maxLength": 4096,
          "title": "Match Method",
          "type": "string"
        },
        "redirect_to": {
          "default": "/admin/unmatched",
          "maxLength": 4096,
          "title": "Redirect To",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "qbo_customer_id",
        "sf_account"
      ],
      "title": "LegalMatchAssignMappingConfig",
      "type": "object"
    },
    "LegalMatchBasicCredential": {
      "properties": {
        "credential_type": {
          "const": "legalmatch_basic",
          "default": "legalmatch_basic",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "username": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "QBI username",
          "type": "string"
        },
        "password": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "QBI password",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "title": "LegalMatch QBI Account",
      "type": "object",
      "x-credential-instructions": "Enter your existing LegalMatch QBI service username and password. This is the QBI administrative service, not a LegalMatch consumer account. NoClick uses HTTP Basic authentication only at qbi.legalmatch.com. Reading sync status checks access, not identity or permission to write.",
      "x-credential-url": "https://qbi.legalmatch.com/openapi.json"
    },
    "LegalMatchGetBannerAuditConfig": {
      "additionalProperties": false,
      "description": "Admin Banner Audit Json: JSON API for banner audit \u2014 for programmatic/scheduled checks.",
      "properties": {
        "operation": {
          "const": "get_banner_audit",
          "default": "get_banner_audit",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "limit": {
          "default": 0,
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "LegalMatchGetBannerAuditConfig",
      "type": "object"
    },
    "LegalMatchGetBannerAuditStatusConfig": {
      "additionalProperties": false,
      "description": "Admin Banner Audit Status: Current job state, for the page to poll. Cheap and read-only.",
      "properties": {
        "operation": {
          "const": "get_banner_audit_status",
          "default": "get_banner_audit_status",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "LegalMatchGetBannerAuditStatusConfig",
      "type": "object"
    },
    "LegalMatchGetGapSummaryConfig": {
      "additionalProperties": false,
      "description": "Admin Gap Summary: JSON endpoint for gap summary \u2014 polled by dashboard after gap detection.",
      "properties": {
        "operation": {
          "const": "get_gap_summary",
          "default": "get_gap_summary",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "LegalMatchGetGapSummaryConfig",
      "type": "object"
    },
    "LegalMatchGetLearningInsightsConfig": {
      "additionalProperties": false,
      "description": "Admin Learning Data: JSON API: all learning insights for programmatic access.",
      "properties": {
        "operation": {
          "const": "get_learning_insights",
          "default": "get_learning_insights",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "LegalMatchGetLearningInsightsConfig",
      "type": "object"
    },
    "LegalMatchGetMappingSuggestionsConfig": {
      "additionalProperties": false,
      "description": "Get Suggestions: Get suggested SF account matches for a QBO customer.",
      "properties": {
        "operation": {
          "const": "get_mapping_suggestions",
          "default": "get_mapping_suggestions",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "qbo_customer_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Qbo Customer Id",
          "type": "string"
        }
      },
      "required": [
        "qbo_customer_id"
      ],
      "title": "LegalMatchGetMappingSuggestionsConfig",
      "type": "object"
    },
    "LegalMatchGetSyncStatusConfig": {
      "additionalProperties": false,
      "description": "Admin Sync Status: JSON endpoint polled by dashboard for real-time sync card updates.",
      "properties": {
        "operation": {
          "const": "get_sync_status",
          "default": "get_sync_status",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "LegalMatchGetSyncStatusConfig",
      "type": "object"
    },
    "LegalMatchListLogsConfig": {
      "additionalProperties": false,
      "description": "Admin Logs Raw: Parsed log entries as JSON array (for programmatic access).",
      "properties": {
        "operation": {
          "const": "list_logs",
          "default": "list_logs",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "max_lines": {
          "default": 1000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Lines",
          "type": "integer"
        },
        "level": {
          "default": "",
          "maxLength": 4096,
          "title": "Level",
          "type": "string"
        }
      },
      "title": "LegalMatchListLogsConfig",
      "type": "object"
    },
    "LegalMatchMarkPaidConfig": {
      "additionalProperties": false,
      "description": "Admin Mark Paid: Set grace_period_cleared = 1 for an attorney's qb_record \u2014 hides the payment banner.",
      "properties": {
        "operation": {
          "const": "mark_paid",
          "default": "mark_paid",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "sf_account": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Sf Account",
          "type": "string"
        },
        "redirect_to": {
          "default": "/admin/mappings",
          "maxLength": 4096,
          "title": "Redirect To",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "sf_account"
      ],
      "title": "LegalMatchMarkPaidConfig",
      "type": "object"
    },
    "LegalMatchResolveAllGapsConfig": {
      "additionalProperties": false,
      "description": "Admin Resolve All Gaps: Batch-resolve all open gaps of a specific type.",
      "properties": {
        "operation": {
          "const": "resolve_all_gaps",
          "default": "resolve_all_gaps",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "gap_type": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Gap Type",
          "type": "string"
        },
        "resolution": {
          "default": "false_alarm",
          "maxLength": 4096,
          "title": "Resolution",
          "type": "string"
        }
      },
      "required": [
        "gap_type"
      ],
      "title": "LegalMatchResolveAllGapsConfig",
      "type": "object"
    },
    "LegalMatchResolveGapConfig": {
      "additionalProperties": false,
      "description": "Admin Resolve Gap: Resolve a single gap: dismissed, false_alarm, or fixed.",
      "properties": {
        "operation": {
          "const": "resolve_gap",
          "default": "resolve_gap",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "gap_id": {
          "title": "Gap Id",
          "type": "integer"
        },
        "resolution": {
          "enum": [
            "dismissed",
            "false_alarm",
            "fixed"
          ],
          "maxLength": 4096,
          "minLength": 1,
          "title": "Resolution",
          "type": "string"
        }
      },
      "required": [
        "gap_id",
        "resolution"
      ],
      "title": "LegalMatchResolveGapConfig",
      "type": "object"
    },
    "LegalMatchRevokeReviewConfig": {
      "additionalProperties": false,
      "description": "Admin Revoke Review: Withdraw a verdict, bringing the finding back to the live list.",
      "properties": {
        "operation": {
          "const": "revoke_review",
          "default": "revoke_review",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "sf_account": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Sf Account",
          "type": "string"
        },
        "finding_type": {
          "default": "owner_mismatch",
          "maxLength": 4096,
          "title": "Finding Type",
          "type": "string"
        },
        "redirect_to": {
          "default": "/admin/sf-validation",
          "maxLength": 4096,
          "title": "Redirect To",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "sf_account"
      ],
      "title": "LegalMatchRevokeReviewConfig",
      "type": "object"
    },
    "LegalMatchRunBackfillsConfig": {
      "additionalProperties": false,
      "description": "Trigger All Backfills: Manually trigger all 4 backfill entity types sequentially.",
      "properties": {
        "operation": {
          "const": "run_backfills",
          "default": "run_backfills",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "mode": {
          "default": "incremental",
          "enum": [
            "incremental",
            "full"
          ],
          "maxLength": 4096,
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "LegalMatchRunBackfillsConfig",
      "type": "object"
    },
    "LegalMatchRunBannerSyncConfig": {
      "additionalProperties": false,
      "description": "Trigger Banner Sync: Manually trigger banner sync.",
      "properties": {
        "operation": {
          "const": "run_banner_sync",
          "default": "run_banner_sync",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "LegalMatchRunBannerSyncConfig",
      "type": "object"
    },
    "LegalMatchRunFullSyncConfig": {
      "additionalProperties": false,
      "description": "Trigger Full Pipeline: Trigger the full sync pipeline (backfill \u2192 mapping \u2192 banner \u2192 reconcile \u2192 gap detection).",
      "properties": {
        "operation": {
          "const": "run_full_sync",
          "default": "run_full_sync",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "LegalMatchRunFullSyncConfig",
      "type": "object"
    },
    "LegalMatchRunGapDetectionConfig": {
      "additionalProperties": false,
      "description": "Trigger Gap Detection: Manually trigger gap detection.",
      "properties": {
        "operation": {
          "const": "run_gap_detection",
          "default": "run_gap_detection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "LegalMatchRunGapDetectionConfig",
      "type": "object"
    },
    "LegalMatchRunMappingSyncConfig": {
      "additionalProperties": false,
      "description": "Trigger Mapping Sync: Manually trigger mapping sync.",
      "properties": {
        "operation": {
          "const": "run_mapping_sync",
          "default": "run_mapping_sync",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "LegalMatchRunMappingSyncConfig",
      "type": "object"
    },
    "LegalMatchRunReconciliationConfig": {
      "additionalProperties": false,
      "description": "Trigger Reconciliation: Manually trigger reconciliation.",
      "properties": {
        "operation": {
          "const": "run_reconciliation",
          "default": "run_reconciliation",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "LegalMatchRunReconciliationConfig",
      "type": "object"
    },
    "LegalMatchUnmarkPaidConfig": {
      "additionalProperties": false,
      "description": "Admin Unmark Paid: Clear grace_period_cleared back to 0 \u2014 re-shows the payment banner.",
      "properties": {
        "operation": {
          "const": "unmark_paid",
          "default": "unmark_paid",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "sf_account": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Sf Account",
          "type": "string"
        },
        "redirect_to": {
          "default": "/admin/mappings",
          "maxLength": 4096,
          "title": "Redirect To",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "sf_account"
      ],
      "title": "LegalMatchUnmarkPaidConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "acknowledge_review": "#/$defs/LegalMatchAcknowledgeReviewConfig",
          "adjust_mapping_confidence": "#/$defs/LegalMatchAdjustMappingConfidenceConfig",
          "assign_mapping": "#/$defs/LegalMatchAssignMappingConfig",
          "get_banner_audit": "#/$defs/LegalMatchGetBannerAuditConfig",
          "get_banner_audit_status": "#/$defs/LegalMatchGetBannerAuditStatusConfig",
          "get_gap_summary": "#/$defs/LegalMatchGetGapSummaryConfig",
          "get_learning_insights": "#/$defs/LegalMatchGetLearningInsightsConfig",
          "get_mapping_suggestions": "#/$defs/LegalMatchGetMappingSuggestionsConfig",
          "get_sync_status": "#/$defs/LegalMatchGetSyncStatusConfig",
          "list_logs": "#/$defs/LegalMatchListLogsConfig",
          "mark_paid": "#/$defs/LegalMatchMarkPaidConfig",
          "resolve_all_gaps": "#/$defs/LegalMatchResolveAllGapsConfig",
          "resolve_gap": "#/$defs/LegalMatchResolveGapConfig",
          "revoke_review": "#/$defs/LegalMatchRevokeReviewConfig",
          "run_backfills": "#/$defs/LegalMatchRunBackfillsConfig",
          "run_banner_sync": "#/$defs/LegalMatchRunBannerSyncConfig",
          "run_full_sync": "#/$defs/LegalMatchRunFullSyncConfig",
          "run_gap_detection": "#/$defs/LegalMatchRunGapDetectionConfig",
          "run_mapping_sync": "#/$defs/LegalMatchRunMappingSyncConfig",
          "run_reconciliation": "#/$defs/LegalMatchRunReconciliationConfig",
          "unmark_paid": "#/$defs/LegalMatchUnmarkPaidConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LegalMatchRunFullSyncConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchRunBannerSyncConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchRunBackfillsConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchRunMappingSyncConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchRunReconciliationConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchRunGapDetectionConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchGetMappingSuggestionsConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchGetSyncStatusConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchGetGapSummaryConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchGetLearningInsightsConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchListLogsConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchAssignMappingConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchMarkPaidConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchUnmarkPaidConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchResolveGapConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchResolveAllGapsConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchGetBannerAuditStatusConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchGetBannerAuditConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchAdjustMappingConfidenceConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchAcknowledgeReviewConfig"
        },
        {
          "$ref": "#/$defs/LegalMatchRevokeReviewConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/LegalMatchBasicCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Legalmatch Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
