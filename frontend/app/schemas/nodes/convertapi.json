  "$defs": {
    "ConvertAPICredential": {
      "properties": {
        "credential_type": {
          "const": "convertapi_api_secret",
          "default": "convertapi_api_secret",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_secret": {
          "minLength": 1,
          "title": "API secret",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_secret"
      ],
      "title": "ConvertAPI API Secret",
      "type": "object",
      "x-credential-instructions": "Paste your ConvertAPI API secret from your account. Use the secret, rather than a restricted API token: account information and usage statistics require it. NoClick sends it as a Bearer credential to v2.convertapi.com. Conversions consume your provider balance and store results temporarily for up to three hours.",
      "x-credential-url": "https://www.convertapi.com/a/secret"
    },
    "ConvertCSVToXLSX": {
      "additionalProperties": false,
      "description": "Convert CSV to XLSX; consumes conversion credits.",
      "properties": {
        "file": {
          "description": "Source file URL or previously uploaded ConvertAPI file ID. The provider fetches URL inputs.",
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "file_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional output file name",
          "title": "File Name"
        },
        "operation": {
          "const": "csv_to_xlsx",
          "default": "csv_to_xlsx",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "ConvertCSVToXLSX",
      "type": "object"
    },
