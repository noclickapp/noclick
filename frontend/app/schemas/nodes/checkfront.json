        "customer_id"
      ],
      "title": "ArchiveCustomer",
      "type": "object"
    },
    "ChangeBookingStatus": {
      "additionalProperties": false,
      "description": "Change status; notifications, payment creation and overbooking are explicit switches.",
      "properties": {
        "booking_code": {
          "description": "Booking code, for example ABCD-010115.",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Booking Code",
          "type": "string"
        },
        "operation": {
          "const": "change_booking_status",
          "default": "change_booking_status",
          "title": "Operation",
          "type": "string"
        },
        "status_id": {
          "description": "Status ID from list_statuses, such as PAID.",
          "maxLength": 100,
          "minLength": 1,
          "title": "Status Id",
          "type": "string"
        },
        "send_notifications": {
          "default": false,
          "description": "Send the provider's configured status email notifications.",
          "title": "Send Notifications",
          "type": "boolean"
        },
        "apply_payment": {
          "default": false,
          "description": "Create a POS transaction for the balance when setting PAID.",
          "title": "Apply Payment",
          "type": "boolean"
        },
        "allow_overbooking": {
          "default": false,
          "description": "Allow inventory overbooking when setting a locked status.",
          "title": "Allow Overbooking",
          "type": "boolean"
        }
      },
      "required": [
        "booking_code",
        "status_id"
      ],
      "title": "ChangeBookingStatus",
      "type": "object"
    },
