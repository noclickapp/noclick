    "CheckfrontAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "checkfront_api_key",
          "default": "checkfront_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "tenant_url": {
          "description": "Your Checkfront HTTPS origin, without /api/4.0.",
          "title": "Tenant URL",
          "type": "string"
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_secret": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API secret",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "tenant_url",
        "api_key",
        "api_secret"
      ],
      "title": "Checkfront API Key",
      "type": "object",
      "x-credential-instructions": "In Checkfront, open Manage > Developer and create a token-pair application. Paste its API key and API secret, plus your tenant URL (for example https://your-company.checkfront.com). Migrated accounts can use their manage.na1.bookingplatform.app or manage.eu1.bookingplatform.app URL. API access requires an eligible paid account. The pair is sent using HTTP Basic authentication. Use a credential with permission for the selected operations.",
      "x-credential-url": "https://api.checkfront.com/overview/connecting.html"
    },
