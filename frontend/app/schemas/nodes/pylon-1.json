    "PylonAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "pylon_1_api_token",
          "default": "pylon_1_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        },
        "region": {
          "default": "US",
          "description": "Region hosting your Pylon tenant.",
          "enum": [
            "US",
            "EU"
          ],
          "title": "Region",
          "type": "string"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Pylon API Token",
      "type": "object",
      "x-credential-instructions": "An Admin creates a token in Settings > Integrations & dev > API tokens. Paste the token and select your tenant region. Its role controls access; Pylon API tokens have no separate scopes. NoClick checks /me to identify the connected organization.",
      "x-credential-url": "https://app.usepylon.com/settings/api-tokens"
    },
    "ReplyIssue": {
      "additionalProperties": false,
      "description": "Send a customer-facing reply to the selected existing conversation.",
      "properties": {
        "operation": {
          "const": "reply_issue",
          "default": "reply_issue",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "message_id": {
          "description": "Top-level Pylon message ID from list_issue_messages, identifying the customer-visible conversation.",
          "title": "Message Id",
          "type": "string"
        },
        "body_html": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Body Html",
          "type": "string"
        },
        "to_emails": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For an email conversation, provide at least one recipient; recipients are not inferred from the referenced message.",
          "title": "To Emails"
        }
      },
      "required": [
        "issue_id",
        "message_id",
        "body_html"
      ],
      "title": "ReplyIssue",
      "type": "object"
    },
