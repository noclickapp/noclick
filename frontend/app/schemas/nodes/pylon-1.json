    "CreateIssue": {
      "additionalProperties": false,
      "description": "Create an internal issue and first note without messaging a customer.",
      "properties": {
        "operation": {
          "const": "create_issue",
          "default": "create_issue",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "title": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "body_html": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Body Html",
          "type": "string"
        },
        "account_id": {
          "description": "Account for this internal issue. No destination is sent, so the first message is an internal note.",
          "title": "Account Id",
          "type": "string"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "urgent",
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority",
          "enum": [
            "urgent",
            "high",
            "medium",
            "low"
          ],
          "x-enum-searchable": true
        },
        "assignee_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assignee Id"
        },
        "team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        }
      },
      "required": [
        "title",
        "body_html",
        "account_id"
      ],
      "title": "CreateIssue",
      "type": "object"
    },
    "CreateIssueNote": {
      "additionalProperties": false,
      "description": "Post an internal note that is not visible to the requester.",
      "properties": {
        "operation": {
          "const": "create_issue_note",
