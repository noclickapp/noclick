        "body_html": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Body Html",
          "type": "string"
        },
        "thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Internal thread ID. When omitted, Pylon selects or creates an internal thread.",
          "title": "Thread Id"
        }
      },
      "required": [
        "issue_id",
        "body_html"
      ],
      "title": "CreateIssueNote",
      "type": "object"
