{
  "$defs": {
    "AddProspect": {
      "additionalProperties": false,
      "description": "Add a prospect and generate their video with explicitly authorized usage charges.",
      "properties": {
        "workspace_id": {
          "description": "Use Get Workspace Identifier to find your workspace ID.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Workspace ID",
          "type": "string"
        },
        "dynamic_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Dynamic campaign ID",
          "type": "string"
        },
        "processAndAuthorizeCharge": {
          "description": "Must be true: generate prospect videos and authorize Sendspark's usage charges above your plan limit.",
          "title": "Processandauthorizecharge",
          "type": "boolean"
        },
        "callbackId": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callbackid"
        },
        "operation": {
          "const": "add_prospect",
          "default": "add_prospect",
          "title": "Operation",
          "type": "string"
        },
        "prospect": {
          "$ref": "#/$defs/Prospect"
        },
        "fallbackToEmailDomainForBackground": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallbacktoemaildomainforbackground"
        }
      },
      "required": [
        "workspace_id",
        "dynamic_id",
        "processAndAuthorizeCharge",
        "prospect"
      ],
      "title": "AddProspect",
      "type": "object"
    },
    "BulkAddProspects": {
      "additionalProperties": false,
      "description": "Add prospects and generate their videos with explicitly authorized usage charges.",
      "properties": {
        "workspace_id": {
          "description": "Use Get Workspace Identifier to find your workspace ID.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Workspace ID",
          "type": "string"
        },
        "dynamic_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Dynamic campaign ID",
          "type": "string"
        },
        "processAndAuthorizeCharge": {
          "description": "Must be true: generate prospect videos and authorize Sendspark's usage charges above your plan limit.",
          "title": "Processandauthorizecharge",
          "type": "boolean"
        },
        "callbackId": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callbackid"
        },
        "operation": {
          "const": "bulk_add_prospects",
          "default": "bulk_add_prospects",
          "title": "Operation",
          "type": "string"
        },
        "prospectList": {
          "description": "A JSON array of prospect objects, each with a contactEmail.",
          "items": {
            "$ref": "#/$defs/Prospect"
          },
          "maxItems": 10000,
          "minItems": 1,
          "placeholder": "[{\"contactEmail\": \"johndoe@example.com\", \"contactName\": \"John Doe\"}]",
          "title": "Prospectlist",
          "type": "array",
          "ui:widget": "state_editor"
