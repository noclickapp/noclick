    "CreateWebhook": {
      "additionalProperties": false,
      "description": "Register a webhook URL for Sendspark events.",
      "properties": {
        "workspace_id": {
          "description": "Use Get Workspace Identifier to find your workspace ID.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Workspace ID",
          "type": "string"
        },
        "operation": {
          "const": "create_webhook",
          "default": "create_webhook",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "maxLength": 8192,
          "title": "Url",
          "type": "string"
        },
        "module": {
          "enum": [
            "global",
            "dynamics"
          ],
          "title": "Module",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "extraHeaders": {
          "anyOf": [
            {
              "items": {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraheaders",
          "ui:widget": "list"
        },
        "identifiers": {
          "anyOf": [
            {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifiers",
          "ui:widget": "list"
        },
        "events": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "video_watched",
                  "video_played",
                  "video_cta_clicked",
                  "video_viewed",
                  "video_liked",
                  "video_request_received",
                  "video_generated_dv",
                  "video_mp4_ready",
                  "video_generated_error"
                ],
                "type": "string"
              },
              "maxItems": 9,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Events"
        }
      },
      "required": [
        "workspace_id",
        "name",
        "url",
        "module"
      ],
      "title": "CreateWebhook",
      "type": "object"
    },
