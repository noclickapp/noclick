          "title": "Iscollapsed"
        },
        "expandAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The date and time the maintenance will expand at in ISO-8601 format (UTC Timezone).",
          "title": "Expandat"
        },
        "statuses": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ComponentStatusEntry"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statuses"
        },
        "translations": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translations"
        }
