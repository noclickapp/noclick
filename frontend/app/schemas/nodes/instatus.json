          ],
          "default": null,
          "description": "How many minutes the maintenance will last since the `start` date and time if `autoEnd` is set to `true`.",
          "title": "Duration"
        },
        "notifyStart": {
          "description": "Whether to notify the subscribers of the page and the affected components when the maintenance **starts**.",
          "title": "Notifystart",
          "type": "boolean"
        },
        "notifyEnd": {
          "description": "Whether to notify the subscribers of the page and the affected components when the maintenance **ends**.",
          "title": "Notifyend",
          "type": "boolean"
        },
        "notifyEarly": {
          "description": "Whether to notify the subscribers of the page and the affected components before the maintenance starts.",
          "title": "Notifyearly",
          "type": "boolean"
        },
        "notifyMinutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The number of minutes before the maintenance starts that the subscribers will be notified.",
          "title": "Notifyminutes"
        },
        "autoStart": {
          "description": "Whether to automatically start the maintenance automatically when the date and time reaches the `start` date and time.",
          "title": "Autostart",
          "type": "boolean"
        },
        "autoEnd": {
          "description": "Whether to automatically end the maintenance automatically when the date and time\u00ab reaches the `end` date and time.",
          "title": "Autoend",
          "type": "boolean"
        },
        "isCollapsed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
