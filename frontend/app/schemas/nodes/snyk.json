          "minLength": 1,
          "title": "Project ID",
          "type": "string"
        },
        "key": {
          "maxLength": 30,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Tag key",
          "type": "string"
        },
        "value": {
          "maxLength": 50,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Tag value",
          "type": "string"
        },
        "operation": {
          "const": "add_project_tag",
          "default": "add_project_tag",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "org_id",
        "project_id",
        "key",
        "value"
      ],
      "title": "AddProjectTag",
      "type": "object"
    },
