{
  "$defs": {
    "ActivateProject": {
      "additionalProperties": false,
      "description": "Activate project monitoring.",
      "properties": {
        "org_id": {
          "description": "Organization UUID from Snyk or List organizations.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Organization ID",
          "type": "string"
        },
        "project_id": {
          "description": "Project UUID from the Snyk project URL or REST API.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Project ID",
          "type": "string"
        },
        "operation": {
          "const": "activate_project",
          "default": "activate_project",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "org_id",
        "project_id"
      ],
      "title": "ActivateProject",
      "type": "object"
    },
    "AddIgnore": {
      "additionalProperties": false,
      "description": "Add an ignore rule for an issue.",
      "properties": {
        "org_id": {
          "description": "Organization UUID from Snyk or List organizations.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Organization ID",
          "type": "string"
        },
        "project_id": {
          "description": "Project UUID from the Snyk project URL or REST API.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Project ID",
          "type": "string"
        },
        "issue_id": {
          "description": "Snyk vulnerability or license issue ID, for example npm:qs:20140806-1.",
          "maxLength": 300,
          "minLength": 1,
          "title": "Issue ID",
          "type": "string"
        },
        "operation": {
          "const": "add_ignore",
          "default": "add_ignore",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "reason_type": {
          "enum": [
            "not-vulnerable",
            "wont-fix",
            "temporary-ignore"
          ],
          "title": "Reason type",
          "type": "string"
        },
        "disregard_if_fixable": {
          "default": false,
          "description": "Only ignore when no upgrade or patch is available.",
          "title": "Disregard If Fixable",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "expires": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 timestamp when the ignore expires.",
          "title": "Expires"
        },
        "ignore_path": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dependency path to ignore. Omit for all paths (*).",
          "title": "Ignore Path"
        }
      },
      "required": [
        "org_id",
        "project_id",
        "issue_id",
        "reason_type"
      ],
      "title": "AddIgnore",
      "type": "object"
    },
    "AddProjectTag": {
      "additionalProperties": false,
      "description": "Apply a tag to the project.",
      "properties": {
        "org_id": {
          "description": "Organization UUID from Snyk or List organizations.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Organization ID",
