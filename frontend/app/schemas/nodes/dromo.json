{
  "$defs": {
    "CreateHeadlessImport": {
      "additionalProperties": false,
      "description": "Start a JSON headless import; this returns a job, not completed results.",
      "properties": {
        "operation": {
          "const": "create_headless_import",
          "default": "create_headless_import",
          "title": "Operation",
          "type": "string"
        },
        "schema_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Saved schema UUID; supply this or inline fields, exclusively.",
          "title": "Schema Id"
        },
        "fields_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON array of field objects, e.g. [{\"key\":\"first_name\",\"type\":\"string\",\"label\":\"First Name\",\"validators\":[]}].",
          "title": "Fields Json",
          "ui:widget": "code_editor"
        },
        "settings_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional JSON settings override for this import only.",
          "title": "Settings Json",
          "ui:widget": "code_editor"
        },
        "hooks_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional JSON hooks object containing serialized JavaScript callbacks.",
          "title": "Hooks Json",
          "ui:widget": "code_editor"
        },
        "initial_data_json": {
          "description": "Complete JSON data array, at most 15 MB. Example: [{\"first_name\":\"Zeph\",\"last_name\":\"paul.zeph@gmail.com\"}].",
          "maxLength": 15000000,
          "title": "Initial Data Json",
          "type": "string",
          "ui:widget": "code_editor"
        }
      },
      "required": [
        "initial_data_json"
      ],
      "title": "CreateHeadlessImport",
      "type": "object"
    },
    "CreateSchema": {
      "additionalProperties": false,
      "description": "Create a reusable saved import schema.",
      "properties": {
        "name": {
          "description": "Unique schema name within your organization.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "fields_json": {
          "description": "JSON array of field objects, e.g. [{\"key\":\"first_name\",\"type\":\"string\",\"label\":\"First Name\",\"validators\":[]}].",
          "title": "Fields Json",
          "type": "string",
          "ui:widget": "code_editor"
        },
        "settings_json": {
          "default": "{}",
          "description": "JSON settings object, e.g. {\"developmentMode\":true}. PUT replaces the whole schema; supply all fields and settings you want to retain.",
          "title": "Settings Json",
          "type": "string",
          "ui:widget": "code_editor"
        },
        "hooks_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional JSON hooks object containing serialized JavaScript callbacks.",
          "title": "Hooks Json",
          "ui:widget": "code_editor"
        },
        "operation": {
          "const": "create_schema",
          "default": "create_schema",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "fields_json"
      ],
      "title": "CreateSchema",
      "type": "object"
    },
    "DeleteHeadlessImport": {
      "additionalProperties": false,
      "description": "Permanently delete a headless import.",
      "properties": {
        "id": {
          "description": "Dromo resource UUID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_headless_import",
          "default": "delete_headless_import",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeleteHeadlessImport",
      "type": "object"
    },
    "DeleteSchema": {
      "additionalProperties": false,
      "description": "Permanently delete a saved import schema.",
      "properties": {
        "id": {
          "description": "Dromo resource UUID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_schema",
          "default": "delete_schema",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeleteSchema",
      "type": "object"
    },
    "DeleteUpload": {
      "additionalProperties": false,
      "description": "Permanently delete an embedded upload.",
      "properties": {
        "id": {
          "description": "Dromo resource UUID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_upload",
          "default": "delete_upload",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeleteUpload",
      "type": "object"
    },
    "DromoAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "dromo_api_key",
          "default": "dromo_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Backend license key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Dromo Backend API Key",
      "type": "object",
      "x-credential-instructions": "Paste the Backend license key from your Dromo dashboard, not the frontend license key. NoClick sends it to app.dromo.io as X-Dromo-License-Key. Connecting lists your saved schemas. Headless imports require the Enterprise Headless add-on and may consume your plan allowance. Download URLs expire; treat them as secrets.",
      "x-credential-url": "https://dashboard.dromo.io/"
    },
    "GetHeadlessImport": {
      "additionalProperties": false,
      "description": "Read headless import status, review URL and errors without polling.",
      "properties": {
        "id": {
          "description": "Dromo resource UUID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "const": "get_headless_import",
          "default": "get_headless_import",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetHeadlessImport",
      "type": "object"
    },
    "GetHeadlessImportUrl": {
      "additionalProperties": false,
      "description": "Get an expiring signed URL for completed headless import result data.",
      "properties": {
        "id": {
          "description": "Dromo resource UUID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "const": "get_headless_import_url",
          "default": "get_headless_import_url",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetHeadlessImportUrl",
      "type": "object"
    },
    "GetSchema": {
      "additionalProperties": false,
      "description": "Get a saved import schema by UUID.",
      "properties": {
        "id": {
          "description": "Dromo resource UUID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "const": "get_schema",
          "default": "get_schema",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetSchema",
      "type": "object"
    },
    "GetUploadMetadata": {
      "additionalProperties": false,
      "description": "Read metadata and raw-file download URL for an embedded upload.",
      "properties": {
        "id": {
          "description": "Dromo resource UUID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "const": "get_upload_metadata",
          "default": "get_upload_metadata",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetUploadMetadata",
      "type": "object"
    },
    "GetUploadUrl": {
      "additionalProperties": false,
      "description": "Get an expiring signed URL for embedded upload result data.",
      "properties": {
        "id": {
          "description": "Dromo resource UUID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "const": "get_upload_url",
          "default": "get_upload_url",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetUploadUrl",
      "type": "object"
    },
    "ListHeadlessImports": {
      "additionalProperties": false,
      "description": "List one page of headless imports, preserving pagination metadata.",
      "properties": {
        "operation": {
          "const": "list_headless_imports",
          "default": "list_headless_imports",
          "title": "Operation",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "ListHeadlessImports",
      "type": "object"
    },
    "ListSchemas": {
      "additionalProperties": false,
      "description": "List your organization's saved import schemas.",
      "properties": {
        "operation": {
          "const": "list_schemas",
          "default": "list_schemas",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListSchemas",
      "type": "object"
    },
    "ListUploads": {
      "additionalProperties": false,
      "description": "List one bounded range of embedded uploads; use end as the next start.",
      "properties": {
        "operation": {
          "const": "list_uploads",
          "default": "list_uploads",
          "title": "Operation",
          "type": "string"
        },
        "start": {
          "default": 0,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "default": 100,
          "description": "Exclusive range end; request at most 10000 uploads.",
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "title": "ListUploads",
      "type": "object"
    },
    "UpdateSchema": {
      "additionalProperties": false,
      "description": "Replace an existing saved schema with the supplied definition.",
      "properties": {
        "id": {
          "description": "Dromo resource UUID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Unique schema name within your organization.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "fields_json": {
          "description": "JSON array of field objects, e.g. [{\"key\":\"first_name\",\"type\":\"string\",\"label\":\"First Name\",\"validators\":[]}].",
          "title": "Fields Json",
          "type": "string",
          "ui:widget": "code_editor"
        },
        "settings_json": {
          "default": "{}",
          "description": "JSON settings object, e.g. {\"developmentMode\":true}. PUT replaces the whole schema; supply all fields and settings you want to retain.",
          "title": "Settings Json",
          "type": "string",
          "ui:widget": "code_editor"
        },
        "hooks_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional JSON hooks object containing serialized JavaScript callbacks.",
          "title": "Hooks Json",
          "ui:widget": "code_editor"
        },
        "operation": {
          "const": "update_schema",
          "default": "update_schema",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "fields_json"
      ],
      "title": "UpdateSchema",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_headless_import": "#/$defs/CreateHeadlessImport",
          "create_schema": "#/$defs/CreateSchema",
          "delete_headless_import": "#/$defs/DeleteHeadlessImport",
          "delete_schema": "#/$defs/DeleteSchema",
          "delete_upload": "#/$defs/DeleteUpload",
          "get_headless_import": "#/$defs/GetHeadlessImport",
          "get_headless_import_url": "#/$defs/GetHeadlessImportUrl",
          "get_schema": "#/$defs/GetSchema",
          "get_upload_metadata": "#/$defs/GetUploadMetadata",
          "get_upload_url": "#/$defs/GetUploadUrl",
          "list_headless_imports": "#/$defs/ListHeadlessImports",
          "list_schemas": "#/$defs/ListSchemas",
          "list_uploads": "#/$defs/ListUploads",
          "update_schema": "#/$defs/UpdateSchema"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListSchemas"
        },
        {
          "$ref": "#/$defs/GetSchema"
        },
        {
          "$ref": "#/$defs/CreateSchema"
        },
        {
          "$ref": "#/$defs/UpdateSchema"
        },
        {
          "$ref": "#/$defs/DeleteSchema"
        },
        {
          "$ref": "#/$defs/ListUploads"
        },
        {
          "$ref": "#/$defs/GetUploadMetadata"
        },
        {
          "$ref": "#/$defs/DeleteUpload"
        },
        {
          "$ref": "#/$defs/GetUploadUrl"
        },
        {
          "$ref": "#/$defs/ListHeadlessImports"
        },
        {
          "$ref": "#/$defs/GetHeadlessImport"
        },
        {
          "$ref": "#/$defs/CreateHeadlessImport"
        },
        {
          "$ref": "#/$defs/DeleteHeadlessImport"
        },
        {
          "$ref": "#/$defs/GetHeadlessImportUrl"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/DromoAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Dromo Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
