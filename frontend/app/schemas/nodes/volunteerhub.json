{
  "$defs": {
    "AddUserGroupMemberships": {
      "additionalProperties": false,
      "description": "Add a user to the selected user groups.",
      "properties": {
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "user_group_uids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "User group IDs",
          "type": "array"
        },
        "operation": {
          "const": "add_user_group_memberships",
          "default": "add_user_group_memberships",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "user_id",
        "user_group_uids"
      ],
      "title": "AddUserGroupMemberships",
      "type": "object"
    },
    "GetEvent": {
      "additionalProperties": false,
      "description": "Read an event by its unique ID, including registrations and hours.",
      "properties": {
        "operation": {
          "const": "get_event",
          "default": "get_event",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "GetEvent",
      "type": "object"
    },
    "GetOrganization": {
      "additionalProperties": false,
      "description": "Read the connected organization's name, forms and configuration.",
      "properties": {
        "operation": {
          "const": "get_organization",
          "default": "get_organization",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetOrganization",
      "type": "object"
    },
    "GetUser": {
      "additionalProperties": false,
      "description": "Read a volunteer's profile, form answers and user group memberships.",
      "properties": {
        "operation": {
          "const": "get_user",
          "default": "get_user",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id"
      ],
      "title": "GetUser",
      "type": "object"
    },
    "ListDonations": {
      "additionalProperties": false,
      "description": "Read donations for selected users (Volunteer Fundraising required).",
      "properties": {
        "page": {
          "default": 0,
          "description": "Zero-based page number. Each run reads one page.",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 50,
          "description": "Maximum 50 records per page.",
          "maximum": 50,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "operation": {
          "const": "list_donations",
          "default": "list_donations",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "const": "UserUids",
          "default": "UserUids",
          "title": "Query",
          "type": "string",
          "ui:hidden": true
        },
        "uids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "User IDs",
          "type": "array"
        }
      },
      "required": [
        "uids"
      ],
      "title": "ListDonations",
      "type": "object"
    },
    "ListEventGroups": {
      "additionalProperties": false,
      "description": "Read event groups in hierarchical order.",
      "properties": {
        "page": {
          "default": 0,
          "description": "Zero-based page number. Each run reads one page.",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 50,
          "description": "Maximum 50 records per page.",
          "maximum": 50,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "operation": {
          "const": "list_event_groups",
          "default": "list_event_groups",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "const": "Hierarchical",
          "default": "Hierarchical",
          "title": "Query",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListEventGroups",
      "type": "object"
    },
    "ListEvents": {
      "additionalProperties": false,
      "description": "Read events by version or time window.",
      "properties": {
        "page": {
          "default": 0,
          "description": "Zero-based page number. Each run reads one page.",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 50,
          "description": "Maximum 50 records per page.",
          "maximum": 50,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "operation": {
          "const": "list_events",
          "default": "list_events",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "default": "Version",
          "enum": [
            "Version",
            "Time"
          ],
          "title": "Query",
          "type": "string"
        },
        "earliest_version": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Required for a Version query; events with a greater version are returned.",
          "title": "Earliest Version"
        },
        "earliest_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for a Time query; include events ending on or after this ISO 8601 time.",
          "title": "Earliest Time"
        },
        "latest_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional exclusive upper bound on event start time.",
          "title": "Latest Time"
        }
      },
      "title": "ListEvents",
      "type": "object"
    },
    "ListUserGroups": {
      "additionalProperties": false,
      "description": "Read user groups in hierarchical order.",
      "properties": {
        "page": {
          "default": 0,
          "description": "Zero-based page number. Each run reads one page.",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 50,
          "description": "Maximum 50 records per page.",
          "maximum": 50,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "operation": {
          "const": "list_user_groups",
          "default": "list_user_groups",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "const": "Hierarchical",
          "default": "Hierarchical",
          "title": "Query",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListUserGroups",
      "type": "object"
    },
    "ListUsers": {
      "additionalProperties": false,
      "description": "Read volunteer profiles by update time or version.",
      "properties": {
        "page": {
          "default": 0,
          "description": "Zero-based page number. Each run reads one page.",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 50,
          "description": "Maximum 50 records per page.",
          "maximum": 50,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "operation": {
          "const": "list_users",
          "default": "list_users",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "default": "Version",
          "enum": [
            "LastUpdate",
            "Version"
          ],
          "title": "Query",
          "type": "string"
        },
        "earliest_last_update": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for LastUpdate queries (ISO 8601).",
          "title": "Earliest Last Update"
        },
        "earliest_version": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Required for Version queries; return users with a greater version.",
          "title": "Earliest Version"
        }
      },
      "title": "ListUsers",
      "type": "object"
    },
    "RemoveUserGroupMemberships": {
      "additionalProperties": false,
      "description": "Remove a user from the selected user groups.",
      "properties": {
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "user_group_uids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "User group IDs",
          "type": "array"
        },
        "operation": {
          "const": "remove_user_group_memberships",
          "default": "remove_user_group_memberships",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "user_id",
        "user_group_uids"
      ],
      "title": "RemoveUserGroupMemberships",
      "type": "object"
    },
    "VolunteerHubBasicCredential": {
      "properties": {
        "credential_type": {
          "const": "volunteerhub_basic",
          "default": "volunteerhub_basic",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "site_url": {
          "description": "Your site subdomain or HTTPS address, such as https://myorganization.volunteerhub.com.",
          "title": "Site address",
          "type": "string"
        },
        "username": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Username",
          "type": "string"
        },
        "password": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Password",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "site_url",
        "username",
        "password"
      ],
      "title": "VolunteerHub Account",
      "type": "object",
      "x-credential-instructions": "Enter your VolunteerHub site address and an existing Superuser's username and password. VolunteerHub's REST API uses HTTP Basic authentication over HTTPS. Its API guide requires a username and a password shorter than 16 characters. The account must have permission for the selected operation; donations also require Volunteer Fundraising.",
      "x-credential-url": "https://support.volunteerhub.com/support/solutions/articles/60000610783-introduction-to-the-volunteerhub-api"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_user_group_memberships": "#/$defs/AddUserGroupMemberships",
          "get_event": "#/$defs/GetEvent",
          "get_organization": "#/$defs/GetOrganization",
          "get_user": "#/$defs/GetUser",
          "list_donations": "#/$defs/ListDonations",
          "list_event_groups": "#/$defs/ListEventGroups",
          "list_events": "#/$defs/ListEvents",
          "list_user_groups": "#/$defs/ListUserGroups",
          "list_users": "#/$defs/ListUsers",
          "remove_user_group_memberships": "#/$defs/RemoveUserGroupMemberships"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListDonations"
        },
        {
          "$ref": "#/$defs/ListEventGroups"
        },
        {
          "$ref": "#/$defs/ListEvents"
        },
        {
          "$ref": "#/$defs/GetEvent"
        },
        {
          "$ref": "#/$defs/GetOrganization"
        },
        {
          "$ref": "#/$defs/ListUserGroups"
        },
        {
          "$ref": "#/$defs/ListUsers"
        },
        {
          "$ref": "#/$defs/GetUser"
        },
        {
          "$ref": "#/$defs/AddUserGroupMemberships"
        },
        {
          "$ref": "#/$defs/RemoveUserGroupMemberships"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/VolunteerHubBasicCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Volunteerhub Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
