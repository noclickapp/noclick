            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipeline Id"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "company_id": {
          "description": "Company ID from List Companies",
          "maxLength": 128,
          "minLength": 1,
          "title": "Company Id",
          "type": "string"
        },
        "operation": {
          "const": "create_position",
          "default": "create_position",
          "title": "Create Position",
          "type": "string",
          "ui:hidden": true
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
