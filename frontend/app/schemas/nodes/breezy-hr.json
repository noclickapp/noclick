{
  "$defs": {
    "BreezyAddCandidate": {
      "additionalProperties": false,
      "description": "Add candidate in Breezy HR.",
      "properties": {
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "email_address": {
          "anyOf": [
            {
              "maxLength": 320,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email Address"
        },
        "phone_number": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone Number"
        },
        "address": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "cover_letter": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cover Letter"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "company_id": {
          "description": "Company ID from List Companies",
          "maxLength": 128,
          "minLength": 1,
          "title": "Company Id",
          "type": "string"
        },
        "position_id": {
          "description": "Position ID from List Positions",
          "maxLength": 128,
          "minLength": 1,
          "title": "Position Id",
          "type": "string"
        },
        "operation": {
          "const": "add_candidate",
          "default": "add_candidate",
          "title": "Add Candidate",
          "type": "string",
          "ui:hidden": true
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "origin": {
          "default": "sourced",
          "description": "Applied can email the candidate and always runs stage actions; required application fields still apply",
          "enum": [
            "sourced",
            "applied"
          ],
          "title": "Origin",
          "type": "string"
        },
        "stage_actions_enabled": {
          "default": false,
          "description": "Run add-stage actions for sourced candidates",
          "title": "Stage Actions Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "company_id",
        "position_id"
      ],
      "title": "BreezyAddCandidate",
      "type": "object"
    },
    "BreezyCreatePosition": {
      "additionalProperties": false,
      "description": "Create position in Breezy HR.",
