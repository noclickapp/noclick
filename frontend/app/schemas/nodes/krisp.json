{
  "$defs": {
    "KrispAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "krisp_api_key",
          "default": "krisp_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Krisp Settings \u2192 Integrations \u2192 API. A Read scope and an eligible paid/trial plan are required.",
          "maxLength": 103,
          "minLength": 103,
          "pattern": "^krsp_u_[0-9a-fA-F]{96}$",
          "title": "Personal API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "scopes": {
          "description": "Copy the key's configured Read/Write scopes. This form does not grant permissions. These operations require Read.",
          "items": {
            "enum": [
              "read",
              "write"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Configured Key Scopes",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional actual aware ISO 8601 expiry. Leave unset for a no-expiration key; do not invent a new 90-day lifetime.",
          "title": "Actual Key Expiry"
        },
        "expected_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Krisp User ID"
        },
        "expected_team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Team ID"
        },
        "expected_workspace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional expected IDs from /me. A mismatch fails before meeting data is requested.",
          "title": "Expected Workspace ID"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Krisp API Key",
      "type": "object",
      "x-credential-url": "https://meeting-api-docs.krisp.ai/docs/getting-started"
    },
    "KrispGetIdentityConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_identity",
          "default": "get_identity",
          "title": "Operation",
          "type": "string",
          "x-category": "Account",
          "x-display-name": "Get Key Holder Identity"
        }
      },
      "title": "KrispGetIdentityConfig",
      "type": "object"
    },
    "KrispGetMeetingConfig": {
      "additionalProperties": false,
      "properties": {
        "meeting_id": {
          "title": "Processed Meeting",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "meeting_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "krisp_meeting"
        },
        "operation": {
          "const": "get_meeting",
          "default": "get_meeting",
          "title": "Operation",
          "type": "string",
          "x-category": "Meetings",
          "x-display-name": "Get Meeting Metadata"
        }
      },
      "required": [
        "meeting_id"
      ],
      "title": "KrispGetMeetingConfig",
      "type": "object"
    },
    "KrispGetMeetingTagsConfig": {
      "additionalProperties": false,
      "properties": {
        "meeting_id": {
          "title": "Processed Meeting",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "meeting_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "krisp_meeting"
        },
        "operation": {
          "const": "get_meeting_tags",
          "default": "get_meeting_tags",
          "title": "Operation",
          "type": "string",
          "x-category": "Tags",
          "x-display-name": "Get Meeting Tag Names"
        }
      },
      "required": [
        "meeting_id"
      ],
      "title": "KrispGetMeetingTagsConfig",
      "type": "object"
    },
    "KrispGetNotesConfig": {
      "additionalProperties": false,
      "properties": {
        "meeting_id": {
          "title": "Processed Meeting",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "meeting_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "krisp_meeting"
        },
        "operation": {
          "const": "get_meeting_notes",
          "default": "get_meeting_notes",
          "title": "Operation",
          "type": "string",
          "x-category": "Meeting Content",
          "x-display-name": "Get Existing Meeting Notes"
        }
      },
      "required": [
        "meeting_id"
      ],
      "title": "KrispGetNotesConfig",
      "type": "object"
    },
    "KrispGetParticipantsConfig": {
      "additionalProperties": false,
      "properties": {
        "meeting_id": {
          "title": "Processed Meeting",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "meeting_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "krisp_meeting"
        },
        "operation": {
          "const": "get_meeting_participants",
          "default": "get_meeting_participants",
          "title": "Operation",
          "type": "string",
          "x-category": "Meeting Content",
          "x-display-name": "Get Meeting Participants"
        }
      },
      "required": [
        "meeting_id"
      ],
      "title": "KrispGetParticipantsConfig",
      "type": "object"
    },
    "KrispGetTranscriptConfig": {
      "additionalProperties": false,
      "properties": {
        "meeting_id": {
          "title": "Processed Meeting",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "meeting_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "krisp_meeting"
        },
        "operation": {
          "const": "get_meeting_transcript",
          "default": "get_meeting_transcript",
          "title": "Operation",
          "type": "string",
          "x-category": "Meeting Content",
          "x-display-name": "Get Existing Transcript"
        },
        "include_speaker_names": {
          "default": false,
          "description": "Include the existing diarization-index name map. Photos and media URLs remain excluded.",
          "title": "Include Speaker Names",
          "type": "boolean"
        }
      },
      "required": [
        "meeting_id"
      ],
      "title": "KrispGetTranscriptConfig",
      "type": "object"
    },
    "KrispListActionItemsConfig": {
      "additionalProperties": false,
      "properties": {
        "page_token": {
          "anyOf": [
            {
              "maxLength": 16000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Continuation from this exact key, account context, endpoint, parent and filters. No automatic page drain.",
          "title": "Page Token"
        },
        "limit": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "completed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "False means incomplete only; unset means all statuses.",
          "title": "Completed"
        },
        "assigned_to_me": {
          "default": false,
          "title": "Assigned To Me",
          "type": "boolean"
        },
        "include_assignee": {
          "default": false,
          "description": "Explicitly include existing assignee names/email; avatar and media URLs are excluded.",
          "title": "Include Assignee",
          "type": "boolean"
        },
        "operation": {
          "const": "list_action_items",
          "default": "list_action_items",
          "title": "Operation",
          "type": "string",
          "x-category": "Action Items",
          "x-display-name": "List Action Items"
        }
      },
      "title": "KrispListActionItemsConfig",
      "type": "object"
    },
    "KrispListMeetingActionItemsConfig": {
      "additionalProperties": false,
      "properties": {
        "page_token": {
          "anyOf": [
            {
              "maxLength": 16000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Continuation from this exact key, account context, endpoint, parent and filters. No automatic page drain.",
          "title": "Page Token"
        },
        "limit": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "completed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "False means incomplete only; unset means all statuses.",
          "title": "Completed"
        },
        "assigned_to_me": {
          "default": false,
          "title": "Assigned To Me",
          "type": "boolean"
        },
        "include_assignee": {
          "default": false,
          "description": "Explicitly include existing assignee names/email; avatar and media URLs are excluded.",
          "title": "Include Assignee",
          "type": "boolean"
        },
        "meeting_id": {
          "title": "Processed Meeting",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "meeting_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "krisp_meeting"
        },
        "operation": {
          "const": "list_meeting_action_items",
          "default": "list_meeting_action_items",
          "title": "Operation",
          "type": "string",
          "x-category": "Action Items",
          "x-display-name": "List Meeting Action Items From Page"
        }
      },
      "required": [
        "meeting_id"
      ],
      "title": "KrispListMeetingActionItemsConfig",
      "type": "object"
    },
    "KrispListMeetingsConfig": {
      "additionalProperties": false,
      "properties": {
        "page_token": {
          "anyOf": [
            {
              "maxLength": 16000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Continuation from this exact key, account context, endpoint, parent and filters. No automatic page drain.",
          "title": "Page Token"
        },
        "operation": {
          "const": "list_meetings",
          "default": "list_meetings",
          "title": "Operation",
          "type": "string",
          "x-category": "Meetings",
          "x-display-name": "List Processed Meetings"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "ownership": {
          "default": "all",
          "enum": [
            "all",
            "mine",
            "shared"
          ],
          "title": "Ownership",
          "type": "string"
        },
        "sort_by": {
          "default": "date",
          "enum": [
            "date",
            "duration",
            "last_modified"
          ],
          "title": "Sort By",
          "type": "string"
        },
        "order": {
          "default": "newest",
          "enum": [
            "newest",
            "oldest"
          ],
          "title": "Order",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider search across titles, notes and participants; transcript text is not searched.",
          "title": "Query"
        },
        "from_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From (ISO 8601)"
        },
        "to_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To (ISO 8601)"
        },
        "tag_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "tag_id",
            "searchable": true
          },
          "x-resource-type": "krisp_tag"
        }
      },
      "title": "KrispListMeetingsConfig",
      "type": "object"
    },
    "KrispListTagsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_tags",
          "default": "list_tags",
          "title": "Operation",
          "type": "string",
          "x-category": "Tags",
          "x-display-name": "List Tags"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider prefix search over tag names; at most 100 tags.",
          "title": "Query"
        }
      },
      "title": "KrispListTagsConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_identity": "#/$defs/KrispGetIdentityConfig",
          "get_meeting": "#/$defs/KrispGetMeetingConfig",
          "get_meeting_notes": "#/$defs/KrispGetNotesConfig",
          "get_meeting_participants": "#/$defs/KrispGetParticipantsConfig",
          "get_meeting_tags": "#/$defs/KrispGetMeetingTagsConfig",
          "get_meeting_transcript": "#/$defs/KrispGetTranscriptConfig",
          "list_action_items": "#/$defs/KrispListActionItemsConfig",
          "list_meeting_action_items": "#/$defs/KrispListMeetingActionItemsConfig",
          "list_meetings": "#/$defs/KrispListMeetingsConfig",
          "list_tags": "#/$defs/KrispListTagsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/KrispGetIdentityConfig"
        },
        {
          "$ref": "#/$defs/KrispListMeetingsConfig"
        },
        {
          "$ref": "#/$defs/KrispGetMeetingConfig"
        },
        {
          "$ref": "#/$defs/KrispGetNotesConfig"
        },
        {
          "$ref": "#/$defs/KrispGetTranscriptConfig"
        },
        {
          "$ref": "#/$defs/KrispGetParticipantsConfig"
        },
        {
          "$ref": "#/$defs/KrispGetMeetingTagsConfig"
        },
        {
          "$ref": "#/$defs/KrispListActionItemsConfig"
        },
        {
          "$ref": "#/$defs/KrispListMeetingActionItemsConfig"
        },
        {
          "$ref": "#/$defs/KrispListTagsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/KrispAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Krisp Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
