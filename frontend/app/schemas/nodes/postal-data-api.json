{
  "$defs": {
    "GetPostalCodeMetadata": {
      "description": "Get all country-specific metadata using the recommended metacode endpoint.",
      "properties": {
        "zipcode": {
          "description": "Postal code as text, preserving leading zeros; for example 90210 or SW1A.",
          "minLength": 1,
          "title": "Zipcode",
          "type": "string"
        },
        "country": {
          "default": "US",
          "description": "ISO 3166-1 alpha-2 country code.",
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "operation": {
          "const": "get_postal_code_metadata",
          "default": "get_postal_code_metadata",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "zipcode"
      ],
      "title": "GetPostalCodeMetadata",
      "type": "object"
    },
    "GetPostalCodeMetadataLegacy": {
      "description": "Query the deprecated metazip alias; prefer Get Postal Code Metadata for new workflows.",
      "properties": {
        "zipcode": {
          "description": "Postal code as text, preserving leading zeros; for example 90210 or SW1A.",
          "minLength": 1,
          "title": "Zipcode",
          "type": "string"
        },
        "country": {
          "default": "US",
          "description": "ISO 3166-1 alpha-2 country code.",
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "operation": {
          "const": "get_postal_code_metadata_legacy",
          "default": "get_postal_code_metadata_legacy",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "zipcode"
      ],
      "title": "GetPostalCodeMetadataLegacy",
      "type": "object"
    },
    "LookupPostalCode": {
      "description": "Get the city, state and coordinates for a postal code.",
      "properties": {
        "zipcode": {
          "description": "Postal code as text, preserving leading zeros; for example 90210 or SW1A.",
          "minLength": 1,
          "title": "Zipcode",
          "type": "string"
        },
        "country": {
          "default": "US",
          "description": "ISO 3166-1 alpha-2 country code.",
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "operation": {
          "const": "lookup_postal_code",
          "default": "lookup_postal_code",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "zipcode"
      ],
      "title": "LookupPostalCode",
      "type": "object"
    },
    "PostalCodeRecord": {
      "properties": {
        "postalCode": {
          "minLength": 1,
          "title": "Postal Code",
          "type": "string"
        },
        "countryCode": {
          "maxLength": 2,
          "minLength": 2,
          "title": "Country Code",
          "type": "string"
        }
      },
      "required": [
        "postalCode",
        "countryCode"
      ],
      "title": "PostalCodeRecord",
      "type": "object"
    },
    "PostalDataApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "postal_data_api_key",
          "default": "postal_data_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Postal Data Api API Key",
      "type": "object",
      "x-credential-instructions": "Sign in to PostalDataPI, open API Keys, create a key and paste it here. Connecting performs one postal-code query and consumes one query credit; it verifies key acceptance, not account identity.",
      "x-credential-type": "api_key",
      "x-credential-url": "https://postaldatapi.com/login"
    },
    "SearchByCity": {
      "description": "Find postal codes by city; US queries require state or ST.",
      "properties": {
        "operation": {
          "const": "search_by_city",
          "default": "search_by_city",
          "title": "Operation",
          "type": "string"
        },
        "city": {
          "minLength": 1,
          "title": "City",
          "type": "string"
        },
        "country": {
          "default": "US",
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Full state/region name. Required for US unless ST is supplied.",
          "title": "State"
        },
        "ST": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "State abbreviation, for example CA.",
          "title": "State Abbreviation"
        }
      },
      "required": [
        "city"
      ],
      "title": "SearchByCity",
      "type": "object"
    },
    "ValidateBulkPostalCodes": {
      "description": "Validate 1\u20131,000 records in input order, including mixed countries.",
      "properties": {
        "operation": {
          "const": "validate_bulk_postal_codes",
          "default": "validate_bulk_postal_codes",
          "title": "Operation",
          "type": "string"
        },
        "records": {
          "description": "Each record has postalCode and countryCode. Each record consumes one query credit.",
          "items": {
            "$ref": "#/$defs/PostalCodeRecord"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "records"
      ],
      "title": "ValidateBulkPostalCodes",
      "type": "object"
    },
    "ValidatePostalCode": {
      "description": "Check whether a postal code exists; valid=false is a successful response.",
      "properties": {
        "zipcode": {
          "description": "Postal code as text, preserving leading zeros; for example 90210 or SW1A.",
          "minLength": 1,
          "title": "Zipcode",
          "type": "string"
        },
        "country": {
          "default": "US",
          "description": "ISO 3166-1 alpha-2 country code.",
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "operation": {
          "const": "validate_postal_code",
          "default": "validate_postal_code",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "zipcode"
      ],
      "title": "ValidatePostalCode",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_postal_code_metadata": "#/$defs/GetPostalCodeMetadata",
          "get_postal_code_metadata_legacy": "#/$defs/GetPostalCodeMetadataLegacy",
          "lookup_postal_code": "#/$defs/LookupPostalCode",
          "search_by_city": "#/$defs/SearchByCity",
          "validate_bulk_postal_codes": "#/$defs/ValidateBulkPostalCodes",
          "validate_postal_code": "#/$defs/ValidatePostalCode"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LookupPostalCode"
        },
        {
          "$ref": "#/$defs/ValidatePostalCode"
        },
        {
          "$ref": "#/$defs/ValidateBulkPostalCodes"
        },
        {
          "$ref": "#/$defs/SearchByCity"
        },
        {
          "$ref": "#/$defs/GetPostalCodeMetadata"
        },
        {
          "$ref": "#/$defs/GetPostalCodeMetadataLegacy"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/PostalDataApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Postal-data-api Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
