        "contact_id"
      ],
      "title": "GetContact",
      "type": "object"
    },
    "GetContactByEmail": {
      "additionalProperties": false,
      "description": "Read a contact by primary email.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
