{
  "$defs": {
    "AddContactComment": {
      "additionalProperties": false,
      "description": "Add a comment to the selected contact.",
      "properties": {
        "contact_id": {
          "minimum": 1,
          "title": "Contact ID",
          "type": "integer"
        },
        "operation": {
          "const": "add_contact_comment",
          "default": "add_contact_comment",
          "title": "Operation",
          "type": "string"
        },
        "comment": {
          "minLength": 1,
          "title": "Comment",
          "type": "string"
        }
      },
      "required": [
        "contact_id",
        "comment"
      ],
      "title": "AddContactComment",
      "type": "object"
    },
    "AddContactTags": {
      "additionalProperties": false,
      "description": "Add tags to a contact; tag changes can start campaigns.",
      "properties": {
        "contact_id": {
          "minimum": 1,
          "title": "Contact ID",
          "type": "integer"
        },
        "operation": {
          "const": "add_contact_tags",
          "default": "add_contact_tags",
          "title": "Operation",
          "type": "string"
        },
        "tag_ids": {
          "description": "Tag IDs to send to Quentn's PUT contact terms endpoint.",
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Tag Ids",
          "type": "array"
        }
      },
      "required": [
        "contact_id",
        "tag_ids"
      ],
      "title": "AddContactTags",
      "type": "object"
    },
    "ContactData": {
      "additionalProperties": true,
      "description": "Built-in fields plus provider-defined field_ custom field names.",
      "properties": {
        "mail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Email"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "family_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family Name"
        },
        "company": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
