          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tag IDs; changing tags may start campaigns.",
          "title": "Terms"
        }
      },
      "title": "ContactData",
      "type": "object"
    },
    "CreateContact": {
      "additionalProperties": false,
      "description": "Create or merge a contact using the documented duplicate policy.",
      "properties": {
        "operation": {
          "const": "create_contact",
          "default": "create_contact",
          "title": "Operation",
          "type": "string"
        },
        "contact": {
          "$ref": "#/$defs/ContactData"
        },
        "duplicate_check_method": {
          "default": "auto",
          "enum": [
            "auto",
            "email",
            "none"
          ],
          "title": "Duplicate Check Method",
          "type": "string"
        },
        "duplicate_merge_method": {
          "default": "update_add",
          "enum": [
            "update_add",
            "update",
            "add"
          ],
          "title": "Duplicate Merge Method",
          "type": "string"
        },
        "return_fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Fields"
        }
      },
      "required": [
        "contact"
      ],
      "title": "CreateContact",
      "type": "object"
    },
    "CreateTag": {
      "additionalProperties": false,
      "description": "Create a tag for contact segmentation and campaigns.",
      "properties": {
        "operation": {
          "const": "create_tag",
          "default": "create_tag",
          "title": "Operation",
          "type": "string"
        },
        "name": {
