            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_audit_event",
          "default": "on_new_audit_event",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On New Account Audit Event",
          "x-is-trigger": true
        },
        "lookback_hours": {
          "default": 24,
          "description": "Poll this rolling time window. Existing events are baselined when armed. Use a schedule shorter than the window; outages beyond it can miss events.",
          "maximum": 168,
          "minimum": 1,
          "title": "Lookback hours",
          "type": "integer"
        },
        "audit_filter": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit filter"
        },
        "limit": {
          "default": 1000,
          "description": "At this limit, results may be incomplete. Narrow the filter/window or increase the limit.",
          "maximum": 10000,
          "minimum": 1,
          "title": "Maximum events per window",
          "type": "integer"
        },
        "allow_partial_results": {
          "default": false,
          "description": "By default a warning or full page stops polling without consuming seen state. Enable to emit the returned events with an explicit incompleteness warning; events missing from the API response may be missed.",
          "title": "Allow incomplete audit windows",
          "type": "boolean"
        }
      },
      "title": "DynatraceOnNewAuditEventConfig",
      "type": "object",
      "x-requires-webhook": true
