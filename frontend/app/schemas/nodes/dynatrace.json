      "x-credential-url": "https://docs.dynatrace.com/docs/manage/identity-access-management/access-tokens-and-oauth-clients/oauth-clients",
      "x-oauth-provider": "dynatrace",
      "x-oauth-scopes": [
        "account-audit-logs-read",
        "account-env-read",
        "account-idm-read",
        "account-idm-write",
        "account-uac-read",
        "iam-policies-management",
        "offline_access",
        "openid",
        "profile"
      ]
    },
