{
  "$defs": {
    "AddSenderDomain": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "add_sender_domain",
          "default": "add_sender_domain",
          "description": "Add a sender domain",
          "title": "Add Sender Domain",
          "type": "string",
          "ui:hidden": true
        },
        "domain": {
          "description": "Domain to add as a sender domain",
          "maxLength": 8192,
          "title": "Domain",
          "type": "string"
        },
        "tracking_subdomain": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An optional subdomain used for click or open tracking and unsubscribe links",
          "title": "Tracking Subdomain"
        },
        "returnpath_subdomain": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An optional subdomain to use as a return-path subdomain",
          "title": "Returnpath Subdomain"
        },
        "auto_verify": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If true, verify the domain now removing the need to call the 'domain/verify' endpoint or wait for the periodic verification every 7 minutes.  Note: In order to successfully complete the verification, the 'tracking_subdomain' and 'returnpath_subdomain' must be configured in the domain DNS and propagated.",
          "title": "Auto Verify"
        },
        "requisition_ssl": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If true, requisition an SSL certificate for the tracking domain once verification is complete",
          "title": "Requisition Ssl"
        },
        "subaccount_id": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If you wish to make this API call on behalf of a subaccount then include its unique ID here",
          "title": "Subaccount Id"
        }
      },
      "required": [
        "domain"
      ],
      "title": "AddSenderDomain",
      "type": "object"
    },
