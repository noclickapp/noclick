          "default": null,
          "description": "A HTML encoded email body. Either html_body or text_body is required if template_id is not passed. If template_id is passed this field is ignored. Warning:To correctly track clicking of URLs you must:  Enable click tracking for the API key  Insert a full anchor HTML element (not just the URL) Include \"https://\" at the start of the HREF property ",
          "title": "HTML Body"
        },
        "text_body": {
          "anyOf": [
            {
              "maxLength": 200000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A plain text email body. Either html_body or text_body is required if template_id is not passed. If template_id is passed this field is ignored.",
          "title": "Text Body"
        },
        "template_id": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The ID of the template you wish to use",
          "title": "Template ID"
        },
        "template_data": {
          "anyOf": [
            {
              "maxLength": 200000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When a template_id is provided, include the pass-through values in the format {\"variable1\": \"value1\", \"variable2\": \"value2\"}",
          "title": "Template Data"
        },
        "schedule": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
