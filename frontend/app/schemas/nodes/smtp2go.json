        "subject": {
          "description": "The subject of the email template.",
          "maxLength": 8192,
          "title": "Subject",
          "type": "string"
        },
        "html_body": {
          "description": "The HTML body of the email template.",
          "maxLength": 200000,
          "title": "HTML Body",
          "type": "string"
        },
        "text_body": {
          "description": "The Plain Text body of the email template.",
          "maxLength": 200000,
          "title": "Text Body",
          "type": "string"
        },
        "template_variables": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The variables to use within this email template in the format {\"variable1\": \"value1\", \"variable2\": \"value2\"}",
          "title": "Template Variables"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The list of Tags to associate to this email template",
          "title": "Tags"
        }
      },
      "required": [
        "template_name",
        "id",
        "subject",
        "html_body",
        "text_body"
      ],
      "title": "CreateTemplate",
      "type": "object"
