        },
        "template_name": {
          "description": "The name of the email template. Min length: 1 Character. Max length: 64 Characters.",
          "maxLength": 8192,
          "title": "Template Name",
          "type": "string"
        },
        "id": {
          "description": "The case-sensitive ID of the email template. Min length: 5 Character. Max length: 24 Characters.",
          "maxLength": 8192,
          "title": "Id",
          "type": "string"
