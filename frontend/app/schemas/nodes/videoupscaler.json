{
  "$defs": {
    "CreateUploadConfig": {
      "properties": {
        "operation": {
          "const": "create_upload_url",
          "default": "create_upload_url",
          "title": "Create Upload URL",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Video",
          "x-display-name": "Create Upload URL",
          "x-is-trigger": false
        },
        "content_type": {
          "enum": [
            "video/mp4",
            "video/quicktime",
            "video/webm"
          ],
          "title": "Content Type",
          "type": "string"
        },
        "size": {
          "description": "Upload the file with PUT to the returned URL using its headers, then pass video_url to Create Upscale Task.",
          "maximum": 104857600,
          "minimum": 1,
          "title": "File Size in Bytes",
          "type": "integer"
        }
      },
      "required": [
        "content_type",
        "size"
      ],
      "title": "CreateUploadConfig",
      "type": "object"
    },
    "CreateUpscaleConfig": {
      "properties": {
        "operation": {
          "const": "create_upscale_task",
          "default": "create_upscale_task",
          "title": "Create Upscale Task",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Video",
          "x-display-name": "Create Upscale Task",
          "x-is-trigger": false
        },
        "video_url": {
          "description": "Public MP4, MOV or WebM URL, or video_url from Create Upload URL.",
          "title": "Video URL",
          "type": "string"
        },
        "resolution": {
          "enum": [
            "1080p",
            "2k",
            "4k"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reuse the same key when retrying to avoid a second charge.",
          "title": "Idempotency Key"
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional HTTPS URL receiving the Task on completion or failure.",
          "title": "Completion Webhook URL"
        },
        "ops": {
          "anyOf": [
            {
              "$ref": "#/$defs/UpscaleOps"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enhancement Options"
        }
      },
      "required": [
        "video_url",
        "resolution"
      ],
      "title": "CreateUpscaleConfig",
      "type": "object"
    },
    "GetAccountConfig": {
      "properties": {
        "operation": {
          "const": "get_account_balance",
          "default": "get_account_balance",
          "title": "Get Account Balance",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Video",
          "x-display-name": "Get Account Balance",
          "x-is-trigger": false
        }
      },
      "title": "GetAccountConfig",
      "type": "object"
    },
    "GetTaskConfig": {
      "properties": {
        "operation": {
          "const": "get_upscale_task",
          "default": "get_upscale_task",
          "title": "Get Upscale Task",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Video",
          "x-display-name": "Get Upscale Task",
          "x-is-trigger": false
        },
        "task_id": {
          "minLength": 1,
          "title": "Task ID",
          "type": "string"
        },
        "wait": {
          "default": 0,
          "description": "Hold the request until completion/failure or this timeout.",
          "maximum": 45,
          "minimum": 0,
          "title": "Wait Seconds",
          "type": "integer"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "GetTaskConfig",
      "type": "object"
    },
    "ListTasksConfig": {
      "properties": {
        "operation": {
          "const": "list_upscale_tasks",
          "default": "list_upscale_tasks",
          "title": "List Upscale Tasks",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Video",
          "x-display-name": "List Upscale Tasks",
          "x-is-trigger": false
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Tasks per Page",
          "type": "integer"
        }
      },
      "title": "ListTasksConfig",
      "type": "object"
    },
    "OnNewTaskConfig": {
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_task",
          "default": "on_new_task",
          "title": "On New Upscale Task",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On New Upscale Task",
          "x-is-trigger": true
        }
      },
      "title": "OnNewTaskConfig",
      "type": "object",
      "x-requires-webhook": true
    },
