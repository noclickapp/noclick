    "SidetrackerListConversionsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_conversions",
          "default": "list_conversions",
          "title": "Retrieve converted sessions",
          "type": "string",
          "ui:hidden": true
        },
        "attribution": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`0` to omit the attribution block. On by default, which caps `page_size` at 100.",
          "title": "Attribution"
        },
        "converted": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`yes` or `no` -- whether the session has revenue recorded against it.",
          "title": "Converted"
        },
        "daterange": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Range over the conversion date, e.g. `2026-08-01 to 2026-08-20`.",
          "title": "Daterange"
        },
        "domain_id": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Limit to one tracked domain (its unique id). Faster than the account-wide list.",
          "title": "Domain Id"
        },
        "include_hidden": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`1` to also return SPAM, which is hidden by default.",
          "title": "Include Hidden"
        },
        "label": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeatable. Referrer label name.",
          "title": "Label"
        },
        "lookback": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Attribution window in days: `30`, `60`, `90` (default) or `all`.",
          "title": "Lookback"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Attribution model: `last_click` (default), `first_click`, `linear`, `position_based`, `time_decay`.",
          "title": "Model"
        },
        "order": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`converted_at` (default) or `id`. Use `id` to page through the whole list.",
          "title": "Order"
        },
        "page": {
          "default": 1,
          "description": "The page number to retrieve.",
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 100,
          "description": "Items per page. Clamped to 500, or 100 when attribution is on.",
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "sales_status": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeatable. Stored status names, e.g. `CUSTOMER`. Repeated values are OR'd; unknown ones are ignored.",
          "title": "Sales Status"
        },
        "search": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free text over name, session id and the Google Ads campaign behind the session (campaign, ad group, keyword, ad, device, network). Also `meta:<key>`, `data:<key>` and `status:<STATUS>`.",
          "title": "Search"
        },
        "tab": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`all` (default), `inbox` for unarchived sessions, or `archived`.",
          "title": "Tab"
        },
        "tag": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeatable. Tag name.",
          "title": "Tag"
        },
        "updated_since": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601. Only sessions changed at or after this moment, for incremental syncing.",
          "title": "Updated Since"
        }
      },
      "title": "SidetrackerListConversionsConfig",
      "type": "object"
    },
