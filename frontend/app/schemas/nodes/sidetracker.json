{
  "$defs": {
    "SidetrackerCreateListConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_list",
          "default": "create_list",
          "title": "Create a list",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "List Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "preset": {
          "enum": [
            "tracking",
            "checks"
          ],
          "title": "Preset",
          "type": "string"
        },
        "columns": {
          "description": "Column names allowed by the selected preset, as listed in the Sidetracker API contract.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        }
      },
      "required": [
        "name",
        "preset",
        "columns"
      ],
      "title": "SidetrackerCreateListConfig",
      "type": "object"
    },
