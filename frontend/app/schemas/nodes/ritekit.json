{
  "$defs": {
    "AutoEmojify": {
      "additionalProperties": false,
      "description": "Auto-Emojify.",
      "properties": {
        "operation": {
          "const": "auto_emojify",
          "default": "auto_emojify",
          "title": "Auto-Emojify",
          "type": "string",
          "ui:hidden": true
        },
        "text": {
          "description": "Text of the post",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "AutoEmojify",
      "type": "object"
    },
    "AutoHashtag": {
      "additionalProperties": false,
      "description": "Auto-Hashtag.",
      "properties": {
        "operation": {
          "const": "auto_hashtag",
          "default": "auto_hashtag",
          "title": "Auto-Hashtag",
          "type": "string",
          "ui:hidden": true
        },
        "post": {
          "description": "Text of the post",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Post",
          "type": "string"
        },
        "maxHashtags": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Max number of hashtags.",
          "title": "Maxhashtags"
        },
        "hashtagPosition": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Position of hashtags: end => at the end, auto => anywhere",
          "title": "Hashtagposition"
        }
      },
      "required": [
        "post"
      ],
      "title": "AutoHashtag",
      "type": "object"
    },
    "CleanInstagramHashtags": {
      "additionalProperties": false,
      "description": "Hashtags cleaner.",
      "properties": {
        "operation": {
          "const": "clean_instagram_hashtags",
          "default": "clean_instagram_hashtags",
          "title": "Hashtags cleaner",
          "type": "string",
          "ui:hidden": true
        },
        "post": {
          "description": "post",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Post",
          "type": "string"
        }
      },
      "required": [
        "post"
      ],
      "title": "CleanInstagramHashtags",
      "type": "object"
    },
    "CreateQuoteImage": {
      "additionalProperties": false,
      "description": "Text to Image.",
      "properties": {
        "operation": {
          "const": "create_quote_image",
          "default": "create_quote_image",
          "title": "Text to Image",
          "type": "string",
          "ui:hidden": true
        },
        "quote": {
          "description": "Text of the quote",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "author": {
          "description": "Name of the author/source",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "fontSize": {
          "description": "Font size for the quote (author font size is calculated automatically)",
          "title": "Fontsize",
          "type": "integer"
        },
        "quoteFont": {
          "description": "Font-family used for quote text",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Quotefont",
          "type": "string"
        },
        "quoteFontColor": {
          "description": "Font color of the quote text",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Quotefontcolor",
          "type": "string"
        },
        "authorFont": {
          "description": "Font-family used for author name",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Authorfont",
          "type": "string"
        },
        "authorFontColor": {
          "description": "Font color of the author",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Authorfontcolor",
          "type": "string"
        },
        "enableHighlight": {
          "description": "Enable highlight on quote text",
          "title": "Enablehighlight",
          "type": "integer"
        },
        "highlightColor": {
          "description": "Color used for highlight",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Highlightcolor",
          "type": "string"
        },
        "bgType": {
          "description": "Background type (gradient/solid)",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Bgtype",
          "type": "string"
        },
        "backgroundColor": {
          "description": "Background color for solid background type",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Backgroundcolor",
          "type": "string"
        },
        "gradientType": {
          "description": "Type of gradient background (linear/radial)",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Gradienttype",
          "type": "string"
        },
        "gradientColor1": {
          "description": "First color for gradient background type",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Gradientcolor1",
          "type": "string"
        },
        "gradientColor2": {
          "description": "Second color for gradient background type",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Gradientcolor2",
          "type": "string"
        },
        "brandLogo": {
          "description": "URL of the brand logo",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Brandlogo",
          "type": "string"
        },
        "animation": {
          "description": "Animation type: none, rays, glint, circle",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Animation",
          "type": "string"
        },
        "showQuoteMark": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "showing/hiding quote mark",
          "title": "Showquotemark"
        }
      },
      "required": [
        "quote",
        "author",
        "fontSize",
        "quoteFont",
        "quoteFontColor",
        "authorFont",
        "authorFontColor",
        "enableHighlight",
        "highlightColor",
        "bgType",
        "backgroundColor",
        "gradientType",
        "gradientColor1",
        "gradientColor2",
        "brandLogo",
        "animation"
      ],
      "title": "CreateQuoteImage",
      "type": "object"
    },
    "GetHashtagHistory": {
      "additionalProperties": false,
      "description": "Hashtag History.",
      "properties": {
        "operation": {
          "const": "get_hashtag_history",
          "default": "get_hashtag_history",
          "title": "Hashtag History",
          "type": "string",
          "ui:hidden": true
        },
        "hashtag": {
          "description": "Hashtag without # mark",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Hashtag",
          "type": "string"
        }
      },
      "required": [
        "hashtag"
      ],
      "title": "GetHashtagHistory",
      "type": "object"
    },
    "GetHashtagStats": {
      "additionalProperties": false,
      "description": "Hashtag Stats.",
      "properties": {
        "operation": {
          "const": "get_hashtag_stats",
          "default": "get_hashtag_stats",
          "title": "Hashtag Stats",
          "type": "string",
          "ui:hidden": true
        },
        "tags": {
          "description": "Hashtag(s) without # mark",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "tags"
      ],
      "title": "GetHashtagStats",
      "type": "object"
    },
    "GetTrendingHashtags": {
      "additionalProperties": false,
      "description": "Trending Hashtags.",
      "properties": {
        "operation": {
          "const": "get_trending_hashtags",
          "default": "get_trending_hashtags",
          "title": "Trending Hashtags",
          "type": "string",
          "ui:hidden": true
        },
        "green": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict results only to green hashtags. Hides overused (red) hashtags.",
          "title": "Green"
        },
        "latin": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict results only to hashtags with latin characters",
          "title": "Latin"
        }
      },
      "title": "GetTrendingHashtags",
      "type": "object"
    },
    "ListCtas": {
      "additionalProperties": false,
      "description": "List of CTAs.",
      "properties": {
        "operation": {
          "const": "list_ctas",
          "default": "list_ctas",
          "title": "List of CTAs",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListCtas",
      "type": "object"
    },
    "RitekitClientIdCredential": {
      "properties": {
        "credential_type": {
          "const": "ritekit_client_id",
          "default": "ritekit_client_id",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "client_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Client ID",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "client_id"
      ],
      "title": "RiteKit Client ID",
      "type": "object",
      "x-credential-instructions": "Create a token in the RiteKit developer dashboard, then paste its Client ID. RiteKit supports using this private value directly without OAuth. Keep it secret; NoClick sends it as the client_id query parameter to api.ritekit.com.",
      "x-credential-url": "https://ritekit.com/developer/dashboard/"
    },
    "ShortenLink": {
      "additionalProperties": false,
      "description": "Shorten Link.",
      "properties": {
        "operation": {
          "const": "shorten_link",
          "default": "shorten_link",
          "title": "Shorten Link",
          "type": "string",
          "ui:hidden": true
        },
        "url": {
          "description": "URL",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "cta": {
          "description": "cta id",
          "title": "Cta",
          "type": "integer"
        }
      },
      "required": [
        "url",
        "cta"
      ],
      "title": "ShortenLink",
      "type": "object"
    },
    "SuggestEmojis": {
      "additionalProperties": false,
      "description": "Emoji Suggestions.",
      "properties": {
        "operation": {
          "const": "suggest_emojis",
          "default": "suggest_emojis",
          "title": "Emoji Suggestions",
          "type": "string",
          "ui:hidden": true
        },
        "text": {
          "description": "Text of the post",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "SuggestEmojis",
      "type": "object"
    },
    "SuggestHashtags": {
      "additionalProperties": false,
      "description": "Hashtag Suggestions.",
      "properties": {
        "operation": {
          "const": "suggest_hashtags",
          "default": "suggest_hashtags",
          "title": "Hashtag Suggestions",
          "type": "string",
          "ui:hidden": true
        },
        "text": {
          "description": "Topic",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "SuggestHashtags",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "auto_emojify": "#/$defs/AutoEmojify",
          "auto_hashtag": "#/$defs/AutoHashtag",
          "clean_instagram_hashtags": "#/$defs/CleanInstagramHashtags",
          "create_quote_image": "#/$defs/CreateQuoteImage",
          "get_hashtag_history": "#/$defs/GetHashtagHistory",
          "get_hashtag_stats": "#/$defs/GetHashtagStats",
          "get_trending_hashtags": "#/$defs/GetTrendingHashtags",
          "list_ctas": "#/$defs/ListCtas",
          "shorten_link": "#/$defs/ShortenLink",
          "suggest_emojis": "#/$defs/SuggestEmojis",
          "suggest_hashtags": "#/$defs/SuggestHashtags"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AutoEmojify"
        },
        {
          "$ref": "#/$defs/SuggestEmojis"
        },
        {
          "$ref": "#/$defs/CreateQuoteImage"
        },
        {
          "$ref": "#/$defs/ListCtas"
        },
        {
          "$ref": "#/$defs/ShortenLink"
        },
        {
          "$ref": "#/$defs/GetTrendingHashtags"
        },
        {
          "$ref": "#/$defs/AutoHashtag"
        },
        {
          "$ref": "#/$defs/SuggestHashtags"
        },
        {
          "$ref": "#/$defs/GetHashtagHistory"
        },
        {
          "$ref": "#/$defs/GetHashtagStats"
        },
        {
          "$ref": "#/$defs/CleanInstagramHashtags"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/RitekitClientIdCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Ritekit Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
