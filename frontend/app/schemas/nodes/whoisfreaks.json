    "GetReverseDnsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_reverse_dns",
          "default": "get_reverse_dns",
          "description": "Reverse DNS Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Reverse DNS Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "value": {
          "description": "IP, CIDR, or record value",
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "type": {
          "enum": [
            "a",
            "mx",
            "cname",
            "ns",
            "aaaa",
            "txt",
            "soa"
          ],
          "title": "Type",
          "type": "string"
        },
        "exact": {
          "default": true,
          "title": "Exact",
          "type": "boolean"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "type"
      ],
      "title": "GetReverseDnsConfig",
      "type": "object"
    },
    "GetReverseWhoisConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_reverse_whois",
          "default": "get_reverse_whois",
          "description": "Reverse WHOIS lookup by keyword. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Reverse WHOIS lookup by keyword",
          "type": "string",
          "ui:hidden": true
        },
        "keyword": {
          "description": "Keyword to search across WHOIS records",
          "minLength": 1,
          "title": "Keyword",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page number",
          "title": "Page"
        }
      },
      "required": [
        "keyword"
      ],
      "title": "GetReverseWhoisConfig",
      "type": "object"
    },
    "GetSslCertificateConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_ssl_certificate",
          "default": "get_ssl_certificate",
          "description": "SSL Certificate Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "SSL Certificate Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "domainName": {
          "minLength": 1,
          "title": "Domain Name",
          "type": "string"
        },
        "chain": {
          "default": false,
          "title": "Chain",
          "type": "boolean"
        },
        "sslRaw": {
          "default": false,
          "title": "Ssl Raw",
          "type": "boolean"
        }
      },
      "required": [
        "domainName"
      ],
      "title": "GetSslCertificateConfig",
      "type": "object"
    },
    "GetSubdomainsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_subdomains",
          "default": "get_subdomains",
          "description": "Subdomains Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Subdomains Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "after": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date",
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date",
          "title": "Before"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "active",
                "inactive"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "active",
            "inactive"
          ],
          "x-enum-searchable": true
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "domain"
      ],
      "title": "GetSubdomainsConfig",
      "type": "object"
    },
    "RotateApiKeyConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "rotate_api_key",
          "default": "rotate_api_key",
          "description": "Generate a secondary API key. WhoisFreaks must first enable rotation for your account. The result contains a secret; store it securely. Does not update your saved NoClick credential.",
          "title": "Rotate API Key",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "RotateApiKeyConfig",
      "type": "object"
    },
    "WhoisfreaksAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "whoisfreaks_api_key",
          "default": "whoisfreaks_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Whoisfreaks API Key",
      "type": "object",
      "x-credential-instructions": "Paste your API key from the WhoisFreaks billing dashboard. Account usage verifies the key without a domain lookup. Lookups consume provider credits; some APIs need a subscription.",
      "x-credential-type": "api_key",
      "x-credential-url": "https://billing.whoisfreaks.com"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "bulk_dns": "#/$defs/BulkDnsConfig",
          "bulk_domain_availability": "#/$defs/BulkDomainAvailabilityConfig",
          "bulk_ip_geolocation": "#/$defs/BulkIpGeolocationConfig",
          "bulk_ip_reputation": "#/$defs/BulkIpReputationConfig",
          "bulk_whois": "#/$defs/BulkWhoisConfig",
          "get_account_usage": "#/$defs/GetAccountUsageConfig",
          "get_asn_whois": "#/$defs/GetAsnWhoisConfig",
          "get_domain_availability": "#/$defs/GetDomainAvailabilityConfig",
          "get_domain_reputation": "#/$defs/GetDomainReputationConfig",
          "get_domain_typos": "#/$defs/GetDomainTyposConfig",
          "get_historical_dns": "#/$defs/GetHistoricalDnsConfig",
          "get_historical_whois": "#/$defs/GetHistoricalWhoisConfig",
          "get_ip_geolocation": "#/$defs/GetIpGeolocationConfig",
          "get_ip_reputation": "#/$defs/GetIpReputationConfig",
          "get_ip_whois": "#/$defs/GetIpWhoisConfig",
          "get_live_dns": "#/$defs/GetLiveDnsConfig",
          "get_live_whois": "#/$defs/GetLiveWhoisConfig",
          "get_reverse_dns": "#/$defs/GetReverseDnsConfig",
          "get_reverse_whois": "#/$defs/GetReverseWhoisConfig",
          "get_ssl_certificate": "#/$defs/GetSslCertificateConfig",
          "get_subdomains": "#/$defs/GetSubdomainsConfig",
          "rotate_api_key": "#/$defs/RotateApiKeyConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetLiveWhoisConfig"
        },
        {
          "$ref": "#/$defs/BulkWhoisConfig"
        },
        {
          "$ref": "#/$defs/GetLiveDnsConfig"
        },
        {
          "$ref": "#/$defs/GetHistoricalDnsConfig"
        },
        {
          "$ref": "#/$defs/GetReverseDnsConfig"
        },
        {
          "$ref": "#/$defs/BulkDnsConfig"
        },
        {
          "$ref": "#/$defs/GetDomainAvailabilityConfig"
        },
        {
          "$ref": "#/$defs/BulkDomainAvailabilityConfig"
        },
        {
          "$ref": "#/$defs/GetDomainTyposConfig"
        },
        {
          "$ref": "#/$defs/GetSslCertificateConfig"
        },
        {
          "$ref": "#/$defs/GetIpGeolocationConfig"
        },
        {
          "$ref": "#/$defs/BulkIpGeolocationConfig"
        },
        {
          "$ref": "#/$defs/GetSubdomainsConfig"
        },
        {
          "$ref": "#/$defs/GetIpReputationConfig"
        },
        {
          "$ref": "#/$defs/BulkIpReputationConfig"
        },
        {
          "$ref": "#/$defs/GetDomainReputationConfig"
        },
        {
          "$ref": "#/$defs/GetAsnWhoisConfig"
        },
        {
          "$ref": "#/$defs/GetIpWhoisConfig"
        },
        {
          "$ref": "#/$defs/RotateApiKeyConfig"
        },
        {
          "$ref": "#/$defs/GetAccountUsageConfig"
        },
        {
          "$ref": "#/$defs/GetHistoricalWhoisConfig"
        },
        {
          "$ref": "#/$defs/GetReverseWhoisConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/WhoisfreaksAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Whoisfreaks Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
