          "title": "IP Geolocation Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "ip": {
          "minLength": 1,
          "title": "Ip",
          "type": "string"
        }
      },
      "required": [
        "ip"
      ],
      "title": "GetIpGeolocationConfig",
