          "title": "Live WHOIS Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "domainName": {
          "minLength": 1,
          "title": "Domain Name",
          "type": "string"
        }
      },
      "required": [
        "domainName"
      ],
      "title": "GetLiveWhoisConfig",
