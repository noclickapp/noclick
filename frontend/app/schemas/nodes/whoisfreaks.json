    },
    "GetIpReputationConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_ip_reputation",
          "default": "get_ip_reputation",
          "description": "IP Reputation Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "IP Reputation Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "ip": {
          "minLength": 1,
          "title": "Ip",
          "type": "string"
        }
      },
      "required": [
        "ip"
      ],
      "title": "GetIpReputationConfig",
      "type": "object"
    },
    "GetIpWhoisConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_ip_whois",
          "default": "get_ip_whois",
          "description": "IP WHOIS Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "IP WHOIS Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "ip": {
          "minLength": 1,
          "title": "Ip",
          "type": "string"
        }
      },
      "required": [
        "ip"
      ],
      "title": "GetIpWhoisConfig",
      "type": "object"
    },
    "GetLiveDnsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_live_dns",
          "default": "get_live_dns",
          "description": "Live DNS Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Live DNS Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "domainName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Name"
        },
        "ipAddress": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use for PTR lookups",
          "title": "Ip Address"
        },
        "type": {
          "default": "all",
          "description": "all or comma-separated: A,MX,NS,TXT,SOA,SPF,AAAA,CNAME",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "GetLiveDnsConfig",
      "type": "object"
    },
    "GetLiveWhoisConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_live_whois",
          "default": "get_live_whois",
