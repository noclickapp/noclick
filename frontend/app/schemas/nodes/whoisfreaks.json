{
  "$defs": {
    "BulkDnsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "bulk_dns",
          "default": "bulk_dns",
          "description": "Bulk DNS Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Bulk DNS Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "type": {
          "default": "all",
          "title": "Type",
          "type": "string"
        },
        "domainNames": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Names"
        },
        "ipAddresses": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ip Addresses"
        }
      },
      "title": "BulkDnsConfig",
      "type": "object"
    },
    "BulkDomainAvailabilityConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "bulk_domain_availability",
          "default": "bulk_domain_availability",
          "description": "Bulk Domain Availability Check. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Bulk Domain Availability Check",
          "type": "string",
          "ui:hidden": true
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for TLD-mode bulk check (base domain).",
          "title": "Domain"
        },
        "domainNames": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mode 1: list of full domain names. Cannot be used with tld.",
          "title": "Domain Names"
        },
        "tld": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mode 2: TLDs to check against the domain query param. Cannot be used with domainNames.",
          "title": "Tld"
        }
      },
      "title": "BulkDomainAvailabilityConfig",
      "type": "object"
    },
    "BulkIpGeolocationConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "bulk_ip_geolocation",
          "default": "bulk_ip_geolocation",
          "description": "Bulk IP Geolocation. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Bulk IP Geolocation",
          "type": "string",
          "ui:hidden": true
        },
        "ips": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Ips",
          "type": "array"
        }
      },
      "required": [
        "ips"
      ],
      "title": "BulkIpGeolocationConfig",
      "type": "object"
    },
    "BulkIpReputationConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "bulk_ip_reputation",
          "default": "bulk_ip_reputation",
          "description": "Bulk IP Reputation. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Bulk IP Reputation",
          "type": "string",
          "ui:hidden": true
        },
        "ips": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Ips",
          "type": "array"
        }
      },
      "required": [
        "ips"
      ],
      "title": "BulkIpReputationConfig",
      "type": "object"
    },
    "BulkWhoisConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "bulk_whois",
          "default": "bulk_whois",
          "description": "Bulk WHOIS Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Bulk WHOIS Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "domainNames": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Domain Names",
          "type": "array"
        }
      },
      "required": [
        "domainNames"
      ],
      "title": "BulkWhoisConfig",
      "type": "object"
    },
    "GetAccountUsageConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_account_usage",
          "default": "get_account_usage",
          "description": "Account Usage. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Account Usage",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetAccountUsageConfig",
      "type": "object"
    },
    "GetAsnWhoisConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_asn_whois",
          "default": "get_asn_whois",
          "description": "ASN WHOIS Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "ASN WHOIS Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "asn": {
          "minLength": 1,
          "title": "Asn",
          "type": "string"
        }
      },
      "required": [
        "asn"
      ],
      "title": "GetAsnWhoisConfig",
      "type": "object"
    },
    "GetDomainAvailabilityConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_domain_availability",
          "default": "get_domain_availability",
          "description": "Domain Availability Check with Suggestions. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Domain Availability Check with Suggestions",
          "type": "string",
          "ui:hidden": true
        },
        "domain": {
          "description": "The domain name to check",
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "sug": {
          "default": false,
          "description": "Whether to return TLD suggestions alongside the queried domain.",
          "title": "Sug",
          "type": "boolean"
        },
        "count": {
          "default": 5,
          "description": "Number of TLD suggestions to return when sug=true. Maximum is 100.",
          "maximum": 100,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "domain"
      ],
      "title": "GetDomainAvailabilityConfig",
      "type": "object"
    },
    "GetDomainReputationConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_domain_reputation",
          "default": "get_domain_reputation",
          "description": "Domain Reputation Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Domain Reputation Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "domainName": {
          "description": "The domain name to assess",
          "minLength": 1,
          "title": "Domain Name",
          "type": "string"
        }
      },
      "required": [
        "domainName"
      ],
      "title": "GetDomainReputationConfig",
      "type": "object"
    },
    "GetDomainTyposConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_domain_typos",
          "default": "get_domain_typos",
          "description": "Typosquatting Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Typosquatting Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "keyword": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keyword"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "pageToken": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Token"
        }
      },
      "title": "GetDomainTyposConfig",
      "type": "object"
    },
    "GetHistoricalDnsConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_historical_dns",
          "default": "get_historical_dns",
          "description": "Historical DNS Lookup. Returns one response; use provider pagination fields for subsequent pages.",
          "title": "Historical DNS Lookup",
          "type": "string",
          "ui:hidden": true
        },
        "domainName": {
          "minLength": 1,
          "title": "Domain Name",
          "type": "string"
        },
        "type": {
          "default": "all",
          "title": "Type",
          "type": "string"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "domainName"
      ],
      "title": "GetHistoricalDnsConfig",
      "type": "object"
    },
    "GetHistoricalWhoisConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_historical_whois",
