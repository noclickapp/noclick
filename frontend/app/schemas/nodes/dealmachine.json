        },
        "assigned_to_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned To User Id"
        }
      },
      "title": "ListTasks",
      "type": "object"
    },
    "RemoveListItems": {
      "additionalProperties": false,
      "properties": {
        "list_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "List Id",
          "type": "string"
        },
        "ids": {
          "items": {
            "description": "Positive decimal record ID; strings preserve large person IDs.",
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "id_type": {
          "default": "internal_property_id",
          "enum": [
            "internal_property_id",
            "internal_person_id"
