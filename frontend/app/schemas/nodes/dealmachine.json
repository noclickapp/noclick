          "default": null,
          "description": "Property field IDs from the provider field catalog.",
          "title": "Fields"
        },
        "result_session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Copy the previous page's result session unchanged.",
          "title": "Result Session Id"
        }
      },
      "required": [
        "zip_code"
      ],
      "title": "SearchProperties",
      "type": "object"
    },
    "UpdateProspect": {
      "additionalProperties": false,
