{
  "$defs": {
    "AddListItems": {
      "additionalProperties": false,
      "properties": {
        "list_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "List Id",
          "type": "string"
        },
        "ids": {
          "items": {
            "description": "Positive decimal record ID; strings preserve large person IDs.",
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "id_type": {
          "default": "internal_property_id",
          "enum": [
            "internal_property_id",
            "internal_person_id"
          ],
          "title": "Id Type",
          "type": "string"
        },
        "operation": {
          "const": "add_list_items",
          "default": "add_list_items",
          "title": "Operation",
          "type": "string"
        },
        "add_as_prospects": {
          "default": true,
          "description": "Also track records as prospects; counts toward prospect allowance.",
          "title": "Add As Prospects",
          "type": "boolean"
        }
      },
      "required": [
        "list_id",
        "ids"
      ],
      "title": "AddListItems",
      "type": "object"
    },
    "AddProspectNote": {
