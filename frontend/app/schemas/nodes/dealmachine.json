        "name"
      ],
      "title": "RenameList",
      "type": "object"
    },
    "SearchProperties": {
      "additionalProperties": false,
      "description": "Search property records within a ZIP code; data credits may apply.",
      "properties": {
        "page": {
          "default": 1,
          "description": "Page to read; each run fetches one page.",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "operation": {
          "const": "search_properties",
          "default": "search_properties",
          "title": "Operation",
          "type": "string"
        },
        "zip_code": {
          "pattern": "^[0-9]{5}$",
          "title": "Zip Code",
          "type": "string"
