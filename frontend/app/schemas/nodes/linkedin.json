        "current_companies": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Company names or LinkedIn company URLs",
          "title": "Current Companies (comma-separated)"
        },
        "locations": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
