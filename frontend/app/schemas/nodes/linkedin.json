  "description": "Full configuration for LinkedIn node including credentials",
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_article_post": "#/$defs/LinkedInCreateArticlePostConfig",
          "create_text_post": "#/$defs/LinkedInCreateTextPostConfig",
          "delete_post": "#/$defs/LinkedInDeletePostConfig",
          "get_authenticated_profile": "#/$defs/LinkedInGetProfileConfig",
          "scrape_company_employees": "#/$defs/LinkedInScrapeCompanyEmployeesConfig",
          "scrape_user_profiles": "#/$defs/LinkedInScrapeProfileConfig",
          "search_companies": "#/$defs/LinkedInSearchCompaniesConfig",
          "search_job_listings": "#/$defs/LinkedInSearchJobsConfig",
          "search_posts": "#/$defs/LinkedInSearchPostsConfig",
          "search_user_profiles": "#/$defs/LinkedInSearchProfilesConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LinkedInGetProfileConfig"
        },
        {
          "$ref": "#/$defs/LinkedInCreateTextPostConfig"
        },
        {
          "$ref": "#/$defs/LinkedInCreateArticlePostConfig"
        },
        {
          "$ref": "#/$defs/LinkedInDeletePostConfig"
        },
        {
          "$ref": "#/$defs/LinkedInScrapeProfileConfig"
        },
        {
          "$ref": "#/$defs/LinkedInSearchCompaniesConfig"
        },
        {
          "$ref": "#/$defs/LinkedInSearchJobsConfig"
        },
        {
          "$ref": "#/$defs/LinkedInSearchProfilesConfig"
        },
        {
          "$ref": "#/$defs/LinkedInScrapeCompanyEmployeesConfig"
        },
        {
          "$ref": "#/$defs/LinkedInSearchPostsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/LinkedInOAuthCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Linkedin Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Post career tip article to feed with custom commentary",
    "Share job opening link on LinkedIn and set to PUBLIC",
    "Get authenticated user profile with name and headline",
    "Post thought leadership article with external link preview",
    "Delete outdated job posting from LinkedIn feed",
    "Share industry news with company mention to CONNECTIONS only"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}