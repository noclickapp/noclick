    "ListEngagements": {
      "additionalProperties": false,
      "description": "List engagements.",
      "properties": {
        "operation": {
          "const": "list_engagements",
          "default": "list_engagements",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "continuation_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Copy the previous page's continuation_key to fetch the next page.",
          "title": "Continuation Key"
        },
        "engagement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated engagement IDs.",
          "title": "Engagement Id"
        },
        "engagement_type": {
          "anyOf": [
            {
              "enum": [
                "meeting",
                "dialer",
                "email",
                "content_viewed",
                "unrecorded_meeting"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engagement Type",
          "enum": [
            "meeting",
            "dialer",
            "email",
            "content_viewed",
            "unrecorded_meeting"
          ],
          "x-enum-searchable": true
        },
        "min_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum engagement date, ISO 8601 date-time.",
          "title": "Min Date"
        },
        "max_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum engagement date, ISO 8601 date-time.",
          "title": "Max Date"
        },
        "participants_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participants Email"
        },
        "team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated owner team IDs.",
          "title": "Team Id"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated owner user IDs.",
          "title": "User Id"
        },
        "with_trackers": {
          "default": false,
          "title": "With Trackers",
          "type": "boolean"
        }
      },
      "title": "ListEngagements",
      "type": "object"
    },
