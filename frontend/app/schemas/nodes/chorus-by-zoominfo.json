        "operation": {
          "const": "delete_engagement",
          "default": "delete_engagement",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "engagement_id": {
          "description": "Exact engagement ID to delete asynchronously.",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
