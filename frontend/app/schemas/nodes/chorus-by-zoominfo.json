          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crm Opportunity Id"
        }
      },
      "required": [
        "data",
        "name",
        "user"
      ],
      "title": "UploadRecording",
      "type": "object"
