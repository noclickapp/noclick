    "UploadRecording": {
      "additionalProperties": false,
      "description": "Upload recording.",
      "properties": {
        "operation": {
          "const": "upload_recording",
          "default": "upload_recording",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "data": {
          "accept": "audio/*,video/*",
          "description": "Recording file: public HTTPS URL or data URI. Formats: 3GPP, AU, AVI, FLV, HLS, MKV, MP3, MP4, Ogg, WAV, WebM.",
          "format": "data-url",
          "title": "Data",
          "type": "string"
        },
        "name": {
          "description": "Recording name.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
