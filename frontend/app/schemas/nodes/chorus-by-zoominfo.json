            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated documented fields, e.g. name,recording.utterances,recording.trackers.",
          "title": "Fields"
        },
        "include_meeting_metadata": {
          "default": false,
          "title": "Include Meeting Metadata",
          "type": "boolean"
