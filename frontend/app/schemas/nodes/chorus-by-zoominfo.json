{
  "$defs": {
    "ChorusAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "chorus_by_zoominfo_api_token",
          "default": "chorus_by_zoominfo_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Chorus API Token",
      "type": "object",
      "x-credential-instructions": "In Chorus Personal Settings, generate a personal API token. Your Chorus role must permit API access. Paste only the token; NoClick sends it in the Authorization header. API access follows your user's data visibility and action permissions.",
      "x-credential-url": "https://chorus.ai/login"
    },
    "CreateMoment": {
      "additionalProperties": false,
      "description": "Create moment.",
      "properties": {
        "operation": {
          "const": "create_moment",
          "default": "create_moment",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "callid": {
          "minLength": 1,
          "title": "Callid",
          "type": "string"
        },
        "moment_time": {
          "description": "Start time in seconds.",
          "minimum": 0,
          "title": "Moment Time",
          "type": "number"
        },
        "moment_duration": {
          "description": "Duration in seconds.",
          "exclusiveMinimum": 0,
          "title": "Moment Duration",
          "type": "number"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "url_string": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url String"
        },
        "expiration_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiration Date"
        }
      },
      "required": [
        "callid",
        "moment_time",
        "moment_duration"
      ],
      "title": "CreateMoment",
      "type": "object"
    },
