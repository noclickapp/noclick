      "properties": {
        "operation": {
          "const": "get_execution_log",
          "default": "get_execution_log",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "execution_id": {
          "description": "Bolna execution id",
          "format": "uuid",
