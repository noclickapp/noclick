  "$defs": {
    "BolnaAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "bolna_api_key",
          "default": "bolna_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Bolna API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the Bolna dashboard and paste it here. NoClick verifies it by reading your Bolna account.",
      "x-credential-url": "https://platform.bolna.ai/"
    },
    "BolnaCreateAgentConfig": {
      "additionalProperties": false,
      "description": "Creates a new agent",
      "properties": {
        "operation": {
          "const": "create_agent",
          "default": "create_agent",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "agent_config": {
          "additionalProperties": true,
          "description": "Configuration from the Bolna agent API",
          "title": "Agent Config",
          "type": "object"
        },
        "agent_prompts": {
          "additionalProperties": true,
          "description": "Configuration from the Bolna agent API",
          "title": "Agent Prompts",
          "type": "object"
        }
      },
      "required": [
        "agent_config",
        "agent_prompts"
      ],
      "title": "BolnaCreateAgentConfig",
      "type": "object"
    },
