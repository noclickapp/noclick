    "ZeffyAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "zeffy_api_key",
          "default": "zeffy_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Zeffy API Key",
      "type": "object",
      "x-credential-instructions": "As the organization owner, open Settings \u2192 Integrations in Zeffy and complete the API key setup. Paste the key here without the Bearer prefix. Writes require the organization to have completed Stripe verification. NoClick checks the key by reading your organization's campaigns.",
      "x-credential-url": "https://www.zeffy.com/o/settings?openIntegrations=true"
    },
