    "ZeffyCreateContactConfig": {
      "additionalProperties": false,
      "description": "Create a contact with email or both names. Existing emails return a conflict.",
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to leave unchanged; null clears on update.",
          "title": "Email"
        },
        "first_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "phone_number": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone Number"
        },
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/ZeffyAddress"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Full mailing address object; null clears the whole address on update."
        },
        "operation": {
          "const": "create_contact",
          "default": "create_contact",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ZeffyCreateContactConfig",
      "type": "object"
    },
    "ZeffyCreatePaymentConfig": {
      "additionalProperties": false,
      "description": "Record an offline payment, without charging a card. Auctions are unsupported.",
      "properties": {
        "operation": {
          "const": "create_payment",
          "default": "create_payment",
          "title": "Operation",
          "type": "string"
        },
        "campaign_id": {
          "minLength": 1,
          "title": "Campaign Id",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Donation in cents. For donation forms only; use tickets for ticketing campaigns.",
          "title": "Amount"
        },
        "tickets": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ZeffyPaymentTicket"
              },
              "maxItems": 1000,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tickets"
        },
        "occurrence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for ticketing campaigns with multiple occurrences.",
          "title": "Occurrence Id"
        },
        "extra_donation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extra cents, for ticketing only.",
          "title": "Extra Donation"
        },
        "payment_method": {
          "default": "cash",
          "enum": [
            "cash",
            "cheque",
            "in_kind",
            "other"
          ],
          "title": "Payment Method",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "first_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "generate_tax_receipt": {
          "default": false,
          "description": "Generate and email a tax receipt.",
          "title": "Generate Tax Receipt",
          "type": "boolean"
        },
        "send_confirmation_email": {
          "default": false,
          "description": "Send the buyer a confirmation email.",
          "title": "Send Confirmation Email",
          "type": "boolean"
        },
        "payment_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO calendar date or datetime, e.g. 2026-01-15. Defaults to now.",
          "title": "Payment Date"
        }
      },
      "required": [
        "campaign_id"
      ],
      "title": "ZeffyCreatePaymentConfig",
      "type": "object"
    },
    "ZeffyDeleteContactConfig": {
