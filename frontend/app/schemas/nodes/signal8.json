{
  "$defs": {
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    },
    "Signal8APIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "signal8_api_key",
          "default": "signal8_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Signal8 API Key",
      "type": "object",
      "x-credential-instructions": "Paste an API key from the Signal8 developer portal. Requests consume Signal8 API credits. The connection read proves key acceptance, not account identity.",
      "x-credential-url": "https://signal8.ai/developer"
    },
    "Signal8GetBatchQuotesConfig": {
      "additionalProperties": false,
      "description": "Batch quote fetch by explicit ticker list.",
      "properties": {
        "operation": {
          "const": "get_batch_quotes",
          "default": "get_batch_quotes",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "tickers": {
          "description": "Up to 500 comma-separated ticker symbols, for example AAPL,MSFT.",
          "maxLength": 2999,
          "minLength": 1,
          "pattern": "^[A-Za-z]{1,5}(?:,[A-Za-z]{1,5}){0,499}$",
          "title": "Tickers",
          "type": "string"
        }
      },
      "required": [
        "tickers"
      ],
      "title": "Signal8GetBatchQuotesConfig",
      "type": "object"
    },
    "Signal8GetCandlesConfig": {
      "additionalProperties": false,
      "description": "Get historical OHLCV candles.",
      "properties": {
        "ticker": {
          "description": "Company ticker, for example AAPL.",
          "maxLength": 5,
          "minLength": 1,
          "pattern": "^[A-Za-z]{1,5}$",
          "title": "Ticker",
          "type": "string"
        },
        "operation": {
          "const": "get_candles",
          "default": "get_candles",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "resolution": {
          "anyOf": [
            {
              "enum": [
                "1",
                "5",
                "15",
                "30",
                "60",
                "240",
                "D",
                "W",
                "M"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Candle resolution: intraday minutes (1, 5, 15, 30, 60, 240), D (daily, default), W (weekly), or M (monthly).",
          "title": "Resolution",
          "enum": [
            "1",
            "5",
            "15",
            "30",
            "60",
            "240",
            "D",
            "W",
            "M"
          ],
          "x-enum-searchable": true
        },
        "period": {
          "anyOf": [
            {
              "enum": [
                "1M",
                "3M",
                "6M",
                "1Y",
                "5Y",
                "ALL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lookback period shorthand (default 1Y). Ignored when from/to are provided.",
          "title": "Period",
          "enum": [
            "1M",
            "3M",
            "6M",
            "1Y",
            "5Y",
            "ALL"
          ],
          "x-enum-searchable": true
        },
        "from": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start of an explicit range as a UNIX timestamp (takes precedence over period).",
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End of an explicit range as a UNIX timestamp (takes precedence over period).",
          "title": "To"
        }
      },
      "required": [
        "ticker"
      ],
      "title": "Signal8GetCandlesConfig",
      "type": "object"
    },
