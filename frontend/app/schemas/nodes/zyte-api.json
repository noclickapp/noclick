    "SubmitHttpPost": {
      "additionalProperties": false,
      "description": "Submit text to a target website with POST and return its HTTP body. This can change the target website.",
      "properties": {
        "url": {
          "description": "Absolute HTTP or HTTPS URL with a domain hostname.",
          "maxLength": 8192,
          "title": "Page URL",
          "type": "string"
        },
        "operation": {
          "const": "submit_http_post",
          "default": "submit_http_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-method-kind": "write"
        },
        "http_request_text": {
          "description": "UTF-8 text sent to the target website as the POST body.",
          "title": "Request Text",
          "type": "string"
        },
        "content_type": {
          "default": "application/json",
          "description": "Content-Type header sent to the target website.",
          "title": "Content Type",
          "type": "string"
        }
      },
      "required": [
        "url",
        "http_request_text"
      ],
      "title": "SubmitHttpPost",
      "type": "object"
    },
    "ZyteApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "zyte_api_key",
          "default": "zyte_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Paste the API key, without a Basic prefix or password.",
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Zyte API Key",
      "type": "object",
      "x-credential-instructions": "Copy your Zyte API key from API Access. Connecting makes one extraction request to example.com and may use API credit.",
      "x-credential-url": "https://app.zyte.com/o/zyte-api/api-access"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/CheckConnection",
          "extract_article": "#/$defs/ExtractArticle",
          "extract_articleList": "#/$defs/ExtractArticlelist",
          "extract_articleNavigation": "#/$defs/ExtractArticlenavigation",
          "extract_forumThread": "#/$defs/ExtractForumthread",
          "extract_jobPosting": "#/$defs/ExtractJobposting",
          "extract_jobPostingNavigation": "#/$defs/ExtractJobpostingnavigation",
          "extract_pageContent": "#/$defs/ExtractPagecontent",
          "extract_product": "#/$defs/ExtractProduct",
          "extract_productList": "#/$defs/ExtractProductlist",
          "extract_productNavigation": "#/$defs/ExtractProductnavigation",
          "extract_serp": "#/$defs/ExtractSerp",
          "get_browser_html": "#/$defs/GetBrowserHtml",
          "get_http_body": "#/$defs/GetHttpBody",
          "get_http_headers": "#/$defs/GetHttpHeaders",
          "get_markdown": "#/$defs/GetMarkdown",
          "get_screenshot": "#/$defs/GetScreenshot",
          "submit_http_post": "#/$defs/SubmitHttpPost"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CheckConnection"
        },
        {
          "$ref": "#/$defs/GetHttpBody"
        },
        {
          "$ref": "#/$defs/GetHttpHeaders"
        },
        {
          "$ref": "#/$defs/GetBrowserHtml"
        },
        {
          "$ref": "#/$defs/GetScreenshot"
        },
        {
          "$ref": "#/$defs/GetMarkdown"
        },
        {
          "$ref": "#/$defs/ExtractArticle"
        },
        {
          "$ref": "#/$defs/ExtractArticlelist"
        },
        {
          "$ref": "#/$defs/ExtractArticlenavigation"
        },
        {
          "$ref": "#/$defs/ExtractForumthread"
        },
        {
          "$ref": "#/$defs/ExtractJobposting"
        },
        {
          "$ref": "#/$defs/ExtractJobpostingnavigation"
        },
        {
          "$ref": "#/$defs/ExtractPagecontent"
        },
        {
          "$ref": "#/$defs/ExtractProduct"
        },
        {
          "$ref": "#/$defs/ExtractProductlist"
        },
        {
          "$ref": "#/$defs/ExtractProductnavigation"
        },
        {
          "$ref": "#/$defs/ExtractSerp"
        },
        {
          "$ref": "#/$defs/SubmitHttpPost"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ZyteApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Zyte-api Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
