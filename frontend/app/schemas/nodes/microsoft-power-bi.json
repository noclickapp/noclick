          "minLength": 1,
          "title": "Table Name",
          "type": "string"
        },
        "rows": {
          "description": "Rows keyed by the existing table's column names",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "workspace_id",
        "dataset_id",
        "table_name",
