          "enum": [
            "all",
            "hour",
            "today",
            "week",
            "month",
            "year"
          ],
          "x-enum-searchable": true
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "all",
                "video",
                "channel",
                "playlist",
                "movie"
              ],
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by content type",
          "title": "Type",
          "enum": [
            "all",
            "video",
            "channel",
            "playlist",
            "movie"
          ],
          "x-enum-searchable": true
