{
  "$defs": {
    "CreateExtractConfig": {
      "additionalProperties": false,
      "description": "Use AI to analyze video content and extract structured data. Provide either a prompt describing what to extract, a JSON Schema for the output format, or both. Supports YouTube, TikTok, Instagram, Twitter/X, and Facebook videos, or a direct video file URL. Videos up to 3 hours (180 minutes) and files up to 2 GB are supported; the whole video is analyzed (1 frame per second up to 80 minutes, a lower evenly-spaced frame rate beyond). Over-limit YouTube and file URLs are rejected with 400 before a job is created. Returns a job ID for asynchronous processing. Use the `/extract/:jobId` endpoint to poll for results.",
      "properties": {
        "operation": {
          "const": "create_extract",
          "default": "create_extract",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "url": {
          "description": "URL to any supported video media. Supports YouTube, TikTok, Instagram, Twitter/X, and Facebook videos, or a direct media file URL.",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Natural language description of what data to extract from the video. Required if schema is not provided. Do not include JSON structure definitions here \u2014 use the \"schema\" field instead.",
          "title": "Prompt"
        },
        "schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON Schema defining the structure of data to extract. Required if prompt is not provided. Checked before the job is created: a schema the AI model cannot use (most often large `maxItems`/`maxLength` bounds) is rejected with `400 invalid-request` explaining what to change. See the schema rules at https://docs.supadata.ai/get-extract#schema-rules.",
          "title": "Schema"
        }
      },
      "required": [
        "url"
      ],
      "title": "CreateExtractConfig",
      "type": "object"
    },
    "CreateTranscriptBatchConfig": {
      "additionalProperties": false,
      "description": "Create a batch job to get transcripts of multiple YouTube videos. Batches created from a playlist or channel include regular videos only (Shorts and live streams are skipped).",
      "properties": {
        "operation": {
          "const": "create_transcript_batch",
          "default": "create_transcript_batch",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "videoIds": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Array of YouTube video IDs or URLs",
          "title": "Videoids"
        },
        "playlistId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YouTube playlist URL or ID. See [supported URL formats](https://docs.supadata.ai/youtube/supported-url-formats).",
          "title": "Playlistid"
        },
        "channelId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YouTube channel URL, handle or ID. See [supported URL formats](https://docs.supadata.ai/youtube/supported-url-formats).",
          "title": "Channelid"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum number of videos to process (when using playlistId or channelId)",
          "title": "Limit"
        },
        "lang": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Preferred language code of the transcript (ISO 639-1). If not provided, the first available language will be returned. If the requested language is unavailable, the API defaults to the first available language. See [Languages](https://docs.supadata.ai/youtube/supported-language-codes).",
          "title": "Lang"
        },
        "text": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, returns plain text transcript.",
          "title": "Text"
        }
      },
      "title": "CreateTranscriptBatchConfig",
      "type": "object"
    },
