    "GetTranscriptConfig": {
      "additionalProperties": false,
      "description": "Get transcript from a supported video platform (YouTube, TikTok, Twitter, Instagram, Facebook) or file URL. If the video is too large to return transcript immediately, request returns a job ID. Use the `/transcript/:jobId` endpoint to get job results.",
      "properties": {
        "operation": {
          "const": "get_transcript",
          "default": "get_transcript",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "url": {
          "description": "Video URL from any supported platform (YouTube, TikTok, Twitter, Instagram, Facebook) or a direct media file URL.",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "lang": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Preferred language code of the transcript (ISO 639-1). If not provided, the first available language will be returned. If the requested language is unavailable, the API defaults to the first available language. See [Languages](https://docs.supadata.ai/youtube/supported-language-codes).",
          "title": "Lang"
        },
        "text": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, returns plain text transcript.",
          "title": "Text"
        },
        "chunkSize": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 50,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum characters per transcript chunk (only when text=false)",
          "title": "Chunksize"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "native",
                "auto",
                "generate"
              ],
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Transcript mode: `native` (only fetch existing transcript), `generate` (always generate transcript using AI), or `auto` (try native, fallback to generate if unavailable). If url is a file URL, mode is always `generate`.",
          "title": "Mode",
          "enum": [
            "native",
            "auto",
            "generate"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "url"
      ],
      "title": "GetTranscriptConfig",
      "type": "object"
    },
