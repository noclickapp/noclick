{
  "$defs": {
    "CreateBasket": {
      "description": "Create a basket and return its generated management token. Save that token.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "New basket name",
          "type": "string"
        },
        "forward_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Forward incoming requests to this URL; an empty string disables forwarding.",
          "title": "Forward Url"
        },
        "disable_forwarding": {
          "default": false,
          "description": "Clear the forwarding URL. Overrides Forward URL when enabled.",
          "title": "Disable Forwarding",
          "type": "boolean"
        },
        "proxy_response": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return the forwarding destination's response to the original caller.",
          "title": "Proxy Response"
        },
        "insecure_tls": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Disable certificate verification for forwarding. Enabling this has security implications.",
          "title": "Insecure Tls"
        },
        "expand_path": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Append the incoming request path to the forwarding URL.",
          "title": "Expand Path"
        },
        "capacity": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum requests to retain; the service enforces its configured maximum.",
          "title": "Capacity"
        },
        "operation": {
          "const": "create_basket",
          "default": "create_basket",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateBasket",
      "type": "object"
    },
    "DeleteBasket": {
      "description": "Permanently delete a basket and all its collected requests.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave empty to use the basket in your connection.",
          "title": "Basket name"
        },
        "operation": {
          "const": "delete_basket",
          "default": "delete_basket",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "DeleteBasket",
      "type": "object"
    },
    "DeleteRequests": {
      "description": "Delete all requests collected by a basket, keeping the basket itself.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave empty to use the basket in your connection.",
          "title": "Basket name"
        },
        "operation": {
          "const": "delete_requests",
          "default": "delete_requests",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "DeleteRequests",
      "type": "object"
    },
    "GetBasket": {
      "description": "Read protected basket configuration; also verifies the connection.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave empty to use the basket in your connection.",
          "title": "Basket name"
        },
        "operation": {
          "const": "get_basket",
          "default": "get_basket",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetBasket",
      "type": "object"
    },
    "GetResponse": {
      "description": "Read the response configured for an incoming HTTP method.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave empty to use the basket in your connection.",
          "title": "Basket name"
        },
        "operation": {
          "const": "get_response",
          "default": "get_response",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "method": {
          "default": "GET",
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "CONNECT",
            "OPTIONS",
            "TRACE"
          ],
          "title": "Incoming request method",
          "type": "string"
        }
      },
      "title": "GetResponse",
      "type": "object"
    },
    "GetStatistics": {
      "description": "Read basket and request statistics (requires a master token).",
      "properties": {
        "operation": {
          "const": "get_statistics",
          "default": "get_statistics",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "max": {
          "default": 5,
          "maximum": 1000,
          "minimum": 1,
          "title": "Maximum top baskets",
          "type": "integer"
        }
      },
      "title": "GetStatistics",
      "type": "object"
    },
    "GetVersion": {
      "description": "Read the service version and source commit.",
      "properties": {
        "operation": {
          "const": "get_version",
          "default": "get_version",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetVersion",
      "type": "object"
    },
    "ListBaskets": {
      "description": "List one page of basket names (requires a master token).",
      "properties": {
        "operation": {
          "const": "list_baskets",
          "default": "list_baskets",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "max": {
          "default": 20,
          "maximum": 1000,
          "minimum": 1,
          "title": "Page size",
          "type": "integer"
        },
        "skip": {
          "default": 0,
          "minimum": 0,
          "title": "Skip",
          "type": "integer"
        },
        "q": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search"
        }
      },
      "title": "ListBaskets",
      "type": "object"
    },
    "ListRequests": {
      "description": "Read one page of collected requests, optionally searching body, query or headers.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave empty to use the basket in your connection.",
          "title": "Basket name"
        },
        "operation": {
          "const": "list_requests",
          "default": "list_requests",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "max": {
          "default": 20,
          "maximum": 1000,
          "minimum": 1,
          "title": "Page size",
          "type": "integer"
        },
        "skip": {
          "default": 0,
          "minimum": 0,
          "title": "Skip",
          "type": "integer"
        },
        "q": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search"
        },
        "search_in": {
          "default": "any",
          "enum": [
            "any",
            "body",
            "query",
            "headers"
          ],
          "title": "Search in",
          "type": "string"
        }
      },
      "title": "ListRequests",
      "type": "object"
    },
    "RBasketsTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "rbaskets_token",
          "default": "rbaskets_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "token": {
          "minLength": 1,
          "title": "Token",
          "type": "string",
          "ui:widget": "password"
        },
        "basket_name": {
          "minLength": 1,
          "title": "Basket name",
          "type": "string"
        }
      },
      "required": [
        "token",
        "basket_name"
      ],
      "title": "Request Baskets Token",
      "type": "object",
      "x-credential-instructions": "Paste the token shown when you created your basket and its basket name. NoClick reads that basket's protected settings to check the token. Service statistics and listing baskets require a service master token; basket tokens authorize only their own basket. This integration connects to rbaskets.in.",
      "x-credential-url": "https://rbaskets.in"
    },
    "UpdateBasket": {
      "description": "Update basket capacity and request forwarding settings.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave empty to use the basket in your connection.",
          "title": "Basket name"
        },
        "forward_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Forward incoming requests to this URL; an empty string disables forwarding.",
          "title": "Forward Url"
        },
        "disable_forwarding": {
          "default": false,
          "description": "Clear the forwarding URL. Overrides Forward URL when enabled.",
          "title": "Disable Forwarding",
          "type": "boolean"
        },
        "proxy_response": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return the forwarding destination's response to the original caller.",
          "title": "Proxy Response"
        },
        "insecure_tls": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Disable certificate verification for forwarding. Enabling this has security implications.",
          "title": "Insecure Tls"
        },
        "expand_path": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Append the incoming request path to the forwarding URL.",
          "title": "Expand Path"
        },
        "capacity": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum requests to retain; the service enforces its configured maximum.",
          "title": "Capacity"
        },
        "operation": {
          "const": "update_basket",
          "default": "update_basket",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "UpdateBasket",
      "type": "object"
    },
    "UpdateResponse": {
      "description": "Configure the response returned to requests with the selected HTTP method.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave empty to use the basket in your connection.",
          "title": "Basket name"
        },
        "operation": {
          "const": "update_response",
          "default": "update_response",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "method": {
          "default": "GET",
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "CONNECT",
            "OPTIONS",
            "TRACE"
          ],
          "title": "Incoming request method",
          "type": "string"
        },
        "response_status": {
          "default": 200,
          "maximum": 599,
          "minimum": 100,
          "title": "Response status",
          "type": "integer"
        },
        "response_body": {
          "default": "",
          "title": "Response body",
          "type": "string"
        },
        "headers_json": {
          "default": "{}",
          "description": "JSON object mapping header names to arrays of strings, e.g. {\"Content-Type\":[\"application/json\"]}.",
          "title": "Response headers",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "is_template": {
          "default": false,
          "description": "Interpret the response body as a Go HTML template.",
          "title": "Is Template",
          "type": "boolean"
        }
      },
      "title": "UpdateResponse",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_basket": "#/$defs/CreateBasket",
          "delete_basket": "#/$defs/DeleteBasket",
          "delete_requests": "#/$defs/DeleteRequests",
          "get_basket": "#/$defs/GetBasket",
          "get_response": "#/$defs/GetResponse",
          "get_statistics": "#/$defs/GetStatistics",
          "get_version": "#/$defs/GetVersion",
          "list_baskets": "#/$defs/ListBaskets",
          "list_requests": "#/$defs/ListRequests",
          "update_basket": "#/$defs/UpdateBasket",
          "update_response": "#/$defs/UpdateResponse"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetVersion"
        },
        {
          "$ref": "#/$defs/GetStatistics"
        },
        {
          "$ref": "#/$defs/ListBaskets"
        },
        {
          "$ref": "#/$defs/CreateBasket"
        },
        {
          "$ref": "#/$defs/GetBasket"
        },
        {
          "$ref": "#/$defs/UpdateBasket"
        },
        {
          "$ref": "#/$defs/DeleteBasket"
        },
        {
          "$ref": "#/$defs/GetResponse"
        },
        {
          "$ref": "#/$defs/UpdateResponse"
        },
        {
          "$ref": "#/$defs/ListRequests"
        },
        {
          "$ref": "#/$defs/DeleteRequests"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/RBasketsTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Rbaskets Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
