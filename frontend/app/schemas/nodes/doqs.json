{
  "$defs": {
    "DoqsAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "doqs_api_key",
          "default": "doqs_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Doqs API Key",
      "type": "object",
      "x-credential-instructions": "Paste an API key from your Doqs dashboard. NoClick reads your templates to check the connection. A development key watermarks filled PDFs; HTML rendering requires a live key.",
      "x-credential-url": "https://app.doqs.dev"
    },
    "DoqsFillTemplateConfig": {
      "properties": {
        "operation": {
          "const": "fill_template",
          "default": "fill_template",
          "title": "Fill PDF Template",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Fill PDF Template",
          "x-is-trigger": false
        },
        "template_id": {
          "minLength": 1,
          "title": "Template",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "template_id",
            "placeholder": "Choose a template",
            "searchable": false,
            "auto_select_sole_option": true
          }
        },
        "data": {
          "default": "{}",
          "description": "JSON object mapping the template's field names to values.",
          "title": "Template Data",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "template_id"
      ],
      "title": "DoqsFillTemplateConfig",
      "type": "object"
    },
    "DoqsListSubmissionsConfig": {
      "properties": {
        "limit": {
          "default": 100,
          "description": "Maximum results in this page.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of results to skip. Increase by the page size to read the next page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_submissions",
          "default": "list_submissions",
          "title": "List Submissions",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "List Submissions",
          "x-is-trigger": false
        }
      },
      "title": "DoqsListSubmissionsConfig",
      "type": "object"
    },
    "DoqsListTemplatesConfig": {
      "properties": {
        "limit": {
          "default": 100,
          "description": "Maximum results in this page.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of results to skip. Increase by the page size to read the next page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_templates",
          "default": "list_templates",
          "title": "List Templates",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "List Templates",
          "x-is-trigger": false
        }
      },
      "title": "DoqsListTemplatesConfig",
      "type": "object"
    },
    "DoqsRenderPDFConfig": {
      "properties": {
        "operation": {
          "const": "render_pdf",
          "default": "render_pdf",
          "title": "Render HTML to PDF",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Render HTML to PDF",
          "x-is-trigger": false
        },
        "template_html": {
          "minLength": 1,
          "title": "HTML Template",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "html"
        },
        "header_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set a top margin to leave space for the header.",
          "title": "Header HTML"
        },
        "footer_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set a bottom margin to leave space for the footer.",
          "title": "Footer HTML"
        },
        "format": {
          "default": "a4",
          "enum": [
            "a0",
            "a1",
            "a2",
            "a3",
            "a4",
            "a5",
            "a6"
          ],
          "title": "Paper Size",
          "type": "string"
        },
        "orientation": {
          "default": "portrait",
          "enum": [
            "landscape",
            "portrait"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "scale": {
          "default": 1,
          "maximum": 2,
          "minimum": 0.1,
          "title": "Scale",
          "type": "number"
        },
        "margin_top": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CSS length, for example 10mm.",
          "title": "Margin Top"
        },
        "margin_bottom": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CSS length, for example 10mm.",
          "title": "Margin Bottom"
        },
        "margin_left": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CSS length, for example 10mm.",
          "title": "Margin Left"
        },
        "margin_right": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CSS length, for example 10mm.",
          "title": "Margin Right"
        },
        "presigned_upload_url": {
          "anyOf": [
            {
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Presigned HTTPS upload URL. Doqs uploads the PDF to this destination; requires a paid plan.",
          "title": "Presigned Upload Url"
        },
        "presigned_upload_method": {
          "default": "PUT",
          "enum": [
            "PUT",
            "POST"
          ],
          "title": "Upload Method",
          "type": "string"
        }
      },
      "required": [
        "template_html"
      ],
      "title": "DoqsRenderPDFConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "fill_template": "#/$defs/DoqsFillTemplateConfig",
          "list_submissions": "#/$defs/DoqsListSubmissionsConfig",
          "list_templates": "#/$defs/DoqsListTemplatesConfig",
          "render_pdf": "#/$defs/DoqsRenderPDFConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DoqsListTemplatesConfig"
        },
        {
          "$ref": "#/$defs/DoqsFillTemplateConfig"
        },
        {
          "$ref": "#/$defs/DoqsRenderPDFConfig"
        },
        {
          "$ref": "#/$defs/DoqsListSubmissionsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/DoqsAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Doqs Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
