    "SAPConcurOAuthCredential": {
      "properties": {
        "credential_type": {
          "const": "sap_concur_oauth",
          "default": "sap_concur_oauth",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "geolocation": {
          "enum": [
            "https://apj1.api.concursolutions.com",
            "https://eu2.api.concursolutions.com",
            "https://us2.api.concursolutions.com",
            "https://usg.api.concursolutions.com",
            "https://glz.api.concursolutions.com"
          ],
          "title": "Geolocation",
          "type": "string"
        },
        "access_token": {
          "title": "Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:widget": "password"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:widget": "password"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Issued access-token expiry as ISO 8601 with timezone; required when refresh is configured",
          "title": "Expires At"
        },
        "scope": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actual granted scope string, if known; this field grants no permissions",
          "title": "Scope"
        },
        "token_type": {
          "const": "Bearer",
          "default": "Bearer",
          "title": "Token Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "geolocation",
        "access_token"
      ],
      "title": "SAP Concur OAuth Tokens",
      "type": "object",
      "x-credential-instructions": "Use existing issued OAuth tokens and their exact current server geolocation. Optional refresh requires the same application's client ID/secret and expiry. No login or initial token mint is performed.",
      "x-credential-url": "https://developer.concur.com/api-reference/authentication/apidoc.html"
    },
