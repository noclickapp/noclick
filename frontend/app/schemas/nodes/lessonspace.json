    "LessonspaceListSessionsConfig": {
      "additionalProperties": false,
      "description": "Fetch the sessions for an organisation.",
      "properties": {
        "operation": {
          "const": "list_sessions",
          "default": "list_sessions",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
