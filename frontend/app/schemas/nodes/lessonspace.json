    "LessonspaceLaunchSpaceConfig": {
      "additionalProperties": false,
      "description": "Create Unified Space",
      "properties": {
        "operation": {
          "const": "launch_space",
          "default": "launch_space",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "External space identifier. Reuse the same ID to join the same space.",
