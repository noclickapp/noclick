{
  "$defs": {
    "LessonspaceAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "lessonspace_api_key",
          "default": "lessonspace_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Lessonspace API Key",
      "type": "object",
      "x-credential-instructions": "Generate an API key in your Lessonspace organisation dashboard's developer settings. Paste only the key, without the Organisation prefix. NoClick checks it by reading your organisation's users.",
      "x-credential-url": "https://www.thelessonspace.com/docs/overview/authentication"
    },
    "LessonspaceDeleteSessionRecordingsConfig": {
      "additionalProperties": false,
      "description": "Irreversible: Delete all recording data associated with a specific session, including AV, events and transcriptions.\n\nThis cannot be undone. If the space stores recordings in a customer-owned (custom) bucket, the request is rejected and nothing is deleted unless `force_delete_custom_buckets` is set. Basic session metadata such as name and participants is retained and stays visible in the sessions list. Related spaces are not affected by this deletion and can continue to be used for new sessions.",
      "properties": {
        "operation": {
          "const": "delete_session_recordings",
          "default": "delete_session_recordings",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "session": {
          "description": "The UUID identifying this session",
          "format": "uuid",
          "title": "Session",
          "type": "string"
        },
        "force_delete_custom_buckets": {
          "default": false,
          "description": "Also permanently delete recordings in a customer-owned bucket.",
          "title": "Force Delete Custom Buckets",
          "type": "boolean"
        }
      },
      "required": [
        "session"
      ],
      "title": "LessonspaceDeleteSessionRecordingsConfig",
      "type": "object"
    },
    "LessonspaceDeleteSpaceRecordingsConfig": {
      "additionalProperties": false,
      "description": "Irreversible: Delete all recording data for every session that has happened inside a space, including AV, events and transcriptions. The space itself is not deleted and remains usable.\n\nThis cannot be undone. If the space stores recordings in a customer-owned (custom) bucket, the request is rejected and nothing is deleted unless `force_delete_custom_buckets` is set. Basic session metadata such as name and participants is retained and stays visible in the sessions list. Related spaces are not affected by this deletion and can continue to be used for new sessions.",
      "properties": {
        "operation": {
          "const": "delete_space_recordings",
          "default": "delete_space_recordings",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "space": {
          "description": "The UUID identifying this space",
          "format": "uuid",
          "title": "Space",
          "type": "string"
        },
        "force_delete_custom_buckets": {
          "default": false,
          "description": "Also permanently delete recordings in a customer-owned bucket.",
          "title": "Force Delete Custom Buckets",
          "type": "boolean"
        }
      },
      "required": [
        "space"
      ],
      "title": "LessonspaceDeleteSpaceRecordingsConfig",
      "type": "object"
    },
    "LessonspaceDeleteUserConfig": {
      "additionalProperties": false,
      "description": "Irreversible: Delete User from Organisation",
      "properties": {
        "operation": {
          "const": "delete_user",
          "default": "delete_user",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "user_id": {
          "description": "The ID identifying this user",
          "minimum": 1,
          "title": "User Id",
          "type": "integer"
        }
      },
      "required": [
        "user_id"
      ],
      "title": "LessonspaceDeleteUserConfig",
      "type": "object"
    },
