          "default": null,
          "description": "A page number within the paginated result set.",
          "title": "Page"
        },
        "include_single_user": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Include sessions with only one user.",
          "title": "Include Single User"
