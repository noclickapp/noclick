        "start_time_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter to sessions that started after the specified ISO8601 timestamp.",
          "title": "Start Time After"
