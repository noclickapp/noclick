          "title": "Brand",
          "type": "string",
          "x-dynamic-options": {
            "field_name": "blog_id",
            "auto_select_sole_option": true
          }
        },
        "start": {
          "description": "Local ISO time, e.g.2026-10-01T00:00:00; the selected timezone applies.",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "description": "Later than Start, at most31 days; no automatic unbounded pagination.",
          "title": "End",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        },
        "post_id": {
          "description": "Must appear in List Scheduler Posts for this exact brand and date window before direct lookup.",
          "title": "Post ID",
          "type": "string"
        },
        "operation": {
          "const": "delete_draft",
          "default": "delete_draft",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Drafts",
          "x-display-name": "Delete Unpublished Draft",
          "x-is-trigger": false
        }
      },
      "required": [
        "blog_id",
        "start",
        "end",
        "post_id"
      ],
      "title": "MetricoolDeleteDraft",
      "type": "object"
    },
