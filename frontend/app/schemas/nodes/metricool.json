{
  "$defs": {
    "MetricoolAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "metricool_api_key",
          "default": "metricool_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        },
        "user_id": {
          "description": "Your supplied account userId; it is never inferred from a shared brand's owner.",
          "title": "Metricool User ID",
          "type": "string"
        },
        "blog_id": {
          "description": "Existing accessible brand used for connection validation and the brand list. Other selected brands require a current list witness.",
          "title": "Default Brand ID",
          "type": "string"
        }
      },
      "required": [
        "api_token",
        "user_id",
        "blog_id"
      ],
      "title": "Metricool API Token",
      "type": "object",
      "x-credential-instructions": "Supply an existing API token and the userId/blogId from your Metricool account. Current authentication uses X-Mc-Auth, not Authorization. API access is documented for Advanced and Custom plans; your actual entitlement is unverified. No login, mint, refresh or token introspection is performed.",
      "x-credential-url": "https://help.metricool.com/basic-guide-for-api-integration-r97af"
    },
    "MetricoolCreateDraft": {
      "additionalProperties": false,
      "properties": {
        "blog_id": {
          "title": "Brand",
          "type": "string",
          "x-dynamic-options": {
            "field_name": "blog_id",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "create_draft",
          "default": "create_draft",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Drafts",
          "x-display-name": "Create Unpublished Facebook Draft",
          "x-is-trigger": false
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Draft Text",
          "type": "string"
        },
        "planning_time": {
          "description": "Required provider publicationDate metadata; draft is always true, so this does not schedule the post. Use a future local ISO time.",
          "title": "Draft Planning Time",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "blog_id",
        "text",
        "planning_time"
      ],
      "title": "MetricoolCreateDraft",
      "type": "object"
    },
    "MetricoolDeleteDraft": {
      "additionalProperties": false,
