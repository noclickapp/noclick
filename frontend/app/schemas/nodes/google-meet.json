    "GoogleMeetOAuthCredential": {
      "description": "OAuth credential for Google Meet access.\nTokens are obtained via the Google OAuth flow, not entered manually.",
      "properties": {
        "credential_type": {
          "const": "google_meet_oauth",
          "default": "google_meet_oauth",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "description": "OAuth 2.0 access token from Google",
          "title": "Access Token",
          "type": "string"
        },
        "refresh_token": {
          "description": "OAuth 2.0 refresh token for automatic renewal",
          "title": "Refresh Token",
          "type": "string"
        },
        "expires_at": {
          "description": "ISO 8601 timestamp when the access token expires",
          "title": "Token Expiry",
          "type": "string"
        },
        "email": {
          "description": "Email address of the connected Google account",
          "title": "Google Account",
          "type": "string"
        }
      },
      "required": [
        "access_token",
        "refresh_token",
        "expires_at",
        "email"
      ],
      "title": "GoogleMeetOAuthCredential",
      "type": "object",
      "x-credential-type": "oauth",
      "x-credential-url": "https://console.cloud.google.com/apis/credentials",
      "x-oauth-provider": "google",
      "x-oauth-scopes": [
        "https://www.googleapis.com/auth/meetings.space.created",
        "https://www.googleapis.com/auth/meetings.space.readonly",
        "https://www.googleapis.com/auth/meetings.space.settings"
      ]
    },
    "GoogleMeetOnNewConferenceRecordConfig": {
      "description": "Trigger: polls conferenceRecords.list on a schedule and fires for newly\nended meetings. Google Meet has no push webhooks, so this baselines on the\nfirst poll and then emits each new conference record exactly once,\ndeduplicating on the record's resource name.",
