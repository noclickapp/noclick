          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Who can join without knocking",
          "enum": [
            "",
            "OPEN",
            "TRUSTED",
            "RESTRICTED"
          ],
          "enumNames": [
            "Default",
            "Open (anyone with the link)",
            "Trusted (same org)",
            "Restricted (invited only)"
          ],
          "title": "Access Type",
