    "VagaroIssuedClientTokenCredential": {
      "additionalProperties": false,
      "properties": {
        "credential_type": {
          "const": "vagaro_issued_client_token",
          "default": "vagaro_issued_client_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "description": "Token already issued by your Vagaro Developer Settings client credentials. Sent in the accessToken header, without a Bearer prefix. Client IDs/secrets and token minting are not collected by this node.",
          "title": "Issued Client Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "region": {
          "description": "Use the region from your account subdomain, for example us04. The docs do not publish an exhaustive region enumeration; the fixed API host cannot be changed.",
          "title": "Exact Account Region",
          "type": "string"
        },
        "expires_at": {
          "description": "ISO date-time with timezone from actual issuance; the documented expires_in example is 3600 seconds. Replace the saved token when expired; no automatic renewal or replay.",
          "title": "Actual Token Expiry",
          "type": "string"
        },
        "granted_scopes": {
          "description": "Exact comma-separated scope values requested when issuing this token, represented here as a list. Local declared metadata is checked, while provider authorization remains authoritative. Updates additionally need write access or write employee as documented.",
          "items": {
            "enum": [
              "read access",
              "write access",
              "write employee"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Declared Issued Scopes",
          "type": "array"
        }
      },
      "required": [
        "access_token",
        "region",
        "expires_at"
      ],
      "title": "Vagaro Issued Client Token",
      "type": "object",
      "x-credential-url": "https://docs.vagaro.com/public/reference/generate-access-token"
    }
