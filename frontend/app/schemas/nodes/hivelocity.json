{
  "$defs": {
    "HivelocityAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "hivelocity_api_key",
          "default": "hivelocity_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "Existing API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "reference_device_id": {
          "description": "Native safe integer bound, not a documented provider maximum.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Independently Known Accessible Device ID",
          "type": "integer"
        }
      },
      "required": [
        "api_key",
        "reference_device_id"
      ],
      "title": "Hivelocity API Key",
      "type": "object",
      "x-credential-instructions": "Supply an existing X-API-KEY and independently known accessible device ID. Fixed core.hivelocity.net/api/v2. Catalog plus detail establish protected resource reachability, never client/account/principal ownership. No key issue/OAuth/refresh. Entitlement and permissions unknown.",
      "x-credential-url": "https://developers.hivelocity.net/reference/introduction"
    },
    "HivelocityDeviceConfig": {
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to the documented name scalar. Hostname, IP, apps, config, credentials, billing and URLs remain omitted.",
          "title": "Include Custom Device Names",
          "type": "boolean"
        },
        "operation": {
          "const": "get_device",
          "default": "get_device",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Device Metadata",
          "x-display-name": "Get Selected Device Metadata",
          "x-is-trigger": false
        },
        "device_id": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Device in Current Protected Catalog",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "device_id",
            "auto_select_sole_option": true
          },
          "x-resource-type": "device_id"
        }
      },
      "required": [
        "device_id"
      ],
      "title": "HivelocityDeviceConfig",
      "type": "object"
    },
    "HivelocityDevicesConfig": {
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to the documented name scalar. Hostname, IP, apps, config, credentials, billing and URLs remain omitted.",
          "title": "Include Custom Device Names",
          "type": "boolean"
        },
        "operation": {
          "const": "list_devices",
          "default": "list_devices",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Device Metadata",
          "x-display-name": "Read Protected Device Catalog Metadata",
          "x-is-trigger": false
        }
      },
      "title": "HivelocityDevicesConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_device": "#/$defs/HivelocityDeviceConfig",
          "list_devices": "#/$defs/HivelocityDevicesConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HivelocityDevicesConfig"
        },
        {
          "$ref": "#/$defs/HivelocityDeviceConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/HivelocityAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Hivelocity Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Read Hivelocity device provisioning status and monitor counts",
    "Get metadata only for a device in my current catalog",
    "Opt in to custom device names"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
