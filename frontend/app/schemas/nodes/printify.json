    "PrintifyOAuthAccessTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "printify_oauth_access_token",
          "default": "printify_oauth_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "brand": {
          "default": "printify",
          "enum": [
            "printify",
            "printful_enterprise"
          ],
          "title": "API brand",
          "type": "string"
        },
        "access_token": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "OAuth Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "expires_at": {
          "description": "Actual expiry returned by the approved platform's token exchange, with timezone. Access tokens expire after six hours; replace the token when expired.",
          "maxLength": 128,
          "title": "Token expiry",
          "type": "string"
        }
      },
      "required": [
        "access_token",
        "expires_at"
      ],
      "title": "PrintifyOAuthAccessTokenCredential",
      "type": "object",
      "x-credential-instructions": "Supply a current access token from your vendor-approved platform app. This connection does not register a platform app, authorize a merchant or refresh a token. Do not paste a refresh token or app ID as the access token. Requested scopes are distinct from actual grants.",
      "x-credential-url": "https://developers.printify.com/#oauth-2-0"
    },
    "PrintifyPATCredential": {
      "properties": {
        "credential_type": {
          "const": "printify_pat",
          "default": "printify_pat",
          "title": "Credential Type",
