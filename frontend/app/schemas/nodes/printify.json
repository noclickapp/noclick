        "brand": {
          "default": "printify",
          "description": "Printful Enterprise uses this shared API; traditional Printful credentials use a different integration.",
          "enum": [
            "printify",
            "printful_enterprise"
          ],
          "title": "API brand",
          "type": "string"
        },
        "personal_access_token": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Personal Access Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "personal_access_token"
      ],
      "title": "PrintifyPATCredential",
      "type": "object",
      "x-credential-instructions": "Generate a personal token in Profile \u2192 Connections. Select shops.read and the catalog/product scopes needed by your operations. Personal tokens expire after one year. Token contents and actual granted scopes are not inferred.",
      "x-credential-url": "https://developers.printify.com/#create-a-personal-access-token"
    },
