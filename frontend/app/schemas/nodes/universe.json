{
  "$defs": {
    "AccessKey": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_access_key",
          "default": "create_access_key",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "key": {
          "description": "User-facing access code.",
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "rate_ids": {
          "description": "Ticket type IDs unlocked by the code.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Rate Ids",
          "type": "array"
        },
        "quantity": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Redemption limit; serialized as a string per the REST contract.",
          "title": "Quantity"
        }
      },
      "required": [
        "key",
        "listing_id",
        "rate_ids"
      ],
      "title": "AccessKey",
      "type": "object"
    },
    "CheckIn": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "check_in",
          "default": "check_in",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "cost_item_id": {
          "description": "Guestlist ticket ID. Sends the same ID in the URL and cost_item_id query parameter.",
          "minLength": 1,
          "title": "Cost Item Id",
          "type": "string"
        }
      },
      "required": [
        "cost_item_id"
      ],
      "title": "CheckIn",
      "type": "object"
    },
    "CurrentUser": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_current_user",
          "default": "get_current_user",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "CurrentUser",
      "type": "object"
    },
    "EventGuestlist": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_event_guestlist",
          "default": "list_event_guestlist",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "since": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 timestamp: include tickets created or updated after this time.",
          "title": "Since"
        },
        "listing_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional listing filter.",
          "title": "Listing Id"
        },
        "event_id": {
          "description": "Restrict this page to one event.",
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "EventGuestlist",
      "type": "object"
    },
    "FixedDiscount": {
      "additionalProperties": false,
      "properties": {
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "rate_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Ids"
        },
        "operation": {
          "const": "create_fixed_discount",
          "default": "create_fixed_discount",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "fixed": {
          "description": "Discount amount in dollars.",
          "minimum": 0,
          "title": "Fixed",
          "type": "number"
        }
      },
      "required": [
        "listing_id",
        "code",
        "fixed"
      ],
      "title": "FixedDiscount",
      "type": "object"
    },
    "Guestlists": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_guestlists",
          "default": "list_guestlists",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "since": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 timestamp: include tickets created or updated after this time.",
          "title": "Since"
        },
        "listing_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional listing filter.",
          "title": "Listing Id"
        }
      },
      "title": "Guestlists",
      "type": "object"
    },
    "Listings": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_listings",
          "default": "list_listings",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "user_id": {
          "description": "User ID returned by Get current user.",
          "minLength": 1,
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id"
      ],
      "title": "Listings",
      "type": "object"
    },
    "PercentDiscount": {
      "additionalProperties": false,
      "properties": {
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "rate_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Ids"
        },
        "operation": {
          "const": "create_percent_discount",
          "default": "create_percent_discount",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "percent": {
          "description": "Fraction from 0 to 1, for example 0.2 for 20%.",
          "maximum": 1,
          "minimum": 0,
          "title": "Percent",
          "type": "number"
        }
      },
      "required": [
        "listing_id",
        "code",
        "percent"
      ],
      "title": "PercentDiscount",
      "type": "object"
    },
    "Rate": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_rate",
          "default": "create_rate",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "name": {
          "description": "Unique ticket type display name.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "price": {
          "description": "Price in dollars.",
          "minimum": 0,
          "title": "Price",
          "type": "number"
        },
        "state": {
          "default": "active",
          "enum": [
            "locked",
            "active",
            "inactive"
          ],
          "title": "State",
          "type": "string"
        },
        "capacity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity"
        },
        "min_tickets": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Tickets"
        },
        "max_tickets": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tickets"
        },
        "discountable": {
          "default": true,
          "title": "Discountable",
          "type": "boolean"
        }
      },
      "required": [
        "listing_id",
        "name",
        "price"
      ],
      "title": "Rate",
      "type": "object"
    },
    "TokenInfo": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_token_info",
          "default": "get_token_info",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "TokenInfo",
      "type": "object"
    },
    "UniverseOAuthCredential": {
      "properties": {
        "credential_type": {
          "const": "universe_oauth",
          "default": "universe_oauth",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "minLength": 1,
          "title": "Access token",
          "type": "string",
          "ui:widget": "password"
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh token",
          "ui:widget": "password"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 expiry timestamp, if known.",
          "title": "Token expiry"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Granted scopes"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "Universe OAuth",
      "type": "object",
      "x-credential-instructions": "Connect Universe, or paste an existing OAuth access token obtained through Universe's documented client credentials or authorization code flow. Optional refresh token and expiry enable renewal using the configured Universe OAuth application. An access token alone works until it expires.",
      "x-credential-type": "oauth",
      "x-credential-url": "https://www.universe.com/oauth/applications",
      "x-oauth-provider": "universe",
      "x-oauth-scopes": [
        "public"
      ]
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_in": "#/$defs/CheckIn",
          "create_access_key": "#/$defs/AccessKey",
          "create_fixed_discount": "#/$defs/FixedDiscount",
          "create_percent_discount": "#/$defs/PercentDiscount",
          "create_rate": "#/$defs/Rate",
          "get_current_user": "#/$defs/CurrentUser",
          "get_token_info": "#/$defs/TokenInfo",
          "list_event_guestlist": "#/$defs/EventGuestlist",
          "list_guestlists": "#/$defs/Guestlists",
          "list_listings": "#/$defs/Listings"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CurrentUser"
        },
        {
          "$ref": "#/$defs/TokenInfo"
        },
        {
          "$ref": "#/$defs/Listings"
        },
        {
          "$ref": "#/$defs/Guestlists"
        },
        {
          "$ref": "#/$defs/EventGuestlist"
        },
        {
          "$ref": "#/$defs/CheckIn"
        },
        {
          "$ref": "#/$defs/AccessKey"
        },
        {
          "$ref": "#/$defs/Rate"
        },
        {
          "$ref": "#/$defs/PercentDiscount"
        },
        {
          "$ref": "#/$defs/FixedDiscount"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/UniverseOAuthCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Universe Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
