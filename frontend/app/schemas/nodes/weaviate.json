{
  "$defs": {
    "WeaviateAggregateConfig": {
      "description": "Aggregate statistics over a collection (GraphQL Aggregate \u2014 count, mean, topOccurrences, etc.).",
      "properties": {
        "operation": {
          "const": "aggregate",
          "default": "aggregate",
          "title": "Aggregate",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Search",
          "x-display-name": "Aggregate",
          "x-is-trigger": false,
          "x-keywords": [
            "count",
            "stats",
            "statistics",
            "aggregate",
            "average",
            "mean",
            "sum",
            "group by",
            "analytics"
          ]
        },
        "collection": {
          "title": "Collection",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Or type the class name",
            "field_name": "collection",
            "placeholder": "Select a collection...",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "weaviate_collection"
        },
        "properties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Properties (JSON)",
          "description": "JSON array of property aggregation definitions. Each entry specifies a property name and the stats to compute. Numeric properties support stats: [\"mean\",\"maximum\",\"minimum\",\"sum\",\"count\"]. Text properties support topOccurrences (number). E.g. [{\"name\":\"score\",\"stats\":[\"mean\",\"maximum\"]},{\"name\":\"category\",\"topOccurrences\":5}]. meta.count is always included.",
          "ui:widget": "textarea"
        },
        "where": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "WhereFilter JSON to restrict which objects are aggregated",
          "title": "Filter (JSON)",
          "ui:widget": "textarea"
        },
        "group_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Property name to group results by (e.g. \"category\"). Adds groupedBy { value path } to the selection.",
          "title": "Group By"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Max number of groups returned when using Group By",
          "title": "Limit"
        }
      },
      "required": [
        "collection"
      ],
      "title": "WeaviateAggregateConfig",
      "type": "object"
    },
    "WeaviateBatchDeleteConfig": {
      "description": "Batch-delete objects matching a where filter (up to 10,000 per call).",
      "properties": {
        "operation": {
          "const": "batch_delete",
          "default": "batch_delete",
