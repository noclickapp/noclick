            "Dry run (preview only)"
          ],
          "title": "Dry Run",
          "type": "string",
          "x-enum-searchable": true
        }
      },
      "required": [
        "collection",
        "where"
      ],
      "title": "WeaviateBatchDeleteConfig",
      "type": "object"
    },
