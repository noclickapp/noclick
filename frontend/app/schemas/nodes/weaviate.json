    "WeaviateGenerativeSearchConfig": {
      "description": "Generative search (RAG): retrieve objects then generate text with an LLM (GraphQL generate).\n\nThe collection must have a generative module configured in its schema\n(e.g. generative-openai, generative-anthropic, generative-cohere). Pass the\ncorresponding API key in the credential. Provide single_prompt, group_task, or both.",
      "properties": {
        "operation": {
          "const": "generative_search",
          "default": "generative_search",
          "title": "Generative Search (RAG)",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Search",
          "x-display-name": "Generative Search (RAG)",
          "x-is-trigger": false,
          "x-keywords": [
            "rag",
            "generate",
            "llm",
            "summarize",
            "answer",
            "gpt",
            "claude",
            "cohere",
            "gemini"
          ]
        },
        "collection": {
          "title": "Collection",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Or type the class name",
            "field_name": "collection",
            "placeholder": "Select a collection...",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "weaviate_collection"
        },
        "search_type": {
          "default": "nearVector",
          "description": "How to retrieve objects before generating",
          "enum": [
            "nearVector",
            "nearText",
            "hybrid"
          ],
          "enumNames": [
            "Vector (nearVector)",
            "Text (nearText)",
            "Hybrid (BM25+vector)"
          ],
          "title": "Search Type",
          "type": "string",
          "x-enum-searchable": true
        },
        "vector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON array of numbers \u2014 required for nearVector; optional for hybrid",
          "title": "Query Vector",
          "ui:widget": "textarea"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text query \u2014 required for nearText and hybrid",
          "title": "Query Text",
          "ui:widget": "textarea"
        },
        "alpha": {
          "default": 0.75,
          "description": "BM25 (0) to vector (1) balance \u2014 only used with hybrid search type",
          "title": "Hybrid Alpha",
          "type": "number"
        },
        "properties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Properties",
          "description": "Object properties to return alongside generated text, comma-separated"
        },
        "limit": {
          "default": 5,
          "description": "Number of objects to retrieve and feed to the LLM",
          "title": "Limit",
          "type": "integer"
        },
        "where": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional WhereFilter JSON to restrict which objects are fed to the LLM",
          "title": "Filter (JSON)",
          "ui:widget": "textarea"
        },
        "single_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prompt template applied to each object individually. Reference object properties with {propertyName}, e.g. \"Summarize this article: {content}\"",
          "title": "Single Prompt",
          "ui:widget": "textarea"
        },
        "group_task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Task applied once to ALL retrieved objects combined, e.g. \"What do these articles have in common?\"",
          "title": "Group Task",
          "ui:widget": "textarea"
        }
      },
      "required": [
        "collection"
      ],
      "title": "WeaviateGenerativeSearchConfig",
      "type": "object"
    },
