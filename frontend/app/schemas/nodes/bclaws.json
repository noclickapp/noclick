          "title": "Browse Orders in Council",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Browse Orders in Council"
        }
      },
      "title": "ListOrdersInCouncil",
      "type": "object"
    },
    "ListStatutesAndRegulations": {
