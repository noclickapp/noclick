    "SearchDocuments": {
      "additionalProperties": false,
      "properties": {
        "aspect_id": {
          "default": "complete",
          "description": "BC Laws aspect identifier. Complete contains current statutes and regulations.",
          "enum": [
            "complete",
            "corpreg",
            "bcgaz1",
            "bcgaz2",
            "oic",
            "psl",
            "ecb",
            "hscr",
            "arch_oic"
          ],
          "title": "Collection",
          "type": "string"
        },
        "operation": {
          "const": "search_documents",
          "default": "search_documents",
          "title": "Search Legislation",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Search Legislation"
        },
        "query": {
          "description": "CiviX query expression, for example water.",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Search query",
          "type": "string"
        },
        "start": {
          "default": 0,
          "minimum": 0,
          "title": "First hit",
          "type": "integer"
        },
        "end": {
          "default": 20,
          "description": "At most 100 hits beyond the first hit. Advance both offsets for the next page.",
          "minimum": 1,
          "title": "Last hit",
          "type": "integer"
        },
        "fragment_count": {
          "default": 5,
          "exclusiveMaximum": 10,
          "minimum": 0,
          "title": "Snippets per hit",
          "type": "integer"
        },
        "fragment_length": {
          "default": 100,
          "exclusiveMaximum": 200,
          "minimum": 1,
          "title": "Snippet length",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "SearchDocuments",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_document_html": "#/$defs/GetDocumentHtml",
          "get_document_xml": "#/$defs/GetDocumentXml",
          "get_highlighted_document_html": "#/$defs/GetHighlightedDocumentHtml",
          "get_highlighted_document_xml": "#/$defs/GetHighlightedDocumentXml",
          "list_content": "#/$defs/ListContent",
          "list_corporate_registry": "#/$defs/ListCorporateRegistry",
          "list_directory": "#/$defs/ListDirectory",
          "list_orders_in_council": "#/$defs/ListOrdersInCouncil",
          "list_statutes_and_regulations": "#/$defs/ListStatutesAndRegulations",
          "search_documents": "#/$defs/SearchDocuments"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SearchDocuments"
        },
        {
          "$ref": "#/$defs/ListContent"
        },
        {
          "$ref": "#/$defs/ListDirectory"
        },
        {
          "$ref": "#/$defs/GetDocumentHtml"
        },
        {
          "$ref": "#/$defs/GetDocumentXml"
        },
        {
          "$ref": "#/$defs/GetHighlightedDocumentHtml"
        },
        {
          "$ref": "#/$defs/GetHighlightedDocumentXml"
        },
        {
          "$ref": "#/$defs/ListStatutesAndRegulations"
        },
        {
          "$ref": "#/$defs/ListOrdersInCouncil"
        },
        {
          "$ref": "#/$defs/ListCorporateRegistry"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials",
      "type": "null"
    }
  },
  "required": [
    "config"
  ],
  "title": "Bclaws Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
