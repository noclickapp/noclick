          "type": "string"
        },
        "operation": {
          "const": "list_directory",
          "default": "list_directory",
          "title": "Browse Index or Directory",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Browse Index or Directory"
        },
        "directory_id": {
          "description": "CIVIX_DOCUMENT_ID from a browse result, for example statreg.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Index or directory ID",
          "type": "string"
        }
      },
      "required": [
        "directory_id"
      ],
      "title": "ListDirectory",
      "type": "object"
    },
    "ListOrdersInCouncil": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_orders_in_council",
