{
  "$defs": {
    "GetDocumentHtml": {
      "additionalProperties": false,
      "properties": {
        "aspect_id": {
          "default": "complete",
          "description": "BC Laws aspect identifier. Complete contains current statutes and regulations.",
          "enum": [
            "complete",
            "corpreg",
            "bcgaz1",
            "bcgaz2",
            "oic",
            "psl",
            "ecb",
            "hscr",
            "arch_oic"
          ],
          "title": "Collection",
          "type": "string"
        },
        "index_id": {
          "description": "CIVIX_INDEX_ID from browse/search, for example statreg.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Index ID",
          "type": "string"
        },
        "document_id": {
          "description": "CIVIX_DOCUMENT_ID from browse/search, for example 01009_01.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Document ID",
          "type": "string"
        },
        "operation": {
          "const": "get_document_html",
          "default": "get_document_html",
          "title": "Get Document HTML",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Get Document HTML"
        }
      },
      "required": [
        "index_id",
        "document_id"
      ],
      "title": "GetDocumentHtml",
      "type": "object"
    },
