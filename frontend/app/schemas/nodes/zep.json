    "ZepAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "zep_api_key",
          "default": "zep_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Zep API Key",
      "type": "object",
      "x-credential-instructions": "Create a project API key in the Zep console and paste it here, without the Api-Key prefix. The key is sent only to api.getzep.com. Connect reads the project to verify access.",
      "x-credential-url": "https://app.getzep.com"
    },
    "ZepAddEpisodeConfig": {
      "additionalProperties": false,
      "description": "Add business data and return its episode plus extraction task.",
      "properties": {
        "metadata": {
          "anyOf": [
            {
              "maxLength": 200000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON object of metadata. On update, null values remove keys.",
          "title": "Metadata",
          "ui:language": "json",
          "ui:widget": "code_editor"
        },
        "operation": {
          "const": "add_episode",
          "default": "add_episode",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "graph_uuid": {
          "title": "Graph Uuid",
          "type": "string"
        },
        "data": {
          "description": "Episode content to ingest.",
          "maxLength": 200000,
          "minLength": 1,
          "title": "Data",
          "type": "string"
        },
        "type": {
          "default": "text",
          "enum": [
            "text",
            "json",
            "message"
          ],
          "title": "Type",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "reference_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Time"
        },
        "source_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Description"
        },
        "strict_ontology": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strict Ontology"
        }
      },
      "required": [
        "graph_uuid",
        "data"
      ],
      "title": "ZepAddEpisodeConfig",
      "type": "object"
    },
    "ZepAddMessagesConfig": {
      "additionalProperties": false,
      "description": "Store live-turn messages and return the asynchronous extraction task.",
      "properties": {
        "operation": {
          "const": "add_messages",
          "default": "add_messages",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "thread_uuid": {
          "title": "Thread Uuid",
          "type": "string"
        },
        "messages": {
          "description": "JSON array of live-turn messages, for example [{\"role\":\"user\",\"content\":\"Hello\",\"name\":\"Jane\"}]. Server assigns message UUIDs.",
