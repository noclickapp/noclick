    "CheckConnection": {
      "additionalProperties": false,
      "description": "Check API-key acceptance with one geocoding query (GET /json).",
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "CheckConnection",
      "type": "object"
    },
    "Geocode": {
      "additionalProperties": false,
      "description": "Geocode an address or place to coordinates and annotations (GET /json).",
      "properties": {
        "language": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IETF language tag, such as de or pt-BR, or native.",
          "title": "Language"
        },
        "limit": {
          "default": 10,
          "description": "Maximum results; OpenCage may return fewer. There is no pagination.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "abbrv": {
          "default": false,
          "description": "Abbreviate the formatted address.",
          "title": "Abbrv",
          "type": "boolean"
        },
        "no_annotations": {
          "default": false,
          "description": "Omit location annotations.",
          "title": "No Annotations",
          "type": "boolean"
        },
        "no_dedupe": {
          "default": false,
          "description": "Keep duplicate results.",
          "title": "No Dedupe",
          "type": "boolean"
        },
        "no_record": {
          "default": false,
          "description": "Ask OpenCage not to log the query.",
          "title": "No Record",
          "type": "boolean"
        },
        "q": {
          "description": "Address, place name or LOCODE: prefixed UN/LOCODE.",
          "minLength": 2,
          "title": "Q",
          "type": "string"
        },
        "bounds": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "min longitude,min latitude,max longitude,max latitude.",
          "title": "Bounds"
        },
        "countrycode": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2}(,[a-z]{2})*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lowercase ISO alpha-2 codes, comma separated.",
          "title": "Countrycode"
        },
        "proximity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latitude,longitude used to bias results, not restrict them.",
          "title": "Proximity"
        },
        "operation": {
          "const": "geocode",
          "default": "geocode",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "q"
      ],
      "title": "Geocode",
      "type": "object"
    },
