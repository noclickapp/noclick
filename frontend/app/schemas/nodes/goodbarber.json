        "creation_date_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restricts the list of returned orders to the ones created before (or on) the provided datetime.This parameter should use the following format yyyy-mm-ddThh:MM (year, month, day, 24-hour and minute) and be expressed in UTC time.",
          "title": "Creation Date To"
        },
        "delivery_date_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restricts the list of returned orders to the ones whose selected delivery slot lands after (or on) the provided datetime.This parameter should use the following format yyyy-mm-ddThh:MM (year, month, day, 24-hour and minute) and be expressed in UTC time. When this filter is applied, orders that do not have a selected delivery slot (shipped by transporter, for instance) will not be returned.Also, note that a delivery slot is said to land after a given datetime if its slot_start value is later than that datetime.",
          "title": "Delivery Date From"
        },
        "delivery_date_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restricts the list of returned orders to the ones whose selected delivery slot lands before (or on) the provided datetime.This parameter should use the following format yyyy-mm-ddThh:MM (year, month, day, 24-hour and minute) and be expressed in UTC time. When this filter is applied, orders that do not have a selected delivery slot (shipped by transporter, for instance) will not be returned.Also, note that a delivery slot is said to land before a given datetime if its slot_end value comes before that datetime.",
          "title": "Delivery Date To"
        },
        "page": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page number.",
          "title": "Page"
        },
        "per_page": {
