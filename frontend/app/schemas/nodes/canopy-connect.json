{
  "$defs": {
    "CanopyCheckPullPolicyConfig": {
      "description": "Check pull policy. See https://docs.usecanopy.com/reference/post-pull-policy-check.",
      "properties": {
        "operation": {
          "const": "check_pull_policy",
          "default": "check_pull_policy",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "pullId": {
          "description": "ID of Pull that Document belongs to",
          "format": "uuid",
          "title": "Pullid",
          "type": "string"
        }
      },
      "required": [
        "pullId"
      ],
      "title": "CanopyCheckPullPolicyConfig",
      "type": "object"
    },
    "CanopyConnectCredential": {
      "properties": {
        "credential_type": {
          "const": "canopy_connect_api_key",
          "default": "canopy_connect_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "canopy_team_id": {
          "format": "uuid",
          "title": "Team ID",
          "type": "string"
        },
        "client_id": {
          "minLength": 1,
          "title": "Client ID",
          "type": "string",
          "ui:widget": "password"
        },
        "client_secret": {
          "minLength": 1,
          "title": "Client Secret",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "canopy_team_id",
        "client_id",
        "client_secret"
      ],
      "title": "Canopy Connect API Key",
      "type": "object",
      "x-credential-instructions": "In Canopy Connect, open Settings \u2192 API and copy your Team ID, Client ID and Client Secret. Choose a key matching your sandbox or production links. NoClick sends the Client ID and Client Secret using HTTP Basic authentication. The team read verifies access; individual operations may require additional plan permissions.",
      "x-credential-url": "https://app.usecanopy.com/dashboard/settings/api-settings"
    },
    "CanopyCreateMonitoringConfig": {
      "description": "Create monitoring. See https://docs.usecanopy.com/reference/post-monitoring.",
      "properties": {
        "operation": {
          "const": "create_monitoring",
          "default": "create_monitoring",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "interval": {
          "description": "How often the information should be refreshed. Must be >= 30 days. We accept ISO-8601 duration interval value and support days, months, and/or years.",
          "examples": [
            "P1M"
          ],
          "pattern": "^(-?)P(?=\\d|T\\d)(?:(\\d+)Y)?(?:(\\d+)M)?(?:(\\d+)([DW]))?(?:T(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+(?:\\.\\d+)?)S)?)?$",
          "title": "Interval",
          "type": "string"
        },
        "next_pull_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional date the next refresh should occur (Can be used as a start date). Must be >= 30 days after the Pull was created. Defaults to Pull created date + interval.",
          "title": "Next Pull Date"
        },
        "stop_after_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional date after which monitoring should stop",
          "title": "Stop After Date"
        },
        "pull_id": {
          "description": "ID of the Pull to be monitored",
          "format": "uuid",
          "title": "Pull Id",
          "type": "string"
        }
      },
      "required": [
        "interval",
        "pull_id"
      ],
      "title": "CanopyCreateMonitoringConfig",
      "type": "object"
    },
    "CanopyCreateWebhookConfig": {
      "description": "Create webhook. See https://docs.usecanopy.com/reference/post-webhooks.",
      "properties": {
        "operation": {
          "const": "create_webhook",
          "default": "create_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "hookUrl": {
          "description": "The URL that the webhook requests will go to",
          "pattern": "^https?://[^ /]+",
          "title": "Hookurl",
          "type": "string"
        },
        "eventTypes": {
          "description": "The event types that will trigger the webhook request",
          "items": {
            "enum": [
              "COMPLETE",
              "POLICIES_AVAILABLE",
              "POLICY_AVAILABLE",
              "AUTH_STATUS",
              "SERVICING_STATUS_UPDATED",
              "VALIDATION_COMPLETE"
            ],
            "type": "string"
          },
          "title": "Eventtypes",
          "type": "array"
        }
      },
      "required": [
        "hookUrl",
        "eventTypes"
      ],
      "title": "CanopyCreateWebhookConfig",
      "type": "object"
    },
    "CanopyCreateWidgetConfig": {
      "description": "Create widget. See https://docs.usecanopy.com/reference/post-widgets.",
      "properties": {
        "operation": {
          "const": "create_widget",
          "default": "create_widget",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "intro_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The message displayed upon the introduction of the Widget flow.",
          "title": "Intro Title"
        },
        "public_alias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The public identifier for the Widget (eg. demo => https://app.usecanopy.com/c/demo). When not explicitly set, a public_alias will be auto generated.",
          "title": "Public Alias"
        },
        "company_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The company name presented in the Widget flow.",
          "title": "Company Name"
        },
        "brand_color_hex": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RRGGBB hexadecimal string used for color theming in the Widget flow.",
          "title": "Brand Color Hex"
        },
        "success_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The message displayed upon successful completion of the Widget flow.",
          "title": "Success Message"
        },
        "on_success_redirect_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The URL the user is taken to upon successful completion of the Widget flow.",
          "title": "On Success Redirect Url"
        },
        "cobranded_intro_screen": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the enhanced \u201ccobranded\u201d introduction screen is enabled for the Widget flow.",
          "title": "Cobranded Intro Screen"
        },
        "agents": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional list of agents to update (either list of agent_ids or agent object with agent_id)",
          "title": "Agents"
        }
      },
      "title": "CanopyCreateWidgetConfig",
      "type": "object"
    },
