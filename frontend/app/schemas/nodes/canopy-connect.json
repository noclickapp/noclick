    "CanopyUpdateMonitoringConfig": {
      "description": "Update monitoring. See https://docs.usecanopy.com/reference/patch-monitoring.",
      "properties": {
        "operation": {
          "const": "update_monitoring",
          "default": "update_monitoring",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "monitoringId": {
          "description": "ID of Monitoring",
          "format": "uuid",
          "title": "Monitoringid",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "pattern": "^(-?)P(?=\\d|T\\d)(?:(\\d+)Y)?(?:(\\d+)M)?(?:(\\d+)([DW]))?(?:T(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+(?:\\.\\d+)?)S)?)?$",
              "type": "string"
            },
            {
              "type": "null"
