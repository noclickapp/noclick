    "CanopyListMonitoringsConfig": {
      "description": "List monitorings. See https://docs.usecanopy.com/reference/get-monitorings.",
      "properties": {
        "operation": {
          "const": "list_monitorings",
          "default": "list_monitorings",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "limit": {
          "default": 100,
          "description": "Pagination limit",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "before": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pagination before pointer of a monitoring_id",
          "title": "Before"
        },
        "pull_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter used to list Monitorings related to a Pull (cannot be used with account_identifier)",
          "title": "Pull Id"
        },
        "account_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter used to list Monitorings related to an Account Identifier (cannot be used with pull_id)",
          "title": "Account Identifier"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "ACTIVE",
                "STOPPED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter used to list Monitorings of a certain status",
          "title": "Status",
          "enum": [
            "ACTIVE",
            "STOPPED"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "CanopyListMonitoringsConfig",
      "type": "object"
    },
    "CanopyListPullsConfig": {
      "description": "List pulls. See https://docs.usecanopy.com/reference/get-pulls.",
      "properties": {
        "operation": {
          "const": "list_pulls",
          "default": "list_pulls",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by Pulls that occurred since the supplied date (inclusive)",
          "title": "Since"
        },
        "before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by Pulls that occurred before the supplied date (inclusive)",
          "title": "Before"
        },
        "limit": {
          "default": 10,
          "description": "Optionally limit the number of Pulls that are returned in the response to a maximum of limit. Use along with offset",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optionally return Pulls starting from the supplied offset within the total list of Pulls matching the query. Use along with limit",
          "title": "Offset"
        }
      },
      "title": "CanopyListPullsConfig",
      "type": "object"
    },
