            "P1M"
          ],
          "title": "Interval"
        },
        "next_pull_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional date the next refresh should occur. Must be >= 30 days after the latest Pull was created. Defaults to Pull created date + interval.",
          "title": "Next Pull Date"
        },
        "stop_after_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional date after which monitoring should stop",
          "title": "Stop After Date"
        },
        "status": {
          "anyOf": [
