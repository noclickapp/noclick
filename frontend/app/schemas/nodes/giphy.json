          "title": "Operation",
          "type": "string"
        }
      },
      "title": "RandomSticker",
      "type": "object"
    },
    "SearchGifs": {
      "additionalProperties": false,
      "description": "Search the public GIF catalogue.",
      "properties": {
        "limit": {
          "default": 25,
          "description": "Maximum results in this page. No automatic pagination.",
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Search result offset for this page.",
          "maximum": 4999,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "rating": {
          "anyOf": [
            {
              "enum": [
                "g",
                "pg",
                "pg-13",
                "r"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating",
          "enum": [
            "g",
            "pg",
            "pg-13",
            "r"
          ],
          "x-enum-searchable": true
        },
        "q": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Search query",
          "type": "string"
        },
        "lang": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Two-letter ISO 639-1 language code.",
          "title": "Lang"
        },
        "operation": {
          "const": "search_gifs",
          "default": "search_gifs",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "q"
