          "get_gif": "#/$defs/GetGif",
          "get_gifs": "#/$defs/GetGifs",
          "get_trending_gifs": "#/$defs/TrendingGifs",
          "get_trending_stickers": "#/$defs/TrendingStickers",
          "random_gif": "#/$defs/RandomGif",
