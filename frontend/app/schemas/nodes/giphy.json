          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "q": {
          "description": "Watch this search, or use @username to watch a public verified channel.",
          "maxLength": 50,
          "minLength": 1,
          "title": "Search query",
          "type": "string"
        },
        "lang": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Two-letter ISO 639-1 language code.",
          "title": "Lang"
        },
        "rating": {
          "anyOf": [
            {
              "enum": [
                "g",
                "pg",
                "pg-13",
                "r"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating",
          "enum": [
            "g",
            "pg",
            "pg-13",
            "r"
          ],
          "x-enum-searchable": true
        },
        "limit": {
          "default": 50,
          "description": "Check this many most recent matches. Existing matches are baselined when armed. Matches that leave this window between polls can be missed; narrow the query or shorten the schedule.",
          "maximum": 50,
          "minimum": 1,
          "title": "Recent results per poll",
          "type": "integer"
        },
        "operation": {
          "const": "on_new_gif",
          "default": "on_new_gif",
          "title": "Operation",
          "type": "string",
          "x-category": "Triggers",
          "x-display-name": "On New GIF",
          "x-is-trigger": true
        }
      },
      "required": [
        "q"
      ],
      "title": "OnNewGif",
      "type": "object",
      "x-requires-webhook": true
    },
