{
  "$defs": {
    "GetGif": {
      "additionalProperties": false,
      "description": "Get a GIF by its GIPHY ID (IDs are strings in current provider docs).",
      "properties": {
        "operation": {
          "const": "get_gif",
          "default": "get_gif",
          "title": "Operation",
          "type": "string"
        },
        "gif_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9]+$",
          "title": "GIF ID",
          "type": "string"
        }
      },
      "required": [
        "gif_id"
      ],
      "title": "GetGif",
      "type": "object"
    },
    "GetGifs": {
      "additionalProperties": false,
      "description": "Get several GIFs by comma-separated GIPHY IDs.",
      "properties": {
        "operation": {
          "const": "get_gifs",
          "default": "get_gifs",
          "title": "Operation",
          "type": "string"
        },
        "ids": {
          "maxLength": 12900,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9]+(?:,[A-Za-z0-9]+)*$",
          "title": "GIF IDs",
          "type": "string"
        }
      },
      "required": [
        "ids"
      ],
      "title": "GetGifs",
      "type": "object"
    },
    "GiphyApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "giphy_api_key",
          "default": "giphy_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "GIPHY API Key",
      "type": "object",
      "x-credential-instructions": "Create an API app in the GIPHY developer dashboard and paste its API key. NoClick checks access to public trending GIFs; this verifies reachability, not your identity or account ownership.",
      "x-credential-url": "https://developers.giphy.com/dashboard/"
    },
    "RandomGif": {
      "additionalProperties": false,
      "description": "Get a random GIF, optionally filtered by tag and rating.",
      "properties": {
        "tag": {
          "anyOf": [
            {
              "maxLength": 50,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        },
        "rating": {
          "anyOf": [
            {
              "enum": [
                "g",
                "pg",
                "pg-13",
                "r"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating",
          "enum": [
            "g",
            "pg",
            "pg-13",
            "r"
          ],
          "x-enum-searchable": true
        },
        "operation": {
          "const": "random_gif",
          "default": "random_gif",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "RandomGif",
      "type": "object"
    },
    "RandomSticker": {
