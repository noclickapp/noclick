{
  "$defs": {
    "BulkSMSComAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "bulksmscom_api_token",
          "default": "bulksmscom_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "token_id": {
          "minLength": 1,
          "title": "Token ID",
          "type": "string",
          "ui:widget": "password"
        },
        "token_secret": {
          "minLength": 1,
          "title": "Token secret",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "token_id",
        "token_secret"
      ],
      "title": "BulkSMS.com API Token",
      "type": "object",
      "x-credential-instructions": "In BulkSMS.com, open Settings > Developer Settings > API Tokens. Paste the token ID and token secret. NoClick uses these as HTTP Basic credentials and checks your profile.",
      "x-credential-url": "https://www.bulksms.com/developer/json/v1/#section/Authentication"
    },
    "CreateBlockedNumbers": {
      "additionalProperties": false,
      "description": "Block up to 1000 phone numbers from receiving messages from your account.",
      "properties": {
        "operation": {
          "const": "create_blocked_numbers",
          "default": "create_blocked_numbers",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "phone_numbers": {
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Phone Numbers",
          "type": "array"
        }
      },
      "required": [
        "phone_numbers"
      ],
      "title": "CreateBlockedNumbers",
      "type": "object"
    },
    "CreateWebhook": {
      "additionalProperties": false,
      "description": "Register a status or inbound-message webhook with BulkSMS.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "pattern": "^https?://[^\\s]+$",
          "title": "Webhook URL",
          "type": "string"
        },
        "trigger_scope": {
          "enum": [
            "SENT",
            "RECEIVED"
          ],
          "title": "Trigger Scope",
          "type": "string"
        },
        "contact_email_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional problem-report email address; null disables email.",
          "title": "Contact Email Address"
        },
        "invoke_option": {
          "default": "MANY",
          "enum": [
            "ONE",
            "MANY"
          ],
          "title": "Invoke Option",
          "type": "string"
        },
        "active": {
          "default": true,
          "description": "BulkSMS validates active URLs by POSTing an empty array.",
          "title": "Active",
          "type": "boolean"
        },
        "on_web_app": {
          "default": true,
          "title": "On Web App",
          "type": "boolean"
        },
        "operation": {
          "const": "create_webhook",
          "default": "create_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "name",
        "url",
        "trigger_scope"
      ],
      "title": "CreateWebhook",
      "type": "object"
    },
    "DeleteWebhook": {
      "additionalProperties": false,
      "description": "Delete a registered webhook.",
      "properties": {
        "webhook_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Webhook Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_webhook",
          "default": "delete_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "webhook_id"
      ],
      "title": "DeleteWebhook",
      "type": "object"
    },
    "GetMessage": {
      "additionalProperties": false,
      "description": "Read one sent or received message by ID.",
      "properties": {
        "message_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Message Id",
          "type": "string"
        },
        "operation": {
          "const": "get_message",
          "default": "get_message",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "message_id"
      ],
      "title": "GetMessage",
      "type": "object"
    },
    "GetProfile": {
      "additionalProperties": false,
      "description": "Read your account profile, credit balance and quota.",
      "properties": {
        "operation": {
          "const": "get_profile",
          "default": "get_profile",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetProfile",
      "type": "object"
    },
    "GetWebhook": {
      "additionalProperties": false,
      "description": "Read a registered webhook.",
      "properties": {
        "webhook_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Webhook Id",
          "type": "string"
        },
        "operation": {
          "const": "get_webhook",
          "default": "get_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "webhook_id"
      ],
      "title": "GetWebhook",
      "type": "object"
    },
    "ListBlockedNumbers": {
      "additionalProperties": false,
      "description": "Read a bounded blocked-number page; continue with last id plus one as min_id.",
      "properties": {
        "operation": {
          "const": "list_blocked_numbers",
          "default": "list_blocked_numbers",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "min_id": {
          "default": 0,
          "minimum": 0,
          "title": "Min Id",
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "ListBlockedNumbers",
      "type": "object"
    },
    "ListMessages": {
      "additionalProperties": false,
      "description": "Read a bounded message page; use an id filter to fetch subsequent pages.",
      "properties": {
        "operation": {
          "const": "list_messages",
          "default": "list_messages",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "filter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unencoded clauses, e.g. type=SENT&id<123456. NoClick URL-encodes this once.",
          "title": "Filter"
        },
        "sort_order": {
          "anyOf": [
            {
              "const": "ASCENDING",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit for the default descending order.",
          "title": "Sort Order"
        }
      },
      "title": "ListMessages",
      "type": "object"
    },
    "ListRelatedMessages": {
      "additionalProperties": false,
      "description": "Read replies related to a sent message.",
      "properties": {
        "message_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Message Id",
          "type": "string"
        },
        "operation": {
          "const": "list_related_messages",
          "default": "list_related_messages",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "message_id"
      ],
      "title": "ListRelatedMessages",
      "type": "object"
    },
    "ListWebhooks": {
      "additionalProperties": false,
      "description": "List your account's registered message webhooks.",
      "properties": {
        "operation": {
          "const": "list_webhooks",
          "default": "list_webhooks",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListWebhooks",
      "type": "object"
    },
    "SendMessages": {
      "additionalProperties": false,
      "description": "Submit an SMS to one or more international numbers; submission does not prove delivery.",
      "properties": {
        "operation": {
          "const": "send_messages",
          "default": "send_messages",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "to": {
          "description": "International phone numbers, including country code.",
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Recipient numbers",
          "type": "array"
        },
        "body": {
          "minLength": 1,
          "title": "Message text",
          "type": "string"
        },
        "sender_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Approved international number or alphanumeric sender.",
          "title": "Sender address"
        },
        "encoding": {
          "anyOf": [
            {
              "enum": [
                "TEXT",
                "UNICODE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoding",
          "enum": [
            "TEXT",
            "UNICODE"
          ],
          "x-enum-searchable": true
        },
        "routing_group": {
          "anyOf": [
            {
              "enum": [
                "ECONOMY",
                "STANDARD",
                "PREMIUM"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Routing Group",
          "enum": [
            "ECONOMY",
            "STANDARD",
            "PREMIUM"
          ],
          "x-enum-searchable": true
        },
        "user_supplied_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Supplied Id"
        },
        "long_message_max_parts": {
          "anyOf": [
            {
              "maximum": 99,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Long Message Max Parts"
        },
        "delivery_reports": {
          "anyOf": [
            {
              "enum": [
                "ALL",
                "ERRORS",
                "NONE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Reports",
          "enum": [
            "ALL",
            "ERRORS",
            "NONE"
          ],
          "x-enum-searchable": true
        },
        "auto_unicode": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auto Unicode"
        },
        "deduplication_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reuse the same positive ID when retrying the same submission.",
          "title": "Deduplication Id"
        },
        "schedule_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 date-time with seconds and UTC offset.",
          "title": "Schedule Date"
        },
        "schedule_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Description"
        }
      },
      "required": [
        "to",
        "body"
      ],
      "title": "SendMessages",
      "type": "object"
    },
    "UpdateWebhook": {
      "additionalProperties": false,
      "description": "Replace a webhook's settings with the supplied values.",
      "properties": {
        "webhook_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Webhook Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "pattern": "^https?://[^\\s]+$",
          "title": "Webhook URL",
          "type": "string"
        },
        "trigger_scope": {
          "enum": [
            "SENT",
            "RECEIVED"
          ],
          "title": "Trigger Scope",
          "type": "string"
        },
        "contact_email_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional problem-report email address; null disables email.",
          "title": "Contact Email Address"
        },
        "invoke_option": {
          "default": "MANY",
          "enum": [
            "ONE",
            "MANY"
          ],
          "title": "Invoke Option",
          "type": "string"
        },
        "active": {
          "default": true,
          "description": "BulkSMS validates active URLs by POSTing an empty array.",
          "title": "Active",
          "type": "boolean"
        },
        "on_web_app": {
          "default": true,
          "title": "On Web App",
          "type": "boolean"
        },
        "operation": {
          "const": "update_webhook",
          "default": "update_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "webhook_id",
        "name",
        "url",
        "trigger_scope"
      ],
      "title": "UpdateWebhook",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_blocked_numbers": "#/$defs/CreateBlockedNumbers",
          "create_webhook": "#/$defs/CreateWebhook",
          "delete_webhook": "#/$defs/DeleteWebhook",
          "get_message": "#/$defs/GetMessage",
          "get_profile": "#/$defs/GetProfile",
          "get_webhook": "#/$defs/GetWebhook",
          "list_blocked_numbers": "#/$defs/ListBlockedNumbers",
          "list_messages": "#/$defs/ListMessages",
          "list_related_messages": "#/$defs/ListRelatedMessages",
          "list_webhooks": "#/$defs/ListWebhooks",
          "send_messages": "#/$defs/SendMessages",
          "update_webhook": "#/$defs/UpdateWebhook"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetProfile"
        },
        {
          "$ref": "#/$defs/SendMessages"
        },
        {
          "$ref": "#/$defs/ListMessages"
        },
        {
          "$ref": "#/$defs/GetMessage"
        },
        {
          "$ref": "#/$defs/ListRelatedMessages"
        },
        {
          "$ref": "#/$defs/ListBlockedNumbers"
        },
        {
          "$ref": "#/$defs/CreateBlockedNumbers"
        },
        {
          "$ref": "#/$defs/ListWebhooks"
        },
        {
          "$ref": "#/$defs/GetWebhook"
        },
        {
          "$ref": "#/$defs/CreateWebhook"
        },
        {
          "$ref": "#/$defs/UpdateWebhook"
        },
        {
          "$ref": "#/$defs/DeleteWebhook"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/BulkSMSComAPITokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Bulksmscom Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
