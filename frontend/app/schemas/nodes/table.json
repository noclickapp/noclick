{
  "$defs": {
    "TableAddRowsConfig": {
      "description": "Add rows after the table's last row; the first Add to a new name makes the table.",
      "properties": {
        "table": {
          "description": "The table's name: one of this automation's tables, or a new name, which the first Add makes.",
          "minLength": 1,
          "title": "Table",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Name a new table",
            "field_name": "table",
            "names_new": true,
            "placeholder": "Pick a table or name a new one",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "add_rows",
          "default": "add_rows",
          "title": "Add Rows",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Rows",
          "x-display-name": "Add Rows",
          "x-is-trigger": false,
          "x-keywords": [
            "add row",
            "append rows",
            "insert rows",
            "save results",
            "log to table",
            "store row"
          ]
        },
        "rows": {
          "description": "The rows to add, in order: a list of objects whose keys are the columns. One object adds one row; an upstream list passed whole adds a row per item.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Rows",
          "type": "array",
          "ui:placeholder": "[{\"name\": \"Ada\", \"email\": \"ada@example.com\"}]",
          "ui:rows": 5,
          "ui:widget": "textarea"
        }
      },
      "required": [
        "table",
        "rows"
      ],
      "title": "TableAddRowsConfig",
      "type": "object"
    },
    "TableDeleteRowsConfig": {
