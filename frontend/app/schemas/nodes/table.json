        "mapping": {
          "add_rows": "#/$defs/TableAddRowsConfig",
          "delete_rows": "#/$defs/TableDeleteRowsConfig",
          "read_rows": "#/$defs/TableReadRowsConfig",
          "update_rows": "#/$defs/TableUpdateRowsConfig"
        },
        "propertyName": "operation"
