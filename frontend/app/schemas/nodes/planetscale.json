{
  "$defs": {
    "CloseDeployRequest": {
      "description": "Close a deploy request.",
      "properties": {
        "operation": {
          "const": "close_deploy_request",
          "default": "close_deploy_request",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "organization": {
          "description": "The name of the deploy request's organization",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Organization",
          "type": "string"
        },
        "database": {
          "description": "The name of the deploy request's database",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Database",
          "type": "string"
        },
        "number": {
          "description": "The number of the deploy request",
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "state": {
          "const": "closed",
          "default": "closed",
          "description": "The deploy request will be updated to this state",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "organization",
        "database",
        "number"
      ],
      "title": "CloseDeployRequest",
      "type": "object"
    },
    "CreateBackup": {
      "description": "Create a backup.",
      "properties": {
        "operation": {
          "const": "create_backup",
          "default": "create_backup",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "organization": {
          "description": "The name of the organization the branch belongs to",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Organization",
          "type": "string"
        },
        "database": {
          "description": "The name of the database the branch belongs to",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Database",
          "type": "string"
        },
        "branch": {
          "description": "The name of the branch",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Branch",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name for the backup",
          "title": "Name"
        },
        "retention_unit": {
          "anyOf": [
            {
              "enum": [
                "hour",
                "day",
                "week",
                "month",
                "year"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit for the retention period of the backup",
          "title": "Retention Unit",
          "enum": [
            "hour",
            "day",
            "week",
            "month",
            "year"
          ],
          "x-enum-searchable": true
        },
        "retention_value": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Value between `1` and `1000` for the retention period of the backup (i.e retention_value `6` and retention_unit `hour` means 6 hours)",
          "title": "Retention Value"
        },
        "emergency": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the backup is an immediate backup that may affect database performance. Emergency backups are only supported for PostgreSQL databases.",
          "title": "Emergency"
        }
      },
      "required": [
        "organization",
        "database",
        "branch"
      ],
      "title": "CreateBackup",
      "type": "object"
    },
    "CreateBranch": {
      "description": "Create a branch.",
      "properties": {
        "operation": {
          "const": "create_branch",
          "default": "create_branch",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "organization": {
          "description": "The name of the organization the branch belongs to",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Organization",
          "type": "string"
        },
        "database": {
          "description": "The name of the database the branch belongs to",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Database",
          "type": "string"
        },
        "name": {
          "description": "The name of the branch to create",
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "deletion_protected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether deletion protection is enabled for the branch",
          "title": "Deletion Protected"
        },
        "parent_branch": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The name of the parent branch. Defaults to the database's default branch if not provided.",
          "title": "Parent Branch"
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The region to create the branch in. If not provided, the branch will be created in the default region for its database.",
          "title": "Region"
        }
      },
      "required": [
        "organization",
        "database",
        "name"
      ],
      "title": "CreateBranch",
      "type": "object"
    },
    "CreateDatabase": {
      "description": "Create a database.",
      "properties": {
        "operation": {
          "const": "create_database",
          "default": "create_database",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "organization": {
          "description": "Organization name slug from `list_organizations`. Example: `acme`.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Organization",
          "type": "string"
        },
        "name": {
          "description": "Name of the database",
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The region the database will be deployed in. If left blank, defaults to the organization's default region.",
          "title": "Region"
        },
        "cluster_size": {
          "description": "The database cluster size name (e.g., 'PS_10', 'PS_80'). Use the 'List available cluster sizes' endpoint to get available options for your organization. /v1/organizations/:organization/cluster-size-skus",
          "maxLength": 255,
          "minLength": 1,
          "title": "Cluster Size",
          "type": "string"
        },
        "replicas": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The number of replicas for the database. 0 for non-HA, 2+ for HA.",
          "title": "Replicas"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "mysql",
                "postgresql",
                "neki"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The kind of database to create.",
          "title": "Kind",
          "enum": [
            "mysql",
            "postgresql",
            "neki"
          ],
          "x-enum-searchable": true
        },
        "major_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For PostgreSQL and Neki databases, the PostgreSQL major version to use for the database. Defaults to the latest available major version.",
          "title": "Major Version"
        }
      },
      "required": [
        "organization",
        "name",
        "cluster_size"
      ],
      "title": "CreateDatabase",
      "type": "object"
    },
