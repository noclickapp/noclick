{
  "$defs": {
    "CaspioBearerTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "caspio_bearer_token",
          "default": "caspio_bearer_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_base_url": {
          "description": "Your API profile's HTTPS resource endpoint, for example https://b1abc2.caspio.com/rest.",
          "title": "Resource endpoint",
          "type": "string"
        },
        "access_token": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Access token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_base_url",
        "access_token"
      ],
      "title": "Caspio Bearer Token",
      "type": "object",
      "x-credential-instructions": "Paste an existing access token from your Caspio API profile and its resource endpoint, ending in /rest. The profile must permit the tables, views and tasks you use. Access tokens expire after 24 hours; replace the token when it expires. NoClick does not generate or refresh tokens.",
      "x-credential-url": "https://howto.caspio.com/integrate-your-apps/web-services-api/authenticating-rest/"
    },
    "CreateTableRecord": {
      "description": "Insert a table record; returns its new PK_ID.",
      "properties": {
        "values": {
          "additionalProperties": true,
          "description": "Flat JSON object of editable field names and values. Discover fields first. Omit auto-generated fields and PK_ID. Use null to clear a field on update.",
          "minProperties": 1,
          "placeholder": "{\n  \"Name\": \"Example\"\n}",
          "title": "Record values",
          "type": "object",
          "ui:widget": "state_editor"
        },
        "operation": {
          "const": "create_table_record",
          "default": "create_table_record",
          "title": "Operation",
          "type": "string"
        },
        "table_id": {
          "description": "Six-character Caspio identifier returned by discovery; names are not identifiers.",
          "pattern": "^[A-Za-z0-9]{6}$",
          "title": "Table Id",
          "type": "string"
        }
      },
      "required": [
        "values",
        "table_id"
      ],
      "title": "CreateTableRecord",
      "type": "object"
    },
    "DeleteTableRecord": {
      "description": "Delete one table record by PK_ID; returns the affected count.",
      "properties": {
        "operation": {
          "const": "delete_table_record",
          "default": "delete_table_record",
          "title": "Operation",
          "type": "string"
        },
        "table_id": {
          "description": "Six-character Caspio identifier returned by discovery; names are not identifiers.",
          "pattern": "^[A-Za-z0-9]{6}$",
          "title": "Table Id",
          "type": "string"
        },
        "record_pk_id": {
          "description": "System PK_ID returned by Caspio, not a customer-defined key.",
          "maxLength": 32,
          "pattern": "^[0-9]+$",
          "title": "Record Pk Id",
          "type": "string"
        }
      },
      "required": [
        "table_id",
        "record_pk_id"
      ],
      "title": "DeleteTableRecord",
      "type": "object"
    },
    "GetTable": {
