    "GetViewRecord": {
      "description": "Read a view record, preserving composite PK_ID strings verbatim.",
      "properties": {
        "operation": {
          "const": "get_view_record",
          "default": "get_view_record",
          "title": "Operation",
          "type": "string"
        },
        "view_id": {
          "description": "Six-character Caspio identifier returned by discovery; names are not identifiers.",
          "pattern": "^[A-Za-z0-9]{6}$",
          "title": "View Id",
          "type": "string"
        },
        "record_pk_id": {
          "description": "Exact PK_ID from the view response; joins use comma-separated IDs.",
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "^[0-9]+(?:,[0-9]+)*$",
          "title": "Record Pk Id",
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "record_pk_id"
      ],
      "title": "GetViewRecord",
      "type": "object"
    },
    "ListTableFields": {
      "description": "Discover field names, types and editability before querying or writing.",
      "properties": {
        "page_number": {
          "default": 1,
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "page_size": {
          "default": 100,
          "description": "One explicit page; use pagination.totalCount to determine whether more pages remain.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "operation": {
          "const": "list_table_fields",
