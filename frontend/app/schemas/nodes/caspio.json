    "ListTableRecords": {
      "description": "Query a single page of table records.",
      "properties": {
        "page_number": {
          "default": 1,
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "page_size": {
          "default": 100,
          "description": "One explicit page; use pagination.totalCount to determine whether more pages remain.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "select": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated field names or T-SQL expressions; omitted means all fields.",
          "title": "Select"
        },
        "where": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SQL Server condition without WHERE, e.g. Status=N'Active'. Double embedded single quotes.",
          "title": "Where"
        },
        "order_by": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "T-SQL ordering, e.g. LastName ASC, FirstName DESC.",
          "title": "Order By"
        },
        "group_by": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GROUP BY clause for aggregate SELECT expressions.",
          "title": "Group By"
        },
        "operation": {
          "const": "list_table_records",
          "default": "list_table_records",
          "title": "Operation",
          "type": "string"
        },
        "table_id": {
          "description": "Six-character Caspio identifier returned by discovery; names are not identifiers.",
          "pattern": "^[A-Za-z0-9]{6}$",
          "title": "Table Id",
          "type": "string"
        }
      },
      "required": [
        "table_id"
      ],
      "title": "ListTableRecords",
      "type": "object"
    },
