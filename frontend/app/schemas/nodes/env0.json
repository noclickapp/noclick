    "Env0APIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "env0_api_key",
          "default": "env0_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key_id": {
          "title": "API Key ID",
          "type": "string",
          "ui:sensitive": true,
          "ui:widget": "password"
        },
        "api_key_secret": {
          "title": "API Key Secret",
          "type": "string",
          "ui:sensitive": true,
          "ui:widget": "password"
        },
        "approved_resources_json": {
          "default": "{\"organizations\":[],\"projects\":[],\"environments\":[],\"deployments\":[]}",
          "description": "Existing IDs grouped by organizations, projects, environments and deployments. At most 50 per kind.",
          "title": "Approved Resource IDs",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "include_labels": {
          "default": false,
          "description": "Opt in to organization, project and environment names. Configuration, logs, plans, variables, user data and links remain omitted.",
          "title": "Include Resource Names",
          "type": "boolean"
        }
      },
      "required": [
        "api_key_id",
        "api_key_secret"
      ],
      "title": "env zero API Key",
      "type": "object",
      "x-credential-instructions": "Enter an existing API key ID and secret. Organization keys and personal keys have different permissions. Catalog access does not identify a principal or prove organization ownership.",
      "x-help-url": "https://docs.envzero.com/api-reference/organization/list-organizations"
    },
