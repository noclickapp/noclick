{
  "$defs": {
    "UserbackAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "userback_api_token",
          "default": "userback_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Userback API Token",
      "type": "object",
      "x-credential-instructions": "Paste your Userback REST API token from the token page linked in the authentication documentation. An API-enabled account and Admin permissions are required. NoClick sends it as a Bearer token to rest.userback.io and lists projects to check the connection.",
      "x-credential-url": "https://docs.userback.io/reference/authentication"
    },
    "UserbackCreateCommentConfig": {
      "additionalProperties": false,
      "description": "Comment on a feedback.",
      "properties": {
        "operation": {
          "const": "create_comment",
          "default": "create_comment",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "feedbackId": {
          "description": "ID is a generic type that is used to represent a unique identifier",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Feedbackid",
          "type": "integer"
        },
        "replyCommentId": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID is a generic type that is used to represent a unique identifier",
          "title": "Replycommentid"
        },
        "comment": {
          "description": "The contents of the comment.",
          "maxLength": 65535,
          "pattern": ".*",
          "title": "Comment",
          "type": "string"
        },
        "userId": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID is a generic type that is used to represent a unique identifier",
          "title": "Userid"
        },
        "isPublic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If true, the comment is public and visible to all users.",
          "title": "Ispublic"
        },
        "guestEmail": {
          "anyOf": [
            {
              "maxLength": 255,
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The email of the ananymous user who created the comment, if defined.",
          "title": "Guestemail"
        },
        "guestName": {
          "anyOf": [
            {
              "maxLength": 255,
              "pattern": ".*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The name of the ananymous user who created the comment, if defined.",
          "title": "Guestname"
        }
      },
      "required": [
        "feedbackId",
        "comment"
      ],
      "title": "UserbackCreateCommentConfig",
      "type": "object"
    },
    "UserbackCreateFeedbackConfig": {
      "additionalProperties": false,
      "description": "Create a feedback.",
      "properties": {
        "operation": {
          "const": "create_feedback",
          "default": "create_feedback",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "projectId": {
          "description": "ID is a generic type that is used to represent a unique identifier",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Projectid",
          "type": "integer"
        },
        "email": {
          "description": "The email of the user who submitted the Feedback",
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
          "title": "Email",
          "type": "string"
        },
        "feedbackType": {
          "description": "The type of feedback that was given.",
          "enum": [
            "General",
            "Bug",
            "Idea"
          ],
          "title": "Feedbacktype",
          "type": "string"
        },
        "title": {
          "description": "The title provided by the user submitting the Feedback",
          "maxLength": 255,
          "minLength": 0,
          "pattern": ".*",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "The description provided by the user submitting the Feedback",
          "maxLength": 65535,
          "minLength": 0,
          "pattern": ".*",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 0,
              "pattern": ".*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The name of the user who submitted the Feedback",
          "title": "Name"
        },
        "pageUrl": {
          "anyOf": [
            {
              "maxLength": 65535,
              "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The url of the page where the feedback was submitted",
          "title": "Pageurl"
        },
        "isShared": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isshared"
        },
        "allowPublicComment": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If true, public comments are allowed to be posted on the feedback",
          "title": "Allowpubliccomment"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "low",
                "neutral",
                "high",
                "urgent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority",
          "enum": [
            "low",
            "neutral",
            "high",
            "urgent"
          ],
          "x-enum-searchable": true
        },
        "category": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": ".*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If defined, the category the feedback was assigned to",
          "title": "Category"
        },
        "rating": {
          "anyOf": [
            {
              "maxLength": 255,
              "pattern": "^star_[1-5]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defines the rating given by the user submitting the feedback",
          "title": "Rating"
        },
        "assigneeId": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID is a generic type that is used to represent a unique identifier",
          "title": "Assigneeid"
        },
        "dueDate": {
          "anyOf": [
            {
              "maxLength": 255,
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Define the due date of the feedback",
          "title": "Duedate"
        },
        "notify": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If set to false, notifications to Email, Instant Messengers and Auto-Reply will be supressed.",
          "title": "Notify"
        }
      },
      "required": [
        "projectId",
        "email",
        "feedbackType",
        "title",
        "description"
      ],
      "title": "UserbackCreateFeedbackConfig",
      "type": "object"
    },
    "UserbackCreateWorkflowConfig": {
      "additionalProperties": false,
      "description": "Create a workflow.",
      "properties": {
        "operation": {
          "const": "create_workflow",
          "default": "create_workflow",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "description": "The name of the workflow",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\w\\-\\s\\.\\!\\#]+$",
          "title": "Name",
          "type": "string"
        },
        "color": {
          "description": "The color of the workflow in a hex format",
          "maxLength": 7,
          "pattern": "^#([A-F0-9]{6}|[A-F0-9]{3})$",
          "title": "Color",
          "type": "string"
        },
        "projectId": {
          "description": "ID is a generic type that is used to represent a unique identifier",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Projectid",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "color",
        "projectId"
      ],
      "title": "UserbackCreateWorkflowConfig",
      "type": "object"
    },
