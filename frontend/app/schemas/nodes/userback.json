    "UserbackListCommentsConfig": {
      "additionalProperties": false,
      "description": "List comments from a feedback.",
      "properties": {
        "page": {
          "default": 1,
          "description": "Page number; each execution reads one page.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 25,
          "description": "Maximum records per page.",
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "sort": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 4,
              "pattern": "^[a-zA-Z0-9_]+,(asc|desc)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Field and direction, for example id,desc.",
          "title": "Sort"
        },
        "filter": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Userback OData filter expression.",
          "title": "Filter"
        },
        "operation": {
          "const": "list_comments",
          "default": "list_comments",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
