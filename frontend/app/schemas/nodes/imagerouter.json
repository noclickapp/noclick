{
  "$defs": {
    "ChatCompletion": {
      "additionalProperties": false,
      "description": "Create a non-streaming chat completion with a text or multimodal model.",
      "properties": {
        "operation": {
          "const": "create_chat_completion",
          "default": "create_chat_completion",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        }
      },
      "required": [
        "model",
        "messages"
      ],
      "title": "ChatCompletion",
      "type": "object"
    },
    "CreateResponse": {
      "additionalProperties": false,
      "description": "Create a non-streaming response from text or structured input items.",
      "properties": {
        "operation": {
          "const": "create_response",
          "default": "create_response",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/ResponseInput"
              },
              "type": "array"
            }
          ],
          "description": "Text prompt or OpenAI-compatible role/content input items.",
          "title": "Input"
        }
      },
      "required": [
        "model",
        "input"
      ],
      "title": "CreateResponse",
      "type": "object"
    },
    "DescribeImage": {
      "additionalProperties": false,
      "description": "Ask a vision-capable chat model about an image.",
      "properties": {
        "operation": {
          "const": "describe_image",
          "default": "describe_image",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "model": {
          "description": "A vision-capable model ID from ImageRouter.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt": {
          "description": "Question about the image.",
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "image_url": {
          "description": "HTTPS image URL or image data URI.",
          "format": "uri",
          "minLength": 1,
          "title": "Image Url",
          "type": "string"
        }
      },
      "required": [
        "model",
        "prompt",
        "image_url"
      ],
      "title": "DescribeImage",
      "type": "object"
    },
    "GenerateImage": {
      "additionalProperties": false,
      "description": "Generate an image from a text prompt.",
      "properties": {
        "model": {
          "description": "Model ID from ImageRouter's model catalog, for example test/test for a dummy image.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "response_format": {
          "const": "url",
          "default": "url",
          "description": "Hosted media URLs expire after 30 days. Save generated media elsewhere for long-term use.",
          "title": "Response Format",
          "type": "string"
        },
        "size": {
          "default": "auto",
          "description": "Model-supported WIDTHxHEIGHT or auto.",
          "title": "Size",
          "type": "string"
        },
        "quality": {
          "default": "auto",
          "enum": [
            "auto",
            "low",
            "medium",
            "high",
            "very_low",
            "xhigh",
            "max"
          ],
          "title": "Quality",
          "type": "string"
        },
        "output_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model-supported output format, e.g. webp, jpeg or png.",
          "title": "Output Format"
        },
        "operation": {
          "const": "generate_image",
          "default": "generate_image",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "model"
      ],
      "title": "GenerateImage",
      "type": "object"
    },
    "GenerateImageFromImage": {
      "additionalProperties": false,
      "description": "Transform an image using the image-generation JSON endpoint.",
      "properties": {
        "model": {
          "description": "Model ID from ImageRouter's model catalog, for example test/test for a dummy image.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "response_format": {
          "const": "url",
          "default": "url",
          "description": "Hosted media URLs expire after 30 days. Save generated media elsewhere for long-term use.",
          "title": "Response Format",
          "type": "string"
        },
        "size": {
          "default": "auto",
          "description": "Model-supported WIDTHxHEIGHT or auto.",
          "title": "Size",
          "type": "string"
        },
        "quality": {
          "default": "auto",
          "enum": [
            "auto",
            "low",
            "medium",
            "high",
            "very_low",
            "xhigh",
            "max"
          ],
          "title": "Quality",
          "type": "string"
        },
        "output_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model-supported output format, e.g. webp, jpeg or png.",
          "title": "Output Format"
        },
        "operation": {
          "const": "generate_image_from_image",
          "default": "generate_image_from_image",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "image": {
          "description": "HTTPS image URL or image data URI.",
          "format": "uri",
          "minLength": 1,
          "title": "Image",
          "type": "string"
        }
      },
      "required": [
        "model",
        "image"
      ],
      "title": "GenerateImageFromImage",
      "type": "object"
    },
    "GenerateVideo": {
      "additionalProperties": false,
      "description": "Generate a video from a text prompt.",
      "properties": {
        "model": {
          "description": "Model ID from ImageRouter's model catalog, for example test/test for a dummy image.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "response_format": {
          "const": "url",
          "default": "url",
          "description": "Hosted media URLs expire after 30 days. Save generated media elsewhere for long-term use.",
          "title": "Response Format",
          "type": "string"
        },
        "size": {
          "default": "auto",
          "description": "Model-supported WIDTHxHEIGHT or auto.",
          "title": "Size",
          "type": "string"
        },
        "quality": {
          "default": "auto",
          "enum": [
            "auto",
            "low",
            "medium",
            "high"
          ],
          "title": "Quality",
          "type": "string"
        },
        "seconds": {
          "anyOf": [
            {
              "const": "auto",
              "type": "string"
            },
            {
              "maximum": 60,
              "minimum": 1,
              "type": "number"
            }
          ],
          "default": "auto",
          "description": "Model-supported duration in seconds or auto.",
          "title": "Seconds"
        },
        "operation": {
          "const": "generate_video",
          "default": "generate_video",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "model"
      ],
      "title": "GenerateVideo",
      "type": "object"
    },
    "GenerateVideoFromImage": {
      "additionalProperties": false,
      "description": "Animate an input image using JSON video generation.",
      "properties": {
        "model": {
          "description": "Model ID from ImageRouter's model catalog, for example test/test for a dummy image.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "response_format": {
          "const": "url",
          "default": "url",
          "description": "Hosted media URLs expire after 30 days. Save generated media elsewhere for long-term use.",
          "title": "Response Format",
          "type": "string"
        },
        "size": {
          "default": "auto",
          "description": "Model-supported WIDTHxHEIGHT or auto.",
          "title": "Size",
          "type": "string"
        },
        "quality": {
          "default": "auto",
          "enum": [
            "auto",
            "low",
            "medium",
            "high"
          ],
          "title": "Quality",
          "type": "string"
        },
        "seconds": {
          "anyOf": [
            {
              "const": "auto",
              "type": "string"
            },
            {
              "maximum": 60,
              "minimum": 1,
              "type": "number"
            }
          ],
          "default": "auto",
          "description": "Model-supported duration in seconds or auto.",
          "title": "Seconds"
        },
        "operation": {
          "const": "generate_video_from_image",
          "default": "generate_video_from_image",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "image": {
          "description": "HTTPS image URL or image data URI.",
          "format": "uri",
          "minLength": 1,
          "title": "Image",
          "type": "string"
        }
      },
      "required": [
        "model",
        "image"
      ],
      "title": "GenerateVideoFromImage",
      "type": "object"
    },
    "GetCredits": {
      "additionalProperties": false,
      "description": "Read the account's remaining credits, usage and total deposits.",
      "properties": {
        "operation": {
          "const": "get_credits",
          "default": "get_credits",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetCredits",
      "type": "object"
    },
    "ImagerouterAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "imagerouter_api_key",
          "default": "imagerouter_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "ImageRouter API Key",
      "type": "object",
      "x-credential-instructions": "Create a normal API key in ImageRouter's API Keys page and paste it below. Management keys are not supported. NoClick sends Bearer authentication to api.imagerouter.io and reads your account's credit usage by API key to verify the connection.",
      "x-credential-url": "https://imagerouter.io/api-keys"
    },
    "ListAPIKeyUsage": {
      "additionalProperties": false,
      "description": "Read credit usage, spending limits and expiry broken down by API key.",
      "properties": {
        "operation": {
          "const": "list_api_key_usage",
          "default": "list_api_key_usage",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListAPIKeyUsage",
      "type": "object"
    },
    "ListModels": {
      "additionalProperties": false,
      "description": "List the legacy v1 model catalog from the pinned contract.",
      "properties": {
        "operation": {
          "const": "list_models",
          "default": "list_models",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListModels",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "content": {
          "default": null,
          "description": "Text or OpenAI-compatible multimodal content parts.",
          "title": "Content"
        }
      },
      "required": [
        "role"
      ],
      "title": "Message",
      "type": "object"
    },
    "ResponseInput": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "content": {
          "default": null,
          "title": "Content"
        }
      },
      "title": "ResponseInput",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_chat_completion": "#/$defs/ChatCompletion",
          "create_response": "#/$defs/CreateResponse",
          "describe_image": "#/$defs/DescribeImage",
          "generate_image": "#/$defs/GenerateImage",
          "generate_image_from_image": "#/$defs/GenerateImageFromImage",
          "generate_video": "#/$defs/GenerateVideo",
          "generate_video_from_image": "#/$defs/GenerateVideoFromImage",
          "get_credits": "#/$defs/GetCredits",
          "list_api_key_usage": "#/$defs/ListAPIKeyUsage",
          "list_models": "#/$defs/ListModels"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GenerateImage"
        },
        {
          "$ref": "#/$defs/GenerateImageFromImage"
        },
        {
          "$ref": "#/$defs/DescribeImage"
        },
        {
          "$ref": "#/$defs/GenerateVideo"
        },
        {
          "$ref": "#/$defs/GenerateVideoFromImage"
        },
        {
          "$ref": "#/$defs/ChatCompletion"
        },
        {
          "$ref": "#/$defs/CreateResponse"
        },
        {
          "$ref": "#/$defs/ListModels"
        },
        {
          "$ref": "#/$defs/GetCredits"
        },
        {
          "$ref": "#/$defs/ListAPIKeyUsage"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImagerouterAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Imagerouter Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
