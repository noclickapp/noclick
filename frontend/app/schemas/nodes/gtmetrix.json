        "tag_id": {
          "minLength": 1,
          "title": "Tag ID",
          "type": "string"
        },
        "operation": {
          "const": "update_tag",
          "default": "update_tag",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "tag_id"
      ],
      "title": "GTmetrixUpdateTagConfig",
      "type": "object"
    }
