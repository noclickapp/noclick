          "type": "array"
        },
        "operation": {
          "const": "attach_tag_pages",
          "default": "attach_tag_pages",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "tag_id",
        "page_ids"
      ],
      "title": "GTmetrixAttachTagPagesConfig",
      "type": "object"
    },
    "GTmetrixCreateTagConfig": {
