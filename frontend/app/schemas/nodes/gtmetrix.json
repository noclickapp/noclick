    "GTmetrixListTestsConfig": {
      "additionalProperties": false,
      "description": "Read one page of tests.",
      "properties": {
        "page_size": {
          "default": 50,
          "maximum": 500,
          "minimum": 1,
          "title": "Page size",
          "type": "integer"
        },
        "page_number": {
          "default": 1,
          "description": "One page is returned. Increment to read the next page; provider links and metadata are preserved.",
          "minimum": 1,
          "title": "Page number",
          "type": "integer"
        },
        "operation": {
          "const": "list_tests",
          "default": "list_tests",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "api",
                "on-demand",
                "monitored",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source",
          "enum": [
            "api",
            "on-demand",
            "monitored",
            "any"
          ],
          "x-enum-searchable": true
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "queued",
                "started",
                "completed",
                "error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State",
          "enum": [
            "queued",
            "started",
            "completed",
            "error"
          ],
          "x-enum-searchable": true
        }
