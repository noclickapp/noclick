        "page_size": {
          "default": 50,
          "maximum": 500,
          "minimum": 1,
          "title": "Page size",
          "type": "integer"
        },
        "page_number": {
          "default": 1,
          "description": "One page is returned. Increment to read the next page; provider links and metadata are preserved.",
          "minimum": 1,
          "title": "Page number",
          "type": "integer"
        },
        "page_id": {
          "minLength": 1,
          "title": "Page ID",
          "type": "string"
        },
        "operation": {
          "const": "list_page_alert_events",
          "default": "list_page_alert_events",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "page_id"
      ],
