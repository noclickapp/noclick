    },
    "GTmetrixStartTestConfig": {
      "additionalProperties": false,
      "description": "Queue a performance test. This spends GTmetrix API credits.",
      "properties": {
        "operation": {
          "const": "start_test",
          "default": "start_test",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "url": {
          "description": "Absolute HTTP or HTTPS URL to test.",
          "title": "Page URL",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location ID"
        },
        "browser": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Browser ID"
        },
        "report": {
          "default": "lighthouse",
          "enum": [
            "lighthouse",
            "legacy",
            "lighthouse,legacy",
            "none"
          ],
          "title": "Report",
          "type": "string"
        },
        "retention": {
          "default": 1,
          "description": "Retention in months; longer retention costs extra credits.",
          "enum": [
            1,
            6,
            12,
            24
          ],
          "title": "Retention",
          "type": "integer"
        },
        "adblock": {
          "default": false,
          "title": "Adblock",
          "type": "boolean"
        },
        "video": {
          "default": false,
          "description": "Record video, costing extra credits.",
          "title": "Video",
          "type": "boolean"
        },
        "stop_onload": {
          "default": false,
          "title": "Stop Onload",
          "type": "boolean"
        },
        "throttle": {
          "anyOf": [
            {
              "pattern": "^\\d+/\\d+/\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Download/upload Kbps/latency ms.",
          "title": "Throttle"
        },
        "simulate_device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simulated device ID"
        }
      },
      "required": [
        "url"
      ],
      "title": "GTmetrixStartTestConfig",
      "type": "object"
    },
    "GTmetrixUpdatePageMonitoringConfig": {
