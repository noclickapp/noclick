{
  "$defs": {
    "GTmetrixAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "gtmetrix_api_key",
          "default": "gtmetrix_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Gtmetrix API Key",
      "type": "object",
      "x-credential-instructions": "Paste your API key from GTmetrix API Details or Account Settings. NoClick sends it as the Basic username with a blank password. Test and retest operations spend GTmetrix API credits; plan and team-role restrictions apply.",
      "x-credential-url": "https://gtmetrix.com/api/docs/2.0/"
    },
    "GTmetrixAttachTagPagesConfig": {
