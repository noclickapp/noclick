          "default": "update_page_monitoring",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "frequency": {
          "description": "none disables monitoring; enabling monitoring uses the account allowance.",
          "enum": [
            "none",
            "no",
            "hourly",
            "daily",
            "weekly",
            "monthly"
          ],
          "title": "Frequency",
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "frequency"
      ],
      "title": "GTmetrixUpdatePageMonitoringConfig",
      "type": "object"
    },
