          "default": null,
          "title": "Description"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^[A-Fa-f0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Six hex digits without #.",
          "title": "Color"
        },
        "operation": {
          "const": "create_tag",
          "default": "create_tag",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
