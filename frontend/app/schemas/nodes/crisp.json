{
  "$defs": {
    "AddNote": {
      "description": "Add a private note to a Crisp conversation: the team sees it in the inbox, the visitor never does.",
      "properties": {
        "session_id": {
          "description": "The conversation's session_id (session_\u2026), as the trigger and list_conversations give it.",
          "pattern": "^session_[0-9a-fA-F-]{36}$",
          "title": "Session ID",
          "type": "string"
        },
        "operation": {
          "const": "add_note",
          "default": "add_note",
          "title": "Add Private Note",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Messages",
          "x-display-name": "Add Private Note",
          "x-is-trigger": false
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string",
          "ui:widget": "textarea"
        }
      },
      "required": [
        "session_id",
        "note"
      ],
      "title": "AddNote",
      "type": "object"
    },
    "AssignConversation": {
      "description": "Assign a Crisp conversation to a teammate (an operator), e.g. to hand it to a human.",
      "properties": {
        "session_id": {
          "description": "The conversation's session_id (session_\u2026), as the trigger and list_conversations give it.",
          "pattern": "^session_[0-9a-fA-F-]{36}$",
          "title": "Session ID",
          "type": "string"
        },
        "operation": {
          "const": "assign_conversation",
          "default": "assign_conversation",
          "title": "Assign Conversation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Conversations",
          "x-display-name": "Assign Conversation",
          "x-is-trigger": false
        },
        "operator_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Operator",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "operator_id",
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "session_id",
        "operator_id"
      ],
      "title": "AssignConversation",
      "type": "object"
    },
    "CrispAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "crisp_website_token",
          "default": "crisp_website_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "website_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Website ID",
          "type": "string"
        },
        "identifier": {
          "minLength": 1,
          "title": "Token Identifier",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Token Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "website_id",
        "identifier",
        "key"
      ],
      "title": "Crisp API Token",
      "type": "object",
      "x-credential-instructions": "In Crisp, a workspace owner opens Settings \u2192 Workspace Settings \u2192 Advanced configuration \u2192 API Token and clicks Generate Token, then copies its Identifier and Key (Crisp shows the key once). If the workspace already has a token, use that one: generating a new one replaces it everywhere it's used. The Website ID is the CRISP_WEBSITE_ID in your chat widget's code. For chats to wake an agent, also add the NoClick plugin to the workspace (the trigger's status links it).",
      "x-credential-url": "https://docs.crisp.chat/guides/rest-api/authentication/website-token/"
    },
    "GetContact": {
      "description": "Get a contact's Crisp profile (name, company, segments, notes) by email or people_id.",
      "properties": {
        "operation": {
          "const": "get_contact",
          "default": "get_contact",
          "title": "Get Contact",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Contacts",
          "x-display-name": "Get Contact",
          "x-is-trigger": false
        },
        "people_id": {
          "description": "The contact's email, or the people_id a conversation names.",
          "minLength": 1,
          "pattern": "^[^/?#\\s]+$",
          "title": "Email or People ID",
          "type": "string"
        }
      },
      "required": [
        "people_id"
      ],
      "title": "GetContact",
      "type": "object"
    },
    "GetConversation": {
      "description": "Get a Crisp conversation: its state, assignee, unread counts, last message and the visitor's details.",
      "properties": {
        "session_id": {
          "description": "The conversation's session_id (session_\u2026), as the trigger and list_conversations give it.",
          "pattern": "^session_[0-9a-fA-F-]{36}$",
          "title": "Session ID",
          "type": "string"
        },
        "operation": {
          "const": "get_conversation",
          "default": "get_conversation",
          "title": "Get Conversation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Conversations",
          "x-display-name": "Get Conversation",
          "x-is-trigger": false
        }
      },
      "required": [
        "session_id"
      ],
      "title": "GetConversation",
      "type": "object"
    },
    "GetMessages": {
      "description": "Read a Crisp conversation's messages, the latest batch first; from \"user\" is the visitor, \"operator\" the team (and NoClick).",
      "properties": {
        "session_id": {
          "description": "The conversation's session_id (session_\u2026), as the trigger and list_conversations give it.",
          "pattern": "^session_[0-9a-fA-F-]{36}$",
          "title": "Session ID",
          "type": "string"
        },
        "operation": {
          "const": "get_messages",
          "default": "get_messages",
          "title": "Get Messages",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Messages",
          "x-display-name": "Get Messages",
          "x-is-trigger": false
        },
        "before_timestamp": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unix ms: return the batch before it, to page back through older messages.",
          "title": "Before Timestamp"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "GetMessages",
      "type": "object"
    },
    "GetVisitor": {
      "description": "Get who is writing in a Crisp conversation: name, email, phone, segments, custom data, location and device.",
      "properties": {
        "session_id": {
          "description": "The conversation's session_id (session_\u2026), as the trigger and list_conversations give it.",
          "pattern": "^session_[0-9a-fA-F-]{36}$",
          "title": "Session ID",
          "type": "string"
        },
        "operation": {
          "const": "get_visitor",
          "default": "get_visitor",
          "title": "Get Visitor Details",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Contacts",
          "x-display-name": "Get Visitor Details",
          "x-is-trigger": false
        }
      },
      "required": [
        "session_id"
      ],
      "title": "GetVisitor",
      "type": "object"
    },
    "GetWebsite": {
      "description": "Get the connected Crisp workspace: its name and domain.",
      "properties": {
        "operation": {
          "const": "get_website",
          "default": "get_website",
          "title": "Get Workspace",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Workspace",
          "x-display-name": "Get Workspace",
          "x-is-trigger": false
        }
      },
      "title": "GetWebsite",
      "type": "object"
    },
    "ListConversations": {
      "description": "List or search the workspace's Crisp conversations, most recently active first.",
      "properties": {
        "operation": {
          "const": "list_conversations",
          "default": "list_conversations",
          "title": "List Conversations",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Conversations",
          "x-display-name": "List Conversations",
          "x-is-trigger": false
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 20,
          "description": "20 to 50 conversations per page.",
          "maximum": 50,
          "minimum": 20,
          "title": "Per Page",
          "type": "integer"
        },
        "search": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text to find in messages, names or emails.",
          "title": "Search"
        },
        "status": {
          "default": "all",
          "enum": [
            "all",
            "unresolved",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "unread_only": {
          "default": "false",
          "enum": [
            "true",
            "false"
          ],
          "enumNames": [
            "Yes",
            "No"
          ],
          "title": "Unread Only",
          "type": "string",
          "x-enum-searchable": true
        },
        "unassigned_only": {
          "default": "false",
          "enum": [
            "true",
            "false"
          ],
          "enumNames": [
            "Yes",
            "No"
          ],
          "title": "Unassigned Only",
          "type": "string",
          "x-enum-searchable": true
        }
      },
      "title": "ListConversations",
      "type": "object"
    },
    "ListOperators": {
      "description": "List the workspace's teammates (operators) with their user_id, name, role and availability.",
      "properties": {
        "operation": {
          "const": "list_operators",
          "default": "list_operators",
          "title": "List Teammates",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Team",
          "x-display-name": "List Teammates",
          "x-is-trigger": false
        }
      },
      "title": "ListOperators",
      "type": "object"
    },
    "OnVisitorMessage": {
      "description": "Wake when a visitor sends a message in a Crisp conversation. The team's replies and notes, and messages NoClick sent, never fire it.",
      "properties": {
        "operation": {
          "const": "on_visitor_message",
          "default": "on_visitor_message",
          "title": "On Visitor Message",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On Visitor Message",
          "x-is-trigger": true
        },
        "subscription_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "ui:loadValue": true,
          "ui:widget": "subscription_status"
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "trigger_action": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Action",
          "ui:hidden": true
        }
      },
      "title": "OnVisitorMessage",
      "type": "object"
    },
    "SendFile": {
      "description": "Send the visitor a file in a Crisp conversation, from a public URL.",
      "properties": {
        "session_id": {
          "description": "The conversation's session_id (session_\u2026), as the trigger and list_conversations give it.",
          "pattern": "^session_[0-9a-fA-F-]{36}$",
          "title": "Session ID",
          "type": "string"
        },
        "operation": {
          "const": "send_file",
          "default": "send_file",
          "title": "Send File",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Messages",
          "x-display-name": "Send File",
          "x-is-trigger": false
        },
        "file_url": {
          "description": "Public HTTPS URL of the file.",
          "pattern": "^https://",
          "title": "File URL",
          "type": "string"
        },
        "file_name": {
          "description": "Shown to the visitor, e.g. invoice.pdf.",
          "minLength": 1,
          "title": "File Name",
          "type": "string"
        },
        "mime_type": {
          "description": "e.g. application/pdf or image/png.",
          "minLength": 1,
          "title": "MIME Type",
          "type": "string"
        },
        "sender_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name the visitor sees on the message. Empty: the workspace's.",
          "title": "Sender Name"
        }
      },
      "required": [
        "session_id",
        "file_url",
        "file_name",
        "mime_type"
      ],
      "title": "SendFile",
      "type": "object"
    },
    "SendMessage": {
      "description": "Reply to the visitor in a Crisp conversation, as the team.",
      "properties": {
        "session_id": {
          "description": "The conversation's session_id (session_\u2026), as the trigger and list_conversations give it.",
          "pattern": "^session_[0-9a-fA-F-]{36}$",
          "title": "Session ID",
          "type": "string"
        },
        "operation": {
          "const": "send_message",
          "default": "send_message",
          "title": "Send Message",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Messages",
          "x-display-name": "Send Message",
          "x-is-trigger": false
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string",
          "ui:widget": "textarea"
        },
        "sender_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name the visitor sees on the message. Empty: the workspace's.",
          "title": "Sender Name"
        }
      },
      "required": [
        "session_id",
        "message"
      ],
      "title": "SendMessage",
      "type": "object"
    },
    "SetConversationState": {
      "description": "Resolve a Crisp conversation, or reopen it as unresolved or pending.",
      "properties": {
        "session_id": {
          "description": "The conversation's session_id (session_\u2026), as the trigger and list_conversations give it.",
          "pattern": "^session_[0-9a-fA-F-]{36}$",
          "title": "Session ID",
          "type": "string"
        },
        "operation": {
          "const": "set_conversation_state",
          "default": "set_conversation_state",
          "title": "Set Conversation State",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Conversations",
          "x-display-name": "Set Conversation State",
          "x-is-trigger": false
        },
        "state": {
          "enum": [
            "resolved",
            "unresolved",
            "pending"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "state"
      ],
      "title": "SetConversationState",
      "type": "object"
    },
    "UpdateVisitor": {
      "description": "Update a Crisp conversation's visitor details or subject; only the fields given change.",
      "properties": {
        "session_id": {
          "description": "The conversation's session_id (session_\u2026), as the trigger and list_conversations give it.",
          "pattern": "^session_[0-9a-fA-F-]{36}$",
          "title": "Session ID",
          "type": "string"
        },
        "operation": {
          "const": "update_visitor",
          "default": "update_visitor",
          "title": "Update Visitor Details",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Contacts",
          "x-display-name": "Update Visitor Details",
          "x-is-trigger": false
        },
        "nickname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "segments": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replaces the conversation's segments (tags).",
          "title": "Segments"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "UpdateVisitor",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_note": "#/$defs/AddNote",
          "assign_conversation": "#/$defs/AssignConversation",
          "get_contact": "#/$defs/GetContact",
          "get_conversation": "#/$defs/GetConversation",
          "get_messages": "#/$defs/GetMessages",
          "get_visitor": "#/$defs/GetVisitor",
          "get_website": "#/$defs/GetWebsite",
          "list_conversations": "#/$defs/ListConversations",
          "list_operators": "#/$defs/ListOperators",
          "on_visitor_message": "#/$defs/OnVisitorMessage",
          "send_file": "#/$defs/SendFile",
          "send_message": "#/$defs/SendMessage",
          "set_conversation_state": "#/$defs/SetConversationState",
          "update_visitor": "#/$defs/UpdateVisitor"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SendMessage"
        },
        {
          "$ref": "#/$defs/SendFile"
        },
        {
          "$ref": "#/$defs/AddNote"
        },
        {
          "$ref": "#/$defs/GetMessages"
        },
        {
          "$ref": "#/$defs/ListConversations"
        },
        {
          "$ref": "#/$defs/GetConversation"
        },
        {
          "$ref": "#/$defs/SetConversationState"
        },
        {
          "$ref": "#/$defs/AssignConversation"
        },
        {
          "$ref": "#/$defs/ListOperators"
        },
        {
          "$ref": "#/$defs/GetVisitor"
        },
        {
          "$ref": "#/$defs/UpdateVisitor"
        },
        {
          "$ref": "#/$defs/GetContact"
        },
        {
          "$ref": "#/$defs/GetWebsite"
        },
        {
          "$ref": "#/$defs/OnVisitorMessage"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/CrispAPITokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Crisp Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
