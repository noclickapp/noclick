{
  "$defs": {
    "BandsintownAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "bandsintown_api_key",
          "default": "bandsintown_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Application ID (API key)",
          "type": "string",
          "ui:widget": "password"
        },
        "artist_name": {
          "description": "Canonical name of the artist this key can access; also used for the connection check.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Artist name",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "artist_name"
      ],
      "title": "Bandsintown API Key",
      "type": "object",
      "x-credential-instructions": "In Bandsintown for Artists, open your artist's Settings, then General, and copy the API Key. Paste it as the application ID and enter that artist's canonical name. Keys are artist-specific unless Bandsintown approves broader access. These reads verify reachability, not account identity or ownership.",
      "x-credential-url": "https://www.artists.bandsintown.com/support/api-installation"
    },
    "GetArtistByIDConfig": {
      "description": "Get an artist profile using its confirmed Bandsintown ID.",
      "properties": {
        "operation": {
          "const": "get_artist_by_id",
          "default": "get_artist_by_id",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "artist_id": {
          "description": "Artist ID from the Bandsintown artist page URL.",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[0-9]+$",
          "title": "Artist Id",
          "type": "string"
        }
      },
      "required": [
        "artist_id"
      ],
      "title": "GetArtistByIDConfig",
      "type": "object"
    },
    "GetArtistConfig": {
      "description": "Get the artist's profile, follower count, images and upcoming-event count.",
      "properties": {
        "artist_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Artist name; leave empty to use the credential's artist.",
          "title": "Artist Name"
        },
        "operation": {
          "const": "get_artist",
          "default": "get_artist",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetArtistConfig",
      "type": "object"
    },
    "ListArtistEventsConfig": {
      "description": "List tour dates with venues, ticket offers, lineups and descriptions.",
      "properties": {
        "artist_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Artist name; leave empty to use the credential's artist.",
          "title": "Artist Name"
        },
        "operation": {
          "const": "list_artist_events",
          "default": "list_artist_events",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "date": {
          "default": "upcoming",
          "description": "Use upcoming, past, all, or an inclusive YYYY-MM-DD,YYYY-MM-DD range.",
          "examples": [
            "upcoming",
            "past",
            "all",
            "2015-05-05,2017-05-05"
          ],
          "title": "Event date filter",
          "type": "string"
        }
      },
      "title": "ListArtistEventsConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_artist": "#/$defs/GetArtistConfig",
          "get_artist_by_id": "#/$defs/GetArtistByIDConfig",
          "list_artist_events": "#/$defs/ListArtistEventsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetArtistConfig"
        },
        {
          "$ref": "#/$defs/ListArtistEventsConfig"
        },
        {
          "$ref": "#/$defs/GetArtistByIDConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/BandsintownAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Bandsintown Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
