{
  "$defs": {
    "TrackViaCreateRecordConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_record",
          "default": "create_record",
          "title": "Create Record",
          "type": "string",
          "ui:hidden": true
        },
        "view_id": {
          "minimum": 1,
          "title": "View ID",
          "type": "integer"
        },
        "data": {
          "description": "One object of field names and values, e.g. [{\"Field A\": \"Some Text\", \"Field B\": 12345}].",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Record Fields",
          "type": "array",
          "ui:widget": "textarea"
        }
      },
      "required": [
        "view_id",
        "data"
      ],
      "title": "TrackViaCreateRecordConfig",
      "type": "object"
    },
    "TrackViaCreateUserConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_user",
          "default": "create_user",
          "title": "Create User",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "format": "email",
          "title": "Email",
          "type": "string"
        },
        "first_name": {
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "minLength": 1,
          "title": "Last Name",
          "type": "string"
        },
        "time_zone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Zone"
        }
      },
      "required": [
        "email",
        "first_name",
        "last_name"
      ],
      "title": "TrackViaCreateUserConfig",
      "type": "object"
    },
    "TrackViaDeleteAllAttachmentsConfig": {
