    "TrackViaTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "trackvia_api_token",
          "default": "trackvia_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "title": "Auth Token",
          "type": "string",
          "ui:widget": "password"
        },
        "user_key": {
          "title": "Account API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional account-id header for an account selection.",
          "title": "Account ID"
        },
        "api_base_url": {
          "default": "https://go.trackvia.com",
          "description": "HTTPS URL of your TrackVia tenant, without /openapi.",
          "title": "TrackVia Tenant URL",
          "type": "string"
        }
      },
      "required": [
        "access_token",
        "user_key"
      ],
      "title": "TrackVia API Token",
      "type": "object",
      "x-credential-instructions": "In TrackVia Account Settings \u2192 API Access, copy your account API key and an active API user's auth token. Paste them below. Tokens expire on the date chosen by your administrator; replace expired tokens here. If needed, enter the account ID and your custom TrackVia tenant URL.",
      "x-credential-url": "https://developer.trackvia.com/getting-started-with-the-api/tokens/"
    },
    "TrackViaUpdateRecordConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "update_record",
