  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_record": "#/$defs/TrackViaCreateRecordConfig",
          "create_user": "#/$defs/TrackViaCreateUserConfig",
          "delete_all_attachments": "#/$defs/TrackViaDeleteAllAttachmentsConfig",
          "delete_attachments": "#/$defs/TrackViaDeleteAttachmentsConfig",
          "delete_file": "#/$defs/TrackViaDeleteFileConfig",
          "delete_record": "#/$defs/TrackViaDeleteRecordConfig",
          "get_record": "#/$defs/TrackViaGetRecordConfig",
          "invoke_microservice": "#/$defs/TrackViaInvokeMicroserviceConfig",
          "invoke_microservice_query": "#/$defs/TrackViaInvokeMicroserviceQueryConfig",
          "list_apps": "#/$defs/TrackViaListAppsConfig",
          "list_microservices": "#/$defs/TrackViaListMicroservicesConfig",
          "list_records": "#/$defs/TrackViaListRecordsConfig",
          "list_users": "#/$defs/TrackViaListUsersConfig",
          "list_views": "#/$defs/TrackViaListViewsConfig",
          "search_records": "#/$defs/TrackViaSearchRecordsConfig",
          "update_record": "#/$defs/TrackViaUpdateRecordConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TrackViaListUsersConfig"
        },
        {
          "$ref": "#/$defs/TrackViaCreateUserConfig"
        },
        {
          "$ref": "#/$defs/TrackViaListAppsConfig"
        },
        {
          "$ref": "#/$defs/TrackViaListViewsConfig"
        },
        {
          "$ref": "#/$defs/TrackViaListRecordsConfig"
        },
        {
          "$ref": "#/$defs/TrackViaSearchRecordsConfig"
        },
        {
          "$ref": "#/$defs/TrackViaListMicroservicesConfig"
        },
        {
          "$ref": "#/$defs/TrackViaInvokeMicroserviceQueryConfig"
        },
        {
          "$ref": "#/$defs/TrackViaInvokeMicroserviceConfig"
        },
        {
          "$ref": "#/$defs/TrackViaCreateRecordConfig"
        },
        {
          "$ref": "#/$defs/TrackViaGetRecordConfig"
        },
        {
          "$ref": "#/$defs/TrackViaUpdateRecordConfig"
        },
        {
          "$ref": "#/$defs/TrackViaDeleteRecordConfig"
        },
        {
          "$ref": "#/$defs/TrackViaDeleteFileConfig"
        },
        {
          "$ref": "#/$defs/TrackViaDeleteAttachmentsConfig"
        },
        {
          "$ref": "#/$defs/TrackViaDeleteAllAttachmentsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrackViaTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Trackvia Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
