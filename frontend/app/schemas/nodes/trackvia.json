          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Record Fields",
          "type": "array",
          "ui:widget": "textarea"
        }
      },
      "required": [
        "view_id",
        "record_id",
        "data"
      ],
      "title": "TrackViaUpdateRecordConfig",
      "type": "object"
    }
