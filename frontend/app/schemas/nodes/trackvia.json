          "ui:hidden": true
        },
        "microservice_id": {
          "minimum": 1,
          "title": "Microservice ID",
          "type": "integer"
        },
        "param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sent as the documented param query parameter.",
          "title": "Microservice Query Value"
        }
      },
      "required": [
        "microservice_id"
      ],
      "title": "TrackViaInvokeMicroserviceQueryConfig",
      "type": "object"
    },
