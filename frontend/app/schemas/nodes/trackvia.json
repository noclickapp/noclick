    "TrackViaInvokeMicroserviceConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "invoke_microservice",
          "default": "invoke_microservice",
          "title": "Invoke Microservice",
          "type": "string",
          "ui:hidden": true
        },
        "microservice_id": {
          "minimum": 1,
          "title": "Microservice ID",
          "type": "integer"
        },
        "body": {
          "additionalProperties": true,
          "description": "JSON object expected by this microservice.",
          "title": "Microservice Body",
          "type": "object",
          "ui:widget": "textarea"
        }
      },
      "required": [
        "microservice_id",
