          "type": "string",
          "ui:hidden": true
        },
        "view_id": {
          "minimum": 1,
          "title": "View ID",
          "type": "integer"
        },
        "record_id": {
          "minimum": 1,
          "title": "Record ID",
          "type": "integer"
        },
        "field_name": {
          "minLength": 1,
          "title": "Field Name",
          "type": "string"
        },
        "attachment_ids": {
          "description": "JSON array of attachment IDs to delete from the selected field.",
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Attachment IDs",
          "type": "array",
          "ui:widget": "textarea"
        }
      },
      "required": [
        "view_id",
        "record_id",
        "field_name",
        "attachment_ids"
      ],
      "title": "TrackViaDeleteAttachmentsConfig",
      "type": "object"
    },
    "TrackViaDeleteFileConfig": {
