          "ui:hidden": true
        },
        "view_id": {
          "minimum": 1,
          "title": "View ID",
          "type": "integer"
        },
        "start": {
          "default": 0,
          "description": "Zero-based offset. Increase by max for the next page.",
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "max": {
          "default": 100,
          "maximum": 100000,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "view_id"
      ],
      "title": "TrackViaListRecordsConfig",
      "type": "object"
    },
    "TrackViaListUsersConfig": {
