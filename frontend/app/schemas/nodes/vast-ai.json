{
  "$defs": {
    "AttachSshKey": {
      "additionalProperties": false,
      "description": "Attach a public SSH key to one instance.",
      "properties": {
        "instance_id": {
          "description": "Vast.ai instance contract ID.",
          "exclusiveMinimum": 0,
          "title": "Instance Id",
          "type": "integer"
        },
        "ssh_key": {
          "description": "Public SSH key from your .pub file, never a private key.",
          "maxLength": 16384,
          "minLength": 1,
          "title": "Ssh Key",
          "type": "string"
        },
        "operation": {
          "const": "attach_ssh_key",
          "default": "attach_ssh_key",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "ssh_key"
      ],
      "title": "AttachSshKey",
      "type": "object"
    },
    "ChangeBid": {
      "additionalProperties": false,
      "description": "Change an interruptible instance's hourly bid price.",
      "properties": {
        "instance_id": {
          "description": "Vast.ai instance contract ID.",
          "exclusiveMinimum": 0,
          "title": "Instance Id",
          "type": "integer"
        },
        "operation": {
          "const": "change_bid",
          "default": "change_bid",
          "title": "Operation",
          "type": "string"
        },
        "price": {
          "maximum": 32,
          "minimum": 0.001,
          "title": "Price",
          "type": "number"
        }
      },
      "required": [
        "instance_id",
        "price"
      ],
      "title": "ChangeBid",
      "type": "object"
    },
    "CreateInstance": {
      "additionalProperties": false,
      "description": "Accept an offer and create a paid instance.",
      "properties": {
        "operation": {
          "const": "create_instance",
          "default": "create_instance",
          "title": "Operation",
          "type": "string"
        },
        "offer_id": {
          "description": "Offer ID returned by search_offers.",
          "exclusiveMinimum": 0,
          "title": "Offer Id",
          "type": "integer"
        },
        "image": {
          "description": "Docker image, for example vastai/base-image:@vastai-automatic-tag.",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "disk": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local disk size in GB; fixed for the lifetime of the instance.",
          "title": "Disk"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "runtype": {
          "anyOf": [
            {
              "enum": [
                "ssh",
                "jupyter",
                "args",
                "ssh_proxy",
                "ssh_direct",
                "jupyter_proxy",
                "jupyter_direct"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtype",
          "enum": [
            "ssh",
            "jupyter",
            "args",
            "ssh_proxy",
            "ssh_direct",
            "jupyter_proxy",
            "jupyter_direct"
          ],
          "x-enum-searchable": true
        },
        "target_state": {
          "anyOf": [
            {
              "enum": [
                "running",
                "stopped"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target State",
          "enum": [
            "running",
            "stopped"
          ],
          "x-enum-searchable": true
        },
        "price": {
          "anyOf": [
            {
              "maximum": 128,
              "minimum": 0.001,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hourly bid for interruptible instances.",
          "title": "Price"
        },
        "env": {
          "anyOf": [
            {
              "maxLength": 32768,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Docker flags for environment variables and port mappings.",
          "title": "Env"
        },
        "onstart": {
          "anyOf": [
            {
              "maxLength": 32768,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Onstart"
        },
        "cancel_unavail": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancel Unavail"
        },
        "template_hash_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Hash Id"
        }
      },
      "required": [
        "offer_id",
        "image"
      ],
      "title": "CreateInstance",
      "type": "object"
    },
    "CreateSshKey": {
      "additionalProperties": false,
