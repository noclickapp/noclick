      "properties": {
        "ssh_key": {
          "description": "Public SSH key from your .pub file, never a private key.",
          "maxLength": 16384,
          "minLength": 1,
          "title": "Ssh Key",
          "type": "string"
        },
        "operation": {
          "const": "create_ssh_key",
          "default": "create_ssh_key",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "ssh_key"
      ],
      "title": "CreateSshKey",
      "type": "object"
    },
    "DeleteSshKey": {
      "additionalProperties": false,
