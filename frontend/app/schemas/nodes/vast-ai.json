    "ListCharges": {
      "additionalProperties": false,
      "description": "Read one page of per-contract charges within a date range.",
      "properties": {
        "start_time": {
          "description": "Inclusive start, Unix seconds UTC.",
          "minimum": 0,
          "title": "Start Time",
          "type": "integer"
        },
        "end_time": {
          "description": "Inclusive end, Unix seconds UTC.",
          "minimum": 0,
          "title": "End Time",
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "after_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Previous data.next_token; omit for the first page.",
          "title": "After Token"
        },
        "operation": {
          "const": "list_charges",
          "default": "list_charges",
          "title": "Operation",
          "type": "string"
        }
