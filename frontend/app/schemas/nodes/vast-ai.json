      "required": [
        "start_time",
        "end_time"
      ],
      "title": "ListCharges",
      "type": "object"
    },
    "ListInstances": {
      "additionalProperties": false,
      "description": "Read one page of your instances; pass data.next_token as after_token.",
      "properties": {
        "operation": {
          "const": "list_instances",
          "default": "list_instances",
          "title": "Operation",
          "type": "string"
        },
        "limit": {
          "default": 25,
          "maximum": 25,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "after_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The previous response's data.next_token; omit for the first page.",
