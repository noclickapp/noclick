      "properties": {
        "instance_id": {
          "description": "Vast.ai instance contract ID.",
          "exclusiveMinimum": 0,
          "title": "Instance Id",
          "type": "integer"
        },
        "operation": {
          "const": "get_instance",
          "default": "get_instance",
          "title": "Operation",
          "type": "string"
