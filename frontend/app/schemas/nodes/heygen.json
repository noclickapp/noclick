        },
        "operation": {
          "const": "create_video",
          "default": "create_video",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "avatar_id": {
          "description": "Avatar look ID, available from HeyGen's avatar library.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Avatar Id",
          "type": "string"
        },
        "script": {
          "description": "Text for the avatar to speak.",
          "minLength": 1,
          "title": "Script",
          "type": "string"
        },
        "voice_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Voice Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "folder_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Folder Id"
        },
        "resolution": {
          "anyOf": [
            {
              "enum": [
                "720p",
                "1080p",
                "4k"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution",
          "enum": [
            "720p",
            "1080p",
            "4k"
          ],
          "x-enum-searchable": true
        },
        "aspect_ratio": {
          "default": "16:9",
          "enum": [
            "16:9",
            "9:16",
            "4:5",
            "5:4",
            "1:1",
            "auto"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "callback_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback Id"
        },
        "callback_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback Url"
        }
      },
      "required": [
        "avatar_id",
        "script",
        "voice_id"
      ],
      "title": "CreateVideo",
      "type": "object"
    },
