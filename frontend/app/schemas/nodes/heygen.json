        "operation": {
          "const": "create_translation",
          "default": "create_translation",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "video": {
          "discriminator": {
            "mapping": {
              "asset_id": "#/$defs/VideoAsset",
              "url": "#/$defs/VideoURL"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/VideoURL"
            },
            {
              "$ref": "#/$defs/VideoAsset"
            }
          ],
          "title": "Video"
        },
        "output_languages": {
          "description": "Names returned by list_translation_languages, for example English or Spanish (Spain).",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Output Languages",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "input_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Language"
        },
        "translate_audio_only": {
          "default": false,
          "title": "Translate Audio Only",
          "type": "boolean"
        },
        "mode": {
          "default": "speed",
          "enum": [
            "speed",
            "precision"
          ],
          "title": "Mode",
          "type": "string"
        },
        "callback_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback Url"
        },
        "callback_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback Id"
        }
      },
      "required": [
        "video",
        "output_languages"
      ],
      "title": "CreateTranslation",
      "type": "object"
    },
    "CreateVideo": {
      "additionalProperties": false,
      "description": "Create an avatar video from a script; returns a queued job, not a finished video.",
      "properties": {
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_:.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
