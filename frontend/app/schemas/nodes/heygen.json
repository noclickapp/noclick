{
  "$defs": {
    "CreateFolder": {
      "additionalProperties": false,
      "description": "Create folder.",
      "properties": {
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_:.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional Idempotency-Key header. Reuse the same key and body when retrying the same creation.",
          "title": "Idempotency Key"
        },
        "operation": {
          "const": "create_folder",
          "default": "create_folder",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "type": {
          "default": "mixed",
          "enum": [
            "mixed",
            "video",
            "video_translate"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateFolder",
      "type": "object"
    },
    "CreateTranslation": {
      "additionalProperties": false,
      "description": "Create translation.",
