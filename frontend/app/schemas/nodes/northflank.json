{
  "$defs": {
    "NorthflankAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "northflank_api_token",
          "default": "northflank_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "title": "Issued User or Team API Token",
          "type": "string",
          "ui:widget": "password"
        },
        "target": {
          "description": "Explicit resource context; not an assertion about the token's principal.",
          "enum": [
            "token_default",
            "team"
          ],
          "title": "Actual API Routing Context",
          "type": "string"
        },
        "team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required only for explicit team routes. Not auto-discovered or inferred.",
          "title": "Known Team ID"
        }
      },
      "required": [
        "api_token",
        "target"
      ],
      "title": "Northflank API Token",
      "type": "object",
      "x-credential-instructions": "Supply an issued user or team API token. Use token default for its authenticated context, or explicitly bind requests to a known team ID using the documented /teams/{teamId} routes. Team ID is resource routing, not a verified principal identity. Team tokens require a configured API role; choose only needed read permissions and project manage permissions if using empty-project writes. No OAuth, token mint or refresh is automated. Paid access and role permissions remain unverified.",
      "x-credential-url": "https://northflank.com/docs/v1/api/use-the-api"
    },
