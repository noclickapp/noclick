          "default": null,
          "title": "Messaging Profile Id"
        },
        "media_urls": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public media URLs for MMS.",
          "title": "Media Urls"
        },
        "type": {
          "default": "SMS",
          "enum": [
            "SMS",
            "MMS"
