    "SendMessage": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "send_message",
          "default": "send_message",
          "title": "Send Message",
          "type": "string",
          "ui:hidden": true
        },
        "from_number": {
          "description": "Authorized E.164 sender.",
          "pattern": "^\\+[1-9][0-9]{6,14}$",
          "title": "From Number",
          "type": "string"
        },
        "to": {
          "pattern": "^\\+[1-9][0-9]{6,14}$",
          "title": "To",
          "type": "string"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
