          "const": "on_file_event",
          "default": "on_file_event",
          "title": "On File Event",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "On File Created, Updated, Deleted, Renamed or Restored",
          "x-is-trigger": true
        },
        "event_type": {
          "default": "OCP\\Files\\Events\\Node\\NodeCreatedEvent",
          "enum": [
            "OCP\\Files\\Events\\Node\\NodeCreatedEvent",
            "OCP\\Files\\Events\\Node\\NodeWrittenEvent",
            "OCP\\Files\\Events\\Node\\NodeDeletedEvent",
            "OCP\\Files\\Events\\Node\\NodeRenamedEvent",
            "OCP\\Files\\Events\\Node\\NodeRestoredEvent"
          ],
          "title": "File Event",
          "type": "string"
        },
        "user_id": {
          "description": "Only events caused by this Nextcloud user. Use the account's internal user ID, which may differ from its login name.",
