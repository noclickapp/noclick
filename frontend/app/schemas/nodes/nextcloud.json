      "oneOf": [
        {
          "$ref": "#/$defs/NextcloudListFoldersConfig"
        },
        {
          "$ref": "#/$defs/NextcloudListTemplatesConfig"
        },
        {
          "$ref": "#/$defs/NextcloudGetTemplateFieldsConfig"
        },
        {
          "$ref": "#/$defs/NextcloudCreateFromTemplateConfig"
        },
        {
          "$ref": "#/$defs/NextcloudInitializeTemplatesConfig"
        },
        {
          "$ref": "#/$defs/NextcloudGetEditingCapabilitiesConfig"
        },
        {
          "$ref": "#/$defs/NextcloudListEditorTemplatesConfig"
        },
        {
          "$ref": "#/$defs/NextcloudOpenEditorConfig"
        },
        {
          "$ref": "#/$defs/NextcloudCreateForEditingConfig"
        },
        {
          "$ref": "#/$defs/NextcloudConvertFileConfig"
        },
        {
          "$ref": "#/$defs/NextcloudTransferOwnershipConfig"
        },
        {
          "$ref": "#/$defs/NextcloudAcceptTransferConfig"
        },
        {
          "$ref": "#/$defs/NextcloudRejectTransferConfig"
        },
        {
          "$ref": "#/$defs/NextcloudCreateLocalEditorConfig"
        },
        {
          "$ref": "#/$defs/NextcloudValidateLocalEditorConfig"
        },
        {
          "$ref": "#/$defs/NextcloudOnFileEventConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/NextcloudAppPasswordCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Nextcloud Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
