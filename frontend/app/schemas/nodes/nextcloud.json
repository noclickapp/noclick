          "title": "Acting User ID",
          "type": "string"
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook URL",
          "ui:copyable": true,
          "ui:loadValue": true,
          "ui:widget": "webhook"
        }
      },
      "required": [
        "user_id"
      ],
      "title": "NextcloudOnFileEventConfig",
      "type": "object",
      "x-requires-webhook": true
