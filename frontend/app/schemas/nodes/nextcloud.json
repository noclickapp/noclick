  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "accept_transfer": "#/$defs/NextcloudAcceptTransferConfig",
          "convert_file": "#/$defs/NextcloudConvertFileConfig",
          "create_for_editing": "#/$defs/NextcloudCreateForEditingConfig",
          "create_from_template": "#/$defs/NextcloudCreateFromTemplateConfig",
          "create_local_editor": "#/$defs/NextcloudCreateLocalEditorConfig",
          "get_editing_capabilities": "#/$defs/NextcloudGetEditingCapabilitiesConfig",
          "get_template_fields": "#/$defs/NextcloudGetTemplateFieldsConfig",
