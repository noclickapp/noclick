{
  "$defs": {
    "NextcloudAcceptTransferConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "accept_transfer",
          "default": "accept_transfer",
          "title": "Accept Ownership Transfer",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Accept Ownership Transfer",
          "x-is-trigger": false
        },
        "id": {
          "minimum": 1,
          "title": "Transfer ID",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "NextcloudAcceptTransferConfig",
      "type": "object"
    },
    "NextcloudAppPasswordCredential": {
      "properties": {
        "credential_type": {
          "const": "nextcloud_app_password",
          "default": "nextcloud_app_password",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "server_url": {
          "description": "Installation root, for example https://cloud.example.com/nextcloud. Public HTTPS only.",
          "title": "Nextcloud Server URL",
          "type": "string"
        },
        "username": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Username",
          "type": "string"
        },
        "app_password": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "App Password",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "server_url",
        "username",
        "app_password"
      ],
      "title": "Nextcloud App Password",
      "type": "object",
      "x-credential-instructions": "Enter your public HTTPS Nextcloud installation URL, username and an app password from Personal settings \u2192 Security \u2192 Devices & sessions. File triggers require the Webhook Listeners app and administrator or delegated Webhooks privileges. The app password is sent using HTTP Basic authentication.",
      "x-credential-url": "https://docs.nextcloud.com/server/stable/user_manual/en/session_management.html"
    },
    "NextcloudConvertFileConfig": {
