{
  "$defs": {
    "BlinqAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "blinq_api_key",
          "default": "blinq_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Blinq API Key",
      "type": "object",
      "x-credential-instructions": "In the Blinq web app, open Settings > API keys and create a key. Requires a Pro or Business plan and verified email. Select blinq:identity:read for connection verification, blinq:notes:read for notes, blinq:contacts:read for contacts, blinq:cards:read for cards, and blinq:webhooks:read/write for subscriptions. Creating subscriptions also requires blinq:contacts:read. Paste the key without Bearer. Keys cannot exceed the owner's workspace permissions.",
      "x-credential-url": "https://docs.blinq.me/api-reference/introduction"
    },
    "BlinqCreateWebhookConfig": {
      "additionalProperties": false,
      "description": "Create webhook subscription.",
      "properties": {
        "operation": {
          "const": "create_webhook",
          "default": "create_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_id": {
          "description": "The workspace ID: your individual workspace, or a business workspace where you are an owner or admin. Use an `id` returned by the list workspaces endpoint.",
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "url": {
          "description": "The HTTPS destination URL for deliveries. Credentials and fragments are rejected. The stored URL is the normalized form, preserving query parameters.",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "events": {
          "description": "The events to receive. At least one is required; duplicates are stored once.",
          "items": {
            "const": "contact.created",
            "type": "string"
          },
          "minItems": 1,
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "workspace_id",
        "url",
        "events"
      ],
      "title": "BlinqCreateWebhookConfig",
      "type": "object"
    },
    "BlinqDeleteWebhookConfig": {
      "additionalProperties": false,
      "description": "Delete webhook subscription.",
      "properties": {
        "operation": {
          "const": "delete_webhook",
          "default": "delete_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_id": {
          "description": "The workspace ID: your individual workspace, or a business workspace where you are an owner or admin. Use an `id` returned by the list workspaces endpoint.",
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "subscription_id": {
          "description": "The webhook subscription ID to delete.",
          "minLength": 1,
          "title": "Subscription Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "subscription_id"
      ],
      "title": "BlinqDeleteWebhookConfig",
      "type": "object"
    },
    "BlinqGetCardConfig": {
      "additionalProperties": false,
      "description": "Get card.",
      "properties": {
        "operation": {
          "const": "get_card",
          "default": "get_card",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_id": {
          "description": "The ID of the workspace containing the card. Use an `id` from list workspaces.",
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "card_id": {
          "description": "The card ID.",
          "minLength": 1,
          "title": "Card Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "card_id"
      ],
      "title": "BlinqGetCardConfig",
      "type": "object"
    },
    "BlinqGetContactConfig": {
      "additionalProperties": false,
      "description": "Get contact.",
      "properties": {
        "operation": {
          "const": "get_contact",
          "default": "get_contact",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_id": {
          "description": "The ID of the workspace containing the contact. Use the `workspace_id` returned when listing contacts.",
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "contact_id": {
          "description": "The contact ID.",
          "minLength": 1,
          "title": "Contact Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "contact_id"
      ],
      "title": "BlinqGetContactConfig",
      "type": "object"
    },
    "BlinqGetCurrentUserConfig": {
      "additionalProperties": false,
      "description": "Get the authenticated user.",
      "properties": {
        "operation": {
          "const": "get_current_user",
          "default": "get_current_user",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "BlinqGetCurrentUserConfig",
      "type": "object"
    },
    "BlinqGetNoteConfig": {
      "additionalProperties": false,
      "description": "Get note.",
      "properties": {
        "operation": {
          "const": "get_note",
          "default": "get_note",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "The note ID.",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "BlinqGetNoteConfig",
      "type": "object"
    },
    "BlinqGetNoteTranscriptConfig": {
      "additionalProperties": false,
      "description": "Get note transcript.",
      "properties": {
        "operation": {
          "const": "get_note_transcript",
          "default": "get_note_transcript",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "The note ID.",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "BlinqGetNoteTranscriptConfig",
      "type": "object"
    },
    "BlinqListCardsConfig": {
      "additionalProperties": false,
      "description": "List cards.",
      "properties": {
        "operation": {
          "const": "list_cards",
          "default": "list_cards",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "cursor": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The `next_cursor` returned by the previous response. Omit for the first page. Keep the workspace unchanged between pages.",
          "title": "Cursor"
        },
        "limit": {
          "default": 25,
          "description": "The maximum number of cards to return per page.",
          "exclusiveMinimum": 0,
          "maximum": 50,
          "title": "Limit",
          "type": "integer"
        },
        "workspace_id": {
          "description": "The workspace ID. Use an `id` returned by the list workspaces endpoint.",
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id"
      ],
      "title": "BlinqListCardsConfig",
      "type": "object"
    },
    "BlinqListContactsConfig": {
      "additionalProperties": false,
      "description": "List contacts.",
      "properties": {
        "operation": {
          "const": "list_contacts",
          "default": "list_contacts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "cursor": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The `next_cursor` returned by the previous response. Omit for the first page. Keep filters unchanged between pages.",
          "title": "Cursor"
        },
        "search": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filters contacts using a case-insensitive substring match against card names, job titles, company names, and saved text notes.",
          "title": "Search"
        },
        "updated_at_gte": {
          "anyOf": [
            {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return contact records last updated at or after this ISO 8601 timestamp with a timezone, such as `2026-10-01T00:00:00Z` (inclusive). Deleted contacts are excluded. Changes to linked resources do not necessarily update the contact record.",
          "title": "Updated At Gte"
        },
        "created_at_gte": {
          "anyOf": [
            {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Include contacts created at or after this ISO 8601 timestamp with a timezone, such as `2026-10-01T00:00:00Z` (inclusive).",
          "title": "Created At Gte"
        },
        "created_at_lte": {
          "anyOf": [
            {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Include contacts created at or before this ISO 8601 timestamp with a timezone, such as `2026-10-31T23:59:59Z` (inclusive).",
          "title": "Created At Lte"
        },
        "limit": {
          "default": 25,
          "description": "The maximum number of contacts to return per page.",
          "exclusiveMinimum": 0,
          "maximum": 50,
          "title": "Limit",
          "type": "integer"
        },
        "workspace_id": {
          "description": "The workspace ID. Use an `id` returned by the list workspaces endpoint.",
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id"
      ],
      "title": "BlinqListContactsConfig",
      "type": "object"
    },
    "BlinqListNotesConfig": {
      "additionalProperties": false,
      "description": "List notes.",
      "properties": {
        "operation": {
          "const": "list_notes",
          "default": "list_notes",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "created_after": {
          "anyOf": [
            {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return notes created after this ISO 8601 timestamp with a timezone, such as `2026-10-01T00:00:00Z` (exclusive).",
          "title": "Created After"
        },
        "created_before": {
          "anyOf": [
            {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return notes created before this ISO 8601 timestamp with a timezone, such as `2026-11-01T00:00:00Z` (exclusive).",
          "title": "Created Before"
        },
        "updated_at_gte": {
          "anyOf": [
            {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return notes last updated at or after this ISO 8601 timestamp with a timezone, such as `2026-10-01T00:00:00Z` (inclusive). Deleted notes are excluded.",
          "title": "Updated At Gte"
        },
        "order_by": {
          "default": "created_at",
          "description": "The timestamp used to sort notes in descending order. Keep this value unchanged between pages.",
          "enum": [
            "created_at",
            "updated_at"
          ],
          "title": "Order By",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The `next_cursor` from the previous response. Omit on the first request. Keep filters and `order_by` unchanged between pages.",
          "title": "Cursor"
        },
        "limit": {
          "default": 25,
          "description": "The maximum number of notes to return per page.",
          "exclusiveMinimum": 0,
          "maximum": 50,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "BlinqListNotesConfig",
      "type": "object"
    },
    "BlinqListWebhooksConfig": {
      "additionalProperties": false,
      "description": "List webhook subscriptions.",
      "properties": {
        "operation": {
          "const": "list_webhooks",
          "default": "list_webhooks",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_id": {
          "description": "The workspace ID: your individual workspace, or a business workspace where you are an owner or admin. Use an `id` returned by the list workspaces endpoint.",
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id"
      ],
      "title": "BlinqListWebhooksConfig",
      "type": "object"
    },
    "BlinqListWorkspacesConfig": {
      "additionalProperties": false,
      "description": "List workspaces.",
      "properties": {
        "operation": {
          "const": "list_workspaces",
          "default": "list_workspaces",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "BlinqListWorkspacesConfig",
      "type": "object"
    },
    "BlinqQueryNotesConfig": {
      "additionalProperties": false,
      "description": "Ask a question about notes.",
      "properties": {
        "operation": {
          "const": "query_notes",
          "default": "query_notes",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "description": "A natural-language question. Answers draw on note titles and note bodies (the AI summary for a recording or the saved text of a typed note), not transcripts. Each note body is truncated to 8,000 UTF-16 code units.",
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "note_ids": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restricts the answer to between 1 and 8 notes you own. Omit to let the API select up to 10 of the most relevant notes automatically. IDs of inaccessible notes are ignored.",
          "title": "Note Ids"
        }
      },
      "required": [
        "query"
      ],
      "title": "BlinqQueryNotesConfig",
      "type": "object"
    },
    "BlinqSearchNotesConfig": {
      "additionalProperties": false,
      "description": "Search notes.",
      "properties": {
        "operation": {
          "const": "search_notes",
          "default": "search_notes",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "description": "Search terms to match against indexed titles and bodies, including recording summaries and saved text.",
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "description": "The maximum number of search results to return. Search does not support pagination.",
          "exclusiveMinimum": 0,
          "maximum": 25,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "BlinqSearchNotesConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_webhook": "#/$defs/BlinqCreateWebhookConfig",
          "delete_webhook": "#/$defs/BlinqDeleteWebhookConfig",
          "get_card": "#/$defs/BlinqGetCardConfig",
          "get_contact": "#/$defs/BlinqGetContactConfig",
          "get_current_user": "#/$defs/BlinqGetCurrentUserConfig",
          "get_note": "#/$defs/BlinqGetNoteConfig",
          "get_note_transcript": "#/$defs/BlinqGetNoteTranscriptConfig",
          "list_cards": "#/$defs/BlinqListCardsConfig",
          "list_contacts": "#/$defs/BlinqListContactsConfig",
          "list_notes": "#/$defs/BlinqListNotesConfig",
          "list_webhooks": "#/$defs/BlinqListWebhooksConfig",
          "list_workspaces": "#/$defs/BlinqListWorkspacesConfig",
          "query_notes": "#/$defs/BlinqQueryNotesConfig",
          "search_notes": "#/$defs/BlinqSearchNotesConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BlinqListNotesConfig"
        },
        {
          "$ref": "#/$defs/BlinqSearchNotesConfig"
        },
        {
          "$ref": "#/$defs/BlinqQueryNotesConfig"
        },
        {
          "$ref": "#/$defs/BlinqGetNoteConfig"
        },
        {
          "$ref": "#/$defs/BlinqGetNoteTranscriptConfig"
        },
        {
          "$ref": "#/$defs/BlinqGetCurrentUserConfig"
        },
        {
          "$ref": "#/$defs/BlinqListWorkspacesConfig"
        },
        {
          "$ref": "#/$defs/BlinqListContactsConfig"
        },
        {
          "$ref": "#/$defs/BlinqGetContactConfig"
        },
        {
          "$ref": "#/$defs/BlinqListCardsConfig"
        },
        {
          "$ref": "#/$defs/BlinqGetCardConfig"
        },
        {
          "$ref": "#/$defs/BlinqCreateWebhookConfig"
        },
        {
          "$ref": "#/$defs/BlinqListWebhooksConfig"
        },
        {
          "$ref": "#/$defs/BlinqDeleteWebhookConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/BlinqAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Blinq Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
