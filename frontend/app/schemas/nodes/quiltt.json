{
  "$defs": {
    "CreateProfileConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "email",
          "title": "Email"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "E.164 phone number in the US or Canada.",
          "title": "Phone"
        },
        "dateOfBirth": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date of Birth"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "maxProperties": 50,
              "minProperties": 1,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Metadata"
        },
        "uuid": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile UUID"
        },
        "operation": {
          "const": "create_profile",
          "default": "create_profile",
          "title": "Create Profile",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "CreateProfileConfig",
      "type": "object"
    },
    "CreateSubscriptionConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Subscription Name",
          "type": "string"
        },
        "targetUrl": {
          "format": "uri",
          "title": "Webhook Target URL",
          "type": "string"
        },
        "eventTypes": {
          "items": {
            "enum": [
              "profile",
              "profile.created",
              "profile.ready",
              "profile.deleted",
              "connection",
              "connection.created",
              "connection.synced",
              "connection.synced.successful",
              "connection.synced.successful.initial",
              "connection.synced.successful.historical",
              "connection.synced.errored",
              "connection.synced.errored.repairable",
              "connection.synced.errored.institution",
              "connection.synced.errored.provider",
              "connection.synced.errored.service",
              "connection.disconnected",
              "account",
              "account.created",
              "account.owners_verified",
              "account.reconnected",
              "account.verified",
              "balance",
              "balance.created",
              "statement",
              "statement.ready"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Event Types",
          "type": "array"
        },
        "disabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled"
        },
        "operation": {
          "const": "create_subscription",
          "default": "create_subscription",
          "title": "Create Subscription",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "name",
        "targetUrl",
        "eventTypes"
      ],
      "title": "CreateSubscriptionConfig",
      "type": "object"
    },
    "DeleteProfileConfig": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile ID",
          "type": "string"
        },
        "operation": {
          "const": "delete_profile",
          "default": "delete_profile",
          "description": "Permanently deletes the profile and all associated financial data. Completion can take up to 15 minutes.",
          "title": "Delete Profile",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "DeleteProfileConfig",
      "type": "object"
    },
    "DeleteSubscriptionConfig": {
      "additionalProperties": false,
      "properties": {
        "subscription_id": {
          "title": "Subscription ID",
          "type": "string"
        },
        "operation": {
          "const": "delete_subscription",
          "default": "delete_subscription",
          "title": "Delete Subscription",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "subscription_id"
      ],
      "title": "DeleteSubscriptionConfig",
      "type": "object"
    },
    "ExportConnectionConfig": {
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "title": "Connection ID",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile ID",
          "type": "string"
        },
        "operation": {
          "const": "export_connection",
          "default": "export_connection",
          "description": "Export provider credentials for direct API access. Quiltt Support must enable this feature for your environment.",
          "title": "Export Connection",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "connection_id",
        "profile_id"
      ],
      "title": "ExportConnectionConfig",
      "type": "object"
    },
    "GetProfileConfig": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile ID",
          "type": "string"
        },
        "operation": {
          "const": "get_profile",
          "default": "get_profile",
          "title": "Get Profile",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "GetProfileConfig",
      "type": "object"
    },
    "GetSubscriptionConfig": {
      "additionalProperties": false,
      "properties": {
        "subscription_id": {
          "title": "Subscription ID",
          "type": "string"
        },
        "operation": {
          "const": "get_subscription",
          "default": "get_subscription",
          "title": "Get Subscription",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "subscription_id"
      ],
      "title": "GetSubscriptionConfig",
      "type": "object"
    },
    "ImportMxConnectionConfig": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile ID",
          "type": "string"
        },
        "memberGuid": {
          "title": "MX Member GUID",
          "type": "string"
        },
        "userGuid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for the first MX import for a profile; omit on subsequent imports.",
          "title": "MX User GUID"
        },
        "externallyManaged": {
          "default": false,
          "title": "Externally Managed",
          "type": "boolean"
        },
        "operation": {
          "const": "import_mx_connection",
          "default": "import_mx_connection",
          "title": "Import Mx Connection",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "profile_id",
        "memberGuid"
      ],
      "title": "ImportMxConnectionConfig",
      "type": "object"
    },
    "ImportPlaidConnectionConfig": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile ID",
          "type": "string"
        },
        "accessToken": {
          "title": "Plaid Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "mode": {
          "default": "REALTIME",
          "enum": [
            "REALTIME",
            "BACKGROUND"
          ],
          "title": "Import Mode",
          "type": "string"
        },
        "externallyManaged": {
          "default": false,
          "title": "Externally Managed",
          "type": "boolean"
        },
        "migrateWebhook": {
          "default": true,
          "description": "Allow Quiltt to replace the webhook registered with Plaid. Set false to preserve it; syncing will be less frequent.",
          "title": "Migrate Plaid Webhook",
          "type": "boolean"
        },
        "operation": {
          "const": "import_plaid_connection",
          "default": "import_plaid_connection",
          "title": "Import Plaid Connection",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "profile_id",
        "accessToken"
      ],
      "title": "ImportPlaidConnectionConfig",
      "type": "object"
    },
    "ListProfilesConfig": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 25,
          "minimum": 1,
          "title": "Items Per Page",
          "type": "integer"
        },
        "operation": {
          "const": "list_profiles",
          "default": "list_profiles",
          "title": "List Profiles",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListProfilesConfig",
      "type": "object"
    },
    "ListSubscriptionsConfig": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "limit": {
          "default": 25,
          "minimum": 1,
          "title": "Items Per Page",
          "type": "integer"
        },
        "operation": {
          "const": "list_subscriptions",
          "default": "list_subscriptions",
          "title": "List Subscriptions",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListSubscriptionsConfig",
      "type": "object"
    },
    "QuilttApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "quiltt_api_key",
          "default": "quiltt_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API Key Secret",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Quiltt API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Quiltt environment API Key secret from Dashboard \u2192 API Keys. The key is sent as a Bearer token to api.quiltt.io. Connection verification reads profiles in that environment.",
      "x-credential-url": "https://dashboard.quiltt.dev/api-keys"
    },
    "RefreshBalanceConfig": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "title": "Account ID",
          "type": "string"
        },
        "operation": {
          "const": "refresh_balance",
          "default": "refresh_balance",
          "description": "Requests an asynchronous refresh, usually billable in production. Accepted does not mean completed; listen for balance.created.",
          "title": "Refresh Balance",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "account_id"
      ],
      "title": "RefreshBalanceConfig",
      "type": "object"
    },
    "RefreshTransactionsConfig": {
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "title": "Connection ID",
          "type": "string"
        },
        "operation": {
          "const": "refresh_transactions",
          "default": "refresh_transactions",
          "description": "Requests an asynchronous refresh; accepted does not mean completed.",
          "title": "Refresh Transactions",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "connection_id"
      ],
      "title": "RefreshTransactionsConfig",
      "type": "object"
    },
    "SearchInstitutionsConfig": {
      "additionalProperties": false,
      "properties": {
        "routingNumber": {
          "pattern": "^[0-9]{9}$",
          "title": "US Routing Number",
          "type": "string"
        },
        "operation": {
          "const": "search_institutions",
          "default": "search_institutions",
          "title": "Search Institutions",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "routingNumber"
      ],
      "title": "SearchInstitutionsConfig",
      "type": "object"
    },
    "UpdateProfileConfig": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile ID",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "email",
          "title": "Email"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "E.164 phone number in the US or Canada.",
          "title": "Phone"
        },
        "dateOfBirth": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date of Birth"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "maxProperties": 50,
              "minProperties": 1,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Metadata"
        },
        "operation": {
          "const": "update_profile",
          "default": "update_profile",
          "title": "Update Profile",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "UpdateProfileConfig",
      "type": "object"
    },
    "UpdateSubscriptionConfig": {
      "additionalProperties": false,
      "properties": {
        "subscription_id": {
          "title": "Subscription ID",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subscription Name"
        },
        "targetUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "uri",
          "title": "Webhook Target URL"
        },
        "eventTypes": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "profile",
                  "profile.created",
                  "profile.ready",
                  "profile.deleted",
                  "connection",
                  "connection.created",
                  "connection.synced",
                  "connection.synced.successful",
                  "connection.synced.successful.initial",
                  "connection.synced.successful.historical",
                  "connection.synced.errored",
                  "connection.synced.errored.repairable",
                  "connection.synced.errored.institution",
                  "connection.synced.errored.provider",
                  "connection.synced.errored.service",
                  "connection.disconnected",
                  "account",
                  "account.created",
                  "account.owners_verified",
                  "account.reconnected",
                  "account.verified",
                  "balance",
                  "balance.created",
                  "statement",
                  "statement.ready"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Types"
        },
        "disabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled"
        },
        "operation": {
          "const": "update_subscription",
          "default": "update_subscription",
          "title": "Update Subscription",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "subscription_id"
      ],
      "title": "UpdateSubscriptionConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_profile": "#/$defs/CreateProfileConfig",
          "create_subscription": "#/$defs/CreateSubscriptionConfig",
          "delete_profile": "#/$defs/DeleteProfileConfig",
          "delete_subscription": "#/$defs/DeleteSubscriptionConfig",
          "export_connection": "#/$defs/ExportConnectionConfig",
          "get_profile": "#/$defs/GetProfileConfig",
          "get_subscription": "#/$defs/GetSubscriptionConfig",
          "import_mx_connection": "#/$defs/ImportMxConnectionConfig",
          "import_plaid_connection": "#/$defs/ImportPlaidConnectionConfig",
          "list_profiles": "#/$defs/ListProfilesConfig",
          "list_subscriptions": "#/$defs/ListSubscriptionsConfig",
          "refresh_balance": "#/$defs/RefreshBalanceConfig",
          "refresh_transactions": "#/$defs/RefreshTransactionsConfig",
          "search_institutions": "#/$defs/SearchInstitutionsConfig",
          "update_profile": "#/$defs/UpdateProfileConfig",
          "update_subscription": "#/$defs/UpdateSubscriptionConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListProfilesConfig"
        },
        {
          "$ref": "#/$defs/GetProfileConfig"
        },
        {
          "$ref": "#/$defs/CreateProfileConfig"
        },
        {
          "$ref": "#/$defs/UpdateProfileConfig"
        },
        {
          "$ref": "#/$defs/DeleteProfileConfig"
        },
        {
          "$ref": "#/$defs/ListSubscriptionsConfig"
        },
        {
          "$ref": "#/$defs/GetSubscriptionConfig"
        },
        {
          "$ref": "#/$defs/CreateSubscriptionConfig"
        },
        {
          "$ref": "#/$defs/UpdateSubscriptionConfig"
        },
        {
          "$ref": "#/$defs/DeleteSubscriptionConfig"
        },
        {
          "$ref": "#/$defs/ImportMxConnectionConfig"
        },
        {
          "$ref": "#/$defs/ImportPlaidConnectionConfig"
        },
        {
          "$ref": "#/$defs/ExportConnectionConfig"
        },
        {
          "$ref": "#/$defs/RefreshBalanceConfig"
        },
        {
          "$ref": "#/$defs/RefreshTransactionsConfig"
        },
        {
          "$ref": "#/$defs/SearchInstitutionsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/QuilttApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Quiltt Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
