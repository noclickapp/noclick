{
  "$defs": {
    "BookwhenAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "bookwhen_api_token",
          "default": "bookwhen_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        },
        "check_resource": {
          "default": "events",
          "enum": [
            "events",
            "locations",
            "attachments",
            "class_passes"
          ],
          "title": "Connection read resource",
          "type": "string"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Bookwhen API Token",
      "type": "object",
      "x-credential-instructions": "Paste an existing Bookwhen v2 access token with the schedule permissions needed for these reads. NoClick sends the token as the Basic username with an empty password to api.bookwhen.com only. No token creation, refresh or OAuth flow is provided. Public schedule reads establish reachability, not user identity or account ownership.",
      "x-credential-url": "https://support.bookwhen.com/en/articles/753664-bookwhen-api"
    },
    "BookwhenCheckConfig": {
      "additionalProperties": false,
      "description": "Read one public schedule page without claiming an account identity.",
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "BookwhenCheckConfig",
      "type": "object"
    },
    "BookwhenGetAttachmentConfig": {
      "additionalProperties": false,
      "description": "Read attachment file metadata without exposing its download URL.",
      "properties": {
        "operation": {
          "const": "get_attachment",
          "default": "get_attachment",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "attachment_id": {
          "title": "Attachment Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Bookwhen ID",
            "field_name": "attachment_id",
            "placeholder": "Choose resource",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "attachment_id"
      ],
      "title": "BookwhenGetAttachmentConfig",
      "type": "object"
    },
    "BookwhenGetClassPassConfig": {
      "additionalProperties": false,
      "description": "Read one class pass without purchasing or booking it.",
      "properties": {
        "operation": {
          "const": "get_class_pass",
          "default": "get_class_pass",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "class_pass_id": {
          "title": "Class Pass Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Bookwhen ID",
            "field_name": "class_pass_id",
            "placeholder": "Choose resource",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "class_pass_id"
      ],
      "title": "BookwhenGetClassPassConfig",
      "type": "object"
    },
    "BookwhenGetEventConfig": {
      "additionalProperties": false,
      "description": "Read one event with optional safe location, ticket and attachment metadata.",
      "properties": {
        "operation": {
          "const": "get_event",
          "default": "get_event",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "event_id": {
          "title": "Event Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Bookwhen ID",
            "field_name": "event_id",
            "placeholder": "Choose resource",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "include_related": {
          "default": false,
          "description": "Request location, attachments, tickets and ticket class passes; no leader profiles.",
          "title": "Include Related",
          "type": "boolean"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "BookwhenGetEventConfig",
      "type": "object"
    },
    "BookwhenGetLocationConfig": {
      "additionalProperties": false,
      "description": "Read one selected location without following map links.",
      "properties": {
        "operation": {
          "const": "get_location",
          "default": "get_location",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "location_id": {
          "title": "Location Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Bookwhen ID",
            "field_name": "location_id",
            "placeholder": "Choose resource",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "location_id"
      ],
      "title": "BookwhenGetLocationConfig",
      "type": "object"
    },
    "BookwhenGetTicketConfig": {
      "additionalProperties": false,
      "description": "Read one ticket only within the selected event relationship.",
      "properties": {
        "operation": {
          "const": "get_ticket",
          "default": "get_ticket",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "event_id": {
          "title": "Event Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Bookwhen ID",
            "field_name": "event_id",
            "placeholder": "Choose resource",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "ticket_id": {
          "title": "Ticket Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Bookwhen ID",
            "depends_on": "event_id",
            "field_name": "ticket_id",
            "placeholder": "Choose resource",
            "searchable": false
          }
        },
        "include_related": {
          "default": false,
          "description": "Request related event and class-pass metadata.",
          "title": "Include Related",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "ticket_id"
      ],
      "title": "BookwhenGetTicketConfig",
      "type": "object"
    },
    "BookwhenListAttachmentsConfig": {
      "additionalProperties": false,
      "description": "Read attachment descriptions without returning or downloading file URLs.",
      "properties": {
        "offset": {
          "default": 0,
          "description": "Documented page[offset]; use next_offset returned by the previous page. Server default page size is 20.",
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_attachments",
          "default": "list_attachments",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "file_name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Name"
        },
        "file_type": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Type"
        }
      },
      "title": "BookwhenListAttachmentsConfig",
      "type": "object"
    },
    "BookwhenListClassPassesConfig": {
      "additionalProperties": false,
      "description": "Read public class-pass availability and usage metadata.",
      "properties": {
        "offset": {
          "default": 0,
          "description": "Documented page[offset]; use next_offset returned by the previous page. Server default page size is 20.",
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_class_passes",
          "default": "list_class_passes",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "usage_type": {
          "anyOf": [
            {
              "enum": [
                "personal",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Type",
          "enum": [
            "personal",
            "any"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "BookwhenListClassPassesConfig",
      "type": "object"
    },
    "BookwhenListEventsConfig": {
      "additionalProperties": false,
      "description": "Filter events with documented AND-combined v2 filters.",
      "properties": {
        "offset": {
          "default": 0,
          "description": "Documented page[offset]; use next_offset returned by the previous page. Server default page size is 20.",
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_events",
          "default": "list_events",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "calendar": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated calendar codes; not an ownership proof.",
          "title": "Calendar"
        },
        "entry": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated entry codes.",
          "title": "Entry"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated location IDs.",
          "title": "Location"
        },
        "tag": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "from_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive YYYYMMDD or YYYYMMDDHHMISS. If absent Bookwhen defaults to today.",
          "title": "From Time"
        },
        "to_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exclusive YYYYMMDD or YYYYMMDDHHMISS.",
          "title": "To Time"
        },
        "compact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Combine course events into one virtual event.",
          "title": "Compact"
        }
      },
      "title": "BookwhenListEventsConfig",
      "type": "object"
    },
    "BookwhenListLocationsConfig": {
      "additionalProperties": false,
      "description": "Read location metadata with documented text filters.",
      "properties": {
        "offset": {
          "default": 0,
          "description": "Documented page[offset]; use next_offset returned by the previous page. Server default page size is 20.",
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_locations",
          "default": "list_locations",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "address_text": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address Text"
        },
        "additional_info": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Additional Info"
        }
      },
      "title": "BookwhenListLocationsConfig",
      "type": "object"
    },
    "BookwhenListTicketsConfig": {
      "additionalProperties": false,
      "description": "List tickets for the selected event and verify returned event relationships.",
      "properties": {
        "offset": {
          "default": 0,
          "description": "Documented page[offset]; use next_offset returned by the previous page. Server default page size is 20.",
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_tickets",
          "default": "list_tickets",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "event_id": {
          "title": "Event Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Bookwhen ID",
            "field_name": "event_id",
            "placeholder": "Choose resource",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "event_id"
      ],
      "title": "BookwhenListTicketsConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/BookwhenCheckConfig",
          "get_attachment": "#/$defs/BookwhenGetAttachmentConfig",
          "get_class_pass": "#/$defs/BookwhenGetClassPassConfig",
          "get_event": "#/$defs/BookwhenGetEventConfig",
          "get_location": "#/$defs/BookwhenGetLocationConfig",
          "get_ticket": "#/$defs/BookwhenGetTicketConfig",
          "list_attachments": "#/$defs/BookwhenListAttachmentsConfig",
          "list_class_passes": "#/$defs/BookwhenListClassPassesConfig",
          "list_events": "#/$defs/BookwhenListEventsConfig",
          "list_locations": "#/$defs/BookwhenListLocationsConfig",
          "list_tickets": "#/$defs/BookwhenListTicketsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BookwhenCheckConfig"
        },
        {
          "$ref": "#/$defs/BookwhenListEventsConfig"
        },
        {
          "$ref": "#/$defs/BookwhenGetEventConfig"
        },
        {
          "$ref": "#/$defs/BookwhenListTicketsConfig"
        },
        {
          "$ref": "#/$defs/BookwhenGetTicketConfig"
        },
        {
          "$ref": "#/$defs/BookwhenListLocationsConfig"
        },
        {
          "$ref": "#/$defs/BookwhenGetLocationConfig"
        },
        {
          "$ref": "#/$defs/BookwhenListAttachmentsConfig"
        },
        {
          "$ref": "#/$defs/BookwhenGetAttachmentConfig"
        },
        {
          "$ref": "#/$defs/BookwhenListClassPassesConfig"
        },
        {
          "$ref": "#/$defs/BookwhenGetClassPassConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/BookwhenAPITokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Bookwhen Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
