{
  "$defs": {
    "CreateConnection": {
      "additionalProperties": false,
      "description": "Create a plugin connection; its configuration is omitted from output.",
      "properties": {
        "org_handle": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,37}[a-z0-9]$",
          "title": "Organization Handle",
          "type": "string"
        },
        "workspace_handle": {
          "pattern": "^[a-z0-9]{1,23}$",
          "title": "Workspace Handle",
          "type": "string"
        },
        "operation": {
          "const": "create_connection",
          "default": "create_connection",
          "title": "Operation",
          "type": "string"
        },
        "handle": {
          "maxLength": 39,
          "pattern": "^[a-z](?:[a-z0-9]|_[a-z0-9])*$",
          "title": "Handle",
          "type": "string"
        },
        "plugin": {
          "description": "Plugin name, for example aws.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Plugin",
          "type": "string"
        },
        "plugin_config_json": {
          "default": "{}",
          "description": "Plugin-specific configuration object. Store sensitive values in workflow secrets.",
          "maxLength": 100000,
          "title": "Plugin Configuration (JSON)",
          "type": "string",
          "ui:widget": "code_editor"
        }
      },
      "required": [
        "org_handle",
        "workspace_handle",
        "handle",
        "plugin"
      ],
      "title": "CreateConnection",
      "type": "object"
    },
    "CreateWorkspace": {
      "additionalProperties": false,
      "description": "Provision an organization workspace; provider compute/storage charges may apply.",
      "properties": {
        "desired_state": {
          "anyOf": [
            {
              "enum": [
                "enabled",
                "disabled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desired State",
          "enum": [
            "enabled",
            "disabled"
          ],
          "x-enum-searchable": true
        },
        "instance_type": {
          "anyOf": [
            {
              "enum": [
                "db1.shared",
                "db1.small",
                "db1.medium"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Type",
          "enum": [
            "db1.shared",
            "db1.small",
            "db1.medium"
          ],
          "x-enum-searchable": true
        },
        "db_volume_size_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Db Volume Size Bytes"
        },
        "org_handle": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,37}[a-z0-9]$",
          "title": "Organization Handle",
          "type": "string"
        },
        "operation": {
          "const": "create_workspace",
          "default": "create_workspace",
          "title": "Operation",
          "type": "string"
        },
        "handle": {
          "pattern": "^[a-z0-9]{1,23}$",
          "title": "New Workspace Handle",
          "type": "string"
        }
      },
      "required": [
        "org_handle",
        "handle"
      ],
      "title": "CreateWorkspace",
      "type": "object"
    },
