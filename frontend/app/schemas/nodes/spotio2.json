    "Spotio2CreateActivity": {
      "additionalProperties": false,
      "description": "Log a note or event against one record without sending a communication.",
      "properties": {
        "operation": {
          "const": "create_activity",
          "default": "create_activity",
          "title": "Operation",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "activity_type": {
          "default": "Note",
          "enum": [
            "Note",
            "Event"
          ],
          "title": "Activity Type",
          "type": "string"
        },
        "notes": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Notes",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "activity_template_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Template Id"
        },
        "owner_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Id"
        },
        "date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "done": {
          "default": false,
          "title": "Done",
          "type": "boolean"
        }
      },
      "required": [
        "record_id",
        "notes"
      ],
      "title": "Spotio2CreateActivity",
      "type": "object"
    },
    "Spotio2CreateAppointment": {
