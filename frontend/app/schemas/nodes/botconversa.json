    "BotConversaAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "botconversa_api_key",
          "default": "botconversa_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Your BotConversa API key, sent in the API-KEY header.",
