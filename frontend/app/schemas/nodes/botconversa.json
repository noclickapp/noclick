        },
        {
          "$ref": "#/$defs/FindSubscriberByPhoneConfig"
        },
        {
          "$ref": "#/$defs/CreateSubscriberConfig"
        },
        {
          "$ref": "#/$defs/SendMessageConfig"
        },
        {
          "$ref": "#/$defs/SendFlowConfig"
        },
        {
          "$ref": "#/$defs/ChangeConversationStatusConfig"
        },
        {
          "$ref": "#/$defs/SetCustomFieldConfig"
