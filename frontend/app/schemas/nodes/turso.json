{
  "$defs": {
    "CreateDatabase": {
      "additionalProperties": false,
      "description": "Create an empty database in an existing group.",
      "properties": {
        "organization_slug": {
          "description": "Organization slug, or your username for a personal organization.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Organization Slug",
          "type": "string"
        },
        "operation": {
          "const": "create_database",
          "default": "create_database",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$",
          "title": "Name",
          "type": "string"
        },
        "group": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Group",
          "type": "string"
        },
        "size_limit": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bytes or a size such as 256mb.",
          "title": "Size Limit"
        }
      },
      "required": [
        "organization_slug",
        "name",
        "group"
      ],
      "title": "CreateDatabase",
      "type": "object"
    },
