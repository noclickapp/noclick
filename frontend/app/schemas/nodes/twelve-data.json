    "BatchTimeSeries": {
      "additionalProperties": false,
      "description": "POST a batch of time-series reads, with individual outcomes preserved.",
      "properties": {
        "operation": {
          "const": "batch_time_series",
          "default": "batch_time_series",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "symbols": {
          "description": "Comma-separated symbols, e.g. AAPL,MSFT. Maximum 20 unique instruments; each consumes API credits.",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Symbols",
          "type": "string"
        },
        "interval": {
          "enum": [
            "1min",
            "5min",
            "15min",
            "30min",
            "45min",
            "1h",
            "2h",
            "4h",
            "8h",
            "1day",
            "1week",
            "1month"
          ],
          "title": "Interval",
          "type": "string"
        },
        "outputsize": {
          "default": 30,
          "maximum": 5000,
          "minimum": 1,
          "title": "Outputsize",
          "type": "integer"
        }
      },
      "required": [
        "symbols",
        "interval"
      ],
      "title": "BatchTimeSeries",
      "type": "object"
    },
