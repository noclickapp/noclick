{
  "$defs": {
    "BotsonicCreateFaqConfig": {
      "description": "Create bot faq.",
      "properties": {
        "operation": {
          "const": "create_faq",
          "default": "create_faq",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "question": {
          "description": "The question for the FAQ entry.",
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "description": "The answer to the FAQ question.",
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "title": "BotsonicCreateFaqConfig",
      "type": "object"
    },
    "BotsonicCreateStarterQuestionConfig": {
      "description": "Create starter question.",
      "properties": {
        "operation": {
          "const": "create_starter_question",
          "default": "create_starter_question",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "question": {
          "description": "a starter question",
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "description": "answer for given question",
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "order": {
          "default": 0,
          "description": "Set order in which this question appears",
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "title": "BotsonicCreateStarterQuestionConfig",
      "type": "object"
    },
    "BotsonicCredential": {
      "properties": {
        "credential_type": {
          "const": "botsonic_api_token",
          "default": "botsonic_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "description": "Paste the bot API token from Share > API Token. Business access is required.",
          "minLength": 1,
          "title": "Bot API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Botsonic API Token",
      "type": "object",
      "x-credential-instructions": "Business access is required. In Botsonic, open your bot, then Share > API Token. Paste the bot token below.",
      "x-credential-url": "https://api.botsonic.ai/docs"
    },
    "BotsonicDeleteFaqConfig": {
      "description": "Delete bot faq.",
      "properties": {
        "operation": {
          "const": "delete_faq",
          "default": "delete_faq",
