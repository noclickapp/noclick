          "list_faqs": "#/$defs/BotsonicListFaqsConfig",
          "list_starter_presets": "#/$defs/BotsonicListStarterPresetsConfig",
          "list_starter_questions": "#/$defs/BotsonicListStarterQuestionsConfig",
          "list_training_data": "#/$defs/BotsonicListTrainingDataConfig",
