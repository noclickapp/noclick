    "BotsonicListConversationsConfig": {
      "description": "Get all conversations in paginated format.",
      "properties": {
        "operation": {
          "const": "list_conversations",
          "default": "list_conversations",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "search_query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Search for data matching particluar query",
          "title": "Search Query"
        },
        "sort_by": {
          "default": "recent",
          "description": "Select conversation type to sort by",
          "enum": [
            "recent",
            "negative",
            "positive"
          ],
          "title": "Sort By",
          "type": "string"
        },
        "sort_order": {
          "default": "desc",
          "description": "Select sorting order",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Sort Order",
          "type": "string"
        },
        "updated_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter conversations updated after this datetime (ISO 8601). Example: 2024-01-01T00:00:00Z",
          "title": "Updated After"
        },
        "updated_before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter conversations updated before this datetime (ISO 8601). Example: 2024-01-01T00:00:00Z",
          "title": "Updated Before"
        },
        "page": {
          "default": 1,
          "minimum": 1.0,
          "title": "Page",
          "type": "integer"
        },
        "size": {
          "default": 50,
          "maximum": 100.0,
          "minimum": 1.0,
          "title": "Size",
          "type": "integer"
        }
      },
      "title": "BotsonicListConversationsConfig",
      "type": "object"
    },
