          "type": "string",
          "ui:hidden": true
        },
        "faq_id": {
          "description": "faq_id of specific faq to delete",
          "title": "Faq Id",
          "type": "string"
        }
      },
      "required": [
        "faq_id"
      ],
      "title": "BotsonicDeleteFaqConfig",
      "type": "object"
    },
    "BotsonicDeleteStarterQuestionConfig": {
      "description": "Delete starter question.",
      "properties": {
        "operation": {
          "const": "delete_starter_question",
          "default": "delete_starter_question",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "starter_question_id": {
          "description": "starter_question_id of specific starter question to delete",
          "title": "Starter Question Id",
          "type": "string"
        }
      },
      "required": [
        "starter_question_id"
      ],
      "title": "BotsonicDeleteStarterQuestionConfig",
      "type": "object"
    },
    "BotsonicDeleteTrainingDataConfig": {
      "description": "Delete particluar bot data.",
      "properties": {
        "operation": {
          "const": "delete_training_data",
          "default": "delete_training_data",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "data_id": {
          "description": "data_id of specific bot data to delete",
          "title": "Data Id",
          "type": "string"
        }
      },
      "required": [
        "data_id"
      ],
      "title": "BotsonicDeleteTrainingDataConfig",
      "type": "object"
    },
    "BotsonicEndChatConfig": {
      "description": "End a chat conversation.",
      "properties": {
        "operation": {
          "const": "end_chat",
          "default": "end_chat",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "chat_id": {
          "description": "chat_id of specific conversation",
          "title": "Chat Id",
          "type": "string"
        },
        "status": {
          "default": "none",
          "description": "status of chat",
          "enum": [
            "liked",
            "disliked",
            "none"
          ],
          "title": "Status",
          "type": "string"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "feedback for chat",
          "title": "Feedback"
        }
      },
      "required": [
        "chat_id"
      ],
      "title": "BotsonicEndChatConfig",
      "type": "object"
    },
    "BotsonicGenerateResponseConfig": {
      "description": "Generation endpoint supporting synchronous response.",
      "properties": {
        "operation": {
          "const": "generate_response",
          "default": "generate_response",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "input_text": {
          "description": "User question for bot",
          "minLength": 1,
          "title": "Input Text",
          "type": "string"
        },
        "chat_id": {
          "description": "chat_id for given chat",
          "title": "Chat Id",
          "type": "string"
        },
        "user_unique_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Can be passed to store some additional user data in inbox",
          "title": "User Unique Identifier"
        },
        "full_history": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "if true, will return full history of chat till now",
          "title": "Full History"
        }
      },
      "required": [
        "input_text",
        "chat_id"
      ],
      "title": "BotsonicGenerateResponseConfig",
      "type": "object"
    },
    "BotsonicGetConversationConfig": {
      "description": "Get specific conversation by chat_id.",
      "properties": {
        "operation": {
          "const": "get_conversation",
          "default": "get_conversation",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "chat_id": {
          "description": "chat_id of specific conversation",
