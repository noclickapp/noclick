{
  "$defs": {
    "CoassembleAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "coassemble_api_key",
          "default": "coassemble_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Coassemble API Key",
      "type": "object",
      "x-credential-instructions": "Copy your workspace API key from Coassemble's developer setup guide. Paste the complete COASSEMBLE:<workspaceId>:<token> value without the Authorization header name. NoClick sends it only to api.coassemble.com. Course access verifies this connection; it does not verify every write permission.",
      "x-credential-url": "https://coassemble.com/dashboard/developer?tab=overview&setup=1"
    },
    "CoassembleCreateCollectionConfig": {
      "additionalProperties": false,
      "description": "Create a collection with an ordered list of initial courses.",
      "properties": {
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "identifier": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable collection owner identifier.",
          "title": "Identifier"
        },
        "client_identifier": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Identifier"
        },
        "theme_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theme Id"
        },
        "identified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Require learner identification on the share link. Does not apply to embeds.",
          "title": "Identified"
        },
        "private": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict the share link to invited emails. Does not apply to embeds.",
          "title": "Private"
        },
        "domain": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict the share link to approved email domains. Does not apply to embeds.",
          "title": "Domain"
        },
        "domains": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domains"
        },
        "emails": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emails"
        },
        "operation": {
          "const": "create_collection",
          "default": "create_collection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "course_ids": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Initial course IDs in display order.",
          "title": "Course Ids"
        }
      },
      "required": [
        "title"
      ],
      "title": "CoassembleCreateCollectionConfig",
      "type": "object"
    },
