        "metadata_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by metadata value. Requires `metadata_key`.",
          "title": "Metadata Value"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter donations on or after this date (YYYY-MM-DD).",
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter donations on or before this date (YYYY-MM-DD, inclusive).",
          "title": "End Date"
        },
        "page": {
          "default": 1,
          "description": "Page number (1-indexed).",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 20,
          "description": "Number of results per page.",
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "title": "ListDonationsConfig",
      "type": "object"
