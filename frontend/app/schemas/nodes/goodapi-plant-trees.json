{
  "$defs": {
    "CreateDonationConfig": {
      "additionalProperties": false,
      "description": "Record a USD donation (early access). Activate donation billing first; use an idempotency key for retries.",
      "properties": {
        "operation": {
          "const": "create_donation",
          "default": "create_donation",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "amount_cents": {
          "description": "Donation amount in cents (must be > 0).",
          "minimum": 1,
          "title": "Amount Cents",
          "type": "integer"
        },
        "ein": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Employer Identification Number of the charity. At least one of `ein` or `nonprofit_id` is required.",
          "title": "Ein"
        },
        "nonprofit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider-specific nonprofit identifier. At least one of `ein` or `nonprofit_id` is required.",
          "title": "Nonprofit Id"
        },
        "charity_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable charity name. Auto-filled from the search result if omitted.",
          "title": "Charity Name"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unique key to prevent duplicate donations.",
          "title": "Idempotency Key"
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-form tag for grouping donations.",
          "title": "Attribution"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arbitrary key-value pairs stored with the donation.",
          "title": "Metadata"
        }
      },
      "required": [
        "amount_cents"
      ],
      "title": "CreateDonationConfig",
      "type": "object"
    },
    "GetDashboardUrlConfig": {
      "additionalProperties": false,
      "description": "Get the public impact dashboard URL.",
      "properties": {
        "operation": {
          "const": "get_dashboard_url",
          "default": "get_dashboard_url",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetDashboardUrlConfig",
      "type": "object"
    },
    "GetEvidenceConfig": {
      "additionalProperties": false,
      "description": "Read global planting evidence cached for 30 days; it is not filtered to your organization.",
      "properties": {
        "operation": {
          "const": "get_evidence",
          "default": "get_evidence",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetEvidenceConfig",
      "type": "object"
    },
    "GetTreeEvidenceConfig": {
      "additionalProperties": false,
      "description": "Get tree planting timeline and evidence.",
      "properties": {
        "operation": {
          "const": "get_tree_evidence",
          "default": "get_tree_evidence",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "The unique tree registration ID.",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "evidence_stage": {
          "anyOf": [
            {
              "enum": [
                "registered",
                "funds_distributed",
                "planted",
                "planted_and_verified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional testing parameter to return a mocked evidence response at a specific milestone stage (`registered`, `funds_distributed`, or `planted`). Only permitted for test API keys. Seeded from a verified Kenya planting registration.",
          "title": "Evidence Stage",
          "enum": [
            "registered",
            "funds_distributed",
            "planted",
            "planted_and_verified"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "id"
      ],
      "title": "GetTreeEvidenceConfig",
      "type": "object"
    },
    "GetTreeProjectConfig": {
      "additionalProperties": false,
      "description": "Get tree planting project by ID.",
      "properties": {
        "operation": {
          "const": "get_tree_project",
          "default": "get_tree_project",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "Project identifier (e.g. 'veritree-kenya', 'veritree-us').",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "locale": {
          "default": "en",
          "description": "Locale code for localized text (e.g. 'en', 'fr', 'de', 'es'). Defaults to 'en'.",
          "title": "Locale",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetTreeProjectConfig",
      "type": "object"
    },
    "GoodapiPlantTreesCredential": {
      "properties": {
        "credential_type": {
          "const": "goodapi_plant_trees_api_key",
          "default": "goodapi_plant_trees_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Goodapi Plant Trees API Key",
      "type": "object",
      "x-credential-instructions": "Paste your production or test API key from GoodAPI. Test keys do not generate Stripe charges. Paste only the key, without Authorization or Bearer. Live tree and plastic actions are metered; donation endpoints are early access.",
      "x-credential-url": "https://app.thegoodapi.com"
    },
    "ListDonationsConfig": {
      "additionalProperties": false,
      "description": "List donations.",
      "properties": {
        "operation": {
          "const": "list_donations",
          "default": "list_donations",
