{
  "$defs": {
    "GetAreaCopyrights": {
      "additionalProperties": false,
      "description": "Read legacy bounding-box copyrights (withdrawn by TomTom).",
      "properties": {
        "operation": {
          "const": "get_area_copyrights",
          "default": "get_area_copyrights",
          "title": "Operation",
          "type": "string"
        },
        "minLon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Minlon",
          "type": "number"
        },
        "minLat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Minlat",
          "type": "number"
        },
        "maxLon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Maxlon",
          "type": "number"
        },
        "maxLat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Maxlat",
          "type": "number"
        }
      },
      "required": [
        "minLon",
        "minLat",
        "maxLon",
        "maxLat"
      ],
      "title": "GetAreaCopyrights",
      "type": "object"
    },
    "GetCopyrightCaption": {
      "additionalProperties": false,
      "description": "Read the legacy copyright caption (withdrawn by TomTom).",
      "properties": {
        "operation": {
          "const": "get_copyright_caption",
          "default": "get_copyright_caption",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetCopyrightCaption",
      "type": "object"
    },
    "GetRasterTile": {
      "additionalProperties": false,
      "description": "Download a PNG or JPEG raster map tile.",
      "properties": {
        "zoom": {
          "default": 0,
          "maximum": 22,
          "minimum": 0,
          "title": "Zoom",
          "type": "integer"
        },
        "X": {
          "default": 0,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "Y": {
          "default": 0,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "operation": {
          "const": "get_raster_tile",
          "default": "get_raster_tile",
          "title": "Operation",
          "type": "string"
        },
        "layer": {
          "default": "basic",
          "enum": [
            "basic",
            "hybrid",
            "labels"
          ],
          "title": "Layer",
          "type": "string"
        },
        "style": {
          "default": "main",
          "enum": [
            "main",
            "night"
          ],
          "title": "Style",
          "type": "string"
        },
        "format": {
          "default": "png",
          "enum": [
            "png",
            "jpg"
          ],
          "title": "Format",
          "type": "string"
        },
        "tileSize": {
          "default": 256,
          "enum": [
            256,
            512
          ],
          "title": "Tilesize",
          "type": "integer"
        },
        "view": {
          "anyOf": [
            {
              "enum": [
                "Unified",
                "IN"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View",
          "enum": [
            "Unified",
            "IN"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "GetRasterTile",
      "type": "object"
    },
    "GetStaticImage": {
      "additionalProperties": false,
      "description": "Render a static map centered on longitude,latitude.",
      "properties": {
        "operation": {
          "const": "get_static_image",
          "default": "get_static_image",
          "title": "Operation",
          "type": "string"
        },
        "center": {
          "description": "Longitude,latitude, for example 4.899886,52.379031",
          "pattern": "^-?\\d+(?:\\.\\d+)?, *-?\\d+(?:\\.\\d+)?$",
          "title": "Center",
          "type": "string"
        },
        "zoom": {
          "default": 12,
          "maximum": 22,
          "minimum": 0,
          "title": "Zoom",
          "type": "integer"
        },
        "width": {
          "default": 512,
          "maximum": 8192,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 512,
          "maximum": 8192,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "layer": {
          "default": "basic",
          "enum": [
            "basic",
            "hybrid",
            "labels"
          ],
          "title": "Layer",
          "type": "string"
        },
        "style": {
          "default": "main",
          "enum": [
            "main",
            "night"
          ],
          "title": "Style",
          "type": "string"
        },
        "format": {
          "default": "png",
          "enum": [
            "png",
            "jpg",
            "jpeg"
          ],
          "title": "Format",
          "type": "string"
        },
        "view": {
          "anyOf": [
            {
              "enum": [
                "Unified",
                "IN"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View",
          "enum": [
            "Unified",
            "IN"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "center"
      ],
      "title": "GetStaticImage",
      "type": "object"
    },
    "GetTileCopyrights": {
      "additionalProperties": false,
      "description": "Read legacy tile copyrights (withdrawn by TomTom).",
      "properties": {
        "zoom": {
          "default": 0,
          "maximum": 18,
          "minimum": 0,
          "title": "Zoom",
          "type": "integer"
        },
        "X": {
          "default": 0,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "Y": {
          "default": 0,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "operation": {
          "const": "get_tile_copyrights",
          "default": "get_tile_copyrights",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetTileCopyrights",
      "type": "object"
    },
    "GetVectorTile": {
      "additionalProperties": false,
      "description": "Download a protobuf vector map tile.",
      "properties": {
        "zoom": {
          "default": 0,
          "maximum": 22,
          "minimum": 0,
          "title": "Zoom",
          "type": "integer"
        },
        "X": {
          "default": 0,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "Y": {
          "default": 0,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "operation": {
          "const": "get_vector_tile",
          "default": "get_vector_tile",
          "title": "Operation",
          "type": "string"
        },
        "layer": {
          "default": "basic",
          "enum": [
            "basic",
            "hybrid",
            "labels"
          ],
          "title": "Layer",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "view": {
          "anyOf": [
            {
              "enum": [
                "Unified",
                "IL",
                "IN"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View",
          "enum": [
            "Unified",
            "IL",
            "IN"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "GetVectorTile",
      "type": "object"
    },
    "GetWMSCapabilities": {
      "additionalProperties": false,
      "description": "Read WMS service capabilities as XML.",
      "properties": {
        "operation": {
          "const": "get_wms_capabilities",
          "default": "get_wms_capabilities",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetWMSCapabilities",
      "type": "object"
    },
    "GetWMSMap": {
      "additionalProperties": false,
      "description": "Render a WMS 1.1.1 map for a bounding box.",
      "properties": {
        "operation": {
          "const": "get_wms_map",
          "default": "get_wms_map",
          "title": "Operation",
          "type": "string"
        },
        "srs": {
          "default": "EPSG:4326",
          "enum": [
            "EPSG:3857",
            "EPSG:4326"
          ],
          "title": "Srs",
          "type": "string"
        },
        "bbox": {
          "description": "minX,minY,maxX,maxY in the chosen SRS",
          "pattern": "^-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?,-?\\d+(?:\\.\\d+)?$",
          "title": "Bbox",
          "type": "string"
        },
        "width": {
          "default": 512,
          "maximum": 2048,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 512,
          "maximum": 2048,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "format": {
          "default": "image/png",
          "enum": [
            "image/png",
            "image/jpeg"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "bbox"
      ],
      "title": "GetWMSMap",
      "type": "object"
    },
    "GetWMTSCapabilities": {
      "additionalProperties": false,
      "description": "Read WMTS 1.0.0 service capabilities as XML.",
      "properties": {
        "operation": {
          "const": "get_wmts_capabilities",
          "default": "get_wmts_capabilities",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetWMTSCapabilities",
      "type": "object"
    },
    "GetWorldCopyrights": {
      "additionalProperties": false,
      "description": "Read legacy whole-world copyrights (withdrawn by TomTom).",
      "properties": {
        "operation": {
          "const": "get_world_copyrights",
          "default": "get_world_copyrights",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetWorldCopyrights",
      "type": "object"
    },
    "TomTomAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "tomtom_api_key",
          "default": "tomtom_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Tomtom API Key",
      "type": "object",
      "x-credential-instructions": "Paste your TomTom application API key with Map Display access. NoClick reads a map tile to check key reachability; it cannot establish account identity. Map requests may consume your TomTom allowance.",
      "x-credential-url": "https://developer.tomtom.com/user/me/apps"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_area_copyrights": "#/$defs/GetAreaCopyrights",
          "get_copyright_caption": "#/$defs/GetCopyrightCaption",
          "get_raster_tile": "#/$defs/GetRasterTile",
          "get_static_image": "#/$defs/GetStaticImage",
          "get_tile_copyrights": "#/$defs/GetTileCopyrights",
          "get_vector_tile": "#/$defs/GetVectorTile",
          "get_wms_capabilities": "#/$defs/GetWMSCapabilities",
          "get_wms_map": "#/$defs/GetWMSMap",
          "get_wmts_capabilities": "#/$defs/GetWMTSCapabilities",
          "get_world_copyrights": "#/$defs/GetWorldCopyrights"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetWorldCopyrights"
        },
        {
          "$ref": "#/$defs/GetCopyrightCaption"
        },
        {
          "$ref": "#/$defs/GetAreaCopyrights"
        },
        {
          "$ref": "#/$defs/GetTileCopyrights"
        },
        {
          "$ref": "#/$defs/GetStaticImage"
        },
        {
          "$ref": "#/$defs/GetVectorTile"
        },
        {
          "$ref": "#/$defs/GetRasterTile"
        },
        {
          "$ref": "#/$defs/GetWMSMap"
        },
        {
          "$ref": "#/$defs/GetWMSCapabilities"
        },
        {
          "$ref": "#/$defs/GetWMTSCapabilities"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TomTomAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Tomtom Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
