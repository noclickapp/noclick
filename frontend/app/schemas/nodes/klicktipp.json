        {
          "$ref": "#/$defs/KlickTippGetContactsConfig"
        },
        {
          "$ref": "#/$defs/KlickTippListChangedContactsConfig"
        },
        {
          "$ref": "#/$defs/KlickTippGetContactConfig"
        },
        {
          "$ref": "#/$defs/KlickTippCreateOrUpdateContactConfig"
        },
        {
          "$ref": "#/$defs/KlickTippUpdateContactConfig"
        },
        {
          "$ref": "#/$defs/KlickTippDeleteContactConfig"
        },
        {
          "$ref": "#/$defs/KlickTippUnsubscribeContactConfig"
        },
        {
          "$ref": "#/$defs/KlickTippTagContactConfig"
        },
        {
          "$ref": "#/$defs/KlickTippUntagContactConfig"
        },
        {
          "$ref": "#/$defs/KlickTippSearchContactConfig"
        },
        {
          "$ref": "#/$defs/KlickTippSearchTaggedContactsConfig"
        },
        {
          "$ref": "#/$defs/KlickTippListTagsConfig"
        },
        {
          "$ref": "#/$defs/KlickTippGetTagConfig"
        },
        {
          "$ref": "#/$defs/KlickTippCreateTagConfig"
        },
        {
          "$ref": "#/$defs/KlickTippUpdateTagConfig"
        },
        {
          "$ref": "#/$defs/KlickTippDeleteTagConfig"
        },
        {
          "$ref": "#/$defs/KlickTippListFieldsConfig"
        },
        {
          "$ref": "#/$defs/KlickTippGetFieldConfig"
        },
        {
          "$ref": "#/$defs/KlickTippCreateFieldConfig"
        },
        {
          "$ref": "#/$defs/KlickTippListOptinProcessesConfig"
        },
        {
          "$ref": "#/$defs/KlickTippGetOptinProcessConfig"
        },
        {
          "$ref": "#/$defs/KlickTippSearchRedirectUrlConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/KlickTippCredential"
        },
        {
          "type": "null"
