        "operation": {
          "const": "list_optin_processes",
          "default": "list_optin_processes",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "detail": {
          "default": false,
          "title": "Detail",
          "type": "boolean"
        }
      },
      "title": "KlickTippListOptinProcessesConfig",
