    "KlickTippListChangedContactsConfig": {
      "additionalProperties": false,
      "description": "GET /subscriber/changed.",
      "properties": {
        "operation": {
          "const": "list_changed_contacts",
          "default": "list_changed_contacts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "from_timestamp": {
          "default": 0,
          "description": "Inclusive Unix timestamp in seconds.",
          "minimum": 0,
          "title": "From Timestamp",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "limit": {
          "default": 100,
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "KlickTippListChangedContactsConfig",
      "type": "object"
    },
    "KlickTippListContactsConfig": {
      "additionalProperties": false,
      "description": "GET /subscriber.",
      "properties": {
        "operation": {
          "const": "list_contacts",
          "default": "list_contacts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "status": {
          "anyOf": [
            {
              "pattern": "^(subscribed|pending|unsubscribed)(,(subscribed|pending|unsubscribed))*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "bounceStatus": {
          "anyOf": [
            {
              "pattern": "^(hardbounce|softbounce|spambounce|nobounce)(,(hardbounce|softbounce|spambounce|nobounce))*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bouncestatus"
        },
        "limit": {
          "default": 100,
          "description": "Page size. Pass nextCursor from the response as cursor for the next page.",
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        }
      },
      "title": "KlickTippListContactsConfig",
      "type": "object"
    },
