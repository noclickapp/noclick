        "operation": {
          "const": "delete_tag",
          "default": "delete_tag",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "tagid": {
          "minimum": 1,
          "title": "Tagid",
          "type": "integer"
        }
      },
      "required": [
        "tagid"
      ],
      "title": "KlickTippDeleteTagConfig",
      "type": "object"
    },
    "KlickTippGetContactConfig": {
      "additionalProperties": false,
      "description": "GET /subscriber/{subscriberid}.",
      "properties": {
        "operation": {
          "const": "get_contact",
          "default": "get_contact",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "subscriberid": {
          "minLength": 1,
          "title": "Subscriberid",
          "type": "string"
        }
      },
      "required": [
        "subscriberid"
      ],
      "title": "KlickTippGetContactConfig",
      "type": "object"
    },
    "KlickTippGetContactsConfig": {
      "additionalProperties": false,
      "description": "GET /subscriber/bulk/{subscriberids}.",
      "properties": {
        "operation": {
          "const": "get_contacts",
          "default": "get_contacts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "subscriberids": {
          "description": "Up to 200 comma-separated numeric contact IDs.",
          "pattern": "^[1-9][0-9]*(,[1-9][0-9]*){0,199}$",
          "title": "Subscriberids",
          "type": "string"
        }
      },
      "required": [
        "subscriberids"
      ],
      "title": "KlickTippGetContactsConfig",
      "type": "object"
    },
    "KlickTippGetFieldConfig": {
      "additionalProperties": false,
      "description": "GET /field/{fieldid}.",
      "properties": {
        "operation": {
          "const": "get_field",
          "default": "get_field",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "fieldid": {
          "description": "Unprefixed field ID, for example 12345.",
          "minLength": 1,
          "title": "Fieldid",
          "type": "string"
        },
        "detail": {
          "default": false,
          "title": "Detail",
          "type": "boolean"
        }
      },
      "required": [
        "fieldid"
      ],
      "title": "KlickTippGetFieldConfig",
      "type": "object"
    },
    "KlickTippGetOptinProcessConfig": {
      "additionalProperties": false,
      "description": "GET /list/{listid}.",
      "properties": {
        "operation": {
          "const": "get_optin_process",
          "default": "get_optin_process",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "listid": {
          "minimum": 1,
          "title": "Listid",
          "type": "integer"
        }
      },
      "required": [
        "listid"
      ],
      "title": "KlickTippGetOptinProcessConfig",
      "type": "object"
    },
    "KlickTippGetTagConfig": {
      "additionalProperties": false,
      "description": "GET /tag/{tagid}.",
      "properties": {
        "operation": {
          "const": "get_tag",
          "default": "get_tag",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "tagid": {
          "minimum": 1,
          "title": "Tagid",
          "type": "integer"
        }
      },
      "required": [
        "tagid"
      ],
      "title": "KlickTippGetTagConfig",
      "type": "object"
