          "title": "Status",
          "type": "array"
        },
        "bounceStatus": {
          "items": {
            "enum": [
              "hardbounce",
              "softbounce",
              "spambounce",
              "nobounce"
            ],
            "type": "string"
          },
          "title": "Bouncestatus",
          "type": "array"
        }
      },
      "required": [
        "tagid"
      ],
      "title": "KlickTippSearchTaggedContactsConfig",
      "type": "object"
    },
    "KlickTippTagContactConfig": {
