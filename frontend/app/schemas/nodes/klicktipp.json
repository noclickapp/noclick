        },
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        },
        "tagids": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Tagids",
          "type": "array"
        }
      },
      "required": [
        "email",
        "tagids"
      ],
      "title": "KlickTippTagContactConfig",
      "type": "object"
    },
