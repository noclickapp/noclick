  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_field": "#/$defs/KlickTippCreateFieldConfig",
          "create_or_update_contact": "#/$defs/KlickTippCreateOrUpdateContactConfig",
          "create_tag": "#/$defs/KlickTippCreateTagConfig",
          "delete_contact": "#/$defs/KlickTippDeleteContactConfig",
          "delete_tag": "#/$defs/KlickTippDeleteTagConfig",
          "get_contact": "#/$defs/KlickTippGetContactConfig",
          "get_contacts": "#/$defs/KlickTippGetContactsConfig",
          "get_field": "#/$defs/KlickTippGetFieldConfig",
          "get_optin_process": "#/$defs/KlickTippGetOptinProcessConfig",
          "get_tag": "#/$defs/KlickTippGetTagConfig",
          "list_changed_contacts": "#/$defs/KlickTippListChangedContactsConfig",
          "list_contacts": "#/$defs/KlickTippListContactsConfig",
          "list_fields": "#/$defs/KlickTippListFieldsConfig",
          "list_optin_processes": "#/$defs/KlickTippListOptinProcessesConfig",
          "list_tags": "#/$defs/KlickTippListTagsConfig",
          "search_contact": "#/$defs/KlickTippSearchContactConfig",
          "search_redirect_url": "#/$defs/KlickTippSearchRedirectUrlConfig",
