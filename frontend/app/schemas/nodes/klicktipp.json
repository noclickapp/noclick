{
  "$defs": {
    "KlickTippCreateFieldConfig": {
      "additionalProperties": false,
      "description": "POST /field/create.",
      "properties": {
        "operation": {
          "const": "create_field",
          "default": "create_field",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 250,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "field-single",
            "field-paragraph",
            "field-email",
            "field-number",
            "field-url",
            "field-date",
            "field-time",
            "field-datetime",
            "field-html",
            "field-decimal"
          ],
          "title": "Type",
          "type": "string"
        },
        "multidimensional": {
          "default": true,
          "title": "Multidimensional",
          "type": "boolean"
        },
        "ai_description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ai Description"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "KlickTippCreateFieldConfig",
      "type": "object"
    },
    "KlickTippCreateOrUpdateContactConfig": {
      "additionalProperties": false,
      "description": "POST /subscriber.",
      "properties": {
        "operation": {
          "const": "create_or_update_contact",
          "default": "create_or_update_contact",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "smsnumber": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smsnumber"
        },
        "listid": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opt-in process ID. Omitting this triggers the default double opt-in and may email the contact.",
          "title": "Listid"
        },
        "tagid": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tagid"
        },
        "fields": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "KlickTipp field names and string values; date/time fields use Unix seconds.",
          "title": "Fields"
        }
      },
      "title": "KlickTippCreateOrUpdateContactConfig",
      "type": "object"
    },
    "KlickTippCreateTagConfig": {
      "additionalProperties": false,
      "description": "POST /tag.",
      "properties": {
        "operation": {
          "const": "create_tag",
          "default": "create_tag",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "name"
      ],
      "title": "KlickTippCreateTagConfig",
      "type": "object"
    },
    "KlickTippCredential": {
      "properties": {
        "credential_type": {
          "const": "klicktipp_api_user",
          "default": "klicktipp_api_user",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "username": {
          "description": "The dedicated API User, such as mainaccount-subaccountname.",
          "minLength": 1,
          "title": "API user username",
          "type": "string"
        },
        "password": {
          "minLength": 1,
          "title": "API user password",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "title": "KlickTipp API User",
      "type": "object",
      "x-credential-instructions": "Requires KlickTipp Premium or higher. Create a dedicated API User under My Account \u2192 Settings \u2192 User Account \u2192 Sub-Accounts, then enter its username and password. NoClick logs in for each operation and logs out afterward; sessions are never saved.",
      "x-credential-url": "https://developers.klicktipp.com/guides/management-api-authentication"
    },
    "KlickTippDeleteContactConfig": {
      "additionalProperties": false,
      "description": "DELETE /subscriber/{subscriberid}.",
