{
  "$defs": {
    "BookSession": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "book_session",
          "default": "book_session",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "service_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Service Id",
          "type": "string"
        },
        "service_type": {
          "default": "face",
          "enum": [
            "face",
            "phone",
            "virtual"
          ],
          "title": "Service Type",
          "type": "string"
        },
        "session_date": {
          "format": "date-time",
          "title": "Session Date",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Duration in seconds; omitted uses the service duration.",
          "title": "Duration"
        },
        "time_zone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Windows timezone name, for example Pacific Standard Time.",
          "title": "Time Zone"
        },
        "launch_application": {
          "anyOf": [
            {
              "enum": [
                "zoom",
                "system",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Launch Application",
          "enum": [
            "zoom",
            "system",
            "other"
          ],
          "x-enum-searchable": true
        },
        "notify": {
          "default": false,
          "description": "Send the client a booking confirmation.",
          "title": "Notify",
          "type": "boolean"
        },
        "ignore_conflict": {
          "default": false,
          "description": "Explicitly override conflicts in the practitioner's calendar.",
          "title": "Ignore Conflict",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "record_id",
        "service_id",
        "session_date"
      ],
      "title": "BookSession",
      "type": "object"
    },
