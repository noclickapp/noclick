  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "convert_currency": "#/$defs/ConvertCurrency",
          "convert_historical_currency": "#/$defs/ConvertHistoricalCurrency",
          "get_fluctuation": "#/$defs/Fluctuation",
          "get_historical_rates": "#/$defs/HistoricalRates",
          "get_historical_spread": "#/$defs/HistoricalSpread",
          "get_latest_rates": "#/$defs/LatestRates",
          "get_latest_spread": "#/$defs/LatestSpread",
          "get_time_series": "#/$defs/TimeSeries",
          "get_time_series_spread": "#/$defs/TimeSeriesSpread",
          "list_symbols": "#/$defs/ListSymbols"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListSymbols"
        },
        {
          "$ref": "#/$defs/LatestRates"
        },
        {
          "$ref": "#/$defs/LatestSpread"
        },
