{
  "$defs": {
    "ConvertCurrency": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "convert_currency",
          "default": "convert_currency",
          "title": "Convert Currency",
          "type": "string",
          "ui:hidden": true
        },
        "from_currency": {
          "description": "Source currency, for example GBP.",
          "pattern": "^[A-Z]{3}$",
          "title": "From currency",
          "type": "string"
        },
        "to_currency": {
          "description": "Target currency, for example JPY.",
          "pattern": "^[A-Z]{3}$",
          "title": "To currency",
          "type": "string"
        },
        "amount": {
          "description": "Amount to convert.",
          "title": "Amount",
          "type": "number"
        }
      },
      "required": [
        "from_currency",
        "to_currency",
        "amount"
      ],
      "title": "ConvertCurrency",
      "type": "object"
    },
    "ConvertHistoricalCurrency": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "convert_historical_currency",
          "default": "convert_historical_currency",
          "title": "Convert at Historical Rate",
          "type": "string",
          "ui:hidden": true
        },
        "from_currency": {
          "description": "Source currency, for example GBP.",
          "pattern": "^[A-Z]{3}$",
          "title": "From currency",
          "type": "string"
        },
        "to_currency": {
          "description": "Target currency, for example JPY.",
          "pattern": "^[A-Z]{3}$",
          "title": "To currency",
          "type": "string"
        },
        "amount": {
          "description": "Amount to convert.",
          "title": "Amount",
          "type": "number"
        },
        "date": {
          "description": "Conversion date in YYYY-MM-DD format.",
          "title": "Date",
          "type": "string"
        }
      },
      "required": [
        "from_currency",
        "to_currency",
        "amount",
        "date"
      ],
      "title": "ConvertHistoricalCurrency",
      "type": "object"
    },
    "FixerIoAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "fixer_io_api_key",
          "default": "fixer_io_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API access key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_key"
      ],
      "title": "Fixer Io API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API access key from the Fixer dashboard. NoClick sends it to data.fixer.io over HTTPS. The connection check reads supported currencies and proves key acceptance, not account identity. Conversion, time series, fluctuation, spread data and base switching may require a paid plan.",
      "x-credential-url": "https://fixer.io/dashboard"
    },
    "Fluctuation": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Three-letter base currency; provider defaults to EUR. Switching base requires a supported plan.",
          "title": "Base"
        },
        "symbols": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated currency codes, for example USD,GBP,JPY. Omit for all currencies.",
          "title": "Symbols"
        },
        "start_date": {
          "description": "First date in YYYY-MM-DD format.",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "description": "Last date in YYYY-MM-DD format; maximum span is 365 days.",
          "title": "End Date",
          "type": "string"
        },
        "operation": {
          "const": "get_fluctuation",
          "default": "get_fluctuation",
          "title": "Get Currency Fluctuation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "Fluctuation",
      "type": "object"
    },
