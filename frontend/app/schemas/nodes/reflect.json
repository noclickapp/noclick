{
  "$defs": {
    "ReflectAccessTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "reflect_access_token",
          "default": "reflect_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "minLength": 1,
          "title": "Access Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "Reflect Access Token",
      "type": "object",
      "x-credential-instructions": "Create credentials at Reflect's developer OAuth page and generate an access token there. Select read:graph and write:graph to use all operations. Paste the token alone. NoClick sends it as a Bearer token to reflect.app only.",
      "x-credential-url": "https://reflect.app/developer/oauth",
      "x-help-url": "https://reflect.app/openapi.json"
    },
    "ReflectAppendDailyNoteConfig": {
      "additionalProperties": false,
      "description": "Append text to a daily note's list (write:graph); this never replaces content.",
      "properties": {
        "graph_id": {
          "description": "Graph ID from List Graphs.",
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "operation": {
          "const": "append_daily_note",
          "default": "append_daily_note",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "text": {
          "description": "Text to append to the daily note.",
          "title": "Text",
          "type": "string"
        },
        "transform_type": {
          "const": "list-append",
          "default": "list-append",
          "description": "Reflect currently supports only list-append.",
          "title": "Transform Type",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Daily note date in YYYY-MM-DD format; omit for today.",
          "format": "date",
          "title": "Date"
        },
        "list_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List name; use [[List Name]] to backlink.",
          "title": "List Name"
        }
      },
      "required": [
        "graph_id",
        "text"
      ],
      "title": "ReflectAppendDailyNoteConfig",
      "type": "object"
    },
    "ReflectCreateLinkConfig": {
      "additionalProperties": false,
      "description": "Create a bookmarked link (read:graph and write:graph).",
      "properties": {
        "graph_id": {
          "description": "Graph ID from List Graphs.",
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "operation": {
          "const": "create_link",
          "default": "create_link",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "url": {
          "description": "URL to bookmark; sent as data, never fetched by NoClick.",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "highlights": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highlights"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional link identifier, as supported by the Link request schema.",
          "title": "Id"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional ISO 8601 date-time.",
          "format": "date-time",
          "title": "Updated At"
        }
      },
      "required": [
        "graph_id",
        "url"
      ],
      "title": "ReflectCreateLinkConfig",
      "type": "object"
    },
    "ReflectCreateNoteConfig": {
      "additionalProperties": false,
      "description": "Create a note from Markdown (write:graph); encrypted contents cannot be read back.",
      "properties": {
        "graph_id": {
          "description": "Graph ID from List Graphs.",
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "operation": {
          "const": "create_note",
          "default": "create_note",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "content_markdown": {
          "title": "Content Markdown",
          "type": "string"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        }
      },
      "required": [
        "graph_id",
        "subject",
        "content_markdown"
      ],
      "title": "ReflectCreateNoteConfig",
      "type": "object"
    },
    "ReflectGetCurrentUserConfig": {
      "additionalProperties": false,
      "description": "Get the connected user's identity (read:graph and write:graph).",
      "properties": {
        "operation": {
          "const": "get_current_user",
          "default": "get_current_user",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ReflectGetCurrentUserConfig",
      "type": "object"
    },
    "ReflectListBooksConfig": {
      "additionalProperties": false,
      "description": "List books and their notes/highlights (read:graph and write:graph).",
      "properties": {
        "graph_id": {
          "description": "Graph ID from List Graphs.",
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "operation": {
          "const": "list_books",
          "default": "list_books",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "graph_id"
      ],
      "title": "ReflectListBooksConfig",
      "type": "object"
    },
    "ReflectListGraphsConfig": {
      "additionalProperties": false,
      "description": "List all graphs available to the connected account (read:graph).",
      "properties": {
        "operation": {
          "const": "list_graphs",
          "default": "list_graphs",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ReflectListGraphsConfig",
      "type": "object"
    },
    "ReflectListLinksConfig": {
      "additionalProperties": false,
      "description": "List bookmarked links and highlights (read:graph).",
      "properties": {
        "graph_id": {
          "description": "Graph ID from List Graphs.",
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "operation": {
          "const": "list_links",
          "default": "list_links",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "graph_id"
      ],
      "title": "ReflectListLinksConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "append_daily_note": "#/$defs/ReflectAppendDailyNoteConfig",
          "create_link": "#/$defs/ReflectCreateLinkConfig",
          "create_note": "#/$defs/ReflectCreateNoteConfig",
          "get_current_user": "#/$defs/ReflectGetCurrentUserConfig",
          "list_books": "#/$defs/ReflectListBooksConfig",
          "list_graphs": "#/$defs/ReflectListGraphsConfig",
          "list_links": "#/$defs/ReflectListLinksConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ReflectListGraphsConfig"
        },
        {
          "$ref": "#/$defs/ReflectGetCurrentUserConfig"
        },
        {
          "$ref": "#/$defs/ReflectListBooksConfig"
        },
        {
          "$ref": "#/$defs/ReflectListLinksConfig"
        },
        {
          "$ref": "#/$defs/ReflectCreateLinkConfig"
        },
        {
          "$ref": "#/$defs/ReflectAppendDailyNoteConfig"
        },
        {
          "$ref": "#/$defs/ReflectCreateNoteConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReflectAccessTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Reflect Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Save this article to Reflect",
    "Append today's meeting summary",
    "Create a Reflect note"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
