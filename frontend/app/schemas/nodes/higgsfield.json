        "operation": {
          "const": "generate_hailuo_text_video",
          "default": "generate_hailuo_text_video",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "GenerateHailuoTextVideo",
      "type": "object"
    },
    "GenerateKlingProImageVideo": {
