        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "duration": {
          "default": 6,
          "enum": [
            6,
            10
          ],
          "title": "Duration",
          "type": "integer"
        },
        "prompt_optimizer": {
          "default": true,
          "title": "Prompt Optimizer",
          "type": "boolean"
