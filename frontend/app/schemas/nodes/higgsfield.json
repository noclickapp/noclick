{
  "$defs": {
    "CancelRequest": {
      "additionalProperties": false,
      "description": "Cancel a queued request; acceptance does not prove cancellation has completed.",
      "properties": {
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "request_id",
            "placeholder": "Choose verification request or paste request UUID",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "cancel_request",
          "default": "cancel_request",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "CancelRequest",
      "type": "object"
    },
    "DeleteRequest": {
      "additionalProperties": false,
      "description": "Permanently delete finished request inputs, outputs, prompt and parameters. Billing records remain.",
      "properties": {
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "request_id",
            "placeholder": "Choose verification request or paste request UUID",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "delete_request",
          "default": "delete_request",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "DeleteRequest",
      "type": "object"
    },
    "GenerateHailuoImageVideo": {
      "additionalProperties": false,
      "description": "Submit MiniMax Hailuo 2.3 image-to-video.",
      "properties": {
        "image_url": {
          "description": "Publicly accessible input image URL",
          "format": "uri",
          "title": "Image Url",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "duration": {
          "default": 6,
          "enum": [
            6,
            10
          ],
          "title": "Duration",
          "type": "integer"
        },
        "prompt_optimizer": {
          "default": true,
          "title": "Prompt Optimizer",
          "type": "boolean"
        },
        "operation": {
          "const": "generate_hailuo_image_video",
          "default": "generate_hailuo_image_video",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "image_url",
        "prompt"
      ],
      "title": "GenerateHailuoImageVideo",
      "type": "object"
    },
    "GenerateHailuoTextVideo": {
      "additionalProperties": false,
