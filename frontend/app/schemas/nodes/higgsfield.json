        "image_url": {
          "description": "Publicly accessible input image URL",
          "format": "uri",
          "title": "Image Url",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "duration": {
          "default": 5,
          "enum": [
            5,
            10
          ],
          "title": "Duration",
          "type": "integer"
        },
        "cfg_scale": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "multipleOf": 0.01,
          "title": "Cfg Scale",
          "type": "number"
        },
        "negative_prompt": {
          "default": "",
          "title": "Negative Prompt",
          "type": "string"
        },
        "operation": {
          "const": "generate_kling_pro_image_video",
          "default": "generate_kling_pro_image_video",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "image_url",
        "prompt"
      ],
      "title": "GenerateKlingProImageVideo",
      "type": "object"
    },
    "GenerateKlingProTextVideo": {
