      "description": "Submit Kling 2.5 Turbo Standard image-to-video.",
      "properties": {
        "image_url": {
          "description": "Publicly accessible input image URL",
          "format": "uri",
          "title": "Image Url",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "duration": {
          "default": 5,
          "enum": [
            5,
            10
          ],
          "title": "Duration",
