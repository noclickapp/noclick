    "ReductoClassifyConfig": {
      "description": "Categorize a document into one of a provided set of document types/labels.",
      "properties": {
        "operation": {
          "const": "classify",
          "default": "classify",
          "title": "Classify Document",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Classify",
          "x-display-name": "Classify Document",
          "x-is-trigger": false
        },
        "document_url": {
          "description": "Public URL, a reducto:// id from Upload, a jobid://<id> reference, or upload a local file via the Upload button.",
          "title": "Document URL",
          "type": "string",
          "ui:accept": ".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.csv,.txt,image/jpeg,image/png,image/webp,image/tiff",
          "ui:widget": "media_upload"
        },
