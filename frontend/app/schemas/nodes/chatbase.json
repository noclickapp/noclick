    "Chat": {
      "description": "Send a message, consuming Chatbase credits; returns JSON without streaming.",
      "properties": {
        "agent_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Agent ID",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "agent_id",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "chat",
          "default": "chat",
          "title": "Operation",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "conversationId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversationid"
        },
        "userId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Userid"
        }
      },
      "required": [
        "agent_id",
        "message"
      ],
      "title": "Chat",
      "type": "object"
    },
