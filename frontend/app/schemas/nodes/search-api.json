  "$defs": {
    "SearchApiAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "search_api_api_key",
          "default": "search_api_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "SearchApi Key",
      "type": "object",
      "x-credential-instructions": "Paste the API key from your SearchApi dashboard. Connecting runs one Google search and consumes one search credit. This checks that SearchApi accepts the key; public search results do not identify your account.",
      "x-credential-url": "https://www.searchapi.io/api_key"
    },
    "SearchApiCheckConfig": {
      "additionalProperties": false,
      "description": "Check key reachability using one paid Google search for Google.",
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "SearchApiCheckConfig",
      "type": "object"
    },
    "SearchApiCoordinatesConfig": {
      "additionalProperties": false,
      "description": "Search from a precise latitude and longitude.",
      "properties": {
        "q": {
          "description": "Google query, including site:, inurl:, intitle:, AND or OR.",
          "minLength": 1,
          "title": "Search Query",
          "type": "string"
        },
        "page": {
          "default": 1,
          "description": "Result page to return. Run again with the next page number to paginate.",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "safe": {
          "default": "blur",
          "enum": [
            "active",
            "blur",
            "off"
          ],
          "title": "Safe",
          "type": "string"
        },
        "link": {
          "default": "raw",
          "description": "Resolve remaining encrypted Google redirect links (adds latency).",
          "enum": [
            "raw",
            "resolved"
          ],
          "title": "Link",
          "type": "string"
        },
        "optimization_strategy": {
          "default": "performance",
          "enum": [
            "performance",
            "ads"
          ],
          "title": "Optimization Strategy",
          "type": "string"
        },
        "nfpr": {
          "default": "0",
          "description": "1 excludes automatically corrected queries.",
          "enum": [
            "0",
            "1"
          ],
          "title": "Exclude Spelling Corrections",
          "type": "string"
        },
        "filter": {
          "default": "1",
          "enum": [
            "0",
            "1"
          ],
          "title": "Duplicate Content Filter",
          "type": "string"
        },
        "operation": {
          "const": "search_coordinates",
          "default": "search_coordinates",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "q",
        "latitude",
        "longitude"
      ],
      "title": "SearchApiCoordinatesConfig",
      "type": "object"
    },
