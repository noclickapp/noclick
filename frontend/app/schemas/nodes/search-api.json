        "operation": {
          "const": "search_date_range",
          "default": "search_date_range",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "time_period_min": {
          "description": "MM/DD/YYYY, inclusive start of the search period.",
          "pattern": "^(0?[1-9]|1[0-2])\\/(0?[1-9]|[12][0-9]|3[01])\\/(19|20)\\d\\d$",
          "title": "Start Date",
          "type": "string"
        },
        "time_period_max": {
          "description": "MM/DD/YYYY, end of the search period.",
          "pattern": "^(0?[1-9]|1[0-2])\\/(0?[1-9]|[12][0-9]|3[01])\\/(19|20)\\d\\d$",
          "title": "End Date",
          "type": "string"
        }
      },
