{
  "$defs": {
    "CopyFile": {
      "additionalProperties": false,
      "description": "Copy a file or transformed CDN URL into this project's storage.",
      "properties": {
        "operation": {
          "const": "copy_file",
          "default": "copy_file",
          "title": "Operation",
          "type": "string"
        },
        "source": {
          "description": "Uploadcare UUID or CDN URL, optionally including transformations.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "store": {
          "default": "false",
          "enum": [
            "true",
            "false"
          ],
          "title": "Store",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "CopyFile",
      "type": "object"
    },
    "CreateWebhook": {
      "additionalProperties": false,
      "description": "Create a webhook subscription to a receiver you control.",
      "properties": {
        "target_url": {
          "format": "uri",
          "maxLength": 255,
          "minLength": 1,
          "title": "Target Url",
          "type": "string"
        },
        "operation": {
          "const": "create_webhook",
          "default": "create_webhook",
          "title": "Operation",
          "type": "string"
        },
        "event": {
          "enum": [
            "file.uploaded",
            "file.infected",
            "file.stored",
            "file.deleted",
            "file.info_updated"
          ],
          "title": "Event",
          "type": "string"
        },
        "is_active": {
          "default": true,
          "title": "Is Active",
          "type": "boolean"
        },
        "signing_secret": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signing Secret",
          "ui:widget": "password"
        },
        "version": {
          "const": "0.7",
          "default": "0.7",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "target_url",
        "event"
      ],
      "title": "CreateWebhook",
      "type": "object"
    },
    "DeleteFile": {
      "additionalProperties": false,
      "description": "Delete a file from Uploadcare storage.",
      "properties": {
        "file_id": {
          "description": "Uploadcare file UUID.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_file",
          "default": "delete_file",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "DeleteFile",
      "type": "object"
    },
    "DeleteGroup": {
      "additionalProperties": false,
      "description": "Delete a group; this does not delete the files in the group.",
      "properties": {
        "group_id": {
          "description": "Group ID including ~file-count suffix.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}~[1-9][0-9]*$",
          "title": "Group Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_group",
          "default": "delete_group",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "group_id"
      ],
      "title": "DeleteGroup",
      "type": "object"
    },
    "DeleteMetadataValue": {
      "additionalProperties": false,
      "description": "Delete one metadata key.",
      "properties": {
        "file_id": {
          "description": "Uploadcare file UUID.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "key": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:\\-]+$",
          "title": "Key",
          "type": "string"
        },
        "operation": {
          "const": "delete_metadata_value",
          "default": "delete_metadata_value",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "key"
      ],
      "title": "DeleteMetadataValue",
      "type": "object"
    },
    "DeleteWebhook": {
      "additionalProperties": false,
      "description": "Unsubscribe webhooks at the exact target URL.",
      "properties": {
        "target_url": {
          "format": "uri",
          "maxLength": 255,
          "minLength": 1,
          "title": "Target Url",
          "type": "string"
        },
        "operation": {
          "const": "delete_webhook",
          "default": "delete_webhook",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "target_url"
      ],
      "title": "DeleteWebhook",
      "type": "object"
    },
    "GetFile": {
      "additionalProperties": false,
      "description": "Read file details.",
      "properties": {
        "file_id": {
          "description": "Uploadcare file UUID.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "get_file",
          "default": "get_file",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetFile",
      "type": "object"
    },
    "GetGroup": {
      "additionalProperties": false,
      "description": "Read a file group.",
      "properties": {
        "group_id": {
          "description": "Group ID including ~file-count suffix.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}~[1-9][0-9]*$",
          "title": "Group Id",
          "type": "string"
        },
        "operation": {
          "const": "get_group",
          "default": "get_group",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "group_id"
      ],
      "title": "GetGroup",
      "type": "object"
    },
    "GetMetadata": {
      "additionalProperties": false,
      "description": "Read all custom metadata for a file.",
      "properties": {
        "file_id": {
          "description": "Uploadcare file UUID.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "get_metadata",
          "default": "get_metadata",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetMetadata",
      "type": "object"
    },
    "GetMetadataValue": {
      "additionalProperties": false,
      "description": "Read one metadata value.",
      "properties": {
        "file_id": {
          "description": "Uploadcare file UUID.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "key": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:\\-]+$",
          "title": "Key",
          "type": "string"
        },
        "operation": {
          "const": "get_metadata_value",
          "default": "get_metadata_value",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "key"
      ],
      "title": "GetMetadataValue",
      "type": "object"
    },
    "GetProject": {
      "additionalProperties": false,
      "description": "Read the connected project's name and settings.",
      "properties": {
        "operation": {
          "const": "get_project",
          "default": "get_project",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetProject",
      "type": "object"
    },
    "GetTags": {
      "additionalProperties": false,
      "description": "Read file tags.",
      "properties": {
        "file_id": {
          "description": "Uploadcare file UUID.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "get_tags",
          "default": "get_tags",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetTags",
      "type": "object"
    },
    "ListFiles": {
      "additionalProperties": false,
      "description": "Read one page of files; pagination URLs are returned without being followed.",
      "properties": {
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "from_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Copy the from timestamp from the previous page's next URL.",
          "format": "date-time",
          "title": "From Time"
        },
        "operation": {
          "const": "list_files",
          "default": "list_files",
          "title": "Operation",
          "type": "string"
        },
        "stored": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stored"
        },
        "removed": {
          "default": false,
          "title": "Removed",
          "type": "boolean"
        },
        "ordering": {
          "default": "datetime_uploaded",
          "enum": [
            "datetime_uploaded",
            "-datetime_uploaded"
          ],
          "title": "Ordering",
          "type": "string"
        }
      },
      "title": "ListFiles",
      "type": "object"
    },
    "ListGroups": {
      "additionalProperties": false,
      "description": "Read one page of file groups.",
      "properties": {
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "from_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Copy the from timestamp from the previous page's next URL.",
          "format": "date-time",
          "title": "From Time"
        },
        "operation": {
          "const": "list_groups",
          "default": "list_groups",
          "title": "Operation",
          "type": "string"
        },
        "ordering": {
          "default": "datetime_created",
          "enum": [
            "datetime_created",
            "-datetime_created"
          ],
          "title": "Ordering",
          "type": "string"
        }
      },
      "title": "ListGroups",
      "type": "object"
    },
    "ListWebhooks": {
      "additionalProperties": false,
      "description": "Read the project's webhook subscriptions.",
      "properties": {
        "operation": {
          "const": "list_webhooks",
          "default": "list_webhooks",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListWebhooks",
      "type": "object"
    },
    "ReplaceTags": {
      "additionalProperties": false,
      "description": "Replace every tag; an empty array clears all tags.",
      "properties": {
        "file_id": {
          "description": "Uploadcare file UUID.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "replace_tags",
          "default": "replace_tags",
          "title": "Operation",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "file_id",
        "tags"
      ],
      "title": "ReplaceTags",
      "type": "object"
    },
    "SetMetadataValue": {
      "additionalProperties": false,
      "description": "Create or replace one metadata value.",
      "properties": {
        "file_id": {
          "description": "Uploadcare file UUID.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "key": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:\\-]+$",
          "title": "Key",
          "type": "string"
        },
        "operation": {
          "const": "set_metadata_value",
          "default": "set_metadata_value",
          "title": "Operation",
          "type": "string"
        },
        "value": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "key",
        "value"
      ],
      "title": "SetMetadataValue",
      "type": "object"
    },
    "StoreFile": {
      "additionalProperties": false,
      "description": "Store a temporary file permanently.",
      "properties": {
        "file_id": {
          "description": "Uploadcare file UUID.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "store_file",
          "default": "store_file",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "StoreFile",
      "type": "object"
    },
    "UpdateTags": {
      "additionalProperties": false,
      "description": "Add and remove tags in a single request.",
      "properties": {
        "file_id": {
          "description": "Uploadcare file UUID.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "update_tags",
          "default": "update_tags",
          "title": "Operation",
          "type": "string"
        },
        "add": {
          "items": {
            "type": "string"
          },
          "title": "Add",
          "type": "array"
        },
        "delete": {
          "items": {
            "type": "string"
          },
          "title": "Delete",
          "type": "array"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "UpdateTags",
      "type": "object"
    },
    "UpdateWebhook": {
      "additionalProperties": false,
      "description": "Update a webhook's receiver and subscription settings.",
      "properties": {
        "target_url": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "uri",
          "title": "Target Url"
        },
        "operation": {
          "const": "update_webhook",
          "default": "update_webhook",
          "title": "Operation",
          "type": "string"
        },
        "webhook_id": {
          "minimum": 1,
          "title": "Webhook Id",
          "type": "integer"
        },
        "event": {
          "anyOf": [
            {
              "enum": [
                "file.uploaded",
                "file.infected",
                "file.stored",
                "file.deleted",
                "file.info_updated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event",
          "enum": [
            "file.uploaded",
            "file.infected",
            "file.stored",
            "file.deleted",
            "file.info_updated"
          ],
          "x-enum-searchable": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Active"
        },
        "signing_secret": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signing Secret",
          "ui:widget": "password"
        }
      },
      "required": [
        "webhook_id"
      ],
      "title": "UpdateWebhook",
      "type": "object"
    },
    "UploadcareAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "uploadcare_api_key",
          "default": "uploadcare_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "public_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Public key",
          "type": "string"
        },
        "secret_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Secret key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "public_key",
        "secret_key"
      ],
      "title": "Uploadcare API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Uploadcare project's public and secret API keys from Project settings \u2192 API keys. NoClick signs requests with the secret key using Uploadcare HMAC authentication. Connecting reads your project details; keys permit both reads and writes to that project.",
      "x-credential-url": "https://app.uploadcare.com/projects/-/api-keys/"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "copy_file": "#/$defs/CopyFile",
          "create_webhook": "#/$defs/CreateWebhook",
          "delete_file": "#/$defs/DeleteFile",
          "delete_group": "#/$defs/DeleteGroup",
          "delete_metadata_value": "#/$defs/DeleteMetadataValue",
          "delete_webhook": "#/$defs/DeleteWebhook",
          "get_file": "#/$defs/GetFile",
          "get_group": "#/$defs/GetGroup",
          "get_metadata": "#/$defs/GetMetadata",
          "get_metadata_value": "#/$defs/GetMetadataValue",
          "get_project": "#/$defs/GetProject",
          "get_tags": "#/$defs/GetTags",
          "list_files": "#/$defs/ListFiles",
          "list_groups": "#/$defs/ListGroups",
          "list_webhooks": "#/$defs/ListWebhooks",
          "replace_tags": "#/$defs/ReplaceTags",
          "set_metadata_value": "#/$defs/SetMetadataValue",
          "store_file": "#/$defs/StoreFile",
          "update_tags": "#/$defs/UpdateTags",
          "update_webhook": "#/$defs/UpdateWebhook"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetProject"
        },
        {
          "$ref": "#/$defs/ListFiles"
        },
        {
          "$ref": "#/$defs/GetFile"
        },
        {
          "$ref": "#/$defs/StoreFile"
        },
        {
          "$ref": "#/$defs/DeleteFile"
        },
        {
          "$ref": "#/$defs/CopyFile"
        },
        {
          "$ref": "#/$defs/GetMetadata"
        },
        {
          "$ref": "#/$defs/GetMetadataValue"
        },
        {
          "$ref": "#/$defs/SetMetadataValue"
        },
        {
          "$ref": "#/$defs/DeleteMetadataValue"
        },
        {
          "$ref": "#/$defs/GetTags"
        },
        {
          "$ref": "#/$defs/ReplaceTags"
        },
        {
          "$ref": "#/$defs/UpdateTags"
        },
        {
          "$ref": "#/$defs/ListGroups"
        },
        {
          "$ref": "#/$defs/GetGroup"
        },
        {
          "$ref": "#/$defs/DeleteGroup"
        },
        {
          "$ref": "#/$defs/ListWebhooks"
        },
        {
          "$ref": "#/$defs/CreateWebhook"
        },
        {
          "$ref": "#/$defs/UpdateWebhook"
        },
        {
          "$ref": "#/$defs/DeleteWebhook"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/UploadcareAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Uploadcare Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
