        "campaign_id": {
          "minLength": 1,
          "title": "Campaign Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Loopy Loyalty ID",
            "field_name": "campaign_id",
            "placeholder": "Choose a record",
            "auto_select_sole_option": true
