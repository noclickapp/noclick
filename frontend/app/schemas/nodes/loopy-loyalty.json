{
  "$defs": {
    "AddStamps": {
      "additionalProperties": false,
      "description": "Add stamps to a card; a negative number deducts stamps.",
      "properties": {
        "scan_latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Latitude"
        },
        "scan_longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Longitude"
        },
        "card_id": {
          "description": "Card ID returned by list cards or enrol customer.",
          "minLength": 1,
          "title": "Card Id",
          "type": "string"
        },
        "operation": {
          "const": "add_stamps",
          "default": "add_stamps",
          "title": "Operation",
          "type": "string"
        },
        "stamps": {
          "title": "Stamps",
          "type": "integer"
        }
      },
      "required": [
        "card_id",
        "stamps"
      ],
      "title": "AddStamps",
      "type": "object"
    },
    "AddStampsByUniqueId": {
      "additionalProperties": false,
