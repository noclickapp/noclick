        "unique_id_value": {
          "minLength": 1,
          "title": "Unique Id Value",
          "type": "string"
        },
        "operation": {
          "const": "add_stamps_by_unique_id",
          "default": "add_stamps_by_unique_id",
          "title": "Operation",
          "type": "string"
        },
        "stamps": {
          "title": "Stamps",
          "type": "integer"
