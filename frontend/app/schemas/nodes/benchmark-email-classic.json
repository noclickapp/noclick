    "BenchmarkEmailClassicCredential": {
      "properties": {
        "credential_type": {
          "const": "benchmark_email_classic_api_token",
          "default": "benchmark_email_classic_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Admin API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Benchmark Email Classic API Token",
      "type": "object",
      "x-credential-instructions": "In Benchmark Email Classic, open Integrations \u2192 API and copy your Admin API Token. Paste the token alone. NoClick sends it in the AuthToken header to Benchmark's Classic API. This is separate from the newer Benchmark Email API key.",
      "x-credential-url": "https://ui.benchmarkemail.com/Integrate#AP"
    },
    "CreateContact": {
      "additionalProperties": false,
      "properties": {
        "list_id": {
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[0-9]+$",
          "title": "List ID",
          "type": "string"
        },
        "operation": {
          "const": "create_contact",
          "default": "create_contact",
          "title": "Add Contact to List",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Contacts",
          "x-display-name": "Add Contact to List"
        },
        "email": {
          "maxLength": 254,
          "minLength": 1,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
          "title": "Email",
          "type": "string"
        },
        "first_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "email_permission": {
          "description": "1 only when the contact gave permission to receive email; 0 otherwise.",
          "enum": [
            "0",
            "1"
          ],
          "title": "Email Permission",
          "type": "string"
        }
      },
      "required": [
        "list_id",
        "email",
        "email_permission"
      ],
      "title": "CreateContact",
      "type": "object"
    },
    "CreateEmail": {
      "additionalProperties": false,
      "description": "Create campaign details without calling the send or schedule endpoints.",
      "properties": {
        "operation": {
          "const": "create_email",
          "default": "create_email",
