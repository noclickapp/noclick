        "version": {
          "default": "400",
          "description": "Classic editor version; the collection's draft example uses 400.",
          "maxLength": 20,
          "title": "Editor Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "subject",
        "from_name",
        "from_email",
        "reply_email"
