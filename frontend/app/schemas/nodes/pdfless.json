{
  "$defs": {
    "PdflessAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "pdfless_api_key",
          "default": "pdfless_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Pdfless API Key",
      "type": "object",
      "x-credential-instructions": "Copy the API key from Workspace settings \u2192 API credentials. NoClick sends it in the apikey header to api.pdfless.com.",
      "x-credential-url": "https://app.pdfless.com/",
      "x-help-url": "https://docs.pdfless.com/authentication"
    },
    "PdflessGeneratePDFConfig": {
      "additionalProperties": false,
      "description": "Generate a PDF from a template and JSON data; returns its temporary download URL.",
      "properties": {
        "operation": {
          "const": "generate_pdf",
          "default": "generate_pdf",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "template_id": {
          "description": "UUID of the Pdfless template.",
          "title": "Template ID",
          "type": "string"
        },
        "payload": {
          "default": "{}",
          "description": "JSON data used by the template.",
          "title": "Payload JSON",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "workspace_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace ID"
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference ID"
        },
        "encryption_user_password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document password",
          "ui:widget": "password"
        },
        "encryption_owner_password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permissions password",
          "ui:widget": "password"
        },
        "encryption_allow_printing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encryption Allow Printing"
        },
        "encryption_allow_modifying": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encryption Allow Modifying"
        },
        "encryption_allow_modify_annotations": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encryption Allow Modify Annotations"
        },
        "encryption_allow_content_copying": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encryption Allow Content Copying"
        },
        "encryption_allow_screenreaders": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encryption Allow Screenreaders"
        },
        "encryption_allow_form_filling": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encryption Allow Form Filling"
        },
        "encryption_allow_document_assembly": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encryption Allow Document Assembly"
        }
      },
      "required": [
        "template_id"
      ],
      "title": "PdflessGeneratePDFConfig",
      "type": "object"
    },
    "PdflessGetWorkspaceConfig": {
      "additionalProperties": false,
      "description": "Read the connected workspace's name, status and PDF quota.",
      "properties": {
        "operation": {
          "const": "get_workspace",
          "default": "get_workspace",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "PdflessGetWorkspaceConfig",
      "type": "object"
    },
    "PdflessListDocumentTemplatesConfig": {
      "additionalProperties": false,
      "description": "List one page of document templates in the current workspace.",
      "properties": {
        "operation": {
          "const": "list_document_templates",
          "default": "list_document_templates",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional WorkspaceId filter; omit for the connected workspace.",
          "title": "Workspace ID"
        },
        "page": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional Page query parameter. Omit to use the provider's default.",
          "title": "Page"
        },
        "page_size": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional PageSize query parameter. Returns one page only.",
          "title": "Page size"
        }
      },
      "title": "PdflessListDocumentTemplatesConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "generate_pdf": "#/$defs/PdflessGeneratePDFConfig",
          "get_workspace": "#/$defs/PdflessGetWorkspaceConfig",
          "list_document_templates": "#/$defs/PdflessListDocumentTemplatesConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PdflessGetWorkspaceConfig"
        },
        {
          "$ref": "#/$defs/PdflessListDocumentTemplatesConfig"
        },
        {
          "$ref": "#/$defs/PdflessGeneratePDFConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/PdflessAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Pdfless Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
