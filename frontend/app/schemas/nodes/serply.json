            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional X-User-Agent header. Serply defaults to desktop.",
          "title": "Device",
          "enum": [
            "desktop",
            "mobile"
          ],
          "x-enum-searchable": true
        },
