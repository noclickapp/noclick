{
  "$defs": {
    "ImageKitAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "imagekit_io_api_key",
          "default": "imagekit_io_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "private_api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Private API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "private_api_key"
      ],
      "title": "Imagekit.io API Key",
      "type": "object",
      "x-credential-instructions": "In the ImageKit dashboard, open Developer options \u2192 API keys. Paste a private API key with the read and write permissions your operations need. NoClick verifies access by listing your media library. Public keys do not authenticate server-side API calls.",
      "x-credential-url": "https://imagekit.io/dashboard/developer/api-keys"
    },
    "ImageKitAddTagsConfig": {
      "additionalProperties": false,
      "description": "Add tags to multiple files; inspect partial failures.",
      "properties": {
        "operation": {
          "const": "add_tags",
          "default": "add_tags",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "File Ids",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "file_ids",
        "tags"
      ],
      "title": "ImageKitAddTagsConfig",
      "type": "object"
    },
    "ImageKitCopyFileConfig": {
