    "ImageKitDeleteFilesConfig": {
      "additionalProperties": false,
      "description": "Permanently delete multiple files; inspect partial failures.",
      "properties": {
        "operation": {
          "const": "delete_files",
          "default": "delete_files",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "File Ids",
          "type": "array"
        }
      },
      "required": [
        "file_ids"
      ],
      "title": "ImageKitDeleteFilesConfig",
      "type": "object"
    },
    "ImageKitDeleteFolderConfig": {
      "additionalProperties": false,
