          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "File Id",
          "type": "string"
        },
        "version_id": {
          "maxLength": 256,
          "minLength": 1,
