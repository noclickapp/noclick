      "properties": {
        "operation": {
          "const": "copy_file",
          "default": "copy_file",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "source_file_path": {
          "minLength": 1,
          "title": "Source File Path",
          "type": "string"
        },
        "destination_path": {
          "minLength": 1,
          "title": "Destination Path",
          "type": "string"
        },
        "include_file_versions": {
          "default": false,
          "title": "Include File Versions",
          "type": "boolean"
        }
      },
      "required": [
        "source_file_path",
        "destination_path"
      ],
      "title": "ImageKitCopyFileConfig",
      "type": "object"
    },
    "ImageKitCreateFolderConfig": {
