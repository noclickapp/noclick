      "properties": {
        "operation": {
          "const": "delete_folder",
          "default": "delete_folder",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "folder_path": {
          "minLength": 1,
          "title": "Folder Path",
          "type": "string"
        }
      },
      "required": [
        "folder_path"
      ],
      "title": "ImageKitDeleteFolderConfig",
      "type": "object"
    },
    "ImageKitGetFileConfig": {
      "additionalProperties": false,
      "description": "Read file details.",
      "properties": {
        "operation": {
          "const": "get_file",
          "default": "get_file",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "ImageKitGetFileConfig",
      "type": "object"
    },
    "ImageKitGetFileMetadataConfig": {
      "additionalProperties": false,
      "description": "Read embedded metadata from an uploaded file.",
      "properties": {
        "operation": {
          "const": "get_file_metadata",
          "default": "get_file_metadata",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "ImageKitGetFileMetadataConfig",
      "type": "object"
    },
    "ImageKitGetFileVersionConfig": {
      "additionalProperties": false,
      "description": "Read one file version.",
      "properties": {
        "operation": {
          "const": "get_file_version",
          "default": "get_file_version",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "File Id",
          "type": "string"
        },
        "version_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "version_id"
      ],
      "title": "ImageKitGetFileVersionConfig",
      "type": "object"
    },
    "ImageKitGetPurgeStatusConfig": {
      "additionalProperties": false,
      "description": "Read cache invalidation status.",
      "properties": {
        "operation": {
          "const": "get_purge_status",
          "default": "get_purge_status",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "request_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "ImageKitGetPurgeStatusConfig",
      "type": "object"
    },
    "ImageKitListCustomMetadataFieldsConfig": {
      "additionalProperties": false,
      "description": "List custom metadata field definitions.",
      "properties": {
        "operation": {
          "const": "list_custom_metadata_fields",
          "default": "list_custom_metadata_fields",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ImageKitListCustomMetadataFieldsConfig",
      "type": "object"
    },
    "ImageKitListFileVersionsConfig": {
      "additionalProperties": false,
      "description": "List versions of a file.",
      "properties": {
        "operation": {
          "const": "list_file_versions",
          "default": "list_file_versions",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "ImageKitListFileVersionsConfig",
      "type": "object"
    },
    "ImageKitListFilesConfig": {
      "additionalProperties": false,
      "description": "List and search a single page of assets.",
      "properties": {
        "operation": {
          "const": "list_files",
          "default": "list_files",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "type": {
          "default": "file",
          "enum": [
            "file",
            "file-version",
            "folder",
            "all"
          ],
          "title": "Type",
          "type": "string"
        },
        "sort": {
          "default": "ASC_CREATED",
          "enum": [
            "ASC_NAME",
            "DESC_NAME",
            "ASC_CREATED",
            "DESC_CREATED",
            "ASC_UPDATED",
            "DESC_UPDATED",
            "ASC_SIZE",
            "DESC_SIZE"
          ],
          "title": "Sort",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "search_query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Query"
        },
        "file_type": {
          "default": "all",
          "enum": [
            "all",
            "image",
            "non-image"
          ],
          "title": "File Type",
          "type": "string"
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "skip": {
          "default": 0,
          "minimum": 0,
          "title": "Skip",
          "type": "integer"
        }
      },
      "title": "ImageKitListFilesConfig",
      "type": "object"
    },
    "ImageKitMoveFileConfig": {
      "additionalProperties": false,
      "description": "Move a file and all versions; existing destination files receive the versions.",
      "properties": {
        "operation": {
          "const": "move_file",
          "default": "move_file",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "source_file_path": {
          "minLength": 1,
          "title": "Source File Path",
          "type": "string"
        },
        "destination_path": {
          "minLength": 1,
          "title": "Destination Path",
          "type": "string"
        }
      },
      "required": [
        "source_file_path",
        "destination_path"
      ],
      "title": "ImageKitMoveFileConfig",
      "type": "object"
    },
    "ImageKitPurgeCacheConfig": {
      "additionalProperties": false,
      "description": "Request CDN cache invalidation; completion requires checking status.",
      "properties": {
        "operation": {
          "const": "purge_cache",
          "default": "purge_cache",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "ImageKitPurgeCacheConfig",
      "type": "object"
    },
    "ImageKitRemoveAiTagsConfig": {
      "additionalProperties": false,
      "description": "Remove AI tags from multiple files; inspect partial failures.",
      "properties": {
        "operation": {
          "const": "remove_ai_tags",
          "default": "remove_ai_tags",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "File Ids",
          "type": "array"
        },
        "ai_tags": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Ai Tags",
          "type": "array"
        }
      },
      "required": [
        "file_ids",
        "ai_tags"
      ],
      "title": "ImageKitRemoveAiTagsConfig",
      "type": "object"
    },
    "ImageKitRemoveTagsConfig": {
      "additionalProperties": false,
      "description": "Remove tags from multiple files; inspect partial failures.",
      "properties": {
        "operation": {
          "const": "remove_tags",
          "default": "remove_tags",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "File Ids",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "file_ids",
        "tags"
      ],
      "title": "ImageKitRemoveTagsConfig",
      "type": "object"
    },
    "ImageKitRenameFileConfig": {
      "additionalProperties": false,
      "description": "Rename all versions; old URLs stop working outside CDN cache.",
      "properties": {
        "operation": {
          "const": "rename_file",
          "default": "rename_file",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_path": {
          "minLength": 1,
          "title": "File Path",
          "type": "string"
        },
        "new_file_name": {
          "minLength": 1,
          "title": "New File Name",
          "type": "string"
        },
        "purge_cache": {
          "default": false,
          "title": "Purge Cache",
          "type": "boolean"
        }
      },
      "required": [
        "file_path",
        "new_file_name"
      ],
      "title": "ImageKitRenameFileConfig",
      "type": "object"
    },
    "ImageKitRestoreFileVersionConfig": {
      "additionalProperties": false,
      "description": "Restore a previous version as the current version.",
      "properties": {
        "operation": {
          "const": "restore_file_version",
          "default": "restore_file_version",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "File Id",
          "type": "string"
        },
        "version_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "version_id"
      ],
      "title": "ImageKitRestoreFileVersionConfig",
      "type": "object"
    },
    "ImageKitUpdateFileConfig": {
      "additionalProperties": false,
      "description": "Update tags, description or existing custom metadata fields.",
      "properties": {
        "operation": {
          "const": "update_file",
          "default": "update_file",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "File Id",
          "type": "string"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replaces tags; an empty list clears them.",
          "title": "Tags"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "custom_metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing metadata fields only; null values unset individual keys.",
          "title": "Custom Metadata"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "ImageKitUpdateFileConfig",
      "type": "object"
    },
    "ImageKitUploadFileConfig": {
      "additionalProperties": false,
      "description": "Upload a publicly accessible URL; ImageKit fetches the source.",
      "properties": {
        "operation": {
          "const": "upload_file",
          "default": "upload_file",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "file": {
          "description": "Public HTTP or HTTPS source URL; fetched by ImageKit, not NoClick.",
          "title": "File",
          "type": "string"
        },
        "file_name": {
          "minLength": 1,
          "title": "File Name",
          "type": "string"
        },
        "folder": {
          "default": "/",
          "title": "Folder",
          "type": "string"
        },
        "use_unique_file_name": {
          "default": true,
          "description": "False replaces an existing file with the same name.",
          "title": "Use Unique File Name",
          "type": "boolean"
        },
        "is_private_file": {
          "default": false,
          "title": "Is Private File",
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "file_name"
      ],
      "title": "ImageKitUploadFileConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_tags": "#/$defs/ImageKitAddTagsConfig",
          "copy_file": "#/$defs/ImageKitCopyFileConfig",
          "create_folder": "#/$defs/ImageKitCreateFolderConfig",
          "delete_file": "#/$defs/ImageKitDeleteFileConfig",
          "delete_file_version": "#/$defs/ImageKitDeleteFileVersionConfig",
          "delete_files": "#/$defs/ImageKitDeleteFilesConfig",
          "delete_folder": "#/$defs/ImageKitDeleteFolderConfig",
          "get_file": "#/$defs/ImageKitGetFileConfig",
          "get_file_metadata": "#/$defs/ImageKitGetFileMetadataConfig",
          "get_file_version": "#/$defs/ImageKitGetFileVersionConfig",
          "get_purge_status": "#/$defs/ImageKitGetPurgeStatusConfig",
          "list_custom_metadata_fields": "#/$defs/ImageKitListCustomMetadataFieldsConfig",
          "list_file_versions": "#/$defs/ImageKitListFileVersionsConfig",
          "list_files": "#/$defs/ImageKitListFilesConfig",
          "move_file": "#/$defs/ImageKitMoveFileConfig",
          "purge_cache": "#/$defs/ImageKitPurgeCacheConfig",
          "remove_ai_tags": "#/$defs/ImageKitRemoveAiTagsConfig",
          "remove_tags": "#/$defs/ImageKitRemoveTagsConfig",
          "rename_file": "#/$defs/ImageKitRenameFileConfig",
          "restore_file_version": "#/$defs/ImageKitRestoreFileVersionConfig",
          "update_file": "#/$defs/ImageKitUpdateFileConfig",
          "upload_file": "#/$defs/ImageKitUploadFileConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ImageKitListFilesConfig"
        },
        {
          "$ref": "#/$defs/ImageKitUploadFileConfig"
        },
        {
          "$ref": "#/$defs/ImageKitGetFileConfig"
        },
        {
          "$ref": "#/$defs/ImageKitUpdateFileConfig"
        },
        {
          "$ref": "#/$defs/ImageKitDeleteFileConfig"
        },
        {
          "$ref": "#/$defs/ImageKitDeleteFilesConfig"
        },
        {
          "$ref": "#/$defs/ImageKitCopyFileConfig"
        },
        {
          "$ref": "#/$defs/ImageKitMoveFileConfig"
        },
        {
          "$ref": "#/$defs/ImageKitRenameFileConfig"
        },
        {
          "$ref": "#/$defs/ImageKitListFileVersionsConfig"
        },
        {
          "$ref": "#/$defs/ImageKitGetFileVersionConfig"
        },
        {
          "$ref": "#/$defs/ImageKitDeleteFileVersionConfig"
        },
        {
          "$ref": "#/$defs/ImageKitRestoreFileVersionConfig"
        },
        {
          "$ref": "#/$defs/ImageKitAddTagsConfig"
        },
        {
          "$ref": "#/$defs/ImageKitRemoveTagsConfig"
        },
        {
          "$ref": "#/$defs/ImageKitRemoveAiTagsConfig"
        },
        {
          "$ref": "#/$defs/ImageKitCreateFolderConfig"
        },
        {
          "$ref": "#/$defs/ImageKitDeleteFolderConfig"
        },
        {
          "$ref": "#/$defs/ImageKitPurgeCacheConfig"
        },
        {
          "$ref": "#/$defs/ImageKitGetPurgeStatusConfig"
        },
        {
          "$ref": "#/$defs/ImageKitGetFileMetadataConfig"
        },
        {
          "$ref": "#/$defs/ImageKitListCustomMetadataFieldsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImageKitAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Imagekit-io Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
