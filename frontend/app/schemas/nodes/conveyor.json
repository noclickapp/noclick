          "x-enum-searchable": true
        },
        "product_line_ids": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated Product Line UUIDs. These are the applicable product lines for the document. Leave blank if applicable to all product lines.",
          "title": "Product Line Ids"
        },
        "access_group_ids": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated Access Group UUIDs",
          "title": "Access Group Ids"
        },
        "disable_downloads": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Disable downloads for this document",
          "title": "Disable Downloads"
        },
        "use_for_question_answering": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use this document for question answering. If not provided, it will be automatically determined based on whether the document can be used for question answering.",
          "title": "Use For Question Answering"
        },
        "document_id": {
          "description": "UUID of the document",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        }
