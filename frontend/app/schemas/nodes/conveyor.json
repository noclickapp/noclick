            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When set to true, this document will be 'featured' on a public profile",
          "title": "Featured"
        },
        "folder_id": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
