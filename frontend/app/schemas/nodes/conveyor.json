            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the document",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Description of the document",
          "title": "Description"
        },
        "certification": {
