{
  "$defs": {
    "AbyssaleApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "abyssale_api_key",
          "default": "abyssale_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Abyssale API Key",
      "type": "object",
      "x-credential-instructions": "In Abyssale, open Workspace settings \u2192 API key and copy an existing API key. An Admin can create one there. Paste the key alone. NoClick sends it in x-api-key to api.abyssale.com. Generation uses your workspace credits; a webhook signing secret is a different credential.",
      "x-credential-url": "https://developers.abyssale.com/rest-api/authentication#how-to-get-an-api-key"
    },
    "CreateDynamicImageUrl": {
      "additionalProperties": false,
      "description": "Create a dynamic image URL for a static design.",
      "properties": {
        "design_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Design Id",
          "type": "string"
        },
        "operation": {
          "const": "create_dynamic_image_url",
          "default": "create_dynamic_image_url",
          "title": "Operation",
          "type": "string"
        },
        "enable_rate_limit": {
          "default": false,
          "title": "Enable Rate Limit",
          "type": "boolean"
        },
        "enable_production_mode": {
          "default": false,
          "title": "Enable Production Mode",
          "type": "boolean"
        }
      },
      "required": [
        "design_id"
      ],
      "title": "CreateDynamicImageUrl",
      "type": "object"
    },
    "CreateProject": {
      "additionalProperties": false,
      "description": "Create a workspace project with a unique name.",
      "properties": {
        "operation": {
          "const": "create_project",
          "default": "create_project",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 2,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateProject",
      "type": "object"
    },
    "DeleteDesign": {
      "additionalProperties": false,
      "description": "Permanently delete a design. This cannot be undone.",
      "properties": {
        "design_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Design Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_design",
          "default": "delete_design",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "design_id"
      ],
      "title": "DeleteDesign",
      "type": "object"
    },
    "DuplicateWorkspaceTemplate": {
      "additionalProperties": false,
      "description": "Queue duplication of a workspace template into an existing project.",
      "properties": {
        "operation": {
          "const": "duplicate_workspace_template",
          "default": "duplicate_workspace_template",
          "title": "Operation",
          "type": "string"
        },
        "company_template_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Company Template Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "company_template_id",
        "project_id"
      ],
      "title": "DuplicateWorkspaceTemplate",
      "type": "object"
    },
    "ExportBanners": {
      "additionalProperties": false,
      "description": "Queue a ZIP export; callback_url receives the asynchronous result.",
      "properties": {
        "operation": {
          "const": "export_banners",
          "default": "export_banners",
          "title": "Operation",
          "type": "string"
        },
        "ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "callback_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback Url"
        }
      },
      "required": [
        "ids"
      ],
      "title": "ExportBanners",
      "type": "object"
    },
    "GenerateImage": {
      "additionalProperties": false,
      "description": "Generate one image synchronously, spending workspace generation credits.",
      "properties": {
        "design_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Design Id",
          "type": "string"
        },
        "operation": {
          "const": "generate_image",
          "default": "generate_image",
          "title": "Operation",
          "type": "string"
        },
        "template_format_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Format Name"
        },
        "elements": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "Layer names mapped to property objects, e.g. {\"title\": {\"payload\": \"Summer sale\"}}. Properties depend on the design's layer types; use Get Design first.",
          "title": "Elements",
          "type": "object"
        },
        "image_file_type": {
          "anyOf": [
            {
              "enum": [
                "png",
                "jpeg",
                "webp",
                "avif",
                "pdf",
                "auto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image File Type",
          "enum": [
            "png",
            "jpeg",
            "webp",
            "avif",
            "pdf",
            "auto"
          ],
          "x-enum-searchable": true
        },
        "original_visual_id": {
          "anyOf": [
            {
              "maxLength": 36,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Visual Id"
        },
        "file_compression_level": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Compression Level"
        }
      },
      "required": [
        "design_id"
      ],
      "title": "GenerateImage",
      "type": "object"
    },
    "GenerateMedia": {
      "additionalProperties": false,
      "description": "Queue multi-format media; poll Get Generation Request for completion.",
      "properties": {
        "design_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Design Id",
          "type": "string"
        },
        "operation": {
          "const": "generate_media",
          "default": "generate_media",
          "title": "Operation",
          "type": "string"
        },
        "template_format_names": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit or use [] to generate all design formats.",
          "title": "Template Format Names"
        },
        "elements": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "Layer names mapped to property objects, as returned by Get Design.",
          "title": "Elements",
          "type": "object"
        },
        "image_file_type": {
          "anyOf": [
            {
              "enum": [
                "png",
                "jpeg",
                "webp",
                "avif",
                "gif",
                "pdf",
                "html5",
                "mp4",
                "auto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image File Type",
          "enum": [
            "png",
            "jpeg",
            "webp",
            "avif",
            "gif",
            "pdf",
            "html5",
            "mp4",
            "auto"
          ],
          "x-enum-searchable": true
        },
        "file_compression_level": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Compression Level"
        },
        "callback_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback Url"
        }
      },
      "required": [
        "design_id"
      ],
      "title": "GenerateMedia",
      "type": "object"
    },
    "GetCredits": {
      "additionalProperties": false,
      "description": "Read remaining workspace generation and AI credits.",
      "properties": {
        "operation": {
          "const": "get_credits",
          "default": "get_credits",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetCredits",
      "type": "object"
    },
    "GetDesign": {
      "additionalProperties": false,
      "description": "Read a design, its formats and customizable layers.",
      "properties": {
        "design_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Design Id",
          "type": "string"
        },
        "operation": {
          "const": "get_design",
          "default": "get_design",
          "title": "Operation",
          "type": "string"
        },
        "i": {
          "anyOf": [
            {
              "const": "advanced",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Include the full layer/property set, including groups.",
          "title": "I"
        }
      },
      "required": [
        "design_id"
      ],
      "title": "GetDesign",
      "type": "object"
    },
    "GetDesignFormat": {
      "additionalProperties": false,
      "description": "Read one format by stable UID or format name.",
      "properties": {
        "design_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Design Id",
          "type": "string"
        },
        "operation": {
          "const": "get_design_format",
          "default": "get_design_format",
          "title": "Operation",
          "type": "string"
        },
        "format_specifier": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Format Specifier",
          "type": "string"
        }
      },
      "required": [
        "design_id",
        "format_specifier"
      ],
      "title": "GetDesignFormat",
      "type": "object"
    },
    "GetDuplicationRequest": {
      "additionalProperties": false,
      "description": "Poll template duplication once; statuses expire after seven days.",
      "properties": {
        "operation": {
          "const": "get_duplication_request",
          "default": "get_duplication_request",
          "title": "Operation",
          "type": "string"
        },
        "duplicate_request_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Duplicate Request Id",
          "type": "string"
        }
      },
      "required": [
        "duplicate_request_id"
      ],
      "title": "GetDuplicationRequest",
      "type": "object"
    },
    "GetFile": {
      "additionalProperties": false,
      "description": "Read generated asset metadata and file URLs without downloading bytes.",
      "properties": {
        "operation": {
          "const": "get_file",
          "default": "get_file",
          "title": "Operation",
          "type": "string"
        },
        "banner_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Banner Id",
          "type": "string"
        }
      },
      "required": [
        "banner_id"
      ],
      "title": "GetFile",
      "type": "object"
    },
    "GetGenerationRequest": {
      "additionalProperties": false,
      "description": "Poll a generation request once. A 202 means generation is still running.",
      "properties": {
        "operation": {
          "const": "get_generation_request",
          "default": "get_generation_request",
          "title": "Operation",
          "type": "string"
        },
        "generation_request_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Generation Request Id",
          "type": "string"
        }
      },
      "required": [
        "generation_request_id"
      ],
      "title": "GetGenerationRequest",
      "type": "object"
    },
    "ListDesigns": {
      "additionalProperties": false,
      "description": "Search designs by name and project, returning one explicit page.",
      "properties": {
        "page": {
          "default": 1,
          "description": "1-based page. Use next_page from the previous result.",
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "operation": {
          "const": "list_designs",
          "default": "list_designs",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "maxLength": 36,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "At most eight search words.",
          "title": "Query"
        },
        "type": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "static",
                  "animated",
                  "printer",
                  "printer_multipage"
                ],
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "orientation": {
          "anyOf": [
            {
              "enum": [
                "portrait",
                "landscape",
                "square"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orientation",
          "enum": [
            "portrait",
            "landscape",
            "square"
          ],
          "x-enum-searchable": true
        },
        "sort": {
          "default": "name",
          "enum": [
            "name",
            "updated",
            "created"
          ],
          "title": "Sort",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order",
          "enum": [
            "asc",
            "desc"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "ListDesigns",
      "type": "object"
    },
    "ListFonts": {
      "additionalProperties": false,
      "description": "Search fonts by name, type and category.",
      "properties": {
        "page": {
          "default": 1,
          "description": "1-based page. Use next_page from the previous result.",
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "operation": {
          "const": "list_fonts",
          "default": "list_fonts",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "google",
                "custom"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type",
          "enum": [
            "google",
            "custom"
          ],
          "x-enum-searchable": true
        },
        "category": {
          "anyOf": [
            {
              "enum": [
                "serif",
                "sans-serif",
                "display",
                "handwriting",
                "monospace"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category",
          "enum": [
            "serif",
            "sans-serif",
            "display",
            "handwriting",
            "monospace"
          ],
          "x-enum-searchable": true
        },
        "weight": {
          "anyOf": [
            {
              "enum": [
                100,
                200,
                300,
                400,
                500,
                600,
                700,
                800,
                900
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "normal",
                "italic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style",
          "enum": [
            "normal",
            "italic"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "ListFonts",
      "type": "object"
    },
