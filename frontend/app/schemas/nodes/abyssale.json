      "properties": {
        "design_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Design Id",
          "type": "string"
        },
        "operation": {
          "const": "rename_design",
          "default": "rename_design",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
