          "delete_design": "#/$defs/DeleteDesign",
          "duplicate_workspace_template": "#/$defs/DuplicateWorkspaceTemplate",
          "export_banners": "#/$defs/ExportBanners",
          "generate_image": "#/$defs/GenerateImage",
          "generate_media": "#/$defs/GenerateMedia",
          "get_credits": "#/$defs/GetCredits",
          "get_design": "#/$defs/GetDesign",
          "get_design_format": "#/$defs/GetDesignFormat",
          "get_duplication_request": "#/$defs/GetDuplicationRequest",
          "get_file": "#/$defs/GetFile",
          "get_generation_request": "#/$defs/GetGenerationRequest",
          "list_designs": "#/$defs/ListDesigns",
          "list_fonts": "#/$defs/ListFonts",
          "list_projects": "#/$defs/ListProjects",
          "list_workspace_template_categories": "#/$defs/ListWorkspaceTemplateCategories",
