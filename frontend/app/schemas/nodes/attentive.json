          "description": "Two-letter country code of the locale. [ISO-3166-1 alpha 2](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2) is required. Values are case sensitive and must match exactly.",
          "title": "Country"
        }
      },
      "title": "LocaleDto",
      "type": "object"
    },
    "NewExternalIdentifierDto": {
      "additionalProperties": false,
      "properties": {
        "clientUserId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Notes:\nSending duplicate values could lead to unintentionally bridging users together.\nDon't use customIdentifiers to send attributes (e.g., first name, last name). To send those types of attributes, use our Custom Attributes API.\nAvoid sending null values or empty strings. If you don't have a valid identifier, you should omit the field from the payload.\n",
          "title": "Clientuserid"
        },
        "shopifyId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Notes:\nSending duplicate values could lead to unintentionally bridging users together.\nDon't use customIdentifiers to send attributes (e.g., first name, last name). To send those types of attributes, use our Custom Attributes API.\nAvoid sending null values or empty strings. If you don't have a valid identifier, you should omit the field from the payload.\n",
          "title": "Shopifyid"
        },
        "klaviyoId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Notes:\nSending duplicate values could lead to unintentionally bridging users together.\nDon't use customIdentifiers to send attributes (e.g., first name, last name). To send those types of attributes, use our Custom Attributes API.\nAvoid sending null values or empty strings. If you don't have a valid identifier, you should omit the field from the payload.\n",
          "title": "Klaviyoid"
        },
        "customIdentifiers": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CustomIdentifierDto"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customidentifiers",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "title": "NewExternalIdentifierDto",
      "type": "object"
    },
    "NotificationConfigDto": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Standard language tags as defined by the ISO. Currently only supports en-US and fr-CA. Case sensitive, must match exactly.",
          "title": "Language"
        },
        "disabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A boolean representing if a user should not receive a confirmation message upon unsubscribing. Assumed false by default.",
          "title": "Disabled"
        }
      },
      "title": "NotificationConfigDto",
      "type": "object"
    },
    "Price": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "description": "The price of the product.",
          "title": "Value",
          "type": "number"
        },
        "currency": {
          "default": "USD",
          "description": "The currency used for the price in [ISO 4217 format](https://www.iso.org/iso-4217-currency-codes.html).",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Price",
      "type": "object"
    },
    "ProductRequest": {
      "additionalProperties": false,
      "properties": {
        "productId": {
          "description": "A unique identifier for the product (i.e. \"T-Shirt\"). If you are providing a [Google Shopping Feed](https://support.google.com/merchants/answer/7052112?hl=en), this should be [item_group_id](https://support.google.com/merchants/answer/6324507). If you don't have an [item_group_id](https://support.google.com/merchants/answer/6324507) in your feed, use [id](https://support.google.com/merchants/answer/6324405). If you are using [Shopify](https://help.shopify.com/en/manual/products), this should be Shopify product ID.\n",
          "minLength": 1,
          "title": "Productid",
          "type": "string"
        },
        "productVariantId": {
          "description": "A unique identifier for the product variant (i.e. \"Medium Blue T-Shirt\"). If you are providing a [Google Shopping Feed](https://support.google.com/merchants/answer/7052112?hl=en), this should be [id](https://support.google.com/merchants/answer/6324405). If you are using Shopify, this should be Shopify product Variant ID.\n",
          "minLength": 1,
          "title": "Productvariantid",
          "type": "string"
        },
        "productImage": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A link to the image of the product. The image should not be larger than 500kb. This image will be used when sending MMS text messages.\n",
          "title": "Productimage"
        },
        "productUrl": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The URL for the product.",
          "title": "Producturl"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The name of the product. This should be in a format that could be used directly in a message.",
          "title": "Name"
        },
        "price": {
          "description": "The price and currency of the product.",
          "items": {
            "$ref": "#/$defs/Price"
          },
          "minItems": 1,
          "title": "Price",
          "type": "array",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The number of products.",
          "title": "Quantity"
        }
      },
      "required": [
        "productId",
        "productVariantId",
        "price"
      ],
      "title": "ProductRequest",
      "type": "object"
    },
    "RecordAddToCartConfig": {
