    "ArchiveGoal": {
      "description": "Archive a goal.",
      "properties": {
        "operation": {
          "const": "archive_goal",
          "default": "archive_goal",
          "title": "Operation",
          "type": "string"
        },
        "goal_id": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Goal Id",
          "type": "integer"
        }
      },
      "required": [
        "goal_id"
      ],
      "title": "ArchiveGoal",
      "type": "object"
    },
    "BloomGrowthTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "bloom_growth_api_token",
          "default": "bloom_growth_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Bloom Growth API Token",
      "type": "object",
      "x-credential-instructions": "Generate an access_token using Bloom Growth's API instructions and paste the token here without the Bearer prefix. Tokens expire after two weeks; replace an expired token with a newly generated one. NoClick sends it only to app-next.bloomgrowth.com.",
      "x-credential-type": "api_key",
      "x-credential-url": "https://help.bloomgrowth.com/en/all-about-the-bloom-growth-api"
    },
    "CompleteTodo": {
      "description": "Complete or reopen a to-do using the documented status query parameter.",
