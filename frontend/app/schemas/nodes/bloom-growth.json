          "type": "string"
        },
        "todo_id": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Todo Id",
          "type": "integer"
        },
        "completed": {
          "default": true,
          "title": "Completed",
          "type": "boolean"
        }
      },
      "required": [
        "todo_id"
      ],
      "title": "CompleteTodo",
      "type": "object"
    },
    "CreateGoal": {
