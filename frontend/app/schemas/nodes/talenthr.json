    "TalenthrHireEmployeeConfig": {
      "additionalProperties": false,
      "description": "Hire an employee. TalentHR sends invitation emails and starts onboarding tasks, which can notify task owners.",
      "properties": {
        "hire_date": {
          "format": "date",
          "title": "Hire Date",
          "type": "string"
        },
        "reports_to_employee_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Manager ID; null makes a new hire the company head.",
          "title": "Reports To Employee Id"
        },
        "employment_status": {
          "$ref": "#/$defs/EmploymentStatus"
