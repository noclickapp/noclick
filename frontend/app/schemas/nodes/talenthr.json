        "email": {
          "maxLength": 191,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email",
          "type": "string"
        },
        "operation": {
          "const": "hire_employee",
          "default": "hire_employee",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
