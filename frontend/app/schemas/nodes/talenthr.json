    "TalenthrTerminateEmployeeConfig": {
      "additionalProperties": false,
      "description": "Terminate an employee.",
      "properties": {
        "employee_id": {
          "description": "TalentHR employee ID.",
          "exclusiveMinimum": 0,
          "title": "Employee Id",
          "type": "integer"
        },
        "operation": {
          "const": "terminate_employee",
          "default": "terminate_employee",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "effective_date": {
          "description": "Termination date. Starts offboarding, emails task owners, reassigns reports and tasks, and removes future records and unanswered/rejected leave requests. Same-day termination revokes access immediately.",
          "format": "date",
          "title": "Effective Date",
          "type": "string"
        },
        "termination_reason": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Termination Reason"
        },
        "termination_type": {
          "anyOf": [
            {
              "enum": [
                "termination",
                "resignation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Termination Type",
          "enum": [
            "termination",
            "resignation"
          ],
          "x-enum-searchable": true
        },
        "regrettable_status": {
          "anyOf": [
            {
              "const": "regrettable",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regrettable Status"
        }
      },
      "required": [
        "employee_id",
        "effective_date"
      ],
      "title": "TalenthrTerminateEmployeeConfig",
      "type": "object"
    },
