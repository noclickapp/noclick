{
  "$defs": {
    "DevtoAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "devto_api_key",
          "default": "devto_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Devto API Key",
      "type": "object",
      "x-credential-instructions": "In DEV Settings \u2192 Extensions, create a DEV API Key and paste the key alone. NoClick sends it only to dev.to and reads your profile to check the connection. The key can read and publish articles with your account's permissions.",
      "x-credential-url": "https://dev.to/settings/extensions"
    },
    "DevtoCreateArticleConfig": {
      "additionalProperties": false,
      "description": "Create article in DEV Community.",
      "properties": {
        "operation": {
          "const": "create_article",
          "default": "create_article",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "title": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "body_markdown": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Body Markdown",
          "type": "string",
          "ui:widget": "textarea"
        },
        "published": {
          "default": false,
          "description": "Set true to publish immediately; false creates a draft.",
          "title": "Published",
          "type": "boolean"
        },
        "series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "main_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Image"
        },
        "canonical_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Url"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "tags": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated tags, as required by Forem API v1.",
          "title": "Tags"
        },
        "organization_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 2147483647,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        }
      },
      "required": [
        "title",
        "body_markdown"
      ],
      "title": "DevtoCreateArticleConfig",
      "type": "object"
    },
    "DevtoGetArticleByPathConfig": {
      "additionalProperties": false,
