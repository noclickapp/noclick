          "default": "delete_camera",
          "title": "Delete Camera",
          "type": "string",
          "ui:hidden": true
        },
        "serial": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Camera Serial",
          "type": "string"
        }
      },
      "required": [
        "license_id",
        "serial"
      ],
      "title": "DeleteCamera",
      "type": "object"
    },
