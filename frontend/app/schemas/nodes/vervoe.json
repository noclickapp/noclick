{
  "$defs": {
    "Application": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_application",
          "default": "get_application",
          "title": "Operation",
          "type": "string"
        },
        "assessment_slug": {
          "title": "Assessment Slug",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "assessment_slug",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "candidate_assessment_uuid": {
          "title": "Candidate Assessment Uuid",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "depends_on": "assessment_slug",
            "field_name": "candidate_assessment_uuid",
            "searchable": true
          }
        }
      },
      "required": [
        "assessment_slug",
        "candidate_assessment_uuid"
      ],
      "title": "Application",
      "type": "object"
    },
    "CreateFolder": {
      "additionalProperties": false,
      "properties": {
        "confirm_folder_change": {
          "const": true,
          "description": "Changes internal assessment organization. No invitation, hiring or scoring action is performed.",
          "title": "Confirm Folder Change",
          "type": "boolean"
        },
        "operation": {
          "const": "create_folder",
          "default": "create_folder",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "confirm_folder_change",
        "name"
      ],
      "title": "CreateFolder",
      "type": "object"
    },
    "DeleteFolder": {
      "additionalProperties": false,
      "properties": {
        "confirm_folder_change": {
          "const": true,
          "description": "Changes internal assessment organization. No invitation, hiring or scoring action is performed.",
          "title": "Confirm Folder Change",
          "type": "boolean"
        },
        "operation": {
          "const": "delete_folder",
          "default": "delete_folder",
          "title": "Operation",
          "type": "string"
        },
        "folder_uuid": {
          "title": "Folder Uuid",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "folder_uuid",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "confirm_folder_change",
        "folder_uuid"
      ],
      "title": "DeleteFolder",
      "type": "object"
    },
    "ListApplications": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_applications",
          "default": "list_applications",
          "title": "Operation",
          "type": "string"
        },
        "page": {
          "default": 1,
          "maximum": 100000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "sort": {
          "default": "updated",
          "enum": [
            "updated",
            "created",
            "completed"
          ],
          "title": "Sort",
          "type": "string"
        },
        "order": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Order",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "complete",
                "expired",
                "in_progress",
                "hired",
                "rejected",
                "screeningInProgress",
                "screeningFailed",
                "screeningPassed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "complete",
            "expired",
            "in_progress",
            "hired",
            "rejected",
            "screeningInProgress",
            "screeningFailed",
            "screeningPassed"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "ListApplications",
      "type": "object"
    },
    "ListAssessmentCandidates": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_assessment_candidates",
          "default": "list_assessment_candidates",
          "title": "Operation",
          "type": "string"
        },
        "assessment_slug": {
          "title": "Assessment Slug",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "assessment_slug",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "page": {
          "default": 1,
          "maximum": 100000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "assessment_slug"
      ],
      "title": "ListAssessmentCandidates",
      "type": "object"
    },
    "ListAssessmentFolders": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_assessment_folders",
          "default": "list_assessment_folders",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListAssessmentFolders",
      "type": "object"
    },
    "ListAssessments": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_assessments",
          "default": "list_assessments",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListAssessments",
      "type": "object"
    },
    "ListBrands": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_brands",
          "default": "list_brands",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListBrands",
      "type": "object"
    },
    "MoveAssessment": {
      "additionalProperties": false,
      "properties": {
        "confirm_folder_change": {
          "const": true,
          "description": "Changes internal assessment organization. No invitation, hiring or scoring action is performed.",
          "title": "Confirm Folder Change",
          "type": "boolean"
        },
        "operation": {
          "const": "move_assessment_to_folder",
          "default": "move_assessment_to_folder",
          "title": "Operation",
          "type": "string"
        },
        "assessment_slug": {
          "title": "Assessment Slug",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "assessment_slug",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "folder_uuid": {
          "title": "Folder Uuid",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "folder_uuid",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "confirm_folder_change",
        "assessment_slug",
        "folder_uuid"
      ],
      "title": "MoveAssessment",
      "type": "object"
    },
    "RemoveAssessment": {
      "additionalProperties": false,
      "properties": {
        "confirm_folder_change": {
          "const": true,
          "description": "Changes internal assessment organization. No invitation, hiring or scoring action is performed.",
          "title": "Confirm Folder Change",
          "type": "boolean"
        },
        "operation": {
          "const": "remove_assessment_from_folder",
          "default": "remove_assessment_from_folder",
          "title": "Operation",
          "type": "string"
        },
        "assessment_slug": {
          "title": "Assessment Slug",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "assessment_slug",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "confirm_folder_change",
        "assessment_slug"
      ],
      "title": "RemoveAssessment",
      "type": "object"
    },
    "RenameFolder": {
      "additionalProperties": false,
      "properties": {
        "confirm_folder_change": {
          "const": true,
          "description": "Changes internal assessment organization. No invitation, hiring or scoring action is performed.",
          "title": "Confirm Folder Change",
          "type": "boolean"
        },
        "operation": {
          "const": "rename_folder",
          "default": "rename_folder",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "folder_uuid": {
          "title": "Folder Uuid",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "folder_uuid",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "confirm_folder_change",
        "name",
        "folder_uuid"
      ],
      "title": "RenameFolder",
      "type": "object"
    },
    "VervoeAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "vervoe_api_key",
          "default": "vervoe_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "secret_key": {
          "title": "Secret Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key",
        "secret_key"
      ],
      "title": "Vervoe API Key",
      "type": "object",
      "x-credential-instructions": "Use an existing Enterprise or Partner API key and secret key. The node obtains a short-lived token for each invocation, without storing it or changing the account.",
      "x-credential-url": "https://vervoe.stoplight.io/docs/api-docs/ZG9jOjQ4ODIx-introduction"
    },
    "VervoeBearerTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "vervoe_bearer_token",
          "default": "vervoe_bearer_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "title": "Issued Bearer Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "Vervoe Bearer Token",
      "type": "object",
      "x-credential-instructions": "Paste an already issued Vervoe token without the Bearer prefix. Tokens expire after 10 minutes. This method does not mint or renew a token; use the API pair for ongoing workflows.",
      "x-credential-url": "https://vervoe.stoplight.io/docs/api-docs/ZG9jOjQ4ODIx-introduction"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_folder": "#/$defs/CreateFolder",
          "delete_folder": "#/$defs/DeleteFolder",
          "get_application": "#/$defs/Application",
          "list_applications": "#/$defs/ListApplications",
          "list_assessment_candidates": "#/$defs/ListAssessmentCandidates",
          "list_assessment_folders": "#/$defs/ListAssessmentFolders",
          "list_assessments": "#/$defs/ListAssessments",
          "list_brands": "#/$defs/ListBrands",
          "move_assessment_to_folder": "#/$defs/MoveAssessment",
          "remove_assessment_from_folder": "#/$defs/RemoveAssessment",
          "rename_folder": "#/$defs/RenameFolder"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListAssessments"
        },
        {
          "$ref": "#/$defs/ListAssessmentFolders"
        },
        {
          "$ref": "#/$defs/ListApplications"
        },
        {
          "$ref": "#/$defs/Application"
        },
        {
          "$ref": "#/$defs/ListAssessmentCandidates"
        },
        {
          "$ref": "#/$defs/ListBrands"
        },
        {
          "$ref": "#/$defs/CreateFolder"
        },
        {
          "$ref": "#/$defs/RenameFolder"
        },
        {
          "$ref": "#/$defs/MoveAssessment"
        },
        {
          "$ref": "#/$defs/DeleteFolder"
        },
        {
          "$ref": "#/$defs/RemoveAssessment"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/VervoeAPIKeyCredential"
        },
        {
          "$ref": "#/$defs/VervoeBearerTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "Vervoe Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "List my Vervoe assessments",
    "Check an application completion status",
    "Create an assessment folder",
    "Move an assessment into a folder"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
