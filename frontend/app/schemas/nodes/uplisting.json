{
  "$defs": {
    "CalendarDay": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "from_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive date range start.",
          "title": "From Date"
        },
        "to_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exclusive date range end.",
          "title": "To Date"
        },
        "available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available"
        },
        "day_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day Rate"
        },
        "minimum_length_of_stay": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Length Of Stay"
        },
        "closed_for_arrival": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closed For Arrival"
        },
        "closed_for_departure": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closed For Departure"
        }
      },
      "title": "CalendarDay",
      "type": "object"
    },
    "CreateBooking": {
      "additionalProperties": false,
      "description": "Create a confirmed booking (requires partner client ID).",
      "properties": {
        "operation": {
          "const": "create_booking",
          "default": "create_booking",
          "title": "Operation",
          "type": "string"
        },
        "property_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Property Id",
          "type": "string"
        },
        "check_in": {
          "format": "date",
          "title": "Check In",
          "type": "string"
        },
        "check_out": {
          "format": "date",
          "title": "Check Out",
          "type": "string"
        },
        "guest_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guest Name"
        },
        "guest_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guest Email"
        },
        "guest_phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guest Phone"
        },
        "number_of_guests": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number Of Guests"
        }
      },
      "required": [
        "property_id",
        "check_in",
        "check_out"
      ],
      "title": "CreateBooking",
      "type": "object"
    },
    "CreateCustomBookingAttribute": {
      "additionalProperties": false,
      "description": "Create a namespaced attribute; Uplisting must configure the partner prefix.",
      "properties": {
        "operation": {
          "const": "create_custom_booking_attribute",
          "default": "create_custom_booking_attribute",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "CreateCustomBookingAttribute",
      "type": "object"
    },
    "CreateHook": {
      "additionalProperties": false,
      "description": "Register a webhook; retain its returned secret to verify deliveries.",
      "properties": {
        "operation": {
          "const": "create_hook",
          "default": "create_hook",
          "title": "Operation",
          "type": "string"
        },
        "target_url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Target Url",
          "type": "string"
        },
        "event": {
          "enum": [
            "booking_created",
            "booking_updated",
            "booking_removed",
            "booking_cancelled",
            "booking_request_approved",
            "booking_request_declined",
            "property_created",
            "property_updated",
            "property_removed",
            "prices_changed",
            "restrictions_changed",
            "availability_changed",
            "message_created",
            "payment_status_changed",
            "payment_refunded",
            "review_created"
          ],
          "title": "Event",
          "type": "string"
        }
      },
      "required": [
        "target_url",
        "event"
      ],
      "title": "CreateHook",
      "type": "object"
    },
    "DeleteHook": {
      "additionalProperties": false,
      "description": "Unsubscribe a webhook by its ID.",
      "properties": {
        "operation": {
          "const": "delete_hook",
          "default": "delete_hook",
          "title": "Operation",
          "type": "string"
        },
        "hook_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Hook Id",
          "type": "string"
        }
      },
      "required": [
        "hook_id"
      ],
      "title": "DeleteHook",
      "type": "object"
    },
    "GetCalendar": {
      "additionalProperties": false,
      "description": "Read one property's calendar, up to twelve months per request.",
      "properties": {
        "operation": {
          "const": "get_calendar",
          "default": "get_calendar",
          "title": "Operation",
          "type": "string"
        },
        "property_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Property Id",
          "type": "string"
        },
        "from_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive start date; defaults to today.",
          "title": "From Date"
        },
        "to_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End date; at most twelve months per legacy request.",
          "title": "To Date"
        }
      },
      "required": [
        "property_id"
      ],
      "title": "GetCalendar",
      "type": "object"
    },
    "GetProperty": {
      "additionalProperties": false,
      "description": "Read a single property and its related data.",
      "properties": {
        "operation": {
          "const": "get_property",
          "default": "get_property",
          "title": "Operation",
          "type": "string"
        },
        "property_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Property Id",
          "type": "string"
        }
      },
      "required": [
        "property_id"
      ],
      "title": "GetProperty",
      "type": "object"
    },
    "ListCustomBookingAttributes": {
      "additionalProperties": false,
      "description": "List writable booking attribute definitions (requires partner client ID).",
      "properties": {
        "operation": {
          "const": "list_custom_booking_attributes",
          "default": "list_custom_booking_attributes",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListCustomBookingAttributes",
      "type": "object"
    },
    "ListHooks": {
      "additionalProperties": false,
      "description": "Read registered webhook subscriptions.",
      "properties": {
        "operation": {
          "const": "list_hooks",
          "default": "list_hooks",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListHooks",
      "type": "object"
    },
    "ListProperties": {
      "additionalProperties": false,
      "description": "List account properties and their included related data.",
      "properties": {
        "operation": {
          "const": "list_properties",
          "default": "list_properties",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListProperties",
      "type": "object"
    },
    "RotateHookSecret": {
      "additionalProperties": false,
      "description": "Rotate a webhook's signing secret; update the receiver immediately.",
      "properties": {
        "operation": {
          "const": "rotate_hook_secret",
          "default": "rotate_hook_secret",
          "title": "Operation",
          "type": "string"
        },
        "hook_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Hook Id",
          "type": "string"
        }
      },
      "required": [
        "hook_id"
      ],
      "title": "RotateHookSecret",
      "type": "object"
    },
    "SearchAvailability": {
      "additionalProperties": false,
      "description": "Find available properties using the documented search criteria.",
      "properties": {
        "operation": {
          "const": "search_availability",
          "default": "search_availability",
          "title": "Operation",
          "type": "string"
        },
        "check_in": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check In"
        },
        "check_out": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check Out"
        },
        "number_of_guests": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number Of Guests"
        },
        "min_price": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Price"
        },
        "max_price": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Price"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        }
      },
      "title": "SearchAvailability",
      "type": "object"
    },
    "UpdateBookingAttributes": {
      "additionalProperties": false,
      "description": "Set writable custom booking attributes (requires partner client ID).",
      "properties": {
        "operation": {
          "const": "update_booking_attributes",
          "default": "update_booking_attributes",
          "title": "Operation",
          "type": "string"
        },
        "booking_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Booking Id",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Only keys returned by List custom booking attributes.",
          "minProperties": 1,
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "booking_id",
        "attributes"
      ],
      "title": "UpdateBookingAttributes",
      "type": "object"
    },
    "UpdateCalendar": {
      "additionalProperties": false,
      "description": "Queue calendar changes; acceptance does not mean they have been applied.",
      "properties": {
        "operation": {
          "const": "update_calendar",
          "default": "update_calendar",
          "title": "Operation",
          "type": "string"
        },
        "property_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Property Id",
          "type": "string"
        },
        "days": {
          "items": {
            "$ref": "#/$defs/CalendarDay"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Days",
          "type": "array"
        },
        "notification_url": {
          "anyOf": [
            {
              "pattern": "^https://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional HTTPS endpoint for asynchronous results.",
          "title": "Notification Url"
        }
      },
      "required": [
        "property_id",
        "days"
      ],
      "title": "UpdateCalendar",
      "type": "object"
    },
    "UplistingAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "uplisting_api_key",
          "default": "uplisting_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only needed for V2 booking and custom attribute operations. Request from Uplisting's partner team.",
          "title": "Partner client ID"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Uplisting API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from Uplisting Connect > API. Paste the raw key; NoClick encodes it for Basic authentication. V2 booking and custom attribute operations also require a partner client ID from Uplisting's API access form. Other operations need only the API key.",
      "x-credential-url": "https://app.uplisting.io/connect/api"
    },
    "VerifyAccount": {
      "additionalProperties": false,
      "description": "Read the account name and UID to verify the API key.",
      "properties": {
        "operation": {
          "const": "get_account",
          "default": "get_account",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "VerifyAccount",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_booking": "#/$defs/CreateBooking",
          "create_custom_booking_attribute": "#/$defs/CreateCustomBookingAttribute",
          "create_hook": "#/$defs/CreateHook",
          "delete_hook": "#/$defs/DeleteHook",
          "get_account": "#/$defs/VerifyAccount",
          "get_calendar": "#/$defs/GetCalendar",
          "get_property": "#/$defs/GetProperty",
          "list_custom_booking_attributes": "#/$defs/ListCustomBookingAttributes",
          "list_hooks": "#/$defs/ListHooks",
          "list_properties": "#/$defs/ListProperties",
          "rotate_hook_secret": "#/$defs/RotateHookSecret",
          "search_availability": "#/$defs/SearchAvailability",
          "update_booking_attributes": "#/$defs/UpdateBookingAttributes",
          "update_calendar": "#/$defs/UpdateCalendar"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/VerifyAccount"
        },
        {
          "$ref": "#/$defs/ListProperties"
        },
        {
          "$ref": "#/$defs/GetProperty"
        },
        {
          "$ref": "#/$defs/SearchAvailability"
        },
        {
          "$ref": "#/$defs/GetCalendar"
        },
        {
          "$ref": "#/$defs/UpdateCalendar"
        },
        {
          "$ref": "#/$defs/ListHooks"
        },
        {
          "$ref": "#/$defs/CreateHook"
        },
        {
          "$ref": "#/$defs/DeleteHook"
        },
        {
          "$ref": "#/$defs/RotateHookSecret"
        },
        {
          "$ref": "#/$defs/ListCustomBookingAttributes"
        },
        {
          "$ref": "#/$defs/CreateCustomBookingAttribute"
        },
        {
          "$ref": "#/$defs/UpdateBookingAttributes"
        },
        {
          "$ref": "#/$defs/CreateBooking"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/UplistingAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Uplisting Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
