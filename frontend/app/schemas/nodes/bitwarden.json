    "AssociationWithPermissionsRequestModel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The associated object's unique identifier.",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "readOnly": {
          "description": "When true, the read only permission will not allow the user or group to make changes to items.",
          "title": "Readonly",
          "type": "boolean"
        },
        "hidePasswords": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, the hide passwords permission will not allow the user or group to view passwords.\nThis prevents easy copy-and-paste of hidden items, however it may not completely prevent user access.",
          "title": "Hidepasswords"
        },
        "manage": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, the manage permission allows a user to both edit the ciphers within a collection and edit the users/groups that are assigned to the collection.\nThis field will not affect behavior until your organization is using the latest collection enhancements (Releasing Q1, 2024)",
          "title": "Manage"
        }
      },
      "required": [
        "id",
        "readOnly"
      ],
      "title": "AssociationWithPermissionsRequestModel",
      "type": "object"
