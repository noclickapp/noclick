{
  "$defs": {
    "ApacheBasicCredential": {
      "properties": {
        "credential_type": {
          "const": "apache_basic",
          "default": "apache_basic",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_base_url": {
          "description": "HTTPS API root, for example https://airflow.example.com/api/v1. An origin alone is expanded to /api/v1.",
          "title": "API Root",
          "type": "string"
        },
        "username": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Username",
          "type": "string"
        },
        "password": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Password",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_base_url",
        "username",
        "password"
      ],
      "title": "Apache Airflow Username and Password",
      "type": "object",
      "x-credential-instructions": "Connect an Airflow 2.x deployment with Basic API authentication enabled. Enter its HTTPS API root, username and password. Ask your Airflow administrator to enable the Basic authentication backend and grant the DAG, run, variable or pool permissions your workflow needs.",
      "x-credential-url": "https://airflow.apache.org/docs/apache-airflow/2.10.0/security/api.html"
    },
