            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Membership"
        },
        "comped": {
          "default": false,
          "description": "Register without charging a membership use.",
          "title": "Comped",
          "type": "boolean"
        }
      },
      "required": [
        "customer",
        "event_id"
      ],
      "title": "TeamUpRegisterCustomerConfig",
      "type": "object"
    },
    "TeamUpUnregisterCustomerConfig": {
      "additionalProperties": false,
      "description": "Remove a registration; late cancellation can incur provider-configured penalties.",
      "properties": {
        "customer": {
          "exclusiveMinimum": 0,
          "title": "Customer ID",
          "type": "integer"
        },
        "event_id": {
          "exclusiveMinimum": 0,
          "title": "Event ID",
          "type": "integer"
