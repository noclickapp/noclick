{
  "$defs": {
    "TeamUpCancelCustomerMembershipConfig": {
      "additionalProperties": false,
      "description": "Cancel a customer membership; provider cancellation and billing rules apply.",
      "properties": {
        "operation": {
          "const": "cancel_customer_membership",
          "default": "cancel_customer_membership",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "customer_membership_id": {
          "exclusiveMinimum": 0,
          "title": "Customer Membership Id",
          "type": "integer"
        },
        "forced_expiration_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional final expiration date. Omit to use TeamUp cancellation rules.",
          "title": "Forced Expiration Date"
        }
      },
      "required": [
        "customer_membership_id"
      ],
      "title": "TeamUpCancelCustomerMembershipConfig",
      "type": "object"
    },
    "TeamUpConfirmAttendanceConfig": {
      "additionalProperties": false,
      "description": "Mark a customer as attended.",
      "properties": {
        "customer": {
          "exclusiveMinimum": 0,
          "title": "Customer ID",
          "type": "integer"
        },
        "event_id": {
          "exclusiveMinimum": 0,
          "title": "Event ID",
          "type": "integer"
        },
        "operation": {
          "const": "confirm_attendance",
          "default": "confirm_attendance",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "customer",
        "event_id"
      ],
      "title": "TeamUpConfirmAttendanceConfig",
      "type": "object"
    },
    "TeamUpCreateCustomerConfig": {
      "additionalProperties": false,
      "description": "Create a customer; an invitation is sent only when explicitly enabled.",
      "properties": {
        "operation": {
          "const": "create_customer",
          "default": "create_customer",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "first_name": {
          "maxLength": 150,
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Last Name",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "maxLength": 254,
              "minLength": 3,
              "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "send_invitation_email": {
          "default": false,
          "description": "When enabled, TeamUp emails the customer an invitation.",
          "title": "Send Invitation Email",
          "type": "boolean"
        }
      },
      "required": [
        "first_name",
        "last_name"
      ],
      "title": "TeamUpCreateCustomerConfig",
      "type": "object"
    },
    "TeamUpCreateCustomerMembershipConfig": {
      "additionalProperties": false,
      "description": "Assign a membership to a customer; TeamUp applies its configured billing rules.",
      "properties": {
        "customer": {
          "exclusiveMinimum": 0,
          "title": "Customer ID",
          "type": "integer"
        },
        "operation": {
          "const": "create_customer_membership",
          "default": "create_customer_membership",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "membership": {
          "exclusiveMinimum": 0,
          "title": "Membership ID",
          "type": "integer"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "payment_plan": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Plan"
        }
      },
      "required": [
        "customer",
        "membership"
      ],
      "title": "TeamUpCreateCustomerMembershipConfig",
      "type": "object"
    },
