    "TeamUpListAttendancesConfig": {
      "additionalProperties": false,
      "description": "Read one page of attendances.",
      "properties": {
        "page": {
          "default": 1,
          "description": "Page to read. Use next_page from the previous result; each run fetches one page.",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
