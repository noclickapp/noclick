        "operation": {
          "const": "unregister_customer",
          "default": "unregister_customer",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "is_late_cancel": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Late Cancel"
        }
      },
      "required": [
        "customer",
        "event_id"
      ],
      "title": "TeamUpUnregisterCustomerConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "cancel_customer_membership": "#/$defs/TeamUpCancelCustomerMembershipConfig",
          "confirm_attendance": "#/$defs/TeamUpConfirmAttendanceConfig",
          "create_customer": "#/$defs/TeamUpCreateCustomerConfig",
          "create_customer_membership": "#/$defs/TeamUpCreateCustomerMembershipConfig",
          "get_attendance": "#/$defs/TeamUpGetAttendanceConfig",
          "get_customer": "#/$defs/TeamUpGetCustomerConfig",
          "get_customer_membership": "#/$defs/TeamUpGetCustomerMembershipConfig",
          "get_event": "#/$defs/TeamUpGetEventConfig",
          "get_membership": "#/$defs/TeamUpGetMembershipConfig",
          "get_provider": "#/$defs/TeamUpGetProviderConfig",
          "get_venue": "#/$defs/TeamUpGetVenueConfig",
          "list_attendances": "#/$defs/TeamUpListAttendancesConfig",
          "list_customer_memberships": "#/$defs/TeamUpListCustomerMembershipsConfig",
          "list_customers": "#/$defs/TeamUpListCustomersConfig",
          "list_events": "#/$defs/TeamUpListEventsConfig",
          "list_memberships": "#/$defs/TeamUpListMembershipsConfig",
          "list_providers": "#/$defs/TeamUpListProvidersConfig",
          "list_venues": "#/$defs/TeamUpListVenuesConfig",
          "mark_no_show": "#/$defs/TeamUpMarkNoShowConfig",
          "register_customer": "#/$defs/TeamUpRegisterCustomerConfig",
          "unregister_customer": "#/$defs/TeamUpUnregisterCustomerConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TeamUpListProvidersConfig"
        },
        {
          "$ref": "#/$defs/TeamUpGetProviderConfig"
        },
        {
          "$ref": "#/$defs/TeamUpListCustomersConfig"
        },
        {
          "$ref": "#/$defs/TeamUpGetCustomerConfig"
        },
        {
          "$ref": "#/$defs/TeamUpListEventsConfig"
        },
        {
          "$ref": "#/$defs/TeamUpGetEventConfig"
        },
        {
          "$ref": "#/$defs/TeamUpListAttendancesConfig"
        },
        {
          "$ref": "#/$defs/TeamUpGetAttendanceConfig"
        },
        {
          "$ref": "#/$defs/TeamUpListMembershipsConfig"
        },
        {
          "$ref": "#/$defs/TeamUpGetMembershipConfig"
        },
        {
          "$ref": "#/$defs/TeamUpListCustomerMembershipsConfig"
        },
        {
          "$ref": "#/$defs/TeamUpGetCustomerMembershipConfig"
        },
        {
          "$ref": "#/$defs/TeamUpListVenuesConfig"
        },
        {
          "$ref": "#/$defs/TeamUpGetVenueConfig"
        },
        {
          "$ref": "#/$defs/TeamUpCreateCustomerConfig"
        },
        {
          "$ref": "#/$defs/TeamUpRegisterCustomerConfig"
        },
        {
          "$ref": "#/$defs/TeamUpUnregisterCustomerConfig"
        },
        {
          "$ref": "#/$defs/TeamUpConfirmAttendanceConfig"
        },
        {
          "$ref": "#/$defs/TeamUpMarkNoShowConfig"
        },
        {
          "$ref": "#/$defs/TeamUpCreateCustomerMembershipConfig"
        },
        {
          "$ref": "#/$defs/TeamUpCancelCustomerMembershipConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TeamUpM2MTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
