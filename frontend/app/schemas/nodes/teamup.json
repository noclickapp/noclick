          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "customer",
        "event_id"
      ],
      "title": "TeamUpMarkNoShowConfig",
      "type": "object"
    },
    "TeamUpRegisterCustomerConfig": {
      "additionalProperties": false,
      "description": "Register a customer for a class, consuming membership usage unless comped.",
      "properties": {
        "customer": {
          "exclusiveMinimum": 0,
          "title": "Customer ID",
          "type": "integer"
        },
        "event_id": {
          "exclusiveMinimum": 0,
          "title": "Event ID",
          "type": "integer"
