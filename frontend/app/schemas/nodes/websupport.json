{
  "$defs": {
    "WebsupportApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "websupport_api_key",
          "default": "websupport_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Existing API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_secret": {
          "description": "Used locally for fresh HMAC-SHA1 signatures. The secret itself is never transmitted.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Existing Signing Secret",
          "type": "string",
          "ui:widget": "password"
        },
        "service_id": {
          "description": "Opaque supplied service route reference. No service catalog is invented; this need not equal a domain name.",
          "maxLength": 191,
          "minLength": 1,
          "title": "Existing Service Reference",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "api_secret",
        "service_id"
      ],
      "title": "WebsupportApiKeyCredential",
      "type": "object",
      "x-credential-instructions": "Supply an existing API key, signing secret and selected service reference. NoClick sends Basic key:fresh-signature, not key:secret, with matching UTC X-Date. Only protected v2 verification/zone/record metadata reads are implemented; no key issue, rotation, exchange or ownership claim.",
      "x-credential-url": "https://rest.websupport.sk/v2/docs/intro"
    },
    "WebsupportCheckConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to zone/record names. DNS contents and all private hosting fields remain excluded.",
          "title": "Include Names",
          "type": "boolean"
        },
        "max_items": {
          "default": 100,
          "description": "Local default-page output limit, not a provider pagination parameter.",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "WebsupportCheckConfig",
      "type": "object"
    },
    "WebsupportRecordsConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to zone/record names. DNS contents and all private hosting fields remain excluded.",
          "title": "Include Names",
          "type": "boolean"
        },
        "max_items": {
          "default": 100,
          "description": "Local default-page output limit, not a provider pagination parameter.",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "operation": {
          "const": "list_records",
          "default": "list_records",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "record_type": {
          "anyOf": [
            {
              "enum": [
                "A",
                "AAAA",
                "ANAME",
                "CAA",
                "CNAME",
                "DNSSEC",
                "MX",
                "NS",
                "SRV",
                "TXT",
                "CERT",
                "LOC",
                "SSHFP",
                "TLSA",
                "DS"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional local type selection from the current saved service's protected zone/record page; never sent as a query filter.",
          "title": "Record Type",
          "x-dynamic-options": {
            "field": "record_type"
          },
          "enum": [
            "A",
            "AAAA",
            "ANAME",
            "CAA",
            "CNAME",
            "DNSSEC",
            "MX",
            "NS",
            "SRV",
            "TXT",
            "CERT",
            "LOC",
            "SSHFP",
            "TLSA",
            "DS"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "WebsupportRecordsConfig",
      "type": "object"
    },
    "WebsupportZoneConfig": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to zone/record names. DNS contents and all private hosting fields remain excluded.",
          "title": "Include Names",
          "type": "boolean"
        },
        "max_items": {
          "default": 100,
          "description": "Local default-page output limit, not a provider pagination parameter.",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "operation": {
          "const": "get_zone",
          "default": "get_zone",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "WebsupportZoneConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/WebsupportCheckConfig",
          "get_zone": "#/$defs/WebsupportZoneConfig",
          "list_records": "#/$defs/WebsupportRecordsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/WebsupportCheckConfig"
        },
        {
          "$ref": "#/$defs/WebsupportZoneConfig"
        },
        {
          "$ref": "#/$defs/WebsupportRecordsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/WebsupportApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Websupport Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
