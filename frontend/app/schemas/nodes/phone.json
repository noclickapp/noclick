{
  "$defs": {
    "PhoneGetNumberConfig": {
      "description": "Read-only: the number this credential holds and whether the provider still has it.",
      "properties": {
        "operation": {
          "const": "get_number",
          "default": "get_number",
          "title": "Get Number",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Number",
          "x-display-name": "Get Number",
          "x-is-trigger": false,
          "x-keywords": [
            "my number",
            "phone number",
            "caller id"
          ]
        }
      },
      "title": "PhoneGetNumberConfig",
      "type": "object"
    },
    "PhoneNumberCredential": {
      "description": "A phone number your agent answers and calls from.",
      "properties": {
        "credential_type": {
          "const": "phone_number",
          "default": "phone_number",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "phone_number": {
          "minLength": 1,
          "title": "Phone Number",
          "type": "string",
          "ui:hidden": true
        },
        "number_sid": {
          "minLength": 1,
          "title": "Number Sid",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "phone_number",
        "number_sid"
      ],
      "title": "Phone Number",
      "type": "object",
      "x-credential-instructions": "Buy a phone number for this agent, 15 credits a month (Plus and Pro plans).",
      "x-credential-type": "purchase"
    },
    "PhoneOnCallConfig": {
      "description": "Trigger: the number is called. The wired agent answers, live.",
      "properties": {
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "external_webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Webhook Id",
          "ui:hidden": true
        },
        "signing_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signing Secret",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_call",
          "default": "on_call",
          "title": "On Incoming Call",
          "type": "string",
          "ui:hidden": true,
          "x-category": null,
          "x-display-name": "On Incoming Call",
          "x-is-trigger": true,
          "x-keywords": [
            "answer calls",
            "phone call",
            "voice",
            "receive call",
            "inbound call"
          ]
        },
        "greeting": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the agent says when it picks up. Leave empty for a plain hello.",
          "title": "Greeting"
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set up automatically once a number is attached: calls to it reach this workflow.",
          "readOnly": true,
          "title": "Call routing",
          "ui:loadValue": true,
          "ui:widget": "webhook"
        }
      },
      "title": "PhoneOnCallConfig",
      "type": "object",
      "x-requires-webhook": true
    },
    "PhonePlaceCallConfig": {
      "description": "Dial a number from this one and hold the whole conversation yourself: the agent behind this tool is the voice on the call and pursues the goal end to end (keypad menus included). Returns at once while the call runs; when it ends, the full transcript arrives in this conversation as a new message \u2014 report the outcome then, never redial.",
      "properties": {
        "operation": {
          "const": "place_call",
          "default": "place_call",
          "title": "Place a Call",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Calls",
          "x-display-name": "Place a Call",
          "x-is-trigger": false,
          "x-keywords": [
            "call",
            "dial",
            "phone",
            "ring",
            "outbound call"
          ]
        },
        "to_number": {
          "description": "The number to call, in international format (+1\u2026).",
          "title": "To",
          "type": "string"
        },
        "goal": {
          "description": "What this call should achieve, in plain words \u2014 who to ask for, what to find out or arrange, and any facts the voice may state. Everything the voice knows about the call is in here.",
          "title": "Goal",
          "type": "string"
        }
      },
      "required": [
        "to_number",
        "goal"
      ],
      "title": "PhonePlaceCallConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_number": "#/$defs/PhoneGetNumberConfig",
          "on_call": "#/$defs/PhoneOnCallConfig",
          "place_call": "#/$defs/PhonePlaceCallConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PhoneOnCallConfig"
        },
        {
          "$ref": "#/$defs/PhonePlaceCallConfig"
        },
        {
          "$ref": "#/$defs/PhoneGetNumberConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/PhoneNumberCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Phone Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Answer calls to my number with this agent",
    "Let the agent call the customer back with the quote",
    "Give the support agent a phone number"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
