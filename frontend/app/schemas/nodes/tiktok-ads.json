    "CreateCampaign": {
      "additionalProperties": false,
      "description": "Create a Smart+ campaign. Enabling a campaign can spend the advertiser's budget.",
      "properties": {
        "advertiser_id": {
          "anyOf": [
            {
              "maxLength": 30,
              "minLength": 1,
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to the connected advertiser. Override only with another account authorized for the same token.",
          "title": "Advertiser ID"
        },
        "operation": {
          "const": "create_campaign",
          "default": "create_campaign",
          "title": "Create Smart+ Campaign",
          "type": "string",
          "ui:hidden": true
        },
        "campaign_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Campaign Name",
          "type": "string"
        },
        "objective_type": {
          "enum": [
            "APP_PROMOTION",
            "LEAD_GENERATION",
            "WEB_CONVERSIONS"
          ],
          "title": "Objective Type",
          "type": "string"
        },
        "request_id": {
          "description": "Supply a stable unique request ID for this creation; reuse only for the same logical request.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "operation_status": {
          "default": "DISABLE",
          "description": "DISABLE creates a paused campaign. ENABLE may start spending.",
          "enum": [
            "DISABLE",
            "ENABLE"
          ],
          "title": "Operation Status",
          "type": "string"
        },
        "budget": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget"
        },
        "budget_mode": {
          "anyOf": [
            {
              "enum": [
                "BUDGET_MODE_DYNAMIC_DAILY_BUDGET",
                "BUDGET_MODE_TOTAL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Mode",
          "enum": [
            "BUDGET_MODE_DYNAMIC_DAILY_BUDGET",
            "BUDGET_MODE_TOTAL"
          ],
          "x-enum-searchable": true
        },
        "budget_optimize_on": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Optimize On"
        },
        "app_id": {
          "anyOf": [
            {
              "maxLength": 30,
              "minLength": 1,
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App Id"
        },
        "app_promotion_type": {
          "anyOf": [
            {
              "const": "APP_INSTALL",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App Promotion Type"
        },
        "sales_destination": {
          "anyOf": [
            {
              "const": "WEBSITE",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sales Destination"
        },
        "po_number": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Po Number"
        },
        "special_industries": {
          "anyOf": [
            {
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Special Industries"
        }
      },
      "required": [
        "campaign_name",
        "objective_type",
        "request_id"
      ],
      "title": "CreateCampaign",
      "type": "object"
    },
