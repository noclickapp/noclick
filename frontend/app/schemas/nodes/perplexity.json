  "description": "Full configuration for the Perplexity node including credentials.",
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "academic_search": "#/$defs/PerplexityAcademicSearchConfig",
          "agent_response": "#/$defs/PerplexityAgentResponseConfig",
          "chat_completion": "#/$defs/PerplexityChatCompletionConfig",
          "create_async_completion": "#/$defs/PerplexityCreateAsyncCompletionConfig",
          "create_contextualized_embeddings": "#/$defs/PerplexityCreateContextualizedEmbeddingsConfig",
          "create_embeddings": "#/$defs/PerplexityCreateEmbeddingsConfig",
          "generate_auth_token": "#/$defs/PerplexityGenerateAuthTokenConfig",
          "get_async_completion": "#/$defs/PerplexityGetAsyncCompletionConfig",
          "list_async_completions": "#/$defs/PerplexityListAsyncCompletionsConfig",
          "list_models": "#/$defs/PerplexityListModelsConfig",
          "revoke_auth_token": "#/$defs/PerplexityRevokeAuthTokenConfig",
          "search": "#/$defs/PerplexitySearchConfig",
          "sec_search": "#/$defs/PerplexitySecSearchConfig",
          "structured_output": "#/$defs/PerplexityStructuredOutputConfig",
          "usage_analytics": "#/$defs/PerplexityUsageAnalyticsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PerplexityChatCompletionConfig"
        },
        {
          "$ref": "#/$defs/PerplexityCreateAsyncCompletionConfig"
        },
        {
          "$ref": "#/$defs/PerplexityListAsyncCompletionsConfig"
        },
        {
          "$ref": "#/$defs/PerplexityGetAsyncCompletionConfig"
        },
        {
          "$ref": "#/$defs/PerplexitySearchConfig"
        },
        {
          "$ref": "#/$defs/PerplexityAgentResponseConfig"
        },
        {
          "$ref": "#/$defs/PerplexityCreateEmbeddingsConfig"
        },
        {
          "$ref": "#/$defs/PerplexityCreateContextualizedEmbeddingsConfig"
        },
        {
          "$ref": "#/$defs/PerplexityListModelsConfig"
        },
        {
          "$ref": "#/$defs/PerplexityGenerateAuthTokenConfig"
        },
        {
          "$ref": "#/$defs/PerplexityRevokeAuthTokenConfig"
        },
        {
          "$ref": "#/$defs/PerplexityUsageAnalyticsConfig"
        },
        {
          "$ref": "#/$defs/PerplexityAcademicSearchConfig"
        },
        {
          "$ref": "#/$defs/PerplexitySecSearchConfig"
        },
        {
          "$ref": "#/$defs/PerplexityStructuredOutputConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/PerplexityApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
