{
  "$defs": {
    "AddWhitelistedIPs": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "add_whitelisted_ips",
          "default": "add_whitelisted_ips",
          "title": "Add Whitelisted IPs",
          "type": "string",
          "ui:hidden": true
        },
        "ip_addresses": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "IP Addresses",
          "type": "array"
        }
      },
      "required": [
        "ip_addresses"
      ],
      "title": "AddWhitelistedIPs",
      "type": "object"
    },
    "CreateSubUser": {
      "additionalProperties": false,
      "properties": {
        "service_type": {
          "const": "residential_proxies",
          "default": "residential_proxies",
          "title": "Service Type",
          "type": "string"
        },
        "operation": {
          "const": "create_sub_user",
          "default": "create_sub_user",
          "title": "Create Subuser",
          "type": "string",
          "ui:hidden": true
        },
        "username": {
          "maxLength": 64,
          "minLength": 6,
          "pattern": "^[A-Za-z0-9_]+$",
          "title": "Username",
          "type": "string"
        },
        "password": {
          "description": "12\u201364 characters, including uppercase, lowercase, a number and one of _ ~ + =. Do not use @ or :.",
          "maxLength": 64,
          "minLength": 12,
          "title": "Password",
          "type": "string",
          "ui:widget": "password"
        },
        "traffic_limit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traffic Limit (GB)"
        },
        "auto_disable": {
          "default": false,
          "title": "Disable at Traffic Limit",
          "type": "boolean"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "title": "CreateSubUser",
      "type": "object"
    },
    "DeleteSubUser": {
      "additionalProperties": false,
      "properties": {
        "sub_user_id": {
          "exclusiveMinimum": 0,
          "title": "Subuser ID",
          "type": "integer"
        },
        "operation": {
          "const": "delete_sub_user",
          "default": "delete_sub_user",
          "title": "Delete Subuser",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "sub_user_id"
      ],
      "title": "DeleteSubUser",
      "type": "object"
    },
    "DeleteWhitelistedIP": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "delete_whitelisted_ip",
          "default": "delete_whitelisted_ip",
          "title": "Delete Whitelisted IP",
          "type": "string",
          "ui:hidden": true
        },
        "whitelist_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Whitelist Entry ID",
          "type": "string"
        }
      },
      "required": [
        "whitelist_id"
      ],
      "title": "DeleteWhitelistedIP",
      "type": "object"
    },
    "GetAllocatedTraffic": {
      "additionalProperties": false,
      "properties": {
        "service_type": {
          "const": "residential_proxies",
          "default": "residential_proxies",
          "title": "Service Type",
          "type": "string"
        },
        "operation": {
          "const": "get_allocated_traffic",
          "default": "get_allocated_traffic",
          "title": "Get Allocated Subuser Traffic",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetAllocatedTraffic",
      "type": "object"
    },
    "GetEndpointsByType": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_endpoints_by_type",
          "default": "get_endpoints_by_type",
          "title": "Get Endpoints by Type",
          "type": "string",
          "ui:hidden": true
        },
        "session_type": {
          "default": "random",
          "enum": [
            "random",
            "sticky"
          ],
          "title": "Session Type",
          "type": "string"
        }
      },
      "title": "GetEndpointsByType",
      "type": "object"
    },
    "GetSubUser": {
      "additionalProperties": false,
      "properties": {
        "sub_user_id": {
          "exclusiveMinimum": 0,
          "title": "Subuser ID",
          "type": "integer"
        },
        "operation": {
          "const": "get_sub_user",
          "default": "get_sub_user",
          "title": "Get Subuser",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "sub_user_id"
      ],
      "title": "GetSubUser",
      "type": "object"
    },
    "GetSubUserTraffic": {
      "additionalProperties": false,
      "properties": {
        "service_type": {
          "const": "residential_proxies",
          "default": "residential_proxies",
          "title": "Service Type",
          "type": "string"
        },
        "sub_user_id": {
          "exclusiveMinimum": 0,
          "title": "Subuser ID",
          "type": "integer"
        },
        "operation": {
          "const": "get_sub_user_traffic",
          "default": "get_sub_user_traffic",
          "title": "Get Subuser Traffic",
          "type": "string",
          "ui:hidden": true
        },
        "period": {
          "default": "month",
          "enum": [
            "24h",
            "7days",
            "month",
            "custom"
          ],
          "title": "Period",
          "type": "string"
        },
        "from_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD; applies to custom period",
          "title": "From Date"
        },
        "to_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD; applies to custom period",
          "title": "To Date"
        }
      },
      "required": [
        "sub_user_id"
      ],
      "title": "GetSubUserTraffic",
      "type": "object"
    },
    "GetSubscriptions": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_subscriptions",
          "default": "get_subscriptions",
          "title": "Get Subscriptions",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetSubscriptions",
      "type": "object"
    },
    "GetTargets": {
      "additionalProperties": false,
      "properties": {
        "proxy_type": {
          "default": "residential_proxies",
          "enum": [
            "residential_proxies",
            "mobile_proxies",
            "rtc_universal_proxies",
            "rtc_universal_core_proxies",
            "modular_scraper"
          ],
          "title": "Proxy Type",
          "type": "string"
        },
        "start_date": {
          "description": "UTC YYYY-MM-DD HH:MM:SS; interval at most 180 days",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "description": "UTC YYYY-MM-DD HH:MM:SS",
          "title": "End Date",
          "type": "string"
        },
        "proxy_users": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Residential proxies only",
          "title": "Proxy User IDs"
        },
        "operation": {
          "const": "get_targets",
          "default": "get_targets",
          "title": "Get Traffic Targets",
          "type": "string",
          "ui:hidden": true
        },
        "search": {
          "anyOf": [
            {
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Targets"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "GetTargets",
      "type": "object"
    },
    "GetTraffic": {
      "additionalProperties": false,
      "properties": {
        "proxy_type": {
          "default": "residential_proxies",
          "enum": [
            "residential_proxies",
            "mobile_proxies",
            "rtc_universal_proxies",
            "rtc_universal_core_proxies",
            "modular_scraper"
          ],
          "title": "Proxy Type",
          "type": "string"
        },
        "start_date": {
          "description": "UTC YYYY-MM-DD HH:MM:SS; interval at most 180 days",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "description": "UTC YYYY-MM-DD HH:MM:SS",
          "title": "End Date",
          "type": "string"
        },
        "proxy_users": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Residential proxies only",
          "title": "Proxy User IDs"
        },
        "operation": {
          "const": "get_traffic",
          "default": "get_traffic",
          "title": "Get Traffic Statistics",
          "type": "string",
          "ui:hidden": true
        },
        "group_by": {
          "default": "target",
          "enum": [
            "day",
            "target",
            "country",
            "protocol",
            "proxy_user",
            "hour",
            "week",
            "month"
          ],
          "title": "Group By",
          "type": "string"
        },
        "targets": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target URLs"
        },
        "locations": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO-2 codes, for example US or IT",
          "title": "Country Codes"
        },
        "limit": {
          "default": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "sort_by": {
          "default": "grouping_key",
          "enum": [
            "grouping_key",
            "requests",
            "totals"
          ],
          "title": "Sort By",
          "type": "string"
        },
        "sort_order": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Sort Order",
          "type": "string"
        },
        "protocols": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "http",
                  "https",
                  "socks5"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocols"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "GetTraffic",
      "type": "object"
    },
    "ListEndpointTypes": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_endpoint_types",
          "default": "list_endpoint_types",
          "title": "List Endpoint Types",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListEndpointTypes",
      "type": "object"
    },
    "ListSubUsers": {
      "additionalProperties": false,
      "properties": {
        "service_type": {
          "const": "residential_proxies",
          "default": "residential_proxies",
          "title": "Service Type",
          "type": "string"
        },
        "operation": {
          "const": "list_sub_users",
          "default": "list_sub_users",
          "title": "List Subusers",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListSubUsers",
      "type": "object"
    },
    "ListWhitelistedIPs": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_whitelisted_ips",
          "default": "list_whitelisted_ips",
          "title": "List Whitelisted IPs",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListWhitelistedIPs",
      "type": "object"
    },
    "SmartproxyAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "smartproxy_api_key",
          "default": "smartproxy_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Smartproxy API Key",
      "type": "object",
      "x-credential-instructions": "Smartproxy is now Decodo. In Account and Settings \u2192 Settings \u2192 API Keys, create a Public API key and paste it here. Residential proxies support management operations; mobile proxies support only dashboard traffic and targets. Datacenter and ISP products are not supported by this API.",
      "x-credential-url": "https://dashboard.decodo.com/profile?tab=api-keys"
    },
    "UpdateSubUser": {
      "additionalProperties": false,
      "properties": {
        "sub_user_id": {
          "exclusiveMinimum": 0,
          "title": "Subuser ID",
          "type": "integer"
        },
        "operation": {
          "const": "update_sub_user",
          "default": "update_sub_user",
          "title": "Update Subuser",
          "type": "string",
          "ui:hidden": true
        },
        "traffic_limit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traffic Limit (GB)"
        },
        "auto_disable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disable at Traffic Limit"
        },
        "password": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 12,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Password",
          "ui:widget": "password"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "active",
                "disabled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subuser Status",
          "enum": [
            "active",
            "disabled"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "sub_user_id"
      ],
      "title": "UpdateSubUser",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_whitelisted_ips": "#/$defs/AddWhitelistedIPs",
          "create_sub_user": "#/$defs/CreateSubUser",
          "delete_sub_user": "#/$defs/DeleteSubUser",
          "delete_whitelisted_ip": "#/$defs/DeleteWhitelistedIP",
          "get_allocated_traffic": "#/$defs/GetAllocatedTraffic",
          "get_endpoints_by_type": "#/$defs/GetEndpointsByType",
          "get_sub_user": "#/$defs/GetSubUser",
          "get_sub_user_traffic": "#/$defs/GetSubUserTraffic",
          "get_subscriptions": "#/$defs/GetSubscriptions",
          "get_targets": "#/$defs/GetTargets",
          "get_traffic": "#/$defs/GetTraffic",
          "list_endpoint_types": "#/$defs/ListEndpointTypes",
          "list_sub_users": "#/$defs/ListSubUsers",
          "list_whitelisted_ips": "#/$defs/ListWhitelistedIPs",
          "update_sub_user": "#/$defs/UpdateSubUser"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListSubUsers"
        },
        {
          "$ref": "#/$defs/CreateSubUser"
        },
        {
          "$ref": "#/$defs/GetSubUser"
        },
        {
          "$ref": "#/$defs/UpdateSubUser"
        },
        {
          "$ref": "#/$defs/DeleteSubUser"
        },
        {
          "$ref": "#/$defs/GetSubUserTraffic"
        },
        {
          "$ref": "#/$defs/GetAllocatedTraffic"
        },
        {
          "$ref": "#/$defs/ListWhitelistedIPs"
        },
        {
          "$ref": "#/$defs/AddWhitelistedIPs"
        },
        {
          "$ref": "#/$defs/DeleteWhitelistedIP"
        },
        {
          "$ref": "#/$defs/ListEndpointTypes"
        },
        {
          "$ref": "#/$defs/GetEndpointsByType"
        },
        {
          "$ref": "#/$defs/GetSubscriptions"
        },
        {
          "$ref": "#/$defs/GetTargets"
        },
        {
          "$ref": "#/$defs/GetTraffic"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/SmartproxyAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Smartproxy Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
