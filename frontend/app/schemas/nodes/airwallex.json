    "AirwallexAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "airwallex_api_key",
          "default": "airwallex_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "client_id": {
          "minLength": 1,
          "title": "Client ID",
          "type": "string",
          "ui:widget": "password"
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "environment": {
          "default": "production",
          "enum": [
            "production",
            "sandbox"
          ],
          "title": "Environment",
          "type": "string"
        },
        "account_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when a scoped API key covers multiple accounts. Sent as x-login-as during token creation.",
          "title": "Target account ID"
        }
      },
      "required": [
        "client_id",
        "api_key"
      ],
      "title": "Airwallex API Key",
      "type": "object",
      "x-credential-instructions": "In Airwallex Settings > Developer > API keys, copy your client ID and API key. Grant the read and write permissions your operations need. Choose the matching production or sandbox environment. NoClick obtains a short-lived access token for each run; connecting reads your global accounts and does not prove write permissions.",
