              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort",
          "enum": [
            "CREATED_AT_DESCEND",
            "CREATED_AT_ASCEND",
            "UPDATED_AT_DESCEND",
            "UPDATED_AT_ASCEND",
            "NAME_ASCEND",
            "NAME_DESCEND"
