    "FathomCreateWebhookConfig": {
      "description": "Register a Fathom webhook that posts new-meeting content to a URL.",
      "properties": {
        "operation": {
          "const": "create_webhook",
          "default": "create_webhook",
          "title": "Create Webhook",
