          "title": "Event Platform subscriber ID",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "depends_on": "pim_client_id",
            "field_name": "subscriber_id",
            "placeholder": "Choose an Event Platform subscriber"
          }
        },
        "events": {
          "default": [
