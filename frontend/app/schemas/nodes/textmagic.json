    "SendMessage": {
      "additionalProperties": false,
      "description": "Send message.",
      "properties": {
        "operation": {
          "const": "send_message",
          "default": "send_message",
          "title": "Send Message",
          "type": "string",
          "ui:hidden": true
        },
        "text": {
          "minLength": 1,
          "title": "Message text",
          "type": "string",
          "ui:widget": "textarea"
        },
        "phones": {
          "description": "Comma-separated E.164 phone digits. Sending uses paid Textmagic credit.",
          "pattern": "^[1-9][0-9]{5,14}(,[1-9][0-9]{5,14})*$",
          "title": "Phones",
          "type": "string"
        },
        "sender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An approved sender ID or phone number. Textmagic may fall back to the default sender.",
          "title": "Sender ID"
        },
        "sending_date_time": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:[1-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional scheduled local time YYYY-MM-DD HH:MM:SS; seconds must be at least 10.",
          "title": "Sending Date Time"
        },
        "sending_timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timezone name for scheduled sending, for example America/Buenos_Aires. Defaults to the account timezone.",
          "title": "Sending Timezone"
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference ID"
        },
        "parts_count": {
          "default": 6,
          "maximum": 6,
          "minimum": 1,
          "title": "Maximum message parts",
          "type": "integer"
        },
        "cut_extra": {
          "default": false,
          "description": "Cut text exceeding the maximum parts instead of returning an error.",
          "title": "Cut Extra",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "phones"
      ],
      "title": "SendMessage",
      "type": "object"
    },
    "TextmagicAPIKeyCredential": {
      "properties": {
