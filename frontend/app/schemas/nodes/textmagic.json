  "$defs": {
    "AddContactsToList": {
      "additionalProperties": false,
      "description": "Assign contacts to a list.",
      "properties": {
        "id": {
          "minimum": 1,
          "title": "Resource ID",
          "type": "integer"
        },
        "operation": {
          "const": "add_contacts_to_list",
          "default": "add_contacts_to_list",
          "title": "Add Contacts To List",
          "type": "string",
          "ui:hidden": true
        },
        "contacts": {
          "description": "Comma-separated contact IDs to add without replacing existing members.",
          "pattern": "^[1-9][0-9]*(,[1-9][0-9]*)*$",
          "title": "Contacts",
          "type": "string"
        }
      },
      "required": [
        "id",
        "contacts"
      ],
      "title": "AddContactsToList",
      "type": "object"
    },
    "CreateContact": {
      "additionalProperties": false,
      "description": "Add a new contact.",
      "properties": {
        "phone": {
          "description": "International E.164 phone digits, for example 447860021130.",
          "pattern": "^[1-9][0-9]{5,14}$",
          "title": "Phone",
          "type": "string"
        },
        "lists": {
          "description": "Comma-separated list IDs. A contact must belong to at least one list.",
          "pattern": "^[1-9][0-9]*(,[1-9][0-9]*)*$",
          "title": "Lists",
          "type": "string"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last name"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "email",
          "title": "Email"
        },
        "company_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company name"
        },
        "favorited": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Favorited"
        },
        "operation": {
          "const": "create_contact",
          "default": "create_contact",
          "title": "Create Contact",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "phone",
        "lists"
      ],
      "title": "CreateContact",
      "type": "object"
    },
