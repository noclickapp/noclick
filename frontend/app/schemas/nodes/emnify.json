    "EMnifySetDataQuotaConfig": {
      "properties": {
        "endpoint_id": {
          "description": "Numeric EMnify endpoint ID",
          "exclusiveMinimum": 0,
          "title": "Endpoint Id",
          "type": "integer"
        },
        "volume": {
          "description": "Data quota volume in MB",
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        },
        "expiry_date": {
          "description": "UTC expiry: YYYY-MM-DD HH:MM:SS",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
          "title": "Expiry Date",
          "type": "string"
        },
        "status_id": {
          "default": 1,
          "enum": [
            1,
            2,
            3
          ],
          "title": "Status Id",
          "type": "integer"
        },
        "auto_refill": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "Auto Refill",
          "type": "integer"
        },
        "threshold_percentage": {
          "default": 15,
          "maximum": 100,
          "minimum": 0,
          "title": "Threshold Percentage",
          "type": "number"
        },
        "operation": {
          "const": "set_data_quota",
          "default": "set_data_quota",
          "title": "Set Data Quota",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "endpoint_id",
        "volume",
        "expiry_date"
      ],
      "title": "EMnifySetDataQuotaConfig",
      "type": "object"
    },
    "EMnifySetSmsQuotaConfig": {
      "properties": {
        "endpoint_id": {
