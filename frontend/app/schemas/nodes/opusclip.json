{
  "$defs": {
    "CensorOptions": {
      "additionalProperties": false,
      "properties": {
        "beepSound": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use beep sound instead of the censored words.",
          "examples": [
            true
          ],
          "title": "Beep sound"
        }
      },
      "title": "CensorOptions",
      "type": "object"
    },
    "ConclusionAction": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "Specifies the action to be taken upon project conclusion. Options include sending an email or triggering a webhook.",
          "enum": [
            "EMAIL",
            "WEBHOOK"
          ],
          "examples": [
            "EMAIL"
          ],
          "title": "Type",
          "type": "string"
        },
        "notifyFailure": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indicates whether to notify on failure.",
          "examples": [
            true
          ],
          "title": "Notify failure"
        },
        "email": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Email address to send notifications to, if type is EMAIL.",
          "examples": [
            "user@example.com"
          ],
          "title": "Email"
        },
        "url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Webhook URL to trigger, if type is WEBHOOK.",
          "examples": [
            "https://example.com/webhook"
          ],
          "title": "Url"
        }
      },
      "required": [
        "type"
      ],
      "title": "ConclusionAction",
      "type": "object"
    },
    "CurationPreferences": {
      "additionalProperties": false,
      "properties": {
        "topicKeywords": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Keywords used to find relevant moments to clip from",
          "examples": [
            [
              "Fancy Words"
            ]
          ],
          "title": "Topic keywords"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurationRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The range of the original long-form video to generate clips from.",
          "examples": [
            {
              "endSec": 204,
              "startSec": 106
            }
          ],
          "title": "Range"
        },
        "genre": {
          "anyOf": [
            {
              "enum": [
                "Auto",
                "Q&A",
                "Commentary",
                "Marketing",
                "Webinar",
                "Motivational speech",
                "Podcast",
                "Academic",
                "Listicle",
                "Product reviews",
                "How-to",
                "Comedy",
                "Sports commentary",
                "Church",
                "News",
                "Vlog",
                "Gaming",
                "Others"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The genre of the clips, will apply suitable AI curation models to find the best results.",
          "examples": [
            "Auto"
          ],
          "title": "Genre",
          "enum": [
            "Auto",
            "Q&A",
            "Commentary",
            "Marketing",
            "Webinar",
            "Motivational speech",
            "Podcast",
            "Academic",
            "Listicle",
            "Product reviews",
            "How-to",
            "Comedy",
            "Sports commentary",
            "Church",
            "News",
            "Vlog",
            "Gaming",
            "Others"
          ],
          "x-enum-searchable": true
        },
        "enableAutoHook": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether to add an AI-generated headline (\"auto headline\") over the first seconds of each clip. Disabled by default for API submissions: omit it or send `false` and no headline is added. Only applies to a clipping run, so it has no effect together with `skipCurate` or `skipSlicing`.",
          "examples": [
            false
          ],
          "title": "Enable auto hook"
        }
      },
      "title": "CurationPreferences",
      "type": "object"
    },
    "CurationRange": {
      "additionalProperties": false,
      "properties": {
        "startSec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The start time of the range to be curated.",
          "examples": [
            106
          ],
          "title": "Start sec"
        },
        "endSec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The end time of the range to be curated.",
          "examples": [
            204
          ],
          "title": "End sec"
        }
      },
      "title": "CurationRange",
      "type": "object"
    },
    "ImportPreferences": {
      "additionalProperties": false,
      "properties": {
        "sourceLang": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Select the language to detect the video's spoken content, or leave it blank for automatic detection. Using ISO-639 language codes, examples: \"en\" for English, \"de\" for German, \"fr\" for French.",
          "examples": [
            "en"
          ],
          "title": "Source lang"
        }
      },
      "title": "ImportPreferences",
      "type": "object"
    },
    "OpusClipAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "opusclip_api_key",
          "default": "opusclip_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "OpusClip API Key",
      "type": "object",
      "x-credential-instructions": "Copy your organization's API access key from the lower left corner of the OpusClip dashboard. API access requires an eligible plan and credits for processing. Paste the key without the Bearer prefix. NoClick checks your connected social accounts.",
      "x-credential-url": "https://clip.opus.pro/"
    },
    "OpusClipAddCollectionContentConfig": {
      "additionalProperties": false,
      "description": "Add collection content.",
      "properties": {
        "operation": {
          "const": "add_collection_content",
          "default": "add_collection_content",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "collectionId": {
          "description": "The collectionID of the collection that you want to add the clip to.",
          "examples": [
            "xmAwhhFi0IJt"
          ],
          "minLength": 1,
          "title": "Collection id",
          "type": "string"
        },
        "contentId": {
          "description": "The ID of the clip that you want to add to the collection. FullClipId: {projectId}.{curationId}",
          "examples": [
            "P0000000demo.CUexample2"
          ],
          "minLength": 1,
          "title": "Content id",
          "type": "string"
        }
      },
      "required": [
        "collectionId",
        "contentId"
      ],
      "title": "OpusClipAddCollectionContentConfig",
      "type": "object"
    },
    "OpusClipCancelScheduledPostConfig": {
      "additionalProperties": false,
      "description": "Cancel scheduled post.",
      "properties": {
        "operation": {
          "const": "cancel_scheduled_post",
          "default": "cancel_scheduled_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "scheduleId": {
          "description": "Unique ID of the schedule task to cancel",
          "minLength": 1,
          "title": "Schedule id",
          "type": "string"
        }
      },
      "required": [
        "scheduleId"
      ],
      "title": "OpusClipCancelScheduledPostConfig",
      "type": "object"
    },
    "OpusClipCreateCensorJobConfig": {
      "additionalProperties": false,
      "description": "Create censor job.",
      "properties": {
        "operation": {
          "const": "create_censor_job",
          "default": "create_censor_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "projectId": {
          "description": "The project id that you want to censor.",
          "examples": [
            "P0000000demo"
          ],
          "minLength": 1,
          "title": "Project id",
          "type": "string"
        },
        "clipId": {
          "description": "The clip id that you want to censor.",
          "examples": [
            "lDIOHRzdac"
          ],
          "minLength": 1,
          "title": "Clip id",
          "type": "string"
        },
        "options": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "$ref": "#/$defs/CensorOptions"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Some options for the censor job.",
          "examples": [
            {
              "beepSound": false
            }
          ],
          "title": "Options",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "projectId",
        "clipId"
      ],
      "title": "OpusClipCreateCensorJobConfig",
      "type": "object"
    },
    "OpusClipCreateClipProjectConfig": {
      "additionalProperties": false,
      "description": "Create clip project.",
      "properties": {
        "operation": {
          "const": "create_clip_project",
          "default": "create_clip_project",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "videoUrl": {
          "description": "This parameter defines the url of the long-form video. OpusClip can import public videos from the following platforms: \n- YouTube, Google Drive, Vimeo, Zoom, Rumble, Twitch, Facebook, LinkedIn, X, Dropbox, Riverside, Loom, Frame.io, StreamYard\n- Any public video s3 link of an mp4 file (up to 10GB per video)",
          "examples": [
            "https://www.youtube.com/watch?v=LXvv6CbGg8A"
          ],
          "minLength": 1,
          "title": "Video url",
          "type": "string"
        },
        "conclusionActions": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "items": {
                  "$ref": "#/$defs/ConclusionAction"
                },
                "type": "array"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actions to be taken upon project conclusion, such as sending an email or triggering a webhook.",
          "examples": [
            [
              {
                "email": "opusclip@opus.pro",
                "notifyFailure": true,
                "type": "EMAIL"
              }
            ]
          ],
          "title": "Conclusion actions",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "curationPref": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "$ref": "#/$defs/CurationPreferences"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Preferences for advanced curation of the video.",
          "examples": [
            {
              "genre": "Auto",
              "range": {
                "endSec": 636,
                "startSec": 28
              },
              "topicKeywords": [
                "OpusClip"
              ]
            }
          ],
          "title": "Curation pref",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "importPref": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "$ref": "#/$defs/ImportPreferences"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Preferences for importing the video, such as source language.",
          "examples": [
            {
              "sourceLang": "auto"
            }
          ],
          "title": "Import pref",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "brandTemplateId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID of the brand template to be used for the project.",
          "examples": [
            "preset-fancy-Karaoke"
          ],
          "title": "Brand template id"
        }
      },
      "required": [
        "videoUrl"
      ],
      "title": "OpusClipCreateClipProjectConfig",
      "type": "object"
    },
    "OpusClipCreateCollectionConfig": {
      "additionalProperties": false,
      "description": "Create collection.",
      "properties": {
        "operation": {
          "const": "create_collection",
          "default": "create_collection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "collectionName": {
          "description": "The name of the collection that you want to create.",
          "examples": [
            "Opus demo clips"
          ],
          "minLength": 1,
          "title": "Collection name",
          "type": "string"
        }
      },
      "required": [
        "collectionName"
      ],
      "title": "OpusClipCreateCollectionConfig",
      "type": "object"
    },
    "OpusClipCreateSocialCopyJobConfig": {
      "additionalProperties": false,
      "description": "Create social copy job.",
      "properties": {
        "operation": {
          "const": "create_social_copy_job",
          "default": "create_social_copy_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "projectId": {
          "description": "Project ID",
          "minLength": 1,
          "title": "Project id",
          "type": "string"
        },
        "clipId": {
          "description": "Bare clip ID (e.g. `CUexample1`). **Not** the composite `{projectId}.{clipId}` form returned as `id` by `GET /api/exportable-clips` \u2014 pass only the part after the dot.",
          "minLength": 1,
          "title": "Clip id",
          "type": "string"
        },
        "postAccountId": {
          "description": "Unique ID of the connected social account record",
          "minLength": 1,
          "title": "Post account id",
          "type": "string"
        },
        "subAccountId": {
          "description": "Sub-account ID used by Facebook pages, Instagram business accounts, or LinkedIn",
          "minLength": 1,
          "title": "Sub account id",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom style or tone instruction for generation",
          "title": "Prompt"
        },
        "forceRegenerate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether to bypass the cached result and regenerate",
          "title": "Force regenerate"
        }
      },
      "required": [
        "projectId",
        "clipId",
        "postAccountId",
        "subAccountId"
      ],
      "title": "OpusClipCreateSocialCopyJobConfig",
      "type": "object"
    },
    "OpusClipCreateThumbnailJobConfig": {
      "additionalProperties": false,
      "description": "Create thumbnail job.",
      "properties": {
        "operation": {
          "const": "create_thumbnail_job",
          "default": "create_thumbnail_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "jobType": {
          "const": "thumbnail",
          "default": "thumbnail",
          "description": "The type of generative job to create. Currently the only published value is `thumbnail`.",
          "title": "Job type",
          "type": "string"
        },
        "sourceUri": {
          "description": "URL of the source video to extract thumbnails from.",
          "examples": [
            "https://youtube.com/watch?v=..."
          ],
          "minLength": 1,
          "title": "Source uri",
          "type": "string"
        },
        "referenceImageUri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional reference image URL. The thumbnail composition draws stylistic cues from this image. Upload via `POST /api/upload-links` with `usecase: 'FreeToolMedia'`, then pass the returned `cdnUrl` here.",
          "examples": [
            "https://cdn.opus.pro/uploads/.../ref.png"
          ],
          "title": "Reference image uri"
        },
        "maskImageUri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional mask image URL for inpainting.",
          "examples": [
            "https://cdn.opus.pro/uploads/.../mask.png"
          ],
          "title": "Mask image uri"
        },
        "prompt": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional text prompt steering the thumbnail composition.",
          "examples": [
            "punchy red overlay, bold sans-serif title"
          ],
          "title": "Prompt"
        }
      },
      "required": [
        "sourceUri"
      ],
      "title": "OpusClipCreateThumbnailJobConfig",
      "type": "object"
    },
    "OpusClipDeleteCollectionConfig": {
      "additionalProperties": false,
      "description": "Delete collection.",
      "properties": {
        "operation": {
          "const": "delete_collection",
          "default": "delete_collection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "collectionId": {
          "description": "The unique collection ID of the collection that you want to delete.",
          "minLength": 1,
          "title": "Collection id",
          "type": "string"
        }
      },
      "required": [
        "collectionId"
      ],
      "title": "OpusClipDeleteCollectionConfig",
      "type": "object"
    },
    "OpusClipExportCollectionConfig": {
      "additionalProperties": false,
      "description": "Export collection.",
      "properties": {
        "operation": {
          "const": "export_collection",
          "default": "export_collection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "collectionId": {
          "description": "The collectionID of the collection that you want to export",
          "minLength": 1,
          "title": "Collection id",
          "type": "string"
        }
      },
      "required": [
        "collectionId"
      ],
      "title": "OpusClipExportCollectionConfig",
      "type": "object"
    },
    "OpusClipGetCensorJobConfig": {
      "additionalProperties": false,
      "description": "Get censor job.",
      "properties": {
        "operation": {
          "const": "get_censor_job",
          "default": "get_censor_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "jobId": {
          "description": "The jobId that you want to get the status of.",
          "minLength": 1,
          "title": "Job id",
          "type": "string"
        }
      },
      "required": [
        "jobId"
      ],
      "title": "OpusClipGetCensorJobConfig",
      "type": "object"
    },
    "OpusClipGetClipProjectConfig": {
      "additionalProperties": false,
      "description": "Get clip project.",
      "properties": {
        "operation": {
          "const": "get_clip_project",
          "default": "get_clip_project",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "projectId": {
          "description": "",
          "minLength": 1,
          "title": "Project id",
          "type": "string"
        }
      },
      "required": [
        "projectId"
      ],
      "title": "OpusClipGetClipProjectConfig",
      "type": "object"
    },
    "OpusClipGetGenerativeJobConfig": {
      "additionalProperties": false,
      "description": "Get generative job.",
      "properties": {
        "operation": {
          "const": "get_generative_job",
          "default": "get_generative_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "jobId": {
          "description": "The jobId returned by `POST /api/generative-jobs`.",
          "minLength": 1,
          "title": "Job id",
          "type": "string"
        }
      },
      "required": [
        "jobId"
      ],
      "title": "OpusClipGetGenerativeJobConfig",
      "type": "object"
    },
    "OpusClipGetSocialCopyJobConfig": {
      "additionalProperties": false,
      "description": "Get social copy job.",
      "properties": {
        "operation": {
          "const": "get_social_copy_job",
          "default": "get_social_copy_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "jobId": {
          "description": "Unique ID of the social copy generation job",
          "minLength": 1,
          "title": "Job id",
          "type": "string"
        }
      },
      "required": [
        "jobId"
      ],
      "title": "OpusClipGetSocialCopyJobConfig",
      "type": "object"
    },
    "OpusClipGetTranscriptConfig": {
      "additionalProperties": false,
      "description": "Get transcript.",
      "properties": {
        "operation": {
          "const": "get_transcript",
          "default": "get_transcript",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "q": {
          "const": "findByProjectId",
          "default": "findByProjectId",
          "description": "Query variant. Public callers must pass `findByProjectId`.",
          "title": "Q",
          "type": "string"
        },
        "projectId": {
          "description": "Project ID.",
          "examples": [
            "P2120900kDmP"
          ],
          "minLength": 1,
          "title": "Project id",
          "type": "string"
        }
      },
      "required": [
        "projectId"
      ],
      "title": "OpusClipGetTranscriptConfig",
      "type": "object"
    },
    "OpusClipListBrandTemplatesConfig": {
      "additionalProperties": false,
      "description": "List brand templates.",
      "properties": {
        "operation": {
          "const": "list_brand_templates",
          "default": "list_brand_templates",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "q": {
          "const": "mine",
          "default": "mine",
          "description": "",
          "title": "Q",
          "type": "string"
        }
      },
      "title": "OpusClipListBrandTemplatesConfig",
      "type": "object"
    },
    "OpusClipListCollectionsConfig": {
      "additionalProperties": false,
      "description": "List collections.",
      "properties": {
        "operation": {
          "const": "list_collections",
          "default": "list_collections",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "q": {
          "default": "mine",
          "description": "**Query type**\n `q = mine` means list collections of your account.\n `q = findByContentId` means list collections contained the specific content(clip).",
          "enum": [
            "findByContentId",
            "mine"
          ],
          "examples": [
            "mine"
          ],
