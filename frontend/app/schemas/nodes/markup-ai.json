          "contentMediaType": "application/json",
          "contentSchema": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": null,
          "description": "Issues from a previous run to act on, each exactly as returned in that run's result. Supported by agents that apply or rework existing findings; when provided, such an agent works from these instead of re-detecting. Positions must refer to the ``text`` in this request. Other agents ignore this field.",
          "title": "Issues",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "generate_fixes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, agents that apply existing findings also draft a fix for findings that carry no suggested replacement. Every drafted fix is verified in context before it is applied; a finding whose draft fails that verification is returned unapplied and its text is left unchanged. Off by default. Other agents ignore this field.",
