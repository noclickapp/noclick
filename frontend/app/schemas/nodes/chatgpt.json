    "ChatGPTCreateBatch": {
      "additionalProperties": false,
      "description": "Start asynchronous processing of an existing uploaded batch input file.",
      "properties": {
        "operation": {
          "const": "create_batch",
          "default": "create_batch",
          "title": "Operation",
          "type": "string"
        },
        "input_file_id": {
          "title": "Input File Id",
          "type": "string"
        },
        "endpoint": {
          "enum": [
            "/v1/responses",
            "/v1/chat/completions",
            "/v1/embeddings",
            "/v1/completions",
            "/v1/moderations",
            "/v1/images/generations",
            "/v1/images/edits",
            "/v1/videos"
          ],
          "title": "Endpoint",
          "type": "string"
        },
        "completion_window": {
          "const": "24h",
          "default": "24h",
          "title": "Completion Window",
          "type": "string"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata"
        }
      },
      "required": [
        "input_file_id",
        "endpoint"
      ],
      "title": "ChatGPTCreateBatch",
      "type": "object"
    },
    "ChatGPTCreateChatCompletion": {
      "additionalProperties": false,
      "description": "Generate a chat completion from text messages; optionally store it for later reads.",
      "properties": {
        "operation": {
          "const": "create_chat_completion",
          "default": "create_chat_completion",
          "title": "Operation",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/ChatGPTMessage"
          },
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        },
        "max_completion_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Completion Tokens"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "store": {
          "default": false,
          "title": "Store",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "messages"
      ],
      "title": "ChatGPTCreateChatCompletion",
      "type": "object"
    },
    "ChatGPTCreateEmbedding": {
      "additionalProperties": false,
      "description": "Create numeric embedding vectors for text.",
