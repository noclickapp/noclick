            }
          ],
          "default": null,
          "title": "Longdescription"
        },
        "permissions": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "public:read",
                  "team:read",
                  "team:write"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permissions"
        },
        "tlp": {
          "anyOf": [
            {
              "enum": [
                "red",
                "amber+strict",
                "amber",
                "green",
                "clear"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tlp",
          "enum": [
            "red",
            "amber+strict",
            "amber",
            "green",
            "clear"
          ],
          "x-enum-searchable": true
        },
        "usertags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usertags"
        },
        "operation": {
          "const": "update_saved_search",
          "default": "update_saved_search",
          "title": "Operation",
          "type": "string"
        },
        "search_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Search Id",
          "type": "string"
        }
      },
      "required": [
        "datasource",
        "name",
        "query",
        "search_id"
      ],
      "title": "UpdateSavedSearch",
      "type": "object",
      "x-requires-tier": "pro",
      "x-tier-label": "urlscan Pro"
    },
    "UpdateVisibility": {
      "additionalProperties": false,
      "description": "Change visibility of your/team scan. 'deleted' removes it from view.",
      "properties": {
        "scan_id": {
          "description": "UUID of the scan result",
          "format": "uuid",
          "title": "Scan Id",
          "type": "string"
        },
        "operation": {
          "const": "update_visibility",
          "default": "update_visibility",
          "title": "Operation",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "unlisted",
            "private",
            "deleted"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "scan_id",
        "visibility"
      ],
      "title": "UpdateVisibility",
      "type": "object",
      "x-requires-tier": "pro",
      "x-tier-label": "urlscan Pro"
    },
    "UrlscanioAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "urlscanio_api_key",
          "default": "urlscanio_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "urlscan.io API Key",
      "type": "object",
      "x-credential-instructions": "Paste your urlscan.io API key from your profile. NoClick checks the current user. Pro operations need a urlscan Pro plan and the key's permissions; connecting does not verify write access.",
      "x-credential-url": "https://urlscan.io/user/profile/"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_saved_search": "#/$defs/CreateSavedSearch",
          "delete_saved_search": "#/$defs/DeleteSavedSearch",
          "get_available_brands": "#/$defs/GetAvailableBrands",
          "get_brand_summary": "#/$defs/GetBrandSummary",
          "get_countries": "#/$defs/GetCountries",
          "get_hostname_history": "#/$defs/GetHostnameHistory",
          "get_quotas": "#/$defs/GetQuotas",
          "get_result": "#/$defs/GetResult",
          "get_similar_results": "#/$defs/GetSimilarResults",
          "get_user": "#/$defs/GetUser",
          "list_channels": "#/$defs/ListChannels",
          "list_saved_searches": "#/$defs/ListSavedSearches",
          "list_subscriptions": "#/$defs/ListSubscriptions",
          "reset_visibility": "#/$defs/ResetVisibility",
          "search": "#/$defs/Search",
          "submit_scan": "#/$defs/SubmitScan",
          "update_saved_search": "#/$defs/UpdateSavedSearch",
          "update_visibility": "#/$defs/UpdateVisibility"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetUser"
        },
        {
          "$ref": "#/$defs/SubmitScan"
        },
        {
          "$ref": "#/$defs/Search"
        },
        {
          "$ref": "#/$defs/GetResult"
        },
        {
          "$ref": "#/$defs/UpdateVisibility"
        },
        {
          "$ref": "#/$defs/ResetVisibility"
        },
        {
          "$ref": "#/$defs/GetCountries"
        },
        {
          "$ref": "#/$defs/GetQuotas"
        },
        {
          "$ref": "#/$defs/GetAvailableBrands"
        },
        {
          "$ref": "#/$defs/GetBrandSummary"
        },
        {
          "$ref": "#/$defs/GetHostnameHistory"
        },
        {
          "$ref": "#/$defs/GetSimilarResults"
        },
        {
          "$ref": "#/$defs/ListSavedSearches"
        },
        {
          "$ref": "#/$defs/CreateSavedSearch"
        },
        {
          "$ref": "#/$defs/UpdateSavedSearch"
        },
        {
          "$ref": "#/$defs/DeleteSavedSearch"
        },
        {
          "$ref": "#/$defs/ListSubscriptions"
        },
        {
          "$ref": "#/$defs/ListChannels"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/UrlscanioAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Urlscanio Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
