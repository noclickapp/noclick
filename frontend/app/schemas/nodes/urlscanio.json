{
  "$defs": {
    "CreateSavedSearch": {
      "additionalProperties": false,
      "properties": {
        "datasource": {
          "enum": [
            "hostnames",
            "scans"
          ],
          "title": "Datasource",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "longDescription": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longdescription"
        },
        "permissions": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "public:read",
                  "team:read",
                  "team:write"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permissions"
        },
        "tlp": {
          "anyOf": [
            {
              "enum": [
                "red",
                "amber+strict",
                "amber",
                "green",
                "clear"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tlp",
          "enum": [
            "red",
            "amber+strict",
            "amber",
            "green",
            "clear"
          ],
          "x-enum-searchable": true
        },
        "usertags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usertags"
        },
        "operation": {
          "const": "create_saved_search",
          "default": "create_saved_search",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "datasource",
        "name",
        "query"
      ],
      "title": "CreateSavedSearch",
      "type": "object",
      "x-requires-tier": "pro",
      "x-tier-label": "urlscan Pro"
    },
    "DeleteSavedSearch": {
