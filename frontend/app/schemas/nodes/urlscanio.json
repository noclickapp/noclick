    },
    "GetBrandSummary": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_brand_summary",
          "default": "get_brand_summary",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetBrandSummary",
      "type": "object",
      "x-requires-tier": "pro",
      "x-tier-label": "urlscan Pro"
    },
    "GetCountries": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_countries",
          "default": "get_countries",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetCountries",
      "type": "object"
    },
    "GetHostnameHistory": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_hostname_history",
          "default": "get_hostname_history",
          "title": "Operation",
          "type": "string"
        },
        "hostname": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Hostname",
          "type": "string"
        },
        "limit": {
          "default": 1000,
          "maximum": 10000,
          "minimum": 10,
          "title": "Limit",
          "type": "integer"
        },
        "pageState": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque pageState from the previous response",
          "title": "Pagestate"
        }
      },
      "required": [
        "hostname"
      ],
      "title": "GetHostnameHistory",
      "type": "object"
    },
    "GetQuotas": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_quotas",
          "default": "get_quotas",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetQuotas",
      "type": "object"
    },
    "GetResult": {
      "additionalProperties": false,
      "description": "Read a completed scan. A 404 may mean it is still processing; retry explicitly later.",
      "properties": {
        "scan_id": {
          "description": "UUID of the scan result",
          "format": "uuid",
          "title": "Scan Id",
          "type": "string"
        },
        "operation": {
          "const": "get_result",
          "default": "get_result",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "scan_id"
      ],
      "title": "GetResult",
      "type": "object"
    },
    "GetSimilarResults": {
      "additionalProperties": false,
      "properties": {
        "scan_id": {
          "description": "UUID of the scan result",
          "format": "uuid",
          "title": "Scan Id",
          "type": "string"
        },
        "operation": {
          "const": "get_similar_results",
          "default": "get_similar_results",
          "title": "Operation",
          "type": "string"
        },
        "q": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q"
        },
        "size": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "search_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search After"
        }
      },
      "required": [
        "scan_id"
      ],
      "title": "GetSimilarResults",
      "type": "object",
      "x-requires-tier": "pro",
      "x-tier-label": "urlscan Pro"
    },
    "GetUser": {
      "additionalProperties": false,
      "properties": {
        "operation": {
