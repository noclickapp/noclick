          "const": "list_saved_searches",
          "default": "list_saved_searches",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListSavedSearches",
      "type": "object",
      "x-requires-tier": "pro",
      "x-tier-label": "urlscan Pro"
    },
    "ListSubscriptions": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_subscriptions",
          "default": "list_subscriptions",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListSubscriptions",
      "type": "object",
      "x-requires-tier": "pro",
      "x-tier-label": "urlscan Pro"
    },
    "ResetVisibility": {
      "additionalProperties": false,
      "properties": {
        "scan_id": {
          "description": "UUID of the scan result",
          "format": "uuid",
          "title": "Scan Id",
          "type": "string"
        },
        "operation": {
          "const": "reset_visibility",
          "default": "reset_visibility",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "scan_id"
      ],
      "title": "ResetVisibility",
      "type": "object",
      "x-requires-tier": "pro",
      "x-tier-label": "urlscan Pro"
    },
    "Search": {
      "additionalProperties": false,
      "description": "Retrieve one page. Pass the last result's comma-separated sort values as search_after.",
      "properties": {
        "operation": {
          "const": "search",
          "default": "search",
          "title": "Operation",
          "type": "string"
        },
        "q": {
          "description": "Elasticsearch query string, e.g. page.domain:example.com",
          "minLength": 1,
          "title": "Q",
          "type": "string"
        },
        "size": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "search_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search After"
        },
        "datasource": {
          "default": "scans",
          "enum": [
            "scans",
            "hostnames",
            "incidents",
            "notifications",
            "certificates"
          ],
          "title": "Datasource",
          "type": "string"
        },
        "collapse": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collapse"
        }
      },
      "required": [
        "q"
      ],
      "title": "Search",
      "type": "object"
    },
    "SubmitScan": {
      "additionalProperties": false,
      "description": "Submit a URL once. The response acknowledges a queued scan; poll get_result later.",
      "properties": {
        "operation": {
          "const": "submit_scan",
          "default": "submit_scan",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "title": "Url",
          "type": "string"
        },
        "visibility": {
          "default": "private",
          "description": "Public scans expose the URL and page contents to everyone. Private scans need available quota.",
          "enum": [
            "public",
            "unlisted",
            "private"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "country": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "maxLength": 30,
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "referer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referer"
        },
        "customagent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customagent"
        }
      },
      "required": [
        "url"
      ],
      "title": "SubmitScan",
      "type": "object"
    },
    "UpdateSavedSearch": {
