{
  "$defs": {
    "CarsxeApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "carsxe_api_key",
          "default": "carsxe_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "CarsXE API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the CarsXE dashboard. NoClick sends it as the key query parameter to api.carsxe.com. Your plan must enable the products you use; lookups and batch submissions may consume paid credits. The connection check reads the vehicle catalogue and confirms reachability, not account identity.",
      "x-credential-url": "https://carsxe.com/dashboard/developer"
    },
    "CollateralVehicle": {
      "additionalProperties": false,
      "properties": {
        "vin": {
          "maxLength": 17,
          "minLength": 17,
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
          "title": "Vin",
          "type": "string"
        },
        "mileage": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Mileage",
          "type": "integer"
        },
        "zip": {
          "pattern": "^[0-9]{5}$",
          "title": "ZIP code",
          "type": "string"
        },
        "loan_term_months": {
          "anyOf": [
            {
              "maximum": 96,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loan Term Months"
        }
      },
      "required": [
        "vin",
        "mileage",
        "zip"
      ],
      "title": "CollateralVehicle",
      "type": "object"
    },
    "DecodeInternationalVinConfig": {
      "additionalProperties": false,
      "description": "International VIN Decoder.",
      "properties": {
        "operation": {
          "const": "decode_international_vin",
          "default": "decode_international_vin",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "vin": {
          "description": "The 17 character long vehicle identification number.",
          "maxLength": 17,
          "minLength": 17,
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
          "title": "Vin",
          "type": "string"
        }
      },
      "required": [
        "vin"
      ],
      "title": "DecodeInternationalVinConfig",
      "type": "object"
    },
    "DecodeObdCodeConfig": {
      "additionalProperties": false,
      "description": "OBD Codes Decoder.",
      "properties": {
        "operation": {
          "const": "decode_obd_code",
          "default": "decode_obd_code",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "code": {
          "description": "The OBD code.",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "DecodeObdCodeConfig",
      "type": "object"
    },
    "DecodePlateConfig": {
      "additionalProperties": false,
      "description": "License Plate Decoder (v2).",
      "properties": {
        "operation": {
          "const": "decode_plate",
          "default": "decode_plate",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "plate": {
          "description": "The vehicle registration number or license plate number.",
          "minLength": 1,
          "title": "Plate",
          "type": "string"
        },
        "country": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 3166-1 alpha-2 country code such as `AU` for Australia or `ZA` for South Africa. Optional for `US`.",
          "title": "Country"
        },
        "state": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The two letter state code (US) such as `CA` or `NY`, an Australian state (e.g. `NSW`, `VIC`), or a Canadian province (e.g. `ON`). Required for `AU` and `CA`. Optional for `US`: omit it, with `country=US`, to fan out across every covered US jurisdiction. x402 payments still require `state`.",
          "title": "State"
        },
        "district": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The district of the vehicle registration number. Required for Pakistan (`PK`) plates registered in the Khyber-Pakhtunkhwa province.",
          "title": "District"
        },
        "require_vin": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only supported when `country=ES`. Set to `true` to always include a VIN. The request is billed 2x and usage counts 2x.",
          "title": "Require Vin"
        }
      },
      "required": [
        "plate"
      ],
      "title": "DecodePlateConfig",
      "type": "object"
    },
    "DecodeUsPlateConfig": {
      "additionalProperties": false,
      "description": "US Vehicle Plate Decoder.",
      "properties": {
        "operation": {
          "const": "decode_us_plate",
          "default": "decode_us_plate",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "plate": {
          "description": "The vehicle registration number or license plate number.",
          "minLength": 1,
          "title": "Plate",
          "type": "string"
        },
        "state": {
          "description": "Two-letter abbreviation for one of the 50 US states, the District of Columbia (`DC`), or Puerto Rico (`PR`).",
          "minLength": 1,
          "title": "State",
          "type": "string"
        },
        "decodeVIN": {
          "anyOf": [
            {
              "enum": [
                "true",
                "1"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set to `true` or `1` to decode the resolved VIN and include a `vehicle_specs` object in the response (identical in shape to the Specifications endpoint response).",
          "title": "Decodevin",
          "enum": [
            "true",
            "1"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "plate",
        "state"
      ],
      "title": "DecodeUsPlateConfig",
      "type": "object"
    },
    "GetCollateralBatchConfig": {
      "additionalProperties": false,
      "description": "Collateral Score Batch (status and results).",
      "properties": {
        "operation": {
          "const": "get_collateral_batch",
          "default": "get_collateral_batch",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        }
      },
      "required": [
        "batch_id"
      ],
      "title": "GetCollateralBatchConfig",
      "type": "object"
    },
    "GetCollateralScoreConfig": {
      "additionalProperties": false,
      "description": "Collateral Score.",
      "properties": {
        "operation": {
          "const": "get_collateral_score",
          "default": "get_collateral_score",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "vin": {
          "maxLength": 17,
          "minLength": 17,
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
          "title": "Vin",
          "type": "string"
        },
        "mileage": {
          "description": "Current odometer reading in miles.",
          "maximum": 1000000,
          "minimum": 0,
          "title": "Mileage",
          "type": "integer"
        },
        "zip": {
          "description": "US ZIP; its state sets the regional value adjustment.",
          "minLength": 1,
          "pattern": "^[0-9]{5}$",
          "title": "Zip",
          "type": "string"
        },
        "loan_term_months": {
          "anyOf": [
            {
              "maximum": 96,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Adds `depreciation_forecast.at_loan_maturity`.",
          "title": "Loan Term Months"
        }
      },
      "required": [
        "vin",
        "mileage",
        "zip"
      ],
      "title": "GetCollateralScoreConfig",
      "type": "object"
    },
    "GetHistoryConfig": {
      "additionalProperties": false,
      "description": "Vehicle History.",
      "properties": {
        "operation": {
          "const": "get_history",
          "default": "get_history",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "vin": {
          "description": "The 17 character long vehicle identification number.",
          "maxLength": 17,
          "minLength": 17,
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
          "title": "Vin",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "const": "json",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The format of the response. One of `json` or `xml`.",
          "title": "Format"
        },
        "lienTheft": {
          "anyOf": [
            {
              "enum": [
                "true",
                "1"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set to `true` or `1` to include a Lien & Theft check for the same VIN under `lienTheft`. Billed as one extra Lien & Theft call, only when lien & theft data is returned.",
          "title": "Lientheft",
          "enum": [
            "true",
            "1"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "vin"
      ],
      "title": "GetHistoryConfig",
      "type": "object"
    },
    "GetImagesConfig": {
      "additionalProperties": false,
      "description": "Vehicle Images.",
      "properties": {
        "operation": {
          "const": "get_images",
          "default": "get_images",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "make": {
          "description": "The vehicle make.",
          "minLength": 1,
          "title": "Make",
          "type": "string"
        },
        "model": {
          "description": "The vehicle model.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[0-9]{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The vehicle year.",
          "title": "Year"
        },
        "trim": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The vehicle trim.",
          "title": "Trim"
        },
        "color": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The vehicle color.",
          "title": "Color"
        },
        "transparent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prioritize images with transparent background. Defaults to `true`.",
          "title": "Transparent"
        },
        "angle": {
          "anyOf": [
            {
              "enum": [
                "front",
                "side",
                "back"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The angle to show the car in.",
          "title": "Angle",
          "enum": [
            "front",
            "side",
            "back"
          ],
          "x-enum-searchable": true
        },
        "photoType": {
          "anyOf": [
            {
              "enum": [
                "interior",
                "exterior",
                "engine"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Request images of the interior, exterior or engine. Can only be used in conjunction with year, make, model and trim query params.",
          "title": "Phototype",
          "enum": [
            "interior",
            "exterior",
            "engine"
          ],
          "x-enum-searchable": true
        },
        "size": {
          "anyOf": [
            {
              "enum": [
                "Small",
                "Medium",
                "Large",
                "Wallpaper",
                "All"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Request images of a given size. Defaults to all sizes.",
          "title": "Size",
          "enum": [
            "Small",
            "Medium",
            "Large",
            "Wallpaper",
            "All"
          ],
          "x-enum-searchable": true
        },
        "license": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter images by usage-rights labels supplied by the hosting site. This does not grant a license; confirm each image's contextLink before reuse. Presets: Public (public domain only); Share (free to use or share, including NonCommercial and NoDerivatives); ShareCommercially (free to share commercially; excludes NonCommercial, includes NoDerivatives); Modify (free to modify; excludes NoDerivatives, includes NonCommercial); ModifyCommercially (free to modify commercially; public domain, attribution, and ShareAlike only). Or pass specific tokens as a comma-separated list: cc_publicdomain (public domain), cc_attribute (attribution; commercial use and modification, with credit when shared), cc_sharealike (ShareAlike; shared adaptations use the same license), cc_noncommercial (NonCommercial), cc_nonderived (NoDerivatives). Prefix a token with - to exclude it. At least one included token is required. Leave blank to return all images.",
          "title": "License"
        },
        "format": {
          "anyOf": [
            {
              "const": "json",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The format of the response. One of `json` or `xml`.",
          "title": "Format"
        }
      },
      "required": [
        "make",
        "model"
      ],
      "title": "GetImagesConfig",
      "type": "object"
    },
    "GetLienTheftConfig": {
      "additionalProperties": false,
      "description": "Lien & Theft records.",
      "properties": {
        "operation": {
          "const": "get_lien_theft",
          "default": "get_lien_theft",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "vin": {
          "description": "The 17 character long vehicle identification number.",
          "maxLength": 17,
          "minLength": 17,
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
          "title": "Vin",
          "type": "string"
        }
      },
      "required": [
        "vin"
      ],
      "title": "GetLienTheftConfig",
      "type": "object"
    },
    "GetMarketValueConfig": {
      "additionalProperties": false,
      "description": "Vehicle Market Value (v2).",
      "properties": {
        "operation": {
          "const": "get_market_value",
          "default": "get_market_value",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "vin": {
          "description": "The 17 character long vehicle identification number.",
          "maxLength": 17,
          "minLength": 17,
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
          "title": "Vin",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The US state of the vehicle to get the market value for.",
          "title": "State"
        },
        "mileage": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The current odometer reading (miles in the US, kilometers in Canada). When passed with condition, the API selects the matching mileage_list band and writes it into mileage_*, then recalculates adjusted_*. Omit mileage to apply bands yourself.",
          "title": "Mileage"
        },
        "condition": {
          "anyOf": [
            {
              "enum": [
                "excellent",
                "clean",
                "average",
                "rough"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overall condition: excellent, clean, average, or rough. excellent maps to the xclean response tier. Used with mileage to apply the matching band.",
          "title": "Condition",
          "enum": [
            "excellent",
            "clean",
            "average",
            "rough"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "vin"
      ],
      "title": "GetMarketValueConfig",
      "type": "object"
    },
    "GetRecallCampaignConfig": {
      "additionalProperties": false,
      "description": "Recall Campaign.",
      "properties": {
        "operation": {
          "const": "get_recall_campaign",
          "default": "get_recall_campaign",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "make": {
          "description": "The vehicle manufacturer name (e.g. `volkswagen`). Case and extra whitespace are ignored.",
          "maxLength": 120,
          "minLength": 1,
          "title": "Make",
          "type": "string"
        },
        "code": {
          "description": "The manufacturer's campaign code (e.g. `37M2`). Case-insensitive, the letter O is read as zero, and Volkswagen warranty codes match in any spelling (`VWP1403`, `VWP 14 03`, `VWP-14-03`).",
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "make",
        "code"
      ],
      "title": "GetRecallCampaignConfig",
      "type": "object"
    },
    "GetRecallsBatchResultsConfig": {
      "additionalProperties": false,
      "description": "Get bulk recalls batch results.",
      "properties": {
        "operation": {
          "const": "get_recalls_batch_results",
          "default": "get_recalls_batch_results",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "batchId": {
          "description": "The batch ID returned from the submit endpoint.",
          "minLength": 1,
          "title": "Batchid",
          "type": "string"
        }
      },
      "required": [
        "batchId"
      ],
      "title": "GetRecallsBatchResultsConfig",
      "type": "object"
    },
    "GetRecallsBatchStatusConfig": {
      "additionalProperties": false,
      "description": "Get bulk recalls batch status.",
      "properties": {
        "operation": {
          "const": "get_recalls_batch_status",
          "default": "get_recalls_batch_status",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "batchId": {
          "description": "The batch ID returned from the submit endpoint.",
          "minLength": 1,
          "title": "Batchid",
          "type": "string"
        }
      },
      "required": [
        "batchId"
      ],
      "title": "GetRecallsBatchStatusConfig",
      "type": "object"
    },
    "GetRecallsByYmmConfig": {
      "additionalProperties": false,
      "description": "Recalls by Year, Make & Model.",
      "properties": {
        "operation": {
          "const": "get_recalls_by_ymm",
          "default": "get_recalls_by_ymm",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "year": {
          "description": "The 4-digit model year (e.g. `2019`).",
          "minLength": 1,
          "pattern": "^[0-9]{4}$",
          "title": "Year",
          "type": "string"
        },
        "make": {
          "description": "The vehicle manufacturer name (e.g. `Toyota`). Case-insensitive.",
          "minLength": 1,
          "title": "Make",
          "type": "string"
        },
        "model": {
          "description": "The vehicle model name (e.g. `Camry`). Case-insensitive.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "year",
        "make",
        "model"
      ],
      "title": "GetRecallsByYmmConfig",
      "type": "object"
    },
    "GetRecallsConfig": {
      "additionalProperties": false,
      "description": "Vehicle Recalls.",
      "properties": {
        "operation": {
          "const": "get_recalls",
          "default": "get_recalls",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "vin": {
          "description": "The 17 character long vehicle identification number.",
          "maxLength": 17,
          "minLength": 17,
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
          "title": "Vin",
          "type": "string"
        }
      },
      "required": [
        "vin"
      ],
      "title": "GetRecallsConfig",
      "type": "object"
    },
    "GetSpecsConfig": {
      "additionalProperties": false,
      "description": "Vehicle Specifications (VIN decoder).",
      "properties": {
        "operation": {
          "const": "get_specs",
          "default": "get_specs",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "vin": {
          "description": "The 17 character long vehicle identification number.",
          "maxLength": 17,
          "minLength": 17,
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
          "title": "Vin",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "const": "json",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The format of the response. One of `json` or `xml`.",
          "title": "Format"
        },
        "deepdata": {
          "anyOf": [
            {
              "const": "1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Request extra data. Set to `1` to use. Significantly slower than the regular request but retrieves additional data.",
          "title": "Deepdata"
        },
        "disableIntVINDecoding": {
          "anyOf": [
            {
              "const": "1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set to `1` to disable the International VIN decoding fallback and return an error instead of a potential partial response.",
          "title": "Disableintvindecoding"
        }
      },
      "required": [
        "vin"
      ],
      "title": "GetSpecsConfig",
      "type": "object"
    },
    "GetYearMakeModelConfig": {
      "additionalProperties": false,
      "description": "Year Make Model.",
      "properties": {
        "operation": {
          "const": "get_year_make_model",
          "default": "get_year_make_model",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "year": {
          "description": "The manufacturing year of the vehicle (numeric, between 1900 and the current model year plus one).",
