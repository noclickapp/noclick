{
  "$defs": {
    "FungeneratorsAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "fungenerators_api_key",
          "default": "fungenerators_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Fun Generators API Key",
      "type": "object",
      "x-credential-instructions": "Paste the API key from your Fun Generators subscription, without the Bearer prefix. UUID requests use your plan's quota. NoClick checks API reachability by generating one UUID; this service has no account identity endpoint.",
      "x-credential-url": "https://fungenerators.com/api/uuid/"
    },
    "GetUUIDsConfig": {
      "description": "Generate random UUIDs, optionally choosing a documented UUID version.",
      "properties": {
        "operation": {
          "const": "get_uuids",
          "default": "get_uuids",
          "title": "Generate UUIDs",
          "type": "string",
          "ui:hidden": true
        },
        "limit": {
          "default": 1,
          "description": "Number of UUIDs to generate. Your subscription limits apply.",
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "version": {
          "anyOf": [
            {
              "enum": [
                "0",
                "1",
                "2",
                "3",
                "4",
                "5",
                "6",
                "7"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UUID version. Leave blank for random v4; 0 produces a nil UUID.",
          "title": "Version",
          "enum": [
            "0",
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "7"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "GetUUIDsConfig",
      "type": "object"
    },
    "ParseUUIDConfig": {
      "description": "Check a UUID string's validity and return its version.",
      "properties": {
        "operation": {
          "const": "parse_uuid",
          "default": "parse_uuid",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "uuid": {
          "description": "UUID string to send to the provider for validation.",
          "minLength": 1,
          "title": "Uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid"
      ],
      "title": "ParseUUIDConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_uuids": "#/$defs/GetUUIDsConfig",
          "parse_uuid": "#/$defs/ParseUUIDConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetUUIDsConfig"
        },
        {
          "$ref": "#/$defs/ParseUUIDConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/FungeneratorsAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Fungenerators Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
