            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "sort_by": {
          "anyOf": [
            {
              "enum": [
                "usage",
                "alphabetically"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort By",
          "enum": [
            "usage",
            "alphabetically"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "ListToolkits",
      "type": "object"
    },
