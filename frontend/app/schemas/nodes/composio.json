            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque next_cursor from the preceding page with the same filters.",
          "title": "Cursor"
        },
        "operation": {
          "const": "list_auth_configs",
          "default": "list_auth_configs",
          "title": "Operation",
          "type": "string"
        },
        "toolkit_slug": {
          "anyOf": [
            {
              "maxLength": 256,
