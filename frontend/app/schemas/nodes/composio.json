{
  "$defs": {
    "ComposioAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "composio_api_key",
          "default": "composio_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Composio API Key",
      "type": "object",
      "x-credential-instructions": "Paste a project API key from Composio project settings. Grant read access to connected accounts for the connection check, and permissions for the operations you use.",
      "x-credential-url": "https://dashboard.composio.dev/~/project/settings/api-keys"
    },
    "CreateAuthConfig": {
      "additionalProperties": false,
      "description": "Create a Composio-managed auth configuration for a toolkit.",
      "properties": {
        "operation": {
          "const": "create_auth_config",
          "default": "create_auth_config",
          "title": "Operation",
          "type": "string"
        },
        "toolkit_slug": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Toolkit Slug",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "toolkit_slug",
        "name"
      ],
      "title": "CreateAuthConfig",
      "type": "object"
    },
    "DeleteAuthConfig": {
      "additionalProperties": false,
      "description": "Delete one auth configuration; does not request upstream revocation.",
      "properties": {
        "operation": {
          "const": "delete_auth_config",
          "default": "delete_auth_config",
          "title": "Operation",
          "type": "string"
        },
        "auth_config_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Auth Config Id",
          "type": "string"
        }
      },
      "required": [
        "auth_config_id"
      ],
      "title": "DeleteAuthConfig",
      "type": "object"
    },
    "DeleteConnectedAccount": {
      "additionalProperties": false,
      "description": "Delete a connected account; does not request upstream revocation.",
      "properties": {
        "operation": {
          "const": "delete_connected_account",
          "default": "delete_connected_account",
          "title": "Operation",
          "type": "string"
        },
        "connected_account_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Connected Account Id",
          "type": "string"
        }
      },
      "required": [
        "connected_account_id"
      ],
      "title": "DeleteConnectedAccount",
      "type": "object"
    },
    "DeleteTrigger": {
      "additionalProperties": false,
      "description": "Delete one trigger instance.",
      "properties": {
        "operation": {
          "const": "delete_trigger",
          "default": "delete_trigger",
          "title": "Operation",
          "type": "string"
        },
        "trigger_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Trigger Id",
          "type": "string"
        }
      },
      "required": [
        "trigger_id"
      ],
      "title": "DeleteTrigger",
      "type": "object"
    },
    "ExecuteTool": {
      "additionalProperties": false,
      "description": "Execute one tool as an explicit connected account and user.",
      "properties": {
        "operation": {
          "const": "execute_tool",
          "default": "execute_tool",
          "title": "Operation",
          "type": "string"
        },
        "tool_slug": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Tool Slug",
          "type": "string"
        },
        "connected_account_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Connected Account Id",
          "type": "string"
        },
        "user_id": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "User Id",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "description": "Arguments matching the schema returned by get_tool.",
          "title": "Arguments",
          "type": "object"
        },
        "version": {
          "default": "latest",
          "description": "Use a fixed published version for repeatable workflows.",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "tool_slug",
        "connected_account_id",
        "user_id"
      ],
      "title": "ExecuteTool",
      "type": "object"
    },
    "GetAuthConfig": {
      "additionalProperties": false,
      "description": "Read an authentication configuration's non-secret metadata.",
      "properties": {
        "operation": {
          "const": "get_auth_config",
          "default": "get_auth_config",
          "title": "Operation",
          "type": "string"
        },
        "auth_config_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Auth Config Id",
          "type": "string"
        }
      },
      "required": [
        "auth_config_id"
      ],
      "title": "GetAuthConfig",
      "type": "object"
    },
    "GetConnectedAccount": {
      "additionalProperties": false,
      "description": "Read one connected account, omitting connection state and credential data.",
      "properties": {
        "operation": {
          "const": "get_connected_account",
          "default": "get_connected_account",
          "title": "Operation",
          "type": "string"
        },
        "connected_account_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Connected Account Id",
          "type": "string"
        }
      },
      "required": [
        "connected_account_id"
      ],
      "title": "GetConnectedAccount",
      "type": "object"
    },
    "GetTool": {
      "additionalProperties": false,
      "description": "Read a tool's argument schema before executing it.",
      "properties": {
        "operation": {
          "const": "get_tool",
          "default": "get_tool",
          "title": "Operation",
          "type": "string"
        },
        "tool_slug": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Tool Slug",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "tool_slug"
      ],
      "title": "GetTool",
      "type": "object"
    },
    "GetToolkit": {
      "additionalProperties": false,
      "description": "Read toolkit authentication requirements and metadata.",
      "properties": {
        "operation": {
          "const": "get_toolkit",
          "default": "get_toolkit",
          "title": "Operation",
          "type": "string"
        },
        "slug": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Slug",
          "type": "string"
        },
        "version": {
          "default": "latest",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "slug"
      ],
      "title": "GetToolkit",
      "type": "object"
    },
    "GetTriggerType": {
      "additionalProperties": false,
      "description": "Read the configuration and payload schemas of one trigger type.",
      "properties": {
        "operation": {
          "const": "get_trigger_type",
          "default": "get_trigger_type",
          "title": "Operation",
          "type": "string"
        },
        "slug": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "slug"
      ],
      "title": "GetTriggerType",
      "type": "object"
    },
    "ListActiveTriggers": {
      "additionalProperties": false,
      "description": "List project trigger instances with explicit pagination.",
      "properties": {
        "limit": {
          "default": 50,
          "description": "Maximum results in this page; follow next_cursor explicitly.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque next_cursor from the preceding page with the same filters.",
          "title": "Cursor"
        },
        "operation": {
          "const": "list_active_triggers",
          "default": "list_active_triggers",
          "title": "Operation",
          "type": "string"
        },
        "user_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Ids"
        },
        "show_disabled": {
          "default": false,
          "title": "Show Disabled",
          "type": "boolean"
        }
      },
      "title": "ListActiveTriggers",
      "type": "object"
    },
    "ListAuthConfigs": {
