              "type": "null"
            }
          ],
          "default": null,
          "title": "Toolkit Slugs"
        },
        "statuses": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "INITIALIZING",
                  "INITIATED",
                  "ACTIVE",
                  "FAILED",
                  "EXPIRED",
                  "INACTIVE",
                  "REVOKED"
                ],
                "type": "string"
              },
              "maxItems": 7,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statuses"
        }
      },
      "title": "ListConnectedAccounts",
      "type": "object"
    },
