        "limit": {
          "default": 50,
          "description": "Maximum results in this page; follow next_cursor explicitly.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 8192,
