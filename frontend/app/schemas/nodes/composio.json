            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "important": {
          "anyOf": [
            {
              "enum": [
                "true",
                "false"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Important",
          "enum": [
            "true",
            "false"
          ],
