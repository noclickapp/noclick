        "connected_account_id",
        "user_id"
      ],
      "title": "UpsertTrigger",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_auth_config": "#/$defs/CreateAuthConfig",
          "delete_auth_config": "#/$defs/DeleteAuthConfig",
          "delete_connected_account": "#/$defs/DeleteConnectedAccount",
          "delete_trigger": "#/$defs/DeleteTrigger",
          "execute_tool": "#/$defs/ExecuteTool",
          "get_auth_config": "#/$defs/GetAuthConfig",
          "get_connected_account": "#/$defs/GetConnectedAccount",
          "get_tool": "#/$defs/GetTool",
          "get_toolkit": "#/$defs/GetToolkit",
          "get_trigger_type": "#/$defs/GetTriggerType",
          "list_active_triggers": "#/$defs/ListActiveTriggers",
          "list_auth_configs": "#/$defs/ListAuthConfigs",
          "list_connected_accounts": "#/$defs/ListConnectedAccounts",
          "list_toolkit_categories": "#/$defs/ListToolkitCategories",
          "list_toolkits": "#/$defs/ListToolkits",
          "list_tools": "#/$defs/ListTools",
          "list_trigger_types": "#/$defs/ListTriggerTypes",
          "update_trigger": "#/$defs/UpdateTrigger",
          "upsert_trigger": "#/$defs/UpsertTrigger"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListTools"
        },
        {
          "$ref": "#/$defs/GetTool"
        },
        {
          "$ref": "#/$defs/ExecuteTool"
        },
        {
          "$ref": "#/$defs/ListToolkits"
        },
        {
          "$ref": "#/$defs/GetToolkit"
        },
        {
          "$ref": "#/$defs/ListToolkitCategories"
        },
        {
          "$ref": "#/$defs/ListAuthConfigs"
        },
        {
          "$ref": "#/$defs/GetAuthConfig"
