            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque next_cursor from the preceding page with the same filters.",
          "title": "Cursor"
        },
        "operation": {
          "const": "list_connected_accounts",
          "default": "list_connected_accounts",
          "title": "Operation",
          "type": "string"
        },
        "user_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
