          "enum": [
            "poll",
            "webhook"
          ],
          "x-enum-searchable": true
        },
        "polling_interval": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
