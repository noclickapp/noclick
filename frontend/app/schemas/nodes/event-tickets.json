    "EventTicketsApplicationPasswordCredential": {
      "properties": {
        "credential_type": {
          "const": "event_tickets_application_password",
          "default": "event_tickets_application_password",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "site_url": {
          "description": "HTTPS site root, including a WordPress installation subdirectory if needed.",
          "title": "WordPress site URL",
          "type": "string"
        },
        "username": {
          "maxLength": 250,
          "minLength": 1,
          "title": "WordPress username",
          "type": "string"
        },
        "application_password": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Application password",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "site_url",
        "username",
        "application_password"
      ],
      "title": "Event Tickets Application Password",
      "type": "object",
      "x-credential-instructions": "In your WordPress admin, open Users \u2192 Profile \u2192 Application Passwords and create a password. Enter the site URL, your username and that application password. Your user needs permission to read attendees. Requires WordPress 5.6 or later and Event Tickets. Cart actions use a new session and do not place an order.",
      "x-credential-url": "https://developer.wordpress.org/rest-api/using-the-rest-api/authentication/"
    },
