              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "disable_email_notifications": {
          "default": false,
          "description": "Switch off email notifications for members added with the new project.",
          "title": "Disable Email Notifications",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateProject",
      "type": "object"
    },
