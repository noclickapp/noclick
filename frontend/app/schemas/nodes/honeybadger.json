    "UpdateFault": {
      "additionalProperties": false,
      "description": "Resolve, ignore, tag or schedule resolution of a fault (faults:write).",
      "properties": {
        "project_id": {
          "description": "v3 project ID, from List projects (for example Xk9mZp).",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project Id",
          "type": "string"
        },
        "fault_id": {
          "description": "Fault ID as a string, from List faults.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Fault Id",
          "type": "string"
        },
        "operation": {
          "const": "update_fault",
          "default": "update_fault",
          "title": "Operation",
          "type": "string"
        },
        "resolved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved"
        },
        "ignored": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ignored"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replace tags; [] clears them; null clears them.",
          "title": "Tags"
        },
        "resolve_on_deploy": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Resolve on the next deploy; ignored or resolved faults cannot have a pending resolution.",
          "title": "Resolve On Deploy"
        }
      },
      "required": [
        "project_id",
        "fault_id"
      ],
      "title": "UpdateFault",
      "type": "object"
    },
