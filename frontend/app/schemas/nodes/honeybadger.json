{
  "$defs": {
    "CreateComment": {
      "additionalProperties": false,
      "description": "Add a fault comment (faults:write). @mentions notify project members.",
      "properties": {
        "project_id": {
          "description": "v3 project ID, from List projects (for example Xk9mZp).",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project Id",
          "type": "string"
        },
        "fault_id": {
          "description": "Fault ID as a string, from List faults.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Fault Id",
          "type": "string"
        },
        "operation": {
          "const": "create_comment",
          "default": "create_comment",
          "title": "Operation",
          "type": "string"
        },
        "body": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Comment text",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "fault_id",
        "body"
      ],
      "title": "CreateComment",
      "type": "object"
    },
    "CreateProject": {
