        },
        "order": {
          "anyOf": [
            {
              "enum": [
                "recent",
                "frequent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order",
          "enum": [
            "recent",
            "frequent"
          ],
          "x-enum-searchable": true
        },
        "sort": {
          "anyOf": [
            {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort",
          "enum": [
            "asc",
            "desc"
          ],
          "x-enum-searchable": true
        },
        "created_after": {
          "anyOf": [
