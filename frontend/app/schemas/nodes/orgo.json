{
  "$defs": {
    "OrgoAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "orgo_api_key",
          "default": "orgo_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Orgo API Key",
      "type": "object",
      "x-credential-instructions": "In the Orgo dashboard, create an API key and paste its value without the Bearer prefix. Use an account-wide key with permissions for your workflow. NoClick sends it only to www.orgo.ai. Connecting reads the current account; computer creation and running computers can spend your Orgo credit.",
      "x-credential-url": "https://www.orgo.ai/dashboard"
    },
    "OrgoClickConfig": {
      "additionalProperties": false,
      "description": "Click a screen coordinate.",
      "properties": {
        "computer_id": {
          "description": "Computer ID from List Workspaces (desktops) or Create Computer.",
          "minLength": 1,
          "title": "Computer Id",
          "type": "string"
        },
        "screen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional screen selector for computers with multiple displays.",
          "title": "Screen"
        },
        "operation": {
          "const": "click",
          "default": "click",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "button": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Button",
          "enum": [
            "left",
            "right"
          ],
          "x-enum-searchable": true
        },
        "double": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Double"
        }
      },
      "required": [
        "computer_id",
        "x",
        "y"
      ],
      "title": "OrgoClickConfig",
      "type": "object"
    },
    "OrgoCreateComputerConfig": {
      "additionalProperties": false,
      "description": "Provision a cloud computer; this can spend Orgo credit.",
      "properties": {
        "operation": {
          "const": "create_computer",
          "default": "create_computer",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_id": {
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "os": {
          "anyOf": [
            {
              "enum": [
                "linux",
                "windows",
                "macos",
                "android",
                "ios"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Os",
          "enum": [
            "linux",
            "windows",
            "macos",
            "android",
            "ios"
          ],
          "x-enum-searchable": true
        },
        "ram": {
          "anyOf": [
            {
              "enum": [
                4,
                8,
                10,
                16,
                32,
                64
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RAM in GB; omit to use the provider or template default.",
          "title": "Ram"
        },
        "cpu": {
          "anyOf": [
            {
              "enum": [
                0.5,
                1,
                2,
                4,
                6,
                8,
                16
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu"
        },
        "disk_size_gb": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disk Size Gb"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "WIDTHxHEIGHTxDEPTH, for example 1280x720x24.",
          "title": "Resolution"
        },
        "ends_in_hours": {
          "anyOf": [
            {
              "maximum": 720,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Delete the computer and its contents when the time is up. Omit to keep it.",
          "title": "Ends In Hours"
        },
        "billing_mode": {
          "anyOf": [
            {
              "enum": [
                "hourly",
                "plan",
                "monthly"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omitted: provider selects billing; hourly launches spend account credit.",
          "title": "Billing Mode",
          "enum": [
            "hourly",
            "plan",
            "monthly"
          ],
          "x-enum-searchable": true
        },
        "compute_request_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reuse this launch ID when manually retrying to avoid provisioning twice.",
          "title": "Compute Request Id"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[ -~]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional Idempotency-Key header for this launch.",
          "title": "Idempotency Key"
        },
        "template_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template reference namespace/name@version.",
          "title": "Template Ref"
        }
      },
      "required": [
        "workspace_id",
        "name"
      ],
      "title": "OrgoCreateComputerConfig",
      "type": "object"
    },
    "OrgoCreatePublicUrlConfig": {
      "additionalProperties": false,
      "description": "Expose a computer port through a public URL.",
      "properties": {
        "computer_id": {
          "description": "Computer ID from List Workspaces (desktops) or Create Computer.",
