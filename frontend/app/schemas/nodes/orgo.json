      "properties": {
        "computer_id": {
          "description": "Computer ID from List Workspaces (desktops) or Create Computer.",
          "minLength": 1,
          "title": "Computer Id",
          "type": "string"
        },
        "operation": {
          "const": "update_public_url",
          "default": "update_public_url",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "url_id": {
          "format": "uuid",
          "title": "Url Id",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "password": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 4,
              "pattern": "^[!-~]([ -~]*[!-~])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password",
          "ui:widget": "password"
        },
        "remove_password": {
          "default": false,
          "description": "Make the URL open by sending password null.",
          "title": "Remove Password",
          "type": "boolean"
        }
      },
      "required": [
        "computer_id",
        "url_id"
      ],
      "title": "OrgoUpdatePublicUrlConfig",
      "type": "object"
    }
