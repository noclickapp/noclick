{
  "$defs": {
    "HevoAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "hevo_api_key",
          "default": "hevo_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_secret": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Secret",
          "type": "string",
          "ui:widget": "password"
        },
        "region": {
          "description": "The supplied key and secret bind your existing Hevo team. Select its documented region; no caller URL or team-header authority is accepted.",
          "enum": [
            "us",
            "us2",
            "eu",
            "in",
            "asia",
            "au",
            "us-gcp"
          ],
          "enumNames": [
            "US East",
            "US West",
            "Europe",
            "India",
            "Asia",
            "Australia",
            "US GCP"
          ],
          "title": "Hevo Account Region",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "api_secret",
        "region"
      ],
      "title": "Hevo API Key",
      "type": "object",
      "x-credential-instructions": "Supply an existing API key and secret issued by your Hevo account owner for the selected region. Basic username is the key and password is the secret. No account login, generation, mint or renewal is performed. Actual entitlement and per-operation permission are not inferred.",
      "x-credential-url": "https://api-docs.hevodata.com/reference/building-your-first-api"
    },
