{
  "$defs": {
    "OneDriveOAuthCredential": {
      "description": "Microsoft OAuth credential for OneDrive (via Graph API).\n\nUses centralized Microsoft OAuth - credentials are automatically created\nwhen users connect their Microsoft account through the OAuth flow.\n\nScopes required:\n- Files.ReadWrite.All: Full OneDrive file access\n- User.Read: Get user profile info",
      "properties": {
        "credential_type": {
          "const": "microsoft_onedrive_oauth",
          "default": "microsoft_onedrive_oauth",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "description": "OAuth access token",
          "title": "Access Token",
          "type": "string"
        },
        "refresh_token": {
          "description": "OAuth refresh token for token renewal",
          "title": "Refresh Token",
          "type": "string"
        },
        "expires_at": {
          "description": "Token expiry timestamp (ISO 8601)",
          "title": "Expires At",
          "type": "string"
        },
        "email": {
          "description": "Microsoft account email address",
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "access_token",
        "refresh_token",
        "expires_at",
        "email"
      ],
      "title": "OneDriveOAuthCredential",
      "type": "object",
      "x-credential-instructions": "Connect your Microsoft account to access OneDrive files. Uses Microsoft Graph API with OAuth 2.0.",
      "x-credential-type": "oauth",
      "x-credential-url": "https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade",
      "x-oauth-provider": "microsoft",
      "x-oauth-scopes": [
        "https://graph.microsoft.com/Files.ReadWrite.All",
        "https://graph.microsoft.com/User.Read"
      ]
    },
    "PowerPointCopyPresentationConfig": {
      "additionalProperties": false,
      "description": "Start an asynchronous copy in the same drive. A 202 response means accepted; monitor_url tracks completion.",
      "properties": {
        "operation": {
          "const": "copy_presentation",
          "default": "copy_presentation",
          "title": "Copy Presentation from Template",
          "type": "string",
          "ui:hidden": true,
          "x-category": "PowerPoint",
          "x-display-name": "Copy Presentation from Template",
          "x-is-trigger": false
        },
        "drive_id": {
          "description": "Drive ID from Get My Presentation Drive or the file's parentReference.driveId.",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Drive Id",
          "type": "string"
        },
        "presentation_id": {
          "description": "PowerPoint file's driveItem ID from List Presentations in Folder.",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Presentation Id",
          "type": "string"
        },
        "folder_id": {
          "description": "Folder driveItem ID; Get Drive Root Folder returns the root folder's actual ID.",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Folder Id",
          "type": "string"
        },
        "name": {
          "description": "Include the PowerPoint extension, such as Quarterly Review.pptx.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^/\\\\:*?\"<>|\\x00-\\x1f]+\\.(?i:pptx|ppt|ppsx|pps|potx|pot|pptm|ppsm|potm)$",
          "title": "Presentation filename",
          "type": "string"
        }
      },
      "required": [
        "drive_id",
        "presentation_id",
        "folder_id",
        "name"
      ],
      "title": "Copy Presentation from Template",
      "type": "object"
    },
