        },
        "chatId": {
          "description": "Chat ID in the neutral form the gateway returns, on either engine (e.g. 12025550101@c.us)",
          "maxLength": 255,
          "title": "Chatid",
          "type": "string"
        },
        "messageIds": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Specific message IDs to mark read. Baileys acknowledges individual messages, so without this only the newest received message the engine still holds in memory gets a receipt \u2014 a burst leaves its earlier messages unread forever, and a restarted session has no message to acknowledge at all. Callers that persist inbound message IDs should send them here. Ignored by whatsapp-web.js, whose own sendSeen is chat-level.",
