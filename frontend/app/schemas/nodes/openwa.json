    "OpenWAAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "openwa_api_key",
          "default": "openwa_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "server_url": {
          "description": "Public HTTPS origin of your OpenWA gateway, for example https://openwa.example.com.",
          "title": "Server URL",
          "type": "string"
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "server_url",
        "api_key"
      ],
      "title": "OpenWA API Key",
      "type": "object",
      "x-credential-instructions": "Enter your publicly reachable HTTPS OpenWA server origin and paste its API key. An operator key can send messages; a viewer key supports reads. NoClick lists the sessions visible to your key to check the connection. Use an already linked WhatsApp session.",
      "x-credential-url": "https://github.com/rmyndharis/OpenWA/blob/main/docs/06-api-specification.md"
    },
    "OpenWAArchiveChatConfig": {
      "additionalProperties": false,
