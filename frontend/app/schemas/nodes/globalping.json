{
  "$defs": {
    "Dns": {
      "additionalProperties": false,
      "description": "Create a DNS lookup measurement.",
      "properties": {
        "target": {
          "description": "Public hostname, IPv4 or IPv6 address, without a URL scheme or path.",
          "maxLength": 253,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Globalping magic location filter, for example Berlin+Germany or AS13335.",
          "title": "Location"
        },
        "reuse_measurement_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reuse the probes of an earlier measurement instead of a location filter.",
          "title": "Reuse Measurement Id"
        },
        "limit": {
          "default": 1,
          "description": "Maximum probes; each probe consumes a rate-limit point or credit.",
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "timeout": {
          "anyOf": [
            {
              "maximum": 30,
              "minimum": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Probe-side timeout in seconds.",
          "title": "Timeout"
        },
        "ip_version": {
          "default": 4,
          "enum": [
            4,
            6
          ],
          "title": "IP version",
          "type": "integer"
        },
        "query_type": {
          "default": "A",
          "enum": [
            "A",
            "AAAA",
            "ANY",
            "CNAME",
            "DNSKEY",
            "DS",
            "HTTPS",
            "MX",
            "NS",
            "NSEC",
            "PTR",
            "RRSIG",
            "SOA",
            "TXT",
            "SRV",
            "SVCB"
          ],
          "title": "Query Type",
          "type": "string"
        },
        "protocol": {
          "default": "UDP",
          "enum": [
            "TCP",
            "UDP"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "resolver": {
          "anyOf": [
            {
              "maxLength": 253,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom DNS resolver IP address.",
          "title": "Resolver"
        },
        "port": {
          "default": 53,
          "maximum": 65535,
          "minimum": 0,
          "title": "Port",
          "type": "integer"
        },
        "operation": {
          "const": "create_dns",
          "default": "create_dns",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "title": "Dns",
      "type": "object"
    },
