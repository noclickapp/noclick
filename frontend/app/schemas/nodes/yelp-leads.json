    "YelpLeadsOAuthCredential": {
      "properties": {
        "credential_type": {
          "const": "yelp_leads_oauth",
          "default": "yelp_leads_oauth",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "business_id": {
          "title": "Yelp business ID",
          "type": "string"
        },
        "access_token": {
          "title": "Access token",
          "type": "string",
          "ui:widget": "password"
        },
        "refresh_token": {
          "title": "Refresh token",
          "type": "string",
          "ui:widget": "password"
        },
        "expires_at": {
          "description": "ISO 8601 expiry including timezone.",
          "title": "Token expiry",
          "type": "string"
        }
      },
      "required": [
        "business_id",
        "access_token",
        "refresh_token",
        "expires_at"
      ],
      "title": "Yelp Leads OAuth",
      "type": "object",
      "x-credential-instructions": "Requires a Yelp-approved reseller partner OAuth application and an advertising business. Enter your Yelp business ID before signing in. For manual connection, paste existing OAuth access and refresh tokens, their ISO 8601 expiry, and the business ID. A Places API key does not grant Leads access.",
      "x-credential-type": "oauth",
      "x-credential-url": "https://docs.developer.yelp.com/docs/oauth-authorization",
      "x-oauth-provider": "yelp_leads",
      "x-oauth-scopes": [
        "leads"
      ]
    }
