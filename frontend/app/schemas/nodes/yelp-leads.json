    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/YelpLeadsOAuthCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Yelp-leads Node Configuration",
  "type": "object",
