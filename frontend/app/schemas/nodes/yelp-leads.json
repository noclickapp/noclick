          "$ref": "#/$defs/GetLead"
        },
        {
          "$ref": "#/$defs/GetLeadEvents"
        },
        {
          "$ref": "#/$defs/WriteLeadEvent"
        },
        {
          "$ref": "#/$defs/MarkLeadAsReplied"
        },
        {
          "$ref": "#/$defs/MarkLeadEventAsRead"
        },
        {
          "$ref": "#/$defs/ListLeadIds"
        },
        {
          "$ref": "#/$defs/GetOlderLeadEvents"
        },
        {
          "$ref": "#/$defs/GetNewerLeadEvents"
        },
        {
          "$ref": "#/$defs/MarkLeadRepliedByPhone"
        },
        {
          "$ref": "#/$defs/MarkLeadRepliedByEmail"
        }
      ],
