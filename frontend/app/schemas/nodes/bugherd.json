{
  "$defs": {
    "BugHerdApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "bugherd_api_key",
          "default": "bugherd_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "BugHerd API Key",
      "type": "object",
      "x-credential-instructions": "Use your existing organization API key from Settings > General. No password, OAuth app or key issuance is needed here.",
      "x-credential-url": "https://www.bugherd.com"
    },
    "GetColumn": {
      "properties": {
        "operation": {
          "const": "get_column",
          "default": "get_column",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "minimum": 1,
          "title": "Project",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "project_id",
            "placeholder": "Select a project",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "column_id": {
          "minimum": 1,
          "title": "Column Id",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "column_id"
      ],
      "title": "GetColumn",
      "type": "object"
    },
    "GetOrganization": {
      "properties": {
        "operation": {
          "const": "get_organization",
          "default": "get_organization",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetOrganization",
      "type": "object"
    },
    "GetProject": {
      "properties": {
        "operation": {
          "const": "get_project",
          "default": "get_project",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "minimum": 1,
          "title": "Project",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "project_id",
            "placeholder": "Select a project",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "project_id"
      ],
      "title": "GetProject",
      "type": "object"
    },
    "GetTask": {
      "properties": {
        "operation": {
          "const": "get_task",
          "default": "get_task",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "minimum": 1,
          "title": "Project",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "project_id",
            "placeholder": "Select a project",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "task_id": {
          "description": "Globally unique task ID, not the local task number.",
          "minimum": 1,
          "title": "Task",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "depends_on": "project_id",
            "field_name": "task_id",
            "searchable": true
          }
        }
      },
      "required": [
        "project_id",
        "task_id"
      ],
      "title": "GetTask",
      "type": "object"
    },
    "ListColumns": {
      "properties": {
        "operation": {
          "const": "list_columns",
          "default": "list_columns",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "minimum": 1,
          "title": "Project",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "project_id",
            "placeholder": "Select a project",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ListColumns",
      "type": "object"
    },
    "ListComments": {
      "properties": {
        "operation": {
          "const": "list_comments",
          "default": "list_comments",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "minimum": 1,
          "title": "Project",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "project_id",
            "placeholder": "Select a project",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "task_id": {
          "description": "Globally unique task ID, not the local task number.",
          "minimum": 1,
          "title": "Task",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "depends_on": "project_id",
            "field_name": "task_id",
            "searchable": true
          }
        }
      },
      "required": [
        "project_id",
        "task_id"
      ],
      "title": "ListComments",
      "type": "object"
    },
    "ListProjects": {
      "properties": {
        "operation": {
          "const": "list_projects",
          "default": "list_projects",
          "title": "Operation",
          "type": "string"
        },
        "active_only": {
          "default": false,
          "title": "Active Only",
          "type": "boolean"
        },
        "page": {
          "default": 1,
          "description": "One page of at most 100 records. Continue until an empty page.",
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "title": "ListProjects",
      "type": "object"
    },
    "ListTasks": {
      "properties": {
        "operation": {
          "const": "list_tasks",
          "default": "list_tasks",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "minimum": 1,
          "title": "Project",
          "type": "integer",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "project_id",
            "placeholder": "Select a project",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "view": {
          "default": "all",
          "enum": [
            "all",
            "feedback",
            "archive",
            "taskboard"
          ],
          "title": "View",
          "type": "string"
        },
        "page": {
          "default": 1,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "status": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Includes custom column names.",
          "title": "Status"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "not set",
                "critical",
                "important",
                "normal",
                "minor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority",
          "enum": [
            "not set",
            "critical",
            "important",
            "normal",
            "minor"
          ],
          "x-enum-searchable": true
        },
        "tag": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        },
        "assigned_to_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned To Id"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "created_since": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created Since"
        },
        "updated_since": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated Since"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ListTasks",
      "type": "object"
    },
    "ListUsers": {
      "properties": {
        "operation": {
          "const": "list_users",
          "default": "list_users",
          "title": "Operation",
          "type": "string"
        },
        "kind": {
          "default": "all",
          "enum": [
            "all",
            "members",
            "clients"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "default": 1,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "title": "ListUsers",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_column": "#/$defs/GetColumn",
          "get_organization": "#/$defs/GetOrganization",
          "get_project": "#/$defs/GetProject",
          "get_task": "#/$defs/GetTask",
          "list_columns": "#/$defs/ListColumns",
          "list_comments": "#/$defs/ListComments",
          "list_projects": "#/$defs/ListProjects",
          "list_tasks": "#/$defs/ListTasks",
          "list_users": "#/$defs/ListUsers"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetOrganization"
        },
        {
          "$ref": "#/$defs/ListProjects"
        },
        {
          "$ref": "#/$defs/GetProject"
        },
        {
          "$ref": "#/$defs/ListUsers"
        },
        {
          "$ref": "#/$defs/ListTasks"
        },
        {
          "$ref": "#/$defs/GetTask"
        },
        {
          "$ref": "#/$defs/ListComments"
        },
        {
          "$ref": "#/$defs/ListColumns"
        },
        {
          "$ref": "#/$defs/GetColumn"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/BugHerdApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Bugherd Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
