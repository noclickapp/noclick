{
  "$defs": {
    "SurfApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "surf_api_key",
          "default": "surf_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Surf API Key",
      "type": "object",
      "x-credential-instructions": "Generate an API key in the Surf Dashboard and paste it here without the Bearer prefix. The free credit balance read verifies the key. Data calls spend Surf credits; SQL job submission starts a query and cancellation may be pending.",
      "x-credential-url": "https://agents.asksurf.ai"
    },
    "SurfCancelSqlJobConfig": {
      "additionalProperties": false,
      "description": "Cancel Asynchronous Blockchain SQL Job",
      "properties": {
        "operation": {
          "const": "cancel_sql_job",
          "default": "cancel_sql_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "job_id": {
          "description": "Asynchronous SQL job identifier",
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "SurfCancelSqlJobConfig",
      "type": "object"
    },
    "SurfCreateSqlJobConfig": {
      "additionalProperties": false,
      "description": "Submit Asynchronous Blockchain SQL Job",
      "properties": {
        "operation": {
          "const": "create_sql_job",
          "default": "create_sql_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "Idempotency-Key": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable client-generated key. Reusing it returns the existing job without starting another query.",
          "title": "Idempotency-Key"
        },
        "max_rows": {
          "default": 1000,
          "description": "Maximum number of result rows to retain",
          "examples": [
            1000
          ],
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        },
        "sql": {
          "description": "Exact read-only ClickHouse SQL to execute asynchronously. The submitted SQL and date range are preserved.",
          "examples": [
            "SELECT block_date, project, symbol, apy FROM agent.ethereum_yields_daily WHERE block_date >= today() - 30 ORDER BY apy DESC"
          ],
          "minLength": 1,
          "title": "Sql",
          "type": "string"
        }
      },
      "required": [
        "sql"
      ],
      "title": "SurfCreateSqlJobConfig",
      "type": "object"
    },
    "SurfFetchWebPageConfig": {
      "additionalProperties": false,
      "description": "Web Page Fetch",
      "properties": {
        "operation": {
          "const": "fetch_web_page",
          "default": "fetch_web_page",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "url": {
          "description": "URL to fetch and parse",
          "examples": [
            "https://ethereum.org"
          ],
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "target_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CSS selector to extract specific content",
          "examples": [
            "article.main-content"
          ],
          "title": "Target Selector"
        },
        "remove_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CSS selector to remove unwanted elements",
          "examples": [
            "nav,footer,.ads"
          ],
          "title": "Remove Selector"
        },
        "wait_for_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CSS selector to wait for before extracting",
          "examples": [
            ".content-loaded"
          ],
          "title": "Wait For Selector"
        },
        "timeout": {
          "default": 30000,
          "description": "Request timeout in milliseconds",
          "examples": [
            5000
          ],
          "maximum": 60000,
          "minimum": 1000,
          "title": "Timeout",
          "type": "integer"
        }
      },
      "required": [
        "url"
      ],
      "title": "SurfFetchWebPageConfig",
      "type": "object"
    },
    "SurfGetCreditsConfig": {
      "additionalProperties": false,
      "description": "Credit Balance",
      "properties": {
        "operation": {
          "const": "get_credits",
          "default": "get_credits",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "SurfGetCreditsConfig",
      "type": "object"
    },
    "SurfGetDefiMetricsConfig": {
      "additionalProperties": false,
      "description": "Project DeFi Metrics",
      "properties": {
        "operation": {
          "const": "get_defi_metrics",
          "default": "get_defi_metrics",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Surf project UUID. PREFERRED \u2014 always use this when available from a previous response (e.g. project_id from /fund/portfolio or id from /search/project). Takes priority over q.",
          "examples": [
            "25c6612a-395c-4974-94eb-3b5f9f4b2ed7"
          ],
          "title": "Id"
        },
        "q": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fuzzy entity name search. Only use when 'id' is not available. May return unexpected results for ambiguous names.",
          "examples": [
            "uniswap"
          ],
          "title": "Q"
        },
        "metric": {
          "default": "tvl",
          "description": "Metric to query. Can be `volume`, `fees` (or `fee` alias), `revenue`, `tvl`, or `users`. Defaults to tvl.",
          "enum": [
            "volume",
            "fee",
            "fees",
            "revenue",
            "tvl",
            "users"
          ],
          "examples": [
            "tvl"
          ],
          "title": "Metric",
          "type": "string"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start of time range. Accepts Unix seconds (`1704067200`) or date string (`2024-01-01`)",
          "examples": [
            "2024-01-01"
          ],
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End of time range. Accepts Unix seconds (`1706745600`) or date string (`2024-02-01`)",
          "examples": [
            "2024-02-01"
          ],
          "title": "To"
        },
        "chain": {
          "anyOf": [
            {
              "enum": [
                "ethereum",
                "polygon",
                "bsc",
                "arbitrum",
                "optimism",
                "base",
                "avalanche",
                "fantom",
                "solana"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by chain. Can be `ethereum`, `polygon`, `bsc`, `arbitrum`, `optimism`, `base`, `avalanche`, `fantom`, or `solana`.",
          "examples": [
            "ethereum"
          ],
          "title": "Chain",
          "enum": [
            "ethereum",
            "polygon",
            "bsc",
            "arbitrum",
            "optimism",
            "base",
            "avalanche",
            "fantom",
            "solana"
          ],
          "x-enum-searchable": true
        },
        "limit": {
          "default": 20,
          "description": "Results per page",
          "examples": [
            20
          ],
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Pagination offset",
          "examples": [
            0
          ],
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "title": "SurfGetDefiMetricsConfig",
      "type": "object"
    },
    "SurfGetFearGreedConfig": {
      "additionalProperties": false,
      "description": "Fear & Greed Index History",
      "properties": {
        "operation": {
          "const": "get_fear_greed",
          "default": "get_fear_greed",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start of time range. Accepts Unix seconds or date string (YYYY-MM-DD)",
          "examples": [
            "2026-01-01"
          ],
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End of time range. Accepts Unix seconds or date string (YYYY-MM-DD)",
          "examples": [
            "2026-03-01"
          ],
          "title": "To"
        }
      },
      "title": "SurfGetFearGreedConfig",
      "type": "object"
    },
    "SurfGetGasPriceConfig": {
      "additionalProperties": false,
      "description": "Current Gas Price",
      "properties": {
        "operation": {
          "const": "get_gas_price",
          "default": "get_gas_price",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "chain": {
          "description": "Chain. Can be `ethereum`, `polygon`, `bsc`, `arbitrum`, `optimism`, `base`, `avalanche`, `fantom`, `linea`, or `cyber`.",
          "enum": [
            "ethereum",
            "polygon",
            "bsc",
            "arbitrum",
            "optimism",
            "base",
            "avalanche",
            "fantom",
            "linea",
            "cyber"
          ],
          "examples": [
            "ethereum"
          ],
          "minLength": 1,
          "title": "Chain",
          "type": "string"
        }
      },
      "required": [
        "chain"
      ],
      "title": "SurfGetGasPriceConfig",
      "type": "object"
    },
    "SurfGetNewsConfig": {
      "additionalProperties": false,
      "description": "News Article Detail",
      "properties": {
        "operation": {
          "const": "get_news",
          "default": "get_news",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "Article ID (returned as id in feed/search results)",
          "examples": [
            "e54e0ac4-1ef8-44d2-928e-52df465e2c81"
          ],
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "SurfGetNewsConfig",
      "type": "object"
    },
    "SurfGetPriceHistoryConfig": {
      "additionalProperties": false,
      "description": "Token Price History",
      "properties": {
        "operation": {
          "const": "get_price_history",
          "default": "get_price_history",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "symbol": {
          "description": "Single token ticker symbol like `BTC`, `ETH`, or `SOL` (multi-symbol not supported)",
          "examples": [
            "BTC"
          ],
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "time_range": {
          "default": "30d",
          "description": "Window of historical data to return: `1d`, `7d`, `14d`, `30d`, `90d`, `180d`, `365d`, or `max`. Ignored when `from`/`to` are set. This endpoint uses `time_range` only \u2014 it does NOT accept `interval`; bucket granularity is chosen server-side based on the window size.",
          "enum": [
            "1d",
            "7d",
            "14d",
            "30d",
            "90d",
            "180d",
            "365d",
            "max"
          ],
          "examples": [
            "30d"
          ],
          "title": "Time Range",
          "type": "string"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start of custom date range (Unix timestamp or YYYY-MM-DD). Must be used together with `to`. Overrides `time_range` when set.",
          "examples": [
            "2025-01-01"
          ],
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End of custom date range (Unix timestamp or YYYY-MM-DD). Must be used together with `from`. Overrides `time_range` when set.",
          "examples": [
            "2025-03-01"
          ],
          "title": "To"
        },
        "currency": {
          "default": "usd",
          "description": "Quote currency like `usd`, `eur`, or `btc`",
          "examples": [
            "usd"
          ],
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "SurfGetPriceHistoryConfig",
      "type": "object"
    },
    "SurfGetProjectConfig": {
      "additionalProperties": false,
      "description": "Aggregated Project Detail",
      "properties": {
        "operation": {
          "const": "get_project",
          "default": "get_project",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Surf project UUID. PREFERRED \u2014 always use this when available from a previous response (e.g. project_id from /fund/portfolio or id from /search/project). Takes priority over q.",
          "examples": [
            "25c6612a-395c-4974-94eb-3b5f9f4b2ed7"
          ],
          "title": "Id"
        },
        "x_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Numeric X (Twitter) account ID. Resolves to the associated project.",
          "examples": [
            "984188226826010624"
          ],
          "title": "X Id"
        },
        "handle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "X (Twitter) handle without @. Resolves to the associated project via twitter account lookup.",
          "examples": [
            "uniswap"
          ],
          "title": "Handle"
        },
        "q": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fuzzy entity name search. Only use when 'id' is not available. May return unexpected results for ambiguous names.",
          "examples": [
            "ethereum"
          ],
          "title": "Q"
        },
        "fields": {
          "default": "overview,token_info,tokenomics,funding,team,contracts,social,tge_status",
          "description": "Comma-separated sub-resources to include. Can be `overview`, `token_info`, `tokenomics`, `funding`, `team`, `contracts`, `social`, or `tge_status`.",
          "examples": [
            "overview,token_info,funding"
          ],
          "title": "Fields",
          "type": "string"
        }
      },
      "title": "SurfGetProjectConfig",
      "type": "object"
    },
    "SurfGetSqlJobConfig": {
      "additionalProperties": false,
      "description": "Get Asynchronous Blockchain SQL Job",
      "properties": {
        "operation": {
          "const": "get_sql_job",
          "default": "get_sql_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "job_id": {
          "description": "Asynchronous SQL job identifier",
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "SurfGetSqlJobConfig",
      "type": "object"
    },
    "SurfGetWalletConfig": {
      "additionalProperties": false,
      "description": "Aggregated Wallet Detail",
      "properties": {
        "operation": {
          "const": "get_wallet",
          "default": "get_wallet",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "address": {
          "description": "Wallet address (0x hex for EVM, base58 for Solana)",
          "examples": [
            "0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045"
          ],
          "minLength": 1,
          "title": "Address",
          "type": "string"
        },
        "chain": {
          "anyOf": [
            {
              "enum": [
                "ethereum",
                "polygon",
                "bsc",
                "arbitrum",
                "optimism",
                "base",
                "avalanche",
                "fantom",
                "solana"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chain filter for `tokens`, `nft`, and `approvals`. When omitted, inferred from address format: 0x addresses query all EVM chains, base58 addresses query Solana.",
          "examples": [
            "ethereum"
          ],
          "title": "Chain",
          "enum": [
            "ethereum",
            "polygon",
            "bsc",
            "arbitrum",
            "optimism",
            "base",
            "avalanche",
            "fantom",
            "solana"
          ],
          "x-enum-searchable": true
        },
        "fields": {
          "default": "balance,tokens,labels,nft",
          "description": "Comma-separated sub-resources to include. Valid: `balance`, `tokens`, `labels`, `nft`, `approvals`. The `active_chains` field is always returned. `approvals` is opt-in (not in default) as it triggers additional upstream calls.",
          "examples": [
            "balance,labels,approvals"
          ],
          "title": "Fields",
          "type": "string"
        }
      },
      "required": [
        "address"
      ],
      "title": "SurfGetWalletConfig",
      "type": "object"
    },
    "SurfListNewsConfig": {
      "additionalProperties": false,
      "description": "Crypto News Feed",
      "properties": {
        "operation": {
          "const": "list_news",
          "default": "list_news",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "coindesk",
                "cointelegraph",
                "theblock",
                "decrypt",
                "dlnews",
                "blockbeats",
                "bitcoincom",
                "coinpedia",
                "ambcrypto",
                "cryptodaily",
                "cryptopotato",
                "phemex",
                "panews",
                "odaily",
                "tradingview",
                "chaincatcher",
                "techflow"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by news source",
          "examples": [
            "coindesk"
          ],
          "title": "Source",
          "enum": [
            "coindesk",
            "cointelegraph",
            "theblock",
            "decrypt",
            "dlnews",
            "blockbeats",
            "bitcoincom",
            "coinpedia",
            "ambcrypto",
            "cryptodaily",
            "cryptopotato",
            "phemex",
            "panews",
            "odaily",
            "tradingview",
            "chaincatcher",
            "techflow"
          ],
          "x-enum-searchable": true
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated project names to filter by",
          "examples": [
            "bitcoin,ethereum"
          ],
          "title": "Project"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter articles published on or after this time. Accepts Unix seconds or date string (2024-01-01)",
          "examples": [
            "2024-01-01"
          ],
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter articles published on or before this time. Accepts Unix seconds or date string (2024-02-01)",
          "examples": [
            "2024-02-01"
          ],
          "title": "To"
        },
        "sort_by": {
          "default": "recency",
          "description": "Sort order: recency (newest first) or trending (deterministic newest-first alias until engagement ranking is available)",
          "enum": [
            "recency",
            "trending"
          ],
          "examples": [
            "recency"
          ],
          "title": "Sort By",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "description": "Results per page (max 50)",
          "examples": [
            20
          ],
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Pagination offset",
          "examples": [
            0
          ],
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "title": "SurfListNewsConfig",
      "type": "object"
    },
    "SurfListTokenHoldersConfig": {
      "additionalProperties": false,
      "description": "Token Holders",
      "properties": {
        "operation": {
          "const": "list_token_holders",
          "default": "list_token_holders",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "address": {
          "description": "Token CONTRACT ADDRESS \u2014 0x-prefixed hex for EVM chains, base58 for Solana. This is NOT a ticker symbol (e.g. do NOT pass `USDC` or `BTC`). To resolve a ticker symbol to a contract address, call GET /v1/search/token?q={symbol}&chain={chain} and use the `address` whose `chain` is supported by this endpoint. This endpoint has no `symbol` parameter.",
          "examples": [
            "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48"
          ],
          "minLength": 1,
          "title": "Address",
          "type": "string"
        },
        "chain": {
          "description": "Chain. Can be `ethereum`, `polygon`, `bsc`, `solana`, `avalanche`, `arbitrum`, `optimism`, or `base`.",
          "enum": [
            "ethereum",
            "polygon",
            "bsc",
            "solana",
            "avalanche",
            "arbitrum",
            "optimism",
            "base"
          ],
          "examples": [
            "ethereum"
          ],
