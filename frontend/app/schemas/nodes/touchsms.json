            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Group name. touchSMS creates the group if necessary.",
          "title": "Group"
        },
        "groups": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Group IDs to add this contact to.",
          "title": "Groups"
        },
        "metadata": {
