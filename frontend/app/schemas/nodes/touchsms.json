{
  "$defs": {
    "CreateContact": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "description": "Mobile number, preferably in E.164 format.",
          "maxLength": 20,
          "minLength": 5,
          "title": "Number",
          "type": "string"
        },
        "firstname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Firstname"
        },
        "surname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surname"
        },
        "email": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Group name. touchSMS creates the group if necessary.",
          "title": "Group"
        },
        "groups": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Group IDs to add this contact to.",
          "title": "Groups"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom fields already configured on the account.",
          "title": "Metadata"
        },
        "operation": {
          "const": "create_contact",
          "default": "create_contact",
          "title": "Operation",
          "type": "string"
        },
        "update_if_exists": {
          "default": false,
          "description": "Update a matching number instead of creating a duplicate.",
          "title": "Update If Exists",
          "type": "boolean"
        }
      },
      "required": [
        "number"
      ],
      "title": "CreateContact",
      "type": "object"
    },
    "CreateOptout": {
      "additionalProperties": false,
      "description": "Stop messages to a number; creates a named opt-out list if needed.",
