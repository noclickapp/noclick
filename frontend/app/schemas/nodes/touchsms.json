          "const": "create_optout",
          "default": "create_optout",
          "title": "Operation",
          "type": "string"
        },
        "number": {
          "minLength": 1,
          "title": "Number",
          "type": "string"
        }
      },
      "required": [
        "number"
      ],
      "title": "CreateOptout",
      "type": "object"
    },
    "CreateTemplate": {
      "additionalProperties": false,
      "properties": {
        "sender_id": {
          "description": "An allowed sender ID, such as SHARED_NUMBER.",
