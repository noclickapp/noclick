          "title": "Messages",
          "type": "array"
        },
        "reject_duplicates": {
          "default": false,
          "title": "Reject Duplicates",
          "type": "boolean"
        },
        "reject_duplicates_by_recipient": {
          "default": false,
          "title": "Reject Duplicates By Recipient",
          "type": "boolean"
        }
      },
      "required": [
        "messages"
