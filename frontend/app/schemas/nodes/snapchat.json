{
  "$defs": {
    "GetValidationLogs": {
      "additionalProperties": false,
      "description": "Read the asset's test event metadata from the last 24 hours.",
      "properties": {
        "operation": {
          "const": "get_validation_logs",
          "default": "get_validation_logs",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetValidationLogs",
      "type": "object"
    },
    "GetValidationStats": {
      "additionalProperties": false,
      "description": "Read live and test event counts and latest timestamps for this asset.",
