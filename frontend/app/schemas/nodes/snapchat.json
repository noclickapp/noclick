        "operation": {
          "const": "get_validation_stats",
          "default": "get_validation_stats",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetValidationStats",
      "type": "object"
    },
    "SendAddCart": {
      "additionalProperties": false,
      "description": "Report a website add-to-cart conversion.",
      "properties": {
        "event_time": {
          "description": "Unix timestamp in seconds or milliseconds of the real conversion, at most seven days old.",
          "exclusiveMinimum": 0,
          "title": "Event Time",
          "type": "integer"
        },
        "event_id": {
          "description": "Stable unique conversion ID. Reuse it when retrying and for Pixel deduplication.",
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_source_url": {
          "description": "HTTP(S) page URL where the web conversion happened.",
          "title": "Event Source Url",
          "type": "string"
        },
        "email_sha256": {
          "description": "SHA256 hex digest of the email after trimming and lowercasing. Never paste an unhashed email.",
          "title": "Email Sha256",
          "type": "string"
        },
        "sc_click_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional Snap click ID from the landing page.",
          "title": "Sc Click Id"
        },
        "sc_cookie1": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional _scid first-party cookie.",
          "title": "Sc Cookie1"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 4217 currency code; required for purchases.",
          "title": "Currency"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Conversion value; required for purchases.",
          "title": "Value"
        },
        "order_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Id"
        },
        "content_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Ids"
        },
        "search_string": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search String"
        },
        "operation": {
          "const": "send_add_cart",
          "default": "send_add_cart",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "event_time",
        "event_id",
        "event_source_url",
        "email_sha256"
      ],
      "title": "SendAddCart",
      "type": "object"
    },
