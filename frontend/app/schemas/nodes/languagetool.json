{
  "$defs": {
    "AddWordConfig": {
      "additionalProperties": false,
      "description": "Add a word; named dictionaries are created if needed (500-word limit).",
      "properties": {
        "word": {
          "description": "One word in your personal dictionary, not a phrase.",
          "minLength": 1,
          "title": "Word",
          "type": "string"
        },
        "dictionary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dictionary name; omit to use the default dictionary.",
          "title": "Dictionary"
        },
        "operation": {
          "const": "add_word",
          "default": "add_word",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "word"
      ],
      "title": "AddWordConfig",
      "type": "object"
    },
    "CheckTextConfig": {
      "additionalProperties": false,
      "description": "Find grammar, spelling and style issues, including markup-aware text.",
      "properties": {
        "operation": {
          "const": "check_text",
          "default": "check_text",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text to check. Supply either text or annotated data.",
          "title": "Text",
          "ui:widget": "textarea"
        },
        "data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Annotated JSON string, e.g. {\"annotation\":[{\"text\":\"A \"},{\"markup\":\"<b>\"},{\"text\":\"test\"},{\"markup\":\"</b>\"}]}. Markup is ignored.",
          "title": "Data"
        },
        "language": {
          "default": "auto",
          "description": "Language code, e.g. en-US, de-DE, fr, or auto. Specify a variant for spell checking.",
          "title": "Language",
          "type": "string"
        },
        "dicts": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated dictionary names; omit for the default dictionary.",
          "title": "Dicts"
        },
        "mother_tongue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Native language code for false-friend checks.",
          "title": "Mother Tongue"
        },
        "preferred_variants": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated variants for auto detection, e.g. en-GB,de-AT.",
          "title": "Preferred Variants"
        },
        "enabled_rules": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated rule IDs to enable.",
          "title": "Enabled Rules"
        },
        "disabled_rules": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated rule IDs to disable.",
          "title": "Disabled Rules"
        },
        "enabled_categories": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated category IDs to enable.",
          "title": "Enabled Categories"
        },
        "disabled_categories": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated category IDs to disable.",
          "title": "Disabled Categories"
        },
        "enabled_only": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run only the explicitly enabled rules/categories.",
          "title": "Enabled Only"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                "default",
                "picky"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Picky activates additional formal-writing checks.",
          "title": "Level",
          "enum": [
            "default",
            "picky"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "CheckTextConfig",
      "type": "object"
    },
    "DeleteWordConfig": {
      "additionalProperties": false,
      "description": "Remove a word; an emptied named dictionary is deleted by LanguageTool.",
      "properties": {
        "word": {
          "description": "One word in your personal dictionary, not a phrase.",
          "minLength": 1,
          "title": "Word",
          "type": "string"
        },
        "dictionary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dictionary name; omit to use the default dictionary.",
          "title": "Dictionary"
        },
        "operation": {
          "const": "delete_word",
          "default": "delete_word",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "word"
      ],
      "title": "DeleteWordConfig",
      "type": "object"
    },
    "LanguageToolAPIKey": {
      "properties": {
        "credential_type": {
          "const": "languagetool_api_key",
          "default": "languagetool_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "username": {
          "minLength": 1,
          "title": "Username / Email",
          "type": "string"
        },
        "api_key": {
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "username",
        "api_key"
      ],
      "title": "LanguageTool API Key",
      "type": "object",
      "x-credential-instructions": "Enter your LanguageTool username (email) and API key from Settings \u2192 Access tokens. Use an API plan that permits automation. NoClick reads your personal dictionary to verify the connection.",
      "x-credential-url": "https://languagetool.org/editor/settings/access-tokens"
    },
    "ListLanguagesConfig": {
      "additionalProperties": false,
      "description": "List supported languages and regional language codes.",
      "properties": {
        "operation": {
          "const": "list_languages",
          "default": "list_languages",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListLanguagesConfig",
      "type": "object"
    },
    "ListWordsConfig": {
      "additionalProperties": false,
      "description": "Read one page of words from your personal dictionaries.",
      "properties": {
        "operation": {
          "const": "list_words",
          "default": "list_words",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "offset": {
          "default": 0,
          "description": "Zero-based offset; increment by the returned word count for the next page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 10,
          "description": "Maximum words to return in this page.",
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "dicts": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated dictionaries; omit for the default dictionary.",
          "title": "Dicts"
        }
      },
      "title": "ListWordsConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_word": "#/$defs/AddWordConfig",
          "check_text": "#/$defs/CheckTextConfig",
          "delete_word": "#/$defs/DeleteWordConfig",
          "list_languages": "#/$defs/ListLanguagesConfig",
          "list_words": "#/$defs/ListWordsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CheckTextConfig"
        },
        {
          "$ref": "#/$defs/ListLanguagesConfig"
        },
        {
          "$ref": "#/$defs/ListWordsConfig"
        },
        {
          "$ref": "#/$defs/AddWordConfig"
        },
        {
          "$ref": "#/$defs/DeleteWordConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/LanguageToolAPIKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Languagetool Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
