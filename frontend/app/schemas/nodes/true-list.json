{
  "$defs": {
    "CheckEmail": {
      "additionalProperties": false,
      "properties": {
        "validation_strategy": {
          "default": "accurate",
          "enum": [
            "accurate",
            "fast",
            "thorough",
            "enhanced"
          ],
          "title": "Validation Strategy",
          "type": "string"
        },
        "timeout": {
          "default": 30,
          "description": "Seconds per address; timed-out results are unknown and not billed.",
          "maximum": 30,
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        },
        "operation": {
          "const": "check_email",
          "default": "check_email",
          "description": "Fast syntax, MX, disposable and role checks; does not confirm mailbox deliverability.",
          "title": "Check Email Without SMTP",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "description": "One email address to verify.",
          "minLength": 1,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "CheckEmail",
      "type": "object"
    },
    "CreateBatch": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_batch",
          "default": "create_batch",
          "description": "Upload CSV rows for background verification. Poll Get Batch or supply a completion webhook. May consume verification credits.",
          "title": "Create Verification Batch",
          "type": "string",
          "ui:hidden": true
        },
        "rows": {
          "description": "At least two rows, each containing an email address; optional extra columns are preserved in annotated results.",
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "minItems": 2,
          "title": "Rows",
          "type": "array"
        },
        "filename": {
          "default": "truelist.csv",
          "description": "CSV filename, used as the batch name.",
          "title": "Filename",
          "type": "string"
        },
        "uuid": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional caller-assigned batch UUID.",
          "title": "Uuid"
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True List sends a completion POST with batch_id to this URL.",
          "title": "Webhook Url"
        },
        "validation_strategy": {
          "default": "accurate",
          "enum": [
            "accurate",
            "fast"
          ],
          "title": "Validation Strategy",
          "type": "string"
        }
      },
      "required": [
        "rows"
      ],
      "title": "CreateBatch",
      "type": "object"
    },
    "DeleteBatch": {
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "description": "Batch UUID returned by Create Batch or List Batches.",
          "format": "uuid",
          "title": "Uuid",
          "type": "string"
        },
        "operation": {
          "const": "delete_batch",
          "default": "delete_batch",
          "description": "Delete a completed batch; the API rejects unfinished batches.",
          "title": "Delete Batch",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "uuid"
      ],
      "title": "DeleteBatch",
      "type": "object"
    },
    "GetAccount": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_account",
          "default": "get_account",
          "title": "Get Account",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetAccount",
      "type": "object"
    },
    "GetBatch": {
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "description": "Batch UUID returned by Create Batch or List Batches.",
          "format": "uuid",
          "title": "Uuid",
          "type": "string"
        },
        "operation": {
          "const": "get_batch",
          "default": "get_batch",
          "description": "Read progress, counts and CSV result URLs. Counts are final only when completed.",
          "title": "Get Batch",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "uuid"
      ],
      "title": "GetBatch",
      "type": "object"
    },
    "GetResult": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_result",
          "default": "get_result",
          "title": "Get Email Result",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "Stored result ID returned by verification or List Email Results.",
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetResult",
      "type": "object"
    },
    "ListBatches": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_batches",
          "default": "list_batches",
          "title": "List Batches",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListBatches",
      "type": "object"
    },
    "ListResults": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_results",
          "default": "list_results",
          "title": "List Email Results",
          "type": "string",
          "ui:hidden": true
        },
        "batch_uuid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Batch UUID; use none for results outside any batch.",
          "title": "Batch Uuid"
        },
        "email_state": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "risky",
                "invalid",
                "email_invalid",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email State",
          "enum": [
            "ok",
            "risky",
            "invalid",
            "email_invalid",
            "unknown"
          ],
          "x-enum-searchable": true
        },
        "email_sub_state": {
          "anyOf": [
            {
              "enum": [
                "email_ok",
                "accept_all",
                "is_disposable",
                "is_role",
                "failed_mx_check",
                "failed_smtp_check",
                "failed_no_mailbox",
                "failed_greylisted",
                "failed_syntax_check",
                "unknown_error",
                "timed_out"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email Sub State",
          "enum": [
            "email_ok",
            "accept_all",
            "is_disposable",
            "is_role",
            "failed_mx_check",
            "failed_smtp_check",
            "failed_no_mailbox",
            "failed_greylisted",
            "failed_syntax_check",
            "unknown_error",
            "timed_out"
          ],
          "x-enum-searchable": true
        },
        "email_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return addresses starting with this value.",
          "title": "Email Address"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "per_page": {
          "default": 10,
          "description": "One page per execution; increment page to fetch subsequent results.",
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        }
      },
      "title": "ListResults",
      "type": "object"
    },
    "TrueListAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "true_list_api_token",
          "default": "true_list_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "True List API Token",
      "type": "object",
      "x-credential-instructions": "Generate an API key in True List account settings, then paste it here without the Bearer prefix. NoClick reads your account to check the connection without verifying emails.",
      "x-credential-url": "https://app.truelist.io/settings/api-keys"
    },
    "TrueListMcpCredential": {
      "description": "Truelist connected through Truelist's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "true_list_mcp",
          "default": "true_list_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "Truelist MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://api.truelist.io/mcp",
      "x-mcp-transport": "shttp"
    },
    "VerifyEmail": {
      "additionalProperties": false,
      "properties": {
        "validation_strategy": {
          "default": "accurate",
          "enum": [
            "accurate",
            "fast",
            "thorough",
            "enhanced"
          ],
          "title": "Validation Strategy",
          "type": "string"
        },
        "timeout": {
          "default": 30,
          "description": "Seconds per address; timed-out results are unknown and not billed.",
          "maximum": 30,
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        },
        "operation": {
          "const": "verify_email",
          "default": "verify_email",
          "description": "Run complete verification, including SMTP. May consume verification credits.",
          "title": "Verify Email",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "description": "One email address to verify.",
          "minLength": 1,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "VerifyEmail",
      "type": "object"
    },
    "VerifyEmails": {
      "additionalProperties": false,
      "properties": {
        "validation_strategy": {
          "default": "accurate",
          "enum": [
            "accurate",
            "fast",
            "thorough",
            "enhanced"
          ],
          "title": "Validation Strategy",
          "type": "string"
        },
        "timeout": {
          "default": 30,
          "description": "Seconds per address; timed-out results are unknown and not billed.",
          "maximum": 30,
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        },
        "operation": {
          "const": "verify_emails",
          "default": "verify_emails",
          "description": "Verify two or three addresses in one request, including SMTP. May consume verification credits.",
          "title": "Verify Up to Three Emails",
          "type": "string",
          "ui:hidden": true
        },
        "emails": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Emails",
          "type": "array"
        }
      },
      "required": [
        "emails"
      ],
      "title": "VerifyEmails",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_email": "#/$defs/CheckEmail",
          "create_batch": "#/$defs/CreateBatch",
          "delete_batch": "#/$defs/DeleteBatch",
          "get_account": "#/$defs/GetAccount",
          "get_batch": "#/$defs/GetBatch",
          "get_result": "#/$defs/GetResult",
          "list_batches": "#/$defs/ListBatches",
          "list_results": "#/$defs/ListResults",
          "verify_email": "#/$defs/VerifyEmail",
          "verify_emails": "#/$defs/VerifyEmails"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetAccount"
        },
        {
          "$ref": "#/$defs/VerifyEmail"
        },
        {
          "$ref": "#/$defs/VerifyEmails"
        },
        {
          "$ref": "#/$defs/CheckEmail"
        },
        {
          "$ref": "#/$defs/CreateBatch"
        },
        {
          "$ref": "#/$defs/ListBatches"
        },
        {
          "$ref": "#/$defs/GetBatch"
        },
        {
          "$ref": "#/$defs/DeleteBatch"
        },
        {
          "$ref": "#/$defs/ListResults"
        },
        {
          "$ref": "#/$defs/GetResult"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrueListAPITokenCredential"
        },
        {
          "$ref": "#/$defs/TrueListMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "True-list Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
