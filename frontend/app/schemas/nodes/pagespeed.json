          "description": "Crawler profile to emulate",
          "enum": [
            "DESKTOP",
            "MOBILE"
          ],
          "enumNames": [
            "Desktop",
            "Mobile"
          ],
          "title": "Strategy",
          "x-enum-searchable": true
        }
      },
      "required": [
        "page_url",
        "audit_id"
      ],
      "title": "PageSpeedGetAuditConfig",
      "type": "object"
    },
