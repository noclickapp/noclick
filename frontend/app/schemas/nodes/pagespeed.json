  "description": "Full configuration for the Google PageSpeed node including credentials.",
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "accessibility_score": "#/$defs/PageSpeedAccessibilityScoreConfig",
          "all_categories": "#/$defs/PageSpeedAllCategoriesConfig",
          "analyze_desktop": "#/$defs/PageSpeedAnalyzeDesktopConfig",
          "analyze_mobile": "#/$defs/PageSpeedAnalyzeMobileConfig",
          "best_practices_score": "#/$defs/PageSpeedBestPracticesScoreConfig",
          "core_web_vitals": "#/$defs/PageSpeedCoreWebVitalsConfig",
          "get_audit": "#/$defs/PageSpeedGetAuditConfig",
          "get_opportunities": "#/$defs/PageSpeedOpportunitiesConfig",
          "get_screenshot": "#/$defs/PageSpeedScreenshotConfig",
          "lab_metrics": "#/$defs/PageSpeedLabMetricsConfig",
          "localized_report": "#/$defs/PageSpeedLocalizedReportConfig",
          "origin_core_web_vitals": "#/$defs/PageSpeedOriginCoreWebVitalsConfig",
          "performance_score": "#/$defs/PageSpeedPerformanceScoreConfig",
          "run_analysis": "#/$defs/PageSpeedRunAnalysisConfig",
          "seo_score": "#/$defs/PageSpeedSeoScoreConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PageSpeedRunAnalysisConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedAnalyzeMobileConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedAnalyzeDesktopConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedPerformanceScoreConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedAccessibilityScoreConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedSeoScoreConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedBestPracticesScoreConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedAllCategoriesConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedCoreWebVitalsConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedOriginCoreWebVitalsConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedLabMetricsConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedGetAuditConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedOpportunitiesConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedScreenshotConfig"
        },
        {
          "$ref": "#/$defs/PageSpeedLocalizedReportConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageSpeedApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Pagespeed Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "Run a full PageSpeed analysis for my landing page",
    "Get the mobile performance score for a URL",
    "Extract Core Web Vitals field data for a page",
    "List the top performance opportunities for a page",
    "Get all four Lighthouse category scores in one call"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}