{
  "$defs": {
    "CheckPolicyHealth": {
      "additionalProperties": false,
      "description": "Check the policy configuration of an explicit project.",
      "properties": {
        "operation": {
          "const": "check_policy_health",
          "default": "check_policy_health",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "description": "Project ID required by the published request schema.",
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "CheckPolicyHealth",
      "type": "object"
    },
    "FunctionCall": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "description": "JSON-encoded function arguments, as returned by the LLM.",
          "title": "Arguments",
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "FunctionCall",
      "type": "object"
    },
    "GetDetectionResults": {
      "additionalProperties": false,
      "description": "Analyze historic content and calibrate detectors without screening logs.\n\nThis endpoint does not make a flagging decision. Do not use its results\nfor runtime security decisions; use Screen Content for runtime screening.",
      "properties": {
        "messages": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Message"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original LLM conversation. Provide messages, tools, or both.",
          "title": "Messages"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ToolDefinition"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OpenAI-format function definitions to screen, with or without messages.",
          "title": "Tools"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Project whose policy to apply; omit to use the default policy.",
          "title": "Project Id"
        },
        "conversation_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:@;=-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional user/session tags attached to this request.",
          "title": "Metadata"
        },
        "dev_info": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dev Info"
        },
        "operation": {
          "const": "get_detection_results",
          "default": "get_detection_results",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetDetectionResults",
      "type": "object"
    },
    "LakeraGuardApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "lakera_guard_api_key",
          "default": "lakera_guard_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_base_url": {
          "default": "https://api.lakera.ai",
          "description": "Use the documented API region associated with your key.",
          "enum": [
            "https://api.lakera.ai",
            "https://eu.api.lakera.ai",
            "https://us.api.lakera.ai",
            "https://ap-southeast-1.api.lakera.ai"
          ],
          "title": "API Region",
          "type": "string"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Lakera Guard API Key",
      "type": "object",
      "x-credential-instructions": "Create an API key in the Lakera Guard dashboard and paste it here without the Bearer prefix. Choose the region for that key. The connection check calls the published policy-lint endpoint and proves key reachability, not account identity or screening permissions.",
      "x-credential-url": "https://platform.lakera.ai/"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool",
            "developer"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/TextPart"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ToolCall"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        }
      },
      "required": [
        "role"
      ],
      "title": "Message",
      "type": "object"
    },
    "ScreenContent": {
      "additionalProperties": false,
      "description": "Screen an LLM interaction using the project's runtime Guard policy.\n\nGuard can create screening logs. In detect mode flagged is always false;\nuse the returned action and breakdown when interpreting results.",
      "properties": {
        "messages": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Message"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original LLM conversation. Provide messages, tools, or both.",
          "title": "Messages"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ToolDefinition"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OpenAI-format function definitions to screen, with or without messages.",
          "title": "Tools"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Project whose policy to apply; omit to use the default policy.",
          "title": "Project Id"
        },
        "conversation_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:@;=-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional user/session tags attached to this request.",
          "title": "Metadata"
        },
        "dev_info": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dev Info"
        },
        "operation": {
          "const": "screen_content",
          "default": "screen_content",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Include PII, profanity and regex match locations.",
          "title": "Payload"
        },
        "breakdown": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Include individual detector decisions and confidence levels.",
          "title": "Breakdown"
        }
      },
      "title": "ScreenContent",
      "type": "object"
    },
    "TextPart": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextPart",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "function": {
          "$ref": "#/$defs/FunctionCall"
        },
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "function",
        "id"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolDefinition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        },
        "function": {
          "$ref": "#/$defs/ToolFunction"
        }
      },
      "required": [
        "function"
      ],
      "title": "ToolDefinition",
      "type": "object"
    },
    "ToolFunction": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters"
        },
        "strict": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strict"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolFunction",
      "type": "object"
    },
    "ValidatePolicy": {
      "additionalProperties": false,
      "description": "Call the published policy-lint endpoint with no request body.\n\nThe provider publishes no policy-input schema for this endpoint. For an\narbitrary policy file, use the dashboard's policy-linter editor instead.",
      "properties": {
        "operation": {
          "const": "validate_policy",
          "default": "validate_policy",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ValidatePolicy",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_policy_health": "#/$defs/CheckPolicyHealth",
          "get_detection_results": "#/$defs/GetDetectionResults",
          "screen_content": "#/$defs/ScreenContent",
          "validate_policy": "#/$defs/ValidatePolicy"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ScreenContent"
        },
        {
          "$ref": "#/$defs/GetDetectionResults"
        },
        {
          "$ref": "#/$defs/CheckPolicyHealth"
        },
        {
          "$ref": "#/$defs/ValidatePolicy"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/LakeraGuardApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Lakera-guard Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
