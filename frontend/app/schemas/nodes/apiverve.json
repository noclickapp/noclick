{
  "$defs": {
    "ApiverveAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "apiverve_api_key",
          "default": "apiverve_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Apiverve API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Apiverve API key from the dashboard. The connection check reads the USD currency symbol and confirms key acceptance, not account identity. Calls consume provider credits.",
      "x-credential-url": "https://dashboard.apiverve.com"
    },
    "ApiverveCaptureScreenshotConfig": {
      "description": "Capture screenshot. Provider reference: https://docs.apiverve.com/ref/webscreenshots.",
      "properties": {
        "operation": {
          "const": "capture_screenshot",
          "default": "capture_screenshot",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "ApiverveCaptureScreenshotConfig",
      "type": "object"
    },
    "ApiverveCheckDisposableEmailConfig": {
      "description": "Check disposable email. Provider reference: https://docs.apiverve.com/ref/emaildisposablechecker.",
      "properties": {
        "operation": {
          "const": "check_disposable_email",
          "default": "check_disposable_email",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "ApiverveCheckDisposableEmailConfig",
      "type": "object"
    },
    "ApiverveCheckDomainAvailabilityConfig": {
      "description": "Check domain availability. Provider reference: https://docs.apiverve.com/ref/domainavailability.",
      "properties": {
        "operation": {
          "const": "check_domain_availability",
          "default": "check_domain_availability",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        }
      },
      "required": [
        "domain"
      ],
      "title": "ApiverveCheckDomainAvailabilityConfig",
      "type": "object"
    },
    "ApiverveConvertCurrencyConfig": {
      "description": "Convert currency. Provider reference: https://docs.apiverve.com/ref/currencyconverter.",
      "properties": {
        "operation": {
          "const": "convert_currency",
          "default": "convert_currency",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "from_currency": {
          "minLength": 1,
          "title": "From Currency",
          "type": "string"
        },
        "to": {
          "minLength": 1,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "value",
        "from_currency",
        "to"
      ],
      "title": "ApiverveConvertCurrencyConfig",
      "type": "object"
    },
    "ApiverveConvertMarkdownConfig": {
      "description": "Convert markdown. Provider reference: https://docs.apiverve.com/ref/markdowntohtml.",
      "properties": {
        "operation": {
          "const": "convert_markdown",
          "default": "convert_markdown",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "markdown": {
          "minLength": 1,
          "title": "Markdown",
          "type": "string"
        }
      },
      "required": [
        "markdown"
      ],
      "title": "ApiverveConvertMarkdownConfig",
      "type": "object"
    },
    "ApiverveGenerateImageConfig": {
      "description": "Generate image. Provider reference: https://docs.apiverve.com/ref/htmltoimage.",
      "properties": {
        "operation": {
          "const": "generate_image",
          "default": "generate_image",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "html": {
          "minLength": 1,
          "title": "Html",
          "type": "string"
        }
      },
      "required": [
        "html"
      ],
      "title": "ApiverveGenerateImageConfig",
      "type": "object"
    },
    "ApiverveGeneratePdfConfig": {
      "description": "Generate pdf. Provider reference: https://docs.apiverve.com/ref/htmltopdf.",
      "properties": {
        "operation": {
          "const": "generate_pdf",
          "default": "generate_pdf",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "html": {
          "minLength": 1,
          "title": "Html",
          "type": "string"
        }
      },
      "required": [
        "html"
      ],
      "title": "ApiverveGeneratePdfConfig",
      "type": "object"
    },
    "ApiverveGenerateQrCodeConfig": {
      "description": "Generate qr code. Provider reference: https://docs.apiverve.com/ref/qrcodegenerator.",
      "properties": {
        "operation": {
          "const": "generate_qr_code",
          "default": "generate_qr_code",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ApiverveGenerateQrCodeConfig",
      "type": "object"
    },
    "ApiverveGetDomainExpirationConfig": {
      "description": "Get domain expiration. Provider reference: https://docs.apiverve.com/ref/domainexpiration.",
      "properties": {
        "operation": {
          "const": "get_domain_expiration",
          "default": "get_domain_expiration",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        }
      },
      "required": [
        "domain"
      ],
      "title": "ApiverveGetDomainExpirationConfig",
      "type": "object"
    },
    "ApiverveGetWeatherConfig": {
      "description": "Get weather. Provider reference: https://docs.apiverve.com/ref/weatherforecast.",
      "properties": {
        "operation": {
          "const": "get_weather",
          "default": "get_weather",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "city": {
          "minLength": 1,
          "title": "City",
          "type": "string"
        }
      },
      "required": [
        "city"
      ],
      "title": "ApiverveGetWeatherConfig",
      "type": "object"
    },
    "ApiverveListCurrencySymbolsConfig": {
      "description": "List currency symbols. Provider reference: https://docs.apiverve.com/ref/currencysymbols.",
      "properties": {
        "operation": {
          "const": "list_currency_symbols",
          "default": "list_currency_symbols",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        }
      },
      "title": "ApiverveListCurrencySymbolsConfig",
      "type": "object"
    },
    "ApiverveLookupIpConfig": {
      "description": "Lookup ip. Provider reference: https://docs.apiverve.com/ref/iplookup.",
      "properties": {
        "operation": {
          "const": "lookup_ip",
          "default": "lookup_ip",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "ip": {
          "minLength": 1,
          "title": "Ip",
          "type": "string"
        }
      },
      "required": [
        "ip"
      ],
      "title": "ApiverveLookupIpConfig",
      "type": "object"
    },
    "ApiverveMcpCredential": {
      "description": "APIVerve connected through APIVerve's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "apiverve_mcp",
          "default": "apiverve_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "APIVerve MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://api.apiverve.com/v1/mcp",
      "x-mcp-transport": "shttp"
    },
    "ApiverveUnshortenUrlConfig": {
      "description": "Unshorten url. Provider reference: https://docs.apiverve.com/ref/urlunshortener.",
      "properties": {
        "operation": {
          "const": "unshorten_url",
          "default": "unshorten_url",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "ApiverveUnshortenUrlConfig",
      "type": "object"
    },
    "ApiverveValidateEmailConfig": {
      "description": "Validate email. Provider reference: https://docs.apiverve.com/ref/emailvalidator.",
      "properties": {
        "operation": {
          "const": "validate_email",
          "default": "validate_email",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "ApiverveValidateEmailConfig",
      "type": "object"
    },
    "ApiverveValidatePhoneConfig": {
      "description": "Validate phone. Provider reference: https://docs.apiverve.com/ref/phonenumbervalidator.",
      "properties": {
        "operation": {
          "const": "validate_phone",
          "default": "validate_phone",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "number": {
          "minLength": 1,
          "title": "Number",
          "type": "string"
        },
        "country": {
          "minLength": 1,
          "title": "Country",
          "type": "string"
        }
      },
      "required": [
        "number",
        "country"
      ],
      "title": "ApiverveValidatePhoneConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "capture_screenshot": "#/$defs/ApiverveCaptureScreenshotConfig",
          "check_disposable_email": "#/$defs/ApiverveCheckDisposableEmailConfig",
          "check_domain_availability": "#/$defs/ApiverveCheckDomainAvailabilityConfig",
          "convert_currency": "#/$defs/ApiverveConvertCurrencyConfig",
          "convert_markdown": "#/$defs/ApiverveConvertMarkdownConfig",
          "generate_image": "#/$defs/ApiverveGenerateImageConfig",
          "generate_pdf": "#/$defs/ApiverveGeneratePdfConfig",
          "generate_qr_code": "#/$defs/ApiverveGenerateQrCodeConfig",
          "get_domain_expiration": "#/$defs/ApiverveGetDomainExpirationConfig",
          "get_weather": "#/$defs/ApiverveGetWeatherConfig",
          "list_currency_symbols": "#/$defs/ApiverveListCurrencySymbolsConfig",
          "lookup_ip": "#/$defs/ApiverveLookupIpConfig",
          "unshorten_url": "#/$defs/ApiverveUnshortenUrlConfig",
          "validate_email": "#/$defs/ApiverveValidateEmailConfig",
          "validate_phone": "#/$defs/ApiverveValidatePhoneConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ApiverveValidateEmailConfig"
        },
        {
          "$ref": "#/$defs/ApiverveCheckDisposableEmailConfig"
        },
        {
          "$ref": "#/$defs/ApiverveValidatePhoneConfig"
        },
        {
          "$ref": "#/$defs/ApiverveLookupIpConfig"
        },
        {
          "$ref": "#/$defs/ApiverveCheckDomainAvailabilityConfig"
        },
        {
          "$ref": "#/$defs/ApiverveGetDomainExpirationConfig"
        },
        {
          "$ref": "#/$defs/ApiverveConvertCurrencyConfig"
        },
        {
          "$ref": "#/$defs/ApiverveGetWeatherConfig"
        },
        {
          "$ref": "#/$defs/ApiverveGenerateQrCodeConfig"
        },
        {
          "$ref": "#/$defs/ApiverveGeneratePdfConfig"
        },
        {
          "$ref": "#/$defs/ApiverveGenerateImageConfig"
        },
        {
          "$ref": "#/$defs/ApiverveCaptureScreenshotConfig"
        },
        {
          "$ref": "#/$defs/ApiverveUnshortenUrlConfig"
        },
        {
          "$ref": "#/$defs/ApiverveConvertMarkdownConfig"
        },
        {
          "$ref": "#/$defs/ApiverveListCurrencySymbolsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApiverveAPIKeyCredential"
        },
        {
          "$ref": "#/$defs/ApiverveMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "Apiverve Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
