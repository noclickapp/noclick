          "title": "Include Domain and Link Names",
          "type": "boolean"
        },
        "domain_page": {
          "default": 1,
          "description": "First documented page is1; local default1 and maximum10000. OAS does not declare a page default or coherent minimum. One bounded page; completion remains unknown.",
          "maximum": 10000,
          "minimum": 1,
          "title": "Domain Catalog Page",
          "type": "integer"
        },
        "domain_page_size": {
          "default": 50,
          "description": "Documented default/max50; local minimum1.",
          "maximum": 50,
          "minimum": 1,
          "title": "Domain Page Size",
          "type": "integer"
        },
        "domain_id": {
          "title": "Current Domain ID",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "auto_select_sole_option": false,
            "depends_on": [
              "domain_page",
              "domain_page_size",
              "include_names"
            ],
            "field_name": "domain_id"
          },
          "x-resource-type": "domain_id"
        },
