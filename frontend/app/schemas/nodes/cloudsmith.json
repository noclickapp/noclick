{
  "$defs": {
    "CloudsmithApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "cloudsmith_api_key",
          "default": "cloudsmith_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Cloudsmith API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Cloudsmith API key from your account settings. Your account needs the repository privileges for the operations you run. NoClick sends it in X-Api-Key to api.cloudsmith.io.",
      "x-credential-url": "https://docs.cloudsmith.com/accounts-and-teams/api-key"
    },
    "CopyPackage": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "description": "Cloudsmith workspace slug.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[-a-zA-Z0-9_]+$",
          "title": "Workspace",
          "type": "string"
        },
        "repo": {
          "description": "Repository slug, without the workspace.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[-a-zA-Z0-9_]+$",
          "title": "Repository",
          "type": "string"
        },
        "identifier": {
          "description": "Package or entitlement slug / permanent identifier.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[-a-zA-Z0-9_]+$",
          "title": "Resource Identifier",
          "type": "string"
        },
        "operation": {
          "const": "copy_package",
          "default": "copy_package",
          "title": "Copy Package",
          "type": "string",
          "ui:hidden": true
        },
        "destination": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[-a-zA-Z0-9_]+$",
          "title": "Destination Repository",
          "type": "string"
        },
        "republish": {
          "default": false,
          "description": "Overwrite matching destination packages when true.",
          "title": "Republish",
          "type": "boolean"
        }
      },
      "required": [
        "owner",
        "repo",
        "identifier",
        "destination"
      ],
      "title": "CopyPackage",
      "type": "object"
    },
    "CreateRepository": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "description": "Cloudsmith workspace slug.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[-a-zA-Z0-9_]+$",
          "title": "Workspace",
          "type": "string"
        },
        "operation": {
          "const": "create_repository",
          "default": "create_repository",
          "title": "Create Repository",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 50,
          "minLength": 1,
          "pattern": "^\\w[\\w \\-\\'\\.\\/()]+$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "slug": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[-a-zA-Z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slug"
        },
        "repository_type_str": {
          "default": "Private",
          "enum": [
            "Private",
            "Public",
            "Open-Source"
          ],
          "title": "Repository Visibility",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "name"
      ],
      "title": "CreateRepository",
      "type": "object"
    },
