{
  "$defs": {
    "GenderapiIoAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "genderapi_io_api_key",
          "default": "genderapi_io_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "GenderAPI.io API Key",
      "type": "object",
      "x-credential-instructions": "Paste your existing GenderAPI.io API key. V1 and V2 share the same credits. NoClick checks the free usage endpoint and requires API-key access: an invalid key can otherwise fall back to the IP trial. Predictions cost credits, including unknown results and repeated requests.",
      "x-credential-url": "https://app.genderapi.io/"
    },
    "GetCapabilities": {
      "additionalProperties": false,
      "description": "Read public capabilities and current limits, free of charge.",
      "properties": {
        "operation": {
          "const": "get_capabilities",
          "default": "get_capabilities",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetCapabilities",
      "type": "object"
    },
    "GetErrorCatalog": {
      "additionalProperties": false,
      "description": "Read public machine-readable error and recovery guidance.",
      "properties": {
        "operation": {
          "const": "get_error_catalog",
          "default": "get_error_catalog",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetErrorCatalog",
      "type": "object"
    },
    "GetOpenapi": {
      "additionalProperties": false,
      "description": "Read the provider's current published OpenAPI contract.",
      "properties": {
        "operation": {
          "const": "get_openapi",
          "default": "get_openapi",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetOpenapi",
      "type": "object"
    },
    "GetUsage": {
      "additionalProperties": false,
      "description": "Read account or trial credits without spending credits; reports access mode.",
      "properties": {
        "operation": {
          "const": "get_usage",
          "default": "get_usage",
          "title": "Operation",
          "type": "string"
        },
        "verify_api_key": {
          "default": false,
          "description": "Require account-key access; IP-trial fallback is rejected. Used automatically when connecting.",
          "title": "Verify Api Key",
          "type": "boolean"
        }
      },
      "title": "GetUsage",
      "type": "object"
    },
    "PredictBatch": {
      "additionalProperties": false,
      "description": "Submit 1\u201350 mixed inputs; preserve ordered successes, unknowns and item errors.",
      "properties": {
        "operation": {
          "const": "predict_batch",
          "default": "predict_batch",
          "title": "Operation",
          "type": "string"
        },
        "items": {
          "description": "Batch defaults to dataset only. Every retry is a new billable operation.",
          "items": {
            "$ref": "#/$defs/PredictionItem"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "PredictBatch",
      "type": "object"
    },
    "PredictEmail": {
      "additionalProperties": false,
      "description": "Estimate gender from a name signal in an email address (billable).",
      "properties": {
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional uppercase ISO 3166-1 alpha-2 country code.",
          "title": "Country"
        },
        "type": {
          "const": "email",
          "default": "email",
          "title": "Type",
          "type": "string",
          "ui:hidden": true
        },
        "value": {
          "description": "Name, email address or username. Estimates are not verified identity.",
          "maxLength": 254,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "forceToGenderize": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Try dataset first, then nickname AI when unresolved (2 credits total). Cannot combine with AI off or always.",
          "title": "Forcetogenderize"
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/PredictionOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "const": "predict_email",
          "default": "predict_email",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "PredictEmail",
      "type": "object"
    },
    "PredictGenderGet": {
      "additionalProperties": false,
      "description": "Estimate gender using the documented GET query interface (billable).",
      "properties": {
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional uppercase ISO 3166-1 alpha-2 country code.",
          "title": "Country"
        },
        "operation": {
          "const": "predict_gender_get",
          "default": "predict_gender_get",
          "title": "Operation",
          "type": "string"
        },
        "type": {
          "default": "name",
          "enum": [
            "name",
            "email",
            "username"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 254,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "forceToGenderize": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forcetogenderize"
        },
        "ai_mode": {
          "anyOf": [
            {
              "enum": [
                "off",
                "fallback",
                "always"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ai Mode",
          "enum": [
            "off",
            "fallback",
            "always"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "value"
      ],
      "title": "PredictGenderGet",
      "type": "object"
    },
    "PredictName": {
      "additionalProperties": false,
      "description": "Estimate gender from a first or full name (billable).",
      "properties": {
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional uppercase ISO 3166-1 alpha-2 country code.",
          "title": "Country"
        },
        "type": {
          "const": "name",
          "default": "name",
          "title": "Type",
          "type": "string",
          "ui:hidden": true
        },
        "value": {
          "description": "Name, email address or username. Estimates are not verified identity.",
          "maxLength": 254,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "forceToGenderize": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Try dataset first, then nickname AI when unresolved (2 credits total). Cannot combine with AI off or always.",
          "title": "Forcetogenderize"
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/PredictionOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "const": "predict_name",
          "default": "predict_name",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "PredictName",
      "type": "object"
    },
    "PredictUsername": {
      "additionalProperties": false,
      "description": "Estimate gender from a username or nickname (billable).",
      "properties": {
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional uppercase ISO 3166-1 alpha-2 country code.",
          "title": "Country"
        },
        "type": {
          "const": "username",
          "default": "username",
          "title": "Type",
          "type": "string",
          "ui:hidden": true
        },
        "value": {
          "description": "Name, email address or username. Estimates are not verified identity.",
          "maxLength": 254,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "forceToGenderize": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Try dataset first, then nickname AI when unresolved (2 credits total). Cannot combine with AI off or always.",
          "title": "Forcetogenderize"
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/PredictionOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "const": "predict_username",
          "default": "predict_username",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "PredictUsername",
      "type": "object"
    },
    "PredictionItem": {
      "additionalProperties": false,
      "properties": {
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional uppercase ISO 3166-1 alpha-2 country code.",
          "title": "Country"
        },
        "type": {
          "enum": [
            "name",
            "email",
            "username"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "description": "Name, email address or username. Estimates are not verified identity.",
          "maxLength": 254,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "forceToGenderize": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Try dataset first, then nickname AI when unresolved (2 credits total). Cannot combine with AI off or always.",
          "title": "Forcetogenderize"
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/PredictionOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "PredictionItem",
      "type": "object"
    },
    "PredictionOptions": {
      "additionalProperties": false,
      "properties": {
        "ai_mode": {
          "anyOf": [
            {
              "enum": [
                "off",
                "fallback",
                "always"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit for provider default: fallback for singles, off for batches. Always costs 2 credits; fallback costs 1.",
          "title": "Ai Mode",
          "enum": [
            "off",
            "fallback",
            "always"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "PredictionOptions",
      "type": "object"
    },
    "ValidatePhone": {
      "additionalProperties": false,
      "description": "Check phone structure and formatting (1 credit), not subscriber existence.",
      "properties": {
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional uppercase ISO 3166-1 alpha-2 country code.",
          "title": "Country"
        },
        "operation": {
          "const": "validate_phone",
          "default": "validate_phone",
          "title": "Operation",
          "type": "string"
        },
        "number": {
          "maxLength": 32,
          "minLength": 3,
          "pattern": "^\\+?[0-9 ()-]+$",
          "title": "Number",
          "type": "string"
        }
      },
      "required": [
        "number"
      ],
      "title": "ValidatePhone",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_capabilities": "#/$defs/GetCapabilities",
          "get_error_catalog": "#/$defs/GetErrorCatalog",
          "get_openapi": "#/$defs/GetOpenapi",
          "get_usage": "#/$defs/GetUsage",
          "predict_batch": "#/$defs/PredictBatch",
          "predict_email": "#/$defs/PredictEmail",
          "predict_gender_get": "#/$defs/PredictGenderGet",
          "predict_name": "#/$defs/PredictName",
          "predict_username": "#/$defs/PredictUsername",
          "validate_phone": "#/$defs/ValidatePhone"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PredictName"
        },
        {
          "$ref": "#/$defs/PredictEmail"
        },
        {
          "$ref": "#/$defs/PredictUsername"
        },
        {
          "$ref": "#/$defs/PredictGenderGet"
        },
        {
          "$ref": "#/$defs/PredictBatch"
        },
        {
          "$ref": "#/$defs/ValidatePhone"
        },
        {
          "$ref": "#/$defs/GetUsage"
        },
        {
          "$ref": "#/$defs/GetCapabilities"
        },
        {
          "$ref": "#/$defs/GetErrorCatalog"
        },
        {
          "$ref": "#/$defs/GetOpenapi"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/GenderapiIoAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Genderapi-io Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
