{
  "$defs": {
    "MetadataUpdate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "favourite": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Favourite"
        },
        "mark_as_final": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mark As Final"
        },
        "lock": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lock"
        },
        "state": {
          "anyOf": [
            {
              "const": "mark_as_complete",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "track_changes": {
          "anyOf": [
            {
              "enum": [
                "enable",
                "disable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Changes",
          "enum": [
            "enable",
            "disable"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "MetadataUpdate",
      "type": "object"
    },
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    },
    "ZohoWriterCopyDocumentConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "copy_document",
          "default": "copy_document",
          "title": "Copy Document",
          "type": "string",
          "ui:hidden": true,
          "x-is-trigger": false,
          "x-operation-kind": "write"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A unique name for the copied document.",
          "title": "Document Name"
        },
        "format": {
          "default": "zdoc",
          "description": "The format in which to store the copied document.",
          "enum": [
            "docx",
            "zdoc",
            "odt",
            "html",
            "pdf",
            "epub",
            "rtf",
            "txt"
          ],
          "title": "Format",
          "type": "string"
        },
        "folder_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The ID of the folder in which to store the copy. Defaults to \"My Folders\".",
          "title": "Folder Id"
        },
        "resource_type": {
          "anyOf": [
            {
              "enum": [
                "fillable",
                "merge",
                "sign"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the document type assigned to the copy.",
          "title": "Resource Type",
          "enum": [
            "fillable",
            "merge",
            "sign"
          ],
          "x-enum-searchable": true
        },
        "from": {
          "anyOf": [
            {
              "enum": [
                "publish",
                "editor",
                "version",
                "dashboard"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indicates the context the copy request originated from. When set to `publish`, the copy always excludes tracked changes and comments, overriding `options.include_changes` and `options.include_comments`.\n",
          "title": "From",
          "enum": [
            "publish",
            "editor",
            "version",
            "dashboard"
          ],
          "x-enum-searchable": true
        },
        "version_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The ID of the specific document version to copy. If omitted, the latest version is copied.",
          "title": "Version Id"
        }
      },
      "required": [
        "document_id"
      ],
      "title": "ZohoWriterCopyDocumentConfig",
      "type": "object"
    },
    "ZohoWriterCopyTemplateConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "copy_template",
          "default": "copy_template",
          "title": "Copy Template",
          "type": "string",
          "ui:hidden": true,
          "x-is-trigger": false,
          "x-operation-kind": "write"
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        },
        "type": {
          "default": "personal",
          "description": "The category under which the copied template is created. Copying to `organization` requires the template admin role in Zoho WorkDrive and a non-Personal Edition WorkDrive plan.",
          "enum": [
            "personal",
            "organization"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A unique name for the copied template. If omitted, defaults to \"Copy of\" followed by the source template's name.\n",
          "title": "Name"
        },
        "save_as": {
          "default": "template",
          "description": "Whether the copy is saved as a template or converted into a standalone document.\n",
          "enum": [
            "document",
            "template"
          ],
          "title": "Save As",
          "type": "string"
        },
        "team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The unique ID of the team/organization library to copy the template into. Applicable only when copying a public template.\n",
          "title": "Team Id"
        }
      },
      "required": [
        "template_id"
      ],
      "title": "ZohoWriterCopyTemplateConfig",
      "type": "object"
    },
