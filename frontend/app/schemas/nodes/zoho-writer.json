          "default": null,
          "description": "A unique name for the new template. If omitted, a default untitled name is used.\n",
          "title": "Name"
        },
        "type": {
          "default": "personal",
          "description": "The category under which the template is created. Creating an `organization` template requires the template admin role in Zoho WorkDrive and a non-Personal Edition WorkDrive plan.",
          "enum": [
            "personal",
            "organization"
          ],
          "title": "Type",
          "type": "string"
        },
        "team_id": {
          "anyOf": [
            {
