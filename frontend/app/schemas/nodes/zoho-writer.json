    "ZohoWriterOAuthCredential": {
      "properties": {
        "credential_type": {
          "const": "zoho_writer_oauth",
          "default": "zoho_writer_oauth",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "minLength": 1,
          "title": "Access token",
          "type": "string",
          "ui:widget": "password"
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh token",
          "ui:widget": "password"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 expiry of the OAuth token, when known.",
          "title": "Token expiry"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "Zoho Writer OAuth",
      "type": "object",
      "x-credential-instructions": "Connect your US data centre Zoho account, or paste an existing OAuth access token. Pasted tokens expire unless refresh details are supplied. Document, template and search permissions are requested.",
      "x-credential-type": "oauth",
      "x-credential-url": "https://api-console.zoho.com/",
      "x-oauth-provider": "zoho_writer",
      "x-oauth-scopes": [
        "WorkDrive.files.ALL",
        "WorkDrive.organization.ALL",
        "WorkDrive.team.READ",
