          "anyOf": [
            {
              "enum": [
                "Deal",
                "Company",
                "Person"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Association Type",
          "enum": [
            "Deal",
