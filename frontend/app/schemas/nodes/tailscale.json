{
  "$defs": {
    "TailscaleAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "tailscale_api_token",
          "default": "tailscale_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Tailscale API Token",
      "type": "object",
      "x-credential-instructions": "Paste a personal API access token from Tailscale Settings \u2192 Keys. Use an API access token, not a device auth key or OAuth client secret. Tokens inherit your Tailscale permissions and expire after 1\u201390 days; replace the saved token when it expires. Connecting reads devices in the token's default tailnet. Write permissions are checked by Tailscale when each operation runs.",
      "x-credential-url": "https://login.tailscale.com/admin/settings/keys"
    },
    "TailscaleAuthorizeDeviceConfig": {
      "additionalProperties": false,
      "description": "Authorize or deauthorize a device.",
      "properties": {
        "device_id": {
          "description": "Device nodeId (preferred) or legacy id, from List Devices.",
          "title": "Device Id",
          "type": "string"
        },
        "operation": {
          "const": "authorize_device",
          "default": "authorize_device",
          "title": "Operation",
          "type": "string"
        },
        "authorized": {
          "title": "Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "device_id",
        "authorized"
      ],
      "title": "TailscaleAuthorizeDeviceConfig",
      "type": "object"
    },
    "TailscaleDeleteDeviceConfig": {
      "additionalProperties": false,
      "description": "Remove a device from its tailnet.",
      "properties": {
        "device_id": {
          "description": "Device nodeId (preferred) or legacy id, from List Devices.",
          "title": "Device Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_device",
          "default": "delete_device",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "device_id"
      ],
      "title": "TailscaleDeleteDeviceConfig",
      "type": "object"
    },
    "TailscaleDeleteKeyConfig": {
      "additionalProperties": false,
      "description": "Revoke an auth key or trust credential.",
      "properties": {
        "tailnet": {
          "default": "-",
          "description": "Tailnet ID or legacy name. '-' uses the access token's default tailnet.",
          "title": "Tailnet",
          "type": "string"
        },
        "operation": {
          "const": "delete_key",
          "default": "delete_key",
          "title": "Operation",
          "type": "string"
        },
        "key_id": {
          "title": "Key Id",
          "type": "string"
        }
      },
      "required": [
        "key_id"
      ],
      "title": "TailscaleDeleteKeyConfig",
      "type": "object"
    },
    "TailscaleExpireDeviceKeyConfig": {
      "additionalProperties": false,
      "description": "Expire the device's node key, requiring reauthentication.",
      "properties": {
        "device_id": {
          "description": "Device nodeId (preferred) or legacy id, from List Devices.",
          "title": "Device Id",
          "type": "string"
        },
        "operation": {
          "const": "expire_device_key",
          "default": "expire_device_key",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "device_id"
      ],
      "title": "TailscaleExpireDeviceKeyConfig",
      "type": "object"
    },
    "TailscaleGetDeviceConfig": {
      "additionalProperties": false,
      "description": "Get a device's details.",
      "properties": {
        "device_id": {
          "description": "Device nodeId (preferred) or legacy id, from List Devices.",
          "title": "Device Id",
          "type": "string"
        },
        "operation": {
          "const": "get_device",
          "default": "get_device",
          "title": "Operation",
          "type": "string"
        },
        "fields": {
          "default": "default",
          "enum": [
            "default",
            "all"
          ],
          "title": "Fields",
          "type": "string"
        }
      },
      "required": [
        "device_id"
      ],
      "title": "TailscaleGetDeviceConfig",
      "type": "object"
    },
    "TailscaleGetDnsPreferencesConfig": {
      "additionalProperties": false,
      "description": "Read whether MagicDNS is enabled.",
      "properties": {
        "tailnet": {
          "default": "-",
          "description": "Tailnet ID or legacy name. '-' uses the access token's default tailnet.",
          "title": "Tailnet",
          "type": "string"
        },
        "operation": {
          "const": "get_dns_preferences",
          "default": "get_dns_preferences",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "TailscaleGetDnsPreferencesConfig",
      "type": "object"
    },
    "TailscaleGetKeyConfig": {
      "additionalProperties": false,
      "description": "Read metadata for an auth key or trust credential.",
      "properties": {
        "tailnet": {
          "default": "-",
          "description": "Tailnet ID or legacy name. '-' uses the access token's default tailnet.",
          "title": "Tailnet",
          "type": "string"
        },
        "operation": {
          "const": "get_key",
          "default": "get_key",
          "title": "Operation",
          "type": "string"
        },
        "key_id": {
          "title": "Key Id",
          "type": "string"
        }
      },
      "required": [
        "key_id"
      ],
      "title": "TailscaleGetKeyConfig",
      "type": "object"
    },
    "TailscaleGetUserConfig": {
      "additionalProperties": false,
      "description": "Get a tailnet user's details.",
      "properties": {
        "operation": {
          "const": "get_user",
          "default": "get_user",
          "title": "Operation",
          "type": "string"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id"
      ],
      "title": "TailscaleGetUserConfig",
      "type": "object"
    },
    "TailscaleListDeviceRoutesConfig": {
      "additionalProperties": false,
      "description": "Read advertised and enabled subnet routes.",
      "properties": {
        "device_id": {
          "description": "Device nodeId (preferred) or legacy id, from List Devices.",
          "title": "Device Id",
          "type": "string"
        },
        "operation": {
          "const": "list_device_routes",
          "default": "list_device_routes",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "device_id"
      ],
      "title": "TailscaleListDeviceRoutesConfig",
      "type": "object"
    },
    "TailscaleListDevicesConfig": {
      "additionalProperties": false,
      "description": "List all devices in the tailnet, without pagination.",
      "properties": {
        "tailnet": {
          "default": "-",
          "description": "Tailnet ID or legacy name. '-' uses the access token's default tailnet.",
          "title": "Tailnet",
          "type": "string"
        },
        "operation": {
          "const": "list_devices",
          "default": "list_devices",
          "title": "Operation",
          "type": "string"
        },
        "fields": {
          "default": "default",
          "enum": [
            "default",
            "all"
          ],
          "title": "Fields",
          "type": "string"
        }
      },
      "title": "TailscaleListDevicesConfig",
      "type": "object"
    },
    "TailscaleListDnsNameserversConfig": {
      "additionalProperties": false,
      "description": "Read the global DNS nameservers.",
      "properties": {
        "tailnet": {
          "default": "-",
          "description": "Tailnet ID or legacy name. '-' uses the access token's default tailnet.",
          "title": "Tailnet",
          "type": "string"
        },
        "operation": {
          "const": "list_dns_nameservers",
          "default": "list_dns_nameservers",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "TailscaleListDnsNameserversConfig",
      "type": "object"
    },
    "TailscaleListDnsSearchPathsConfig": {
      "additionalProperties": false,
      "description": "Read DNS search domains.",
      "properties": {
        "tailnet": {
          "default": "-",
          "description": "Tailnet ID or legacy name. '-' uses the access token's default tailnet.",
          "title": "Tailnet",
          "type": "string"
        },
        "operation": {
          "const": "list_dns_search_paths",
          "default": "list_dns_search_paths",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "TailscaleListDnsSearchPathsConfig",
      "type": "object"
    },
    "TailscaleListKeysConfig": {
      "additionalProperties": false,
      "description": "List key metadata; secret key material is omitted.",
      "properties": {
        "tailnet": {
          "default": "-",
          "description": "Tailnet ID or legacy name. '-' uses the access token's default tailnet.",
          "title": "Tailnet",
          "type": "string"
        },
        "operation": {
          "const": "list_keys",
          "default": "list_keys",
          "title": "Operation",
          "type": "string"
        },
        "all_keys": {
          "default": false,
          "description": "Include revoked and expired keys.",
          "title": "All Keys",
          "type": "boolean"
        }
      },
      "title": "TailscaleListKeysConfig",
      "type": "object"
    },
    "TailscaleListUsersConfig": {
      "additionalProperties": false,
      "description": "List tailnet users with optional relation and role filters.",
      "properties": {
        "tailnet": {
          "default": "-",
          "description": "Tailnet ID or legacy name. '-' uses the access token's default tailnet.",
          "title": "Tailnet",
          "type": "string"
        },
        "operation": {
          "const": "list_users",
          "default": "list_users",
          "title": "Operation",
          "type": "string"
        },
        "user_type": {
          "default": "member",
          "enum": [
            "member",
            "shared",
            "all"
          ],
          "title": "User Type",
          "type": "string"
        },
        "role": {
          "default": "all",
          "enum": [
            "owner",
            "member",
            "admin",
            "it-admin",
            "network-admin",
            "billing-admin",
            "auditor",
            "all"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "title": "TailscaleListUsersConfig",
      "type": "object"
    },
    "TailscaleSetDeviceNameConfig": {
      "additionalProperties": false,
      "description": "Set a device's MagicDNS name, or reset it from its OS hostname.",
      "properties": {
        "device_id": {
          "description": "Device nodeId (preferred) or legacy id, from List Devices.",
          "title": "Device Id",
          "type": "string"
        },
        "operation": {
          "const": "set_device_name",
          "default": "set_device_name",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "default": "",
          "description": "Base name or full MagicDNS name. Empty resets to the OS hostname.",
          "maxLength": 253,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "device_id"
      ],
      "title": "TailscaleSetDeviceNameConfig",
      "type": "object"
    },
    "TailscaleSetDeviceRoutesConfig": {
      "additionalProperties": false,
      "description": "Replace enabled routes; an empty list disables all routes.",
      "properties": {
        "device_id": {
          "description": "Device nodeId (preferred) or legacy id, from List Devices.",
          "title": "Device Id",
          "type": "string"
        },
        "operation": {
          "const": "set_device_routes",
          "default": "set_device_routes",
          "title": "Operation",
          "type": "string"
        },
        "routes": {
          "description": "Complete list of enabled CIDR routes, e.g. ['10.0.0.0/16']. Routes must also be advertised by the device to carry traffic.",
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Routes",
          "type": "array"
        }
      },
      "required": [
        "device_id",
        "routes"
      ],
      "title": "TailscaleSetDeviceRoutesConfig",
      "type": "object"
    },
    "TailscaleSetDeviceTagsConfig": {
      "additionalProperties": false,
      "description": "Replace the complete list of identity tags on a device.",
      "properties": {
        "device_id": {
          "description": "Device nodeId (preferred) or legacy id, from List Devices.",
          "title": "Device Id",
          "type": "string"
        },
        "operation": {
          "const": "set_device_tags",
          "default": "set_device_tags",
          "title": "Operation",
          "type": "string"
        },
        "tags": {
          "description": "Complete replacement list, e.g. ['tag:prod']; [] removes all tags.",
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "device_id",
        "tags"
      ],
      "title": "TailscaleSetDeviceTagsConfig",
      "type": "object"
    },
    "TailscaleSetDnsNameserversConfig": {
      "additionalProperties": false,
      "description": "Replace global DNS nameservers; [] removes them.",
      "properties": {
        "tailnet": {
          "default": "-",
          "description": "Tailnet ID or legacy name. '-' uses the access token's default tailnet.",
          "title": "Tailnet",
          "type": "string"
        },
        "operation": {
          "const": "set_dns_nameservers",
          "default": "set_dns_nameservers",
          "title": "Operation",
          "type": "string"
        },
        "dns": {
          "description": "Complete nameserver list, e.g. ['8.8.8.8', '1.2.3.4'].",
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Dns",
          "type": "array"
        }
      },
      "required": [
        "dns"
      ],
      "title": "TailscaleSetDnsNameserversConfig",
      "type": "object"
    },
    "TailscaleSetDnsPreferencesConfig": {
      "additionalProperties": false,
      "description": "Enable or disable MagicDNS.",
      "properties": {
        "tailnet": {
          "default": "-",
          "description": "Tailnet ID or legacy name. '-' uses the access token's default tailnet.",
          "title": "Tailnet",
          "type": "string"
        },
        "operation": {
          "const": "set_dns_preferences",
          "default": "set_dns_preferences",
          "title": "Operation",
          "type": "string"
        },
        "magic_dns": {
          "title": "Magic Dns",
          "type": "boolean"
        }
      },
      "required": [
        "magic_dns"
      ],
      "title": "TailscaleSetDnsPreferencesConfig",
      "type": "object"
    },
    "TailscaleSetDnsSearchPathsConfig": {
      "additionalProperties": false,
      "description": "Replace DNS search domains; [] removes them.",
      "properties": {
        "tailnet": {
          "default": "-",
          "description": "Tailnet ID or legacy name. '-' uses the access token's default tailnet.",
          "title": "Tailnet",
          "type": "string"
        },
        "operation": {
          "const": "set_dns_search_paths",
          "default": "set_dns_search_paths",
          "title": "Operation",
          "type": "string"
        },
        "search_paths": {
          "description": "Complete domain list, e.g. ['user1.example.com', 'user2.example.com'].",
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Search Paths",
          "type": "array"
        }
      },
      "required": [
        "search_paths"
      ],
      "title": "TailscaleSetDnsSearchPathsConfig",
      "type": "object"
    },
    "TailscaleUpdateDeviceKeyConfig": {
      "additionalProperties": false,
      "description": "Enable or disable device key expiry.",
      "properties": {
        "device_id": {
          "description": "Device nodeId (preferred) or legacy id, from List Devices.",
          "title": "Device Id",
          "type": "string"
        },
        "operation": {
          "const": "update_device_key",
          "default": "update_device_key",
          "title": "Operation",
          "type": "string"
        },
        "key_expiry_disabled": {
          "description": "True disables expiry. False restores the original expiry time, which may already be in the past.",
          "title": "Key Expiry Disabled",
          "type": "boolean"
        }
      },
      "required": [
        "device_id",
        "key_expiry_disabled"
      ],
      "title": "TailscaleUpdateDeviceKeyConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "authorize_device": "#/$defs/TailscaleAuthorizeDeviceConfig",
          "delete_device": "#/$defs/TailscaleDeleteDeviceConfig",
          "delete_key": "#/$defs/TailscaleDeleteKeyConfig",
          "expire_device_key": "#/$defs/TailscaleExpireDeviceKeyConfig",
          "get_device": "#/$defs/TailscaleGetDeviceConfig",
          "get_dns_preferences": "#/$defs/TailscaleGetDnsPreferencesConfig",
          "get_key": "#/$defs/TailscaleGetKeyConfig",
          "get_user": "#/$defs/TailscaleGetUserConfig",
          "list_device_routes": "#/$defs/TailscaleListDeviceRoutesConfig",
          "list_devices": "#/$defs/TailscaleListDevicesConfig",
          "list_dns_nameservers": "#/$defs/TailscaleListDnsNameserversConfig",
          "list_dns_search_paths": "#/$defs/TailscaleListDnsSearchPathsConfig",
          "list_keys": "#/$defs/TailscaleListKeysConfig",
          "list_users": "#/$defs/TailscaleListUsersConfig",
          "set_device_name": "#/$defs/TailscaleSetDeviceNameConfig",
          "set_device_routes": "#/$defs/TailscaleSetDeviceRoutesConfig",
          "set_device_tags": "#/$defs/TailscaleSetDeviceTagsConfig",
          "set_dns_nameservers": "#/$defs/TailscaleSetDnsNameserversConfig",
          "set_dns_preferences": "#/$defs/TailscaleSetDnsPreferencesConfig",
          "set_dns_search_paths": "#/$defs/TailscaleSetDnsSearchPathsConfig",
          "update_device_key": "#/$defs/TailscaleUpdateDeviceKeyConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TailscaleListDevicesConfig"
        },
        {
          "$ref": "#/$defs/TailscaleGetDeviceConfig"
        },
        {
          "$ref": "#/$defs/TailscaleDeleteDeviceConfig"
        },
        {
          "$ref": "#/$defs/TailscaleExpireDeviceKeyConfig"
        },
        {
          "$ref": "#/$defs/TailscaleListDeviceRoutesConfig"
        },
        {
          "$ref": "#/$defs/TailscaleSetDeviceRoutesConfig"
        },
        {
          "$ref": "#/$defs/TailscaleAuthorizeDeviceConfig"
        },
        {
          "$ref": "#/$defs/TailscaleSetDeviceNameConfig"
        },
        {
          "$ref": "#/$defs/TailscaleSetDeviceTagsConfig"
        },
        {
          "$ref": "#/$defs/TailscaleUpdateDeviceKeyConfig"
        },
        {
          "$ref": "#/$defs/TailscaleListDnsNameserversConfig"
        },
        {
          "$ref": "#/$defs/TailscaleSetDnsNameserversConfig"
        },
        {
          "$ref": "#/$defs/TailscaleGetDnsPreferencesConfig"
        },
        {
          "$ref": "#/$defs/TailscaleSetDnsPreferencesConfig"
        },
        {
          "$ref": "#/$defs/TailscaleListDnsSearchPathsConfig"
        },
        {
          "$ref": "#/$defs/TailscaleSetDnsSearchPathsConfig"
        },
        {
          "$ref": "#/$defs/TailscaleListKeysConfig"
        },
        {
          "$ref": "#/$defs/TailscaleGetKeyConfig"
        },
        {
          "$ref": "#/$defs/TailscaleDeleteKeyConfig"
        },
        {
          "$ref": "#/$defs/TailscaleListUsersConfig"
        },
        {
          "$ref": "#/$defs/TailscaleGetUserConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/TailscaleAPITokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Tailscale Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
