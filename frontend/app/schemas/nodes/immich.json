{
  "$defs": {
    "GetAlbum": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to albumName only. Assets, media, users, sharing, descriptions and URLs are omitted.",
          "title": "Include Album Names",
          "type": "boolean"
        },
        "operation": {
          "const": "get_album",
          "default": "get_album",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Metadata",
          "x-display-name": "Get Album Metadata",
          "x-is-trigger": false
        },
        "album_id": {
          "description": "Exact current UUIDv4 album ID from the bounded catalog. Case is preserved; catalog/detail/catalog witnesses access, not ownership.",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
          "title": "Album",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "album_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "immich_album"
        }
      },
      "required": [
        "album_id"
      ],
      "title": "GetAlbum",
      "type": "object"
    },
    "ImmichAPIKeyCredential": {
      "additionalProperties": false,
      "properties": {
        "credential_type": {
          "const": "immich_api_key",
          "default": "immich_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "instance_origin": {
          "description": "One public HTTPS origin, with no credentials/path/query/fragment. API paths are fixed /api. Current master OAS3.0.0/version3.3.0-rc.0 parity with your installed server is unverified; no fallback.",
          "title": "Instance HTTPS Origin",
          "type": "string"
        },
        "api_key": {
          "description": "Supplied existing x-api-key header only. Both selected documented operations require album.read; current key kind, permissions and principal remain unverified. No token issuance, login or refresh.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Existing API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "instance_origin",
        "api_key"
      ],
      "title": "Immich API Key",
      "type": "object",
      "x-credential-url": "https://docs.immich.app/api/"
    },
    "ListAlbums": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to albumName only. Assets, media, users, sharing, descriptions and URLs are omitted.",
          "title": "Include Album Names",
          "type": "boolean"
        },
        "operation": {
          "const": "list_albums",
          "default": "list_albums",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Metadata",
          "x-display-name": "List Album Metadata",
          "x-is-trigger": false
        }
      },
      "title": "ListAlbums",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_album": "#/$defs/GetAlbum",
          "list_albums": "#/$defs/ListAlbums"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListAlbums"
        },
        {
          "$ref": "#/$defs/GetAlbum"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImmichAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Immich Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
