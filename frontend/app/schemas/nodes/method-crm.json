{
  "$defs": {
    "CountRecordsConfig": {
      "additionalProperties": false,
      "description": "Count all records or records matching a filter.",
      "properties": {
        "table": {
          "description": "Exact table name from List Tables, e.g. Contacts, Customer, Activity or Invoice.",
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "operation": {
          "const": "count_records",
          "default": "count_records",
          "title": "Operation",
          "type": "string"
        },
        "filter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter"
        }
      },
      "required": [
        "table"
      ],
      "title": "CountRecordsConfig",
      "type": "object"
    },
    "CreateRecordConfig": {
      "additionalProperties": false,
      "description": "Create a contact, customer, lead, activity, invoice or custom record.",
      "properties": {
        "table": {
          "description": "Exact table name from List Tables, e.g. Contacts, Customer, Activity or Invoice.",
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "record_json": {
          "description": "JSON object with exact case-sensitive, writable field names from Get Table Fields. Linked fields use their foreign-key IDs. Aggregate writes allow up to 50 children and require a parent field.",
          "title": "Record Json",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "operation": {
          "const": "create_record",
          "default": "create_record",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "table",
        "record_json"
      ],
      "title": "CreateRecordConfig",
      "type": "object"
    },
    "DeleteFileConfig": {
      "additionalProperties": false,
      "description": "Delete a file by its provider ID.",
      "properties": {
        "file_id": {
          "description": "File id returned by List Files.",
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_file",
          "default": "delete_file",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "DeleteFileConfig",
      "type": "object"
    },
    "DeleteRecordConfig": {
      "additionalProperties": false,
      "description": "Delete the selected table record.",
      "properties": {
        "table": {
          "description": "Exact table name from List Tables, e.g. Contacts, Customer, Activity or Invoice.",
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "record_id": {
          "description": "RecordID of the selected table row.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Record Id",
          "type": "integer"
        },
        "operation": {
          "const": "delete_record",
          "default": "delete_record",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "table",
        "record_id"
      ],
      "title": "DeleteRecordConfig",
      "type": "object"
    },
    "GetFileURLConfig": {
      "additionalProperties": false,
      "description": "Retrieve the provider's file URL without downloading it.",
      "properties": {
        "file_id": {
          "description": "File id returned by List Files.",
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "get_file_url",
          "default": "get_file_url",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetFileURLConfig",
      "type": "object"
    },
    "GetRecordConfig": {
      "additionalProperties": false,
      "description": "Read a record with optional selected and expanded fields.",
      "properties": {
        "table": {
          "description": "Exact table name from List Tables, e.g. Contacts, Customer, Activity or Invoice.",
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "record_id": {
          "description": "RecordID of the selected table row.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Record Id",
          "type": "integer"
        },
        "operation": {
          "const": "get_record",
          "default": "get_record",
          "title": "Operation",
          "type": "string"
        },
        "select": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Select"
        },
        "expand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Linked fields to expand, e.g. Entity.",
          "title": "Expand"
        }
      },
      "required": [
        "table",
        "record_id"
      ],
      "title": "GetRecordConfig",
      "type": "object"
    },
    "GetTableFieldsConfig": {
      "additionalProperties": false,
      "description": "Get field names, types and account-specific write permissions.",
      "properties": {
        "table": {
          "description": "Exact table name from List Tables, e.g. Contacts, Customer, Activity or Invoice.",
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "operation": {
          "const": "get_table_fields",
          "default": "get_table_fields",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "table"
      ],
      "title": "GetTableFieldsConfig",
      "type": "object"
    },
    "ListFilesConfig": {
      "additionalProperties": false,
      "description": "List files, optionally restricted to a table and record.",
      "properties": {
        "operation": {
          "const": "list_files",
          "default": "list_files",
          "title": "Operation",
          "type": "string"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "record_id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        }
      },
      "title": "ListFilesConfig",
      "type": "object"
    },
    "ListTablesConfig": {
      "additionalProperties": false,
      "description": "List the tables and custom tables available to this account.",
      "properties": {
        "operation": {
          "const": "list_tables",
          "default": "list_tables",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListTablesConfig",
      "type": "object"
    },
    "MethodCRMAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "method_crm_api_key",
          "default": "method_crm_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Method CRM API Key",
      "type": "object",
      "x-credential-instructions": "In Method, open Integrations \u2192 API \u2192 API keys \u2192 New. Generate and copy the API key, then paste it here without the APIKey prefix.",
      "x-credential-url": "https://rest.method.me/#section/Authentication"
    },
    "QueryRecordsConfig": {
      "additionalProperties": false,
      "description": "Query one page of contacts, customers, activities or any account table.",
      "properties": {
        "table": {
          "description": "Exact table name from List Tables, e.g. Contacts, Customer, Activity or Invoice.",
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "operation": {
          "const": "query_records",
          "default": "query_records",
          "title": "Operation",
          "type": "string"
        },
        "select": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated field names.",
          "title": "Select"
        },
        "filter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Method filter expression; include Z or an offset for dates.",
          "title": "Filter"
        },
        "orderby": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated ordering, e.g. RecordID asc.",
          "title": "Orderby"
        },
        "apply": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Documented aggregation expression.",
          "title": "Apply"
        },
        "top": {
          "default": 10,
          "description": "Page size. Read next_link and advance skip for another page.",
          "maximum": 100,
          "minimum": 1,
          "title": "Top",
          "type": "integer"
        },
        "skip": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Skip",
          "type": "integer"
        }
      },
      "required": [
        "table"
      ],
      "title": "QueryRecordsConfig",
      "type": "object"
    },
    "SyncRecordConfig": {
      "additionalProperties": false,
      "description": "Force a syncable record to QuickBooks or Xero, overriding normal timing.",
      "properties": {
        "table": {
          "description": "Exact table name from List Tables, e.g. Contacts, Customer, Activity or Invoice.",
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "record_id": {
          "description": "RecordID of the selected table row.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Record Id",
          "type": "integer"
        },
        "operation": {
          "const": "sync_record",
          "default": "sync_record",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "table",
        "record_id"
      ],
      "title": "SyncRecordConfig",
      "type": "object"
    },
    "UpdateFileLinkConfig": {
      "additionalProperties": false,
      "description": "Update the file link's attach-to-email flag for a table record.",
      "properties": {
        "table": {
          "description": "Exact table name from List Tables, e.g. Contacts, Customer, Activity or Invoice.",
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "record_id": {
          "description": "RecordID of the selected table row.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Record Id",
          "type": "integer"
        },
        "file_id": {
          "description": "File id returned by List Files.",
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "update_file_link",
          "default": "update_file_link",
          "title": "Operation",
          "type": "string"
        },
        "attach_to_email": {
          "description": "Whether the linked file is attached to email.",
          "title": "Attach To Email",
          "type": "boolean"
        }
      },
      "required": [
        "table",
        "record_id",
        "file_id",
        "attach_to_email"
      ],
      "title": "UpdateFileLinkConfig",
      "type": "object"
    },
    "UpdateRecordConfig": {
      "additionalProperties": false,
      "description": "Patch a record; omitted fields and child records remain unchanged.",
      "properties": {
        "table": {
          "description": "Exact table name from List Tables, e.g. Contacts, Customer, Activity or Invoice.",
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "record_id": {
          "description": "RecordID of the selected table row.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Record Id",
          "type": "integer"
        },
        "record_json": {
          "description": "JSON object with exact case-sensitive, writable field names from Get Table Fields. Linked fields use their foreign-key IDs. Aggregate writes allow up to 50 children and require a parent field.",
          "title": "Record Json",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "operation": {
          "const": "update_record",
          "default": "update_record",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "table",
        "record_id",
        "record_json"
      ],
      "title": "UpdateRecordConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "count_records": "#/$defs/CountRecordsConfig",
          "create_record": "#/$defs/CreateRecordConfig",
          "delete_file": "#/$defs/DeleteFileConfig",
          "delete_record": "#/$defs/DeleteRecordConfig",
          "get_file_url": "#/$defs/GetFileURLConfig",
          "get_record": "#/$defs/GetRecordConfig",
          "get_table_fields": "#/$defs/GetTableFieldsConfig",
          "list_files": "#/$defs/ListFilesConfig",
          "list_tables": "#/$defs/ListTablesConfig",
          "query_records": "#/$defs/QueryRecordsConfig",
          "sync_record": "#/$defs/SyncRecordConfig",
          "update_file_link": "#/$defs/UpdateFileLinkConfig",
          "update_record": "#/$defs/UpdateRecordConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListTablesConfig"
        },
        {
          "$ref": "#/$defs/GetTableFieldsConfig"
        },
        {
          "$ref": "#/$defs/QueryRecordsConfig"
        },
        {
          "$ref": "#/$defs/GetRecordConfig"
        },
        {
          "$ref": "#/$defs/CreateRecordConfig"
        },
        {
          "$ref": "#/$defs/UpdateRecordConfig"
        },
        {
          "$ref": "#/$defs/DeleteRecordConfig"
        },
        {
          "$ref": "#/$defs/CountRecordsConfig"
        },
        {
          "$ref": "#/$defs/SyncRecordConfig"
        },
        {
          "$ref": "#/$defs/ListFilesConfig"
        },
        {
          "$ref": "#/$defs/GetFileURLConfig"
        },
        {
          "$ref": "#/$defs/UpdateFileLinkConfig"
        },
        {
          "$ref": "#/$defs/DeleteFileConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MethodCRMAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Method-crm Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
