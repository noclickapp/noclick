{
  "$defs": {
    "ConversionOptions": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional conversion value.",
          "title": "Value"
        }
      },
      "title": "ConversionOptions",
      "type": "object"
    },
    "ConvertParticipantConfig": {
      "additionalProperties": false,
      "description": "Record a participant conversion, optionally with a value.",
      "properties": {
        "operation": {
          "const": "convert_participant",
          "default": "convert_participant",
          "title": "Operation",
          "type": "string"
        },
        "user": {
          "$ref": "#/$defs/Participant"
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConversionOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "user"
      ],
      "title": "ConvertParticipantConfig",
      "type": "object"
    },
    "GetCampaignConfig": {
      "additionalProperties": false,
      "description": "Read the campaign selected by the API token.",
      "properties": {
        "operation": {
          "const": "get_campaign",
          "default": "get_campaign",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetCampaignConfig",
      "type": "object"
    },
    "GetCampaignStatsConfig": {
      "additionalProperties": false,
      "description": "Read campaign lead and referral totals.",
      "properties": {
        "operation": {
          "const": "get_campaign_stats",
          "default": "get_campaign_stats",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetCampaignStatsConfig",
      "type": "object"
    },
    "GetGivenRewardsConfig": {
      "additionalProperties": false,
      "description": "Read given rewards for a participant or a campaign page.",
      "properties": {
        "operation": {
          "const": "get_given_rewards",
          "default": "get_given_rewards",
          "title": "Operation",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "referralCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referralcode"
        }
      },
      "title": "GetGivenRewardsConfig",
      "type": "object"
    },
    "GetParticipantConfig": {
      "additionalProperties": false,
      "description": "Read participant profile, referrals, points and rewards.",
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Participant email; supply this or the referral code.",
          "title": "Email"
        },
        "referralCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referral Code"
        },
        "operation": {
          "const": "get_participant",
          "default": "get_participant",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetParticipantConfig",
      "type": "object"
    },
    "GetParticipantOrderConfig": {
      "additionalProperties": false,
      "description": "Read the participant's registration order and campaign lead count.",
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Participant email; supply this or the referral code.",
          "title": "Email"
        },
        "referralCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referral Code"
        },
        "operation": {
          "const": "get_participant_order",
          "default": "get_participant_order",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetParticipantOrderConfig",
      "type": "object"
    },
    "GetParticipantRankConfig": {
      "additionalProperties": false,
      "description": "Read the participant's leaderboard rank and referral totals.",
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Participant email; supply this or the referral code.",
          "title": "Email"
        },
        "referralCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referral Code"
        },
        "operation": {
          "const": "get_participant_rank",
          "default": "get_participant_rank",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetParticipantRankConfig",
      "type": "object"
    },
    "GetParticipantReferralsConfig": {
      "additionalProperties": false,
      "description": "Read one page of a participant's referrals.",
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Participant email; supply this or the referral code.",
          "title": "Email"
        },
        "referralCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referral Code"
        },
        "operation": {
          "const": "get_participant_referrals",
          "default": "get_participant_referrals",
          "title": "Operation",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "conversionStatus": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Numeric conversion status as documented by the v3 referrals endpoint.",
          "title": "Conversionstatus"
        }
      },
      "title": "GetParticipantReferralsConfig",
      "type": "object"
    },
    "GetParticipantReferrerConfig": {
      "additionalProperties": false,
      "description": "Read who referred a participant.",
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Participant email; supply this or the referral code.",
          "title": "Email"
        },
        "referralCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referral Code"
        },
        "operation": {
          "const": "get_participant_referrer",
          "default": "get_participant_referrer",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetParticipantReferrerConfig",
      "type": "object"
    },
    "GetPendingRewardsConfig": {
      "additionalProperties": false,
      "description": "Read pending rewards for a participant or a campaign page.",
      "properties": {
        "operation": {
          "const": "get_pending_rewards",
          "default": "get_pending_rewards",
          "title": "Operation",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "referralCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referralcode"
        }
      },
      "title": "GetPendingRewardsConfig",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 50,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "skip": {
          "default": 0,
          "minimum": 0,
          "title": "Skip",
          "type": "integer"
        }
      },
      "title": "Page",
      "type": "object"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Participant email; supply this or the referral code.",
          "title": "Email"
        },
        "referralCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referral Code"
        }
      },
      "title": "Participant",
      "type": "object"
    },
    "QueryParticipantsConfig": {
      "additionalProperties": false,
      "description": "Query participants and/or referrers with limit/skip pagination.",
      "properties": {
        "operation": {
          "const": "query_participants",
          "default": "query_participants",
          "title": "Operation",
          "type": "string"
        },
        "referrers": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Participant"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referrers"
        },
        "participants": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Participant"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participants"
        },
        "filter": {
          "$ref": "#/$defs/Page",
          "title": "Pagination"
        }
      },
      "title": "QueryParticipantsConfig",
      "type": "object"
    },
    "RedeemRewardConfig": {
      "additionalProperties": false,
      "description": "Move a participant's pending reward to given rewards.",
      "properties": {
        "operation": {
          "const": "redeem_reward",
          "default": "redeem_reward",
          "title": "Operation",
          "type": "string"
        },
        "rewardId": {
          "minLength": 1,
          "title": "Reward ID",
          "type": "string"
        },
        "user": {
          "$ref": "#/$defs/Participant"
        }
      },
      "required": [
        "rewardId",
        "user"
      ],
      "title": "RedeemRewardConfig",
      "type": "object"
    },
    "RegisterParticipantConfig": {
      "additionalProperties": false,
      "description": "Register a participant, optionally crediting a referrer; campaign emails and integrations may run.",
      "properties": {
        "operation": {
          "const": "register_participant",
          "default": "register_participant",
          "title": "Operation",
          "type": "string"
        },
        "user": {
          "$ref": "#/$defs/RegistrationUser"
        },
        "referrer": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegistrationReferrer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "refSource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refsource"
        },
        "acquiredFrom": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquiredfrom"
        }
      },
      "required": [
        "user"
      ],
      "title": "RegisterParticipantConfig",
      "type": "object"
    },
    "RegistrationReferrer": {
      "additionalProperties": false,
      "properties": {
        "referralCode": {
          "minLength": 1,
          "title": "Referralcode",
          "type": "string"
        }
      },
      "required": [
        "referralCode"
      ],
      "title": "RegistrationReferrer",
      "type": "object"
    },
    "RegistrationUser": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        },
        "firstname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Firstname"
        },
        "lastname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastname"
        },
        "consents": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consents"
        },
        "extraData": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extradata"
        }
      },
      "required": [
        "email"
      ],
      "title": "RegistrationUser",
      "type": "object"
    },
    "SearchFilters": {
      "additionalProperties": false,
      "properties": {
        "conversionStatus": {
          "default": "all",
          "enum": [
            "all",
            "pending",
            "converted"
          ],
          "title": "Conversionstatus",
          "type": "string"
        },
        "source": {
          "default": "all",
          "enum": [
            "referred",
            "organic",
            "all"
          ],
          "title": "Source",
          "type": "string"
        },
        "searchTerm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Searchterm"
        }
      },
      "title": "SearchFilters",
      "type": "object"
    },
    "SearchPagination": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 50,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "SearchPagination",
      "type": "object"
    },
    "SearchParticipantsConfig": {
      "additionalProperties": false,
      "description": "Search participants by text, conversion status and referral source.",
      "properties": {
        "operation": {
          "const": "search_participants",
          "default": "search_participants",
          "title": "Operation",
          "type": "string"
        },
        "filters": {
          "$ref": "#/$defs/SearchFilters"
        },
        "pagination": {
          "$ref": "#/$defs/SearchPagination"
        }
      },
      "title": "SearchParticipantsConfig",
      "type": "object"
    },
    "ViralLoopsCredential": {
      "properties": {
        "credential_type": {
          "const": "viral_loops_api_token",
          "default": "viral_loops_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Viral Loops API Token",
      "type": "object",
      "x-credential-instructions": "Open your Viral Loops campaign's API settings and paste its API token. Each token selects one campaign. Use the private API token, not the public token. NoClick reads the campaign name to verify the connection.",
      "x-credential-url": "https://developers.viral-loops.com/"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "convert_participant": "#/$defs/ConvertParticipantConfig",
          "get_campaign": "#/$defs/GetCampaignConfig",
          "get_campaign_stats": "#/$defs/GetCampaignStatsConfig",
          "get_given_rewards": "#/$defs/GetGivenRewardsConfig",
          "get_participant": "#/$defs/GetParticipantConfig",
          "get_participant_order": "#/$defs/GetParticipantOrderConfig",
          "get_participant_rank": "#/$defs/GetParticipantRankConfig",
          "get_participant_referrals": "#/$defs/GetParticipantReferralsConfig",
          "get_participant_referrer": "#/$defs/GetParticipantReferrerConfig",
          "get_pending_rewards": "#/$defs/GetPendingRewardsConfig",
          "query_participants": "#/$defs/QueryParticipantsConfig",
          "redeem_reward": "#/$defs/RedeemRewardConfig",
          "register_participant": "#/$defs/RegisterParticipantConfig",
          "search_participants": "#/$defs/SearchParticipantsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetCampaignConfig"
        },
        {
          "$ref": "#/$defs/GetCampaignStatsConfig"
        },
        {
          "$ref": "#/$defs/GetParticipantConfig"
        },
        {
          "$ref": "#/$defs/GetParticipantReferralsConfig"
        },
        {
          "$ref": "#/$defs/GetParticipantOrderConfig"
        },
        {
          "$ref": "#/$defs/GetParticipantRankConfig"
        },
        {
          "$ref": "#/$defs/GetParticipantReferrerConfig"
        },
        {
          "$ref": "#/$defs/GetPendingRewardsConfig"
        },
        {
          "$ref": "#/$defs/GetGivenRewardsConfig"
        },
        {
          "$ref": "#/$defs/QueryParticipantsConfig"
        },
        {
          "$ref": "#/$defs/SearchParticipantsConfig"
        },
        {
          "$ref": "#/$defs/RegisterParticipantConfig"
        },
        {
          "$ref": "#/$defs/ConvertParticipantConfig"
        },
        {
          "$ref": "#/$defs/RedeemRewardConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ViralLoopsCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Viral-loops Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
