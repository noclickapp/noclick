    "PauseSyncConfig": {
      "additionalProperties": false,
      "description": "Pause scheduled syncs for one connection.",
      "properties": {
        "provider_config_key": {
          "description": "Nango integration ID.",
          "maxLength": 255,
          "minLength": 1,
          "title": "Provider Config Key",
          "type": "string"
        },
        "connection_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Connection Id",
          "type": "string"
        },
        "syncs": {
          "description": "Explicit sync names. This node targets one connection.",
