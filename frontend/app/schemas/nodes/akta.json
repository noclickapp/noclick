{
  "$defs": {
    "AktaAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "akta_api_key",
          "default": "akta_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Akta API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the Akta playground and paste it here. Akta research endpoints prove key acceptance, not account identity. Some data sections require a Subscription or Enterprise plan.",
      "x-credential-url": "https://playground.akta.pro/"
    },
    "AktaBuildFiltersConfig": {
      "additionalProperties": false,
      "description": "Build Filters.",
      "properties": {
        "operation": {
          "const": "build_filters",
          "default": "build_filters",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "description": "Natural language description of target companies (e.g. 'series a companies in mumbai working in climate tech').",
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "AktaBuildFiltersConfig",
      "type": "object"
    },
    "AktaCreateCompanyAdditionRequestConfig": {
      "additionalProperties": false,
      "description": "Company Addition.",
      "properties": {
        "operation": {
          "const": "create_company_addition_request",
          "default": "create_company_addition_request",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company_name": {
          "description": "Name of the company to add. Example: solios",
          "minLength": 1,
          "title": "Company Name",
          "type": "string"
        },
        "website": {
          "description": "Primary website URL of the company. Used to disambiguate and resolve the company. Example: https://www.soleosenergy.com/",
          "minLength": 1,
          "title": "Website",
          "type": "string"
        }
      },
      "required": [
        "company_name",
        "website"
      ],
      "title": "AktaCreateCompanyAdditionRequestConfig",
      "type": "object"
    },
    "AktaEnrichCompanyConfig": {
      "additionalProperties": false,
      "description": "Company Enrichment.",
      "properties": {
        "operation": {
          "const": "enrich_company",
          "default": "enrich_company",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company": {
          "description": "Company website (e.g. 'https://canva.com') or a company UUID (e.g. '00031n-tesla'). The UUID can be obtained from the Company Search API.",
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "sections": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated list of sections to return. Copy-paste example: `firmographic,business_model,company_assessment,trust_signal,company_hierarchy,digital_presence,financial_estimate,location,management_profile,product_offering,strategic_signal,customer_profile,industry,technology,funding_detail,mna_and_investment`. Note: `funding_detail` and `mna_and_investment` are available on the subscription and Enterprise tier only.",
          "title": "Sections"
        }
      },
      "required": [
        "company"
      ],
      "title": "AktaEnrichCompanyConfig",
      "type": "object"
    },
    "AktaGenerateCompanyListConfig": {
      "additionalProperties": false,
      "description": "Generate Company List.",
      "properties": {
        "operation": {
          "const": "generate_company_list",
          "default": "generate_company_list",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Natural language search query (e.g. 'SaaS companies in the US with Series A funding'). Cannot be used with filters.",
          "title": "Query"
        },
        "filters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured filter conditions. Use the Filter Builder API to generate valid filters. Cannot be used with query. See filter options at /api-reference/listgen-api.",
          "title": "Filters"
        },
        "sections": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Data enrichment sections to include. Values: firmographic, business_model, company_assessment, trust_signal, company_hierarchy, digital_presence, financial_estimate, location, management_profile, product_offering, strategic_signal, customer_profile, industry, technology, funding_detail (Subscription, Enterprise), mna_and_investment (Subscription, Enterprise)",
          "title": "Sections"
        },
        "sort_by": {
          "anyOf": [
            {
              "enum": [
                "relevance",
                "revenue_estimate",
                "valuation_estimate",
                "employee_range",
                "total_funding",
                "founded_year"
              ],
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Field to sort results by. Default: relevance",
          "title": "Sort By",
          "enum": [
            "relevance",
            "revenue_estimate",
            "valuation_estimate",
            "employee_range",
            "total_funding",
            "founded_year"
          ],
          "x-enum-searchable": true
        },
        "sort_order": {
          "anyOf": [
            {
              "enum": [
                "asc",
                "desc"
              ],
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sort direction. Default: desc",
          "title": "Sort Order",
          "enum": [
            "asc",
            "desc"
          ],
          "x-enum-searchable": true
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum companies to return. Default: 50, Max: 500",
          "title": "Limit"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of results to skip for pagination. Default: 0",
          "title": "Offset"
        }
      },
      "title": "AktaGenerateCompanyListConfig",
      "type": "object"
    },
    "AktaGetEmployeeReviewsConfig": {
      "additionalProperties": false,
      "description": "Employee Reviews.",
      "properties": {
        "operation": {
          "const": "get_employee_reviews",
          "default": "get_employee_reviews",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company": {
          "description": "Company website (e.g. 'canva.com') or a company UUID. The UUID can be obtained from the Company Search API.",
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "description": "Maximum number of reviews to return.",
          "maximum": 100,
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of reviews to skip before returning records. Use with limit for pagination.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "company"
      ],
      "title": "AktaGetEmployeeReviewsConfig",
      "type": "object"
    },
    "AktaGetHeadcountTrendsConfig": {
      "additionalProperties": false,
      "description": "Headcount Trends.",
      "properties": {
        "operation": {
          "const": "get_headcount_trends",
          "default": "get_headcount_trends",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company": {
          "description": "Company website (e.g. 'canva.com') or a company UUID. The UUID can be obtained from the Company Search API.",
          "minLength": 1,
          "title": "Company",
          "type": "string"
        }
      },
      "required": [
        "company"
      ],
      "title": "AktaGetHeadcountTrendsConfig",
      "type": "object"
    },
    "AktaGetJobPostsConfig": {
      "additionalProperties": false,
      "description": "Job Posts.",
      "properties": {
        "operation": {
          "const": "get_job_posts",
          "default": "get_job_posts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company": {
          "description": "Company website (e.g. 'canva.com') or a company UUID. The UUID can be obtained from the Company Search API.",
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "description": "Maximum number of job listings to return.",
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of listings to skip before returning records.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "company"
      ],
      "title": "AktaGetJobPostsConfig",
      "type": "object"
    },
    "AktaGetNewsConfig": {
      "additionalProperties": false,
      "description": "News.",
      "properties": {
        "operation": {
          "const": "get_news",
          "default": "get_news",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Website (e.g. 'https://canva.com') or company UUID returned by the Company Search API.",
          "title": "Company"
        },
        "primary_company": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter to return only articles where the specified company is the primary company featured. Cannot be used with the `company` parameter.",
          "title": "Primary Company"
        },
        "industry": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma separated list of industry codes to filter articles by. Use industry search endpoint to fetch the list of industry codes for a given industry topic.",
          "title": "Industry"
        },
        "query": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Topic name to search articles. Allows open-ended topic name. Eg. Crude oil price developments",
          "title": "Query"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Searches articles based on the title entered.",
          "title": "Title"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start of the date range, formatted as YYYY-MM-DD. Non-enterprise plans are limited to a 6-month lookback.",
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End of the date range, formatted as YYYY-MM-DD. Default = today.",
          "title": "End Date"
        },
        "limit": {
          "default": 10,
          "description": "Maximum number of news articles to return. Default = 10, Max = 100.",
          "maximum": 100,
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of results to skip before returning records. Use with limit for pagination.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "group_articles": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accepts boolean. True will group similar articles from the same event.",
          "title": "Group Articles"
        },
        "news_score_list": {
          "anyOf": [
            {
              "enum": [
                "High",
                "Medium",
                "Low",
                "all"
              ],
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by news score tier. Accepted values: High, Medium, Low, all. Default = all",
          "title": "News Score List",
          "enum": [
            "High",
            "Medium",
            "Low",
            "all"
          ],
          "x-enum-searchable": true
        },
        "countries": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filters articles based on the country of the event. Comma separated list of ISO country codes.",
          "title": "Countries"
        },
        "blacklisted": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma separated list of publisher domains to exclude.",
          "title": "Blacklisted"
        },
        "type_list": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by news type. Download full list from https://playground.akta.pro/news-tags.csv. Default = all.",
          "title": "Type List"
        },
        "sentiment_list": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated list of sentiments to filter by. Accepted values: positive, negative, neutral, all. Default = all. Example: sentiment_list=positive,negative",
          "title": "Sentiment List"
        },
        "entity_person_list": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma separated list of people names.",
          "title": "Entity Person List"
        },
        "entity_location_list": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma separated list of locations.",
          "title": "Entity Location List"
        },
        "entity_product_list": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma separated list of product names.",
          "title": "Entity Product List"
        },
        "entity_event_list": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma separated list of event names.",
          "title": "Entity Event List"
        },
        "naics_code_list": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma separated list of NAICS codes.",
          "title": "Naics Code List"
        },
        "sic_code_list": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma separated list of SIC codes.",
          "title": "Sic Code List"
        },
        "iptc_code_list": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma separated list of IPTC codes.",
          "title": "Iptc Code List"
        },
        "iab_code_list": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma separated list of IAB codes.",
          "title": "Iab Code List"
        }
      },
      "title": "AktaGetNewsConfig",
      "type": "object"
    },
    "AktaGetProductReviewsConfig": {
      "additionalProperties": false,
      "description": "Product Reviews.",
      "properties": {
        "operation": {
          "const": "get_product_reviews",
          "default": "get_product_reviews",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company": {
          "description": "Company website (e.g. 'canva.com') or a company UUID. The UUID can be obtained from the Company Search API.",
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "products": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of product_id values to fetch reviews for. Pass the parameter multiple times to request more than one product. If omitted, the response returns the product list only.",
          "title": "Products"
        },
        "limit": {
          "default": 0,
          "description": "Maximum number of reviews to return per product. Only applies when products is provided.",
          "maximum": 50,
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of reviews to skip before returning records. Use with limit for pagination.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "company"
      ],
      "title": "AktaGetProductReviewsConfig",
      "type": "object"
    },
    "AktaGetRequestStatusConfig": {
      "additionalProperties": false,
      "description": "Request Status.",
      "properties": {
        "operation": {
          "const": "get_request_status",
          "default": "get_request_status",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "request_id": {
          "description": "The unique identifier of the request to check, returned when the original request was submitted. Example: 2db01b38-5c81-4b3f-b76d-8b36aeed603b",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "AktaGetRequestStatusConfig",
      "type": "object"
    },
    "AktaGetSocialPostsConfig": {
      "additionalProperties": false,
      "description": "Social Posts.",
      "properties": {
        "operation": {
          "const": "get_social_posts",
          "default": "get_social_posts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company": {
          "description": "Company website (e.g. 'canva.com') or a company UUID. The UUID can be obtained from the Company Search API.",
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "description": "Maximum number of posts to return.",
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of posts to skip before returning records.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "company"
      ],
      "title": "AktaGetSocialPostsConfig",
      "type": "object"
    },
    "AktaGetWebsiteTrafficConfig": {
      "additionalProperties": false,
      "description": "Website Traffic.",
      "properties": {
        "operation": {
          "const": "get_website_traffic",
          "default": "get_website_traffic",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company": {
          "description": "Company website (e.g. 'canva.com') or a company UUID. The UUID can be obtained from the Company Search API.",
          "minLength": 1,
          "title": "Company",
          "type": "string"
        }
      },
      "required": [
        "company"
      ],
      "title": "AktaGetWebsiteTrafficConfig",
      "type": "object"
    },
    "AktaSearchCompaniesConfig": {
      "additionalProperties": false,
      "description": "Company Search.",
      "properties": {
        "operation": {
          "const": "search_companies",
          "default": "search_companies",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "description": "A company name, website. The backend automatically resolves the input type. Examples: https://canva.com, canva",
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "AktaSearchCompaniesConfig",
      "type": "object"
    },
    "AktaSearchIndustriesConfig": {
      "additionalProperties": false,
      "description": "Industry Search.",
      "properties": {
        "operation": {
          "const": "search_industries",
          "default": "search_industries",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "description": "Free-text industry name or topic to search for. Example: 'warehouse automation'",
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict results to one or more levels of the industry taxonomy hierarchy. Accepts a single level or a comma-separated list of multiple levels. Available values: l1, l2, l3, l4, all. Default is l4.",
          "title": "Level"
        }
      },
      "required": [
        "query"
      ],
      "title": "AktaSearchIndustriesConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "build_filters": "#/$defs/AktaBuildFiltersConfig",
          "create_company_addition_request": "#/$defs/AktaCreateCompanyAdditionRequestConfig",
          "enrich_company": "#/$defs/AktaEnrichCompanyConfig",
          "generate_company_list": "#/$defs/AktaGenerateCompanyListConfig",
