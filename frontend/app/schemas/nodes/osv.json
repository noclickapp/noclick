{
  "$defs": {
    "DetermineVersion": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "determine_version",
          "default": "determine_version",
          "title": "Determine C/C++ Version (Experimental)",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Determine C/C++ Version (Experimental)"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional library name hint.",
          "title": "Name"
        },
        "file_hashes": {
          "items": {
            "$ref": "#/$defs/FileHash"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "File Hashes",
          "type": "array"
        }
      },
      "required": [
        "file_hashes"
      ],
      "title": "DetermineVersion",
      "type": "object"
    },
    "FileHash": {
      "additionalProperties": false,
      "properties": {
        "file_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "File Path",
          "type": "string"
        },
        "hash": {
          "description": "Base64-encoded MD5 digest bytes, not the hex digest.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/]{22}==$",
          "title": "Hash",
          "type": "string"
        },
        "hash_type": {
          "const": "MD5",
          "default": "MD5",
          "title": "Hash Type",
          "type": "string"
        }
      },
      "required": [
        "file_path",
        "hash"
      ],
      "title": "FileHash",
      "type": "object"
    },
    "GetVulnerability": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_vulnerability",
          "default": "get_vulnerability",
          "title": "Get Vulnerability",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Get Vulnerability"
        },
        "vulnerability_id": {
          "default": "OSV-2020-111",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
          "title": "Vulnerability ID",
          "type": "string"
        }
      },
      "title": "GetVulnerability",
      "type": "object"
    },
    "ListImportFindings": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_import_findings",
          "default": "list_import_findings",
          "title": "List Import Findings (Experimental)",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "List Import Findings (Experimental)"
        },
        "source": {
          "description": "Source name from OSV source.yaml; case sensitive.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,255}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "ListImportFindings",
      "type": "object"
    },
    "MapUbuntuPackages": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "map_ubuntu_packages",
          "default": "map_ubuntu_packages",
          "title": "Map Ubuntu Binary Packages (Experimental)",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Map Ubuntu Binary Packages (Experimental)"
        },
        "ecosystem": {
          "description": "Ubuntu release ecosystem, e.g. Ubuntu:24.04:LTS.",
          "pattern": "^Ubuntu:(?:Pro:)?[0-9]{2}\\.[0-9]{2}(?::LTS)?$",
          "title": "Ecosystem",
          "type": "string"
        },
        "binary_names": {
          "description": "Results correspond to these names in order; an empty result means no known mapping.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Binary Names",
          "type": "array"
        }
      },
      "required": [
        "ecosystem",
        "binary_names"
      ],
      "title": "MapUbuntuPackages",
      "type": "object"
    },
    "Package": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "ecosystem": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ecosystem"
        },
        "purl": {
          "anyOf": [
            {
              "maxLength": 4096,
              "pattern": "^pkg:.+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purl"
        }
      },
      "title": "Package",
      "type": "object"
    },
    "Query": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "package": {
          "anyOf": [
            {
              "$ref": "#/$defs/Package"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Token"
        }
      },
      "title": "Query",
      "type": "object"
    },
    "QueryBatch": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "query_batch",
          "default": "query_batch",
          "title": "Batch Query Vulnerabilities",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Batch Query Vulnerabilities"
        },
        "queries": {
          "description": "Package/version, purl or commit queries. Results preserve input order and contain only IDs and modification timestamps. Each result may have its own next_page_token.",
          "items": {
            "$ref": "#/$defs/Query"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Queries",
          "type": "array"
        }
      },
      "required": [
        "queries"
      ],
      "title": "QueryBatch",
      "type": "object"
    },
    "QueryCommit": {
      "additionalProperties": false,
      "properties": {
        "page_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return next_page_token here with the same query to fetch another page.",
          "title": "Page Token"
        },
        "operation": {
          "const": "query_commit",
          "default": "query_commit",
          "title": "Query Git Commit",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Query Git Commit"
        },
        "commit": {
          "pattern": "^[0-9a-fA-F]{40}$",
          "title": "Commit",
          "type": "string"
        }
      },
      "required": [
        "commit"
      ],
      "title": "QueryCommit",
      "type": "object"
    },
    "QueryGitTag": {
      "additionalProperties": false,
      "properties": {
        "page_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return next_page_token here with the same query to fetch another page.",
          "title": "Page Token"
        },
        "operation": {
          "const": "query_git_tag",
          "default": "query_git_tag",
          "title": "Query Git Repository Tag",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Query Git Repository Tag"
        },
        "repository": {
          "description": "Full Git repository URL, e.g. https://github.com/curl/curl.git. Sent as data; never fetched.",
          "maxLength": 4096,
          "pattern": "^https://.+",
          "title": "Repository",
          "type": "string"
        },
        "tag": {
          "description": "Git tag, e.g. 8.5.0.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Tag",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "tag"
      ],
      "title": "QueryGitTag",
      "type": "object"
    },
    "QueryPackage": {
      "additionalProperties": false,
      "properties": {
        "page_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return next_page_token here with the same query to fetch another page.",
          "title": "Page Token"
        },
        "operation": {
          "const": "query_package",
          "default": "query_package",
          "title": "List Package Vulnerabilities",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "List Package Vulnerabilities"
        },
        "name": {
          "description": "Package name, e.g. nokogiri.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "ecosystem": {
          "description": "Case-sensitive ecosystem, e.g. RubyGems or PyPI.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Ecosystem",
          "type": "string"
        }
      },
      "required": [
        "name",
        "ecosystem"
      ],
      "title": "QueryPackage",
      "type": "object"
    },
    "QueryPackageVersion": {
      "additionalProperties": false,
      "properties": {
        "page_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return next_page_token here with the same query to fetch another page.",
          "title": "Page Token"
        },
        "operation": {
          "const": "query_package_version",
          "default": "query_package_version",
          "title": "Query Package Version",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Query Package Version"
        },
        "name": {
          "description": "Package name, e.g. nokogiri.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "ecosystem": {
          "description": "Case-sensitive ecosystem, e.g. RubyGems or PyPI.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Ecosystem",
          "type": "string"
        },
        "version": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "ecosystem",
        "version"
      ],
      "title": "QueryPackageVersion",
      "type": "object"
    },
    "QueryPurl": {
      "additionalProperties": false,
      "properties": {
        "page_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return next_page_token here with the same query to fetch another page.",
          "title": "Page Token"
        },
        "operation": {
          "const": "query_purl",
          "default": "query_purl",
          "title": "Query Package URL",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Query Package URL"
        },
        "purl": {
          "maxLength": 4096,
          "pattern": "^pkg:.+",
          "title": "Purl",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit when the purl already contains a version.",
          "title": "Version"
        }
      },
      "required": [
        "purl"
      ],
      "title": "QueryPurl",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "determine_version": "#/$defs/DetermineVersion",
          "get_vulnerability": "#/$defs/GetVulnerability",
          "list_import_findings": "#/$defs/ListImportFindings",
          "map_ubuntu_packages": "#/$defs/MapUbuntuPackages",
          "query_batch": "#/$defs/QueryBatch",
          "query_commit": "#/$defs/QueryCommit",
          "query_git_tag": "#/$defs/QueryGitTag",
          "query_package": "#/$defs/QueryPackage",
          "query_package_version": "#/$defs/QueryPackageVersion",
          "query_purl": "#/$defs/QueryPurl"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/QueryPackage"
        },
        {
          "$ref": "#/$defs/QueryPackageVersion"
        },
        {
          "$ref": "#/$defs/QueryPurl"
        },
        {
          "$ref": "#/$defs/QueryCommit"
        },
        {
          "$ref": "#/$defs/QueryGitTag"
        },
        {
          "$ref": "#/$defs/QueryBatch"
        },
        {
          "$ref": "#/$defs/GetVulnerability"
        },
        {
          "$ref": "#/$defs/DetermineVersion"
        },
        {
          "$ref": "#/$defs/ListImportFindings"
        },
        {
          "$ref": "#/$defs/MapUbuntuPackages"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials",
      "type": "null"
    }
  },
  "required": [
    "config"
  ],
  "title": "Osv Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
