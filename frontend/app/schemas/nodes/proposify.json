{
  "$defs": {
    "ProposifyCreateDraftConfig": {
      "properties": {
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Document Name",
          "type": "string"
        },
        "operation": {
          "const": "create_draft_document_from_template",
          "default": "create_draft_document_from_template",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Draft Documents",
          "x-display-name": "Create V3 Draft from Selected Template",
          "x-is-trigger": false
        },
        "template_id": {
          "format": "uuid",
          "title": "Template Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "template_id",
            "auto_select_sole_option": true
          },
          "x-resource-type": "template_id"
        },
        "new_document_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional documented id. It is not an idempotency guarantee; reconcile an ambiguous request before retrying.",
          "title": "Optional New V3 Document UUID"
        }
      },
      "required": [
        "name",
        "template_id"
      ],
      "title": "ProposifyCreateDraftConfig",
      "type": "object"
    },
    "ProposifyGetV3DocumentConfig": {
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "document_id",
            "auto_select_sole_option": true
          },
          "x-resource-type": "document_id"
        },
        "operation": {
          "const": "get_v3_document",
          "default": "get_v3_document",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Documents",
          "x-display-name": "Get Selected V3 Document Metadata",
          "x-is-trigger": false
        }
      },
      "required": [
        "document_id"
      ],
      "title": "ProposifyGetV3DocumentConfig",
      "type": "object"
    },
    "ProposifyIssuedTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "proposify_issued_token",
          "default": "proposify_issued_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "title": "Already-Issued Proposify Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "token_type": {
          "const": "Bearer",
          "title": "Actual Token Type",
          "type": "string"
        },
        "scopes": {
          "description": "Record actual applicable read/write permissions, not requested/guessed scopes. At least one read permission is needed for protected connect proof.",
          "items": {
            "enum": [
              "read_users",
              "read_templates",
              "read_documents",
              "write_documents"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Actual Granted Operation Scopes",
          "type": "array"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Issuing Client ID (if known)"
        },
        "expected_account_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actual numeric account.id observed on an accessible V3 object. Optional for reads; required locally for draft mutations. This is a resource/account binding, not proof of the token principal.",
          "title": "Expected Proposify Account ID (if known)"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timezone-aware known expiry only. Unknown expiry is not a non-expiring token. Replace expired/rejected issued tokens; this credential does not refresh.",
          "title": "Actual Issuer Token Expiry (if known)"
        }
      },
      "required": [
        "access_token",
        "token_type",
        "scopes"
      ],
      "title": "Proposify Issued OAuth Token",
      "type": "object",
      "x-credential-instructions": "Supply an already-issued Proposify Connect Bearer token and its actual granted scopes. No OAuth client registration, authorization, exchange or refresh is automated. Expiry/client/account absence is unknown, not filled from an app/global client. API enablement/paid entitlement remains unverified. Draft mutations require an expected account ID observed from a protected V3 object. User list is account users, not token-user identity.",
      "x-credential-url": "https://apidocs.proposify.com/"
    },
    "ProposifyLegacyTemplatesConfig": {
      "properties": {
        "operation": {
          "const": "list_legacy_templates",
          "default": "list_legacy_templates",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Templates",
          "x-display-name": "List Legacy Numeric Template Metadata",
          "x-is-trigger": false
        }
      },
      "title": "ProposifyLegacyTemplatesConfig",
      "type": "object"
    },
    "ProposifyProbeConfig": {
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Connection",
          "x-display-name": "Check Protected API Reachability",
          "x-is-trigger": false
        }
      },
      "title": "ProposifyProbeConfig",
      "type": "object"
    },
    "ProposifyRenameDraftConfig": {
      "properties": {
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Document Name",
          "type": "string"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "document_id",
            "auto_select_sole_option": true
          },
          "x-resource-type": "document_id"
        },
        "operation": {
          "const": "rename_draft_document",
          "default": "rename_draft_document",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Draft Documents",
          "x-display-name": "Rename Editable V3 Draft",
          "x-is-trigger": false
        }
      },
      "required": [
        "name",
        "document_id"
      ],
      "title": "ProposifyRenameDraftConfig",
      "type": "object"
    },
    "ProposifySoftDeleteDraftConfig": {
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "document_id",
            "auto_select_sole_option": true
          },
          "x-resource-type": "document_id"
        },
        "operation": {
          "const": "soft_delete_draft_document",
          "default": "soft_delete_draft_document",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Draft Documents",
          "x-display-name": "Soft Delete Editable V3 Draft",
          "x-is-trigger": false
        }
      },
      "required": [
        "document_id"
      ],
      "title": "ProposifySoftDeleteDraftConfig",
      "type": "object"
    },
    "ProposifyUsersConfig": {
      "properties": {
        "operation": {
          "const": "list_users",
          "default": "list_users",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Users",
          "x-display-name": "List Account User Metadata",
          "x-is-trigger": false
        },
        "include_personal_details": {
          "default": false,
          "description": "Default returns only numeric user ID and title. Listing account users never identifies the token's principal.",
          "title": "Include User Names and Email",
          "type": "boolean"
        }
      },
      "title": "ProposifyUsersConfig",
      "type": "object"
    },
    "ProposifyV3DocumentsConfig": {
      "properties": {
        "operation": {
          "const": "list_v3_documents",
          "default": "list_v3_documents",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Documents",
          "x-display-name": "List V3 Document Metadata",
          "x-is-trigger": false
        }
      },
      "title": "ProposifyV3DocumentsConfig",
      "type": "object"
    },
    "ProposifyV3TemplatesConfig": {
      "properties": {
        "operation": {
          "const": "list_v3_templates",
          "default": "list_v3_templates",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Templates",
          "x-display-name": "List V3 UUID Template Metadata",
          "x-is-trigger": false
        }
      },
      "title": "ProposifyV3TemplatesConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/ProposifyProbeConfig",
          "create_draft_document_from_template": "#/$defs/ProposifyCreateDraftConfig",
          "get_v3_document": "#/$defs/ProposifyGetV3DocumentConfig",
          "list_legacy_templates": "#/$defs/ProposifyLegacyTemplatesConfig",
          "list_users": "#/$defs/ProposifyUsersConfig",
          "list_v3_documents": "#/$defs/ProposifyV3DocumentsConfig",
          "list_v3_templates": "#/$defs/ProposifyV3TemplatesConfig",
          "rename_draft_document": "#/$defs/ProposifyRenameDraftConfig",
          "soft_delete_draft_document": "#/$defs/ProposifySoftDeleteDraftConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ProposifyProbeConfig"
        },
        {
          "$ref": "#/$defs/ProposifyUsersConfig"
        },
        {
          "$ref": "#/$defs/ProposifyLegacyTemplatesConfig"
        },
        {
          "$ref": "#/$defs/ProposifyV3TemplatesConfig"
        },
        {
          "$ref": "#/$defs/ProposifyV3DocumentsConfig"
        },
        {
          "$ref": "#/$defs/ProposifyGetV3DocumentConfig"
        },
        {
          "$ref": "#/$defs/ProposifyCreateDraftConfig"
        },
        {
          "$ref": "#/$defs/ProposifyRenameDraftConfig"
        },
        {
          "$ref": "#/$defs/ProposifySoftDeleteDraftConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposifyIssuedTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Proposify Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "List V3 template metadata",
    "Create a draft from a selected UUID template",
    "Rename an editable draft without sending it"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
