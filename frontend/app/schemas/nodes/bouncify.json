{
  "$defs": {
    "BouncifyAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "bouncify_api_key",
          "default": "bouncify_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Bouncify API Key",
      "type": "object",
      "x-credential-instructions": "Paste your API key from the Bouncify dashboard. NoClick sends it as the apikey query parameter to api.bouncify.io. The connection check reads your credit balance without verifying an email or consuming verification credits.",
      "x-credential-url": "https://app.bouncify.io/"
    },
    "CreateBulkJob": {
      "additionalProperties": false,
      "description": "Upload an array of email objects; auto verification can consume credits.",
      "properties": {
        "operation": {
          "const": "create_bulk_job",
          "default": "create_bulk_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "emails": {
          "description": "Email objects, optionally with extra columns such as firstname and lastname. Maximum payload 10 MB.",
          "items": {
            "$ref": "#/$defs/EmailRow"
          },
          "maxItems": 500000,
          "minItems": 1,
          "title": "Emails",
          "type": "array"
        },
        "auto_verify": {
          "default": false,
          "description": "Start verification immediately after the list is prepared.",
          "title": "Auto Verify",
          "type": "boolean"
        }
      },
      "required": [
        "emails"
      ],
      "title": "CreateBulkJob",
      "type": "object"
    },
    "DeleteBulkJob": {
      "additionalProperties": false,
      "description": "Request list deletion. The acknowledgement does not prove completed deletion.",
      "properties": {
        "job_id": {
          "description": "job_id returned when the list was uploaded.",
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Job Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_bulk_job",
          "default": "delete_bulk_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "job_id"
      ],
      "title": "DeleteBulkJob",
      "type": "object"
    },
    "DownloadBulkResults": {
      "additionalProperties": false,
      "description": "Download a completed list as CSV, optionally selecting result types.",
      "properties": {
        "job_id": {
          "description": "job_id returned when the list was uploaded.",
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Job Id",
          "type": "string"
        },
        "operation": {
          "const": "download_bulk_results",
          "default": "download_bulk_results",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "filter_results": {
          "items": {
            "enum": [
              "deliverable",
              "undeliverable",
              "accept_all",
              "unknown"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Filter Results",
          "type": "array"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "DownloadBulkResults",
      "type": "object"
    },
    "EmailRow": {
      "additionalProperties": true,
      "description": "An email plus optional columns retained in the downloaded CSV.",
      "properties": {
        "email": {
          "format": "email",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "EmailRow",
      "type": "object"
    },
    "GetBulkJob": {
      "additionalProperties": false,
      "description": "Read preparation/verification status and result counts for one list.",
      "properties": {
        "job_id": {
          "description": "job_id returned when the list was uploaded.",
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Job Id",
          "type": "string"
        },
        "operation": {
          "const": "get_bulk_job",
          "default": "get_bulk_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetBulkJob",
      "type": "object"
    },
    "GetCreditBalance": {
      "additionalProperties": false,
      "description": "Read the authenticated account's remaining verification credits.",
      "properties": {
        "operation": {
          "const": "get_credit_balance",
          "default": "get_credit_balance",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetCreditBalance",
      "type": "object"
    },
    "StartBulkJob": {
      "additionalProperties": false,
      "description": "Start a ready list once; verification cannot be paused or restarted.",
      "properties": {
        "job_id": {
          "description": "job_id returned when the list was uploaded.",
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Job Id",
          "type": "string"
        },
        "operation": {
          "const": "start_bulk_job",
          "default": "start_bulk_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "job_id"
      ],
      "title": "StartBulkJob",
      "type": "object"
    },
    "VerifyEmail": {
      "additionalProperties": false,
      "description": "Verify one address; this can consume verification credits.",
      "properties": {
        "operation": {
          "const": "verify_email",
          "default": "verify_email",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "description": "Email address to verify.",
          "format": "email",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Email",
          "type": "string"
        },
        "timeout": {
          "default": 180000,
          "description": "Provider verification timeout in milliseconds.",
          "maximum": 180000,
          "minimum": 30000,
          "title": "Timeout",
          "type": "integer"
        }
      },
      "required": [
        "email"
      ],
      "title": "VerifyEmail",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_bulk_job": "#/$defs/CreateBulkJob",
          "delete_bulk_job": "#/$defs/DeleteBulkJob",
          "download_bulk_results": "#/$defs/DownloadBulkResults",
          "get_bulk_job": "#/$defs/GetBulkJob",
          "get_credit_balance": "#/$defs/GetCreditBalance",
          "start_bulk_job": "#/$defs/StartBulkJob",
          "verify_email": "#/$defs/VerifyEmail"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/VerifyEmail"
        },
        {
          "$ref": "#/$defs/CreateBulkJob"
        },
        {
          "$ref": "#/$defs/GetBulkJob"
        },
        {
          "$ref": "#/$defs/StartBulkJob"
        },
        {
          "$ref": "#/$defs/DeleteBulkJob"
        },
        {
          "$ref": "#/$defs/DownloadBulkResults"
        },
        {
          "$ref": "#/$defs/GetCreditBalance"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/BouncifyAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Bouncify Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
