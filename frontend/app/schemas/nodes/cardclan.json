{
  "$defs": {
    "CardclanIntegrationKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "cardclan_integration_key",
          "default": "cardclan_integration_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "integration_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Integration key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "integration_key"
      ],
      "title": "Cardclan Integration Key",
      "type": "object",
      "x-credential-instructions": "In Cardclan Settings, click Generate Integration Key and paste the key here. Use an Integration Key, which is different from a regular Cardclan API key. NoClick validates it by reading the associated user ID.",
      "x-credential-url": "https://app.cardclan.io"
    },
    "CreateConfig": {
      "properties": {
        "operation": {
          "const": "create_config",
          "default": "create_config",
          "title": "Create Integration Config",
          "type": "string",
          "ui:hidden": true
        },
        "user_id": {
          "description": "Returned by Validate Authentication.",
          "title": "User ID",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace ID",
          "type": "string"
        },
        "card_id": {
          "title": "Card ID",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "workspace_id",
        "card_id"
      ],
      "title": "CreateConfig",
      "type": "object"
    },
    "GetCardDetails": {
      "properties": {
        "operation": {
          "const": "get_card_details",
          "default": "get_card_details",
          "title": "Get Card Details",
          "type": "string",
          "ui:hidden": true
        },
        "card_id": {
          "title": "Card ID",
          "type": "string"
        }
      },
      "required": [
        "card_id"
      ],
      "title": "GetCardDetails",
      "type": "object"
    },
    "GetCardUrl": {
      "properties": {
        "card_id": {
          "title": "Card ID",
          "type": "string"
        },
        "integration_id": {
          "title": "Integration Config ID",
          "type": "string"
        },
        "merge_tags": {
          "description": "JSON array of recipients, each with name and email plus any custom string merge tags. Example: [{\"name\":\"John Doe\",\"email\":\"john@example.com\"}].",
          "title": "Recipient Merge Tags",
          "type": "string",
          "ui:language": "json",
          "ui:widget": "code_editor"
        },
        "operation": {
          "const": "get_card_url",
          "default": "get_card_url",
          "description": "Creates a personalized card URL without sending email.",
          "title": "Generate Personalized Card URL",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "card_id",
        "integration_id",
        "merge_tags"
      ],
      "title": "GetCardUrl",
      "type": "object"
    },
    "GetConfig": {
      "properties": {
        "operation": {
          "const": "get_config",
          "default": "get_config",
          "title": "Get Integration Config",
          "type": "string",
          "ui:hidden": true
        },
        "integration_id": {
          "title": "Integration Config ID",
          "type": "string"
        }
      },
      "required": [
        "integration_id"
      ],
      "title": "GetConfig",
      "type": "object"
    },
    "GetConfigByCard": {
      "properties": {
        "operation": {
          "const": "get_config_by_card",
          "default": "get_config_by_card",
          "title": "Get Config by Card",
          "type": "string",
          "ui:hidden": true
        },
        "card_id": {
          "title": "Card ID",
          "type": "string"
        }
      },
      "required": [
        "card_id"
      ],
      "title": "GetConfigByCard",
      "type": "object"
    },
    "ListCards": {
      "properties": {
        "operation": {
          "const": "list_cards",
          "default": "list_cards",
          "title": "List Workspace Cards",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_id": {
          "description": "Use an ID returned by List Workspaces.",
          "title": "Workspace ID",
          "type": "string"
        }
      },
      "required": [
        "workspace_id"
      ],
      "title": "ListCards",
      "type": "object"
    },
    "ListEmailAccounts": {
      "properties": {
        "operation": {
          "const": "list_email_accounts",
          "default": "list_email_accounts",
          "title": "List Email Accounts",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListEmailAccounts",
      "type": "object"
    },
    "ListWorkflowCards": {
      "properties": {
        "operation": {
          "const": "list_workflow_cards",
          "default": "list_workflow_cards",
          "title": "List Cards with Workflows",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListWorkflowCards",
      "type": "object"
    },
    "ListWorkspaces": {
      "properties": {
        "operation": {
          "const": "list_workspaces",
          "default": "list_workspaces",
          "title": "List Workspaces",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListWorkspaces",
      "type": "object"
    },
    "SendCard": {
      "properties": {
        "card_id": {
          "title": "Card ID",
          "type": "string"
        },
        "integration_id": {
          "title": "Integration Config ID",
          "type": "string"
        },
        "merge_tags": {
          "description": "JSON array of recipients, each with name and email plus any custom string merge tags. Example: [{\"name\":\"John Doe\",\"email\":\"john@example.com\"}].",
          "title": "Recipient Merge Tags",
          "type": "string",
          "ui:language": "json",
          "ui:widget": "code_editor"
        },
        "operation": {
          "const": "send_card",
          "default": "send_card",
          "description": "Sends email to the supplied recipients. Inspect Cardclan before retrying an uncertain result.",
          "title": "Send Personalized Card",
          "type": "string",
          "ui:hidden": true
        },
        "email_account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An email account ID from List Email Accounts, or CardClan for the default sender. Omit to use the provider default.",
          "title": "Email Account"
        }
      },
      "required": [
        "card_id",
        "integration_id",
        "merge_tags"
      ],
      "title": "SendCard",
      "type": "object"
    },
    "ValidateAuthentication": {
      "properties": {
        "operation": {
          "const": "validate_authentication",
          "default": "validate_authentication",
          "title": "Validate Authentication",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ValidateAuthentication",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_config": "#/$defs/CreateConfig",
          "get_card_details": "#/$defs/GetCardDetails",
          "get_card_url": "#/$defs/GetCardUrl",
          "get_config": "#/$defs/GetConfig",
          "get_config_by_card": "#/$defs/GetConfigByCard",
          "list_cards": "#/$defs/ListCards",
          "list_email_accounts": "#/$defs/ListEmailAccounts",
          "list_workflow_cards": "#/$defs/ListWorkflowCards",
          "list_workspaces": "#/$defs/ListWorkspaces",
          "send_card": "#/$defs/SendCard",
          "validate_authentication": "#/$defs/ValidateAuthentication"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ValidateAuthentication"
        },
        {
          "$ref": "#/$defs/ListWorkspaces"
        },
        {
          "$ref": "#/$defs/ListCards"
        },
        {
          "$ref": "#/$defs/ListEmailAccounts"
        },
        {
          "$ref": "#/$defs/SendCard"
        },
        {
          "$ref": "#/$defs/GetCardUrl"
        },
        {
          "$ref": "#/$defs/CreateConfig"
        },
        {
          "$ref": "#/$defs/GetConfig"
        },
        {
          "$ref": "#/$defs/GetConfigByCard"
        },
        {
          "$ref": "#/$defs/ListWorkflowCards"
        },
        {
          "$ref": "#/$defs/GetCardDetails"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/CardclanIntegrationKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Cardclan Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
