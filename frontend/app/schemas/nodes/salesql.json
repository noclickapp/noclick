{
  "$defs": {
    "BulkEnrichOrganizations": {
      "additionalProperties": false,
      "description": "Enrich up to 100 organizations (10 on Free); returns one result per query.",
      "properties": {
        "operation": {
          "const": "bulk_enrich_organizations",
          "default": "bulk_enrich_organizations",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "organizations": {
          "items": {
            "$ref": "#/$defs/OrganizationQuery"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Organizations",
          "type": "array"
        }
      },
      "required": [
        "organizations"
      ],
      "title": "BulkEnrichOrganizations",
      "type": "object"
    },
    "BulkEnrichPersons": {
      "additionalProperties": false,
      "description": "Enrich up to 100 people (10 on Free); returns one result per query.",
      "properties": {
        "operation": {
          "const": "bulk_enrich_persons",
          "default": "bulk_enrich_persons",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "persons": {
          "items": {
            "$ref": "#/$defs/PersonQuery"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Persons",
          "type": "array"
        }
      },
      "required": [
        "persons"
      ],
      "title": "BulkEnrichPersons",
      "type": "object"
    },
    "BulkVerifyEmails": {
      "additionalProperties": false,
      "description": "Queue up to 500 emails (100 on Free). Only one job per account may run at a time.",
      "properties": {
        "operation": {
          "const": "bulk_verify_emails",
          "default": "bulk_verify_emails",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "emails": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Emails",
          "type": "array"
        }
      },
      "required": [
        "emails"
      ],
      "title": "BulkVerifyEmails",
      "type": "object"
    },
    "EnrichOrganization": {
      "additionalProperties": false,
      "description": "Enrich one company by LinkedIn URL, domain or name. Uses enrichment credits.",
      "properties": {
        "linkedin_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Company LinkedIn URL, for example https://linkedin.com/company/oracle",
          "title": "Linkedin Url"
        },
        "organization_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Name"
        },
        "organization_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Company website domain, for example oracle.com",
          "title": "Organization Domain"
        },
        "operation": {
          "const": "enrich_organization",
          "default": "enrich_organization",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "EnrichOrganization",
      "type": "object"
    },
    "EnrichPerson": {
      "additionalProperties": false,
      "description": "Enrich a person by a complete matching group. Uses enrichment credits.",
      "properties": {
        "linkedin_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Person LinkedIn URL, for example https://linkedin.com/in/bob-christiaanse",
          "title": "Linkedin Url"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "full_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Full Name"
        },
        "organization_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Name"
        },
        "organization_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Domain"
        },
        "operation": {
          "const": "enrich_person",
          "default": "enrich_person",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "match_if_direct_email": {
          "default": false,
          "description": "Require a direct (non-work) email",
          "title": "Match If Direct Email",
          "type": "boolean"
        },
        "match_if_direct_phone": {
          "default": false,
          "description": "Require a direct phone; ignored on the Free plan",
          "title": "Match If Direct Phone",
          "type": "boolean"
        }
      },
      "title": "EnrichPerson",
      "type": "object"
    },
    "GetAllowance": {
      "additionalProperties": false,
      "description": "Read the authenticated account's remaining credits without spending any.",
      "properties": {
        "operation": {
          "const": "get_credit_allowance",
          "default": "get_credit_allowance",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetAllowance",
      "type": "object"
    },
    "GetBulkVerificationJob": {
      "additionalProperties": false,
      "description": "Read a verification job. Follow retry_after seconds until status is completed.",
      "properties": {
        "operation": {
          "const": "get_bulk_verification_job",
          "default": "get_bulk_verification_job",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "job_id": {
          "description": "Job UUID returned by Bulk Verify Emails",
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetBulkVerificationJob",
      "type": "object"
    },
    "LookupPersonByEmail": {
      "additionalProperties": false,
      "description": "Find a person's enriched profile by email. Uses enrichment credits.",
      "properties": {
        "operation": {
          "const": "lookup_person_by_email",
          "default": "lookup_person_by_email",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "LookupPersonByEmail",
      "type": "object"
    },
    "OrganizationQuery": {
      "additionalProperties": false,
      "properties": {
        "linkedin_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Company LinkedIn URL, for example https://linkedin.com/company/oracle",
          "title": "Linkedin Url"
        },
        "organization_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Name"
        },
        "organization_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Company website domain, for example oracle.com",
          "title": "Organization Domain"
        }
      },
      "title": "OrganizationQuery",
      "type": "object"
    },
    "PersonQuery": {
      "additionalProperties": false,
      "properties": {
        "linkedin_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Person LinkedIn URL, for example https://linkedin.com/in/bob-christiaanse",
          "title": "Linkedin Url"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "full_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Full Name"
        },
        "organization_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Name"
        },
        "organization_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Domain"
        }
      },
      "title": "PersonQuery",
      "type": "object"
    },
    "SalesQLAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "salesql_api_key",
          "default": "salesql_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "SALESQL API Key",
      "type": "object",
      "x-credential-instructions": "Create a REST API key in SalesQL Settings \u2192 API Access and paste it here. Use an API key, not an MCP key. Enable enrichment access and verify:verify for email verification. Account and plan limits apply; enrichment and verification use separate credits.",
      "x-credential-type": "api_key",
      "x-credential-url": "https://app.salesql.com/dashboard/enrichment/api"
    },
    "VerifyEmail": {
      "additionalProperties": false,
      "description": "Verify one mailbox synchronously. Costs one verification credit, including cache hits.",
      "properties": {
        "operation": {
          "const": "verify_email",
          "default": "verify_email",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "VerifyEmail",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "bulk_enrich_organizations": "#/$defs/BulkEnrichOrganizations",
          "bulk_enrich_persons": "#/$defs/BulkEnrichPersons",
          "bulk_verify_emails": "#/$defs/BulkVerifyEmails",
          "enrich_organization": "#/$defs/EnrichOrganization",
          "enrich_person": "#/$defs/EnrichPerson",
          "get_bulk_verification_job": "#/$defs/GetBulkVerificationJob",
          "get_credit_allowance": "#/$defs/GetAllowance",
          "lookup_person_by_email": "#/$defs/LookupPersonByEmail",
          "verify_email": "#/$defs/VerifyEmail"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetAllowance"
        },
        {
          "$ref": "#/$defs/EnrichOrganization"
        },
        {
          "$ref": "#/$defs/BulkEnrichOrganizations"
        },
        {
          "$ref": "#/$defs/EnrichPerson"
        },
        {
          "$ref": "#/$defs/LookupPersonByEmail"
        },
        {
          "$ref": "#/$defs/BulkEnrichPersons"
        },
        {
          "$ref": "#/$defs/VerifyEmail"
        },
        {
          "$ref": "#/$defs/BulkVerifyEmails"
        },
        {
          "$ref": "#/$defs/GetBulkVerificationJob"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/SalesQLAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Salesql Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
