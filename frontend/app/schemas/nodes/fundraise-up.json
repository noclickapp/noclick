{
  "$defs": {
    "FundraiseUpAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "fundraise_up_api_key",
          "default": "fundraise_up_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "livemode": {
          "description": "Required: false for test supporter data; true for live data. No fallback.",
          "title": "Live data",
          "type": "boolean"
        },
        "account_id": {
          "description": "Eight-character account ID used to fence returned metadata. Parent keys may read subaccounts.",
          "title": "Account ID",
          "type": "string"
        },
        "check_resource": {
          "default": "supporters",
          "description": "Choose a resource the key has Read permission for in this mode.",
          "enum": [
            "supporters",
            "campaigns",
            "fundraisers",
            "designations"
          ],
          "title": "Connection read resource",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "livemode",
        "account_id"
      ],
      "title": "Fundraise Up API Key",
      "type": "object",
      "x-credential-instructions": "Use an organization-admin-issued Bearer API key. Choose test or live explicitly; permissions are independent and NoClick never switches modes. Campaigns, fundraisers and designations exist only in live mode. Select a permitted read resource for connection checking. Account ID is a local output fence, not an account identity claim. Keys do not expire; old keys created before January 30, 2026 were scheduled for deactivation six months later. No token mint or refresh.",
      "x-credential-url": "https://dashboard.fundraiseup.com/settings/api-keys"
    },
    "FundraiseUpCheckConfig": {
      "additionalProperties": false,
      "description": "Check the chosen mode/resource permission without claiming identity.",
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "FundraiseUpCheckConfig",
      "type": "object"
    },
    "FundraiseUpCreateDesignationConfig": {
      "additionalProperties": false,
      "description": "Create ordinary allocation metadata in the API key's account, with no campaign assignment.",
      "properties": {
        "operation": {
          "const": "create_designation",
          "default": "create_designation",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "description": "Local 500-character bound; provider validates its current constraints.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        }
      },
      "required": [
        "name"
      ],
      "title": "FundraiseUpCreateDesignationConfig",
      "type": "object"
    },
    "FundraiseUpDeleteDesignationConfig": {
      "additionalProperties": false,
      "description": "Delete a non-default designation after checking its current account.",
      "properties": {
        "operation": {
          "const": "delete_designation",
          "default": "delete_designation",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "designation_id": {
          "title": "Designation Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Fundraise Up ID",
            "field_name": "designation_id",
            "placeholder": "Choose resource",
            "searchable": false,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "designation_id"
      ],
      "title": "FundraiseUpDeleteDesignationConfig",
      "type": "object"
    },
    "FundraiseUpGetCampaignConfig": {
      "additionalProperties": false,
      "description": "Read base campaign name/status without modifying assignments.",
      "properties": {
        "operation": {
          "const": "get_campaign",
          "default": "get_campaign",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "campaign_id": {
          "title": "Campaign Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Fundraise Up ID",
            "field_name": "campaign_id",
            "placeholder": "Choose resource",
            "searchable": false,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "campaign_id"
      ],
      "title": "FundraiseUpGetCampaignConfig",
      "type": "object"
    },
    "FundraiseUpGetDesignationConfig": {
      "additionalProperties": false,
      "description": "Read a designation's account, name, code and default status.",
      "properties": {
        "operation": {
          "const": "get_designation",
          "default": "get_designation",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "designation_id": {
          "title": "Designation Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Fundraise Up ID",
            "field_name": "designation_id",
            "placeholder": "Choose resource",
            "searchable": false,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "designation_id"
      ],
      "title": "FundraiseUpGetDesignationConfig",
      "type": "object"
    },
    "FundraiseUpGetFundraiserConfig": {
      "additionalProperties": false,
      "description": "Read a fundraiser with its campaign's current account fence.",
      "properties": {
        "operation": {
          "const": "get_fundraiser",
          "default": "get_fundraiser",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "fundraiser_id": {
          "title": "Fundraiser Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Fundraise Up ID",
            "field_name": "fundraiser_id",
            "placeholder": "Choose resource",
            "searchable": false,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "fundraiser_id"
      ],
      "title": "FundraiseUpGetFundraiserConfig",
      "type": "object"
    },
    "FundraiseUpGetSupporterConfig": {
      "additionalProperties": false,
      "description": "Read an account-fenced supporter, optionally including basic contact fields.",
      "properties": {
        "operation": {
          "const": "get_supporter",
          "default": "get_supporter",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "supporter_id": {
          "title": "Supporter Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Fundraise Up ID",
            "field_name": "supporter_id",
            "placeholder": "Choose resource",
            "searchable": false,
            "auto_select_sole_option": true
          }
        },
        "include_contact": {
          "default": false,
          "title": "Include Contact",
          "type": "boolean"
        }
      },
      "required": [
        "supporter_id"
      ],
      "title": "FundraiseUpGetSupporterConfig",
      "type": "object"
    },
    "FundraiseUpListCampaignsConfig": {
      "additionalProperties": false,
      "description": "List base campaign metadata in live mode.",
      "properties": {
        "limit": {
          "default": 10,
          "description": "One bounded page; API order is newest first.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "starting_after": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last ID of the previous older-record page.",
          "title": "Starting After"
        },
        "ending_before": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First ID for a newer-record page; exclusive with starting_after.",
          "title": "Ending Before"
        },
        "operation": {
          "const": "list_campaigns",
          "default": "list_campaigns",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "FundraiseUpListCampaignsConfig",
      "type": "object"
    },
    "FundraiseUpListDesignationsConfig": {
      "additionalProperties": false,
      "description": "List allocation metadata, including inherited entries only if they match the saved account.",
      "properties": {
        "limit": {
          "default": 10,
          "description": "One bounded page; API order is newest first.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "starting_after": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last ID of the previous older-record page.",
          "title": "Starting After"
        },
        "ending_before": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First ID for a newer-record page; exclusive with starting_after.",
          "title": "Ending Before"
        },
        "operation": {
          "const": "list_designations",
          "default": "list_designations",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "FundraiseUpListDesignationsConfig",
      "type": "object"
    },
    "FundraiseUpListFundraisersConfig": {
      "additionalProperties": false,
      "description": "Read fundraiser metadata; verify each campaign's account before output.",
      "properties": {
        "limit": {
          "default": 10,
          "description": "One bounded page; API order is newest first.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "starting_after": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last ID of the previous older-record page.",
          "title": "Starting After"
        },
        "ending_before": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First ID for a newer-record page; exclusive with starting_after.",
          "title": "Ending Before"
        },
        "operation": {
          "const": "list_fundraisers",
          "default": "list_fundraisers",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "FundraiseUpListFundraisersConfig",
      "type": "object"
    },
    "FundraiseUpListSupportersConfig": {
      "additionalProperties": false,
      "description": "List supporter IDs and creation metadata; contact data is opt-in.",
      "properties": {
        "limit": {
          "default": 10,
          "description": "One bounded page; API order is newest first.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "starting_after": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last ID of the previous older-record page.",
          "title": "Starting After"
        },
        "ending_before": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First ID for a newer-record page; exclusive with starting_after.",
          "title": "Ending Before"
        },
        "operation": {
          "const": "list_supporters",
          "default": "list_supporters",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "include_contact": {
          "default": false,
          "description": "Include name/email/phone only when the workflow needs it. Address/employer/occupation are never returned.",
          "title": "Include Contact",
          "type": "boolean"
        }
      },
      "title": "FundraiseUpListSupportersConfig",
      "type": "object"
    },
    "FundraiseUpUpdateDesignationConfig": {
      "additionalProperties": false,
      "description": "POST a partial name/code update; omitted fields retain their current values.",
      "properties": {
        "operation": {
          "const": "update_designation",
          "default": "update_designation",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "designation_id": {
          "title": "Designation Id",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste Fundraise Up ID",
            "field_name": "designation_id",
            "placeholder": "Choose resource",
            "searchable": false,
            "auto_select_sole_option": true
          }
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set clear_code to remove a code; omission preserves it.",
          "title": "Code"
        },
        "clear_code": {
          "default": false,
          "title": "Clear Code",
          "type": "boolean"
        }
      },
      "required": [
        "designation_id"
      ],
      "title": "FundraiseUpUpdateDesignationConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/FundraiseUpCheckConfig",
          "create_designation": "#/$defs/FundraiseUpCreateDesignationConfig",
          "delete_designation": "#/$defs/FundraiseUpDeleteDesignationConfig",
          "get_campaign": "#/$defs/FundraiseUpGetCampaignConfig",
          "get_designation": "#/$defs/FundraiseUpGetDesignationConfig",
          "get_fundraiser": "#/$defs/FundraiseUpGetFundraiserConfig",
          "get_supporter": "#/$defs/FundraiseUpGetSupporterConfig",
          "list_campaigns": "#/$defs/FundraiseUpListCampaignsConfig",
          "list_designations": "#/$defs/FundraiseUpListDesignationsConfig",
          "list_fundraisers": "#/$defs/FundraiseUpListFundraisersConfig",
          "list_supporters": "#/$defs/FundraiseUpListSupportersConfig",
          "update_designation": "#/$defs/FundraiseUpUpdateDesignationConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FundraiseUpCheckConfig"
        },
        {
          "$ref": "#/$defs/FundraiseUpListSupportersConfig"
        },
        {
          "$ref": "#/$defs/FundraiseUpGetSupporterConfig"
        },
        {
          "$ref": "#/$defs/FundraiseUpListCampaignsConfig"
        },
        {
          "$ref": "#/$defs/FundraiseUpGetCampaignConfig"
        },
        {
          "$ref": "#/$defs/FundraiseUpListFundraisersConfig"
        },
        {
          "$ref": "#/$defs/FundraiseUpGetFundraiserConfig"
        },
        {
          "$ref": "#/$defs/FundraiseUpListDesignationsConfig"
        },
        {
          "$ref": "#/$defs/FundraiseUpGetDesignationConfig"
        },
        {
          "$ref": "#/$defs/FundraiseUpCreateDesignationConfig"
        },
        {
          "$ref": "#/$defs/FundraiseUpUpdateDesignationConfig"
        },
        {
          "$ref": "#/$defs/FundraiseUpDeleteDesignationConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/FundraiseUpAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Fundraise-up Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
