{
  "$defs": {
    "BeachDayApiKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "beach_day_api_key",
          "default": "beach_day_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Beach Day API Key",
      "type": "object",
      "x-credential-instructions": "Paste your API key from the Beach Day API dashboard. Requests use Bearer authentication. Connection testing reads the shared country catalogue and proves key acceptance, not account identity. API calls may consume prepaid credits.",
      "x-credential-url": "https://beachdayapi.com/dashboard/api-keys/"
    },
    "GetBeachAmenitiesConfig": {
      "additionalProperties": false,
      "description": "Get beach amenities.",
      "properties": {
        "operation": {
          "const": "get_beach_amenities",
          "default": "get_beach_amenities",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "id",
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetBeachAmenitiesConfig",
      "type": "object"
    },
    "GetBeachDetailConfig": {
      "additionalProperties": false,
      "description": "Get beach detail.",
      "properties": {
        "operation": {
          "const": "get_beach_detail",
          "default": "get_beach_detail",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "Beach ID.",
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetBeachDetailConfig",
      "type": "object"
    },
    "GetBeachRulesConfig": {
      "additionalProperties": false,
      "description": "Get beach rules.",
      "properties": {
        "operation": {
          "const": "get_beach_rules",
          "default": "get_beach_rules",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "id",
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetBeachRulesConfig",
      "type": "object"
    },
    "GetHealthConfig": {
      "additionalProperties": false,
      "description": "Health check.",
      "properties": {
        "operation": {
          "const": "get_health",
          "default": "get_health",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetHealthConfig",
      "type": "object"
    },
    "GetScoredBeachesConfig": {
      "additionalProperties": false,
      "description": "Get scored beaches.",
      "properties": {
        "operation": {
          "const": "get_scored_beaches",
          "default": "get_scored_beaches",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "offset": {
          "default": 0,
          "description": "Number of results to skip (default: 0).",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 50,
          "description": "Max results per page (default: 50, max: 200).",
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "GetScoredBeachesConfig",
      "type": "object"
    },
    "GetTidePredictionsConfig": {
      "additionalProperties": false,
      "description": "Get tide predictions.",
      "properties": {
        "operation": {
          "const": "get_tide_predictions",
          "default": "get_tide_predictions",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "beach_id": {
          "description": "beach_id",
          "minimum": 1,
          "title": "Beach Id",
          "type": "integer"
        }
      },
      "required": [
        "beach_id"
      ],
      "title": "GetTidePredictionsConfig",
      "type": "object"
    },
    "ListBeachConditionsConfig": {
      "additionalProperties": false,
      "description": "List beach conditions.",
      "properties": {
        "operation": {
          "const": "list_beach_conditions",
          "default": "list_beach_conditions",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "Beach ID.",
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of results to skip (default: 0).",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 30,
          "description": "Max results per page (default: 30, max: 200).",
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "ListBeachConditionsConfig",
      "type": "object"
    },
    "ListBeachesConfig": {
      "additionalProperties": false,
      "description": "List beaches.",
      "properties": {
        "operation": {
          "const": "list_beaches",
          "default": "list_beaches",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by state code, for example CA, FL, HI, or AU-NSW.",
          "title": "State"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by country name (e.g., 'Croatia', 'Greece', 'Thailand', 'French Polynesia', 'New Caledonia', 'Fiji', 'Samoa', 'Tonga', 'New Zealand'). Case-insensitive.",
          "title": "Country"
        },
        "search": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Search beaches by name (case-insensitive, e.g. 'Malibu').",
          "title": "Search"
        },
        "offset": {
          "default": 0,
          "description": "Number of results to skip (default: 0).",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "description": "Max results per page (default: 100, max: 500).",
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "ListBeachesConfig",
      "type": "object"
    },
    "ListCountriesConfig": {
      "additionalProperties": false,
      "description": "List available countries.",
      "properties": {
        "operation": {
          "const": "list_countries",
          "default": "list_countries",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListCountriesConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_beach_amenities": "#/$defs/GetBeachAmenitiesConfig",
          "get_beach_detail": "#/$defs/GetBeachDetailConfig",
          "get_beach_rules": "#/$defs/GetBeachRulesConfig",
          "get_health": "#/$defs/GetHealthConfig",
          "get_scored_beaches": "#/$defs/GetScoredBeachesConfig",
          "get_tide_predictions": "#/$defs/GetTidePredictionsConfig",
          "list_beach_conditions": "#/$defs/ListBeachConditionsConfig",
          "list_beaches": "#/$defs/ListBeachesConfig",
          "list_countries": "#/$defs/ListCountriesConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetHealthConfig"
        },
        {
          "$ref": "#/$defs/ListBeachesConfig"
        },
        {
          "$ref": "#/$defs/GetBeachDetailConfig"
        },
        {
          "$ref": "#/$defs/ListBeachConditionsConfig"
        },
        {
          "$ref": "#/$defs/GetScoredBeachesConfig"
        },
        {
          "$ref": "#/$defs/GetBeachRulesConfig"
        },
        {
          "$ref": "#/$defs/GetBeachAmenitiesConfig"
        },
        {
          "$ref": "#/$defs/GetTidePredictionsConfig"
        },
        {
          "$ref": "#/$defs/ListCountriesConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/BeachDayApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Beach-day-api Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
