      "type": "object",
      "x-credential-instructions": "In Mentortools, open Settings \u2192 Integrations & Automations and create an API key with permission for your selected actions. Paste the key here without Bearer. NoClick sends it to app.mentortools.com as a bearer token. Connecting reads your courses; Get Account reads the key, portal and owner identity.",
      "x-credential-url": "https://app.mentortools.com/public_api/docs"
    },
    "RecordPayment": {
      "additionalProperties": false,
      "description": "Record a payment and unlock courses for a buyer; use stable IDs for retries.",
      "properties": {
        "operation": {
          "const": "record_payment",
          "default": "record_payment",
          "title": "Operation",
          "type": "string"
        },
        "marketplace_buyer": {
          "$ref": "#/$defs/Buyer"
        },
        "course_ids": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Course Ids",
          "type": "array"
        },
        "id": {
          "description": "Reuse this ID for retries; the provider adds the portal prefix if absent.",
          "minLength": 1,
          "title": "External Order ID",
          "type": "string"
        },
        "transaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transaction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "send_email": {
          "default": false,
          "description": "Send the provider's buyer notification email.",
          "title": "Send Email",
          "type": "boolean"
        },
        "billing_type": {
          "default": "single_payment",
          "enum": [
            "single_payment",
            "subscription",
            "installment",
            "free",
            "fake",
            "gift",
            "single_payment_imported",
            "subscription_imported",
            "installment_imported",
            "free_imported",
            "fake_imported",
            "gift_imported"
          ],
          "title": "Billing Type",
          "type": "string"
        },
        "access_until": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Access end Unix timestamp in milliseconds; required for subscriptions.",
          "title": "Access Until"
        },
        "occurred_at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Order Unix timestamp in milliseconds.",
          "title": "Occurred At"
        }
      },
      "required": [
        "marketplace_buyer",
        "course_ids",
        "id"
      ],
      "title": "RecordPayment",
      "type": "object"
    },
    "RecordRefund": {
      "additionalProperties": false,
      "description": "Record an order refund; supply a distinct refund transaction ID for retry deduplication.",
      "properties": {
        "operation": {
