        "mapping": {
          "get_issue": "#/$defs/ForgejoIssueConfig",
          "get_repository": "#/$defs/ForgejoRepositoryConfig",
          "get_user": "#/$defs/ForgejoUserConfig",
          "list_issues": "#/$defs/ForgejoIssuesConfig",
          "list_repositories": "#/$defs/ForgejoRepositoriesConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ForgejoUserConfig"
        },
        {
          "$ref": "#/$defs/ForgejoRepositoriesConfig"
        },
        {
          "$ref": "#/$defs/ForgejoRepositoryConfig"
        },
        {
          "$ref": "#/$defs/ForgejoIssuesConfig"
        },
        {
          "$ref": "#/$defs/ForgejoIssueConfig"
        }
      ],
