          ],
          "default": null,
          "description": "Custom path prefix in your S3 bucket. Uses default prefix if not provided.",
          "title": "S3 Filepath"
        },
        "s3_bucket": {
          "anyOf": [
            {
              "maxLength": 63,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9.\\-]*[a-z0-9]$",
              "type": "string"
