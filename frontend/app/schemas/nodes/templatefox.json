{
  "$defs": {
    "CreateImageConfig": {
      "additionalProperties": false,
      "description": "Generate image from template",
      "properties": {
        "operation": {
          "const": "create_image",
          "default": "create_image",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "template_id": {
          "description": "Template short ID (12 characters)",
          "maxLength": 12,
          "minLength": 12,
          "title": "Template Id",
          "type": "string"
        },
        "modifications": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Modification"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Modify template elements by their layer name (set in the editor's Layers panel). Each item targets a layer and can set its text, image, colors, or visibility. Unknown layer names are skipped and reported in the response `warnings`.",
          "title": "Modifications"
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional key-value data merged into `{{ }}` template variables. For most image templates, prefer `modifications` instead.",
          "title": "Data"
        },
        "format": {
          "default": "png",
          "description": "Output image format: `png` (default), `jpeg` or `webp`.",
          "enum": [
            "png",
            "jpeg",
            "webp"
          ],
          "title": "Format",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 4000.0,
              "minimum": 100.0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Output width in pixels (height follows the template aspect ratio). Defaults to the template's native pixel width.",
          "title": "Width"
        },
        "quality": {
          "default": 85,
          "description": "Compression quality for `jpeg`/`webp` (1-100). Ignored for `png`.",
          "maximum": 100.0,
          "minimum": 1.0,
          "title": "Quality",
          "type": "integer"
        },
        "export_type": {
          "const": "url",
          "default": "url",
          "description": "Return a signed image URL; binary delivery is not exposed.",
          "title": "Export Type",
          "type": "string"
        },
        "expiration": {
          "default": 86400,
          "description": "URL expiration in seconds. Min: 60 (1 min), Max: 604800 (7 days). Only applies to `url` export type.",
          "maximum": 604800.0,
          "minimum": 60.0,
          "title": "Expiration",
          "type": "integer"
        },
        "filename": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9_\\-\\.]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom filename (without extension). If not provided, defaults to 'document'. Only applies to `url` export type.",
          "title": "Filename"
        },
        "store_s3": {
          "default": false,
          "description": "Upload to your configured S3 bucket instead of CDN",
          "title": "Store S3",
          "type": "boolean"
        },
        "s3_filepath": {
          "anyOf": [
            {
              "maxLength": 500,
              "pattern": "^[a-zA-Z0-9_\\-\\./]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom path prefix in your S3 bucket. Uses default prefix if not provided.",
          "title": "S3 Filepath"
        },
        "s3_bucket": {
          "anyOf": [
            {
              "maxLength": 63,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9.\\-]*[a-z0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the default bucket configured in your S3 integration.",
          "title": "S3 Bucket"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional version tag (e.g. `prod`) or version number (e.g. `3`). When omitted, uses the current draft.",
          "title": "Version"
        }
      },
      "required": [
        "template_id"
      ],
      "title": "CreateImageConfig",
      "type": "object"
    },
    "CreatePdfAsyncConfig": {
      "additionalProperties": false,
      "description": "Generate PDF asynchronously",
      "properties": {
        "operation": {
          "const": "create_pdf_async",
          "default": "create_pdf_async",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "template_id": {
          "description": "Template short ID (12 characters)",
          "maxLength": 12,
          "minLength": 12,
          "title": "Template Id",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "description": "Key-value data to render in the template.",
          "title": "Data",
          "type": "object"
        },
        "export_type": {
          "const": "url",
          "default": "url",
          "description": "Export format. Currently only `url` is supported for async.",
          "title": "Export Type",
          "type": "string"
        },
        "expiration": {
          "default": 86400,
          "description": "URL expiration in seconds (60-604800). Default: 86400 (24 hours).",
          "maximum": 604800.0,
          "minimum": 60.0,
          "title": "Expiration",
          "type": "integer"
        },
        "filename": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9_\\-\\.]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom filename for the PDF (without .pdf extension).",
          "title": "Filename"
        },
        "store_s3": {
          "default": false,
          "description": "Upload to your configured S3 bucket instead of CDN.",
          "title": "Store S3",
          "type": "boolean"
        },
        "s3_filepath": {
          "anyOf": [
            {
              "maxLength": 500,
              "pattern": "^[a-zA-Z0-9_\\-\\./]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom path prefix in your S3 bucket.",
          "title": "S3 Filepath"
        },
        "s3_bucket": {
          "anyOf": [
            {
              "maxLength": 63,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9.\\-]*[a-z0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the default bucket configured in your S3 integration.",
          "title": "S3 Bucket"
        },
        "webhook_url": {
          "anyOf": [
            {
              "maxLength": 2083,
              "minLength": 1,
              "pattern": "^https://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL to receive POST notification when job completes or fails. Must be a public HTTPS URL.",
          "title": "Webhook Url"
        },
        "webhook_secret": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Secret for HMAC-SHA256 signing of webhook payloads (min 16 chars).",
          "title": "Webhook Secret",
          "ui:widget": "password"
        },
        "pdf_variant": {
          "anyOf": [
            {
              "enum": [
                "pdf/a-1b",
                "pdf/a-2b",
                "pdf/a-3b"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Generate a standards-compliant PDF variant. Use `pdf/a-3b` for archival compliance (most common). Use `pdf/a-3b` if you need file attachments (e.g. Factur-X). When not set, a standard PDF is generated.",
          "title": "Pdf Variant",
          "enum": [
            "pdf/a-1b",
            "pdf/a-2b",
            "pdf/a-3b"
          ],
          "x-enum-searchable": true
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional version tag (e.g. `prod`) or version number (e.g. `3`). When omitted, uses the template's default version if set, otherwise the current draft.",
          "title": "Version"
        }
      },
      "required": [
        "template_id",
        "data"
      ],
      "title": "CreatePdfAsyncConfig",
      "type": "object"
    },
    "CreatePdfConfig": {
      "additionalProperties": false,
