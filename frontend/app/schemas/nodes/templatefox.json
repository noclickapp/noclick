          "get_template_layers": "#/$defs/GetTemplateLayersConfig",
          "list_pdf_jobs": "#/$defs/ListPdfJobsConfig",
          "list_template_versions": "#/$defs/ListTemplateVersionsConfig",
          "list_templates": "#/$defs/ListTemplatesConfig",
          "list_transactions": "#/$defs/ListTransactionsConfig",
          "merge_pdf": "#/$defs/MergePdfConfig",
          "rotate_pdf": "#/$defs/RotatePdfConfig",
          "update_template_version": "#/$defs/UpdateTemplateVersionConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CreatePdfConfig"
        },
        {
          "$ref": "#/$defs/CreateImageConfig"
        },
        {
          "$ref": "#/$defs/CreatePdfAsyncConfig"
        },
        {
          "$ref": "#/$defs/GetPdfJobConfig"
        },
        {
          "$ref": "#/$defs/ListPdfJobsConfig"
        },
        {
          "$ref": "#/$defs/MergePdfConfig"
        },
        {
          "$ref": "#/$defs/ExtractPdfPagesConfig"
        },
        {
          "$ref": "#/$defs/RotatePdfConfig"
        },
        {
          "$ref": "#/$defs/ListTemplatesConfig"
        },
        {
          "$ref": "#/$defs/GetTemplateFieldsConfig"
        },
        {
          "$ref": "#/$defs/GetTemplateLayersConfig"
        },
        {
          "$ref": "#/$defs/ListTemplateVersionsConfig"
        },
        {
          "$ref": "#/$defs/CreateTemplateVersionConfig"
        },
        {
          "$ref": "#/$defs/DeleteTemplateVersionConfig"
        },
        {
          "$ref": "#/$defs/UpdateTemplateVersionConfig"
        },
        {
          "$ref": "#/$defs/GetAccountConfig"
        },
        {
          "$ref": "#/$defs/ListTransactionsConfig"
