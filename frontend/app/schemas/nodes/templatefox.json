            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the default bucket configured in your S3 integration.",
          "title": "S3 Bucket"
        },
        "pdf_variant": {
          "anyOf": [
            {
              "enum": [
                "pdf/a-1b",
                "pdf/a-2b",
                "pdf/a-3b"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Generate a standards-compliant PDF variant. Use `pdf/a-2b` for archival compliance (most common). Use `pdf/a-3b` if you need file attachments (e.g. Factur-X, ZUGFeRD). When not set, a standard PDF is generated.",
          "title": "Pdf Variant",
          "enum": [
            "pdf/a-1b",
            "pdf/a-2b",
            "pdf/a-3b"
          ],
          "x-enum-searchable": true
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional version tag (e.g. `prod`) or version number (e.g. `3`). When omitted, uses the current draft.",
          "title": "Version"
        }
      },
      "required": [
        "template_id",
        "data"
      ],
      "title": "CreatePdfConfig",
      "type": "object"
    },
    "CreateTemplateVersionConfig": {
      "additionalProperties": false,
      "description": "Create a version snapshot",
      "properties": {
        "operation": {
          "const": "create_template_version",
          "default": "create_template_version",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "template_id": {
          "description": "Template short ID (12 characters)",
          "title": "Template Id",
          "type": "string"
        },
        "tag": {
          "description": "Version tag (e.g. 'prod', 'staging', 'v1'). Lowercase alphanumeric with hyphens/underscores, 2-50 chars.",
          "maxLength": 50,
          "minLength": 2,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,48}[a-z0-9]$",
          "title": "Tag",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional description for this version",
          "title": "Description"
        }
      },
      "required": [
        "template_id",
        "tag"
      ],
      "title": "CreateTemplateVersionConfig",
      "type": "object"
    },
    "DeleteTemplateVersionConfig": {
      "additionalProperties": false,
      "description": "Delete a version",
      "properties": {
        "operation": {
          "const": "delete_template_version",
          "default": "delete_template_version",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "template_id": {
          "description": "Template short ID",
          "title": "Template Id",
          "type": "string"
        },
        "version_number": {
          "description": "Version number to delete",
          "title": "Version Number",
          "type": "integer"
        }
      },
      "required": [
        "template_id",
        "version_number"
      ],
      "title": "DeleteTemplateVersionConfig",
      "type": "object"
    },
    "ExtractPdfPagesConfig": {
      "additionalProperties": false,
      "description": "Extract pages from a PDF",
      "properties": {
        "operation": {
          "const": "extract_pdf_pages",
          "default": "extract_pdf_pages",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "export_type": {
          "const": "url",
          "default": "url",
          "description": "Return a signed PDF URL; binary delivery is not exposed.",
          "title": "Export Type",
          "type": "string"
        },
        "expiration": {
          "default": 86400,
          "description": "URL expiration in seconds. Min 60, max 604800. Only applies to `url` export type.",
          "maximum": 604800.0,
          "minimum": 60.0,
          "title": "Expiration",
          "type": "integer"
        },
        "filename": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9_\\-\\.]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom filename (without `.pdf`). Defaults to a generic name.",
          "title": "Filename"
        },
        "pdf_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public HTTPS URL to download the PDF from",
          "title": "Pdf Url"
        },
        "pdf_base64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PDF file encoded as a base64 string",
          "title": "Pdf Base64"
        },
        "pages": {
          "description": "1-indexed page selection. Supports ranges and singles separated by commas, e.g. `1-3, 5, 7-9`. Order is preserved (`5,1,3` outputs those 3 pages in that order).",
          "title": "Pages",
          "type": "string"
        }
      },
      "required": [
        "pages"
      ],
      "title": "ExtractPdfPagesConfig",
      "type": "object"
    },
