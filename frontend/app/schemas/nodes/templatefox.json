        },
        "limit": {
          "default": 300,
          "description": "Number of records to return",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of records to skip",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "title": "ListTransactionsConfig",
      "type": "object"
    },
    "MergePdfConfig": {
      "additionalProperties": false,
      "description": "Merge PDFs",
      "properties": {
        "operation": {
          "const": "merge_pdf",
          "default": "merge_pdf",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "export_type": {
          "const": "url",
          "default": "url",
          "description": "Return a signed PDF URL; binary delivery is not exposed.",
          "title": "Export Type",
          "type": "string"
        },
        "expiration": {
          "default": 86400,
          "description": "URL expiration in seconds. Min 60, max 604800. Only applies to `url` export type.",
          "maximum": 604800.0,
          "minimum": 60.0,
          "title": "Expiration",
          "type": "integer"
        },
        "filename": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9_\\-\\.]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom filename (without `.pdf`). Defaults to a generic name.",
          "title": "Filename"
        },
        "pdfs": {
          "description": "Ordered list of PDFs to merge. Each entry has either `pdf_url` or `pdf_base64`. Minimum 2.",
          "items": {
            "$ref": "#/$defs/PdfInput"
          },
          "minItems": 2,
          "title": "Pdfs",
          "type": "array"
        }
      },
      "required": [
        "pdfs"
      ],
      "title": "MergePdfConfig",
      "type": "object"
    },
    "Modification": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Name of the layer to modify (set via the editor's Layers panel). Matched against the element's `data-layer-name`, falling back to its `id`.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replace the element's text content. Rendered as literal text (HTML and `{{ }}` are not interpreted).",
          "title": "Text"
        },
        "image_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "pattern": "^https?://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set the image source. For an `<img>` element this sets `src`; for any other element it sets a `background-image`.",
          "title": "Image Url"
        },
        "color": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CSS color applied to the element's text (`color`).",
          "title": "Color"
        },
        "background": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CSS color applied to the element's background (`background-color`).",
          "title": "Background"
        },
        "hidden": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hide (`true`) or show (`false`) the element.",
          "title": "Hidden"
        }
      },
      "required": [
        "name"
      ],
      "title": "Modification",
      "type": "object"
    },
    "PdfInput": {
      "additionalProperties": false,
      "properties": {
        "pdf_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public HTTPS URL to download the PDF from",
          "title": "Pdf Url"
        },
        "pdf_base64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PDF file encoded as a base64 string",
          "title": "Pdf Base64"
        }
      },
      "title": "PdfInput",
      "type": "object"
    },
    "RotatePdfConfig": {
      "additionalProperties": false,
      "description": "Rotate pages of a PDF",
      "properties": {
        "operation": {
          "const": "rotate_pdf",
          "default": "rotate_pdf",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "export_type": {
          "const": "url",
          "default": "url",
          "description": "Return a signed PDF URL; binary delivery is not exposed.",
          "title": "Export Type",
          "type": "string"
        },
        "expiration": {
          "default": 86400,
          "description": "URL expiration in seconds. Min 60, max 604800. Only applies to `url` export type.",
          "maximum": 604800.0,
          "minimum": 60.0,
          "title": "Expiration",
          "type": "integer"
        },
        "filename": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9_\\-\\.]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom filename (without `.pdf`). Defaults to a generic name.",
          "title": "Filename"
        },
        "pdf_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public HTTPS URL to download the PDF from",
          "title": "Pdf Url"
        },
        "pdf_base64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PDF file encoded as a base64 string",
          "title": "Pdf Base64"
        },
        "rotation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rotation in degrees applied to every page. Must be 0, 90, 180 or 270. Cumulative with the page's existing rotation.",
          "title": "Rotation"
        },
        "page_rotations": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-indexed map of page number to rotation in degrees (0/90/180/270). Cumulative with the page's existing rotation. Use this OR `rotation`, not both.",
          "title": "Page Rotations"
        }
      },
      "title": "RotatePdfConfig",
      "type": "object"
    },
    "TemplatefoxAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "templatefox_api_key",
          "default": "templatefox_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "TemplateFox API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the TemplateFox dashboard API Keys section. Paste the key alone. NoClick sends it in x-api-key and checks your account email and credits.",
      "x-credential-url": "https://app.templatefox.com/"
    },
    "UpdateTemplateVersionConfig": {
      "additionalProperties": false,
      "description": "Update a version",
      "properties": {
        "operation": {
          "const": "update_template_version",
          "default": "update_template_version",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "template_id": {
          "description": "Template short ID",
          "title": "Template Id",
          "type": "string"
        },
        "version_number": {
          "description": "Version number to update",
          "title": "Version Number",
          "type": "integer"
        },
        "tag": {
          "anyOf": [
            {
              "maxLength": 50,
              "pattern": "^[a-z0-9][a-z0-9_-]{0,48}[a-z0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "template_id",
        "version_number"
      ],
      "title": "UpdateTemplateVersionConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_image": "#/$defs/CreateImageConfig",
          "create_pdf": "#/$defs/CreatePdfConfig",
          "create_pdf_async": "#/$defs/CreatePdfAsyncConfig",
          "create_template_version": "#/$defs/CreateTemplateVersionConfig",
          "delete_template_version": "#/$defs/DeleteTemplateVersionConfig",
          "extract_pdf_pages": "#/$defs/ExtractPdfPagesConfig",
