          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_base_url": {
          "description": "Public HTTPS origin, for example https://my-deployment.kb.us-east-1.aws.elastic.cloud. Include a port if needed; omit paths and /app.",
