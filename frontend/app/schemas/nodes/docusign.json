{
  "$defs": {
    "CreateFromTemplate": {
      "description": "Create a draft or send an envelope from a reusable template.",
      "properties": {
        "operation": {
          "const": "create_from_template",
          "default": "create_from_template",
          "title": "Send From Template",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Envelopes",
          "x-creates-resource": true,
          "x-display-name": "Send From Template",
          "x-is-trigger": false,
          "x-resource-id-path": "data.envelopeId",
          "x-resource-type": "docusign_envelope"
        },
        "template_id": {
          "title": "Template",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Or paste template ID",
            "field_name": "template_id",
            "placeholder": "Select a template\u2026",
            "searchable": true,
            "auto_select_sole_option": true
          }
        },
        "signer_name": {
          "title": "Signer Name",
          "type": "string"
        },
        "signer_email": {
          "title": "Signer Email",
          "type": "string"
        },
        "role_name": {
          "default": "Signer",
          "title": "Template Role Name",
          "type": "string"
        },
        "email_subject": {
          "default": "Please sign this document",
          "title": "Email Subject",
          "type": "string"
        },
        "send_now": {
          "default": true,
          "description": "Turn off to create a draft",
          "title": "Send Now",
          "type": "boolean"
        }
      },
      "required": [
        "template_id",
        "signer_name",
        "signer_email"
      ],
      "title": "CreateFromTemplate",
      "type": "object"
    },
    "DocusignOAuthCredential": {
      "properties": {
        "credential_type": {
          "const": "docusign_oauth",
          "default": "docusign_oauth",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "title": "Access Token",
          "type": "string"
        },
        "refresh_token": {
          "title": "Refresh Token",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Expiry"
        },
        "account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account ID"
        },
        "account_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Name"
        },
        "base_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account API Base URI"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        }
      },
      "required": [
        "access_token",
        "refresh_token"
      ],
      "title": "Docusign OAuth",
      "type": "object",
      "x-credential-type": "oauth",
      "x-credential-url": "https://apps.docusign.com/admin/apps-and-keys",
      "x-oauth-provider": "docusign",
      "x-oauth-scopes": [
        "extended",
        "signature"
      ]
    },
    "DownloadDocument": {
      "description": "Download a signed PDF as a file for downstream workflow steps.",
      "properties": {
        "operation": {
          "const": "download_document",
          "default": "download_document",
          "title": "Download Signed Document",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Documents",
          "x-display-name": "Download Signed Document",
          "x-is-trigger": false
        },
        "envelope_id": {
          "title": "Envelope ID",
          "type": "string"
        },
        "document_id": {
          "default": "combined",
          "description": "Use combined for one signed PDF",
          "title": "Document ID",
          "type": "string"
        }
      },
      "required": [
        "envelope_id"
      ],
      "title": "DownloadDocument",
      "type": "object"
    },
    "GetAccount": {
      "description": "Read the connected eSignature account settings.",
      "properties": {
        "operation": {
          "const": "get_account",
          "default": "get_account",
          "title": "Get Account",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Account",
          "x-display-name": "Get Account",
          "x-is-trigger": false
        }
      },
      "title": "GetAccount",
      "type": "object"
    },
    "GetEnvelope": {
      "description": "Read the current envelope status and details.",
      "properties": {
        "operation": {
          "const": "get_envelope",
          "default": "get_envelope",
          "title": "Get Envelope",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Envelopes",
          "x-display-name": "Get Envelope",
          "x-is-trigger": false
        },
        "envelope_id": {
          "title": "Envelope ID",
          "type": "string"
        }
      },
      "required": [
        "envelope_id"
      ],
      "title": "GetEnvelope",
      "type": "object"
    },
    "GetTemplate": {
      "description": "Get a template's details and recipient roles.",
      "properties": {
        "operation": {
          "const": "get_template",
          "default": "get_template",
          "title": "Get Template",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Templates",
          "x-display-name": "Get Template",
          "x-is-trigger": false
        },
        "template_id": {
          "title": "Template",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Or paste template ID",
            "field_name": "template_id",
            "placeholder": "Select a template\u2026",
            "searchable": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "template_id"
      ],
      "title": "GetTemplate",
      "type": "object"
    },
    "ListDocuments": {
      "description": "List documents and certificates attached to an envelope.",
      "properties": {
        "operation": {
          "const": "list_documents",
          "default": "list_documents",
          "title": "List Envelope Documents",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Documents",
          "x-display-name": "List Envelope Documents",
          "x-is-trigger": false
        },
        "envelope_id": {
          "title": "Envelope ID",
          "type": "string"
        }
      },
      "required": [
        "envelope_id"
      ],
      "title": "ListDocuments",
      "type": "object"
    },
    "ListEnvelopes": {
      "description": "List envelopes changed since an ISO 8601 timestamp.",
      "properties": {
        "operation": {
          "const": "list_envelopes",
          "default": "list_envelopes",
          "title": "List Recent Envelopes",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Envelopes",
          "x-display-name": "List Recent Envelopes",
          "x-is-trigger": false
        },
        "from_date": {
          "description": "ISO 8601 timestamp, for example 2026-01-01T00:00:00Z",
          "title": "From Date",
          "type": "string"
        },
        "count": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Maximum Results",
          "type": "integer"
        }
      },
      "required": [
        "from_date"
      ],
      "title": "ListEnvelopes",
      "type": "object"
    },
    "ListRecipients": {
      "description": "Read signer and recipient status for an envelope.",
      "properties": {
        "operation": {
          "const": "list_recipients",
          "default": "list_recipients",
          "title": "List Recipients",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Envelopes",
          "x-display-name": "List Recipients",
          "x-is-trigger": false
        },
        "envelope_id": {
          "title": "Envelope ID",
          "type": "string"
        }
      },
      "required": [
        "envelope_id"
      ],
      "title": "ListRecipients",
      "type": "object"
    },
    "ListTemplates": {
      "description": "List reusable templates in the connected account.",
      "properties": {
        "operation": {
          "const": "list_templates",
          "default": "list_templates",
          "title": "List Templates",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Templates",
          "x-display-name": "List Templates",
          "x-is-trigger": false
        },
        "count": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Maximum Results",
          "type": "integer"
        }
      },
      "title": "ListTemplates",
      "type": "object"
    },
    "SendDocument": {
      "description": "Create a draft or send a PDF with an anchor-positioned signature field.",
      "properties": {
        "operation": {
          "const": "send_document",
          "default": "send_document",
          "title": "Send Document for Signature",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Envelopes",
          "x-creates-resource": true,
          "x-display-name": "Send Document for Signature",
          "x-is-trigger": false,
          "x-resource-id-path": "data.envelopeId",
          "x-resource-type": "docusign_envelope"
        },
        "document_base64": {
          "description": "Base64 PDF content, optionally from an upstream node",
          "title": "Document (Base64)",
          "type": "string"
        },
        "document_name": {
          "default": "Document.pdf",
          "title": "Document Name",
          "type": "string"
        },
        "signer_name": {
          "title": "Signer Name",
          "type": "string"
        },
        "signer_email": {
          "title": "Signer Email",
          "type": "string"
        },
        "email_subject": {
          "default": "Please sign this document",
          "title": "Email Subject",
          "type": "string"
        },
        "anchor_string": {
          "default": "/sig1/",
          "description": "Text in the PDF marking where the signature goes",
          "title": "Signature Anchor",
          "type": "string"
        },
        "send_now": {
          "default": true,
          "description": "Turn off to create a draft",
          "title": "Send Now",
          "type": "boolean"
        }
      },
      "required": [
        "document_base64",
        "signer_name",
        "signer_email"
      ],
      "title": "SendDocument",
      "type": "object"
    },
    "VoidEnvelope": {
      "description": "Void an in-progress envelope and notify its recipients of the reason.",
      "properties": {
        "operation": {
          "const": "void_envelope",
          "default": "void_envelope",
          "title": "Void Envelope",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Envelopes",
          "x-display-name": "Void Envelope",
          "x-is-trigger": false
        },
        "envelope_id": {
          "title": "Envelope ID",
          "type": "string"
        },
        "reason": {
          "description": "Shown to recipients",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "envelope_id",
        "reason"
      ],
      "title": "VoidEnvelope",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_from_template": "#/$defs/CreateFromTemplate",
          "download_document": "#/$defs/DownloadDocument",
          "get_account": "#/$defs/GetAccount",
          "get_envelope": "#/$defs/GetEnvelope",
          "get_template": "#/$defs/GetTemplate",
          "list_documents": "#/$defs/ListDocuments",
          "list_envelopes": "#/$defs/ListEnvelopes",
          "list_recipients": "#/$defs/ListRecipients",
          "list_templates": "#/$defs/ListTemplates",
          "send_document": "#/$defs/SendDocument",
          "void_envelope": "#/$defs/VoidEnvelope"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetAccount"
        },
        {
          "$ref": "#/$defs/ListTemplates"
        },
        {
          "$ref": "#/$defs/GetTemplate"
        },
        {
          "$ref": "#/$defs/CreateFromTemplate"
        },
        {
          "$ref": "#/$defs/SendDocument"
        },
        {
          "$ref": "#/$defs/GetEnvelope"
        },
        {
          "$ref": "#/$defs/ListEnvelopes"
        },
        {
          "$ref": "#/$defs/ListRecipients"
        },
        {
          "$ref": "#/$defs/ListDocuments"
        },
        {
          "$ref": "#/$defs/DownloadDocument"
        },
        {
          "$ref": "#/$defs/VoidEnvelope"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocusignOAuthCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Docusign Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "List my Docusign templates",
    "Send a Docusign template for signature",
    "Check the status of a Docusign envelope",
    "Download a completed signed document"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
