    "AddShadow": {
      "additionalProperties": false,
      "properties": {
        "size": {
          "default": "preview",
          "description": "Preview costs 0.25 credits; full costs 1 credit. Auto uses the highest resolution available for the image and balance.",
          "enum": [
            "preview",
            "full",
            "auto"
          ],
          "title": "Size",
          "type": "string"
        },
        "format": {
          "default": "auto",
          "enum": [
            "auto",
            "png",
            "jpg",
            "zip",
            "webp"
          ],
          "title": "Format",
          "type": "string"
        },
        "type": {
          "default": "auto",
          "enum": [
            "auto",
            "car",
            "product",
            "person",
            "animal",
            "graphic",
            "transportation"
          ],
          "title": "Type",
          "type": "string"
        },
        "semitransparency": {
          "default": true,
          "title": "Semitransparency",
          "type": "boolean"
        },
        "roi": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Region of interest, e.g. \"0% 0% 100% 100%\".",
          "title": "Roi"
        },
        "image_url": {
          "description": "Public source JPG, PNG or WebP URL; remove.bg downloads it. Maximum 22 MB and 50 megapixels.",
          "format": "uri",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Image Url",
          "type": "string"
        },
        "operation": {
          "const": "add_shadow",
          "default": "add_shadow",
          "title": "Add Subject Shadow",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Add Subject Shadow",
          "x-is-trigger": false
        },
        "shadow_type": {
          "default": "auto",
          "enum": [
            "auto",
            "car",
            "3D",
            "drop",
            "none"
          ],
          "title": "Shadow Type",
          "type": "string"
        },
        "shadow_opacity": {
          "default": "auto",
          "description": "auto or an opacity from 0 to 100.",
          "maxLength": 16,
          "title": "Shadow Opacity",
          "type": "string"
        }
      },
      "required": [
        "image_url"
      ],
      "title": "AddShadow",
      "type": "object"
    },
