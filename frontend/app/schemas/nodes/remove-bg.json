  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_shadow": "#/$defs/AddShadow",
          "create_alpha_mask": "#/$defs/CreateAlphaMask",
          "crop_to_subject": "#/$defs/CropToSubject",
          "get_account": "#/$defs/GetAccount",
          "remove_background": "#/$defs/RemoveBackground",
          "remove_background_base64": "#/$defs/RemoveBackgroundBase64",
          "replace_background_color": "#/$defs/ReplaceBackgroundColor",
          "replace_background_image": "#/$defs/ReplaceBackgroundImage",
          "resize_subject": "#/$defs/ResizeSubject",
          "submit_improvement": "#/$defs/SubmitImprovement"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetAccount"
        },
        {
          "$ref": "#/$defs/RemoveBackground"
        },
        {
          "$ref": "#/$defs/RemoveBackgroundBase64"
        },
        {
          "$ref": "#/$defs/CreateAlphaMask"
        },
        {
          "$ref": "#/$defs/ReplaceBackgroundColor"
        },
        {
          "$ref": "#/$defs/ReplaceBackgroundImage"
        },
        {
          "$ref": "#/$defs/CropToSubject"
        },
        {
          "$ref": "#/$defs/ResizeSubject"
        },
        {
          "$ref": "#/$defs/AddShadow"
        },
        {
          "$ref": "#/$defs/SubmitImprovement"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemoveBgAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Remove-bg Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
