{
  "$defs": {
    "GetDNSRecord": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to domain names and DNS record owner names. DNS values, notes, IPs and private account/settings fields are always omitted.",
          "title": "Include Domain and Record Names",
          "type": "boolean"
        },
        "domain": {
          "description": "Exact lowercase ASCII/punycode domain from the current catalog. Internally use the documented exact-domain catalog filter and independent detail read before child reads.",
          "maxLength": 253,
          "minLength": 3,
          "title": "Catalog Domain",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste an exact catalog domain",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "get_dns_record",
          "default": "get_dns_record",
          "description": "Bind a record to the current domain's record catalog and verify the independently returned records array contains exactly that record. No record values or changes.",
          "title": "Get DNS Record Metadata",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Domain Metadata",
          "x-display-name": "Get DNS Record Metadata",
          "x-is-trigger": false
        },
        "record_id": {
          "description": "Numeric string ID from this domain's current DNS record catalog, not an integer or URL.",
          "maxLength": 40,
          "minLength": 1,
          "title": "Catalog DNS Record ID",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste an exact domain record ID",
            "depends_on": "domain"
          }
        }
      },
      "required": [
        "domain",
        "record_id"
      ],
      "title": "GetDNSRecord",
      "type": "object"
    },
    "GetDomain": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to domain names and DNS record owner names. DNS values, notes, IPs and private account/settings fields are always omitted.",
          "title": "Include Domain and Record Names",
          "type": "boolean"
        },
        "domain": {
          "description": "Exact lowercase ASCII/punycode domain from the current catalog. Internally use the documented exact-domain catalog filter and independent detail read before child reads.",
          "maxLength": 253,
          "minLength": 3,
          "title": "Catalog Domain",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste an exact catalog domain",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "get_domain",
          "default": "get_domain",
          "description": "Read the current catalog-bound domain's status, TLD and documented date strings. No privacy, security, renewal or delegation settings.",
          "title": "Get Domain Metadata",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Domain Metadata",
          "x-display-name": "Get Domain Metadata",
          "x-is-trigger": false
        }
      },
      "required": [
        "domain"
      ],
      "title": "GetDomain",
      "type": "object"
    },
    "ListDNSRecords": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to domain names and DNS record owner names. DNS values, notes, IPs and private account/settings fields are always omitted.",
          "title": "Include Domain and Record Names",
          "type": "boolean"
        },
        "max_results": {
          "default": 20,
          "description": "Strict integer 1\u2013100 local output cap. This is not a provider page size or account total.",
          "maximum": 100,
          "minimum": 1,
          "title": "Maximum Results",
          "type": "integer"
        },
        "domain": {
          "description": "Exact lowercase ASCII/punycode domain from the current catalog. Internally use the documented exact-domain catalog filter and independent detail read before child reads.",
          "maxLength": 253,
          "minLength": 3,
          "title": "Catalog Domain",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "custom_placeholder": "Paste an exact catalog domain",
            "auto_select_sole_option": true
          }
        },
        "operation": {
          "const": "list_dns_records",
          "default": "list_dns_records",
          "description": "Read editable records for the protected domain; SOA and Porkbun default NS are excluded by this API. No DNS pagination is invented. RDATA is never emitted.",
          "title": "List DNS Record Metadata",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Domain Metadata",
          "x-display-name": "List DNS Record Metadata",
          "x-is-trigger": false
        }
      },
      "required": [
        "domain"
      ],
      "title": "ListDNSRecords",
      "type": "object"
    },
    "ListDomains": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to domain names and DNS record owner names. DNS values, notes, IPs and private account/settings fields are always omitted.",
          "title": "Include Domain and Record Names",
          "type": "boolean"
        },
        "max_results": {
          "default": 20,
          "description": "Strict integer 1\u2013100 local output cap. This is not a provider page size or account total.",
          "maximum": 100,
          "minimum": 1,
          "title": "Maximum Results",
          "type": "integer"
        },
        "operation": {
          "const": "list_domains",
          "default": "list_domains",
          "description": "Read one protected domain catalog page. Its count describes this page, not the account. Completion remains unknown.",
          "title": "List Domain Metadata",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Domain Metadata",
          "x-display-name": "List Domain Metadata",
          "x-is-trigger": false
        },
        "start": {
          "default": 0,
          "description": "Documented zero-based start. Porkbun can return up to 1000 domains; only the local maximum is emitted. No next cursor or global completeness is inferred.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Domain Start Offset",
          "type": "integer"
        }
      },
      "title": "ListDomains",
      "type": "object"
    },
    "PorkbunCredential": {
      "properties": {
        "credential_type": {
          "const": "porkbun_api_key",
          "default": "porkbun_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "secret_api_key": {
          "title": "Secret API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key",
        "secret_api_key"
      ],
      "title": "PorkbunCredential",
      "type": "object",
      "x-credential-help-url": "https://kb.porkbun.com/article/307-getting-started-porkbun-api",
      "x-credential-instructions": "Supply the existing API key and secret API key. Both are sent only in HTTPS headers to api.porkbun.com. Protected catalog reachability is not human identity or account ownership. No key issuance, body/query credentials, OAuth, alternate host or automatic refresh. Keys and domain API access must already be enabled by their owner.",
      "x-credential-type": "porkbun_api_key"
    },
    "PorkbunMcpCredential": {
      "description": "Porkbun connected through Porkbun's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "porkbun_mcp",
          "default": "porkbun_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "Porkbun MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://mcp.porkbun.com/mcp",
      "x-mcp-transport": "shttp"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_dns_record": "#/$defs/GetDNSRecord",
          "get_domain": "#/$defs/GetDomain",
          "list_dns_records": "#/$defs/ListDNSRecords",
          "list_domains": "#/$defs/ListDomains"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListDomains"
        },
        {
          "$ref": "#/$defs/GetDomain"
        },
        {
          "$ref": "#/$defs/ListDNSRecords"
        },
        {
          "$ref": "#/$defs/GetDNSRecord"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/PorkbunCredential"
        },
        {
          "$ref": "#/$defs/PorkbunMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    },
    "node_type": {
      "const": "automation-porkbun",
      "default": "automation-porkbun",
      "title": "Node Type",
      "type": "string"
    }
  },
  "required": [
    "config"
  ],
  "title": "Porkbun Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
