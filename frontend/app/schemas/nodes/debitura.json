{
  "$defs": {
    "ClaimLine": {
      "additionalProperties": false,
      "properties": {
        "dueDate": {
          "description": "Payment deadline of this invoice.",
          "format": "date-time",
          "title": "Duedate",
          "type": "string"
        },
        "amount": {
          "description": "The outstanding balance on this invoice in the case currency \u2014 what the debtor still owes on it,",
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional: your own invoice number for this line. Used only to make validation errors readable",
          "title": "Reference"
        }
      },
      "required": [
        "dueDate",
        "amount"
      ],
      "title": "ClaimLine",
      "type": "object"
    },
    "DebituraAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "debitura_api_key",
          "default": "debitura_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Debitura API Key",
      "type": "object",
      "x-credential-instructions": "In the Debitura Client Portal, open API Keys and generate a key for your own creditor account. Paste the key below. NoClick sends it in the XApiKey header and verifies it by reading your creditor profile. Referral partner tokens are not supported.",
      "x-credential-url": "https://app.debitura.com/CreditorApiKey"
    },
    "DebituraArchiveDivisionConfig": {
      "additionalProperties": false,
      "description": "Archive a division.",
      "properties": {
        "operation": {
          "const": "archive_division",
          "default": "archive_division",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "division_id": {
          "format": "uuid",
          "title": "Division Id",
          "type": "string"
        }
      },
      "required": [
        "division_id"
      ],
      "title": "DebituraArchiveDivisionConfig",
      "type": "object"
    },
    "DebituraCheckEligibilityConfig": {
      "additionalProperties": false,
      "description": "Check case eligibility and get assigned partner.",
      "properties": {
        "countryAlpha2": {
          "description": "Debtor country (2-letter ISO code, e.g., \"DK\", \"US\", \"DE\")",
          "minLength": 1,
          "title": "Countryalpha2",
          "type": "string"
        },
        "stateAlpha2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "US state code for US debtors (e.g., \"CA\", \"NY\"). Required if CountryAlpha2 = \"US\"",
          "title": "Statealpha2"
        },
        "debtorType": {
          "description": "Debtor type: \"Company\" or \"Private\"",
          "minLength": 1,
          "title": "Debtortype",
          "type": "string"
        },
        "amount": {
          "description": "Amount to recover in specified currency",
          "maximum": 1.7976931348623157e+308,
          "minimum": 0.01,
          "title": "Amount",
          "type": "number"
        },
        "currencyCode": {
          "description": "Currency code (e.g., \"USD\", \"EUR\", \"DKK\")",
          "minLength": 1,
          "title": "Currencycode",
          "type": "string"
        },
        "operation": {
          "const": "check_eligibility",
          "default": "check_eligibility",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "countryAlpha2",
        "debtorType",
        "amount",
        "currencyCode"
      ],
      "title": "DebituraCheckEligibilityConfig",
      "type": "object"
    },
    "DebituraCreateCaseConfig": {
      "additionalProperties": false,
      "description": "Create collection case.",
      "properties": {
        "currencyCode": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currencycode",
          "type": "string"
        },
        "date": {
          "description": "Invoice date; no future dates.",
          "format": "date-time",
          "title": "Date",
          "type": "string"
        },
        "dueDate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 date or date-time accepted by Debitura.",
          "title": "Duedate"
        },
        "comments": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional comments about the case, e.g. payment history or communication context.",
          "title": "Comments"
        },
        "claimDescription": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Client provided description of the claim",
          "title": "Claimdescription"
        },
        "creditorReference": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creditorreference"
        },
        "debtor": {
          "$ref": "#/$defs/Debtor"
        },
        "creditorDivisionId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creditordivisionid"
        },
        "amountToRecover": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The TOTAL amount to recover for this case.",
          "title": "Amounttorecover"
        },
        "amountToRecoverOver6Months": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OPTIONAL - MULTI-INVOICE AGE BUCKET PRICING (PRICING ZONE 180-DAY THRESHOLD)",
          "title": "Amounttorecoverover6Months"
        },
        "amountToRecoverOver12Months": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OPTIONAL - MULTI-INVOICE AGE BUCKET PRICING",
          "title": "Amounttorecoverover12Months"
        },
        "amountToRecoverOver24Months": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OPTIONAL - MULTI-INVOICE AGE BUCKET PRICING",
          "title": "Amounttorecoverover24Months"
        },
        "claimLines": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ClaimLine"
              },
              "maxItems": 1000,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OPTIONAL - the unpaid invoices making up this claim, one line per invoice, each carrying its",
          "title": "Claimlines"
        },
        "allowPendingContracts": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, cases with unsigned contracts (SDCA/POA) are accepted in 'PendingContractSigning'",
          "title": "Allowpendingcontracts"
        },
        "isTest": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, creates a test case that IS persisted to the database but marked as test data.",
          "title": "Istest"
        },
        "tag": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional tag for scoped test data grouping (e.g. \"suite-run-{uuid}\").",
          "title": "Tag"
        },
        "assignedUserEmail": {
          "anyOf": [
            {
              "format": "email",
              "maxLength": 320,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional: Email address of the creditor team member to assign as the case owner.",
          "title": "Assigneduseremail"
        },
        "returnUrl": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional: URL the creditor user should land on after completing any",
          "title": "Returnurl"
        },
        "operation": {
          "const": "create_case",
          "default": "create_case",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional retry key. Reuse only with an identical request body.",
          "title": "Idempotency Key"
        }
      },
      "required": [
        "currencyCode",
        "date",
        "debtor"
      ],
      "title": "DebituraCreateCaseConfig",
      "type": "object"
    },
