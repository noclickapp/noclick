    "LogCall": {
      "additionalProperties": false,
      "description": "Log a Call.",
      "properties": {
        "contact_id": {
          "minimum": 1,
          "title": "Contact ID",
          "type": "integer"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD HH:MM:SS; defaults to the current time at kvCORE.",
          "title": "Date"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "inbound",
                "outbound"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction",
          "enum": [
            "inbound",
            "outbound"
          ],
          "x-enum-searchable": true
        },
        "result": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1 Bad Number, 2 Not Home, 3 Contacted.",
          "title": "Result"
        },
        "recording_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL of an existing call recording. NoClick passes this URL to kvCORE without downloading it.",
          "title": "Recording Url"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes",
          "ui:widget": "textarea"
        },
        "action_owner_user_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only company admins may set another owner.",
          "title": "Action Owner User Id"
        },
        "operation": {
          "const": "log_call",
          "default": "log_call",
          "title": "Log Call",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "contact_id"
      ],
      "title": "LogCall",
      "type": "object"
