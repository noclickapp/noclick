        },
        {
          "$ref": "#/$defs/GetSearchAlerts"
        },
        {
          "$ref": "#/$defs/ListUsers"
        },
        {
          "$ref": "#/$defs/GetUser"
        },
        {
          "$ref": "#/$defs/ListManualListings"
        }
