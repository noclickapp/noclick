{
  "$defs": {
    "AddContactTags": {
      "additionalProperties": false,
      "description": "Add Tags to Contact.",
      "properties": {
        "contact_id": {
          "minimum": 1,
          "title": "Contact ID",
          "type": "integer"
        },
        "tags": {
          "description": "Tags to attach; missing tags are created. Locked tags require admin permissions.",
          "items": {
            "$ref": "#/$defs/ContactTag"
          },
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        },
        "operation": {
          "const": "add_contact_tags",
          "default": "add_contact_tags",
          "title": "Add Contact Tags",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "contact_id",
        "tags"
      ],
      "title": "AddContactTags",
      "type": "object"
    },
    "AddNote": {
