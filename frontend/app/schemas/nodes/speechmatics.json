{
  "$defs": {
    "DeleteJob": {
      "properties": {
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Job ID",
          "type": "string"
        },
        "operation": {
          "const": "delete_job",
          "default": "delete_job",
          "title": "Delete Job",
          "type": "string",
          "ui:hidden": true
        },
        "force": {
          "default": false,
          "description": "Terminate a running job as well as deleting its data.",
          "title": "Force",
          "type": "boolean"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "DeleteJob",
      "type": "object"
    },
    "GetJob": {
      "properties": {
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Job ID",
          "type": "string"
        },
        "operation": {
          "const": "get_job",
          "default": "get_job",
          "title": "Get Job",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetJob",
      "type": "object"
    },
    "GetLog": {
      "properties": {
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Job ID",
          "type": "string"
        },
        "operation": {
          "const": "get_log",
          "default": "get_log",
          "title": "Get Job Log",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetLog",
      "type": "object"
    },
    "GetSrtTranscript": {
      "properties": {
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Job ID",
          "type": "string"
        },
        "operation": {
          "const": "get_srt_transcript",
          "default": "get_srt_transcript",
          "title": "Get SRT Subtitles",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetSrtTranscript",
      "type": "object"
    },
    "GetTextTranscript": {
      "properties": {
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Job ID",
          "type": "string"
        },
        "operation": {
          "const": "get_text_transcript",
          "default": "get_text_transcript",
          "title": "Get Text Transcript",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetTextTranscript",
      "type": "object"
    },
    "GetTranscript": {
      "properties": {
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Job ID",
          "type": "string"
        },
        "operation": {
          "const": "get_transcript",
          "default": "get_transcript",
          "title": "Get JSON Transcript",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetTranscript",
      "type": "object"
    },
    "GetUsage": {
      "properties": {
        "operation": {
          "const": "get_usage",
          "default": "get_usage",
          "title": "Get Usage",
          "type": "string",
          "ui:hidden": true
        },
        "since": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Since"
        },
        "until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        }
      },
      "title": "GetUsage",
      "type": "object"
    },
    "ListJobs": {
      "properties": {
        "operation": {
          "const": "list_jobs",
          "default": "list_jobs",
          "title": "List Jobs",
          "type": "string",
          "ui:hidden": true
        },
        "limit": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "created_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UTC timestamp cursor. Pass the oldest creation timestamp to retrieve an earlier page.",
          "title": "Created Before"
        },
        "include_deleted": {
          "default": false,
          "title": "Include Deleted",
          "type": "boolean"
        }
      },
      "title": "ListJobs",
      "type": "object"
    },
    "SpeechmaticsCredential": {
      "properties": {
        "credential_type": {
          "const": "speechmatics_api_key",
          "default": "speechmatics_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Paste your Speechmatics API key without the Bearer prefix.",
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password",
          "x-credential-url": "https://portal.speechmatics.com/settings/api-keys"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Speechmatics API Key",
      "type": "object"
    },
    "SubmitSpeakerTranscription": {
      "properties": {
        "audio_url": {
          "description": "Public or signed HTTPS audio URL fetched by Speechmatics.",
          "title": "Audio URL",
          "type": "string"
        },
        "language": {
          "default": "en",
          "description": "Language code, for example en; use auto for language identification.",
          "maxLength": 20,
          "title": "Language",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Title"
        },
        "operation": {
          "const": "submit_speaker_transcription",
          "default": "submit_speaker_transcription",
          "title": "Submit Speaker Transcription",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "audio_url"
      ],
      "title": "SubmitSpeakerTranscription",
      "type": "object"
    },
    "SubmitSummarization": {
      "properties": {
        "audio_url": {
          "description": "Public or signed HTTPS audio URL fetched by Speechmatics.",
          "title": "Audio URL",
          "type": "string"
        },
        "language": {
          "default": "en",
          "description": "Language code, for example en; use auto for language identification.",
          "maxLength": 20,
          "title": "Language",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Title"
        },
        "operation": {
          "const": "submit_summarization",
          "default": "submit_summarization",
          "title": "Submit Transcription and Summary",
          "type": "string",
          "ui:hidden": true
        },
        "summary_length": {
          "default": "brief",
          "enum": [
            "brief",
            "detailed"
          ],
          "title": "Summary Length",
          "type": "string"
        },
        "summary_type": {
          "default": "paragraphs",
          "enum": [
            "paragraphs",
            "bullets"
          ],
          "title": "Summary Type",
          "type": "string"
        },
        "content_type": {
          "default": "auto",
          "enum": [
            "auto",
            "informative",
            "conversational"
          ],
          "title": "Content Type",
          "type": "string"
        }
      },
      "required": [
        "audio_url"
      ],
      "title": "SubmitSummarization",
      "type": "object"
    },
    "SubmitTranscription": {
      "properties": {
        "audio_url": {
          "description": "Public or signed HTTPS audio URL fetched by Speechmatics.",
          "title": "Audio URL",
          "type": "string"
        },
        "language": {
          "default": "en",
          "description": "Language code, for example en; use auto for language identification.",
          "maxLength": 20,
          "title": "Language",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Title"
        },
        "operation": {
          "const": "submit_transcription",
          "default": "submit_transcription",
          "title": "Submit Transcription",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "audio_url"
      ],
      "title": "SubmitTranscription",
      "type": "object"
    },
    "SubmitTranslation": {
      "properties": {
        "audio_url": {
          "description": "Public or signed HTTPS audio URL fetched by Speechmatics.",
          "title": "Audio URL",
          "type": "string"
        },
        "language": {
          "default": "en",
          "description": "Language code, for example en; use auto for language identification.",
          "maxLength": 20,
          "title": "Language",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Title"
        },
        "operation": {
          "const": "submit_translation",
          "default": "submit_translation",
          "title": "Submit Transcription and Translation",
          "type": "string",
          "ui:hidden": true
        },
        "target_languages": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Target Language Codes",
          "type": "array"
        }
      },
      "required": [
        "audio_url",
        "target_languages"
      ],
      "title": "SubmitTranslation",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "delete_job": "#/$defs/DeleteJob",
          "get_job": "#/$defs/GetJob",
          "get_log": "#/$defs/GetLog",
          "get_srt_transcript": "#/$defs/GetSrtTranscript",
          "get_text_transcript": "#/$defs/GetTextTranscript",
          "get_transcript": "#/$defs/GetTranscript",
          "get_usage": "#/$defs/GetUsage",
          "list_jobs": "#/$defs/ListJobs",
          "submit_speaker_transcription": "#/$defs/SubmitSpeakerTranscription",
          "submit_summarization": "#/$defs/SubmitSummarization",
          "submit_transcription": "#/$defs/SubmitTranscription",
          "submit_translation": "#/$defs/SubmitTranslation"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SubmitTranscription"
        },
        {
          "$ref": "#/$defs/SubmitSpeakerTranscription"
        },
        {
          "$ref": "#/$defs/SubmitTranslation"
        },
        {
          "$ref": "#/$defs/SubmitSummarization"
        },
        {
          "$ref": "#/$defs/ListJobs"
        },
        {
          "$ref": "#/$defs/GetJob"
        },
        {
          "$ref": "#/$defs/DeleteJob"
        },
        {
          "$ref": "#/$defs/GetTranscript"
        },
        {
          "$ref": "#/$defs/GetTextTranscript"
        },
        {
          "$ref": "#/$defs/GetSrtTranscript"
        },
        {
          "$ref": "#/$defs/GetLog"
        },
        {
          "$ref": "#/$defs/GetUsage"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpeechmaticsCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Speechmatics Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
