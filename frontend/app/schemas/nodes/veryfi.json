    "ProcessDocument": {
      "additionalProperties": false,
      "properties": {
        "file_name": {
          "description": "A basename ending .pdf, .png, .jpg or .jpeg, matching the supplied bytes.",
          "maxLength": 128,
          "title": "Document Filename",
          "type": "string"
        },
        "file_data": {
          "description": "Canonical raw Base64 only, 250 bytes\u20132 MiB decoded. No data URI, URL, S3 path, local file or ZIP; uploaded content is private workflow input.",
