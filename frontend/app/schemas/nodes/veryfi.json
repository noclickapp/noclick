          "default": null,
          "title": "External ID"
        },
        "max_pages_to_process": {
          "default": 1,
          "description": "Process at most this many starting pages; additional pages are intentionally omitted.",
          "maximum": 15,
          "minimum": 1,
          "title": "Maximum Pages",
          "type": "integer"
        },
        "idempotency_key": {
          "description": "A unique opaque ASCII key for this upload. Reuse it only for a deliberate retry of the same upload, client and mode. No automatic retry.",
          "maxLength": 255,
          "title": "Upload Idempotency Key",
          "type": "string"
        },
        "confirm_processing": {
          "const": true,
