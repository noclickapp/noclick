{
  "$defs": {
    "GetFactSheet": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_fact_sheet",
          "default": "get_fact_sheet",
          "title": "Get Selected Fact Sheet Metadata",
          "type": "string",
          "x-operation-group": "Fact Sheet Reads"
        },
        "fact_sheet_type": {
          "title": "Fact Sheet Type",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "fact_sheet_type",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "leanix_fact_sheet_type"
        },
        "fact_sheet_id": {
          "title": "Fact Sheet",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "depends_on": "fact_sheet_type",
            "field_name": "fact_sheet_id",
            "searchable": true
          },
          "x-resource-type": "leanix_fact_sheet"
        }
      },
      "required": [
        "fact_sheet_type",
        "fact_sheet_id"
      ],
      "title": "GetFactSheet",
      "type": "object"
    },
    "LeanIXApiTokenCredential": {
      "additionalProperties": false,
      "description": "SAP LeanIX API Token",
      "properties": {
        "credential_type": {
          "const": "leanix_api_token",
          "default": "leanix_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "workspace_subdomain": {
          "description": "Actual single subdomain of your SAP LeanIX workspace; requests use only https://<subdomain>.leanix.net.",
          "maxLength": 63,
          "minLength": 1,
          "title": "Workspace Subdomain",
          "type": "string"
        },
        "api_token": {
          "description": "Exchanged with Basic client ID apitoken; no technical user, token or role is created here.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Existing Technical User API Token",
          "type": "string",
          "ui:widget": "password"
        },
        "witness_fact_sheet_id": {
          "description": "Protected read witness; this does not prove a personal identity, numeric workspace ID or ownership.",
          "title": "Known Accessible Fact Sheet ID",
          "type": "string",
          "x-resource-type": "leanix_fact_sheet"
        }
      },
      "required": [
        "workspace_subdomain",
        "api_token",
        "witness_fact_sheet_id"
      ],
      "title": "SAP LeanIX API Token",
      "type": "object",
      "x-credential-url": "https://help.sap.com/docs/leanix/ea/authentication-to-sap-leanix-services"
    },
    "ListApplicationsByTechnicalFit": {
      "additionalProperties": false,
      "properties": {
        "page_size": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 18000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation",
          "ui:hidden": true
        },
        "operation": {
          "const": "list_applications_by_technical_fit",
          "default": "list_applications_by_technical_fit",
          "title": "List Applications by Current Technical Fit",
          "type": "string",
          "x-operation-group": "Fact Sheet Reads"
        },
        "technical_fit": {
          "title": "Application Technical Fit",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "technical_fit",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "leanix_technical_fit"
        }
      },
      "required": [
        "technical_fit"
      ],
      "title": "ListApplicationsByTechnicalFit",
      "type": "object"
    },
    "ListFactSheetTypes": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_fact_sheet_types",
          "default": "list_fact_sheet_types",
          "title": "List Current Fact Sheet Type Facets",
          "type": "string",
          "x-operation-group": "Fact Sheet Reads"
        }
      },
      "title": "ListFactSheetTypes",
      "type": "object"
    },
    "ListFactSheets": {
      "additionalProperties": false,
      "properties": {
        "page_size": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 18000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation",
          "ui:hidden": true
        },
        "operation": {
          "const": "list_fact_sheets",
          "default": "list_fact_sheets",
          "title": "List Workspace Fact Sheet Metadata",
          "type": "string",
          "x-operation-group": "Fact Sheet Reads"
        },
        "fact_sheet_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optional Fact Sheet Type",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "fact_sheet_type",
            "searchable": true
          },
          "x-resource-type": "leanix_fact_sheet_type"
        }
      },
      "title": "ListFactSheets",
      "type": "object"
    },
    "TestAuthentication": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "test_authentication",
          "default": "test_authentication",
          "title": "Read Protected Fact Sheet Witness",
          "type": "string",
          "x-operation-group": "Fact Sheet Reads"
        }
      },
      "title": "TestAuthentication",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_fact_sheet": "#/$defs/GetFactSheet",
          "list_applications_by_technical_fit": "#/$defs/ListApplicationsByTechnicalFit",
          "list_fact_sheet_types": "#/$defs/ListFactSheetTypes",
          "list_fact_sheets": "#/$defs/ListFactSheets",
          "test_authentication": "#/$defs/TestAuthentication"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TestAuthentication"
        },
        {
          "$ref": "#/$defs/GetFactSheet"
        },
        {
          "$ref": "#/$defs/ListFactSheets"
        },
        {
          "$ref": "#/$defs/ListFactSheetTypes"
        },
        {
          "$ref": "#/$defs/ListApplicationsByTechnicalFit"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/LeanIXApiTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Leanix Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
