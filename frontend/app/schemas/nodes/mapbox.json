    "MapboxAccessToken": {
      "properties": {
        "credential_type": {
          "const": "mapbox_access_token",
          "default": "mapbox_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "minLength": 1,
          "title": "Access token",
          "type": "string",
          "ui:widget": "password"
        },
        "username": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Account username",
          "type": "string"
        }
      },
      "required": [
        "access_token",
        "username"
      ],
      "title": "Mapbox Access Token",
      "type": "object",
      "x-credential-instructions": "Paste a Mapbox access token and your account username. Geocoding accepts public tokens. Reading styles needs styles:read; modifying styles or sprites needs a secret token with styles:write. Use an unrestricted server token; URL-restricted tokens may reject server requests.",
      "x-credential-url": "https://account.mapbox.com/access-tokens/"
    },
    "MapboxMcpCredential": {
      "description": "Mapbox connected through Mapbox's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
