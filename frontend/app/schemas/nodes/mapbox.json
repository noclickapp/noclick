  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/CheckConnection",
          "create_style": "#/$defs/CreateStyle",
          "delete_sprite_image": "#/$defs/DeleteSpriteImage",
          "delete_style": "#/$defs/DeleteStyle",
          "delete_style_draft": "#/$defs/DeleteStyleDraft",
          "forward_geocode": "#/$defs/ForwardGeocode",
          "get_sprite": "#/$defs/GetSprite",
          "get_style": "#/$defs/GetStyle",
          "get_style_draft": "#/$defs/GetStyleDraft",
          "list_styles": "#/$defs/ListStyles",
          "reverse_geocode": "#/$defs/ReverseGeocode",
          "update_style": "#/$defs/UpdateStyle",
          "update_style_draft": "#/$defs/UpdateStyleDraft"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CheckConnection"
        },
        {
          "$ref": "#/$defs/ListStyles"
        },
        {
          "$ref": "#/$defs/GetStyle"
        },
        {
          "$ref": "#/$defs/CreateStyle"
        },
        {
          "$ref": "#/$defs/UpdateStyle"
        },
        {
          "$ref": "#/$defs/DeleteStyle"
        },
        {
          "$ref": "#/$defs/GetStyleDraft"
        },
        {
          "$ref": "#/$defs/UpdateStyleDraft"
        },
        {
          "$ref": "#/$defs/DeleteStyleDraft"
        },
        {
          "$ref": "#/$defs/GetSprite"
        },
        {
          "$ref": "#/$defs/DeleteSpriteImage"
        },
        {
          "$ref": "#/$defs/ForwardGeocode"
        },
        {
          "$ref": "#/$defs/ReverseGeocode"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MapboxAccessToken"
        },
        {
          "$ref": "#/$defs/MapboxMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
