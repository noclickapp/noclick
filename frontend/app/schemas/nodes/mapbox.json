{
  "$defs": {
    "CheckConnection": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "check_connection",
          "default": "check_connection",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "CheckConnection",
      "type": "object"
    },
    "CreateStyle": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": 8,
          "enum": [
            6,
            7,
            8
          ],
          "title": "Version",
          "type": "integer"
        },
        "sources": {
          "additionalProperties": true,
          "description": "Mapbox Style Specification source objects; maximum 15 sources.",
          "title": "Sources",
          "type": "object"
        },
        "layers": {
          "description": "Ordered Mapbox Style Specification layers.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Layers",
          "type": "array"
        },
        "sprite": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sprite"
        },
        "glyphs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Glyphs"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata"
        },
        "operation": {
          "const": "create_style",
          "default": "create_style",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sources",
        "layers"
      ],
      "title": "CreateStyle",
      "type": "object"
    },
    "DeleteSpriteImage": {
      "additionalProperties": false,
      "properties": {
        "style_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Style Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_sprite_image",
          "default": "delete_sprite_image",
          "title": "Operation",
          "type": "string"
        },
        "icon_name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Icon Name",
          "type": "string"
        }
      },
      "required": [
        "style_id",
        "icon_name"
