    "ListStyles": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_styles",
          "default": "list_styles",
          "title": "Operation",
          "type": "string"
        },
        "limit": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
