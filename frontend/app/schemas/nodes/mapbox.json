    "ForwardGeocode": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "forward_geocode",
          "default": "forward_geocode",
          "title": "Operation",
          "type": "string"
        },
        "q": {
          "description": "Address or place to find; at most 20 words, without semicolons.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Q",
          "type": "string"
        },
        "limit": {
          "default": 5,
          "maximum": 10,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "permanent": {
          "default": false,
          "description": "Enable only with a Mapbox plan permitting permanent storage.",
          "title": "Permanent",
          "type": "boolean"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
