    "BlackboardAccessTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "blackboard_access_token",
          "default": "blackboard_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "site_url": {
          "description": "Your institution's public HTTPS Blackboard Learn origin, for example https://school.blackboard.com.",
          "title": "Blackboard site URL",
          "type": "string"
        },
        "access_token": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Access token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "site_url",
        "access_token"
      ],
      "title": "Blackboard Access Token",
      "type": "object",
      "x-credential-instructions": "Paste your Blackboard Learn HTTPS site URL and an existing bearer access token for that site, without the Bearer prefix. Ask your Blackboard administrator for a token from an already registered REST integration with the permissions your operations need. Blackboard tokens expire after one hour; replace an expired token here. NoClick does not create or refresh tokens. Connection testing lists courses and does not verify all write permissions.",
      "x-credential-url": "https://docs.blackboard.com/docs/blackboard/rest-apis/getting-started/basic-authentication"
    },
    "CreateAnnouncement": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_announcement",
          "default": "create_announcement",
          "title": "Operation",
          "type": "string"
        },
        "course_id": {
          "title": "Course Id",
          "type": "string"
