          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Announcement text in Blackboard BbML/HTML format.",
          "title": "Body"
        },
        "draft": {
          "default": true,
          "description": "Keep as a draft; false makes the announcement available according to Blackboard's defaults.",
          "title": "Draft",
          "type": "boolean"
        }
      },
      "required": [
        "course_id",
        "title"
      ],
      "title": "CreateAnnouncement",
      "type": "object"
    },
