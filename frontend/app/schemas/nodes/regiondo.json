{
  "$defs": {
    "CancelTickets": {
      "additionalProperties": false,
      "description": "Cancel API-booked tickets. Regiondo does not refund or notify the customer; the supplier is notified.",
      "properties": {
        "operation": {
          "const": "cancel_tickets",
          "default": "cancel_tickets",
          "title": "Operation",
          "type": "string"
        },
        "reference_ids": {
          "description": "Comma-separated ticket reference IDs. Only bookings placed through the API can be canceled; this does not refund or email the customer.",
