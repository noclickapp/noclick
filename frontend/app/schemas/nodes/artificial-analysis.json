    "ArtificialAnalysisGetLanguageModelBySlugConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_language_model_by_slug",
          "default": "get_language_model_by_slug",
          "title": "Get a single language model by slug",
          "type": "string",
          "ui:hidden": true
        },
        "slug": {
          "description": "The model slug (e.g. \"gemini-3-pro\", \"claude-opus-4-6\", \"deepseek-v3\").",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Slug",
          "type": "string"
        },
        "prompt_type": {
          "default": "long",
          "description": "The prompt type preset used for performance benchmarking.\nControls how many input tokens and parallel queries are used in latency/throughput measurements.\nApplies to the `performance` fields only; `performance_v3` does not depend on it.\n\n| prompt_type | input_tokens | parallel_queries |\n| --- | --- | --- |\n| `medium` | 1,000 | 1 |\n| `long` (default) | 10,000 | 1 |\n| `100k` | 100,000 | 1 |\n| `vision_single_image` | 1,000 | 1 |\n| `medium_parallel` | 1,000 | 10 |\n",
          "enum": [
            "medium",
            "long",
            "100k",
            "vision_single_image",
            "medium_parallel"
          ],
          "title": "Prompt Type",
          "type": "string"
        }
      },
      "required": [
        "slug"
      ],
      "title": "ArtificialAnalysisGetLanguageModelBySlugConfig",
      "type": "object",
      "x-requires-tier": "pro",
      "x-tier-label": "Pro"
    },
