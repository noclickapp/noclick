    "SirvAccessTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "sirv_access_token",
          "default": "sirv_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Existing Access Token",
          "type": "string",
          "ui:sensitive": true,
          "ui:widget": "password"
        },
        "root_folder": {
          "description": "Absolute account path, such as /catalog. A local read boundary, not account identity.",
          "title": "Selected Root Folder",
          "type": "string",
          "ui:sensitive": true
        },
        "expires_at": {
          "description": "Timezone-aware ISO deadline from the genuine token issuance time and expiresIn. Never inferred from a decoded JWT.",
          "title": "Actual Token Expiry",
          "type": "string"
        },
        "scope": {
          "description": "Copy the issuer-reported scope array, including files:read. No scope is requested or granted by this node.",
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Actual Token Scope List",
          "type": "array"
        }
      },
      "required": [
        "access_token",
        "root_folder",
        "expires_at",
        "scope"
      ],
      "title": "Sirv Access Token",
      "type": "object",
      "x-credential-instructions": "Supply an existing Bearer token, its actual issuer-reported scope list including files:read, actual expiry deadline, and a selected absolute root-folder path. This node neither creates nor refreshes tokens. Sent only in the Authorization header to fixed public HTTPS api.sirv.com/v2. Folder reads establish reachability, not principal/tenant ownership or token-claim verification.",
      "x-credential-url": "https://sirv.com/help/articles/sirv-rest-api/",
      "x-required-token-scopes": [
        "files:read"
      ]
    }
