    "ImportContact": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "import_contact",
          "default": "import_contact",
          "description": "Queues a contact transaction for matching, duplicate checks, and organization review. Does not immediately create a contact.",
