    "GoToTrainingCancelRegistrationConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "cancel_registration",
          "default": "cancel_registration",
          "description": "Cancels a registration in a scheduled training for a specific registrant. If the registrant has paid for the training, a cancellation cannot be completed with this method; it must be completed on the external admin site. No notification is sent to the registrant or the organizer by default. The registrant can re-register if needed.\n",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Cancel Registration",
          "x-is-trigger": false,
          "x-operation-kind": "write"
        },
        "organizer_key": {
          "pattern": "^[0-9]+$",
          "title": "Organizer Key",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "organizer_key",
            "auto_select_sole_option": true
          }
        },
        "training_key": {
          "pattern": "^[0-9]+$",
          "title": "Training Key",
          "type": "string"
        },
        "registrant_key": {
          "pattern": "^[0-9]+$",
          "title": "Registrant Key",
          "type": "string"
        }
      },
      "required": [
        "organizer_key",
        "training_key",
        "registrant_key"
      ],
      "title": "GoToTrainingCancelRegistrationConfig",
      "type": "object"
    },
    "GoToTrainingCreateTrainingConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_training",
          "default": "create_training",
          "description": "Schedules a training of one or more sessions. You can only add organizers to a training if you have a multi-user account. Once a training has been created with this method, you can accept registrations to the training. Registration is for the entire training - all sessions. (The GoTo Training admin site enables you to create trainings that allow participants to register for individual sessions as well as automatically create weekly or monthly events.) Registration settings controls whether you allow web registration for this training, and whether a confirmation email is sent to the registrant following registration. Disabling the confirmation email is an API-only setting. If the user registers through the GoTo Training website, a confirmation email is sent. If the user is manually approved by the training administrator through the GoTo Training web site, the confirmation email is sent. It is recommended that you disable web registration if you disable confirmation emails. The response contains a trainingKey for the scheduled training.\n",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Create Training",
          "x-is-trigger": false,
          "x-operation-kind": "write"
        },
        "organizer_key": {
          "pattern": "^[0-9]+$",
          "title": "Organizer Key",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "organizer_key",
            "auto_select_sole_option": true
          }
        },
        "body": {
          "$ref": "#/$defs/TrainingReqCreate",
          "description": "Schedules a training of one or more sessions. You can only add organizers to a training if you have a multi-user account. Once a training has been created with this method, you can accept registrations to the training. Registration is for the entire training - all sessions. (The GoTo Training admin site enables you to create trainings that allow participants to register for individual sessions as well as automatically create weekly or monthly events.) Registration settings controls whether you allow web registration for this training, and whether a confirmation email is sent to the registrant following registration. Disabling the confirmation email is an API-only setting. If the user registers through the GoTo Training website, a confirmation email is sent. If the user is manually approved by the training administrator through the GoTo Training web site, the confirmation email is sent. It is recommended that you disable web registration if you disable confirmation emails. The response contains a trainingKey for the scheduled training.\n",
          "title": "Details"
        }
      },
      "required": [
        "organizer_key",
        "body"
      ],
      "title": "GoToTrainingCreateTrainingConfig",
      "type": "object"
    },
    "GoToTrainingDeleteTrainingConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "delete_training",
          "default": "delete_training",
          "description": "Deletes a scheduled or completed training. For scheduled trainings, it deletes all scheduled sessions of the training. For completed trainings, the sessions remain in the database. No email is sent to organizers or registrants, but when participants attempt to start or join the training, they are directed to a page that states: Training Not Found: The training you are trying to join is no longer available.\n",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Delete Training",
          "x-is-trigger": false,
          "x-operation-kind": "write"
        },
        "organizer_key": {
          "pattern": "^[0-9]+$",
          "title": "Organizer Key",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "organizer_key",
            "auto_select_sole_option": true
          }
        },
        "training_key": {
