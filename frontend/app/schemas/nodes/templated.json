      "title": "TemplatedUpdateFolderConfig",
      "type": "object"
    },
    "TemplatedUpdateTemplateConfig": {
      "additionalProperties": false,
      "description": "Update an existing template; omitted layers remain unchanged.",
      "properties": {
        "template_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Template ID",
          "type": "string"
        },
        "operation": {
          "const": "update_template",
          "default": "update_template",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "layers": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to preserve existing layers. An empty list explicitly clears them.",
          "title": "Layers"
        }
      },
      "required": [
        "template_id",
        "name"
      ],
      "title": "TemplatedUpdateTemplateConfig",
      "type": "object"
    }
