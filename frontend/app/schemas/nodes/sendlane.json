    "AddListContact": {
      "additionalProperties": false,
      "description": "Create or add a contact to a list; consent must reflect the person's permission.",
      "properties": {
        "list_id": {
          "minimum": 1,
          "title": "List ID",
          "type": "integer"
        },
        "operation": {
          "const": "add_list_contact",
          "default": "add_list_contact",
          "title": "Operation",
          "type": "string"
