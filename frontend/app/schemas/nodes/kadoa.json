{
  "$defs": {
    "CreateSchema": {
      "additionalProperties": false,
      "description": "Create a reusable schema with typed extraction fields.",
      "properties": {
        "operation": {
          "const": "create_schema",
          "default": "create_schema",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "entity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/DataField"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "name",
        "fields"
      ],
      "title": "CreateSchema",
      "type": "object"
    },
    "CreateWorkflow": {
      "additionalProperties": false,
      "description": "Create a prompt-driven extraction workflow for a single website.",
      "properties": {
        "operation": {
          "const": "create_workflow",
          "default": "create_workflow",
          "title": "Operation",
          "type": "string"
        },
        "urls": {
          "description": "Source URLs from one website, including its subdomains. Use a separate workflow for each website.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Urls",
          "type": "array"
        },
        "user_prompt": {
          "maxLength": 5000,
          "minLength": 10,
          "title": "User Prompt",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "schema_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Id"
        },
        "bypass_preview": {
          "default": false,
          "description": "Skip preview and deploy immediately. This can start paid extraction.",
          "title": "Bypass Preview",
          "type": "boolean"
        }
      },
      "required": [
        "urls",
        "user_prompt"
      ],
      "title": "CreateWorkflow",
      "type": "object"
    },
    "DataField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[^.]*$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "fieldType": {
          "const": "SCHEMA",
          "default": "SCHEMA",
          "title": "Fieldtype",
          "type": "string"
        },
        "dataType": {
          "enum": [
            "STRING",
            "NUMBER",
            "BOOLEAN",
            "DATE",
            "DATETIME",
            "MONEY",
            "IMAGE",
            "LINK",
            "OBJECT",
            "ARRAY"
          ],
          "title": "Datatype",
          "type": "string"
        },
        "isKey": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iskey"
        }
      },
      "required": [
        "name",
        "description",
        "dataType"
      ],
      "title": "DataField",
      "type": "object"
    },
