{
  "$defs": {
    "CreateProxyBinding": {
      "additionalProperties": false,
      "description": "Create an alias forwarding to the supplied real email addresses.",
      "properties": {
        "operation": {
          "const": "create_proxy_binding",
          "default": "create_proxy_binding",
          "title": "Operation",
          "type": "string"
        },
        "proxy_address": {
          "description": "Alias email address to create.",
          "title": "Proxy Address",
          "type": "string"
        },
        "real_addresses": {
          "description": "Forwarding destinations. Creation may send provider verification emails.",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Real Addresses",
          "type": "array"
        },
        "callback_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL to receive incoming-email webhooks.",
          "title": "Callback Url"
        },
        "is_browsable": {
          "default": true,
          "description": "Store received email for API browsing.",
          "title": "Is Browsable",
          "type": "boolean"
        }
      },
      "required": [
        "proxy_address",
        "real_addresses"
      ],
      "title": "CreateProxyBinding",
      "type": "object"
    },
    "DisableEmailBrowsing": {
      "additionalProperties": false,
      "description": "Disable API browsing of received mail for this alias.",
      "properties": {
        "proxy_binding_id": {
          "description": "Proxy-binding ID returned by List Proxy Bindings.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Proxy Binding Id",
          "type": "string"
        },
        "operation": {
          "const": "disable_email_browsing",
          "default": "disable_email_browsing",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "proxy_binding_id"
      ],
      "title": "DisableEmailBrowsing",
      "type": "object"
    },
    "EnableEmailBrowsing": {
      "additionalProperties": false,
      "description": "Enable browsing received email through the API.",
      "properties": {
        "proxy_binding_id": {
          "description": "Proxy-binding ID returned by List Proxy Bindings.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Proxy Binding Id",
          "type": "string"
        },
        "operation": {
          "const": "enable_email_browsing",
          "default": "enable_email_browsing",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "proxy_binding_id"
      ],
      "title": "EnableEmailBrowsing",
      "type": "object"
    },
    "GetCallback": {
      "additionalProperties": false,
      "description": "Read the payload captured by an existing webhook receiver hash.",
      "properties": {
        "operation": {
          "const": "get_callback",
          "default": "get_callback",
          "title": "Operation",
          "type": "string"
        },
        "callback_hash": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Callback Hash",
          "type": "string"
        }
      },
      "required": [
        "callback_hash"
      ],
      "title": "GetCallback",
      "type": "object"
    },
    "GetReceivedEmail": {
      "additionalProperties": false,
      "description": "Read one received message's payload and attachment links.",
      "properties": {
        "operation": {
          "const": "get_received_email",
          "default": "get_received_email",
          "title": "Operation",
          "type": "string"
        },
        "received_email_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Received Email Id",
          "type": "string"
        }
      },
      "required": [
        "received_email_id"
      ],
      "title": "GetReceivedEmail",
      "type": "object"
    },
    "ListProxyBindings": {
      "additionalProperties": false,
      "description": "List the account's proxy email addresses and usage metadata.",
      "properties": {
        "operation": {
          "const": "list_proxy_bindings",
          "default": "list_proxy_bindings",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListProxyBindings",
      "type": "object"
    },
    "ListReceivedEmailLinks": {
      "additionalProperties": false,
      "description": "Read the last 55 received messages for a browsable alias.",
      "properties": {
        "proxy_binding_id": {
          "description": "Proxy-binding ID returned by List Proxy Bindings.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Proxy Binding Id",
          "type": "string"
        },
        "operation": {
          "const": "list_received_email_links",
          "default": "list_received_email_links",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "proxy_binding_id"
      ],
      "title": "ListReceivedEmailLinks",
      "type": "object"
    },
    "ProxiedmailAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "proxiedmail_api_token",
          "default": "proxiedmail_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Proxiedmail API Token",
      "type": "object",
      "x-credential-instructions": "Paste your API token from ProxiedMail Settings. NoClick sends it in the Token header. Use the API token, not an expiring login bearer token.",
      "x-credential-url": "https://proxiedmail.com/en/settings"
    },
    "SetCallbackURL": {
      "additionalProperties": false,
      "description": "Set the URL receiving incoming-email webhooks.",
      "properties": {
        "proxy_binding_id": {
          "description": "Proxy-binding ID returned by List Proxy Bindings.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Proxy Binding Id",
          "type": "string"
        },
        "operation": {
          "const": "set_callback_url",
          "default": "set_callback_url",
          "title": "Operation",
          "type": "string"
        },
        "callback_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Callback Url",
          "type": "string"
        }
      },
      "required": [
        "proxy_binding_id",
        "callback_url"
      ],
      "title": "SetCallbackURL",
      "type": "object"
    },
    "SetForwardingAddresses": {
      "additionalProperties": false,
      "description": "Replace the forwarding destinations and their enabled flags.",
      "properties": {
        "proxy_binding_id": {
          "description": "Proxy-binding ID returned by List Proxy Bindings.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Proxy Binding Id",
          "type": "string"
        },
        "operation": {
          "const": "set_forwarding_addresses",
          "default": "set_forwarding_addresses",
          "title": "Operation",
          "type": "string"
        },
        "real_addresses": {
          "additionalProperties": {
            "type": "boolean"
          },
          "maxProperties": 100,
          "minProperties": 1,
          "title": "Real Addresses",
          "type": "object"
        }
      },
      "required": [
        "proxy_binding_id",
        "real_addresses"
      ],
      "title": "SetForwardingAddresses",
      "type": "object"
    },
    "UpdateProxyBinding": {
      "additionalProperties": false,
      "description": "Change selected alias settings; omitted fields are preserved.",
      "properties": {
        "proxy_binding_id": {
          "description": "Proxy-binding ID returned by List Proxy Bindings.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Proxy Binding Id",
          "type": "string"
        },
        "operation": {
          "const": "update_proxy_binding",
          "default": "update_proxy_binding",
          "title": "Operation",
          "type": "string"
        },
        "proxy_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy Address"
        },
        "real_addresses": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "boolean"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Destination email to enabled flag; replaces the forwarding map.",
          "title": "Real Addresses"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "callback_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback Url"
        },
        "is_browsable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Browsable"
        }
      },
      "required": [
        "proxy_binding_id"
      ],
      "title": "UpdateProxyBinding",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_proxy_binding": "#/$defs/CreateProxyBinding",
          "disable_email_browsing": "#/$defs/DisableEmailBrowsing",
          "enable_email_browsing": "#/$defs/EnableEmailBrowsing",
          "get_callback": "#/$defs/GetCallback",
          "get_received_email": "#/$defs/GetReceivedEmail",
          "list_proxy_bindings": "#/$defs/ListProxyBindings",
          "list_received_email_links": "#/$defs/ListReceivedEmailLinks",
          "set_callback_url": "#/$defs/SetCallbackURL",
          "set_forwarding_addresses": "#/$defs/SetForwardingAddresses",
          "update_proxy_binding": "#/$defs/UpdateProxyBinding"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListProxyBindings"
        },
        {
          "$ref": "#/$defs/CreateProxyBinding"
        },
        {
          "$ref": "#/$defs/UpdateProxyBinding"
        },
        {
          "$ref": "#/$defs/SetForwardingAddresses"
        },
        {
          "$ref": "#/$defs/SetCallbackURL"
        },
        {
          "$ref": "#/$defs/EnableEmailBrowsing"
        },
        {
          "$ref": "#/$defs/DisableEmailBrowsing"
        },
        {
          "$ref": "#/$defs/ListReceivedEmailLinks"
        },
        {
          "$ref": "#/$defs/GetReceivedEmail"
        },
        {
          "$ref": "#/$defs/GetCallback"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProxiedmailAPITokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Proxiedmail Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
