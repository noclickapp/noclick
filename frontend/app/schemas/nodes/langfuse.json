{
  "$defs": {
    "CreateComment": {
      "additionalProperties": false,
      "description": "Attach a comment to a trace, observation, session or prompt.",
      "properties": {
        "operation": {
          "const": "create_comment",
          "default": "create_comment",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "object_type": {
          "enum": [
            "trace",
            "observation",
            "session",
            "prompt"
          ],
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "content": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "object_type",
        "object_id",
        "content"
      ],
      "title": "CreateComment",
      "type": "object"
    },
    "CreateDataset": {
      "additionalProperties": false,
      "description": "Create an evaluation dataset.",
      "properties": {
        "operation": {
          "const": "create_dataset",
          "default": "create_dataset",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
