              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateDataset",
      "type": "object"
    },
    "CreateScore": {
      "additionalProperties": false,
      "description": "Submit one numeric trace score for asynchronous processing.",
      "properties": {
        "operation": {
          "const": "create_score",
          "default": "create_score",
          "title": "Operation",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "score_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional project-unique ID for the score.",
          "title": "Score Id"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        }
      },
      "required": [
        "trace_id",
        "name",
        "value"
      ],
      "title": "CreateScore",
      "type": "object"
    },
    "CreateTextPrompt": {
      "additionalProperties": false,
      "description": "Create a text prompt or a new version of an existing prompt.",
