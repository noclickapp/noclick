    "LangfuseAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "langfuse_api_key",
          "default": "langfuse_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "public_key": {
          "description": "Project public API key from Langfuse project settings.",
          "minLength": 1,
          "title": "Public key",
          "type": "string",
          "ui:widget": "password"
        },
        "secret_key": {
          "description": "Secret API key paired with the public key.",
          "minLength": 1,
          "title": "Secret key",
          "type": "string",
          "ui:widget": "password"
        },
        "region": {
          "default": "eu",
          "description": "Use the region where your project lives.",
          "enum": [
            "eu",
            "us",
            "jp",
            "hipaa_us"
          ],
          "title": "Cloud region",
          "type": "string"
        }
      },
      "required": [
        "public_key",
        "secret_key"
      ],
      "title": "Langfuse API Key",
      "type": "object",
      "x-credential-instructions": "In your Langfuse project settings, create a project API key. Paste its public key and secret key, then select the project's Cloud region. Organization keys are not supported. NoClick uses Basic authentication to the selected Langfuse Cloud host. Self-hosted instances are not supported.",
      "x-credential-url": "https://langfuse.com/docs/api-and-data-platform/features/public-api#obtain-credentials"
    },
    "ListComments": {
