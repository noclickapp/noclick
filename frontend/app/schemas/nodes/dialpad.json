    "DialpadGetUserConfig": {
      "additionalProperties": false,
      "description": "User -- Get",
      "properties": {
        "operation": {
          "const": "get_user",
          "default": "get_user",
          "title": "Get User",
          "type": "string"
        },
        "id": {
          "description": "The user's id. ('me' can be used if you are using a user level API key)",
          "minLength": 1,
          "title": "User ID",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "DialpadGetUserConfig",
      "type": "object"
    },
    "DialpadHangupCallConfig": {
      "additionalProperties": false,
      "description": "Call Actions -- Hang up",
      "properties": {
        "operation": {
          "const": "hangup_call",
          "default": "hangup_call",
          "title": "Hangup Call",
          "type": "string"
        },
        "id": {
          "description": "The call's id.",
          "title": "Call ID",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "DialpadHangupCallConfig",
      "type": "object"
    },
    "DialpadInitiateCallConfig": {
      "additionalProperties": false,
      "description": "Call -- Initiate via Ring",
      "properties": {
        "operation": {
          "const": "initiate_call",
          "default": "initiate_call",
          "title": "Initiate Call",
          "type": "string"
        },
        "phone_number": {
          "description": "The e164-formatted number to call.",
          "minLength": 1,
          "title": "Phone Number",
          "type": "string"
        },
        "user_id": {
          "description": "The id of the user who should make the outbound call.",
          "title": "User Id",
          "type": "integer"
        },
        "custom_data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extra data to associate with the call. This will be passed through to any subscribed call events.",
          "title": "Custom Data"
        },
        "outbound_caller_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The e164-formatted number shown to the call recipient (or \"blocked\").\n\nIf set to \"blocked\", the recipient will receive a call from \"unknown caller\". The number can be the caller's number, or the caller's group number if the group is provided, or the caller's company reserved number.",
          "title": "Outbound Caller Id"
        }
      },
      "required": [
        "phone_number",
        "user_id"
      ],
      "title": "DialpadInitiateCallConfig",
      "type": "object"
    },
    "DialpadListCallsConfig": {
      "additionalProperties": false,
      "description": "Call -- List",
      "properties": {
        "operation": {
          "const": "list_calls",
          "default": "list_calls",
          "title": "List Calls",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A token used to return the next page of a previous request. Use the cursor provided in the previous response.",
          "title": "Cursor"
        },
        "include_anonymized": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If set to true, includes call records that have been anonymized\n(e.g., calls associated with deleted users). Defaults to false.",
          "title": "Include Anonymized"
        },
        "started_after": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only includes calls that started more recently than the specified timestamp.\n(UTC ms-since-epoch timestamp)",
          "title": "Started After"
        },
        "started_before": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only includes calls that started prior to the specified timestamp.\n(UTC ms-since-epoch timestamp)",
          "title": "Started Before"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The ID of a target to filter against. Defaults to the whole company for company-level API keys and company admins, and to the authenticated user for all other user-level API keys.",
          "title": "Target Id"
        },
        "target_type": {
          "anyOf": [
            {
              "enum": [
                "callcenter",
                "callrouter",
                "channel",
                "coachinggroup",
                "coachingteam",
                "department",
                "office",
                "room",
                "staffgroup",
                "unknown",
                "user"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The target type associated with the target ID. Must be provided whenever target_id is provided.",
          "title": "Target Type",
          "enum": [
            "callcenter",
            "callrouter",
            "channel",
            "coachinggroup",
            "coachingteam",
            "department",
            "office",
            "room",
            "staffgroup",
            "unknown",
            "user"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "DialpadListCallsConfig",
      "type": "object"
    },
    "DialpadListContactsConfig": {
      "additionalProperties": false,
      "description": "Contact -- List",
      "properties": {
        "operation": {
          "const": "list_contacts",
          "default": "list_contacts",
          "title": "List Contacts",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A search string to filter contacts by name.",
          "title": "Name"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
