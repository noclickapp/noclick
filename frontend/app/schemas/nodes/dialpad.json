          "title": "Cursor"
        },
        "include_local": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If set to True company local contacts will be included. default False.",
          "title": "Include Local"
        },
        "owner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The id of the user who owns the contact.",
          "title": "Owner Id"
        }
      },
      "title": "DialpadListContactsConfig",
      "type": "object"
    },
    "DialpadListUsersConfig": {
      "additionalProperties": false,
      "description": "User -- List",
      "properties": {
        "operation": {
          "const": "list_users",
          "default": "list_users",
          "title": "List Users",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A token used to return the next page of a previous request. Use the cursor provided in the previous response.",
          "title": "Cursor"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter results by first name prefix (e.g. \"jo\" matches \"John\", \"Jose\"). Uses Elasticsearch prefix matching. Cannot be combined with email or number.",
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter results by last name prefix (e.g. \"sm\" matches \"Smith\", \"Smythe\"). Uses Elasticsearch prefix matching. Cannot be combined with email or number.",
          "title": "Last Name"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "active",
                "all",
                "cancelled",
                "deleted",
                "pending",
                "suspended"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter results by the specified user state (e.g. active, suspended, deleted)",
          "title": "State",
          "enum": [
            "active",
            "all",
            "cancelled",
            "deleted",
            "pending",
            "suspended"
          ],
          "x-enum-searchable": true
        },
        "company_admin": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If provided, filter results by the specified value to return only company admins or only non-company admins.",
          "title": "Company Admin"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The user's email.",
          "title": "Email"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The user's phone number, in e164 format.",
          "title": "Number"
        },
        "forwarding_number": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, `number` is also matched against the forwarding numbers users have added to their profile, instead of only the numbers assigned to them by Dialpad. Only applies together with `number`.",
          "title": "Forwarding Number"
        }
      },
      "title": "DialpadListUsersConfig",
      "type": "object"
    },
