{
  "$defs": {
    "DialpadAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "dialpad_api_key",
          "default": "dialpad_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "API key generated by a Dialpad company admin.",
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Dialpad API Key",
      "type": "object",
      "x-credential-instructions": "In Dialpad Admin Settings, open My Company \u2192 Authentication \u2192 API keys and add a key. Company admin access and a Pro or Enterprise plan are required. Paste the key here.",
      "x-credential-url": "https://dialpad.com/settings/company/authentication",
      "x-help-url": "https://developers.dialpad.com/docs/api-key-generation"
    },
    "DialpadAddCallLabelsConfig": {
      "additionalProperties": false,
      "description": "Label -- Add",
      "properties": {
        "operation": {
          "const": "add_call_labels",
          "default": "add_call_labels",
          "title": "Add Call Labels",
          "type": "string"
        },
        "id": {
          "description": "The call's id",
          "title": "Call ID",
          "type": "integer"
        },
        "labels": {
          "description": "The list of labels to attach to the call Enter comma-separated values.",
          "minLength": 1,
          "title": "Labels",
          "type": "string"
        }
      },
      "required": [
        "id",
        "labels"
      ],
      "title": "DialpadAddCallLabelsConfig",
      "type": "object"
    },
    "DialpadCreateContactConfig": {
      "additionalProperties": false,
      "description": "Contact -- Create",
      "properties": {
        "operation": {
          "const": "create_contact",
          "default": "create_contact",
          "title": "Create Contact",
          "type": "string"
        },
        "first_name": {
          "description": "The contact's first name.",
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "description": "The contact's last name.",
          "minLength": 1,
          "title": "Last Name",
          "type": "string"
        },
        "emails": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The contact's emails.\n\nThe first email in the list is the contact's primary email. Enter comma-separated values.",
          "title": "Emails"
        },
        "phones": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The contact's phone numbers.\n\nThe phone number must be in e164 format. The first number in the list is the contact's primary phone. Enter comma-separated values.",
          "title": "Phones"
        },
        "company_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The contact's company name.",
          "title": "Company Name"
        },
        "job_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The contact's job title.",
          "title": "Job Title"
        },
        "urls": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A list of websites associated with or belonging to this contact. Enter comma-separated values.",
          "title": "Urls"
        },
        "owner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The id of the user who will own this contact.\n\nIf provided, a local contact will be created for this user. Otherwise, the contact will be created as a shared contact in your company.",
          "title": "Owner Id"
        }
      },
      "required": [
        "first_name",
        "last_name"
      ],
      "title": "DialpadCreateContactConfig",
      "type": "object"
    },
    "DialpadDeleteContactConfig": {
      "additionalProperties": false,
      "description": "Contact -- Delete",
      "properties": {
        "operation": {
          "const": "delete_contact",
          "default": "delete_contact",
          "title": "Delete Contact",
          "type": "string"
        },
        "id": {
          "description": "The contact's id.",
          "minLength": 1,
          "title": "Contact ID",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "DialpadDeleteContactConfig",
      "type": "object"
