{
  "$defs": {
    "ChatMessage": {
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "CreateChatCompletion": {
      "description": "Generate a non-streaming Jamba chat response.",
      "properties": {
        "operation": {
          "const": "create_chat_completion",
          "default": "create_chat_completion",
          "title": "Operation",
          "type": "string"
        },
        "model": {
          "default": "jamba-large",
          "enum": [
            "jamba-mini",
            "jamba-large",
            "jamba-large-1.7",
            "jamba-large-1.7-2025-07",
            "jamba-mini-2",
            "jamba-mini-2-2026-01"
          ],
          "title": "Model",
          "type": "string"
        },
        "messages": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "$ref": "#/$defs/ChatMessage"
            },
            "minItems": 1,
            "type": "array"
          },
          "description": "JSON message array, e.g. [{\"role\":\"user\",\"content\":\"Hello\"}].",
          "title": "Messages",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "max_tokens": {
          "default": 1024,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        },
        "n": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "N",
          "type": "integer"
        },
        "stop": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "messages"
      ],
      "title": "CreateChatCompletion",
      "type": "object"
    },
    "CreateMaestroRun": {
      "description": "Start one Maestro run; use Get Maestro Run to retrieve its later status.",
      "properties": {
        "operation": {
          "const": "create_maestro_run",
          "default": "create_maestro_run",
          "title": "Operation",
          "type": "string"
        },
        "input": {
          "description": "Instruction for Maestro.",
          "minLength": 1,
          "title": "Input",
          "type": "string"
        },
        "system_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overall role and response style.",
          "title": "System Prompt"
        },
        "requirements": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "items": {
                  "$ref": "#/$defs/Requirement"
                },
                "maxItems": 10,
                "type": "array"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirements",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "models": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "items": {
                  "type": "string"
                },
                "maxItems": 1,
                "type": "array"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Models",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "budget": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Budget",
          "type": "string"
        },
        "include": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "items": {
                  "enum": [
                    "data_sources",
                    "requirements_result"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Include",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "output_type": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON Schema for structured output.",
          "title": "Output Type",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "input"
      ],
      "title": "CreateMaestroRun",
      "type": "object"
    },
    "DeleteFile": {
      "description": "Delete a file from the workspace library.",
      "properties": {
        "file_id": {
          "description": "File UUID returned by upload or list files.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_file",
          "default": "delete_file",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "DeleteFile",
      "type": "object"
    },
    "GetBatchStatus": {
      "description": "Read document ingestion counts for a library batch.",
      "properties": {
        "operation": {
          "const": "get_batch_status",
          "default": "get_batch_status",
          "title": "Operation",
          "type": "string"
        },
        "batch_id": {
          "format": "uuid",
          "title": "Batch Id",
          "type": "string"
        }
      },
      "required": [
        "batch_id"
      ],
      "title": "GetBatchStatus",
      "type": "object"
    },
    "GetFile": {
      "description": "Read metadata for one library file.",
      "properties": {
        "file_id": {
          "description": "File UUID returned by upload or list files.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "get_file",
          "default": "get_file",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetFile",
      "type": "object"
    },
    "GetFileDownloadLink": {
      "description": "Get a signed file download link without following it.",
      "properties": {
        "file_id": {
          "description": "File UUID returned by upload or list files.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "get_file_download_link",
          "default": "get_file_download_link",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "GetFileDownloadLink",
      "type": "object"
    },
    "GetMaestroRun": {
      "description": "Retrieve a Maestro run's status, result and requirement scores.",
      "properties": {
        "operation": {
          "const": "get_maestro_run",
          "default": "get_maestro_run",
          "title": "Operation",
          "type": "string"
        },
        "execution_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Execution Id",
          "type": "string"
        }
      },
      "required": [
        "execution_id"
      ],
      "title": "GetMaestroRun",
      "type": "object"
    },
    "ListFiles": {
      "description": "List one page of workspace files, optionally filtered by metadata.",
      "properties": {
        "operation": {
          "const": "list_files",
          "default": "list_files",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact uploaded filename.",
          "title": "Name"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Library path prefix.",
          "title": "Path"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "DB_RECORD_CREATED",
                "UPLOADED",
                "UPLOAD_FAILED",
                "PROCESSED",
                "PROCESSING_FAILED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "DB_RECORD_CREATED",
            "UPLOADED",
            "UPLOAD_FAILED",
            "PROCESSED",
            "PROCESSING_FAILED"
          ],
          "x-enum-searchable": true
        },
        "label": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON array of case-sensitive labels.",
          "title": "Label",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Use next_offset from the preceding full page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "title": "ListFiles",
      "type": "object"
    },
    "Requirement": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "is_mandatory": {
          "default": false,
          "title": "Is Mandatory",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "StudioByAI21LabsAPIKey": {
      "properties": {
        "credential_type": {
          "const": "studio_by_ai21_labs_api_key",
          "default": "studio_by_ai21_labs_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Studio By AI21 Labs API Key",
      "type": "object",
      "x-credential-instructions": "In AI21 Studio, open Settings \u2192 API Keys, create a workspace key and paste it here. NoClick reads your workspace file library to check the connection.",
      "x-credential-url": "https://docs.ai21.com/docs/create-api-key"
    },
    "UpdateFile": {
      "description": "Replace file labels or the public URL metadata.",
      "properties": {
        "file_id": {
          "description": "File UUID returned by upload or list files.",
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "operation": {
          "const": "update_file",
          "default": "update_file",
          "title": "Operation",
          "type": "string"
        },
        "labels": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON array replacing all labels; [] clears them.",
          "title": "Labels",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "publicUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Metadata only; NoClick does not fetch this URL.",
          "title": "Public URL"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "UpdateFile",
      "type": "object"
    },
    "UploadFile": {
      "description": "Upload a UTF-8 text or HTML document with optional library metadata.",
      "properties": {
        "operation": {
          "const": "upload_file",
          "default": "upload_file",
          "title": "Operation",
          "type": "string"
        },
        "filename": {
          "description": "Unique filename ending in .txt or .html.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.(txt|html)$",
          "title": "Filename",
          "type": "string"
        },
        "file_content": {
          "contentMediaType": "text/plain",
          "description": "UTF-8 document text (maximum 5 MB).",
          "maxLength": 5000000,
          "minLength": 1,
          "title": "File Content",
          "type": "string",
          "ui:widget": "code_editor"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "labels": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Labels",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "publicUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source URL metadata only.",
          "title": "Public URL"
        }
      },
      "required": [
        "filename",
        "file_content"
      ],
      "title": "UploadFile",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_chat_completion": "#/$defs/CreateChatCompletion",
          "create_maestro_run": "#/$defs/CreateMaestroRun",
          "delete_file": "#/$defs/DeleteFile",
          "get_batch_status": "#/$defs/GetBatchStatus",
          "get_file": "#/$defs/GetFile",
          "get_file_download_link": "#/$defs/GetFileDownloadLink",
          "get_maestro_run": "#/$defs/GetMaestroRun",
          "list_files": "#/$defs/ListFiles",
          "update_file": "#/$defs/UpdateFile",
          "upload_file": "#/$defs/UploadFile"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListFiles"
        },
        {
          "$ref": "#/$defs/GetFile"
        },
        {
          "$ref": "#/$defs/UpdateFile"
        },
        {
          "$ref": "#/$defs/DeleteFile"
        },
        {
          "$ref": "#/$defs/GetFileDownloadLink"
        },
        {
          "$ref": "#/$defs/UploadFile"
        },
        {
          "$ref": "#/$defs/GetBatchStatus"
        },
        {
          "$ref": "#/$defs/CreateChatCompletion"
        },
        {
          "$ref": "#/$defs/CreateMaestroRun"
        },
        {
          "$ref": "#/$defs/GetMaestroRun"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/StudioByAI21LabsAPIKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Studio-by-ai21-labs Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
