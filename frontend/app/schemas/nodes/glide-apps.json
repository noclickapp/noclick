{
  "$defs": {
    "AddRows": {
      "additionalProperties": false,
      "properties": {
        "on_schema_error": {
          "default": "abort",
          "description": "How Glide handles data that differs from the table schema.",
          "enum": [
            "abort",
            "dropColumns",
            "updateSchema"
          ],
          "title": "On Schema Error",
          "type": "string"
        },
        "rows_json": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "additionalProperties": {},
              "type": "object"
            },
            "type": "array"
          },
          "description": "Array of row objects keyed by Glide column IDs. Empty arrays are allowed.",
          "maxLength": 5000000,
          "title": "Rows JSON",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "table_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Table ID",
          "type": "string"
        },
        "operation": {
          "const": "add_rows",
          "default": "add_rows",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "rows_json",
        "table_id"
      ],
      "title": "AddRows",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "type": {
          "enum": [
            "string",
            "uri",
            "imageURI",
            "audioURI",
            "markdown",
            "phoneNumber",
            "emailAddress",
            "emoji",
            "date",
            "time",
            "dateTime",
            "duration",
            "number",
            "boolean",
            "json"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Column",
      "type": "object"
    },
    "CreateTable": {
      "additionalProperties": false,
      "description": "Create a Big Table with initial rows and optional explicit column types.",
      "properties": {
        "columns": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Column"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional column schema; omit to infer from rows.",
          "title": "Columns"
        },
        "on_schema_error": {
          "default": "abort",
          "description": "How Glide handles data that differs from the table schema.",
          "enum": [
            "abort",
            "dropColumns",
            "updateSchema"
          ],
          "title": "On Schema Error",
          "type": "string"
        },
        "rows_json": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "additionalProperties": {},
              "type": "object"
            },
            "type": "array"
          },
          "description": "Array of row objects keyed by Glide column IDs. Empty arrays are allowed.",
          "maxLength": 5000000,
          "title": "Rows JSON",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "operation": {
          "const": "create_table",
          "default": "create_table",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "apps_to_link": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App IDs to Link"
        },
        "asynchronous": {
          "default": false,
          "description": "Request a job instead of waiting for completion.",
          "title": "Asynchronous",
          "type": "boolean"
        }
      },
      "required": [
        "rows_json",
        "name"
      ],
      "title": "CreateTable",
      "type": "object"
    },
    "DeleteRow": {
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Table ID",
          "type": "string"
        },
        "row_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Row ID",
          "type": "string"
        },
        "operation": {
          "const": "delete_row",
          "default": "delete_row",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "table_id",
        "row_id"
      ],
      "title": "DeleteRow",
      "type": "object"
    },
    "DeleteStash": {
      "additionalProperties": false,
      "properties": {
        "stash_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,255}$",
          "title": "Stash Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_stash",
          "default": "delete_stash",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "stash_id"
      ],
      "title": "DeleteStash",
      "type": "object"
    },
    "GetJob": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_job",
          "default": "get_job",
          "title": "Operation",
          "type": "string"
        },
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "GetJob",
      "type": "object"
    },
    "GetRow": {
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Table ID",
          "type": "string"
        },
        "row_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Row ID",
          "type": "string"
        },
        "operation": {
          "const": "get_row",
          "default": "get_row",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "table_id",
        "row_id"
      ],
      "title": "GetRow",
      "type": "object"
    },
    "GlideAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "glide_apps_api_token",
          "default": "glide_apps_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Glide API Token",
      "type": "object",
      "x-credential-instructions": "Copy your API auth token from the Glide Data Editor. It belongs to your Glide user and team and grants access to that team's applications and data. Paste the token without the Bearer prefix.",
      "x-credential-url": "https://apidocs.glideapps.com/api-reference/v2/general/authentication"
    },
    "ImportTable": {
      "additionalProperties": false,
      "description": "Ask Glide to import a publicly accessible dataset URL as a new Big Table.",
      "properties": {
        "on_schema_error": {
          "default": "abort",
          "description": "How Glide handles data that differs from the table schema.",
          "enum": [
            "abort",
            "dropColumns",
            "updateSchema"
          ],
          "title": "On Schema Error",
          "type": "string"
        },
        "operation": {
          "const": "import_table",
          "default": "import_table",
          "title": "Operation",
          "type": "string"
        },
        "from_url": {
          "format": "uri",
          "maxLength": 8192,
          "pattern": "^https://[^\\s]+$",
          "title": "From Url",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "apps_to_link": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Apps To Link"
        }
      },
      "required": [
        "from_url"
      ],
      "title": "ImportTable",
      "type": "object"
    },
    "ListRows": {
      "additionalProperties": false,
      "description": "Read one page; pass the returned continuation to read the next page.",
      "properties": {
        "table_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Table ID",
          "type": "string"
        },
        "operation": {
          "const": "list_rows",
          "default": "list_rows",
          "title": "Operation",
          "type": "string"
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "continuation": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation"
        }
      },
      "required": [
        "table_id"
      ],
      "title": "ListRows",
      "type": "object"
    },
    "ListTables": {
      "additionalProperties": false,
      "description": "List all Big Tables in the token's team.",
      "properties": {
        "operation": {
          "const": "list_tables",
          "default": "list_tables",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListTables",
      "type": "object"
    },
    "ReplaceTable": {
      "additionalProperties": false,
      "description": "Replace all table rows. Existing data is overwritten, including with an empty array.",
      "properties": {
        "if_match": {
          "anyOf": [
            {
              "pattern": "^\"[0-9]+\"$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional quoted version from Glide etag, for example \"123\". A stale version returns 412.",
          "title": "If Match"
        },
        "columns": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Column"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional column schema; omit to infer from rows.",
          "title": "Columns"
        },
        "on_schema_error": {
          "default": "abort",
          "description": "How Glide handles data that differs from the table schema.",
          "enum": [
            "abort",
            "dropColumns",
            "updateSchema"
          ],
          "title": "On Schema Error",
          "type": "string"
        },
        "rows_json": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "additionalProperties": {},
              "type": "object"
            },
            "type": "array"
          },
          "description": "Array of row objects keyed by Glide column IDs. Empty arrays are allowed.",
          "maxLength": 5000000,
          "title": "Rows JSON",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "table_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Table ID",
          "type": "string"
        },
        "operation": {
          "const": "replace_table",
          "default": "replace_table",
          "title": "Operation",
          "type": "string"
        },
        "asynchronous": {
          "default": false,
          "title": "Asynchronous",
          "type": "boolean"
        }
      },
      "required": [
        "rows_json",
        "table_id"
      ],
      "title": "ReplaceTable",
      "type": "object"
    },
    "SetStashChunk": {
      "additionalProperties": false,
      "description": "Set one stash chunk. Reusing its serial overwrites that chunk.",
      "properties": {
        "rows_json": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "additionalProperties": {},
              "type": "object"
            },
            "type": "array"
          },
          "description": "Array of row objects keyed by Glide column IDs. Empty arrays are allowed.",
          "maxLength": 5000000,
          "title": "Rows JSON",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "stash_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,255}$",
          "title": "Stash Id",
          "type": "string"
        },
        "operation": {
          "const": "set_stash_chunk",
          "default": "set_stash_chunk",
          "title": "Operation",
          "type": "string"
        },
        "serial": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,255}$",
          "title": "Serial",
          "type": "string"
        }
      },
      "required": [
        "rows_json",
        "stash_id",
        "serial"
      ],
      "title": "SetStashChunk",
      "type": "object"
    },
    "UpdateRow": {
      "additionalProperties": false,
      "properties": {
        "if_match": {
          "anyOf": [
            {
              "pattern": "^\"[0-9]+\"$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional quoted version from Glide etag, for example \"123\". A stale version returns 412.",
          "title": "If Match"
        },
        "on_schema_error": {
          "default": "abort",
          "description": "How Glide handles data that differs from the table schema.",
          "enum": [
            "abort",
            "dropColumns",
            "updateSchema"
          ],
          "title": "On Schema Error",
          "type": "string"
        },
        "table_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Table ID",
          "type": "string"
        },
        "row_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Row ID",
          "type": "string"
        },
        "operation": {
          "const": "update_row",
          "default": "update_row",
          "title": "Operation",
          "type": "string"
        },
        "values_json": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "additionalProperties": {},
            "type": "object"
          },
          "description": "Object of column IDs and new values; omitted columns are unchanged.",
          "maxLength": 1000000,
          "title": "Column Values JSON",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "table_id",
        "row_id",
        "values_json"
      ],
      "title": "UpdateRow",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_rows": "#/$defs/AddRows",
          "create_table": "#/$defs/CreateTable",
          "delete_row": "#/$defs/DeleteRow",
          "delete_stash": "#/$defs/DeleteStash",
          "get_job": "#/$defs/GetJob",
          "get_row": "#/$defs/GetRow",
          "import_table": "#/$defs/ImportTable",
          "list_rows": "#/$defs/ListRows",
          "list_tables": "#/$defs/ListTables",
          "replace_table": "#/$defs/ReplaceTable",
          "set_stash_chunk": "#/$defs/SetStashChunk",
          "update_row": "#/$defs/UpdateRow"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListTables"
        },
        {
          "$ref": "#/$defs/ListRows"
        },
        {
          "$ref": "#/$defs/GetRow"
        },
        {
          "$ref": "#/$defs/CreateTable"
        },
        {
          "$ref": "#/$defs/ImportTable"
        },
        {
          "$ref": "#/$defs/ReplaceTable"
        },
        {
          "$ref": "#/$defs/AddRows"
        },
        {
          "$ref": "#/$defs/UpdateRow"
        },
        {
          "$ref": "#/$defs/DeleteRow"
        },
        {
          "$ref": "#/$defs/GetJob"
        },
        {
          "$ref": "#/$defs/SetStashChunk"
        },
        {
          "$ref": "#/$defs/DeleteStash"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/GlideAPITokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Glide-apps Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
