{
  "$defs": {
    "GetCustomer": {
      "additionalProperties": false,
      "description": "Read a customer and subscription by MoonClerk ID.",
      "properties": {
        "operation": {
          "const": "get_customer",
          "default": "get_customer",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "minimum": 1,
          "title": "Customer ID",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetCustomer",
      "type": "object"
    },
    "GetForm": {
      "additionalProperties": false,
      "description": "Read a payment form by MoonClerk ID.",
      "properties": {
        "operation": {
          "const": "get_form",
          "default": "get_form",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "minimum": 1,
          "title": "Form ID",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetForm",
      "type": "object"
    },
    "GetPayment": {
      "additionalProperties": false,
      "description": "Read a payment by MoonClerk ID, preserving cents, custom fields and Stripe references.",
      "properties": {
        "operation": {
          "const": "get_payment",
          "default": "get_payment",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "minimum": 1,
          "title": "Payment ID",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetPayment",
      "type": "object"
    },
    "ListCustomers": {
      "additionalProperties": false,
      "description": "List customers (called Plans in MoonClerk), optionally filtered by form, checkout, next payment or subscription status.",
      "properties": {
        "count": {
          "default": 10,
          "description": "Records per page (1\u2013100).",
          "maximum": 100,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Starting row; use next_offset to request another page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "form_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Form ID"
        },
        "operation": {
          "const": "list_customers",
          "default": "list_customers",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "checkout_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date",
          "title": "Checkout From"
        },
        "checkout_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date",
          "title": "Checkout To"
        },
        "next_payment_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date",
          "title": "Next Payment From"
        },
        "next_payment_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date",
          "title": "Next Payment To"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "active",
                "canceled",
                "expired",
                "past_due",
                "pending",
                "unpaid"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "active",
            "canceled",
            "expired",
            "past_due",
            "pending",
            "unpaid"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "ListCustomers",
      "type": "object"
    },
    "ListForms": {
      "additionalProperties": false,
      "description": "List payment forms in this account.",
      "properties": {
        "count": {
          "default": 10,
          "description": "Records per page (1\u2013100).",
          "maximum": 100,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Starting row; use next_offset to request another page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "operation": {
          "const": "list_forms",
          "default": "list_forms",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListForms",
      "type": "object"
    },
    "ListPayments": {
      "additionalProperties": false,
      "description": "List payments, optionally filtered by form, customer, UTC date range or payment status. Amounts remain in cents.",
      "properties": {
        "count": {
          "default": 10,
          "description": "Records per page (1\u2013100).",
          "maximum": 100,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Starting row; use next_offset to request another page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "form_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Form ID"
        },
        "operation": {
          "const": "list_payments",
          "default": "list_payments",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "customer_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer ID"
        },
        "date_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date",
          "title": "Date From"
        },
        "date_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date",
          "title": "Date To"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "successful",
                "refunded",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "successful",
            "refunded",
            "failed"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "ListPayments",
      "type": "object"
    },
    "MoonclerkAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "moonclerk_api_key",
          "default": "moonclerk_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Moonclerk API Key",
      "type": "object",
      "x-credential-instructions": "In MoonClerk, open Settings \u2192 API Key and generate or copy your API key. Paste only the key below. It grants read access to your account's payment forms, customers and payments. MoonClerk's API does not support writes.",
      "x-credential-url": "https://app.moonclerk.com/settings/api-key"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_customer": "#/$defs/GetCustomer",
          "get_form": "#/$defs/GetForm",
          "get_payment": "#/$defs/GetPayment",
          "list_customers": "#/$defs/ListCustomers",
          "list_forms": "#/$defs/ListForms",
          "list_payments": "#/$defs/ListPayments"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListForms"
        },
        {
          "$ref": "#/$defs/GetForm"
        },
        {
          "$ref": "#/$defs/ListCustomers"
        },
        {
          "$ref": "#/$defs/GetCustomer"
        },
        {
          "$ref": "#/$defs/ListPayments"
        },
        {
          "$ref": "#/$defs/GetPayment"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoonclerkAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Moonclerk Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "List failed payments from last month",
    "Find active customers for this payment form",
    "Get this customer's subscription"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
