          "title": "Execute Code Service",
          "type": "string",
          "ui:hidden": true
        },
        "service_name": {
          "minLength": 1,
          "title": "Service Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "service_name"
      ],
      "title": "ExecuteService",
      "type": "object"
    },
    "ListCollections": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_collections",
          "default": "list_collections",
          "title": "List Collections",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListCollections",
      "type": "object"
    },
    "ListDevices": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_devices",
          "default": "list_devices",
          "title": "List Devices",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "additionalProperties": true,
          "title": "Query",
          "type": "object"
        }
      },
      "title": "ListDevices",
      "type": "object"
    },
    "ListRows": {
      "additionalProperties": false,
      "properties": {
        "collection_name": {
          "minLength": 1,
          "title": "Collection Name",
          "type": "string"
        },
        "query": {
          "additionalProperties": true,
          "description": "ClearBlade REST query object: FILTERS, SORT, PAGESIZE and PAGENUM.",
          "title": "Query",
          "type": "object"
        },
        "operation": {
          "const": "list_rows",
          "default": "list_rows",
          "title": "List Collection Rows",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "collection_name"
      ],
      "title": "ListRows",
      "type": "object"
    },
    "NewOrUpdatedRows": {
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_or_updated_rows",
          "default": "on_new_or_updated_rows",
          "title": "On New or Updated Collection Rows",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-is-trigger": true
        },
        "collection_name": {
          "minLength": 1,
          "title": "Collection Name",
          "type": "string"
        },
        "time_column": {
          "description": "Existing collection timestamp column to order descending. Monitors the latest 100 rows; changes outside that window are not observed.",
          "minLength": 1,
          "title": "Created or Updated Time Column",
          "type": "string"
        }
      },
      "required": [
        "collection_name",
        "time_column"
      ],
      "title": "NewOrUpdatedRows",
      "type": "object",
      "x-requires-webhook": true
    },
    "PublishMessage": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "publish_message",
          "default": "publish_message",
          "title": "Publish MQTT Message",
          "type": "string",
          "ui:hidden": true
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "payload": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "payload"
      ],
      "title": "PublishMessage",
      "type": "object"
    },
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    },
    "UpdateDevice": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "update_device",
          "default": "update_device",
          "title": "Update Device State",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "minLength": 1,
          "title": "Device Name",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "name",
        "state"
      ],
      "title": "UpdateDevice",
      "type": "object"
    },
    "UpdateRows": {
      "additionalProperties": false,
      "properties": {
        "collection_name": {
          "minLength": 1,
          "title": "Collection Name",
          "type": "string"
        },
        "operation": {
          "const": "update_rows",
          "default": "update_rows",
          "title": "Update Collection Rows",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "additionalProperties": true,
          "description": "Explicit query limiting the rows to update.",
          "minProperties": 1,
          "title": "Filter Query",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Column Values",
          "type": "object"
        }
      },
      "required": [
        "collection_name",
        "query",
        "values"
      ],
      "title": "UpdateRows",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "collection_columns": "#/$defs/CollectionColumns",
          "count_devices": "#/$defs/CountDevices",
          "count_rows": "#/$defs/CountRows",
          "create_device": "#/$defs/CreateDevice",
          "create_rows": "#/$defs/CreateRows",
          "delete_rows": "#/$defs/DeleteRows",
          "device_columns": "#/$defs/DeviceColumns",
          "execute_service": "#/$defs/ExecuteService",
          "list_collections": "#/$defs/ListCollections",
          "list_devices": "#/$defs/ListDevices",
          "list_rows": "#/$defs/ListRows",
          "on_new_or_updated_rows": "#/$defs/NewOrUpdatedRows",
          "publish_message": "#/$defs/PublishMessage",
          "update_device": "#/$defs/UpdateDevice",
          "update_rows": "#/$defs/UpdateRows"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListRows"
        },
        {
          "$ref": "#/$defs/CreateRows"
        },
        {
          "$ref": "#/$defs/UpdateRows"
        },
        {
          "$ref": "#/$defs/DeleteRows"
        },
        {
          "$ref": "#/$defs/CountRows"
        },
        {
          "$ref": "#/$defs/CollectionColumns"
        },
        {
          "$ref": "#/$defs/ListCollections"
        },
        {
          "$ref": "#/$defs/ListDevices"
        },
        {
          "$ref": "#/$defs/CountDevices"
        },
        {
          "$ref": "#/$defs/DeviceColumns"
        },
        {
          "$ref": "#/$defs/CreateDevice"
        },
        {
          "$ref": "#/$defs/UpdateDevice"
        },
        {
          "$ref": "#/$defs/ExecuteService"
        },
        {
          "$ref": "#/$defs/PublishMessage"
        },
        {
          "$ref": "#/$defs/NewOrUpdatedRows"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClearBladeCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Clearblade Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
