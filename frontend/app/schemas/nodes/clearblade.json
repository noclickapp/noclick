{
  "$defs": {
    "ClearBladeCredential": {
      "properties": {
        "credential_type": {
          "const": "clearblade_user_token",
          "default": "clearblade_user_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "user_token": {
          "description": "Paste a ClearBlade user authentication token. Expired tokens must be replaced.",
          "minLength": 1,
          "title": "User Token",
          "type": "string",
          "ui:widget": "password"
        },
        "system_key": {
          "description": "System key from the ClearBlade console.",
          "minLength": 1,
          "title": "System Key",
          "type": "string"
        }
      },
      "required": [
        "user_token",
        "system_key"
      ],
      "title": "ClearBlade User Token",
      "type": "object",
      "x-credential-url": "https://docs.clearblade.com/iotenterprise/user-authentication"
    },
    "CollectionColumns": {
      "additionalProperties": false,
      "properties": {
        "collection_name": {
          "minLength": 1,
          "title": "Collection Name",
          "type": "string"
        },
        "operation": {
          "const": "collection_columns",
          "default": "collection_columns",
          "title": "Get Collection Columns",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "collection_name"
      ],
      "title": "CollectionColumns",
      "type": "object"
    },
    "CountDevices": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "count_devices",
          "default": "count_devices",
          "title": "Count Devices",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "CountDevices",
      "type": "object"
    },
    "CountRows": {
      "additionalProperties": false,
      "properties": {
        "collection_name": {
          "minLength": 1,
          "title": "Collection Name",
          "type": "string"
        },
        "query": {
          "additionalProperties": true,
          "description": "ClearBlade REST query object: FILTERS, SORT, PAGESIZE and PAGENUM.",
          "title": "Query",
          "type": "object"
        },
        "operation": {
          "const": "count_rows",
          "default": "count_rows",
          "title": "Count Collection Rows",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "collection_name"
      ],
      "title": "CountRows",
      "type": "object"
    },
    "CreateDevice": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_device",
          "default": "create_device",
          "title": "Create Device",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "minLength": 1,
          "title": "Device Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "state": {
          "default": "",
          "title": "State",
          "type": "string"
        },
        "type": {
          "default": "",
          "title": "Device Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateDevice",
      "type": "object"
    },
    "CreateRows": {
      "additionalProperties": false,
      "properties": {
        "collection_name": {
          "minLength": 1,
          "title": "Collection Name",
          "type": "string"
        },
        "operation": {
          "const": "create_rows",
          "default": "create_rows",
          "title": "Create Collection Rows",
          "type": "string",
          "ui:hidden": true
        },
        "rows": {
          "description": "Array of column-value objects, as in the published ColumnField schema.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "collection_name",
        "rows"
      ],
      "title": "CreateRows",
      "type": "object"
    },
    "DeleteRows": {
      "additionalProperties": false,
      "properties": {
        "collection_name": {
          "minLength": 1,
          "title": "Collection Name",
          "type": "string"
        },
        "operation": {
          "const": "delete_rows",
          "default": "delete_rows",
          "title": "Delete Collection Rows",
          "type": "string",
          "ui:hidden": true
        },
        "query": {
          "additionalProperties": true,
          "description": "Explicit query limiting the rows to delete permanently.",
          "minProperties": 1,
          "title": "Filter Query",
          "type": "object"
        }
      },
      "required": [
        "collection_name",
        "query"
      ],
      "title": "DeleteRows",
      "type": "object"
    },
    "DeviceColumns": {
      "additionalProperties": false,
