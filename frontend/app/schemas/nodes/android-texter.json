    "SendMessage": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "send_message",
          "default": "send_message",
          "description": "Queues a message through a linked Android phone. A successful response confirms queueing, not delivery. Optional scheduling uses an ISO 8601 timestamp.",
          "title": "Send SMS or MMS",
          "type": "string",
          "ui:hidden": true
        },
        "phone": {
          "minLength": 1,
          "title": "Recipient Phone",
          "type": "string"
        },
        "message": {
          "maxLength": 1600,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 3166-1 alpha-2 country for local-format phone numbers; omitted uses the sending SIM's country.",
          "title": "Country"
