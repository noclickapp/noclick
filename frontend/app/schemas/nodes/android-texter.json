{
  "$defs": {
    "AndroidTexterApiKeyCredential": {
      "additionalProperties": false,
      "properties": {
        "credential_type": {
          "const": "android_texter_api_key",
          "default": "android_texter_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Paste your Android Texter API key, without a header name or Bearer prefix.",
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Android Texter API Key",
      "type": "object",
      "x-credential-instructions": "Create an API key in Android Texter under Dashboard \u2192 Settings \u2192 API Keys. Paste the key here; NoClick sends it in the X-API-Key header.",
      "x-credential-url": "https://androidtexter.com/dashboard/settings/api-keys"
    },
