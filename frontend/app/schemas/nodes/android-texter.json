        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omitted selects the first online device.",
          "title": "Device ID"
        },
        "media_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Include a media URL to send MMS.",
          "title": "Media URL"
        },
        "scheduled_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 timestamp for a future send; omitted sends immediately.",
          "title": "Scheduled At"
        },
        "sim_slot": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dual-SIM phones: 0 for SIM 1, 1 for SIM 2. Omitted lets the phone decide.",
          "title": "SIM Slot"
