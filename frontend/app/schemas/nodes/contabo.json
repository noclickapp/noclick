{
  "$defs": {
    "ContaboBearerCredential": {
      "properties": {
        "credential_type": {
          "const": "contabo_bearer",
          "default": "contabo_bearer",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "title": "Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "expected_instance_id": {
          "anyOf": [
            {
              "maxLength": 19,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional exact existing instance ID as decimal text. Every operation independently verifies this resource; no customer or tenant identity is inferred.",
          "title": "Expected Instance ID"
        }
      },
      "required": [
        "access_token"
      ],
      "title": "Contabo Bearer Token",
      "type": "object",
      "x-credential-help-url": "https://api.contabo.com/",
      "x-credential-instructions": "Supply an existing Contabo access token authorized for the required compute GETs. Contabo's documented password grant uses four separate credentials; this node does not exchange, refresh or mint tokens. Replace an expired token manually. Connection reads protected instance metadata and proves scoped resource reachability, not principal/customer identity. The optional expected instance is an existing resource witness."
    },
    "GetImage": {
      "additionalProperties": false,
      "properties": {
        "include_names": {
          "default": false,
          "description": "Opt in to instance display names, image and snapshot names. Internal host names, IPs, customer IDs, URLs, notes, credentials and configuration are always omitted.",
          "title": "Include Resource Names",
          "type": "boolean"
        },
        "operation": {
          "const": "get_image",
          "default": "get_image",
          "description": "Read the exact existing image ID and verify the singleton data array.",
          "title": "Get Image Metadata",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Cloud Metadata",
          "x-display-name": "Get Image Metadata",
          "x-is-trigger": false
        },
        "image_id": {
          "description": "Existing image ID; the saved-credential picker uses numeric pages and custom entry remains available.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Image ID",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "auto_select_sole_option": true
          }
        }
      },
      "required": [
        "image_id"
      ],
      "title": "GetImage",
      "type": "object"
    },
