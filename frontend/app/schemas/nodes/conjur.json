{
  "$defs": {
    "AddRoleMember": {
      "description": "Grant the selected role to a member.",
      "properties": {
        "kind": {
          "enum": [
            "variable",
            "policy",
            "user",
            "role",
            "host",
            "host_factory",
            "group",
            "layer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "identifier": {
          "description": "Original resource ID, e.g. prod/aws/db-password; NoClick URL-encodes it.",
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "member": {
          "description": "Fully qualified role ID to grant or revoke, e.g. myorg:user:alice.",
          "minLength": 1,
          "pattern": "^[^ ]+$",
          "title": "Member",
          "type": "string"
        },
        "operation": {
          "const": "add_role_member",
          "default": "add_role_member",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "kind",
        "identifier",
        "member"
      ],
      "title": "AddRoleMember",
      "type": "object"
    },
    "ConjurAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "conjur_api_key",
          "default": "conjur_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "server_url": {
          "description": "Exact HTTPS origin of your Conjur server, e.g. https://conjur.example.com.",
          "title": "Server URL",
          "type": "string"
        },
        "account": {
          "minLength": 1,
          "title": "Account",
          "type": "string"
        },
        "login": {
          "description": "User ID, or host/<host-id>. Enter the original value, without URL encoding.",
          "minLength": 1,
          "title": "Login",
          "type": "string"
        },
        "api_key": {
          "maxLength": 56,
          "minLength": 50,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "server_url",
        "account",
        "login",
        "api_key"
      ],
      "title": "Conjur API Key",
      "type": "object",
      "x-credential-instructions": "Enter your Conjur HTTPS server origin, account, login and existing API key. For a host, use host/<host-id> as the login. NoClick exchanges the key for a short-lived access token for each execution and verifies the connection with WhoAmI. Permissions remain controlled by your Conjur policy. Secret reads and loaded policies can return sensitive values.",
      "x-credential-url": "https://github.com/cyberark/conjur-openapi-spec/blob/main/spec/authentication.yml"
    },
    "GetIdentity": {
      "description": "Show the authenticated account and username.",
      "properties": {
        "operation": {
          "const": "get_identity",
          "default": "get_identity",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetIdentity",
      "type": "object"
    },
    "GetPublicKeys": {
