        "kind",
        "identifier"
      ],
      "title": "GetRole",
      "type": "object"
    },
    "GetSecret": {
      "description": "Read the latest or a retained version of a secret value.",
      "properties": {
        "operation": {
          "const": "get_secret",
          "default": "get_secret",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
