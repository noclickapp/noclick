        "operation": {
          "const": "get_role",
          "default": "get_role",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "view": {
          "default": "details",
          "enum": [
            "details",
            "members",
            "memberships",
            "all"
          ],
          "title": "View",
          "type": "string"
        },
        "limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
