          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "kind",
        "identifier"
      ],
      "title": "GetResource",
      "type": "object"
    },
    "GetRole": {
      "description": "Get role details, direct members or memberships.",
      "properties": {
        "kind": {
          "enum": [
            "variable",
            "policy",
            "user",
            "role",
            "host",
            "host_factory",
            "group",
            "layer"
