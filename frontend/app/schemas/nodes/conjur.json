  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_role_member": "#/$defs/AddRoleMember",
          "get_identity": "#/$defs/GetIdentity",
          "get_public_keys": "#/$defs/GetPublicKeys",
          "get_resource": "#/$defs/GetResource",
          "get_role": "#/$defs/GetRole",
          "get_secret": "#/$defs/GetSecret",
          "get_secrets": "#/$defs/GetSecrets",
          "list_account_resources": "#/$defs/ListAccountResources",
          "list_kind_resources": "#/$defs/ListKindResources",
          "list_resources": "#/$defs/ListResources",
          "load_policy": "#/$defs/LoadPolicy",
          "remove_role_member": "#/$defs/RemoveRoleMember",
          "replace_policy": "#/$defs/ReplacePolicy",
          "set_secret": "#/$defs/SetSecret",
          "update_policy": "#/$defs/UpdatePolicy"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetIdentity"
        },
        {
          "$ref": "#/$defs/GetSecret"
        },
        {
          "$ref": "#/$defs/SetSecret"
        },
        {
          "$ref": "#/$defs/GetSecrets"
        },
        {
          "$ref": "#/$defs/ListResources"
        },
        {
          "$ref": "#/$defs/ListAccountResources"
        },
        {
          "$ref": "#/$defs/ListKindResources"
        },
        {
          "$ref": "#/$defs/GetResource"
        },
        {
          "$ref": "#/$defs/GetRole"
        },
        {
          "$ref": "#/$defs/AddRoleMember"
        },
        {
          "$ref": "#/$defs/RemoveRoleMember"
        },
        {
          "$ref": "#/$defs/LoadPolicy"
        },
        {
          "$ref": "#/$defs/UpdatePolicy"
        },
        {
          "$ref": "#/$defs/ReplacePolicy"
        },
        {
          "$ref": "#/$defs/GetPublicKeys"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConjurAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
