{
  "$defs": {
    "AddCallTags": {
      "additionalProperties": false,
      "description": "Update call tags. Changes may trigger Nimbata call-update workflows. Existing tags are preserved.",
      "properties": {
        "org_id": {
          "description": "The org_id returned by Get Current User.",
          "format": "uuid",
          "title": "Organization ID",
          "type": "string"
        },
        "project_id": {
          "description": "Project UUID from List Projects.",
          "format": "uuid",
          "title": "Project ID",
          "type": "string"
        },
        "call_id": {
          "description": "Inbound uu_id_a or outbound report-row ID.",
          "maxLength": 45,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Call Id",
          "type": "string"
        },
        "call_direction": {
          "default": "inbound",
          "enum": [
            "inbound",
            "outbound"
          ],
          "title": "Call Direction",
          "type": "string"
        },
        "uu_id_b": {
          "anyOf": [
            {
              "maxLength": 45,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional destination leg ID.",
          "title": "Uu Id B"
        },
        "operation": {
          "const": "add_call_tags",
          "default": "add_call_tags",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "tag_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Tag Ids",
          "type": "array"
        }
      },
      "required": [
        "org_id",
        "project_id",
        "call_id",
        "tag_ids"
      ],
      "title": "AddCallTags",
      "type": "object"
    },
