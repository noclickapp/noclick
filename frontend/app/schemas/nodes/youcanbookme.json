    "YouCanBookMeQueryConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "query_bookings",
          "default": "query_bookings",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Bookings",
          "x-display-name": "Query Bounded Account Bookings",
          "x-is-trigger": false
        },
        "profile_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional existing protected profile filter; otherwise this account's profiles only.",
          "title": "Profile Id",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "profile_id",
            "searchable": true
          },
          "x-resource-type": "youcanbookme_profile"
        },
        "from_time": {
          "description": "Required ISO datetime with offset, transmitted as from. StartsAt and createdAt sorting are documented by vendor staff.",
          "maxLength": 64,
          "title": "From Time",
          "type": "string"
        },
        "to_time": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional ISO datetime with offset, transmitted as to.",
          "title": "To Time"
        },
        "direction": {
          "default": "forwards",
          "enum": [
            "forwards",
            "backwards"
          ],
          "title": "Direction",
          "type": "string"
        },
        "time_criteria": {
          "default": "startsAt",
          "enum": [
            "startsAt",
            "createdAt"
          ],
          "title": "Time Criteria",
          "type": "string"
        },
        "sort_by": {
          "default": "startsAt",
          "enum": [
            "startsAt",
            "createdAt"
          ],
          "title": "Sort By",
          "type": "string"
        },
        "page_size": {
          "default": 50,
          "maximum": 500,
          "minimum": 10,
          "title": "Page Size",
          "type": "integer"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "tentative",
                "rejected",
                "cancelled",
                "upcoming",
                "inProgress",
                "finished",
                "noShow"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One documented status filter. Returned status text is preserved: vendor has also documented later snake_case responses.",
          "title": "Status",
          "enum": [
            "tentative",
            "rejected",
            "cancelled",
            "upcoming",
            "inProgress",
            "finished",
            "noShow"
          ],
          "x-enum-searchable": true
        },
        "search_text": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Text"
        },
        "search_criteria": {
          "default": "title",
          "description": "One documented searchTextCriteria filter; no guessed array encoding.",
          "enum": [
            "title",
            "form",
            "ref"
          ],
          "title": "Search Criteria",
          "type": "string"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Token"
        }
      },
      "required": [
        "from_time"
      ],
      "title": "YouCanBookMeQueryConfig",
      "type": "object"
    },
