{
  "$defs": {
    "YouCanBookMeAPIKeyCredential": {
      "additionalProperties": false,
      "properties": {
        "credential_type": {
          "const": "youcanbookme_api_key",
          "default": "youcanbookme_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "account_id": {
          "description": "Exact account ID paired with this issued key. Team account access requires the organization owner's matching account/key; entitlement is not assumed.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "auth_username": {
          "description": "HTTP Basic username: this account ID or its account email. Do not enter a login password here.",
          "maxLength": 320,
          "title": "Auth Username",
          "type": "string"
        },
        "api_key": {
          "description": "Already issued account API key, used as the HTTP Basic password. This is not your account login password, OAuth token or a key-issuance action.",
          "title": "Api Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "account_id",
        "auth_username",
        "api_key"
      ],
      "title": "YouCanBookMe Account API Key",
      "type": "object",
      "x-credential-url": "https://support.youcanbook.me/hc/en-us/articles/17321549364375-Accessing-your-account-API-key"
    },
