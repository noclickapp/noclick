    "GetTemplateConfig": {
      "additionalProperties": false,
      "description": "Get a template.",
      "properties": {
        "operation": {
          "const": "get_template",
          "default": "get_template",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "uid": {
          "description": "The ID of the template, shown in the editor and returned by `GET /templates`.",
          "title": "Uid",
          "type": "string"
        }
      },
      "required": [
        "uid"
      ],
      "title": "GetTemplateConfig",
      "type": "object"
    },
    "LayerOverride": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "The name of the layer to customize, shown in the settings panel when the layer is selected. `canvas` is the background.",
          "title": "Name",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The text to render in a text layer. Basic HTML is supported and sanitized.",
          "title": "Text"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The text color. E.g. `#000000`, `rgb(0,0,0)` or `rgba(0,0,0,0.5)`.",
          "title": "Color"
        },
        "fontSize": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Font size of a text layer, e.g. `48px`.",
          "title": "Fontsize"
        },
        "backgroundColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The background color of the layer. E.g. `#000000`, `rgb(0,0,0)` or `rgba(0,0,0,0.5)`.",
          "title": "Backgroundcolor"
        },
        "borderColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The border color of the layer. Set `borderWidth` as well. E.g. `#000000`, `rgb(0,0,0)` or `rgba(0,0,0,0.5)`.",
          "title": "Bordercolor"
        },
        "borderWidth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The border width of the layer, e.g. `1px`.",
          "title": "Borderwidth"
        },
        "borderRadius": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The border radius of the layer, e.g. `5px` or `50%`.",
          "title": "Borderradius"
        },
        "opacity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Layer opacity from `0` (hidden) to `1` (as designed).",
          "title": "Opacity"
        },
        "imageUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The image to render in an image layer.",
          "title": "Imageurl"
        },
        "imagePosition": {
          "anyOf": [
            {
              "enum": [
                "cro",
                "cov",
                "ai_face",
                "align"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the image fits its container. Empty centers it. `cro` crops to fill, `cov` scales to cover, `ai_face` detects faces and keeps them visible, and `align` uses `imageAlignH` and `imageAlignV`.",
          "title": "Imageposition",
          "enum": [
            "cro",
            "cov",
            "ai_face",
            "align"
          ],
          "x-enum-searchable": true
        },
        "imageAlignH": {
          "anyOf": [
            {
              "enum": [
                "left",
                "center",
                "right",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Horizontal image alignment when `imagePosition` is `align`.",
          "title": "Imagealignh",
          "enum": [
            "left",
            "center",
            "right",
            "full"
          ],
          "x-enum-searchable": true
        },
        "imageAlignV": {
          "anyOf": [
            {
              "enum": [
                "top",
                "center",
                "bottom",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vertical image alignment when `imagePosition` is `align`.",
          "title": "Imagealignv",
          "enum": [
            "top",
            "center",
            "bottom",
            "full"
          ],
          "x-enum-searchable": true
        },
        "imageEffect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A CSS filter applied to the image, e.g. `grayscale(100%)` or `blur(4px)`.",
          "title": "Imageeffect"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prompt for an AI Image layer in \"Per request\" mode. Supports `[name]` tokens that refer to `referenceImages`.",
          "title": "Prompt"
        },
        "sourceImage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL of a photo for an AI Image layer to edit. Omit it for text-to-image.",
          "title": "Sourceimage"
        },
        "referenceImages": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ReferenceImage"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Named reference images for an AI Image layer.",
          "title": "Referenceimages"
        },
        "chartColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The color of the chart. E.g. `#000000`, `rgb(0,0,0)` or `rgba(0,0,0,0.5)`.",
          "title": "Chartcolor"
        },
        "chartLabelColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The color of the chart axis labels. E.g. `#000000`, `rgb(0,0,0)` or `rgba(0,0,0,0.5)`.",
          "title": "Chartlabelcolor"
        },
        "chartDataLabels": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Labels shown on the X axis.",
          "title": "Chartdatalabels"
        },
        "chartDataValues": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The data series of the chart.",
          "title": "Chartdatavalues"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Progress value for gauge and line progress bar layers, usually `0` to `100`.",
          "title": "Value"
        },
        "maxValue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total number of ticks of a radial tick gauge, e.g. `24`, `60` or `100`.",
          "title": "Maxvalue"
        },
        "activeColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Color of the filled ticks of a radial tick gauge.",
          "title": "Activecolor"
        },
        "inactiveColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Color of the empty ticks of a radial tick gauge.",
          "title": "Inactivecolor"
        },
        "circleColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Color of the background ring of a simple gauge.",
          "title": "Circlecolor"
        },
        "progressColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Color of the progress arc or of the filled part of a line progress bar.",
          "title": "Progresscolor"
