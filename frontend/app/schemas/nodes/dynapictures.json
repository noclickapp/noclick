          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "jobUid": {
          "description": "The `jobUid` from the start request.",
          "title": "Jobuid",
          "type": "string"
        }
      },
      "required": [
        "jobUid"
      ],
      "title": "GetAiGenerationConfig",
      "type": "object"
    },
    "GetMediaAssetConfig": {
      "additionalProperties": false,
