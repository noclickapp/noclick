{
  "$defs": {
    "AddLayerConfig": {
      "additionalProperties": false,
      "description": "Add a layer.",
      "properties": {
        "operation": {
          "const": "add_layer",
          "default": "add_layer",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "uid": {
          "description": "The ID of the template, shown in the editor and returned by `GET /templates`.",
          "title": "Uid",
          "type": "string"
        },
        "type": {
          "description": "The kind of layer to add.",
          "enum": [
            "text",
            "image",
            "ai_image",
            "rectangle",
            "circle"
          ],
          "title": "Type",
          "type": "string"
        },
        "pageIndex": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The page of a multipage design. Defaults to the first page.",
          "title": "Pageindex"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The text of a text layer.",
          "title": "Text"
        },
        "imageUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The image of an image layer.",
          "title": "Imageurl"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The prompt of an AI Image layer.",
          "title": "Prompt"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The text color.",
          "title": "Color"
        },
        "backgroundColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The background color.",
          "title": "Backgroundcolor"
        },
        "fontSize": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The font size in pixels.",
          "title": "Fontsize"
        },
        "textAlign": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The text alignment.",
          "title": "Textalign"
        },
        "fontFamily": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The font family.",
          "title": "Fontfamily"
        },
        "fontWeight": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The font weight.",
          "title": "Fontweight"
        },
        "aiModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The model of an AI Image layer.",
          "title": "Aimodel"
        },
        "aiAspectRatio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The aspect ratio of an AI Image layer.",
          "title": "Aiaspectratio"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Left position in pixels.",
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Top position in pixels.",
          "title": "Y"
        },
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Width in pixels.",
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Height in pixels.",
          "title": "Height"
        },
        "zIndex": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The stacking order.",
          "title": "Zindex"
        }
      },
      "required": [
        "uid",
        "type"
      ],
      "title": "AddLayerConfig",
      "type": "object"
    },
    "CreateDesignConfig": {
      "additionalProperties": false,
      "description": "Create an empty design.",
      "properties": {
        "operation": {
          "const": "create_design",
          "default": "create_design",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspaceUid": {
          "description": "The workspace to create the design in.",
          "title": "Workspaceuid",
          "type": "string"
        },
        "name": {
          "description": "The name of the design.",
          "title": "Name",
          "type": "string"
        },
        "width": {
          "default": 650,
          "description": "Canvas width in pixels.",
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 500,
          "description": "Canvas height in pixels.",
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "workspaceUid",
        "name"
      ],
      "title": "CreateDesignConfig",
      "type": "object"
    },
    "CreateWorkspaceConfig": {
      "additionalProperties": false,
      "description": "Create a workspace.",
      "properties": {
        "operation": {
          "const": "create_workspace",
          "default": "create_workspace",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "description": "The name of the workspace.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateWorkspaceConfig",
      "type": "object"
    },
    "DeleteGeneratedImageConfig": {
      "additionalProperties": false,
      "description": "Delete a generated image.",
      "properties": {
        "operation": {
          "const": "delete_generated_image",
          "default": "delete_generated_image",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "teamUid": {
          "description": "The first path segment of the image URL.",
          "title": "Teamuid",
          "type": "string"
        },
        "filename": {
          "description": "The file name in the image URL.",
          "title": "Filename",
          "type": "string"
        }
      },
      "required": [
        "teamUid",
        "filename"
      ],
      "title": "DeleteGeneratedImageConfig",
      "type": "object"
    },
    "DeleteLayerConfig": {
      "additionalProperties": false,
      "description": "Delete a layer.",
      "properties": {
        "operation": {
          "const": "delete_layer",
          "default": "delete_layer",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "uid": {
          "description": "The ID of the template, shown in the editor and returned by `GET /templates`.",
          "title": "Uid",
          "type": "string"
        },
        "layerId": {
          "description": "The ID of the layer.",
          "title": "Layerid",
          "type": "string"
        }
      },
      "required": [
        "uid",
        "layerId"
      ],
      "title": "DeleteLayerConfig",
      "type": "object"
    },
    "DeleteMediaAssetConfig": {
      "additionalProperties": false,
      "description": "Delete a media asset.",
      "properties": {
        "operation": {
          "const": "delete_media_asset",
          "default": "delete_media_asset",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspaceId": {
          "description": "The ID of the workspace.",
          "title": "Workspaceid",
          "type": "string"
        },
        "assetId": {
          "description": "The ID of the asset.",
          "title": "Assetid",
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "assetId"
      ],
      "title": "DeleteMediaAssetConfig",
      "type": "object"
    },
    "DeleteWorkspaceConfig": {
      "additionalProperties": false,
      "description": "Delete a workspace.",
      "properties": {
        "operation": {
          "const": "delete_workspace",
          "default": "delete_workspace",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "workspaceId": {
          "description": "The ID of the workspace.",
          "title": "Workspaceid",
          "type": "string"
        }
      },
      "required": [
        "workspaceId"
      ],
      "title": "DeleteWorkspaceConfig",
      "type": "object"
    },
    "DynapicturesAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "dynapictures_api_key",
          "default": "dynapictures_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Dynapictures API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the DynaPictures account page. It grants your user's full access. Paste only the key; NoClick adds the Bearer header. Connecting reads your workspaces.",
      "x-credential-url": "https://dynapictures.com/app/account"
    },
    "GenerateImageConfig": {
      "additionalProperties": false,
      "description": "Generate an image from a template.",
      "properties": {
        "operation": {
          "const": "generate_image",
          "default": "generate_image",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "uid": {
          "description": "The ID of the template, shown in the editor and returned by `GET /templates`.",
          "title": "Uid",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "png",
                "jpeg",
                "webp",
                "avif",
                "pdf",
                "pptx"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Output format. `pdf` is for multipage templates and produces one file with every page.",
          "title": "Format",
          "enum": [
            "png",
            "jpeg",
            "webp",
            "avif",
            "pdf",
            "pptx"
          ],
          "x-enum-searchable": true
        },
        "metadata": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom data stored on the generated image and returned in responses and webhooks.",
          "title": "Metadata"
        },
        "params": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/LayerOverride"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "New values for the layers of a single-page template.",
          "title": "Params"
        },
        "pages": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PageOverride"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "New values for the pages of a multipage template, instead of `params`.",
          "title": "Pages"
        },
        "responseFormat": {
          "const": "json",
          "default": "json",
          "description": "Return JSON containing generated image or PDF URLs.",
          "title": "Responseformat",
          "type": "string"
        }
      },
      "required": [
        "uid"
      ],
      "title": "GenerateImageConfig",
      "type": "object"
    },
    "GetAiGenerationConfig": {
      "additionalProperties": false,
      "description": "Get an AI generation job.",
