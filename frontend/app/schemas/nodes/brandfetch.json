    "BrandfetchReceiveWebhookConfig": {
      "description": "Receive brand-change events from Brandfetch (brand.updated, brand.company.updated).\n\nBrandfetch webhooks are Enterprise-plan only and registered from the\nBrandfetch dashboard (no self-serve subscription API), so this trigger\nsimply provisions an inbound URL the user pastes into their dashboard.",
      "properties": {
        "operation": {
          "const": "receive_webhook",
          "default": "receive_webhook",
          "title": "Receive Brand Change Events",
          "type": "string",
          "ui:hidden": true,
          "x-category": null,
          "x-display-name": "Receive Brand Change Events",
          "x-is-trigger": true
        },
        "event_type": {
          "default": "*",
          "description": "Which Brandfetch event fires this workflow. Brandfetch delivers all events to one endpoint, so the trigger filters inbound deliveries by their `type` and skips events you did not select. Options: 'All brand events' (any event); 'brand.updated' (a brand's data changed); 'brand.company.updated' (a brand's company/firmographic data changed); 'brand.claimed' (a brand was claimed by its owner); 'brand.verified' (a brand was human-reviewed by Brandfetch); 'brand.deleted' (a brand was soft-deleted, rare).",
          "enum": [
            "*",
            "brand.updated",
            "brand.company.updated",
            "brand.claimed",
            "brand.verified",
            "brand.deleted"
          ],
          "enumNames": [
            "All brand events",
            "Brand updated",
            "Brand company data updated",
            "Brand claimed",
            "Brand verified",
            "Brand deleted"
          ],
          "title": "Event Type",
          "type": "string",
          "x-enum-searchable": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Add this URL as a webhook endpoint in your Brandfetch dashboard (Enterprise plan)",
          "title": "Webhook URL",
          "ui:copyable": true,
          "ui:loadValue": true,
          "ui:widget": "webhook"
        },
        "webhook_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Svix signing secret from your Brandfetch webhook dashboard \u2014 starts with whsec_. Used to verify inbound delivery signatures. Leave blank to skip verification (not recommended for production).",
          "title": "Webhook Secret",
          "ui:placeholder": "whsec_...",
          "ui:widget": "password"
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        }
      },
      "title": "BrandfetchReceiveWebhookConfig",
      "type": "object",
      "x-requires-webhook": true
    },
