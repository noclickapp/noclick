{
  "$defs": {
    "BrandfetchApiKeyCredential": {
      "description": "API key (Bearer) + public Client ID credential for Brandfetch.\n\nThe API key is a secret used for the Brand / Brand Context / Transaction\nAPIs. The Client ID is a public identifier required by the Logo CDN and\nBrand Search APIs (passed as ?c=). Both are issued from the developer portal.",
      "properties": {
        "credential_type": {
          "const": "brandfetch_api_key",
          "default": "brandfetch_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Your Brandfetch API key (Bearer token) for Brand, Context, and Transaction APIs",
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public Client ID required by the Logo CDN and Brand Search operations (passed as ?c=)",
          "title": "Client ID",
          "ui:help": "Optional. Only needed for Logo and Search operations."
        }
      },
      "required": [
        "api_key"
      ],
      "title": "BrandfetchApiKeyCredential",
      "type": "object",
      "x-credential-instructions": "Create a free account at developers.brandfetch.com, then copy your API key (Bearer, keep secret) and your public Client ID from the dashboard.",
      "x-credential-url": "https://developers.brandfetch.com/register"
    },
