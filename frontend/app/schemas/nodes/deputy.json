            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payroll Id"
        }
      },
      "required": [
        "first_name",
        "last_name",
        "company_id"
      ],
      "title": "CreateEmployee",
      "type": "object"
    },
    "CreateLeave": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_leave",
          "default": "create_leave",
          "title": "Create Leave",
          "type": "string",
          "ui:hidden": true
        },
        "employee_id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Employee Id",
          "type": "integer"
        },
        "date_start": {
          "pattern": "^\\d{4}/\\d{2}/\\d{2}$",
          "title": "Date Start",
          "type": "string"
        },
        "date_end": {
          "pattern": "^\\d{4}/\\d{2}/\\d{2}$",
          "title": "Date End",
          "type": "string"
        },
        "status": {
          "description": "0 awaiting approval, 1 approved, 2 declined, 3 cancelled.",
          "enum": [
            0,
            1,
            2,
            3
          ],
          "title": "Status",
          "type": "integer"
        },
        "approval_comment": {
          "maxLength": 2000,
          "title": "Approval Comment",
          "type": "string"
        },
        "overlapping_rosters_action": {
          "description": "Deputy ActionOverlappingRosters value. Explicitly choose how existing shifts are handled.",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Overlapping Rosters Action",
          "type": "integer"
        }
      },
      "required": [
        "employee_id",
        "date_start",
        "date_end",
        "status",
        "approval_comment",
        "overlapping_rosters_action"
      ],
      "title": "CreateLeave",
      "type": "object"
    },
    "DeputyPermanentTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "deputy_permanent_token",
          "default": "deputy_permanent_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "workplace_url": {
          "description": "HTTPS origin of your Deputy workplace, including its region; no API path.",
          "title": "Workplace URL",
          "type": "string"
        },
        "permanent_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Permanent token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "workplace_url",
        "permanent_token"
      ],
      "title": "Deputy Permanent Token",
      "type": "object",
      "x-credential-instructions": "Paste a Deputy permanent token and your Deputy workplace URL, such as https://your-workplace.au.deputy.com. In Deputy, open /exec/devapp/oauth_clients, add an OAuth client, save it, and select Get an Access Token. Requests use Bearer authentication; the token's existing user permissions control access. Connecting reads your workplace locations.",
      "x-credential-url": "https://developer.deputy.com/docs/the-hello-world-of-deputy"
    },
