{
  "$defs": {
    "CopyRosters": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "copy_rosters",
          "default": "copy_rosters",
          "title": "Copy Rosters",
          "type": "string",
          "ui:hidden": true
        },
        "from_date": {
          "description": "Source date in YYYY-MM-DD.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "From Date",
          "type": "string"
        },
        "to_date": {
          "description": "Destination date in YYYY-MM-DD.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "To Date",
          "type": "string"
        },
        "area_ids": {
          "items": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Area Ids",
          "type": "array"
        }
      },
      "required": [
        "from_date",
        "to_date",
        "area_ids"
      ],
      "title": "CopyRosters",
      "type": "object"
    },
    "CreateArea": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_area",
          "default": "create_area",
          "title": "Create Area",
          "type": "string",
          "ui:hidden": true
        },
        "company_id": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Company Id",
          "type": "integer"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "export_name": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Export Name"
        }
      },
      "required": [
        "company_id",
        "name"
      ],
      "title": "CreateArea",
      "type": "object"
    },
    "CreateEmployee": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_employee",
          "default": "create_employee",
          "title": "Create Employee",
          "type": "string",
          "ui:hidden": true
        },
        "first_name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "First Name",
          "type": "string"
