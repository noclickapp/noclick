{
  "$defs": {
    "AbyssHubAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "abysshub_api_key",
          "default": "abysshub_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "AbyssHub API Key",
      "type": "object",
      "x-credential-instructions": "Create an API key in your AbyssHub Cave and paste it here. The key acts as you and runs are paid from your wallet. Paste only the key, without Bearer.",
      "x-credential-url": "https://abysshub.com/cave"
    },
    "GetKeyConfig": {
      "properties": {
        "operation": {
          "const": "get_key",
          "default": "get_key",
          "title": "Get Key and Account",
          "type": "string"
        }
      },
      "title": "GetKeyConfig",
      "type": "object"
    },
    "GetRunConfig": {
      "properties": {
        "run_id": {
          "pattern": "^run_[A-Za-z0-9]{24}$",
          "title": "Run ID",
          "type": "string"
        },
        "operation": {
          "const": "get_run",
          "default": "get_run",
          "description": "Read the current status, result and fresh signed file URLs without waiting.",
          "title": "Get Run",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "GetRunConfig",
      "type": "object"
    },
    "GetWidgetConfig": {
      "properties": {
        "widget_id": {
          "description": "The widget_ ID or the private token from an unlisted Widget's link.",
          "minLength": 1,
          "title": "Widget ID or Private Token",
          "type": "string"
        },
        "operation": {
          "const": "get_widget",
          "default": "get_widget",
          "title": "Get Widget Price and Input Schema",
          "type": "string"
        }
      },
      "required": [
        "widget_id"
      ],
      "title": "GetWidgetConfig",
      "type": "object"
    },
    "ListRunsConfig": {
      "properties": {
        "operation": {
          "const": "list_runs",
          "default": "list_runs",
          "title": "List Runs",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "starting_after": {
          "anyOf": [
            {
              "pattern": "^run_[A-Za-z0-9]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last run ID of the previous page. Runs from this API key only, newest first.",
          "title": "Starting After"
        }
      },
      "title": "ListRunsConfig",
      "type": "object"
    },
    "OnNewRunConfig": {
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_run",
          "default": "on_new_run",
          "title": "On New Run",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On New Run",
          "x-is-trigger": true
        }
      },
      "title": "OnNewRunConfig",
      "type": "object",
      "x-requires-webhook": true
    },
    "PrepareUploadConfig": {
      "properties": {
        "widget_id": {
          "description": "The widget_ ID or the private token from an unlisted Widget's link.",
          "minLength": 1,
          "title": "Widget ID or Private Token",
          "type": "string"
        },
        "operation": {
          "const": "prepare_upload",
          "default": "prepare_upload",
          "description": "Returns an upload ID and S3 form. Send the form fields and file to upload.url separately, then use the ID in a Widget input.",
          "title": "Prepare File Upload",
          "type": "string"
        },
        "field": {
          "maxLength": 255,
          "minLength": 1,
          "title": "File Field Name",
          "type": "string"
        },
        "filename": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size in Bytes"
        }
      },
      "required": [
        "widget_id",
        "field",
        "filename"
      ],
      "title": "PrepareUploadConfig",
      "type": "object"
    },
    "RunWidgetConfig": {
      "properties": {
        "widget_id": {
          "description": "The widget_ ID or the private token from an unlisted Widget's link.",
          "minLength": 1,
          "title": "Widget ID or Private Token",
          "type": "string"
        },
        "input": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "additionalProperties": true,
            "type": "object"
          },
          "default": "{}",
          "description": "JSON object matching the Widget's input_schema. File fields accept a public HTTPS URL or an upload ID.",
          "title": "Widget Input",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "max_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Refuse the run before charging if its price exceeds this amount.",
          "title": "Maximum Price"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[\\x21-\\x7E]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use the same key and input to retry safely within 24 hours. Use a new key for each new run.",
          "title": "Idempotency Key"
        },
        "operation": {
          "const": "run_widget",
          "default": "run_widget",
          "description": "Starts a paid run and holds for its ending. A busy API or an hour's hold can return queued/running; inspect status and read again.",
          "title": "Run Widget and Wait",
          "type": "string"
        }
      },
      "required": [
        "widget_id"
      ],
      "title": "RunWidgetConfig",
      "type": "object"
    },
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    },
    "StartWidgetConfig": {
      "properties": {
        "widget_id": {
          "description": "The widget_ ID or the private token from an unlisted Widget's link.",
          "minLength": 1,
          "title": "Widget ID or Private Token",
          "type": "string"
        },
        "input": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "additionalProperties": true,
            "type": "object"
          },
          "default": "{}",
          "description": "JSON object matching the Widget's input_schema. File fields accept a public HTTPS URL or an upload ID.",
          "title": "Widget Input",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "max_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Refuse the run before charging if its price exceeds this amount.",
          "title": "Maximum Price"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[\\x21-\\x7E]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use the same key and input to retry safely within 24 hours. Use a new key for each new run.",
          "title": "Idempotency Key"
        },
        "operation": {
          "const": "start_widget",
          "default": "start_widget",
          "description": "Starts a paid run with wait=false and returns immediately. Use Get Run or Wait for Run afterwards.",
          "title": "Start Widget Run",
          "type": "string"
        }
      },
      "required": [
        "widget_id"
      ],
      "title": "StartWidgetConfig",
      "type": "object"
    },
    "WaitForRunConfig": {
      "properties": {
        "run_id": {
          "pattern": "^run_[A-Za-z0-9]{24}$",
          "title": "Run ID",
          "type": "string"
        },
        "operation": {
          "const": "wait_for_run",
          "default": "wait_for_run",
          "description": "Read with wait=true. A busy API or an hour's hold can return before completion; inspect status.",
          "title": "Wait for Run",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "WaitForRunConfig",
      "type": "object"
    },
    "WakeRunConfig": {
      "properties": {
        "run_id": {
          "pattern": "^run_[A-Za-z0-9]{24}$",
          "title": "Run ID",
          "type": "string"
        },
        "operation": {
          "const": "wake_run",
          "default": "wake_run",
          "description": "Restore files from deep storage within 12 hours. AbyssHub emails you when ready. Already awake runs are unchanged.",
          "title": "Wake Run Files",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "WakeRunConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_key": "#/$defs/GetKeyConfig",
          "get_run": "#/$defs/GetRunConfig",
          "get_widget": "#/$defs/GetWidgetConfig",
          "list_runs": "#/$defs/ListRunsConfig",
          "on_new_run": "#/$defs/OnNewRunConfig",
          "prepare_upload": "#/$defs/PrepareUploadConfig",
          "run_widget": "#/$defs/RunWidgetConfig",
          "start_widget": "#/$defs/StartWidgetConfig",
          "wait_for_run": "#/$defs/WaitForRunConfig",
          "wake_run": "#/$defs/WakeRunConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetKeyConfig"
        },
        {
          "$ref": "#/$defs/GetWidgetConfig"
        },
        {
          "$ref": "#/$defs/PrepareUploadConfig"
        },
        {
          "$ref": "#/$defs/RunWidgetConfig"
        },
        {
          "$ref": "#/$defs/StartWidgetConfig"
        },
        {
          "$ref": "#/$defs/ListRunsConfig"
        },
        {
          "$ref": "#/$defs/GetRunConfig"
        },
        {
          "$ref": "#/$defs/WaitForRunConfig"
        },
        {
          "$ref": "#/$defs/WakeRunConfig"
        },
        {
          "$ref": "#/$defs/OnNewRunConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/AbyssHubAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Abysshub Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
