{
  "$defs": {
    "CorbitSMSCredential": {
      "properties": {
        "credential_type": {
          "const": "corbit_sms_api_token",
          "default": "corbit_sms_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Corbit SMS API Token",
      "type": "object",
      "x-credential-instructions": "Paste the API token created in your Corbit SMS account at sms.corbit.sa. Use the SMS token, not a WhatsApp API key. NoClick sends it as a Bearer token to api.corbit.sa.",
      "x-credential-url": "https://sms.corbit.sa"
    },
    "DeleteTemplate": {
      "description": "Delete a saved template.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Template Name",
          "type": "string"
        },
        "operation": {
          "const": "delete_template",
          "default": "delete_template",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "DeleteTemplate",
      "type": "object"
    },
    "GetBalance": {
      "description": "Read the account's remaining SMS balance.",
      "properties": {
        "operation": {
          "const": "get_balance",
          "default": "get_balance",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetBalance",
      "type": "object"
    },
    "GetMessageReport": {
      "description": "Read delivery details for each destination.",
      "properties": {
        "message_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Message ID",
          "type": "string"
        },
        "operation": {
          "const": "get_message_report",
          "default": "get_message_report",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "message_id"
      ],
      "title": "GetMessageReport",
      "type": "object"
    },
    "GetMessageStatus": {
      "description": "Read the current status of an accepted SMS.",
      "properties": {
        "message_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Message ID",
          "type": "string"
        },
        "operation": {
          "const": "get_message_status",
          "default": "get_message_status",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "message_id"
      ],
      "title": "GetMessageStatus",
      "type": "object"
    },
    "GetTemplate": {
      "description": "Read a saved template.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Template Name",
          "type": "string"
        },
        "operation": {
          "const": "get_template",
          "default": "get_template",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "GetTemplate",
      "type": "object"
    },
    "GetUsage": {
      "description": "Read rate limits and last known balance.",
      "properties": {
        "operation": {
          "const": "get_usage",
          "default": "get_usage",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetUsage",
      "type": "object"
    },
    "ListMessages": {
      "description": "Read a page of the sent-message archive, newest first.",
      "properties": {
        "from_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Oldest date: YYYY-MM-DD, ISO date-time, or epoch seconds.",
          "title": "From"
        },
        "to_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Newest date; a bare date includes that entire day.",
          "title": "To"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A number or a piece of it.",
          "title": "Destination Filter"
        },
        "sender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sender Filter"
        },
        "include_status": {
          "default": false,
          "title": "Include Delivery Status",
          "type": "boolean"
        },
        "operation": {
          "const": "list_messages",
          "default": "list_messages",
          "title": "Operation",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "nextCursor from the preceding page. Continue even when a filtered page is short.",
          "title": "Cursor"
        }
      },
      "title": "ListMessages",
      "type": "object"
    },
    "ListSenderNames": {
      "description": "List the account's sender names and their approval status.",
      "properties": {
        "operation": {
          "const": "list_sender_names",
          "default": "list_sender_names",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListSenderNames",
      "type": "object"
    },
    "ListTemplates": {
      "description": "List the account's saved message templates.",
      "properties": {
        "operation": {
          "const": "list_templates",
          "default": "list_templates",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListTemplates",
      "type": "object"
    },
    "OnNewSentMessage": {
      "description": "Poll the date-filtered sent archive; emits new records after an initial baseline.",
      "properties": {
        "from_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Oldest date: YYYY-MM-DD, ISO date-time, or epoch seconds.",
          "title": "From"
        },
        "to_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Newest date; a bare date includes that entire day.",
          "title": "To"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A number or a piece of it.",
          "title": "Destination Filter"
        },
        "sender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sender Filter"
        },
        "include_status": {
          "default": false,
          "title": "Include Delivery Status",
          "type": "boolean"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_sent_message",
          "default": "on_new_sent_message",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On New Sent Message",
          "x-is-trigger": true
        }
      },
      "title": "OnNewSentMessage",
      "type": "object",
      "x-requires-webhook": true
    },
    "Recipient": {
      "properties": {
        "number": {
          "pattern": "^[0-9]{8,15}$",
          "title": "Number",
          "type": "string"
        },
        "vars": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Merge Values",
          "type": "object"
        }
      },
      "required": [
        "number"
      ],
      "title": "Recipient",
      "type": "object"
    },
    "SaveTemplate": {
      "description": "Create or replace a template with merge fields.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Template Name",
          "type": "string"
        },
        "operation": {
          "const": "save_template",
          "default": "save_template",
          "title": "Operation",
          "type": "string"
        },
        "text": {
          "description": "Use Corbit merge fields such as {{name}} or {{code|0000}}.",
          "maxLength": 1600,
          "minLength": 1,
          "title": "Template Text",
          "type": "string"
        }
      },
      "required": [
        "name",
        "text"
      ],
      "title": "SaveTemplate",
      "type": "object"
    },
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    },
    "SendBulkSMS": {
      "description": "Send the same SMS to multiple numbers.",
      "properties": {
        "sender_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Approved Sender Name",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reuse the same key only when retrying the same request, to avoid sending twice.",
          "title": "Idempotency Key"
        },
        "operation": {
          "const": "send_bulk_sms",
          "default": "send_bulk_sms",
          "title": "Operation",
          "type": "string"
        },
        "numbers": {
          "items": {
            "pattern": "^[0-9]{8,15}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Recipient Numbers",
          "type": "array"
        },
        "message_body": {
          "maxLength": 1600,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "send_at_option": {
          "const": "Now",
          "default": "Now",
          "title": "Delivery Timing",
          "type": "string"
        },
        "allow_duplicate": {
          "default": false,
          "title": "Allow Duplicate",
          "type": "boolean"
        }
      },
      "required": [
        "sender_name",
        "numbers",
        "message_body"
      ],
      "title": "SendBulkSMS",
      "type": "object"
    },
    "SendSMS": {
      "description": "Send a single SMS with duplicate protection enabled by default.",
      "properties": {
        "sender_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Approved Sender Name",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reuse the same key only when retrying the same request, to avoid sending twice.",
          "title": "Idempotency Key"
        },
        "operation": {
          "const": "send_sms",
          "default": "send_sms",
          "title": "Operation",
          "type": "string"
        },
        "number": {
          "description": "International format, 8\u201315 digits, without +.",
          "pattern": "^[0-9]{8,15}$",
          "title": "Recipient Number",
          "type": "string"
        },
        "message_body": {
          "maxLength": 1600,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "send_at_option": {
          "const": "NOW",
          "default": "NOW",
          "title": "Delivery Timing",
          "type": "string"
        },
        "allow_duplicate": {
          "default": false,
          "description": "Explicitly allow an identical SMS within the one-hour duplicate window.",
          "title": "Allow Duplicate",
          "type": "boolean"
        }
      },
      "required": [
        "sender_name",
        "number",
        "message_body"
      ],
      "title": "SendSMS",
      "type": "object"
    },
    "SendTemplate": {
      "description": "Send a saved template with shared and per-recipient merge values.",
      "properties": {
        "sender_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Approved Sender Name",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reuse the same key only when retrying the same request, to avoid sending twice.",
          "title": "Idempotency Key"
        },
        "operation": {
          "const": "send_template",
          "default": "send_template",
          "title": "Operation",
          "type": "string"
        },
        "template": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Saved Template",
          "type": "string"
        },
        "vars": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Shared Merge Values",
          "type": "object"
        },
        "recipients": {
          "items": {
            "anyOf": [
              {
                "pattern": "^[0-9]{8,15}$",
                "type": "string"
              },
              {
                "$ref": "#/$defs/Recipient"
              }
            ]
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Recipients",
          "type": "array"
        }
      },
      "required": [
        "sender_name",
        "template",
        "recipients"
      ],
      "title": "SendTemplate",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "delete_template": "#/$defs/DeleteTemplate",
          "get_balance": "#/$defs/GetBalance",
          "get_message_report": "#/$defs/GetMessageReport",
          "get_message_status": "#/$defs/GetMessageStatus",
          "get_template": "#/$defs/GetTemplate",
          "get_usage": "#/$defs/GetUsage",
          "list_messages": "#/$defs/ListMessages",
          "list_sender_names": "#/$defs/ListSenderNames",
          "list_templates": "#/$defs/ListTemplates",
          "on_new_sent_message": "#/$defs/OnNewSentMessage",
          "save_template": "#/$defs/SaveTemplate",
          "send_bulk_sms": "#/$defs/SendBulkSMS",
          "send_sms": "#/$defs/SendSMS",
          "send_template": "#/$defs/SendTemplate"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SendSMS"
        },
        {
          "$ref": "#/$defs/SendBulkSMS"
        },
        {
          "$ref": "#/$defs/GetBalance"
        },
        {
          "$ref": "#/$defs/ListSenderNames"
        },
        {
          "$ref": "#/$defs/GetMessageStatus"
        },
        {
          "$ref": "#/$defs/GetMessageReport"
        },
        {
          "$ref": "#/$defs/ListTemplates"
        },
        {
          "$ref": "#/$defs/SaveTemplate"
        },
        {
          "$ref": "#/$defs/GetTemplate"
        },
        {
          "$ref": "#/$defs/DeleteTemplate"
        },
        {
          "$ref": "#/$defs/SendTemplate"
        },
        {
          "$ref": "#/$defs/GetUsage"
        },
        {
          "$ref": "#/$defs/ListMessages"
        },
        {
          "$ref": "#/$defs/OnNewSentMessage"
        }
      ],
