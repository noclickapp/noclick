        "operation": {
          "const": "upsert_people",
          "default": "upsert_people",
          "title": "Operation",
          "type": "string"
        },
        "people": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "$ref": "#/$defs/Person"
            },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array"
          },
          "description": "JSON array of people, each with id, userId or email. Include names and custom person fields as needed.",
