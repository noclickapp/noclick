  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_tags": "#/$defs/AddTags",
          "archive_people": "#/$defs/ArchivePeople",
          "create_fields": "#/$defs/CreateFields",
          "delete_field": "#/$defs/DeleteField",
          "get_account": "#/$defs/GetAccount",
          "get_people": "#/$defs/GetPeople",
          "list_fields": "#/$defs/ListFields",
          "list_segment_people": "#/$defs/ListSegmentPeople",
          "list_segments": "#/$defs/ListSegments",
          "remove_tags": "#/$defs/RemoveTags",
          "unsubscribe_person": "#/$defs/UnsubscribePerson",
          "update_field": "#/$defs/UpdateField",
          "upsert_people": "#/$defs/UpsertPeople"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetPeople"
        },
        {
          "$ref": "#/$defs/UpsertPeople"
        },
        {
          "$ref": "#/$defs/ArchivePeople"
        },
        {
          "$ref": "#/$defs/GetAccount"
        },
        {
          "$ref": "#/$defs/ListFields"
        },
        {
          "$ref": "#/$defs/CreateFields"
        },
        {
          "$ref": "#/$defs/UpdateField"
        },
        {
          "$ref": "#/$defs/DeleteField"
        },
        {
          "$ref": "#/$defs/ListSegments"
        },
        {
          "$ref": "#/$defs/ListSegmentPeople"
        },
        {
          "$ref": "#/$defs/AddTags"
        },
        {
          "$ref": "#/$defs/RemoveTags"
        },
        {
          "$ref": "#/$defs/UnsubscribePerson"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnchargeAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Encharge Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
