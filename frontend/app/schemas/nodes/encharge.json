          "title": "Type",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "date",
                "date-time"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format",
          "enum": [
            "date",
            "date-time"
          ],
          "x-enum-searchable": true
        },
        "readOnly": {
          "default": false,
          "title": "Readonly",
