    "UpdateField": {
      "additionalProperties": false,
      "description": "Modify a person field using its complete definition.",
      "properties": {
        "field_name": {
          "description": "Unique person field name, not its display title.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Field Name",
          "type": "string"
        },
        "operation": {
          "const": "update_field",
          "default": "update_field",
          "title": "Operation",
          "type": "string"
        },
        "field": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "$ref": "#/$defs/PersonField"
          },
          "description": "JSON field definition; name must match the selected field name.",
          "title": "Field",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "field_name",
        "field"
      ],
      "title": "UpdateField",
      "type": "object"
    },
    "UpsertPeople": {
      "additionalProperties": false,
      "description": "Create people or update those with matching identifiers and custom fields.",
