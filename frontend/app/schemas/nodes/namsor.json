        }
      },
      "required": [
        "japaneseSurnameKanji",
        "japaneseGivenNameKanji"
      ],
      "title": "JapaneseLatinCandidates",
      "type": "object"
    },
    "MatchChineseName": {
      "additionalProperties": false,
      "description": "Return a score for matching Chinese name ex. \u738b\u6653\u660e with a romanized name ex. Wang Xiaoming",
      "properties": {
        "operation": {
          "const": "match_chinese_name",
          "default": "match_chinese_name",
          "title": "Operation",
          "type": "string"
        },
        "chineseSurnameLatin": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Chinesesurnamelatin",
