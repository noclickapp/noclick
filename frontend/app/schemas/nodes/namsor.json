        "chineseGivenNameLatin": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Chinesegivennamelatin",
          "type": "string"
        },
        "chineseName": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Chinesename",
          "type": "string"
        }
      },
      "required": [
        "chineseSurnameLatin",
        "chineseGivenNameLatin",
        "chineseName"
      ],
      "title": "MatchChineseName",
      "type": "object"
    },
    "MatchJapaneseName": {
      "additionalProperties": false,
      "description": "Return a score for matching Japanese name in KANJI ex. \u5c71\u672c \u65e9\u82d7 with a romanized name ex. Yamamoto Sanae",
      "properties": {
        "operation": {
          "const": "match_japanese_name",
