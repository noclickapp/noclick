    "JapaneseKanjiCandidates": {
      "additionalProperties": false,
      "description": "Identify japanese name candidates in KANJI, based on the romanized name ex. Yamamoto Sanae",
      "properties": {
        "operation": {
          "const": "japanese_kanji_candidates",
          "default": "japanese_kanji_candidates",
          "title": "Operation",
          "type": "string"
        },
        "japaneseSurnameLatin": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Japanesesurnamelatin",
          "type": "string"
        },
        "japaneseGivenNameLatin": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Japanesegivennamelatin",
          "type": "string"
        }
      },
      "required": [
        "japaneseSurnameLatin",
        "japaneseGivenNameLatin"
      ],
      "title": "JapaneseKanjiCandidates",
      "type": "object"
    },
    "JapaneseLatinCandidates": {
      "additionalProperties": false,
      "description": "Romanize japanese name, based on the name in Kanji.",
      "properties": {
        "operation": {
          "const": "japanese_latin_candidates",
          "default": "japanese_latin_candidates",
          "title": "Operation",
          "type": "string"
