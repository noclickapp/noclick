{
  "$defs": {
    "ClassifyGender": {
      "additionalProperties": false,
      "description": "Infer the likely gender of a name.",
      "properties": {
        "operation": {
          "const": "classify_gender",
          "default": "classify_gender",
          "title": "Operation",
          "type": "string"
        },
        "firstName": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Firstname",
          "type": "string"
        },
        "lastName": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Lastname",
          "type": "string"
        }
      },
      "required": [
        "firstName",
        "lastName"
      ],
      "title": "ClassifyGender",
      "type": "object"
    },
    "ClassifyGenderBatch": {
      "additionalProperties": false,
      "description": "Infer the likely gender of up to 100 names, detecting automatically the cultural context.",
      "properties": {
        "operation": {
          "const": "classify_gender_batch",
          "default": "classify_gender_batch",
          "title": "Operation",
          "type": "string"
        },
        "personalNames": {
          "items": {
            "$ref": "#/$defs/FirstLastName"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Personalnames",
          "type": "array"
        }
      },
      "required": [
        "personalNames"
      ],
      "title": "ClassifyGenderBatch",
      "type": "object"
    },
    "ClassifyGenderFull": {
      "additionalProperties": false,
      "description": "Infer the likely gender of a full name, ex. John H. Smith",
      "properties": {
        "operation": {
          "const": "classify_gender_full",
          "default": "classify_gender_full",
          "title": "Operation",
          "type": "string"
        },
        "fullName": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Fullname",
          "type": "string"
        }
      },
      "required": [
        "fullName"
      ],
      "title": "ClassifyGenderFull",
      "type": "object"
    },
    "ClassifyGenderFullBatch": {
      "additionalProperties": false,
      "description": "Infer the likely gender of up to 100 full names, detecting automatically the cultural context.",
      "properties": {
        "operation": {
          "const": "classify_gender_full_batch",
          "default": "classify_gender_full_batch",
          "title": "Operation",
          "type": "string"
        },
        "personalNames": {
          "items": {
            "$ref": "#/$defs/PersonalName"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Personalnames",
          "type": "array"
        }
      },
      "required": [
        "personalNames"
      ],
      "title": "ClassifyGenderFullBatch",
      "type": "object"
    },
    "ClassifyGenderFullGeo": {
      "additionalProperties": false,
      "description": "Infer the likely gender of a full name, given a local context (ISO2 country code).",
      "properties": {
        "operation": {
          "const": "classify_gender_full_geo",
          "default": "classify_gender_full_geo",
          "title": "Operation",
          "type": "string"
        },
        "fullName": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Fullname",
          "type": "string"
        },
        "countryIso2": {
          "description": "ISO 3166-1 alpha-2 country code.",
          "pattern": "^[A-Z]{2}$",
          "title": "Countryiso2",
          "type": "string"
        }
      },
      "required": [
        "fullName",
        "countryIso2"
      ],
      "title": "ClassifyGenderFullGeo",
      "type": "object"
    },
    "ClassifyGenderGeo": {
      "additionalProperties": false,
      "description": "Infer the likely gender of a name, given a local context (ISO2 country code).",
      "properties": {
        "operation": {
          "const": "classify_gender_geo",
          "default": "classify_gender_geo",
          "title": "Operation",
          "type": "string"
        },
        "firstName": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Firstname",
          "type": "string"
        },
        "lastName": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Lastname",
          "type": "string"
        },
        "countryIso2": {
          "description": "ISO 3166-1 alpha-2 country code.",
          "pattern": "^[A-Z]{2}$",
          "title": "Countryiso2",
          "type": "string"
        }
      },
      "required": [
        "firstName",
        "lastName",
        "countryIso2"
      ],
      "title": "ClassifyGenderGeo",
      "type": "object"
    },
    "ClassifyNameType": {
      "additionalProperties": false,
      "description": "Infer the likely type of a proper noun (personal name, brand name, place name etc.)",
      "properties": {
        "operation": {
          "const": "classify_name_type",
          "default": "classify_name_type",
          "title": "Operation",
          "type": "string"
        },
