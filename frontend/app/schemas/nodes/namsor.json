          "maxLength": 1000,
          "minLength": 1,
          "title": "Propernoun",
          "type": "string"
        }
      },
      "required": [
        "properNoun"
      ],
      "title": "ClassifyNameType",
      "type": "object"
    },
    "FirstLastName": {
      "additionalProperties": false,
      "properties": {
        "firstName": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Firstname",
          "type": "string"
        },
        "lastName": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Lastname",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
