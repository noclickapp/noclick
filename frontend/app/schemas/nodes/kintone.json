        "app_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave blank to use the credential's app ID.",
          "title": "App Id"
        },
        "operation": {
          "const": "create_record",
          "default": "create_record",
          "title": "Operation",
          "type": "string"
        },
        "record": {
          "additionalProperties": {
            "$ref": "#/$defs/WritableField"
          },
          "title": "Record",
          "type": "object"
        }
      },
      "required": [
        "record"
      ],
      "title": "KintoneCreateRecord",
      "type": "object"
    },
    "KintoneCreateRecords": {
      "additionalProperties": false,
