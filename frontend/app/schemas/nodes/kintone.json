    "KintoneGetComments": {
      "additionalProperties": false,
      "description": "Read one page of comments; newer and older indicate remaining pages.",
      "properties": {
        "app_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
