          "default": null,
          "description": "Leave blank to use the credential's app ID.",
          "title": "App Id"
        },
        "record_id": {
          "minimum": 1,
          "title": "Record Id",
          "type": "integer"
        },
        "operation": {
          "const": "get_comments",
          "default": "get_comments",
          "title": "Operation",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 10,
          "maximum": 10,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "order": {
          "default": "DESC",
          "enum": [
            "ASC",
            "DESC"
          ],
          "title": "Order",
          "type": "string"
        }
      },
      "required": [
        "record_id"
      ],
      "title": "KintoneGetComments",
      "type": "object"
    },
    "KintoneGetCursor": {
      "additionalProperties": false,
      "description": "Read the next cursor page; repeat until next is false. Reading advances the cursor.",
      "properties": {
        "operation": {
          "const": "get_cursor",
          "default": "get_cursor",
          "title": "Operation",
          "type": "string"
        },
        "cursor_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Cursor Id",
          "type": "string"
        }
      },
      "required": [
        "cursor_id"
      ],
      "title": "KintoneGetCursor",
      "type": "object"
    },
