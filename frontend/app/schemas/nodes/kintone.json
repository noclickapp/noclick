{
  "$defs": {
    "KintoneAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "kintone_api_token",
          "default": "kintone_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        },
        "tenant_url": {
          "description": "Your HTTPS tenant origin, such as https://example.kintone.com or https://example.cybozu.com.",
          "title": "Tenant URL",
          "type": "string"
        },
        "app_id": {
          "description": "The numeric ID in your app URL. Used as the default app and for the connection check.",
          "minimum": 1,
          "title": "App ID",
          "type": "integer"
        }
      },
      "required": [
        "api_token",
        "tenant_url",
        "app_id"
      ],
      "title": "Kintone API Token",
      "type": "object",
      "x-credential-instructions": "In your app settings, open API Token, generate a token with the permissions your workflow needs, and update the app. Paste the token, your tenant URL, and that app's ID. Enable View records for reads; enable Add, Edit, or Delete records for writes. The app-name connection check requires View or Add records permission. App settings reads may require App management permission. Multiple app tokens for lookup fields can be separated by commas. NoClick checks the app name to verify access.",
      "x-credential-url": "https://kintone.dev/en/docs/common/authentication/"
    },
    "KintoneAddComment": {
      "additionalProperties": false,
      "description": "Add a comment and optional user, group or organization mentions.",
      "properties": {
        "app_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave blank to use the credential's app ID.",
          "title": "App Id"
        },
        "record_id": {
          "minimum": 1,
          "title": "Record Id",
          "type": "integer"
        },
        "operation": {
          "const": "add_comment",
          "default": "add_comment",
          "title": "Operation",
          "type": "string"
        },
        "text": {
          "maxLength": 65535,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "mentions": {
          "items": {
            "$ref": "#/$defs/Mention"
          },
          "maxItems": 10,
          "title": "Mentions",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "text"
      ],
      "title": "KintoneAddComment",
      "type": "object"
    },
    "KintoneCreateCursor": {
      "additionalProperties": false,
      "description": "Create an export cursor. The query accepts conditions only, without order by, limit or offset.",
      "properties": {
        "app_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave blank to use the credential's app ID.",
          "title": "App Id"
        },
        "operation": {
          "const": "create_cursor",
          "default": "create_cursor",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "size": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "title": "KintoneCreateCursor",
      "type": "object"
    },
    "KintoneCreateRecord": {
      "additionalProperties": false,
      "description": "Add one record with field codes mapped to value objects.",
      "properties": {
        "app_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave blank to use the credential's app ID.",
          "title": "App Id"
        },
        "operation": {
          "const": "create_record",
          "default": "create_record",
          "title": "Operation",
          "type": "string"
        },
        "record": {
          "additionalProperties": {
            "$ref": "#/$defs/WritableField"
          },
          "title": "Record",
          "type": "object"
        }
      },
      "required": [
        "record"
      ],
      "title": "KintoneCreateRecord",
      "type": "object"
    },
    "KintoneCreateRecords": {
      "additionalProperties": false,
      "description": "Add up to 100 records in one request.",
      "properties": {
        "app_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave blank to use the credential's app ID.",
          "title": "App Id"
        },
        "operation": {
          "const": "create_records",
          "default": "create_records",
          "title": "Operation",
          "type": "string"
        },
        "records": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/WritableField"
            },
            "type": "object"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "records"
      ],
      "title": "KintoneCreateRecords",
      "type": "object"
    },
    "KintoneDeleteComment": {
      "additionalProperties": false,
      "description": "Delete one comment by ID.",
      "properties": {
        "app_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave blank to use the credential's app ID.",
          "title": "App Id"
        },
        "record_id": {
          "minimum": 1,
          "title": "Record Id",
          "type": "integer"
        },
        "operation": {
          "const": "delete_comment",
          "default": "delete_comment",
          "title": "Operation",
          "type": "string"
        },
        "comment_id": {
          "minimum": 1,
          "title": "Comment Id",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "comment_id"
      ],
      "title": "KintoneDeleteComment",
      "type": "object"
    },
    "KintoneDeleteCursor": {
      "additionalProperties": false,
      "description": "Delete an unfinished export cursor.",
      "properties": {
        "operation": {
          "const": "delete_cursor",
          "default": "delete_cursor",
          "title": "Operation",
          "type": "string"
        },
        "cursor_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Cursor Id",
          "type": "string"
        }
      },
      "required": [
        "cursor_id"
      ],
      "title": "KintoneDeleteCursor",
      "type": "object"
    },
    "KintoneDeleteRecords": {
      "additionalProperties": false,
      "description": "Delete up to 100 records. Revisions, when supplied, correspond to IDs in order.",
      "properties": {
        "app_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Leave blank to use the credential's app ID.",
          "title": "App Id"
        },
        "operation": {
          "const": "delete_records",
          "default": "delete_records",
          "title": "Operation",
          "type": "string"
        },
        "ids": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "revisions": {
          "anyOf": [
            {
              "items": {
                "minimum": -1,
                "type": "integer"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revisions"
        }
      },
      "required": [
        "ids"
      ],
      "title": "KintoneDeleteRecords",
      "type": "object"
    },
    "KintoneGetApp": {
      "additionalProperties": false,
      "description": "Get general app information, including its name.",
      "properties": {
