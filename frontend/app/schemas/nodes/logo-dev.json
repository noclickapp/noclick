{
  "$defs": {
    "CreateWebhookEndpoint": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "description": "HTTPS delivery URL.",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "filter_types": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "brand.updated",
                  "brand.indexed"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An empty list receives all event types.",
          "title": "Filter Types"
        },
        "disabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled"
        },
        "operation": {
          "const": "create_webhook_endpoint",
          "default": "create_webhook_endpoint",
          "description": "Paid plan and owner/admin role. Registers a URL for event deliveries.",
          "title": "Create Webhook Endpoint",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "url"
      ],
      "title": "CreateWebhookEndpoint",
      "type": "object"
    },
    "DeleteWebhookEndpoint": {
      "additionalProperties": false,
      "properties": {
        "endpoint_id": {
          "description": "Webhook endpoint ID.",
          "minLength": 1,
          "pattern": "^ep_[A-Za-z0-9]+$",
          "title": "Endpoint Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_webhook_endpoint",
          "default": "delete_webhook_endpoint",
          "description": "Paid plan and owner/admin role. Permanently stops deliveries to this endpoint.",
          "title": "Delete Webhook Endpoint",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "endpoint_id"
      ],
      "title": "DeleteWebhookEndpoint",
      "type": "object"
    },
    "FlagDomains": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "flag_domains",
          "default": "flag_domains",
          "description": "Pro plan or above. Submits corrections for manual review; does not immediately change brand data.",
          "title": "Flag Domains for Review",
          "type": "string",
          "ui:hidden": true
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Domains",
          "type": "array"
        },
        "reason": {
          "enum": [
            "incorrect_logo",
            "incorrect_brand",
            "outdated_data",
            "other"
          ],
          "title": "Reason",
          "type": "string"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        }
      },
      "required": [
        "domains",
        "reason"
      ],
      "title": "FlagDomains",
      "type": "object"
    },
    "GetAccount": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_account",
          "default": "get_account",
          "description": "Returns plan and credit balances. Not billed.",
          "title": "Get Account and Credits",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetAccount",
      "type": "object"
    },
    "GetBrand": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Company domain, such as stripe.com. Send exactly one identifier.",
          "title": "Domain"
        },
        "ticker": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stock/ETF ticker; exchange suffixes such as 7203.T are supported.",
          "title": "Ticker"
        },
        "isin": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isin"
        },
        "crypto": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Crypto symbol, such as BTC.",
          "title": "Crypto"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Brand name resolved to its top search match.",
          "title": "Name"
        },
        "operation": {
          "const": "get_brand",
          "default": "get_brand",
          "title": "Look Up Brand",
          "type": "string",
          "ui:hidden": true
        },
        "nosubscribe": {
          "anyOf": [
            {
              "const": "true",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set true to skip automatic subscription. Brand reads cost API credits when ready.",
          "title": "Nosubscribe"
        }
      },
      "title": "GetBrand",
      "type": "object"
    },
    "GetBrandById": {
      "additionalProperties": false,
      "properties": {
        "brand_id": {
          "description": "Stable data.id from a brand response.",
          "minLength": 1,
          "pattern": "^brand_[A-Za-z0-9]+$",
          "title": "Brand Id",
          "type": "string"
        },
        "operation": {
          "const": "get_brand_by_id",
          "default": "get_brand_by_id",
          "title": "Get Brand by ID",
          "type": "string",
          "ui:hidden": true
        },
        "nosubscribe": {
          "anyOf": [
            {
              "const": "true",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set true to skip automatic subscription.",
          "title": "Nosubscribe"
        }
      },
      "required": [
        "brand_id"
      ],
      "title": "GetBrandById",
      "type": "object"
    },
