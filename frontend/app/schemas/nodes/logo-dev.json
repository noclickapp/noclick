        "operation": {
          "const": "get_brand_logo",
          "default": "get_brand_logo",
          "description": "Returns JSON with a temporary image URL; costs API credits.",
          "title": "Get Brand Logo",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "GetBrandLogo",
      "type": "object"
