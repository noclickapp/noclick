          "pattern": "^ep_[A-Za-z0-9]+$",
          "title": "Endpoint Id",
          "type": "string"
        },
        "operation": {
          "const": "get_webhook_secret",
          "default": "get_webhook_secret",
          "description": "Paid plan. Returns sensitive signing material; protect workflow outputs.",
          "title": "Get Webhook Signing Secret",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "endpoint_id"
      ],
      "title": "GetWebhookSecret",
      "type": "object"
    },
    "ListWebhookEndpoints": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_webhook_endpoints",
          "default": "list_webhook_endpoints",
          "description": "Paid plan. Returns all team endpoints; not paginated.",
          "title": "List Webhook Endpoints",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "ListWebhookEndpoints",
      "type": "object"
    },
    "LogoDevCredential": {
      "properties": {
        "credential_type": {
          "const": "logo_dev_api_key",
          "default": "logo_dev_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "Secret API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Logo Dev API Key",
      "type": "object",
      "x-credential-instructions": "Copy your secret API key (sk_) from the Logo.dev dashboard. Use a secret key, not the publishable CDN key or transaction beta key. NoClick checks your account plan and credit balance with a free account read. Paid plans and owner/admin access are required for some webhook operations; flagging requires Pro or above.",
      "x-credential-url": "https://www.logo.dev/dashboard"
    },
    "RotateWebhookSecret": {
      "additionalProperties": false,
      "properties": {
        "endpoint_id": {
          "description": "Webhook endpoint ID.",
          "minLength": 1,
          "pattern": "^ep_[A-Za-z0-9]+$",
          "title": "Endpoint Id",
          "type": "string"
        },
        "operation": {
          "const": "rotate_webhook_secret",
          "default": "rotate_webhook_secret",
          "description": "Paid plan and owner/admin role. Replaces the secret; update your verification code with the returned key.",
          "title": "Rotate Webhook Signing Secret",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "endpoint_id"
      ],
      "title": "RotateWebhookSecret",
      "type": "object"
    },
    "SearchBrands": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "search_brands",
          "default": "search_brands",
          "description": "Each search costs API credits.",
          "title": "Search Brands",
          "type": "string",
          "ui:hidden": true
        },
        "q": {
          "minLength": 1,
          "title": "Search query",
          "type": "string"
        },
        "method": {
          "default": "match",
          "enum": [
            "match",
            "typeahead"
          ],
          "title": "Method",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "maximum": 25,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "q"
      ],
      "title": "SearchBrands",
      "type": "object"
    },
