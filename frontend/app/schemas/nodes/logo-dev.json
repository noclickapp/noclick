    "GetSubscription": {
      "additionalProperties": false,
      "properties": {
        "brand_id": {
          "description": "Stable data.id from a brand response.",
          "minLength": 1,
          "pattern": "^brand_[A-Za-z0-9]+$",
          "title": "Brand Id",
          "type": "string"
        },
        "operation": {
          "const": "get_subscription",
          "default": "get_subscription",
          "title": "Get Brand Subscription",
          "type": "string",
