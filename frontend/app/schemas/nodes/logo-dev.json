          "get_brand_logo": "#/$defs/GetBrandLogo",
          "get_brandmark": "#/$defs/GetBrandmark",
          "get_subscription": "#/$defs/GetSubscription",
          "get_webhook_endpoint": "#/$defs/GetWebhookEndpoint",
          "get_webhook_secret": "#/$defs/GetWebhookSecret",
          "list_webhook_endpoints": "#/$defs/ListWebhookEndpoints",
          "rotate_webhook_secret": "#/$defs/RotateWebhookSecret",
          "search_brands": "#/$defs/SearchBrands",
          "subscribe_brand": "#/$defs/SubscribeBrand",
          "unsubscribe_brand": "#/$defs/UnsubscribeBrand",
          "update_webhook_endpoint": "#/$defs/UpdateWebhookEndpoint"
        },
        "propertyName": "operation"
      },
      "oneOf": [
