          "title": "Endpoint Id",
          "type": "string"
        },
        "operation": {
          "const": "get_webhook_endpoint",
          "default": "get_webhook_endpoint",
          "description": "Requires a paid plan.",
          "title": "Get Webhook Endpoint",
