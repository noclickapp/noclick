        },
        {
          "$ref": "#/$defs/GetWebhookEndpoint"
        },
        {
          "$ref": "#/$defs/UpdateWebhookEndpoint"
        },
        {
          "$ref": "#/$defs/DeleteWebhookEndpoint"
        },
        {
          "$ref": "#/$defs/GetWebhookSecret"
        },
        {
          "$ref": "#/$defs/RotateWebhookSecret"
        },
        {
          "$ref": "#/$defs/GetAccount"
        },
        {
          "$ref": "#/$defs/FlagDomains"
