      "title": "CreateOrderConfig",
      "type": "object"
    },
    "CreateOrderRequest": {
      "additionalProperties": false,
      "properties": {
        "marketSlug": {
          "description": "Unique market slug into which the order should be entered",
          "minLength": 1,
          "title": "Marketslug",
          "type": "string"
        },
        "type": {
          "description": "Type of order (limit or market)",
          "enum": [
            "ORDER_TYPE_LIMIT",
            "ORDER_TYPE_MARKET"
          ],
          "title": "Type",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Order price and currency. Required for limit orders."
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Order quantity in contracts. Supports decimal quantities on markets whose minimumTradeQty is less than 1.",
          "title": "Quantity"
        },
        "tif": {
          "description": "Order time in force policy",
          "enum": [
            "TIME_IN_FORCE_DAY",
            "TIME_IN_FORCE_GOOD_TILL_CANCEL",
            "TIME_IN_FORCE_GOOD_TILL_DATE",
            "TIME_IN_FORCE_IMMEDIATE_OR_CANCEL",
            "TIME_IN_FORCE_FILL_OR_KILL"
          ],
          "title": "Tif",
          "type": "string"
        },
        "participateDontInitiate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If true, order must rest on the book prior to matching (maker only). Order will be rejected if it would immediately match.",
          "title": "Participatedontinitiate"
        },
        "goodTillTime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expiration time for orders with TIME_IN_FORCE_GOOD_TILL_DATE",
          "title": "Goodtilltime"
        },
        "intent": {
          "anyOf": [
            {
              "enum": [
                "ORDER_INTENT_BUY_LONG",
                "ORDER_INTENT_SELL_LONG",
                "ORDER_INTENT_BUY_SHORT",
                "ORDER_INTENT_SELL_SHORT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Order intent. Either `intent` or (`outcomeSide` + `action`) must be set.",
          "title": "Intent",
          "enum": [
            "ORDER_INTENT_BUY_LONG",
            "ORDER_INTENT_SELL_LONG",
            "ORDER_INTENT_BUY_SHORT",
            "ORDER_INTENT_SELL_SHORT"
          ],
          "x-enum-searchable": true
        },
        "outcomeSide": {
          "anyOf": [
            {
              "enum": [
                "OUTCOME_SIDE_YES",
                "OUTCOME_SIDE_NO"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Outcome side. Set with `action` as an alternative to `intent`. Takes priority if both are set.",
          "title": "Outcomeside",
          "enum": [
            "OUTCOME_SIDE_YES",
            "OUTCOME_SIDE_NO"
          ],
          "x-enum-searchable": true
        },
        "action": {
          "anyOf": [
            {
              "enum": [
                "ORDER_ACTION_BUY",
                "ORDER_ACTION_SELL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Order action. Set with `outcomeSide` as an alternative to `intent`.",
          "title": "Action",
          "enum": [
            "ORDER_ACTION_BUY",
            "ORDER_ACTION_SELL"
          ],
          "x-enum-searchable": true
        },
        "cashOrderQty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Order quantity in cash and currency. Used for market orders instead of share quantity."
        },
        "manualOrderIndicator": {
          "const": "MANUAL_ORDER_INDICATOR_AUTOMATIC",
          "default": "MANUAL_ORDER_INDICATOR_AUTOMATIC",
          "description": "Indicates whether the order was placed manually or automatically",
          "title": "Manualorderindicator",
          "type": "string"
        },
        "synchronousExecution": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If true, will block until the order is filled, rejected, canceled, or expired, up to maxBlockTime seconds",
          "title": "Synchronousexecution"
        },
        "maxBlockTime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum block time in seconds if synchronous execution is requested",
          "title": "Maxblocktime"
        },
        "slippageTolerance": {
          "anyOf": [
            {
              "$ref": "#/$defs/SlippageTolerance"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slippage tolerance configuration for the order"
        }
      },
      "required": [
        "marketSlug",
        "type",
        "tif"
      ],
      "title": "CreateOrderRequest",
      "type": "object"
    },
