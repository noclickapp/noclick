          "translate_braille": "#/$defs/FunTranslationsBrailleConfig",
          "translate_chef": "#/$defs/FunTranslationsChefConfig",
          "translate_cheunh": "#/$defs/FunTranslationsCheunhConfig",
          "translate_dothraki": "#/$defs/FunTranslationsDothrakiConfig",
          "translate_gungan": "#/$defs/FunTranslationsGunganConfig",
          "translate_huttese": "#/$defs/FunTranslationsHutteseConfig",
          "translate_klingon": "#/$defs/FunTranslationsKlingonConfig",
          "translate_mandalorian": "#/$defs/FunTranslationsMandalorianConfig",
          "translate_minion": "#/$defs/FunTranslationsMinionConfig",
          "translate_morse": "#/$defs/FunTranslationsMorseConfig",
          "translate_morse2english": "#/$defs/FunTranslationsMorse2EnglishConfig",
          "translate_oldenglish": "#/$defs/FunTranslationsOldenglishConfig",
          "translate_piglatin": "#/$defs/FunTranslationsPiglatinConfig",
          "translate_pirate": "#/$defs/FunTranslationsPirateConfig",
          "translate_shakespeare": "#/$defs/FunTranslationsShakespeareConfig",
          "translate_sindarin": "#/$defs/FunTranslationsSindarinConfig",
          "translate_sith": "#/$defs/FunTranslationsSithConfig",
          "translate_uk2us": "#/$defs/FunTranslationsUk2UsConfig",
          "translate_us2uk": "#/$defs/FunTranslationsUs2UkConfig",
          "translate_valspeak": "#/$defs/FunTranslationsValspeakConfig",
          "translate_valyrian": "#/$defs/FunTranslationsValyrianConfig",
          "translate_vulcan": "#/$defs/FunTranslationsVulcanConfig",
          "translate_yoda": "#/$defs/FunTranslationsYodaConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FunTranslationsCheckConnectionConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsYodaConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsPirateConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsShakespeareConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsMinionConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsMorseConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsMorse2EnglishConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsBrailleConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsSithConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsCheunhConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsGunganConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsMandalorianConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsHutteseConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsVulcanConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsKlingonConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsSindarinConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsValspeakConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsPiglatinConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsDothrakiConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsValyrianConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsChefConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsOldenglishConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsUs2UkConfig"
        },
        {
          "$ref": "#/$defs/FunTranslationsUk2UsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunTranslationsAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Funtranslations Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
