{
  "$defs": {
    "FunTranslationsAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "funtranslations_api_key",
          "default": "funtranslations_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "check_translator": {
          "default": "yoda",
          "description": "Choose one included in your subscription.",
          "enum": [
            "yoda",
            "pirate",
            "shakespeare",
            "minion",
            "morse",
            "morse2english",
            "braille",
            "sith",
            "cheunh",
            "gungan",
            "mandalorian",
            "huttese",
            "vulcan",
            "klingon",
            "sindarin",
            "valspeak",
            "piglatin",
            "dothraki",
            "valyrian",
            "chef",
            "oldenglish",
            "us2uk",
            "uk2us"
          ],
          "title": "Translator for connection check",
          "type": "string"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "FunTranslations API Key",
      "type": "object",
      "x-credential-instructions": "Paste your FunTranslations API key and choose a translator included in your subscription. Connecting makes one translation request and uses your API quota. This integration uses the published Swagger 2.3 API with the X-Funtranslations-Api-Secret header. A successful read proves reachability, not account ownership; the public free tier may also accept a request.",
      "x-credential-url": "https://funtranslations.com/api"
    },
    "FunTranslationsBrailleConfig": {
      "description": "Translate from English to Braille. This is what you use if you have a braille display. This API translates the English text into characters that a braille display understands and you can feed the translated text directly to the display.",
