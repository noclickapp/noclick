        },
        {
          "$ref": "#/$defs/GetCandidate"
        },
        {
          "$ref": "#/$defs/UpdateCandidate"
        },
        {
          "$ref": "#/$defs/DeleteCandidate"
        },
        {
          "$ref": "#/$defs/ListNotes"
        },
        {
          "$ref": "#/$defs/ListOffers"
        },
        {
          "$ref": "#/$defs/CreateOffer"
        },
        {
          "$ref": "#/$defs/GetOffer"
        },
        {
          "$ref": "#/$defs/DeleteOffer"
        },
        {
          "$ref": "#/$defs/ListDepartments"
        },
        {
          "$ref": "#/$defs/ListMemberships"
        },
        {
          "$ref": "#/$defs/ListLocations"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecruiteeCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
