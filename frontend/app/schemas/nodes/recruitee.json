  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_candidate": "#/$defs/CreateCandidate",
          "create_offer": "#/$defs/CreateOffer",
          "delete_candidate": "#/$defs/DeleteCandidate",
          "delete_offer": "#/$defs/DeleteOffer",
          "get_candidate": "#/$defs/GetCandidate",
          "get_offer": "#/$defs/GetOffer",
          "list_candidate_notes": "#/$defs/ListNotes",
          "list_candidates": "#/$defs/ListCandidates",
          "list_departments": "#/$defs/ListDepartments",
          "list_locations": "#/$defs/ListLocations",
          "list_memberships": "#/$defs/ListMemberships",
          "list_offers": "#/$defs/ListOffers",
          "search_candidates": "#/$defs/SearchCandidates",
          "update_candidate": "#/$defs/UpdateCandidate"
