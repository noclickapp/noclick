{
  "$defs": {
    "RollbarAccessTokenCredential": {
      "description": "Account token plus optional project read/write and reporting tokens.",
      "properties": {
        "credential_type": {
          "const": "rollbar_access_token",
          "default": "rollbar_access_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "account_access_token": {
          "description": "Account token with read and write scopes. Required for account, project, team, and user operations.",
          "title": "Account Access Token (read/write)",
          "type": "string",
          "ui:widget": "password"
        },
        "project_read_write_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Project token with read and write scopes. Used for item, occurrence, environment, and deploy operations on its project; otherwise the account token and Project ID are used.",
          "title": "Project Access Token (read/write)",
          "ui:widget": "password"
        },
        "project_post_server_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Separate project token with post_server_item scope. Required to report messages and deploys.",
          "title": "Project Post Server Item Token",
          "ui:widget": "password"
        }
      },
      "required": [
        "account_access_token"
      ],
      "title": "Rollbar Access Token",
      "type": "object",
      "x-credential-url": "https://rollbar.com/settings/accounts/",
      "x-help-text": "Create an account read/write token in Account Settings \u2192 Account Access Tokens. Add a project read/write token for project data and a separate post_server_item token for reporting from Project Settings \u2192 Access Tokens."
    },
