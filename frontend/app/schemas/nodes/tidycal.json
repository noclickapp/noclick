{
  "$defs": {
    "AddBookingGuestConfig": {
      "additionalProperties": false,
      "description": "Add guest to booking.",
      "properties": {
        "operation": {
          "const": "add_booking_guest",
          "default": "add_booking_guest",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "booking_id": {
          "minimum": 1,
          "title": "Booking Id",
          "type": "integer"
        },
        "name": {
          "description": "Guest's name",
          "maxLength": 80,
          "title": "Name",
          "type": "string"
        },
        "email": {
          "description": "Guest's email address. Must not already be the booker or a guest on this booking.",
          "format": "email",
          "maxLength": 191,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "booking_id",
        "name",
        "email"
      ],
      "title": "AddBookingGuestConfig",
      "type": "object"
    },
    "BookingAnswer": {
      "additionalProperties": false,
      "properties": {
        "booking_type_question_id": {
          "minimum": 1,
          "title": "Booking Type Question Id",
          "type": "integer"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Answer"
        }
      },
      "required": [
        "booking_type_question_id",
        "answer"
      ],
      "title": "BookingAnswer",
      "type": "object"
    },
    "CancelBookingConfig": {
      "additionalProperties": false,
      "description": "Cancel booking.",
      "properties": {
        "operation": {
          "const": "cancel_booking",
          "default": "cancel_booking",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "booking_id": {
          "minimum": 1,
          "title": "Booking Id",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional reason for cancellation",
          "title": "Reason"
        },
        "notify": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Email the booker and the host about the cancellation. Send false to cancel without any notification.",
          "title": "Notify"
        }
      },
      "required": [
        "booking_id"
      ],
      "title": "CancelBookingConfig",
      "type": "object"
    },
    "CreateBookingConfig": {
      "additionalProperties": false,
      "description": "Create booking.",
      "properties": {
        "operation": {
          "const": "create_booking",
          "default": "create_booking",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "booking_type_id": {
          "minimum": 1,
          "title": "Booking Type Id",
          "type": "integer"
        },
        "starts_at": {
          "description": "The start time of the booking in UTC. Required for single bookings. Ignored if `bookings` array is provided.",
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "name": {
          "description": "Name of the person making the booking",
          "maxLength": 191,
          "title": "Name",
          "type": "string"
        },
        "email": {
          "description": "Email of the person making the booking",
          "format": "email",
          "maxLength": 191,
          "title": "Email",
          "type": "string"
        },
        "timezone": {
          "description": "The timezone of the booking",
          "maxLength": 191,
          "title": "Timezone",
          "type": "string"
        },
        "booking_questions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/BookingAnswer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Answers to booking type questions",
          "title": "Booking Questions"
        },
        "coupon_code": {
          "anyOf": [
            {
              "maxLength": 191,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One of the host's coupon codes (case-insensitive). Required to book a priced\nbooking type, and it must bring the price to 0. Ignored for a free booking type.\n",
          "title": "Coupon Code"
        }
      },
      "required": [
        "booking_type_id",
        "starts_at",
        "name",
        "email",
        "timezone"
      ],
      "title": "CreateBookingConfig",
      "type": "object"
    },
    "CreateBookingTypeConfig": {
      "additionalProperties": false,
      "description": "Create booking type.",
      "properties": {
        "operation": {
          "const": "create_booking_type",
          "default": "create_booking_type",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "title": {
          "maxLength": 191,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "duration_minutes": {
          "minimum": 1,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "url_slug": {
          "maxLength": 191,
          "title": "Url Slug",
          "type": "string"
        },
        "padding_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Padding Minutes"
        },
        "latest_availability_days": {
          "anyOf": [
            {
              "maximum": 36500,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Availability Days"
        },
        "private": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Private"
        },
        "max_bookings": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Bookings"
        },
        "max_guest_invites_per_booker": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Guest Invites Per Booker"
        },
        "display_seats_remaining": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Seats Remaining"
        },
        "booking_availability_interval_minutes": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 15,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If omitted, defaults to 30 for meetings of at least 30 minutes owned by new signups assigned to the new-booking-type-interval treatment; otherwise 15. Explicit values are preserved.",
          "title": "Booking Availability Interval Minutes"
        },
        "price": {
          "anyOf": [
            {
              "maximum": 99999999.99,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Price for the booking type. Set to 0 for free booking types. How many decimal places are accepted depends on the currency: a currency with no sub-unit (JPY, KRW, CLP, VND and the other zero-decimal currencies) takes whole amounts only, every other currency takes at most 2. Trailing zeros are notation rather than precision, so 2200.00 is a valid JPY price. The currency judged is the one sent in `currency_code`, or your account currency when that is omitted. A price below Stripe's minimum charge for the currency (0.50 USD, for example) is refused on Stripe and TidyCal Payments, and a currency PayPal doesn't list is refused on PayPal. A recurring session or subscription plan price is held to the minimum the recurring charge uses, which is higher in some currencies (50 INR, for example).",
          "title": "Price"
        },
        "payment_platform": {
          "anyOf": [
            {
              "enum": [
                "stripe",
                "paypal",
                "tidycal",
                "razorpay"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Payment platform to use. The platform must be connected in your account Integrations settings. When price > 0 and this is omitted on a new booking type, or a free one whose platform cannot take the charge, your connected platform is used: the one your paid booking types are on if you have moved off TidyCal Payments, otherwise TidyCal Payments, then Stripe, then Razorpay, then PayPal. Recurring booking types and subscription plans need Stripe, and any other platform returns 422. If none is connected the request returns 422 and asks you to connect Stripe.",
          "title": "Payment Platform",
          "enum": [
            "stripe",
            "paypal",
            "tidycal",
            "razorpay"
          ],
          "x-enum-searchable": true
        },
        "currency_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 4217 currency code (e.g. USD, EUR, GBP). Defaults to your account currency.",
          "title": "Currency Code"
        },
        "booking_threshold": {
          "anyOf": [
            {
              "maximum": 15000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum notice required before a booking, in minutes. Omit for the default of 120 (2 hours); set to 0 for no minimum notice.",
          "title": "Booking Threshold"
        }
      },
      "required": [
        "title",
        "description",
        "duration_minutes",
        "url_slug"
      ],
      "title": "CreateBookingTypeConfig",
      "type": "object"
    },
