    "DevinOnSessionFinishedConfig": {
      "description": "Poll-based trigger that fires when a Devin session newly reaches a\nterminal status (finished / blocked / expired / stopped).\n\nDevin has no outbound webhooks, so this provisions a webhook + cron schedule\n(the wake-up signal) and polls GET /v1/sessions on each tick, emitting only\nsessions whose (session_id, status) pair has not been seen before.",
      "properties": {
        "operation": {
          "const": "on_session_finished",
          "default": "on_session_finished",
          "title": "On Session Finished",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On Session Finished",
          "x-is-trigger": true
        },
        "tags": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only fire for sessions carrying ALL of these comma-separated tags (optional)",
          "placeholder": "ci,release (optional)",
          "title": "Filter by Tags"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": {
            "frequency": "minutes",
            "interval": 5,
            "hour": 9,
            "minute": 0,
            "dayOfWeek": 1,
            "dayOfMonth": 1
          },
          "description": "How often to poll Devin for finished sessions",
          "title": "Check Frequency",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "max_results": {
          "default": 50,
          "description": "Maximum number of sessions to scan per check (1-100)",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Sessions",
          "type": "integer",
          "ui:hidden": true
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:copyable": true,
          "ui:hidden": true,
          "ui:loadValue": true,
          "ui:widget": "webhook"
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Check",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "last_seen_ids": {
