{
  "$defs": {
    "CronEntry": {
      "additionalProperties": false,
      "properties": {
        "cron": {
          "description": "Five-field cron expression",
          "minLength": 1,
          "title": "Cron",
          "type": "string"
        },
        "timeZone": {
          "minLength": 1,
          "title": "Time Zone",
          "type": "string"
        }
      },
      "required": [
        "cron",
        "timeZone"
      ],
      "title": "CronEntry",
      "type": "object"
    },
    "Geofence": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "radius": {
          "title": "Radius",
          "type": "number"
        },
        "radiusUnits": {
          "enum": [
            "meters",
            "kilometers",
            "miles"
          ],
          "title": "Radiusunits",
          "type": "string"
        },
        "type": {
          "enum": [
            "enter",
            "exit"
          ],
          "title": "Type",
          "type": "string"
        },
        "timeThrottle": {
          "default": "0",
          "title": "Timethrottle",
          "type": "string"
        },
        "subscribable": {
          "default": "yes",
          "enum": [
            "yes",
            "no"
          ],
          "title": "Subscribable",
          "type": "string"
        }
      },
      "required": [
        "lat",
        "lon",
        "radius",
        "radiusUnits",
        "type"
      ],
      "title": "Geofence",
      "type": "object"
    },
    "TriggerSettings": {
      "additionalProperties": false,
      "properties": {
        "crons": {
          "items": {
            "$ref": "#/$defs/CronEntry"
          },
          "title": "Crons",
          "type": "array"
        }
      },
      "title": "TriggerSettings",
      "type": "object"
    },
    "VybitCreateReminderConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_reminder",
          "default": "create_reminder",
          "title": "Create Reminder",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "cron": {
          "description": "Cron expression naming the one date the reminder fires.\nFormat: minute hour day month dayOfWeek, with a numeric day and month\nand `*` for dayOfWeek.\n",
          "minLength": 1,
          "pattern": "^\\S+\\s+\\S+\\s+\\d{1,2}\\s+\\d{1,2}\\s+\\*$",
          "title": "Cron",
          "type": "string"
        },
        "time_zone": {
          "default": "UTC",
          "description": "IANA timezone identifier",
          "title": "Time Zone",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Year for the reminder (defaults to current year). Used for one-time reminders \u2014 expired reminders are automatically garbage-collected.",
          "title": "Year"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Notification message for this reminder (max 1024 characters)",
          "title": "Message"
        },
        "image_url": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "\\.(jpe?g|png|gif)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Image URL for this reminder's notification (max 512 characters). Must link to a JPG, PNG, or GIF image. URLs without a protocol will have https:// prepended.",
          "format": "uri",
          "title": "Image Url"
        },
        "link_url": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Link URL for this reminder's notification (max 512 characters). URLs without a protocol will have https:// prepended.",
          "format": "uri",
          "title": "Link Url"
        },
        "log": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Log content for this reminder's notification (max 10,000 characters)",
          "title": "Log"
        }
      },
      "required": [
        "key",
        "cron"
      ],
      "title": "VybitCreateReminderConfig",
      "type": "object"
    },
    "VybitCreateSubscriptionConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_subscription",
          "default": "create_subscription",
          "title": "Subscribe to Vybit",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "VybitCreateSubscriptionConfig",
      "type": "object"
    },
    "VybitCreateVybitConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_vybit",
          "default": "create_vybit",
          "title": "Create Vybit",
          "type": "string"
        },
        "name": {
          "description": "Vybit display name",
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Detailed vybit description",
          "maxLength": 512,
          "title": "Description",
          "type": "string"
        },
        "sound_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key of the sound to play (must be an available sound from /sounds endpoint)",
          "title": "Sound Key"
        },
        "status": {
          "default": "on",
          "description": "Vybit status (on = active, off = disabled)",
          "enum": [
            "on",
            "off"
          ],
          "title": "Status",
          "type": "string"
        },
        "trigger_type": {
          "default": "webhook",
          "description": "How this vybit is triggered",
          "enum": [
            "webhook",
            "schedule",
            "geofence",
            "integration",
            "reminders"
          ],
          "title": "Trigger Type",
          "type": "string"
        },
        "trigger_settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/TriggerSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Configuration for scheduled triggers.\nRequired when triggerType is \"schedule\", null otherwise.\nFor triggerType \"reminders\", reminders are managed only via the Reminders endpoints; any sent here are ignored.\n"
        },
        "access": {
          "default": "private",
          "description": "Vybit visibility and access control",
          "enum": [
            "public",
            "private",
            "unlisted"
          ],
          "title": "Access",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default message displayed with notifications (max 1024 characters)",
          "title": "Message"
        },
        "log": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Plain-text default log saved with each notification (max 10,000 characters).\nWhen sent it is escaped, its line breaks are kept, and its http(s) URLs are\nlinked. A trigger's own `log` replaces it.\n",
          "title": "Log"
        },
        "image_url": {
          "anyOf": [
            {
              "pattern": "\\.(jpe?g|png|gif)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default image URL for notifications. Must link to a JPG, PNG, or GIF image.",
          "format": "uri",
          "title": "Image Url"
        },
        "link_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default URL to open when notification is tapped",
          "format": "uri",
          "title": "Link Url"
        },
        "geofence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geofence"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Geofence configuration. Required when triggerType is \"geofence\", null otherwise.\n"
        },
        "send_permissions": {
          "default": "owner_subs",
          "description": "Who can trigger and receive notifications:\n- owner_subs: owner triggers \u2192 subscribers receive (one-way)\n- subs_owner: owner \u2194 subscribers (two-way between owner and each subscriber)\n- subs_group: subscribers trigger \u2192 all subscribers receive (group broadcast)\n",
          "enum": [
            "owner_subs",
            "subs_owner",
            "subs_group"
          ],
          "title": "Send Permissions",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "VybitCreateVybitConfig",
      "type": "object"
    },
