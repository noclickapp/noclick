        }
      },
      "title": "NotraListPostAuthorsConfig",
      "type": "object"
    },
    "NotraListPostsConfig": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "sort": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Sort",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated draft,published. Provider defaults to published posts only.",
          "title": "Status"
        },
        "contentType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated content types.",
          "title": "Contenttype"
        },
        "brandIdentityId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated brand identity IDs.",
          "title": "Brandidentityid"
        },
        "operation": {
          "const": "list_posts",
          "default": "list_posts",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "title": "NotraListPostsConfig",
      "type": "object"
