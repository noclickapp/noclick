  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "cancel_post_schedule": "#/$defs/NotraCancelPostScheduleConfig",
          "create_post": "#/$defs/NotraCreatePostConfig",
          "delete_brand_identity": "#/$defs/NotraDeleteBrandIdentityConfig",
          "delete_post": "#/$defs/NotraDeletePostConfig",
          "generate_post": "#/$defs/NotraGeneratePostConfig",
          "get_brand_identity": "#/$defs/NotraGetBrandIdentityConfig",
          "get_post": "#/$defs/NotraGetPostConfig",
          "get_post_generation": "#/$defs/NotraGetPostGenerationConfig",
          "get_post_schedule": "#/$defs/NotraGetPostScheduleConfig",
          "get_site": "#/$defs/NotraGetSiteConfig",
          "list_brand_identities": "#/$defs/NotraListBrandIdentitiesConfig",
          "list_integrations": "#/$defs/NotraListIntegrationsConfig",
          "list_post_authors": "#/$defs/NotraListPostAuthorsConfig",
          "list_posts": "#/$defs/NotraListPostsConfig",
          "list_sites": "#/$defs/NotraListSitesConfig",
          "list_workspaces": "#/$defs/NotraListWorkspacesConfig",
          "publish_post_to_site": "#/$defs/NotraPublishPostToSiteConfig",
          "schedule_post": "#/$defs/NotraSchedulePostConfig",
          "update_brand_identity": "#/$defs/NotraUpdateBrandIdentityConfig",
          "update_post": "#/$defs/NotraUpdatePostConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NotraListWorkspacesConfig"
        },
        {
          "$ref": "#/$defs/NotraListPostsConfig"
        },
        {
          "$ref": "#/$defs/NotraGetPostConfig"
        },
        {
          "$ref": "#/$defs/NotraCreatePostConfig"
        },
        {
          "$ref": "#/$defs/NotraUpdatePostConfig"
        },
        {
          "$ref": "#/$defs/NotraDeletePostConfig"
        },
        {
          "$ref": "#/$defs/NotraListPostAuthorsConfig"
        },
        {
          "$ref": "#/$defs/NotraGeneratePostConfig"
        },
        {
          "$ref": "#/$defs/NotraGetPostGenerationConfig"
        },
        {
          "$ref": "#/$defs/NotraGetPostScheduleConfig"
        },
        {
          "$ref": "#/$defs/NotraSchedulePostConfig"
        },
        {
          "$ref": "#/$defs/NotraCancelPostScheduleConfig"
        },
        {
          "$ref": "#/$defs/NotraListBrandIdentitiesConfig"
        },
        {
          "$ref": "#/$defs/NotraGetBrandIdentityConfig"
        },
        {
          "$ref": "#/$defs/NotraUpdateBrandIdentityConfig"
        },
        {
          "$ref": "#/$defs/NotraDeleteBrandIdentityConfig"
        },
        {
          "$ref": "#/$defs/NotraListIntegrationsConfig"
        },
        {
          "$ref": "#/$defs/NotraListSitesConfig"
        },
        {
          "$ref": "#/$defs/NotraGetSiteConfig"
        },
        {
          "$ref": "#/$defs/NotraPublishPostToSiteConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/NotraAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
