{
  "$defs": {
    "NotraAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "notra_api_key",
          "default": "notra_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for account keys belonging to multiple workspaces. Sent as X-Notra-Organization-Id.",
          "title": "Workspace ID or slug"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Notra API Key",
      "type": "object",
      "x-credential-instructions": "Paste your Notra account or organization API key. Account keys can select a workspace with its ID or slug; this is required when you belong to multiple workspaces. Organization keys can select only their own workspace. NoClick sends the key only to api.usenotra.com. Grant access to the operations you use; connecting reads your authenticated workspace context.",
      "x-credential-url": "https://www.usenotra.com/docs/api/authentication"
    },
    "NotraCancelPostScheduleConfig": {
      "additionalProperties": false,
      "properties": {
        "post_id": {
          "title": "Post Id",
          "type": "string"
        },
        "operation": {
          "const": "cancel_post_schedule",
          "default": "cancel_post_schedule",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "post_id"
      ],
      "title": "NotraCancelPostScheduleConfig",
      "type": "object"
    },
    "NotraCreatePostConfig": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "contentType": {
          "enum": [
            "blog_post",
            "changelog",
            "linkedin_post",
            "twitter_post"
          ],
          "title": "Contenttype",
          "type": "string"
        },
        "slug": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slug"
        },
        "markdown": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "published"
          ],
          "title": "Status",
          "type": "string"
        },
        "operation": {
          "const": "create_post",
          "default": "create_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "title",
        "contentType"
      ],
      "title": "NotraCreatePostConfig",
      "type": "object"
    },
    "NotraDeleteBrandIdentityConfig": {
      "additionalProperties": false,
      "properties": {
        "brand_identity_id": {
          "title": "Brand Identity Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_brand_identity",
          "default": "delete_brand_identity",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "brand_identity_id"
      ],
      "title": "NotraDeleteBrandIdentityConfig",
      "type": "object"
    },
    "NotraDeletePostConfig": {
      "additionalProperties": false,
      "properties": {
        "post_id": {
          "title": "Post Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_post",
          "default": "delete_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "post_id"
      ],
      "title": "NotraDeletePostConfig",
      "type": "object"
    },
    "NotraGeneratePostConfig": {
      "additionalProperties": false,
      "properties": {
        "contentType": {
          "enum": [
            "changelog",
            "blog_post",
            "linkedin_post",
            "twitter_post",
            "image"
          ],
          "title": "Contenttype",
          "type": "string"
        },
        "lookbackWindow": {
          "default": "last_7_days",
          "enum": [
            "current_day",
            "yesterday",
            "last_7_days",
            "last_14_days",
            "last_30_days"
          ],
          "title": "Lookbackwindow",
          "type": "string"
        },
        "brandIdentityId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brandidentityid"
        },
        "brief": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Topic and angle; facts come from connected sources. Omitted source selectors use all connected GitHub integrations.",
          "title": "Brief"
        },
        "timezone": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "operation": {
          "const": "generate_post",
          "default": "generate_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "contentType"
      ],
      "title": "NotraGeneratePostConfig",
      "type": "object"
    },
    "NotraGetBrandIdentityConfig": {
      "additionalProperties": false,
      "properties": {
        "brand_identity_id": {
          "title": "Brand Identity Id",
          "type": "string"
        },
        "operation": {
          "const": "get_brand_identity",
