      "properties": {
        "site_id": {
          "title": "Site Id",
          "type": "string"
        },
        "postId": {
          "description": "Blog post or changelog. Opens or updates a repository pull request; the site goes live after merge.",
          "title": "Postid",
          "type": "string"
        },
        "operation": {
          "const": "publish_post_to_site",
          "default": "publish_post_to_site",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "site_id",
        "postId"
      ],
      "title": "NotraPublishPostToSiteConfig",
      "type": "object"
    },
    "NotraSchedulePostConfig": {
      "additionalProperties": false,
      "properties": {
        "post_id": {
          "title": "Post Id",
          "type": "string"
        },
        "scheduledAt": {
          "description": "ISO 8601 timestamp with timezone, at most a year ahead. Up to five minutes in the past publishes immediately.",
          "title": "Scheduledat",
          "type": "string"
        },
        "timeZone": {
          "default": "UTC",
          "description": "IANA timezone for display and emails. Publishes in Notra; external destinations are not selected by this operation.",
          "maxLength": 100,
          "title": "Timezone",
          "type": "string"
        },
        "operation": {
          "const": "schedule_post",
          "default": "schedule_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "post_id",
        "scheduledAt"
      ],
      "title": "NotraSchedulePostConfig",
      "type": "object"
    },
    "NotraUpdateBrandIdentityConfig": {
      "additionalProperties": false,
      "properties": {
        "brand_identity_id": {
          "title": "Brand Identity Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "toneProfile": {
          "anyOf": [
            {
              "enum": [
                "Conversational",
                "Professional",
                "Casual",
                "Formal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Toneprofile",
          "enum": [
            "Conversational",
            "Professional",
            "Casual",
            "Formal"
          ],
          "x-enum-searchable": true
        },
        "customTone": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customtone"
        },
        "customInstructions": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custominstructions"
        },
        "isDefault": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only true is accepted to select the organization's default brand.",
          "title": "Isdefault"
        },
        "operation": {
          "const": "update_brand_identity",
          "default": "update_brand_identity",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "brand_identity_id"
      ],
      "title": "NotraUpdateBrandIdentityConfig",
      "type": "object"
    },
    "NotraUpdatePostConfig": {
      "additionalProperties": false,
      "properties": {
        "post_id": {
          "title": "Post Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "slug": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slug"
        },
        "markdown": {
          "anyOf": [
            {
              "maxLength": 100000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "draft",
                "published"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "draft",
            "published"
          ],
          "x-enum-searchable": true
        },
        "operation": {
          "const": "update_post",
          "default": "update_post",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "post_id"
      ],
      "title": "NotraUpdatePostConfig",
      "type": "object"
    }
