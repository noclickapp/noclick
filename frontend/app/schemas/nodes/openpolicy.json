{
  "$defs": {
    "CompileQuery": {
      "additionalProperties": false,
      "description": "Partially evaluate a query with specified unknowns.",
      "properties": {
        "metrics": {
          "default": false,
          "description": "Include evaluation performance metrics.",
          "title": "Metrics",
          "type": "boolean"
        },
        "operation": {
          "const": "compile_query",
          "default": "compile_query",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input"
        },
        "unknowns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unknown references, for example [data.reports].",
          "title": "Unknowns"
        }
      },
      "required": [
        "query"
      ],
      "title": "CompileQuery",
      "type": "object"
    },
    "DeleteDocument": {
      "additionalProperties": false,
      "description": "Delete base data at a document path.",
      "properties": {
        "path": {
          "description": "Slash-separated document path without a leading slash, for example opa/examples/allow_request.",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "operation": {
          "const": "delete_document",
          "default": "delete_document",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "DeleteDocument",
      "type": "object"
    },
    "DeletePolicy": {
      "additionalProperties": false,
      "description": "Delete a loaded policy module.",
      "properties": {
        "policy_id": {
          "description": "Policy module identifier, for example authz.rego.",
          "maxLength": 1024,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "operation": {
          "const": "delete_policy",
          "default": "delete_policy",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "policy_id"
      ],
      "title": "DeletePolicy",
      "type": "object"
    },
    "EvaluateDocument": {
      "additionalProperties": false,
      "description": "Evaluate a decision with input wrapped in the v1 input envelope.",
      "properties": {
        "metrics": {
          "default": false,
          "description": "Include evaluation performance metrics.",
          "title": "Metrics",
          "type": "boolean"
        },
        "path": {
          "description": "Slash-separated document path without a leading slash, for example opa/examples/allow_request.",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "operation": {
          "const": "evaluate_document",
          "default": "evaluate_document",
          "title": "Operation",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "description": "Decision input; NoClick wraps this as {input: ...}.",
          "title": "Input",
          "type": "object"
        },
        "provenance": {
          "default": false,
          "title": "Provenance",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "input"
      ],
      "title": "EvaluateDocument",
      "type": "object"
    },
    "EvaluateWebhookDocument": {
      "additionalProperties": false,
      "description": "Evaluate the v0 decision endpoint with an unwrapped input document.",
      "properties": {
        "path": {
          "description": "Slash-separated document path without a leading slash, for example opa/examples/allow_request.",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "operation": {
          "const": "evaluate_webhook_document",
          "default": "evaluate_webhook_document",
          "title": "Operation",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "description": "Raw input document sent directly to the v0 decision endpoint.",
          "title": "Input",
          "type": "object"
        }
      },
      "required": [
        "path",
        "input"
      ],
      "title": "EvaluateWebhookDocument",
      "type": "object"
    },
    "GetConfig": {
      "additionalProperties": false,
      "description": "Read the active instance configuration (OPA masks private keys).",
      "properties": {
        "operation": {
          "const": "get_config",
          "default": "get_config",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetConfig",
      "type": "object"
    },
    "GetDocument": {
      "additionalProperties": false,
      "description": "Read a base or virtual document without input.",
      "properties": {
        "metrics": {
          "default": false,
          "description": "Include evaluation performance metrics.",
          "title": "Metrics",
          "type": "boolean"
        },
        "path": {
          "description": "Slash-separated document path without a leading slash, for example opa/examples/allow_request.",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "operation": {
          "const": "get_document",
          "default": "get_document",
          "title": "Operation",
          "type": "string"
        },
        "provenance": {
          "default": false,
          "title": "Provenance",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "title": "GetDocument",
      "type": "object"
    },
    "GetHealth": {
      "additionalProperties": false,
      "description": "Read OPA health, optionally checking bundles and plugins.",
      "properties": {
        "operation": {
          "const": "get_health",
          "default": "get_health",
          "title": "Operation",
          "type": "string"
        },
        "bundles": {
          "default": false,
          "title": "Bundles",
          "type": "boolean"
        },
        "plugins": {
          "default": false,
          "title": "Plugins",
          "type": "boolean"
        }
      },
      "title": "GetHealth",
      "type": "object"
    },
    "GetPolicy": {
      "additionalProperties": false,
      "description": "Read a policy module and its AST.",
      "properties": {
        "policy_id": {
          "description": "Policy module identifier, for example authz.rego.",
          "maxLength": 1024,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "operation": {
          "const": "get_policy",
          "default": "get_policy",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "policy_id"
      ],
      "title": "GetPolicy",
      "type": "object"
    },
    "GetQuery": {
      "additionalProperties": false,
      "description": "Execute an ad hoc Rego query using GET.",
      "properties": {
        "metrics": {
          "default": false,
          "description": "Include evaluation performance metrics.",
          "title": "Metrics",
          "type": "boolean"
        },
        "operation": {
          "const": "get_query",
          "default": "get_query",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "description": "Rego query, for example data.servers[i].name = name.",
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "GetQuery",
      "type": "object"
    },
    "JSONPatch": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "add",
            "remove",
            "replace",
            "move",
            "copy",
            "test"
          ],
          "title": "Op",
          "type": "string"
        },
        "path": {
          "description": "JSON pointer relative to the API document path.",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source JSON pointer for move or copy.",
          "title": "From"
        }
      },
      "required": [
        "op",
        "path"
      ],
      "title": "JSONPatch",
      "type": "object"
    },
    "ListPolicies": {
      "additionalProperties": false,
      "description": "List all loaded policy modules (also the connection proof).",
      "properties": {
        "operation": {
          "const": "list_policies",
          "default": "list_policies",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListPolicies",
      "type": "object"
    },
    "OpenPolicyTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "openpolicy_token",
          "default": "openpolicy_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "base_url": {
          "description": "Exact HTTPS origin, including the port if needed; for example https://opa.example.com:8181.",
          "title": "Instance URL",
          "type": "string"
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Bearer token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "base_url",
        "api_token"
      ],
      "title": "Open Policy Agent Token",
      "type": "object",
      "x-credential-instructions": "Enter your OPA instance's HTTPS origin and paste a bearer token accepted by its authorization policy. The instance must enable --authentication=token and authorize the APIs you use. NoClick lists loaded policies to check the connection; OPA has no user profile API.",
      "x-credential-url": "https://www.openpolicyagent.org/docs/security#authentication-and-authorization"
    },
    "PatchDocument": {
      "additionalProperties": false,
      "description": "Apply an atomic JSON Patch to base data.",
      "properties": {
        "path": {
          "description": "Slash-separated document path without a leading slash, for example opa/examples/allow_request.",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "operation": {
          "const": "patch_document",
          "default": "patch_document",
          "title": "Operation",
          "type": "string"
        },
        "patches": {
          "items": {
            "$ref": "#/$defs/JSONPatch"
          },
          "minItems": 1,
          "title": "Patches",
          "type": "array"
        }
      },
      "required": [
        "path",
        "patches"
      ],
      "title": "PatchDocument",
      "type": "object"
    },
    "PostQuery": {
      "additionalProperties": false,
      "description": "Execute a complex ad hoc Rego query using POST.",
      "properties": {
        "metrics": {
          "default": false,
          "description": "Include evaluation performance metrics.",
          "title": "Metrics",
          "type": "boolean"
        },
        "operation": {
          "const": "post_query",
          "default": "post_query",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "PostQuery",
      "type": "object"
    },
    "PutDocument": {
      "additionalProperties": false,
      "description": "Create or replace base data at a document path.",
      "properties": {
        "path": {
          "description": "Slash-separated document path without a leading slash, for example opa/examples/allow_request.",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "operation": {
          "const": "put_document",
          "default": "put_document",
          "title": "Operation",
          "type": "string"
        },
        "document": {
          "description": "JSON document to store, including objects, arrays and scalar values.",
          "title": "Document"
        },
        "create_only": {
          "default": false,
          "description": "Send If-None-Match: * to prevent overwriting existing data.",
          "title": "Create Only",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "document"
      ],
      "title": "PutDocument",
      "type": "object"
    },
    "PutPolicy": {
      "additionalProperties": false,
      "description": "Create or replace a Rego policy module.",
      "properties": {
        "metrics": {
          "default": false,
          "description": "Include evaluation performance metrics.",
          "title": "Metrics",
          "type": "boolean"
        },
        "policy_id": {
          "description": "Policy module identifier, for example authz.rego.",
          "maxLength": 1024,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "operation": {
          "const": "put_policy",
          "default": "put_policy",
          "title": "Operation",
          "type": "string"
        },
        "policy": {
          "description": "Complete Rego source supported by your OPA instance.",
          "minLength": 1,
          "title": "Policy",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "rego"
        }
      },
      "required": [
        "policy_id",
        "policy"
      ],
      "title": "PutPolicy",
      "type": "object"
    },
    "SimpleQuery": {
      "additionalProperties": false,
      "description": "Evaluate the instance's default decision using a raw input object.",
      "properties": {
        "operation": {
          "const": "simple_query",
          "default": "simple_query",
          "title": "Operation",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "description": "Input object for the configured default decision.",
          "title": "Input",
          "type": "object"
        }
      },
      "required": [
        "input"
      ],
      "title": "SimpleQuery",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "compile_query": "#/$defs/CompileQuery",
          "delete_document": "#/$defs/DeleteDocument",
          "delete_policy": "#/$defs/DeletePolicy",
          "evaluate_document": "#/$defs/EvaluateDocument",
          "evaluate_webhook_document": "#/$defs/EvaluateWebhookDocument",
          "get_config": "#/$defs/GetConfig",
          "get_document": "#/$defs/GetDocument",
          "get_health": "#/$defs/GetHealth",
          "get_policy": "#/$defs/GetPolicy",
          "get_query": "#/$defs/GetQuery",
          "list_policies": "#/$defs/ListPolicies",
          "patch_document": "#/$defs/PatchDocument",
          "post_query": "#/$defs/PostQuery",
          "put_document": "#/$defs/PutDocument",
          "put_policy": "#/$defs/PutPolicy",
          "simple_query": "#/$defs/SimpleQuery"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListPolicies"
        },
        {
          "$ref": "#/$defs/GetPolicy"
        },
        {
          "$ref": "#/$defs/PutPolicy"
        },
        {
          "$ref": "#/$defs/DeletePolicy"
        },
        {
          "$ref": "#/$defs/GetDocument"
        },
        {
          "$ref": "#/$defs/EvaluateDocument"
        },
        {
          "$ref": "#/$defs/EvaluateWebhookDocument"
        },
        {
          "$ref": "#/$defs/PutDocument"
        },
        {
          "$ref": "#/$defs/PatchDocument"
        },
        {
          "$ref": "#/$defs/DeleteDocument"
        },
        {
          "$ref": "#/$defs/SimpleQuery"
        },
        {
          "$ref": "#/$defs/GetQuery"
        },
        {
          "$ref": "#/$defs/PostQuery"
        },
        {
          "$ref": "#/$defs/CompileQuery"
        },
        {
          "$ref": "#/$defs/GetHealth"
        },
        {
          "$ref": "#/$defs/GetConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/OpenPolicyTokenCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Openpolicy Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
