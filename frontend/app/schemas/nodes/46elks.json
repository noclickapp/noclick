{
  "$defs": {
    "Elks46AllocateNumberConfig": {
      "description": "Allocate new number for usage in the API.",
      "properties": {
        "operation": {
          "const": "allocate_number",
          "default": "allocate_number",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Allocate Number"
        },
        "country": {
          "description": "country",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Country",
          "type": "string"
        },
        "capabilities": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SMS, MMS, Voice",
          "title": "Capabilities"
        },
        "sms_url": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Url where to send incomming sms. Set to \"none\" to clear.",
          "title": "Sms Url"
        },
        "mms_url": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Url where to send incomming MMS. Set to \"none\" to clear.",
          "title": "Mms Url"
        },
        "voice_start": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Url / JSON where to send incomming calls. Set to \"none\" to clear.",
          "title": "Voice Start"
        },
        "sms_replies": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prevent automatic response from callback server.",
          "title": "Sms Replies",
          "enum": [
            "yes",
            "no"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "country"
      ],
      "title": "Elks46AllocateNumberConfig",
      "type": "object"
    },
