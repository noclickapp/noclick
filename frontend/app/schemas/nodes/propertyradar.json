{
  "$defs": {
    "AddItems": {
      "additionalProperties": false,
      "description": "Add properties matching criteria to a static list; use RadarID criteria for selected IDs.",
      "properties": {
        "list_id": {
          "description": "PropertyRadar ListID.",
          "exclusiveMinimum": 0,
          "title": "List Id",
          "type": "integer"
        },
        "operation": {
          "const": "add_items",
          "default": "add_items",
          "title": "Operation",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        }
      },
      "required": [
        "list_id",
        "criteria"
      ],
      "title": "AddItems",
      "type": "object"
    },
    "CreateList": {
      "additionalProperties": false,
      "description": "Create a static list or a dynamic list with criteria.",
      "properties": {
        "operation": {
          "const": "create_list",
          "default": "create_list",
          "title": "Operation",
          "type": "string"
        },
        "list_name": {
          "maxLength": 50,
          "minLength": 1,
          "title": "List Name",
          "type": "string"
        },
        "list_type": {
          "default": "static",
          "enum": [
            "static",
            "dynamic"
          ],
          "title": "List Type",
          "type": "string"
        },
        "criteria": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Criterion"
              },
              "maxItems": 500,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Criteria"
        },
        "group_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Name"
        },
        "is_monitored": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "Is Monitored",
          "type": "integer"
        }
      },
      "required": [
        "list_name"
      ],
      "title": "CreateList",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "A documented PropertyRadar criterion, such as State, ZipFive or RadarID.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "description": "Criterion value in the provider's Criteria format. See https://developers.propertyradar.com/criteria",
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "DeleteList": {
