{
  "$defs": {
    "AddLeads": {
      "properties": {
        "operation": {
          "const": "add_leads",
          "default": "add_leads",
          "title": "Add Saved Leads",
          "type": "string"
        },
        "leads": {
          "description": "Email records to add to your Minelead leads.",
          "items": {
            "$ref": "#/$defs/LeadInput"
          },
          "minItems": 1,
          "title": "Leads",
          "type": "array"
        }
      },
      "required": [
        "leads"
      ],
      "title": "AddLeads",
      "type": "object"
    },
    "CreateRecipients": {
      "properties": {
        "operation": {
          "const": "create_recipients",
          "default": "create_recipients",
          "title": "Create Recipient List",
          "type": "string"
        },
        "list_name": {
          "minLength": 1,
          "title": "List Name",
          "type": "string"
        },
        "emails": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Emails",
          "type": "array"
        }
      },
      "required": [
        "list_name",
        "emails"
      ],
      "title": "CreateRecipients",
      "type": "object"
    },
    "DeleteLeads": {
      "properties": {
        "operation": {
          "const": "delete_leads",
          "default": "delete_leads",
          "title": "Delete Saved Leads",
          "type": "string"
        },
        "email": {
          "description": "Emails to remove from saved leads; does not delete contacts elsewhere.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Emails",
          "type": "array"
        }
      },
      "required": [
        "email"
      ],
      "title": "DeleteLeads",
      "type": "object"
    },
    "DetectDisposable": {
      "properties": {
        "operation": {
          "const": "detect_disposable",
          "default": "detect_disposable",
          "title": "Detect Disposable Email",
          "type": "string"
        },
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "DetectDisposable",
      "type": "object"
    },
    "EditRecipients": {
      "properties": {
        "operation": {
          "const": "edit_recipients",
          "default": "edit_recipients",
          "title": "Edit Recipient List",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Recipient List ID",
          "type": "integer"
        },
        "action": {
          "description": "Add or remove the specified emails from this list.",
          "enum": [
            "add",
            "remove"
          ],
          "title": "Action",
          "type": "string"
        },
        "emails": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Emails",
          "type": "array"
        }
      },
      "required": [
        "id",
        "action",
        "emails"
      ],
      "title": "EditRecipients",
      "type": "object"
    },
    "EnrichEmail": {
      "properties": {
        "operation": {
          "const": "enrich_email",
          "default": "enrich_email",
          "title": "Enrich Email",
          "type": "string"
        },
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Full Name"
        },
        "company": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company Name or Domain"
        }
      },
      "required": [
        "email"
      ],
      "title": "EnrichEmail",
      "type": "object"
    },
    "FindEmail": {
      "properties": {
        "operation": {
          "const": "find_email",
          "default": "find_email",
          "title": "Find Person's Email",
          "type": "string"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "firstname": {
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        },
        "lastname": {
          "minLength": 1,
          "title": "Last Name",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "firstname",
        "lastname"
      ],
      "title": "FindEmail",
      "type": "object"
    },
    "FindSocialEmails": {
      "properties": {
        "operation": {
          "const": "find_social_emails",
          "default": "find_social_emails",
          "title": "Find Social Profile Emails",
          "type": "string"
        },
        "url": {
          "description": "YouTube channel or Twitter/X profile URL.",
          "minLength": 1,
          "title": "Profile URL",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "FindSocialEmails",
      "type": "object"
    },
    "GenerateLeads": {
      "properties": {
        "operation": {
          "const": "generate_leads",
          "default": "generate_leads",
          "title": "Generate Leads from Tags",
          "type": "string"
        },
        "tags": {
          "description": "Location and industry tags, for example new york and hotel.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "tags"
      ],
      "title": "GenerateLeads",
      "type": "object"
    },
    "GetAccount": {
      "properties": {
        "operation": {
          "const": "get_account",
          "default": "get_account",
          "description": "Read the account identity and subscription; the returned API key is omitted.",
          "title": "Get Account",
          "type": "string"
        }
      },
      "title": "GetAccount",
      "type": "object"
    },
    "GetBuyingIntent": {
      "properties": {
        "operation": {
          "const": "get_buying_intent",
          "default": "get_buying_intent",
          "title": "Get Buying Intent",
          "type": "string"
        },
        "company": {
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "refresh": {
          "anyOf": [
            {
              "const": "true",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Skip the seven-day cache; a fresh analysis costs credits.",
          "title": "Refresh"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                1,
                2
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1: news only; 2: website/LinkedIn only. Omit for both.",
          "title": "Level"
        }
      },
      "required": [
        "company",
        "domain"
      ],
      "title": "GetBuyingIntent",
      "type": "object"
    },
    "LeadInput": {
      "properties": {
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "LeadInput",
      "type": "object"
    },
    "ListCampaigns": {
      "properties": {
        "operation": {
          "const": "list_campaigns",
          "default": "list_campaigns",
          "title": "List Campaigns",
          "type": "string"
        }
      },
      "title": "ListCampaigns",
      "type": "object"
    },
    "ListHistory": {
      "properties": {
        "operation": {
          "const": "list_history",
          "default": "list_history",
          "title": "List Search History",
          "type": "string"
        },
        "start": {
          "default": 0,
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "limit": {
          "default": 7,
          "description": "One page is returned. Increase start to retrieve the next page.",
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "title": "ListHistory",
      "type": "object"
    },
    "ListLeads": {
      "properties": {
        "operation": {
          "const": "list_leads",
          "default": "list_leads",
          "title": "List Saved Leads",
          "type": "string"
        }
      },
      "title": "ListLeads",
      "type": "object"
    },
    "ListRecipients": {
      "properties": {
        "operation": {
          "const": "list_recipients",
          "default": "list_recipients",
          "title": "List Recipient Lists",
          "type": "string"
        }
      },
      "title": "ListRecipients",
      "type": "object"
    },
    "MineleadAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "minelead_api_key",
          "default": "minelead_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Paste your Minelead API key.",
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Minelead API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from your Minelead account. Research operations consume your Minelead credits.",
      "x-credential-url": "https://minelead.io/docs/"
    },
    "SearchEmails": {
      "properties": {
        "operation": {
          "const": "search_emails",
          "default": "search_emails",
          "title": "Search Company Emails",
          "type": "string"
        },
        "domain": {
          "description": "Company domain, for example example.com.",
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company Name"
        },
        "max_emails": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Emails"
        },
        "generic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return only generic addresses.",
          "title": "Generic"
        },
        "light_mode": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return only previously found emails.",
          "title": "Light Mode"
        },
        "enrich": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Include professional profile data; consumes credits.",
          "title": "Enrich"
        },
        "deep": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Discover employee emails with AI; costs 5 credits plus 2 per verified email.",
          "title": "Deep"
        },
        "max_deep_results": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Deep Search Results"
        }
      },
      "required": [
        "domain"
      ],
      "title": "SearchEmails",
      "type": "object"
    },
    "ValidateEmail": {
      "properties": {
        "operation": {
          "const": "validate_email",
          "default": "validate_email",
          "title": "Verify Email",
          "type": "string"
        },
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        },
        "firstname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "lastname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        }
      },
      "required": [
        "email"
      ],
      "title": "ValidateEmail",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "add_leads": "#/$defs/AddLeads",
          "create_recipients": "#/$defs/CreateRecipients",
          "delete_leads": "#/$defs/DeleteLeads",
          "detect_disposable": "#/$defs/DetectDisposable",
          "edit_recipients": "#/$defs/EditRecipients",
          "enrich_email": "#/$defs/EnrichEmail",
          "find_email": "#/$defs/FindEmail",
          "find_social_emails": "#/$defs/FindSocialEmails",
          "generate_leads": "#/$defs/GenerateLeads",
          "get_account": "#/$defs/GetAccount",
          "get_buying_intent": "#/$defs/GetBuyingIntent",
          "list_campaigns": "#/$defs/ListCampaigns",
          "list_history": "#/$defs/ListHistory",
          "list_leads": "#/$defs/ListLeads",
          "list_recipients": "#/$defs/ListRecipients",
          "search_emails": "#/$defs/SearchEmails",
          "validate_email": "#/$defs/ValidateEmail"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SearchEmails"
        },
        {
          "$ref": "#/$defs/EnrichEmail"
        },
        {
          "$ref": "#/$defs/GetBuyingIntent"
        },
        {
          "$ref": "#/$defs/ValidateEmail"
        },
        {
          "$ref": "#/$defs/DetectDisposable"
        },
        {
          "$ref": "#/$defs/FindEmail"
        },
        {
          "$ref": "#/$defs/FindSocialEmails"
        },
        {
          "$ref": "#/$defs/GenerateLeads"
        },
        {
          "$ref": "#/$defs/ListLeads"
        },
        {
          "$ref": "#/$defs/AddLeads"
        },
        {
          "$ref": "#/$defs/DeleteLeads"
        },
        {
          "$ref": "#/$defs/ListHistory"
        },
        {
          "$ref": "#/$defs/ListCampaigns"
        },
        {
          "$ref": "#/$defs/ListRecipients"
        },
        {
          "$ref": "#/$defs/CreateRecipients"
        },
        {
          "$ref": "#/$defs/EditRecipients"
        },
        {
          "$ref": "#/$defs/GetAccount"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MineleadAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Minelead Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
