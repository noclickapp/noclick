        "access_id": {
          "description": "UUID from Voluum Settings \u2192 Security \u2192 Access keys",
          "title": "Access ID",
          "type": "string"
        },
        "access_key": {
          "description": "Access key for the same Voluum user",
          "title": "Access Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "access_id",
        "access_key"
      ],
