            "depends_on": "workspace_id",
            "field_name": "campaign_id",
            "placeholder": "Select campaign",
            "searchable": true
          }
        },
        "from_time": {
          "description": "ISO timestamp on an hour boundary",
          "title": "From (inclusive)",
          "type": "string"
        },
        "to_time": {
          "description": "ISO timestamp on an hour boundary; range <=31 days",
          "title": "To (exclusive)",
          "type": "string"
        },
        "group_by": {
          "default": "campaignId",
          "enum": [
            "campaignId",
            "offerId",
            "landerId",
            "trafficSourceId",
            "day"
          ],
          "title": "Group by",
          "type": "string"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Reporting currency",
          "type": "string"
        },
        "conversion_time_mode": {
          "default": "VISIT",
          "enum": [
            "VISIT",
            "CONVERSION"
          ],
          "title": "Conversion attribution time",
          "type": "string"
        },
        "include": {
          "default": "TRAFFIC",
          "enum": [
            "TRAFFIC",
            "ACTIVE",
            "ARCHIVED",
            "ALL"
          ],
          "title": "Include",
          "type": "string"
        },
        "limit": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Page size",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation"
        }
      },
