{
  "$defs": {
    "KeilaAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "keila_api_key",
          "default": "keila_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "title": "Existing Keila Private API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "instance_origin": {
          "description": "One public HTTPS origin, such as Keila Cloud or an existing self-hosted instance. No API path. Self-hosted version parity is unverified.",
          "title": "Keila Instance Origin",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "instance_origin"
      ],
      "title": "KeilaAPIKeyCredential",
      "type": "object",
      "x-credential-instructions": "Supply an existing private API key. Bearer HEADER only on one public HTTPS instance and fixed /api/v1. Catalog resources are project-context access witnesses, not actor/project/account ownership. No OAuth, key mint, refresh, signup, host/version fallback or account identity endpoint.",
      "x-credential-url": "https://www.keila.io/docs/api/authentication/"
    },
    "KeilaCampaignConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_campaign",
          "default": "get_campaign",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Campaigns",
          "x-display-name": "Read Selected Campaign Metadata",
          "x-is-trigger": false
        },
        "campaign_id": {
          "description": "Must appear in the current default campaign catalog page; subjects and message content are never included.",
          "title": "Campaign",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "campaign_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-id-path": "campaign_id",
          "x-resource-type": "keila_campaign"
        }
      },
      "required": [
        "campaign_id"
      ],
      "title": "KeilaCampaignConfig",
      "type": "object"
    },
    "KeilaCampaignsConfig": {
      "additionalProperties": false,
      "properties": {
        "output_limit": {
          "default": 100,
          "description": "Local output cap only; never a provider query argument. The default provider page size is undocumented.",
          "maximum": 100,
          "minimum": 1,
          "title": "Output Limit",
          "type": "integer"
        },
        "operation": {
          "const": "list_campaigns",
          "default": "list_campaigns",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Campaigns",
          "x-display-name": "List Campaign Metadata",
          "x-is-trigger": false
        }
      },
      "title": "KeilaCampaignsConfig",
      "type": "object"
    },
    "KeilaCheckConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "test_connection",
          "default": "test_connection",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Connection",
          "x-display-name": "Check Protected Campaign Catalog",
          "x-is-trigger": false
        }
      },
      "title": "KeilaCheckConfig",
      "type": "object"
    },
    "KeilaTemplateConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_template",
          "default": "get_template",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Templates",
          "x-display-name": "Read Selected Template Metadata",
          "x-is-trigger": false
        },
        "template_id": {
          "description": "Independent current template-catalog selection; no campaign parent is inferred.",
          "title": "Template",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "template_id",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-id-path": "template_id",
          "x-resource-type": "keila_template"
        },
        "include_names": {
          "default": false,
          "description": "Opt in to template.name only; no template rendering or content output.",
          "title": "Include Names",
          "type": "boolean"
        }
      },
      "required": [
        "template_id"
      ],
      "title": "KeilaTemplateConfig",
      "type": "object"
    },
    "KeilaTemplatesConfig": {
      "additionalProperties": false,
      "properties": {
        "output_limit": {
          "default": 100,
          "description": "Local output cap only; never a provider query argument. The default provider page size is undocumented.",
          "maximum": 100,
          "minimum": 1,
          "title": "Output Limit",
          "type": "integer"
        },
        "operation": {
          "const": "list_templates",
          "default": "list_templates",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Templates",
          "x-display-name": "List Template Metadata",
          "x-is-trigger": false
        },
        "include_names": {
          "default": false,
          "description": "Opt in to template.name only. All bodies, assigns, content slots and styles remain omitted.",
          "title": "Include Names",
          "type": "boolean"
        }
      },
      "title": "KeilaTemplatesConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_campaign": "#/$defs/KeilaCampaignConfig",
          "get_template": "#/$defs/KeilaTemplateConfig",
          "list_campaigns": "#/$defs/KeilaCampaignsConfig",
          "list_templates": "#/$defs/KeilaTemplatesConfig",
          "test_connection": "#/$defs/KeilaCheckConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/KeilaCheckConfig"
        },
        {
          "$ref": "#/$defs/KeilaCampaignsConfig"
        },
        {
          "$ref": "#/$defs/KeilaCampaignConfig"
        },
        {
          "$ref": "#/$defs/KeilaTemplatesConfig"
        },
        {
          "$ref": "#/$defs/KeilaTemplateConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/KeilaAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Keila Node Configuration",
  "type": "object",
  "x-edit-examples": [
    "List campaign IDs and resource times without newsletter content",
    "Read a current selected campaign's documented format",
    "List template IDs/types or explicitly opt into template names"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
