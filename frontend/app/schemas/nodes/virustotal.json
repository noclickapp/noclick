    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
