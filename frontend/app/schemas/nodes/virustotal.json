            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_ioc_notification",
          "default": "on_new_ioc_notification",
          "title": "Operation",
          "type": "string",
          "x-category": "Triggers",
          "x-display-name": "New IoC Notification",
