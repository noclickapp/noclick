{
  "$defs": {
    "DataboxAPIKey": {
      "properties": {
        "credential_type": {
          "const": "databox_api_key",
          "default": "databox_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Databox API Key",
      "type": "object",
      "x-credential-instructions": "Create an API key in Account Management > Profile > Password & Security (admin access required), then paste it here. NoClick sends it in the x-api-key header to api.databox.com and verifies it by reading your profile. Use a key with access to the resources your workflow needs.",
      "x-credential-url": "https://developers.databox.com/docs/api/authentication"
    },
    "DataboxCreateDataset": {
      "description": "Create dataset.",
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional managed account to act on; omit to use the API key's organization.",
          "title": "Account ID"
        },
        "operation": {
          "const": "create_dataset",
          "default": "create_dataset",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "data_source_id": {
          "title": "Data Source Id",
          "type": "integer"
        },
        "columns": {
          "description": "Column definitions for the dataset schema.",
          "items": {
            "$ref": "#/$defs/DatasetColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "primary_key": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Key"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[ -~]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        }
      },
      "required": [
        "name",
        "data_source_id",
        "columns"
      ],
      "title": "DataboxCreateDataset",
      "type": "object"
    },
