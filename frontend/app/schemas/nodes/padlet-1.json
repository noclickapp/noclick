          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_organization_user",
          "default": "on_new_organization_user",
          "title": "On New Organization User",
          "type": "string",
          "x-category": "Triggers",
          "x-display-name": "On New Organization User",
          "x-is-trigger": true
        },
        "org_id": {
          "description": "Organization whose recent Padlet signups to watch. Requires organization analytics access.",
          "maxLength": 22,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Org Id",
          "type": "string"
        },
        "limit": {
          "default": 25,
          "description": "Watch the first page ordered by Padlet account signup date, newest first. The first poll establishes a baseline. Signup date is account creation, not organization join time: existing accounts joining can fall outside this window. More than this many new signups between polls can be missed. One request per poll stays within the documented 60 requests/hour limit with the default five-minute schedule.",
          "maximum": 100,
          "minimum": 1,
          "title": "Recent signup window",
          "type": "integer"
        }
      },
      "required": [
        "org_id"
      ],
      "title": "OnNewOrganizationUser",
      "type": "object",
      "x-requires-webhook": true
    },
