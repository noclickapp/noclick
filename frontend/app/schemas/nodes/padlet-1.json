              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "user_type": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "admin",
                  "maker",
                  "teacher",
                  "student",
                  "contributor",
                  "guest"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Type"
        },
        "q": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q"
        },
        "sort": {
          "default": "name",
          "enum": [
            "name",
            "email",
            "userType",
            "signupDate",
            "lastActivityDate",
