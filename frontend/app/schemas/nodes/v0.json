        "name": {
          "title": "Name",
          "type": "string"
        },
        "events": {
          "items": {
            "enum": [
              "chat.created",
              "chat.updated",
              "chat.deleted",
              "message.created",
              "message.updated",
              "message.deleted",
              "message.finished"
