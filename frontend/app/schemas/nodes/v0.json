        "operation": {
          "const": "create_chat",
          "default": "create_chat",
          "title": "Operation",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "privacy": {
          "default": "private",
          "enum": [
            "public",
            "private",
            "team",
            "team-edit",
            "unlisted"
          ],
          "title": "Privacy",
          "type": "string"
        },
        "system_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Prompt"
        },
        "model_configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelConfiguration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata"
        }
      },
      "required": [
        "message"
      ],
      "title": "CreateChat",
      "type": "object"
    },
    "CreateWebhook": {
      "additionalProperties": false,
      "description": "Register a webhook for V0 chat and message lifecycle events.",
