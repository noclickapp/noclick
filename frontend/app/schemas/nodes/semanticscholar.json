{
  "$defs": {
    "AutocompletePapers": {
      "additionalProperties": false,
      "description": "Suggest paper completions for a partial query.",
      "properties": {
        "operation": {
          "const": "autocomplete_papers",
          "default": "autocomplete_papers",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "AutocompletePapers",
      "type": "object"
    },
    "BatchGetAuthors": {
      "additionalProperties": false,
      "description": "Retrieve up to 1000 author profiles in one POST read.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated response fields, for example title,year,authors. Omit for provider defaults.",
          "title": "Fields"
        },
        "operation": {
          "const": "batch_get_authors",
          "default": "batch_get_authors",
          "title": "Operation",
          "type": "string"
        },
        "ids": {
          "description": "Numeric author IDs in request order.",
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        }
      },
      "required": [
        "ids"
      ],
      "title": "BatchGetAuthors",
      "type": "object"
    },
    "BatchGetPapers": {
      "additionalProperties": false,
      "description": "Retrieve up to 500 papers in one POST read; missing papers may be null.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated response fields, for example title,year,authors. Omit for provider defaults.",
          "title": "Fields"
        },
        "operation": {
          "const": "batch_get_papers",
          "default": "batch_get_papers",
          "title": "Operation",
          "type": "string"
        },
        "ids": {
          "description": "Paper IDs in request order.",
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        }
      },
      "required": [
        "ids"
      ],
      "title": "BatchGetPapers",
      "type": "object"
    },
    "GetAuthor": {
      "additionalProperties": false,
      "description": "Retrieve an author's profile and requested research metrics.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated response fields, for example title,year,authors. Omit for provider defaults.",
          "title": "Fields"
        },
        "operation": {
          "const": "get_author",
          "default": "get_author",
          "title": "Operation",
          "type": "string"
        },
        "author_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[0-9]+$",
          "title": "Author Id",
          "type": "string"
        }
      },
      "required": [
        "author_id"
      ],
      "title": "GetAuthor",
      "type": "object"
    },
    "GetAuthorPapers": {
      "additionalProperties": false,
      "description": "Retrieve one page of an author's papers.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated response fields, for example title,year,authors. Omit for provider defaults.",
          "title": "Fields"
        },
        "offset": {
          "default": 0,
          "description": "Start offset; copy the next value returned by the previous page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "description": "Maximum number of results on this page.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "operation": {
          "const": "get_author_papers",
          "default": "get_author_papers",
          "title": "Operation",
          "type": "string"
        },
        "author_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[0-9]+$",
          "title": "Author Id",
          "type": "string"
        },
        "publicationDateOrYear": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication date or year"
        }
      },
      "required": [
        "author_id"
      ],
      "title": "GetAuthorPapers",
      "type": "object"
    },
    "GetPaper": {
      "additionalProperties": false,
      "description": "Retrieve a paper by Semantic Scholar ID, DOI, arXiv ID or other supported ID.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated response fields, for example title,year,authors. Omit for provider defaults.",
          "title": "Fields"
        },
        "operation": {
          "const": "get_paper",
          "default": "get_paper",
          "title": "Operation",
          "type": "string"
        },
        "paper_id": {
          "description": "Paper ID, for example 649def34f8be52c8b66281af98ae884c09aef38b, DOI:10.1038/nrn3241 or ARXIV:2106.15928.",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        }
      },
      "required": [
        "paper_id"
      ],
      "title": "GetPaper",
      "type": "object"
    },
    "GetPaperAuthors": {
      "additionalProperties": false,
      "description": "Retrieve one page of a paper's authors.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated response fields, for example title,year,authors. Omit for provider defaults.",
          "title": "Fields"
        },
        "offset": {
          "default": 0,
          "description": "Start offset; copy the next value returned by the previous page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "description": "Maximum number of results on this page.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "operation": {
          "const": "get_paper_authors",
          "default": "get_paper_authors",
          "title": "Operation",
          "type": "string"
        },
        "paper_id": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        }
      },
      "required": [
        "paper_id"
      ],
      "title": "GetPaperAuthors",
      "type": "object"
    },
    "GetPaperCitations": {
      "additionalProperties": false,
      "description": "Retrieve one page of papers citing this paper.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated response fields, for example title,year,authors. Omit for provider defaults.",
          "title": "Fields"
        },
        "offset": {
          "default": 0,
          "description": "Start offset; copy the next value returned by the previous page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "description": "Maximum number of results on this page.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "operation": {
          "const": "get_paper_citations",
          "default": "get_paper_citations",
          "title": "Operation",
          "type": "string"
        },
        "paper_id": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        },
        "publicationDateOrYear": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication date or year"
        }
      },
      "required": [
        "paper_id"
      ],
      "title": "GetPaperCitations",
      "type": "object"
    },
    "GetPaperReferences": {
      "additionalProperties": false,
      "description": "Retrieve one page of papers referenced by this paper.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated response fields, for example title,year,authors. Omit for provider defaults.",
          "title": "Fields"
        },
        "offset": {
          "default": 0,
          "description": "Start offset; copy the next value returned by the previous page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "description": "Maximum number of results on this page.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "operation": {
          "const": "get_paper_references",
          "default": "get_paper_references",
          "title": "Operation",
          "type": "string"
        },
        "paper_id": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        }
      },
      "required": [
        "paper_id"
      ],
      "title": "GetPaperReferences",
      "type": "object"
    },
    "MatchPaper": {
      "additionalProperties": false,
      "description": "Find the best paper title match.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated response fields, for example title,year,authors. Omit for provider defaults.",
          "title": "Fields"
        },
        "publicationTypes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated publication types, such as Review,JournalArticle.",
          "title": "Publication types"
        },
        "openAccessPdf": {
          "default": false,
          "title": "Only papers with a public PDF",
          "type": "boolean"
        },
        "minCitationCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum citation count"
        },
        "publicationDateOrYear": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive date range, for example 2019:2020 or 2019-03-05:2020-06-06.",
          "title": "Publication date or year"
        },
        "year": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Year or range, for example 2019, 2016-2020 or 2010-.",
          "title": "Year"
        },
        "venue": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated publication venues.",
          "title": "Venue"
        },
        "fieldsOfStudy": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated fields, for example Computer Science,Medicine.",
          "title": "Fields of study"
        },
        "operation": {
          "const": "match_paper",
          "default": "match_paper",
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "MatchPaper",
      "type": "object"
    },
    "OnNewMatchingPaper": {
      "additionalProperties": false,
      "description": "Watch the newest 1,000 matching papers by publication date.\n\nExisting matches form the baseline when armed. New IDs in this window fire\nafterwards; use a focused query/filter and poll often enough to avoid gaps.\nThis detects newly observed papers, not edits or all newly indexed papers.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated response fields, for example title,year,authors. Omit for provider defaults.",
          "title": "Fields"
        },
        "publicationTypes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated publication types, such as Review,JournalArticle.",
          "title": "Publication types"
        },
        "openAccessPdf": {
          "default": false,
          "title": "Only papers with a public PDF",
          "type": "boolean"
        },
        "minCitationCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum citation count"
        },
        "publicationDateOrYear": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive date range, for example 2019:2020 or 2019-03-05:2020-06-06.",
          "title": "Publication date or year"
        },
        "year": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Year or range, for example 2019, 2016-2020 or 2010-.",
          "title": "Year"
        },
        "venue": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated publication venues.",
          "title": "Venue"
        },
        "fieldsOfStudy": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated fields, for example Computer Science,Medicine.",
          "title": "Fields of study"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_matching_paper",
          "default": "on_new_matching_paper",
          "title": "Operation",
          "type": "string",
          "x-category": "Triggers",
          "x-display-name": "On New Matching Paper",
          "x-is-trigger": true
        },
        "query": {
          "description": "Paper title/abstract search. Watches the newest 1,000 matches by publication date; narrow the query and filters for busy topics.",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "OnNewMatchingPaper",
      "type": "object",
      "x-requires-webhook": true
    },
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
