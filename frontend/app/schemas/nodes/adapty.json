          "type": "string",
          "ui:widget": "password"
        },
        "app_id": {
          "description": "Actual internal app UUID; every returned profile must match this app.",
          "format": "uuid",
          "title": "Adapty App ID",
          "type": "string"
        },
        "verification_profile_id": {
          "description": "An existing profile in this app used for a read-only connection check. This is a resource reference, not account identity.",
          "format": "uuid",
          "title": "Known Profile for Connection Check",
          "type": "string"
        }
      },
      "required": [
        "secret_key",
        "app_id",
        "verification_profile_id"
      ],
      "title": "AdaptyAPIKeyCredential",
      "type": "object",
