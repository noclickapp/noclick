  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "check_connection": "#/$defs/XataCheckConfig",
          "get_backup": "#/$defs/XataGetBackupConfig",
          "get_organization": "#/$defs/XataGetOrganizationConfig",
          "get_project": "#/$defs/XataGetProjectConfig",
          "list_backups": "#/$defs/XataBackupsConfig",
          "list_branches": "#/$defs/XataBranchesConfig",
          "list_organizations": "#/$defs/XataOrganizationsConfig",
          "list_projects": "#/$defs/XataProjectsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/XataCheckConfig"
        },
        {
          "$ref": "#/$defs/XataOrganizationsConfig"
        },
        {
          "$ref": "#/$defs/XataGetOrganizationConfig"
        },
        {
          "$ref": "#/$defs/XataProjectsConfig"
        },
        {
          "$ref": "#/$defs/XataGetProjectConfig"
        },
        {
          "$ref": "#/$defs/XataBranchesConfig"
        },
        {
          "$ref": "#/$defs/XataBackupsConfig"
        },
        {
          "$ref": "#/$defs/XataGetBackupConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/XataIssuedOAuthCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Xata Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
