    "XataIssuedOAuthCredential": {
      "properties": {
        "credential_type": {
          "const": "xata_issued_oauth",
          "default": "xata_issued_oauth",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "description": "Issued OAuth token for current api.xata.tech. No API-key fallback, exchange or refresh.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Existing Xata OAuth Access Token",
          "type": "string",
          "ui:widget": "password"
        },
        "granted_scopes": {
          "description": "Actual existing grant scopes. Parent catalog checks additionally require org:read and project:read. Provider permission remains authoritative.",
          "items": {
            "enum": [
              "org:read",
              "project:read",
              "branch:read"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Granted Scopes",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actual issued expiry when available, with time zone. No assumed lifetime or renewal.",
          "title": "Expires At"
        }
      },
      "required": [
        "access_token",
        "granted_scopes"
      ],
      "title": "XataIssuedOAuthCredential",
      "type": "object",
      "x-credential-instructions": "Enter an existing scoped OAuth Bearer token and actual granted scopes. Selected current routes declare OAuth-only security despite a global API-key component. No popup, minting, refresh, API-key fallback or legacy Xata API.",
      "x-credential-url": "https://xata.io/docs/api-reference/organizations/get-list-of-organizations"
    },
