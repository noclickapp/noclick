          "title": "Signer Profile Id",
          "type": "string"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An external identifier that can be used to identify the signer.\nIt's a reference that can be used to identify the signer in the external system.\nIgnisign does not use internally this field to identify the signer.\n",
          "title": "External Id"
        },
        "first_name": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The first name of the signer.",
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The last name of the signer.",
          "title": "Last Name"
        },
        "email": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The email address of the signer.",
          "title": "Email"
        },
        "phone_number": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the phone number of the signer.",
          "title": "Phone Number"
        },
        "nationality": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The nationality of the signer.",
          "title": "Nationality"
        },
        "birth_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the date of birth of the signer.",
          "title": "Birth Date"
        },
        "birth_place": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the place of birth of the signer.",
          "title": "Birth Place"
        },
        "birth_country": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the country of birth of the signer.",
          "title": "Birth Country"
        }
      },
      "required": [
        "signer_profile_id"
      ],
      "title": "IgnisignCreateSigner",
      "type": "object"
    },
    "IgnisignCreateWebhook": {
