        },
        "expiration_date_is_activated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indicates whether the expiration date is activated.",
          "title": "Expiration Date Is Activated"
        },
        "language": {
          "anyOf": [
            {
              "enum": [
                "AR",
                "BG",
                "BN",
                "CS",
                "DA",
                "DE",
                "EL",
                "EN",
                "ES",
                "ET",
                "FI",
                "FR",
                "GA",
                "HI",
                "HR",
                "HU",
                "IS",
                "IT",
                "JA",
                "KO",
                "LT",
                "LV",
                "MT",
                "NL",
                "NO",
                "PL",
                "PT",
                "RO",
                "RU",
                "SK",
                "SL",
                "SQ",
                "SR",
                "SV",
                "TR",
                "UK",
                "ZH"
              ],
              "type": "string"
            },
            {
