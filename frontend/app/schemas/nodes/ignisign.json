              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The expiration date if the `expirationDateIsActivated` parameter is true The action linked to this date is performed every 5 minutes, at 5, 10, 15... 55.",
