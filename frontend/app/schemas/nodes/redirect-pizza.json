      "type": "object"
    },
    "CreateEmailForward": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_email_forward",
          "default": "create_email_forward",
          "title": "Create an email forward",
          "type": "string",
          "ui:hidden": true
        },
        "alias": {
          "description": "The alias part (before the '@'). Use '*' to create a catch-all email forward.",
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "domain": {
          "description": "Domain of the email forward. Must be a domain you own and can manage DNS for.",
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "destination": {
          "description": "Destination email address where the email will be forwarded to.",
          "minLength": 1,
          "title": "Destination",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "domain",
        "destination"
      ],
      "title": "CreateEmailForward",
      "type": "object"
    },
    "CreateRedirect": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_redirect",
          "default": "create_redirect",
          "title": "Create a redirect",
          "type": "string",
          "ui:hidden": true
        },
        "sources": {
          "description": "URLs to be redirected ('from' URLs)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "destination": {
          "description": "Destination URL or conditional destinations. Either a string (e.g. 'https://example.org') or an array of expression/url objects. Example:\n[\n  {\"expression\": \"country=='US'\", \"url\": \"https://us.example.org\"},\n  {\"expression\": \"country=='NL'\", \"url\": \"https://nl.example.org\"}\n]",
          "minLength": 1,
          "title": "Destination",
          "type": "string"
        },
        "redirect_type": {
          "description": "Type of redirect",
          "enum": [
            "permanent",
            "temporary",
            "permanent:308",
            "temporary:307",
            "frame",
            "meta-refresh"
          ],
          "minLength": 1,
          "title": "Redirect Type",
          "type": "string"
        },
        "uri_forwarding": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the path should be forwarded",
          "title": "Uri Forwarding"
        },
        "keep_query_string": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the query string should be forwarded",
          "title": "Keep Query String"
        },
        "tracking": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether analytics information should be collected",
          "title": "Tracking"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tags categorising this redirect. May also be a comma-separated string.",
          "title": "Tags"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Notes about the redirect",
          "title": "Notes"
        },
        "merge": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether to merge the new redirect with an existing redirect if they have the same destination",
          "title": "Merge"
        },
        "upsert": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When enabled, if any of the provided source URLs already exist on a redirect, that redirect will be updated instead of creating a new one. Existing sources on that redirect are kept and only new sources are added; omitted sources are not deleted. If the provided sources match more than one existing redirect, the request will fail with an error. Useful for automated syncing without needing to track redirect IDs.",
          "title": "Upsert"
        }
      },
      "required": [
        "sources",
        "destination",
        "redirect_type"
      ],
      "title": "CreateRedirect",
      "type": "object"
    },
