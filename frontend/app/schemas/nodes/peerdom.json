{
  "$defs": {
    "AssignRole": {
      "description": "Assign an existing role to a peer, optionally setting contribution, focus and election end.",
      "properties": {
        "operation": {
          "const": "assign_role",
          "default": "assign_role",
          "title": "Operation",
          "type": "string"
        },
        "role_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Role Id",
          "type": "string"
        },
        "peer_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Peer Id",
          "type": "string"
        },
        "percentage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percentage"
        },
        "focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focus"
        },
        "elected_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elected Until"
        }
      },
      "required": [
        "role_id",
        "peer_id"
      ],
      "title": "AssignRole",
      "type": "object"
    },
    "CreateGroup": {
      "description": "Create a group (circle) in a selected map and parent circle.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Parent Id",
          "type": "string"
        },
        "external": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True detaches from its parent; false attaches under the map's root circle. A supplied parent reattaches an external node.",
          "title": "External"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hex color; must be in the tenant palette if personal colors are disabled. Get tenant shows that palette.",
          "title": "Color"
        },
        "shape": {
          "anyOf": [
            {
              "enum": [
                "circle",
                "hexagon"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape",
          "enum": [
            "circle",
            "hexagon"
          ],
          "x-enum-searchable": true
        },
        "custom_fields": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Fields"
        },
        "group_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Email"
        },
        "operation": {
          "const": "create_group",
          "default": "create_group",
          "title": "Operation",
          "type": "string"
        },
        "map_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Map Id",
          "type": "string"
        },
        "electable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Electable"
        }
      },
      "required": [
        "name",
        "parent_id",
        "map_id"
      ],
      "title": "CreateGroup",
      "type": "object"
    },
    "CreatePeer": {
      "description": "Create a peer. An email links/provisions an account as a guest; no invitation is sent.",
      "properties": {
        "first_name": {
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "nick_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nick Name"
        },
        "email": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "birthdate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Birthdate"
        },
        "percentage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contribution percentage; requires the Contribution app.",
          "title": "Percentage"
        },
        "custom_fields": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing custom-field names mapped to a string or list of strings.",
          "title": "Custom Fields"
        },
        "operation": {
          "const": "create_peer",
          "default": "create_peer",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "first_name"
      ],
      "title": "CreatePeer",
      "type": "object"
    },
    "CreateProject": {
      "description": "Create a project; requires the Projects app.",
      "properties": {
        "name": {
          "minLength": 1,
