{
  "$defs": {
    "MicrosoftTodoOAuthCredential": {
      "description": "OAuth credential for Microsoft To Do access.\nTokens are obtained via OAuth flow, not entered manually.",
      "properties": {
        "credential_type": {
          "const": "microsoft_todo_oauth",
          "default": "microsoft_todo_oauth",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "description": "OAuth 2.0 access token from Microsoft",
          "title": "Access Token",
          "type": "string"
        },
        "refresh_token": {
          "description": "OAuth 2.0 refresh token for automatic renewal",
          "title": "Refresh Token",
          "type": "string"
        },
        "expires_at": {
          "description": "ISO 8601 timestamp when access token expires",
          "title": "Token Expiry",
          "type": "string"
        },
        "email": {
          "description": "Email address of the connected Microsoft account",
          "title": "Microsoft Account",
          "type": "string"
        }
      },
      "required": [
        "access_token",
        "refresh_token",
        "expires_at",
        "email"
      ],
      "title": "MicrosoftTodoOAuthCredential",
      "type": "object",
      "x-credential-type": "oauth",
      "x-oauth-provider": "microsoft",
      "x-oauth-scopes": [
        "https://graph.microsoft.com/Tasks.Read",
        "https://graph.microsoft.com/Tasks.ReadWrite",
        "https://graph.microsoft.com/User.Read",
        "offline_access"
      ]
    },
    "TodoCreateTaskConfig": {
      "description": "Configuration for creating a new task",
      "properties": {
