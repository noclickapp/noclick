        "task_list_id": {
          "description": "ID of the task list to create task in",
          "placeholder": "AAMkAGI2...",
          "title": "Task List ID",
          "type": "string"
        },
        "title": {
          "description": "Title of the task",
          "placeholder": "Complete project proposal",
          "title": "Task Title",
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "type": "string"
