          "placeholder": "Additional details about the task (optional)",
          "title": "Task Notes",
          "ui:widget": "textarea"
        },
        "due_date_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Due date in ISO 8601 format (e.g., '2024-01-15T09:00:00Z')",
          "placeholder": "2024-01-15T09:00:00Z (optional)",
          "title": "Due Date"
        },
        "importance": {
          "default": "normal",
          "description": "Task importance level",
          "enum": [
            "low",
            "normal",
            "high"
          ],
          "enumNames": [
            "Low",
            "Normal",
            "High"
          ],
          "title": "Importance",
          "type": "string"
        },
        "status": {
          "default": "notStarted",
          "description": "Task status",
          "enum": [
            "notStarted",
            "inProgress",
            "completed",
            "waitingOnOthers",
            "deferred"
          ],
          "enumNames": [
            "Not Started",
            "In Progress",
            "Completed",
            "Waiting On Others",
            "Deferred"
          ],
          "title": "Status",
          "type": "string"
        }
