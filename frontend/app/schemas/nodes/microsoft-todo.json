  "description": "Full configuration for Microsoft To Do node including credentials",
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_task": "#/$defs/TodoCreateTaskConfig",
          "create_task_list": "#/$defs/TodoCreateTaskListConfig",
          "delete_task": "#/$defs/TodoDeleteTaskConfig",
          "delete_task_list": "#/$defs/TodoDeleteTaskListConfig",
          "get_task": "#/$defs/TodoGetTaskConfig",
          "get_task_list": "#/$defs/TodoGetTaskListConfig",
          "list_task_lists": "#/$defs/TodoListTaskListsConfig",
          "list_tasks": "#/$defs/TodoListTasksConfig",
          "update_task": "#/$defs/TodoUpdateTaskConfig",
          "update_task_list": "#/$defs/TodoUpdateTaskListConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TodoListTaskListsConfig"
        },
        {
          "$ref": "#/$defs/TodoCreateTaskListConfig"
        },
        {
          "$ref": "#/$defs/TodoGetTaskListConfig"
        },
        {
          "$ref": "#/$defs/TodoUpdateTaskListConfig"
        },
        {
          "$ref": "#/$defs/TodoDeleteTaskListConfig"
        },
        {
          "$ref": "#/$defs/TodoListTasksConfig"
        },
        {
          "$ref": "#/$defs/TodoCreateTaskConfig"
        },
        {
          "$ref": "#/$defs/TodoGetTaskConfig"
        },
        {
          "$ref": "#/$defs/TodoUpdateTaskConfig"
        },
        {
          "$ref": "#/$defs/TodoDeleteTaskConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/MicrosoftTodoOAuthCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Microsoft-todo Node Configuration",
  "type": "object",
  "x-edit-examples": [
