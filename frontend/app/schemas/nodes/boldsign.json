          "default": false,
          "description": "Enter true to opt in or false to decline. Creates an organization contact only. New IDs still require explicit saved scope before later reads or changes.",
          "title": "Allow contact creation",
          "type": "boolean"
        },
        "credential_type": {
          "const": "boldsign_client_credentials",
          "default": "boldsign_client_credentials",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "client_id": {
          "title": "Client ID",
          "type": "string"
        },
        "client_secret": {
          "title": "Client Secret",
          "type": "string",
          "ui:widget": "password"
        },
        "scopes": {
          "description": "Enter explicit scopes separated by single spaces (or supply a structured list). Connection checks require Documents.All; template reads require Templates.Read or All, tag changes also require Write or All. Contact permissions remain provider-enforced; no undocumented scope is invented.",
          "items": {
            "enum": [
              "BoldSign.Documents.All",
              "BoldSign.Templates.Read",
              "BoldSign.Templates.Write",
              "BoldSign.Templates.All"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Requested API Scopes",
          "type": "array"
        }
      },
      "required": [
        "environment",
        "client_id",
        "client_secret",
        "scopes"
      ],
      "title": "BoldSign OAuth Client",
      "type": "object",
      "x-credential-instructions": "Supply an existing US-region machine client ID and secret, actual Sandbox/Live label, and explicit API scopes. Tokens are obtained at account.boldsign.com with client_credentials and sent only to api.boldsign.com. No callback, consent or refresh token. Checking the protected document list proves reachability only; provider permissions and saved ID allowlists remain authoritative.",
