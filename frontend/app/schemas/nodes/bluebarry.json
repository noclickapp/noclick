{
  "$defs": {
    "BluebarryCredential": {
      "properties": {
        "credential_type": {
          "const": "bluebarry_api_key",
          "default": "bluebarry_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "tenant_id": {
          "description": "Store data > Integrations. Required for identifying shoppers.",
          "minLength": 1,
          "title": "Tenant ID",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "tenant_id"
      ],
      "title": "Bluebarry API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from Store data > Integrations > Developer area. Paste the raw key without a Bearer prefix. Copy the Tenant ID from Store data > Integrations; it is used only for Identify shopper.",
      "x-credential-url": "https://bluebarry.ai/help/developer-platform/api-authentication-overview"
    },
    "CreateWebhook": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_webhook",
          "default": "create_webhook",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "topic": {
          "description": "Webhook topic, for example result.viewed.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "url": {
          "description": "Webhook delivery URL. Bluebarry sends events to this address.",
          "maxLength": 1024,
          "title": "Url",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "disabled": {
          "default": false,
          "title": "Disabled",
          "type": "boolean"
        }
      },
      "required": [
        "topic",
        "url"
      ],
      "title": "CreateWebhook",
      "type": "object"
    },
