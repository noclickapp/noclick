          "archive_payment_request": "#/$defs/ArchivePaymentRequest",
          "archive_pull_payment": "#/$defs/ArchivePullPayment",
          "create_invoice": "#/$defs/CreateInvoice",
          "create_payment_request": "#/$defs/CreatePaymentRequest",
          "create_pull_payment": "#/$defs/CreatePullPayment",
          "get_current_user": "#/$defs/GetCurrentUser",
          "get_invoice": "#/$defs/GetInvoice",
          "get_invoice_payment_methods": "#/$defs/GetInvoicePaymentMethods",
          "get_payment_request": "#/$defs/GetPaymentRequest",
          "get_pull_payment": "#/$defs/GetPullPayment",
          "get_store": "#/$defs/GetStore",
          "list_invoices": "#/$defs/ListInvoices",
          "list_payment_requests": "#/$defs/ListPaymentRequests",
          "list_pull_payments": "#/$defs/ListPullPayments",
          "list_stores": "#/$defs/ListStores",
          "mark_invoice_status": "#/$defs/MarkInvoiceStatus",
          "unarchive_invoice": "#/$defs/UnarchiveInvoice",
          "update_invoice": "#/$defs/UpdateInvoice"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetCurrentUser"
        },
        {
          "$ref": "#/$defs/ListStores"
        },
        {
          "$ref": "#/$defs/GetStore"
        },
        {
          "$ref": "#/$defs/ListInvoices"
        },
        {
          "$ref": "#/$defs/GetInvoice"
        },
        {
          "$ref": "#/$defs/CreateInvoice"
        },
        {
          "$ref": "#/$defs/UpdateInvoice"
        },
        {
          "$ref": "#/$defs/ArchiveInvoice"
        },
        {
          "$ref": "#/$defs/UnarchiveInvoice"
        },
        {
          "$ref": "#/$defs/MarkInvoiceStatus"
        },
        {
          "$ref": "#/$defs/GetInvoicePaymentMethods"
        },
        {
          "$ref": "#/$defs/ListPaymentRequests"
        },
        {
          "$ref": "#/$defs/CreatePaymentRequest"
        },
        {
          "$ref": "#/$defs/GetPaymentRequest"
        },
        {
          "$ref": "#/$defs/ArchivePaymentRequest"
        },
        {
          "$ref": "#/$defs/ListPullPayments"
        },
        {
          "$ref": "#/$defs/CreatePullPayment"
        },
        {
          "$ref": "#/$defs/GetPullPayment"
        },
        {
          "$ref": "#/$defs/ArchivePullPayment"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/BtcpayServerAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Btcpay-server Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
