              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Ids"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "New",
                "Processing",
                "Expired",
                "Invalid",
                "Settled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "New",
            "Processing",
            "Expired",
            "Invalid",
            "Settled"
          ],
          "x-enum-searchable": true
        },
        "start_date": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unix timestamp in seconds.",
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
