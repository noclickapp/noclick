    "BtcpayServerAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "btcpay_server_api_key",
          "default": "btcpay_server_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_base_url": {
          "description": "Your public HTTPS BTCPay Server origin, for example https://pay.example.com.",
          "minLength": 1,
          "title": "Server URL",
          "type": "string"
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_base_url",
        "api_key"
      ],
      "title": "Btcpay Server API Key",
      "type": "object",
      "x-credential-instructions": "In your BTCPay Server account, open Account \u2192 Manage Account \u2192 API Keys and create an API key. Paste the key and your server's HTTPS origin. Enable btcpay.user.canviewprofile to verify the connection, plus the permissions needed for your operations: view store settings, view/create/modify invoices, manage invoice status, view/modify payment requests, or manage/create/archive pull payments. Keys can be restricted to individual stores. NoClick sends Authorization: token <key> to this server. An accepted profile read does not verify write permissions.",
      "x-credential-url": "https://docs.btcpayserver.org/Developers/api/authentication/"
    },
    "CreateInvoice": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Positive decimal string, such as 5.00.",
          "maxLength": 80,
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Currency",
          "type": "string"
        },
        "operation": {
          "const": "create_invoice",
          "default": "create_invoice",
          "title": "Operation",
          "type": "string"
        },
        "store_id": {
          "title": "Store Id",
          "type": "string"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Invoice metadata, such as orderId, buyerEmail or itemDesc.",
          "title": "Metadata"
        }
      },
      "required": [
        "amount",
        "currency",
        "store_id"
      ],
      "title": "CreateInvoice",
      "type": "object"
    },
    "CreatePaymentRequest": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Positive decimal string, such as 5.00.",
          "maxLength": 80,
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Currency",
          "type": "string"
        },
        "operation": {
          "const": "create_payment_request",
          "default": "create_payment_request",
          "title": "Operation",
          "type": "string"
        },
        "store_id": {
          "title": "Store Id",
          "type": "string"
        },
        "title": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "reference_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Id"
        },
        "expiry_date": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unix timestamp in seconds.",
          "title": "Expiry Date"
        },
        "allow_custom_payment_amounts": {
          "default": false,
          "title": "Allow Custom Payment Amounts",
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "currency",
        "store_id",
        "title"
      ],
      "title": "CreatePaymentRequest",
      "type": "object"
    },
    "CreatePullPayment": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Positive decimal string, such as 5.00.",
          "maxLength": 80,
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Currency",
          "type": "string"
        },
        "operation": {
          "const": "create_pull_payment",
          "default": "create_pull_payment",
          "title": "Operation",
          "type": "string"
        },
        "store_id": {
          "title": "Store Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "payout_methods": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payout Methods"
        },
        "starts_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Starts At"
        },
        "expires_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        }
      },
      "required": [
        "amount",
        "currency",
        "store_id"
      ],
      "title": "CreatePullPayment",
      "type": "object"
    },
