    "ListInvoices": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_invoices",
          "default": "list_invoices",
          "title": "Operation",
          "type": "string"
        },
        "store_id": {
          "title": "Store Id",
          "type": "string"
        },
        "take": {
          "default": 50,
          "description": "Maximum invoices on this page.",
          "maximum": 100,
          "minimum": 1,
          "title": "Take",
          "type": "integer"
        },
        "skip": {
          "default": 0,
          "description": "Offset; increase by the returned count to fetch another page.",
          "minimum": 0,
          "title": "Skip",
          "type": "integer"
        },
        "text_search": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Search"
        },
        "order_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
