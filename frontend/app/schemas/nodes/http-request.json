    "ApiKeyCredential": {
      "description": "API Key authentication \u2014 sent as a request header or a query parameter.\n\nAlso covers \"custom header auth\": set the name to any header an API expects\n(e.g. ``X-Auth-Token``) and keep the location as Header.",
      "properties": {
        "allowed_origin": {
          "description": "Exact HTTPS origin this credential may be sent to, for example https://api.example.com. Requests and redirects to any other origin are blocked.",
          "minLength": 1,
          "title": "Allowed Resource Origin",
          "type": "string",
          "ui:placeholder": "https://api.example.com"
        },
        "credential_type": {
          "const": "http_api_key",
          "default": "http_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "auth_type": {
          "const": "api_key",
          "default": "api_key",
          "title": "Auth Type",
          "type": "string",
          "ui:hidden": true
        },
        "location": {
          "default": "header",
          "description": "Where to put the API key on the request.",
          "enum": [
            "header",
            "query"
          ],
          "enumNames": [
            "Request header",
            "Query parameter"
          ],
          "title": "Send In",
          "type": "string"
        },
        "header_name": {
          "default": "X-API-Key",
          "description": "The name to send the key under \u2014 e.g. X-API-Key or Authorization for a header, or a query-parameter name like api_key.",
          "title": "Header / Parameter Name",
          "type": "string",
          "ui:placeholder": "X-API-Key"
        },
        "api_key": {
          "description": "API key value",
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "allowed_origin",
        "api_key"
      ],
      "title": "ApiKeyCredential",
      "type": "object"
    },
