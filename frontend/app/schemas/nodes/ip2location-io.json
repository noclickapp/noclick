{
  "$defs": {
    "Ip2LocationIoCredential": {
      "properties": {
        "credential_type": {
          "const": "ip2location_io_api_key",
          "default": "ip2location_io_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "IP2Location.io API Key",
      "type": "object",
      "x-credential-instructions": "Paste your IP2Location.io API key. NoClick sends it to api.ip2location.io for IP geolocation. Connecting performs one lookup of 8.8.8.8 and consumes a lookup credit. This establishes reachability, not account identity.",
      "x-credential-url": "https://www.ip2location.io/ip2location-documentation"
    },
    "Ip2LocationIoLookupConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_ip_geolocation",
          "default": "get_ip_geolocation",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "ip": {
          "description": "IPv4 or IPv6 address to geolocate, for example 8.8.8.8.",
          "title": "IP address",
          "type": "string"
        },
        "lang": {
          "anyOf": [
            {
              "enum": [
                "ar",
                "cs",
                "da",
                "de",
                "en",
                "es",
                "et",
                "fi",
                "fr",
                "ga",
                "it",
                "ja",
                "ko",
                "ms",
                "nl",
                "pt",
                "ru",
                "sv",
                "tr",
                "vi",
                "zh-cn",
                "zh-tw"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional translated location names; requires a Plus or Security plan.",
          "title": "Translation language",
          "enum": [
            "ar",
            "cs",
            "da",
            "de",
            "en",
            "es",
            "et",
            "fi",
            "fr",
            "ga",
            "it",
            "ja",
            "ko",
            "ms",
            "nl",
            "pt",
            "ru",
            "sv",
            "tr",
            "vi",
            "zh-cn",
            "zh-tw"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "ip"
      ],
      "title": "Ip2LocationIoLookupConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "$ref": "#/$defs/Ip2LocationIoLookupConfig",
      "description": "Node-specific configuration"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ip2LocationIoCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Ip2location-io Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
