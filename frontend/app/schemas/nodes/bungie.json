          "minItems": 1,
          "title": "Itemids",
          "type": "array"
        },
        "characterId": {
          "title": "Characterid",
          "type": "string"
        },
        "membershipType": {
          "maximum": 254,
          "minimum": -1,
          "title": "Membershiptype",
          "type": "integer"
        }
      },
      "required": [
        "itemIds",
        "characterId",
        "membershipType"
      ],
      "title": "BungieEquipItemsConfig",
      "type": "object"
