    "BungieGetVendorsConfig": {
      "description": "Get currently available vendors from the list of vendors that can possibly have rotating inventory. Note that this does not include things like preview vendors and vendors-as-kiosks, neither of whom have rotating/dynamic inventories. Use their definitions as-is for those.",
      "properties": {
        "operation": {
          "const": "get_vendors",
          "default": "get_vendors",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "characterId": {
          "title": "Characterid",
          "type": "string"
        },
        "components": {
          "default": [
            400,
            402
          ],
          "description": "Destiny component numbers, e.g. 100 (profile), 200 (characters), 300 (item instances). At least one required.",
          "items": {
            "type": "integer"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "destinyMembershipId": {
          "title": "Destinymembershipid",
          "type": "string"
        },
        "filter": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The filter of what vendors and items to return, if any.",
          "title": "Filter"
        },
        "membershipType": {
          "description": "The types of membership the Accounts system supports. This is the external facing enum used in place of the internal-only Bungie.SharedDefinitions.MembershipType.",
          "maximum": 254,
          "minimum": -1,
          "title": "Membershiptype",
          "type": "integer"
        }
      },
      "required": [
        "characterId",
        "destinyMembershipId",
        "membershipType"
      ],
      "title": "BungieGetVendorsConfig",
      "type": "object"
    },
    "BungieOnNewActivityConfig": {
      "description": "Watch a newest-first window of completed activities for one character.\n\nPoll frequently enough that fewer than 250 activities complete between polls.\nThe first poll records a baseline; changing the character resets that baseline.",
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule",
          "ui:widget": "schedule",
          "x-exclude-frequencies": [
            "seconds"
          ]
        },
        "webhook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Id",
          "ui:hidden": true
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url",
          "ui:hidden": true,
          "ui:loadValue": true
        },
        "schedule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Id",
          "ui:hidden": true
        },
        "next_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run",
          "ui:widget": "nextRun"
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Ms",
          "ui:hidden": true
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Is Active",
          "ui:hidden": true
        },
        "relay_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relay Connected",
          "ui:hidden": true
        },
        "is_production": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Production",
          "ui:hidden": true
        },
        "trigger_registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Registered",
          "ui:hidden": true
        },
        "trigger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Error",
          "ui:hidden": true
        },
        "operation": {
          "const": "on_new_activity",
          "default": "on_new_activity",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-category": "Triggers",
          "x-display-name": "On New Completed Activity",
          "x-is-trigger": true
        },
        "membershipType": {
          "maximum": 254,
          "minimum": 0,
          "title": "Membershiptype",
          "type": "integer"
        },
        "destinyMembershipId": {
          "title": "Destinymembershipid",
          "type": "string"
        },
        "characterId": {
          "title": "Characterid",
          "type": "string"
        },
        "mode": {
          "default": 0,
          "description": "Destiny activity mode; 0 includes all modes.",
          "minimum": 0,
          "title": "Mode",
          "type": "integer"
        }
      },
      "required": [
        "membershipType",
        "destinyMembershipId",
        "characterId"
      ],
      "title": "BungieOnNewActivityConfig",
      "type": "object",
      "x-requires-webhook": true
    },
