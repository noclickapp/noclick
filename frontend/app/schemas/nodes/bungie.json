    "BungieGetActivityHistoryConfig": {
      "description": "Gets activity history stats for indicated character.",
      "properties": {
        "operation": {
          "const": "get_activity_history",
          "default": "get_activity_history",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "characterId": {
          "title": "Characterid",
          "type": "string"
        },
