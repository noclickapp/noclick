{
  "$defs": {
    "PeekalinkAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "peekalink_api_key",
          "default": "peekalink_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Peekalink API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from the Peekalink dashboard and paste it here without the Bearer prefix. NoClick sends it to api.peekalink.io. Connecting requests one example link preview and uses your request quota; it verifies API access, not account identity.",
      "x-credential-url": "https://www.peekalink.io/app/dashboard"
    },
    "PeekalinkGetLinkPreviewConfig": {
      "description": "Get metadata, images and platform-specific content for one URL.",
      "properties": {
        "operation": {
          "const": "get_link_preview",
          "default": "get_link_preview",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-keywords": [
            "URL metadata",
            "unfurl link",
            "YouTube",
            "social preview"
          ]
        },
        "link": {
          "format": "uri",
          "minLength": 1,
          "title": "Link URL",
          "type": "string"
        },
        "accept_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional Accept-Language header, such as en-US.",
          "title": "Preferred language"
        },
        "source": {
          "default": "API",
          "enum": [
            "API",
            "WEB"
          ],
          "title": "Request source",
          "type": "string"
        },
        "forceNewSnapshot": {
          "anyOf": [
            {
              "enum": [
                "true",
                "false"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enterprise integration debugging only; Peekalink already keeps previews fresh.",
          "title": "Force new snapshot",
          "enum": [
            "true",
            "false"
          ],
          "x-enum-searchable": true
        },
        "forceNewSnapshotRecursive": {
          "anyOf": [
            {
              "enum": [
                "true",
                "false"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enterprise integration debugging only.",
          "title": "Force recursive snapshot",
          "enum": [
            "true",
            "false"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "link"
      ],
      "title": "PeekalinkGetLinkPreviewConfig",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "$ref": "#/$defs/PeekalinkGetLinkPreviewConfig",
      "description": "Node-specific configuration"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/PeekalinkAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Peekalink Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
