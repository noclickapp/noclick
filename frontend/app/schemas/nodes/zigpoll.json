        "nextSlide": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use -1 to end the survey.",
          "title": "Next question ID"
        }
      },
      "required": [
        "slideId"
      ],
      "title": "ZigpollUpdateSlideConfig",
      "type": "object"
    }
