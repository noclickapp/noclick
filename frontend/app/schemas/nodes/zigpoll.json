        "slideId": {
          "minLength": 1,
          "title": "Question ID",
          "type": "string"
        },
        "operation": {
          "const": "update_slide",
          "default": "update_slide",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
