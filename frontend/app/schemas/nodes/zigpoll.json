      "x-credential-type": "mcp",
      "x-mcp-server": "https://mcp.zigpoll.com/mcp",
      "x-mcp-transport": "shttp"
    },
    "ZigpollSendEmailConfig": {
      "additionalProperties": false,
      "description": "Send email campaign.",
      "properties": {
        "pollId": {
          "minLength": 1,
          "title": "Survey ID",
          "type": "string"
        },
        "operation": {
          "const": "send_email",
          "default": "send_email",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "recipients": {
          "description": "Zigpoll skips invalid and placeholder addresses and reports sent and skipped recipients. Acknowledgement does not prove delivery.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Recipient email addresses",
          "type": "array"
        }
      },
      "required": [
        "pollId",
        "recipients"
      ],
      "title": "ZigpollSendEmailConfig",
      "type": "object"
    },
    "ZigpollSendSmsConfig": {
      "additionalProperties": false,
      "description": "Send SMS campaign.",
      "properties": {
        "pollId": {
          "minLength": 1,
          "title": "Survey ID",
          "type": "string"
        },
        "operation": {
          "const": "send_sms",
          "default": "send_sms",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "recipients": {
          "description": "E.164 or domestic numbers. Acknowledgement does not prove delivery.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Recipient phone numbers",
          "type": "array"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message override"
        }
      },
      "required": [
        "pollId",
        "recipients"
      ],
      "title": "ZigpollSendSmsConfig",
      "type": "object"
    },
    "ZigpollUpdatePollConfig": {
      "additionalProperties": false,
      "description": "Update poll.",
      "properties": {
        "pollId": {
          "minLength": 1,
          "title": "Survey ID",
          "type": "string"
        },
        "operation": {
          "const": "update_poll",
          "default": "update_poll",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Survey title"
        },
        "isVisible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Requires at least one question and an unarchived survey.",
          "title": "Visible"
        },
        "isArchived": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archived"
        },
        "pageRules": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replaces the complete page rules array.",
          "title": "Page rules"
        },
        "pageExcludeRules": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replaces the complete exclusion array.",
          "title": "Excluded page rules"
        }
      },
      "required": [
        "pollId"
      ],
      "title": "ZigpollUpdatePollConfig",
      "type": "object"
    },
    "ZigpollUpdateSlideConfig": {
      "additionalProperties": false,
      "description": "Update slide.",
