{
  "$defs": {
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Schedule configuration from the frontend widget.\nFields accept Union[int, str] to support drag-and-drop references like\n{{nodeId.values.field}} which get resolved at configuration time.",
      "properties": {
        "frequency": {
          "default": "hours",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day",
            "week",
            "weeks",
            "month"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repeat interval (for seconds/minutes/hours/weeks)",
          "title": "Interval"
        },
        "hour": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 9,
          "description": "Hour of day (0-23)",
          "title": "Hour"
        },
        "minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "description": "Minute (0-59)",
          "title": "Minute"
        },
        "dayOfWeek": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of month (1-31)",
          "title": "Dayofmonth"
        },
        "daysOfWeek": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days of week to run on (0=Sunday \u2026 6=Saturday); empty = every day. Supported for seconds/minutes/hours intervals and daily schedules.",
          "title": "Daysofweek"
        },
        "windowStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day start as 24-hour \"HH:MM\" in the schedule timezone (e.g. \"09:00\"). Set together with windowEnd; interval frequencies only.",
          "title": "Windowstart"
        },
        "windowEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-day end as 24-hour \"HH:MM\", inclusive \u2014 a run landing exactly on it fires (e.g. \"18:00\" runs the 6:00 PM tick).",
          "title": "Windowend"
        },
        "monthDayStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month start day (1-31), inclusive. Set together with monthDayEnd; a start after the end wraps around month end (25\u21925 = the 25th through the 5th).",
          "title": "Monthdaystart"
        },
        "monthDayEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-month end day (1-31), inclusive.",
          "title": "Monthdayend"
        },
        "monthStart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year start month (1=January \u2026 12=December), inclusive. Set together with monthEnd; a start after the end wraps around the new year (11\u21922 = November through February).",
          "title": "Monthstart"
        },
        "monthEnd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part-of-year end month (1-12), inclusive.",
          "title": "Monthend"
        }
      },
      "title": "ScheduleConfig",
      "type": "object"
    },
    "ZenzapAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "zenzap_api_key",
          "default": "zenzap_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        },
        "api_secret": {
          "minLength": 1,
          "title": "API secret",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key",
        "api_secret"
      ],
      "title": "Zenzap API Key",
      "type": "object",
      "x-credential-instructions": "In the Zenzap admin console, create a static API key bot with permissions for your operations. Paste its API key and API secret. Actions run as that bot; add it to the topics you want to automate.",
      "x-credential-url": "https://app.zenzap.co/console"
    },
    "ZenzapAddReactionConfig": {
      "description": "Add a reaction to a message.",
      "properties": {
        "operation": {
          "const": "add_reaction",
          "default": "add_reaction",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Add a reaction to a message",
          "x-is-trigger": false
        },
        "message_id": {
          "description": "The message ID to react to",
          "format": "uuid",
          "title": "Message ID",
          "type": "string"
        },
        "reaction": {
          "description": "Emoji reaction to add",
          "minLength": 1,
          "title": "Reaction",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "reaction"
      ],
      "title": "ZenzapAddReactionConfig",
      "type": "object"
    },
    "ZenzapAddTopicMembersConfig": {
      "description": "Add members to a topic.",
      "properties": {
        "operation": {
          "const": "add_topic_members",
          "default": "add_topic_members",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Add members to a topic",
          "x-is-trigger": false
        },
        "topic_id": {
          "description": "The ID of the topic to add members to",
          "format": "uuid",
          "title": "Topic ID",
          "type": "string"
        },
        "member_ids": {
          "description": "Array of member IDs to add to the topic (max 5). All members must be from the same organization as the bot and must not already be members of the topic. Duplicate IDs in the request are automatically removed.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Member ids",
          "type": "array"
        }
      },
      "required": [
        "topic_id",
        "member_ids"
      ],
      "title": "ZenzapAddTopicMembersConfig",
      "type": "object"
    },
    "ZenzapCreateTaskConfig": {
      "description": "Create a task.",
      "properties": {
        "operation": {
          "const": "create_task",
          "default": "create_task",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Create a task",
          "x-is-trigger": false
        },
        "topic_id": {
          "description": "The ID of the topic where the task should be created",
          "format": "uuid",
          "title": "Topic ID",
          "type": "string"
        },
        "title": {
          "description": "The task title",
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional task description",
          "title": "Description"
        },
        "assignee": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional user ID to assign the task to",
          "title": "Assignee"
        },
        "due_date": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional due date as Unix timestamp in milliseconds",
          "title": "Due date"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional external identifier for tracking purposes",
          "title": "External id"
        }
      },
      "required": [
        "topic_id",
        "title"
      ],
      "title": "ZenzapCreateTaskConfig",
      "type": "object"
    },
    "ZenzapCreateTopicConfig": {
