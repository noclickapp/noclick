    "ZenzapListMessagesConfig": {
      "description": "Get topic messages.",
      "properties": {
        "operation": {
          "const": "list_messages",
          "default": "list_messages",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true,
          "x-display-name": "Get topic messages",
          "x-is-trigger": false
        },
        "topic_id": {
          "description": "The ID of the topic to get messages from",
          "format": "uuid",
          "title": "Topic ID",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "description": "Maximum number of messages to return (default: 50, max: 100)",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque cursor for pagination. Use the value from `nextCursor` in the response. Cursors are cryptographically signed and validated server-side to prevent tampering.",
          "title": "Cursor"
        },
        "before": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return messages created before this timestamp (Unix milliseconds). Mutually exclusive with `after`.",
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return messages created after this timestamp (Unix milliseconds). Mutually exclusive with `before`.",
          "title": "After"
        },
        "sender_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter messages by sender ID",
          "title": "Sender id"
        },
        "order": {
          "default": "desc",
          "description": "Sort order for messages (default: desc - newest first)",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Order",
          "type": "string"
        },
        "include_system": {
          "default": true,
          "description": "Include system messages (default: true)",
          "title": "Include system",
          "type": "boolean"
        },
        "thread_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
