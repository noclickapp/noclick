          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional topic description",
          "title": "Description"
        },
        "members": {
          "description": "Array of user IDs to add as topic members (max 100). Your bot will automatically be added as a member.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Members",
          "type": "array"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional external identifier for tracking purposes. Must be unique per bot - you cannot reuse the same external ID for multiple topics.",
          "title": "External id"
        }
      },
      "required": [
        "name",
        "members"
      ],
      "title": "ZenzapCreateTopicConfig",
      "type": "object"
