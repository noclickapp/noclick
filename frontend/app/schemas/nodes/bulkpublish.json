          "exclusiveMinimum": 0,
          "title": "Post ID",
          "type": "integer"
        },
        "operation": {
          "const": "retry_post",
          "default": "retry_post",
          "title": "Operation",
          "type": "string"
        },
        "republish": {
          "default": false,
          "description": "Also retry unconfirmed platforms; this can create duplicate posts.",
          "title": "Republish",
          "type": "boolean"
        }
      },
      "required": [
        "post_id"
      ],
      "title": "RetryPost",
      "type": "object"
    },
    "UpdateLabel": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "label_id": {
          "exclusiveMinimum": 0,
          "title": "Label ID",
          "type": "integer"
        },
        "operation": {
          "const": "update_label",
          "default": "update_label",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label_id"
      ],
      "title": "UpdateLabel",
      "type": "object"
    },
    "UpdateMedia": {
      "additionalProperties": false,
      "description": "Set a media file's alternative text, or clear it with null.",
      "properties": {
        "media_id": {
          "exclusiveMinimum": 0,
          "title": "Media ID",
          "type": "integer"
        },
        "operation": {
          "const": "update_media",
          "default": "update_media",
          "title": "Operation",
          "type": "string"
        },
        "alt_text": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Alt Text"
        }
      },
      "required": [
        "media_id",
        "alt_text"
      ],
      "title": "UpdateMedia",
      "type": "object"
    },
    "UpdatePost": {
      "additionalProperties": false,
      "description": "Replace post text and optionally its media, labels and scheduling state.",
      "properties": {
        "content": {
          "anyOf": [
            {
              "maxLength": 63206,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content",
          "ui:widget": "textarea"
        },
        "media_ids": {
          "anyOf": [
            {
              "maxLength": 2000,
              "pattern": "^\\[\\s*(?:[1-9][0-9]*(?:\\s*,\\s*[1-9][0-9]*)*)?\\s*\\]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON array of existing media IDs, e.g. [12,15]. Use [] to remove media.",
          "title": "Media Ids",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "label_ids": {
          "anyOf": [
            {
              "maxLength": 2000,
              "pattern": "^\\[\\s*(?:[1-9][0-9]*(?:\\s*,\\s*[1-9][0-9]*)*)?\\s*\\]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON array of label IDs; [] clears labels.",
          "title": "Label Ids",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "draft",
                "scheduled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status",
          "enum": [
            "draft",
            "scheduled"
          ],
          "x-enum-searchable": true
        },
        "scheduled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Future time with timezone, required when scheduling.",
          "title": "Scheduled At"
        },
        "post_id": {
          "exclusiveMinimum": 0,
          "title": "Post ID",
          "type": "integer"
        },
        "operation": {
          "const": "update_post",
          "default": "update_post",
          "title": "Operation",
          "type": "string"
        },
        "if_unmodified_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional updatedAt precondition from the last read; preserve milliseconds.",
          "title": "If Unmodified Since"
        }
      },
      "required": [
        "post_id"
      ],
      "title": "UpdatePost",
      "type": "object"
    }
  },
