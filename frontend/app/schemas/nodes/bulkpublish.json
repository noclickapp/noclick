          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateLabel",
      "type": "object"
    },
    "CreatePost": {
      "additionalProperties": false,
      "description": "Create a text or media post as a draft, or schedule it for later.",
      "properties": {
        "content": {
          "maxLength": 63206,
          "title": "Content",
          "type": "string",
          "ui:widget": "textarea"
        },
        "media_ids": {
          "anyOf": [
            {
              "maxLength": 2000,
              "pattern": "^\\[\\s*(?:[1-9][0-9]*(?:\\s*,\\s*[1-9][0-9]*)*)?\\s*\\]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON array of existing media IDs, e.g. [12,15]. Use [] to remove media.",
          "title": "Media Ids",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "label_ids": {
          "anyOf": [
            {
              "maxLength": 2000,
              "pattern": "^\\[\\s*(?:[1-9][0-9]*(?:\\s*,\\s*[1-9][0-9]*)*)?\\s*\\]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON array of label IDs; [] clears labels.",
          "title": "Label Ids",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "scheduled"
          ],
          "title": "Status",
          "type": "string"
        },
        "scheduled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Future time with timezone, required when scheduling.",
          "title": "Scheduled At"
        },
        "operation": {
          "const": "create_post",
          "default": "create_post",
          "title": "Operation",
          "type": "string"
        },
        "channel_ids": {
          "description": "JSON array of target channel IDs, e.g. [12,15].",
          "maxLength": 2000,
          "pattern": "^\\[\\s*[1-9][0-9]*(?:\\s*,\\s*[1-9][0-9]*)*\\s*\\]$",
          "title": "Channel Ids",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "timezone": {
          "default": "UTC",
          "description": "IANA timezone",
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "content",
        "channel_ids"
      ],
      "title": "CreatePost",
      "type": "object"
    },
    "CreateSchedule": {
      "additionalProperties": false,
      "description": "Create a recurring schedule; posts materialize only when it runs.",
      "properties": {
        "operation": {
          "const": "create_schedule",
          "default": "create_schedule",
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "frequency": {
          "default": "daily",
          "enum": [
            "daily",
            "weekly",
            "biweekly",
            "monthly"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "time_of_day": {
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time Of Day",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        },
        "channel_ids": {
          "description": "JSON array of target channel IDs, e.g. [12,15].",
          "maxLength": 2000,
          "pattern": "^\\[\\s*[1-9][0-9]*(?:\\s*,\\s*[1-9][0-9]*)*\\s*\\]$",
          "title": "Channel Ids",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "content_template": {
          "maxLength": 63206,
          "minLength": 1,
          "title": "Content Template",
          "type": "string",
          "ui:widget": "textarea"
        },
        "day_of_week": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day Of Week"
        },
        "day_of_month": {
          "anyOf": [
            {
              "maximum": 31,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day Of Month"
        },
        "is_active": {
          "default": true,
          "title": "Is Active",
          "type": "boolean"
        },
        "require_approval": {
          "default": false,
          "title": "Require Approval",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "time_of_day",
        "channel_ids",
        "content_template"
      ],
      "title": "CreateSchedule",
      "type": "object"
    },
