{
  "$defs": {
    "GetScreenshotZip": {
      "description": "Get the ZIP download URL; does not download the archive.",
      "properties": {
        "test_id": {
          "description": "Screenshot test ID returned by Start Screenshot Test.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Test Id",
          "type": "string"
        },
        "operation": {
          "const": "get_screenshot_zip",
          "default": "get_screenshot_zip",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "test_id"
      ],
      "title": "GetScreenshotZip",
      "type": "object"
    },
    "GetScreenshots": {
      "description": "Get a screenshot test's status and individual image URLs.",
      "properties": {
        "test_id": {
          "description": "Screenshot test ID returned by Start Screenshot Test.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Test Id",
          "type": "string"
        },
        "operation": {
          "const": "get_screenshots",
          "default": "get_screenshots",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "test_id"
      ],
      "title": "GetScreenshots",
      "type": "object"
    },
    "LambdaTestCredential": {
      "properties": {
        "credential_type": {
          "const": "lambdatest_access_key",
          "default": "lambdatest_access_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "username": {
          "minLength": 1,
          "title": "Username",
          "type": "string"
        },
        "access_key": {
          "minLength": 1,
          "title": "Access key",
          "type": "string",
          "ui:widget": "password"
        },
        "region": {
          "default": "us",
          "enum": [
            "us",
            "eu"
          ],
          "enumNames": [
            "US",
            "EU"
          ],
          "title": "Region",
          "type": "string"
        }
      },
      "required": [
        "username",
        "access_key"
      ],
      "title": "LambdaTest Access Key",
      "type": "object",
      "x-credential-instructions": "Copy your username and access key from your LambdaTest (TestMu AI) dashboard's key icon or Account Settings. Screenshot API requires a premium plan. Choose the region that holds your account. NoClick reads your saved login profile names to check the connection.",
      "x-credential-url": "https://accounts.lambdatest.com/detail/profile"
    },
    "LambdatestMcpCredential": {
      "description": "LambdaTest connected through LambdaTest's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "lambdatest_mcp",
          "default": "lambdatest_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "LambdaTest MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://mcp.lambdatest.com/mcp",
      "x-mcp-transport": "shttp"
    },
    "ListBrowsers": {
      "description": "Get supported operating systems and browser versions.",
      "properties": {
        "operation": {
          "const": "list_browsers",
          "default": "list_browsers",
          "title": "Operation",
          "type": "string"
        },
        "os": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional operating system filter, e.g. windows 10.",
          "title": "Os"
        }
      },
      "title": "ListBrowsers",
      "type": "object"
    },
    "ListDevices": {
      "description": "Get supported mobile operating systems and devices.",
      "properties": {
        "operation": {
          "const": "list_devices",
          "default": "list_devices",
          "title": "Operation",
          "type": "string"
        },
        "os": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional operating system filter, e.g. ios 12.0.",
          "title": "Os"
        }
      },
      "title": "ListDevices",
      "type": "object"
    },
    "ListLocations": {
      "description": "Get available geolocation country codes and names.",
      "properties": {
        "operation": {
          "const": "list_locations",
          "default": "list_locations",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListLocations",
      "type": "object"
    },
    "ListProfiles": {
      "description": "Get saved login profiles; stored passwords are redacted from output.",
      "properties": {
        "operation": {
          "const": "list_profiles",
          "default": "list_profiles",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListProfiles",
      "type": "object"
    },
    "ListResolutions": {
      "description": "Get available Mac and Windows screen resolutions.",
      "properties": {
        "operation": {
          "const": "list_resolutions",
          "default": "list_resolutions",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "ListResolutions",
      "type": "object"
    },
    "StartScreenshotTest": {
      "description": "Capture a URL across a chosen browser/device matrix.",
      "properties": {
        "operation": {
          "const": "start_screenshot_test",
          "default": "start_screenshot_test",
          "title": "Operation",
          "type": "string"
        },
        "url": {
          "description": "Full HTTP or HTTPS URL of the website to capture.",
          "title": "Url",
          "type": "string"
        },
        "configs": {
          "additionalProperties": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "description": "OS-to-browser version matrix, e.g. {\"windows 10\":{\"chrome\":[\"76\"]}}. Mobile OS entries use devices as the inner key.",
          "minProperties": 1,
          "title": "Configs",
          "type": "object"
        },
        "defer_time": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds to wait before capture.",
          "title": "Defer Time"
        },
        "email": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Email screenshot results when complete.",
          "title": "Email"
        },
        "mac_res": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mac resolution from List Resolutions.",
          "title": "Mac Res"
        },
        "win_res": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Windows resolution from List Resolutions.",
          "title": "Win Res"
        },
        "tunnel": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use an existing LambdaTest tunnel for a locally hosted site.",
          "title": "Tunnel"
        },
        "tunnel_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tunnel Identifier"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target website's HTTP Basic username, separate from the API account.",
          "title": "Website username"
        },
        "password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Website password",
          "ui:widget": "password"
        },
        "callback_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional destination for results (OpenAPI field callback_url).",
          "title": "Callback Url"
        },
        "smart_scroll": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Smart scroll, as shown in the provider's OpenAPI examples.",
          "title": "Smart Scroll"
        },
        "layout": {
          "anyOf": [
            {
              "enum": [
                "portrait",
                "landscape"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout",
          "enum": [
            "portrait",
            "landscape"
          ],
          "x-enum-searchable": true
        },
        "profile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Saved login profile name from List Profiles.",
          "title": "Profile Id"
        },
        "country_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Country code from List Locations.",
          "title": "Country Code"
        }
      },
      "required": [
        "url",
        "configs"
      ],
      "title": "StartScreenshotTest",
      "type": "object"
    },
    "StopScreenshotTest": {
      "description": "Stop a running screenshot test; completed tests return 404.",
      "properties": {
        "test_id": {
          "description": "Screenshot test ID returned by Start Screenshot Test.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Test Id",
          "type": "string"
        },
        "operation": {
          "const": "stop_screenshot_test",
          "default": "stop_screenshot_test",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "test_id"
      ],
      "title": "StopScreenshotTest",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_screenshot_zip": "#/$defs/GetScreenshotZip",
          "get_screenshots": "#/$defs/GetScreenshots",
          "list_browsers": "#/$defs/ListBrowsers",
          "list_devices": "#/$defs/ListDevices",
          "list_locations": "#/$defs/ListLocations",
          "list_profiles": "#/$defs/ListProfiles",
          "list_resolutions": "#/$defs/ListResolutions",
          "start_screenshot_test": "#/$defs/StartScreenshotTest",
          "stop_screenshot_test": "#/$defs/StopScreenshotTest"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StartScreenshotTest"
        },
        {
          "$ref": "#/$defs/GetScreenshots"
        },
        {
          "$ref": "#/$defs/GetScreenshotZip"
        },
        {
          "$ref": "#/$defs/StopScreenshotTest"
        },
        {
          "$ref": "#/$defs/ListBrowsers"
        },
        {
          "$ref": "#/$defs/ListDevices"
        },
        {
          "$ref": "#/$defs/ListResolutions"
        },
        {
          "$ref": "#/$defs/ListProfiles"
        },
        {
          "$ref": "#/$defs/ListLocations"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/LambdaTestCredential"
        },
        {
          "$ref": "#/$defs/LambdatestMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "Lambdatest Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
