{
  "$defs": {
    "EodhdApisAPITokenCredential": {
      "properties": {
        "credential_type": {
          "const": "eodhd_apis_api_token",
          "default": "eodhd_apis_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "EODHD API Token",
      "type": "object",
      "x-credential-instructions": "Paste your EODHD API token from your account settings. Your subscription determines which datasets you can read. NoClick verifies it with the User API.",
      "x-credential-url": "https://eodhd.com/cp/settings"
    },
    "EodhdGetDividendsCalendarConfig": {
      "description": "Retrieve upcoming dividends calendar.",
      "properties": {
        "operation": {
          "const": "get_dividends_calendar",
          "default": "get_dividends_calendar",
          "title": "Get Dividends Calendar",
          "type": "string",
          "ui:hidden": true
        },
        "date_eq": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact date in 'YYYY-MM-DD' format. Required if `filter[symbol]` is not present.\n",
          "title": "Date Eq"
        },
        "date_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start date in 'YYYY-MM-DD' format.",
          "title": "Date From"
        },
        "date_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End date in 'YYYY-MM-DD' format.",
          "title": "Date To"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ticker symbol (e.g., 'AAPL.US'). When provided, `filter[date_eq]` may be omitted.\n",
          "title": "Symbol"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of records per page (1-10000).",
          "title": "Limit"
        },
        "offset": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pagination offset (0-1000000).",
          "title": "Offset"
        }
      },
      "title": "EodhdGetDividendsCalendarConfig",
      "type": "object"
    },
    "EodhdGetDividendsConfig": {
      "description": "Retrieve historical dividend data.",
      "properties": {
        "operation": {
          "const": "get_dividends",
          "default": "get_dividends",
          "title": "Get Dividends",
          "type": "string",
          "ui:hidden": true
        },
        "ticker": {
          "description": "Ticker symbol of the stock in the format {SYMBOL_NAME}.{EXCHANGE_ID} (e.g., 'AAPL.US' for NASDAQ or 'AAPL.MX' for the Mexican Stock Exchange).",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Ticker",
          "type": "string"
        },
        "from_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start date for data retrieval in 'YYYY-MM-DD' format. Defaults to earliest available data if not provided.",
          "title": "From Date"
        },
        "to_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End date for data retrieval in 'YYYY-MM-DD' format. Defaults to latest available data if not provided.",
          "title": "To Date"
        }
      },
      "required": [
        "ticker"
      ],
      "title": "EodhdGetDividendsConfig",
      "type": "object"
    },
    "EodhdGetEarningsCalendarConfig": {
      "description": "Retrieve upcoming earnings data.",
      "properties": {
        "operation": {
          "const": "get_earnings_calendar",
          "default": "get_earnings_calendar",
          "title": "Get Earnings Calendar",
          "type": "string",
          "ui:hidden": true
        },
        "from_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start date for earnings data, in 'YYYY-MM-DD' format. Defaults to today if not provided.",
          "title": "From Date"
        },
        "to_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End date for earnings data, in 'YYYY-MM-DD' format. Defaults to 7 days from today if not provided.",
          "title": "To Date"
        },
        "symbols": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Specific symbols to retrieve earnings data for, separated by commas (e.g., 'AAPL.US,MSFT.US'). Overrides the 'from' and 'to' parameters if used.",
          "title": "Symbols"
        }
      },
      "title": "EodhdGetEarningsCalendarConfig",
      "type": "object"
    },
    "EodhdGetEodPricesConfig": {
      "description": "Retrieve end-of-day historical price data.",
      "properties": {
        "operation": {
          "const": "get_eod_prices",
          "default": "get_eod_prices",
          "title": "Get EOD Prices",
          "type": "string",
          "ui:hidden": true
        },
        "ticker": {
          "description": "Ticker symbol of the company",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Ticker",
          "type": "string"
        },
        "from_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start date for historical data (YYYY-MM-DD)",
          "title": "From Date"
        },
        "to_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End date for historical data (YYYY-MM-DD)",
          "title": "To Date"
        },
        "period": {
          "anyOf": [
            {
              "enum": [
                "d",
                "w",
                "m"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Data period (e.g., 'd' for daily, 'w' for weekly, 'm' for monthly)",
          "title": "Period",
          "enum": [
            "d",
            "w",
            "m"
          ],
          "x-enum-searchable": true
        },
        "filter": {
          "anyOf": [
            {
              "enum": [
                "last_date",
                "last_open",
                "last_high",
                "last_low",
                "last_close",
                "last_volume"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter for specific last known data points",
          "title": "Filter",
          "enum": [
            "last_date",
            "last_open",
            "last_high",
            "last_low",
            "last_close",
            "last_volume"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "ticker"
      ],
      "title": "EodhdGetEodPricesConfig",
      "type": "object"
    },
    "EodhdGetExchangeDetailsConfig": {
      "description": "Retrieve details for a specific exchange.",
      "properties": {
        "operation": {
          "const": "get_exchange_details",
          "default": "get_exchange_details",
          "title": "Get Exchange Details",
          "type": "string",
          "ui:hidden": true
        },
        "exchange": {
          "description": "Exchange code for which details are to be retrieved (e.g., 'US' for the USA exchange).",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Exchange",
          "type": "string"
        },
        "from_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start date for holiday data (YYYY-MM-DD). Defaults to 6 months before the current date.",
          "title": "From Date"
        },
        "to_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End date for holiday data (YYYY-MM-DD). Defaults to 6 months after the current date.",
          "title": "To Date"
        },
        "format_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Response format version.",
          "title": "Format Version"
        }
      },
      "required": [
        "exchange"
      ],
      "title": "EodhdGetExchangeDetailsConfig",
      "type": "object"
    },
    "EodhdGetFundamentalsConfig": {
      "description": "Retrieve filtered fundamental data for a specific symbol.",
      "properties": {
        "operation": {
          "const": "get_fundamentals",
          "default": "get_fundamentals",
          "title": "Get Fundamentals",
          "type": "string",
          "ui:hidden": true
        },
        "ticker": {
          "description": "The ticker symbol in the format SYMBOL.EXCHANGE, e.g., 'AAPL.US' for Apple Inc. on NASDAQ.",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Ticker",
          "type": "string"
        },
        "filter": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter parameter to specify data section and optional sub-sections, e.g., `Financials::Balance_Sheet::quarterly::2024-06-30`. Supported sections include General, Highlights, Valuation, SharesStats, Technicals, SplitsDividends, AnalystRatings, Holders, InsiderTransactions, ESGScores, outstandingShares, Earnings, and Financials. When omitted, returns all sections.",
          "title": "Filter"
        },
        "historical": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set to 1 to return historical data for certain sections (e.g., outstandingShares).",
          "title": "Historical"
        },
        "from_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start date for historical data in 'YYYY-MM-DD' format.",
          "title": "From Date"
        },
        "to_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End date for historical data in 'YYYY-MM-DD' format.",
          "title": "To Date"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "API version for response format.",
          "title": "Version"
        },
        "no_cache": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set to 1 to bypass cache and get fresh data.",
          "title": "No Cache"
        }
      },
      "required": [
        "ticker"
      ],
      "title": "EodhdGetFundamentalsConfig",
      "type": "object"
    },
    "EodhdGetIntradayPricesConfig": {
      "description": "Retrieve intraday historical price data.",
      "properties": {
        "operation": {
          "const": "get_intraday_prices",
          "default": "get_intraday_prices",
          "title": "Get Intraday Prices",
          "type": "string",
          "ui:hidden": true
        },
        "ticker": {
          "description": "Ticker symbol with exchange code (e.g., 'AAPL.US').",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Ticker",
          "type": "string"
        },
        "interval": {
          "description": "Interval for data points. Options are '1m' (1 minute), '5m' (5 minutes), '15m' (15 minutes), '30m' (30 minutes), and '1h' (1 hour).",
          "enum": [
            "1m",
            "5m",
            "15m",
            "30m",
            "1h"
          ],
          "title": "Interval",
          "type": "string"
        },
        "from_timestamp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start datetime in Unix timestamp (UTC). For example, 1627896900 for '2021-08-02 09:35:00'.",
          "title": "From Timestamp"
        },
        "to_timestamp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End datetime in Unix timestamp (UTC). For example, 1630575300 for '2021-09-02 09:35:00'.",
          "title": "To Timestamp"
        }
      },
      "required": [
        "ticker",
        "interval"
      ],
      "title": "EodhdGetIntradayPricesConfig",
      "type": "object"
