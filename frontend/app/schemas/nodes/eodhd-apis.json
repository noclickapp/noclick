        "to_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End date for news data (YYYY-MM-DD)",
          "title": "To Date"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The number of results to return",
          "title": "Limit"
        },
        "offset": {
          "anyOf": [
            {
              "maximum": 9000,
