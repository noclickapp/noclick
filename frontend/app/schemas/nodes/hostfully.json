      "title": "CreateJob",
      "type": "object"
    },
    "CreateLead": {
      "additionalProperties": false,
      "description": "Create an inquiry, hold, booking or availability block.",
      "properties": {
        "operation": {
          "const": "create_lead",
          "default": "create_lead",
          "title": "Operation",
          "type": "string"
        },
        "property_uid": {
