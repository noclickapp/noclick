        "status": {
          "default": "NEW",
          "enum": [
            "NEW",
            "ON_HOLD",
            "BOOKED",
            "BLOCKED"
          ],
          "title": "Status",
          "type": "string"
        },
        "check_in_date": {
          "format": "date",
          "title": "Check In Date",
          "type": "string"
        },
        "check_out_date": {
          "format": "date",
          "title": "Check Out Date",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "maxLength": 320,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Guest email; required except for availability blocks.",
          "title": "Email"
        },
        "first_name": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
