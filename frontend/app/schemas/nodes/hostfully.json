            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required by Hostfully when property UID identifies a unit type.",
          "title": "Unit Uid"
        }
      },
      "required": [
        "property_uid",
        "check_in_date",
        "check_out_date"
      ],
      "title": "CreateLead",
      "type": "object"
