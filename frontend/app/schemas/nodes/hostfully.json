    "BookLead": {
      "additionalProperties": false,
      "description": "Transform an inquiry to a booking.",
      "properties": {
        "operation": {
          "const": "book_lead",
          "default": "book_lead",
          "title": "Operation",
          "type": "string"
        },
        "lead_uid": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Lead Uid",
          "type": "string"
        }
      },
      "required": [
        "lead_uid"
      ],
      "title": "BookLead",
      "type": "object"
    },
    "CancelLead": {
      "additionalProperties": false,
