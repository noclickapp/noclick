        {
          "$ref": "#/$defs/SearchGoogleAdsConfig"
        },
        {
          "$ref": "#/$defs/SearchLinkedInAdsConfig"
        },
        {
          "$ref": "#/$defs/SearchLinkedInKeywordsConfig"
        },
        {
          "$ref": "#/$defs/SearchMetaKeywordsConfig"
        },
        {
          "$ref": "#/$defs/CreateGoogleShoppingSearchConfig"
        },
        {
          "$ref": "#/$defs/GetGoogleShoppingStatusConfig"
        },
        {
          "$ref": "#/$defs/SearchTikTokAdsConfig"
        },
        {
          "$ref": "#/$defs/GetTikTokAdDetailsConfig"
        },
        {
          "$ref": "#/$defs/GetDomainKeywordsConfig"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdyntelAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Adyntel Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
