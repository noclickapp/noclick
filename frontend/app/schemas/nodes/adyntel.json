{
  "$defs": {
    "AdyntelAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "adyntel_api_key",
          "default": "adyntel_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "email": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Account email",
          "type": "string"
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "email",
        "api_key"
      ],
      "title": "Adyntel API Key",
      "type": "object",
      "x-credential-instructions": "Copy your API key from your Adyntel profile under Integrations and enter the same account email. NoClick sends both in JSON to api.adyntel.com. Connecting searches TikTok for the documented keyword toys to check API reachability and can consume one credit; it does not establish account identity. Searches and Shopping job creation use Adyntel credits. Provider-side all-ads requests can use many credits and cannot be stopped.",
      "x-credential-url": "https://platform.adyntel.com"
    },
    "CreateGoogleShoppingSearchConfig": {
      "additionalProperties": false,
      "description": "Google Shopping Ads.",
      "properties": {
        "operation": {
          "const": "create_google_shopping_search",
          "default": "create_google_shopping_search",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company_domain": {
          "description": "Company website Use a bare domain without www, a protocol or a path.",
          "minLength": 1,
          "title": "Company Domain",
          "type": "string"
        },
        "shopping": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, use Railway parser for direct synchronous results. When false, use DataForSEO (async, poll with /google_shopping_status).",
          "title": "Shopping"
        }
      },
      "required": [
        "company_domain"
      ],
      "title": "CreateGoogleShoppingSearchConfig",
      "type": "object"
    },
    "GetDomainKeywordsConfig": {
      "additionalProperties": false,
      "description": "Paid vs Organic Keywords.",
      "properties": {
        "operation": {
          "const": "get_domain_keywords",
          "default": "get_domain_keywords",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company_domain": {
          "description": "Company website (without www or http) Use a bare domain without www, a protocol or a path.",
          "minLength": 1,
          "title": "Company Domain",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Language for keyword results",
          "title": "Language"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of results to return",
          "title": "Limit"
        }
      },
      "required": [
        "company_domain"
      ],
      "title": "GetDomainKeywordsConfig",
      "type": "object"
    },
    "GetGoogleShoppingStatusConfig": {
      "additionalProperties": false,
      "description": "Google Shopping Status.",
      "properties": {
        "operation": {
          "const": "get_google_shopping_status",
          "default": "get_google_shopping_status",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "The id you received as response",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetGoogleShoppingStatusConfig",
      "type": "object"
    },
    "GetTikTokAdDetailsConfig": {
      "additionalProperties": false,
      "description": "TikTok Ad Details.",
      "properties": {
        "operation": {
          "const": "get_tiktok_ad_details",
          "default": "get_tiktok_ad_details",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "id": {
          "description": "Ad id",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetTikTokAdDetailsConfig",
      "type": "object"
    },
    "SearchFacebookAdsConfig": {
      "additionalProperties": false,
      "description": "Facebook & Instagram Ads.",
      "properties": {
        "operation": {
          "const": "search_facebook_ads",
          "default": "search_facebook_ads",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "facebook_url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Facebook page url (needs to start with https://)",
          "title": "Facebook Url"
        },
        "company_domain": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Company website Use a bare domain without www, a protocol or a path.",
          "title": "Company Domain"
        },
        "country_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parameter used to filter results for a specific country.",
          "title": "Country Code"
        },
        "continuation_token": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Token used to grab the next set of ads",
          "title": "Continuation Token"
        },
        "media_type": {
          "anyOf": [
            {
              "enum": [
                "image",
                "meme",
                "image_and_meme",
                "video"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parameter used to filter results for a specific type of media.",
          "title": "Media Type",
          "enum": [
            "image",
            "meme",
            "image_and_meme",
            "video"
          ],
          "x-enum-searchable": true
        },
        "active_status": {
          "anyOf": [
            {
              "enum": [
                "inactive",
                "all"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "This filters the search in the ad library by active, inactive or all ads.",
          "title": "Active Status",
          "enum": [
            "inactive",
            "all"
          ],
          "x-enum-searchable": true
        },
        "all_ads": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "This will automatically use the continuation_token and scrape all the pages, returning all available ads.",
          "title": "All Ads"
        },
        "webhook_url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Webhook URL where the data will be returned",
          "title": "Webhook Url"
        }
      },
      "title": "SearchFacebookAdsConfig",
      "type": "object"
    },
    "SearchGoogleAdsConfig": {
      "additionalProperties": false,
      "description": "Google Ads.",
      "properties": {
        "operation": {
          "const": "search_google_ads",
          "default": "search_google_ads",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "company_domain": {
          "description": "Company website Use a bare domain without www, a protocol or a path.",
          "minLength": 1,
          "title": "Company Domain",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "enum": [
                "text",
                "image",
                "video"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter results based on media type. Possible values: text, image, video.",
          "title": "Media Type",
          "enum": [
            "text",
            "image",
            "video"
          ],
          "x-enum-searchable": true
        },
        "continuation_token": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Token used to grab the next set of ads",
          "title": "Continuation Token"
        },
        "all_ads": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "This will automatically use the continuation_token and scrape all the pages, returning all available ads. Works only with a webhook_url as it needs a place to send each page, one by one. Warning: use this cautiously because there is no way of stopping it. If you use this on a domain that runs 10000 ads, it will try to scrape all the ads and it will use the credits (one page = one credit)",
          "title": "All Ads"
        },
        "extract_text": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extract text content from ad creatives",
          "title": "Extract Text"
        },
        "webhook_url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Webhook URL for async delivery",
          "title": "Webhook Url"
        },
        "data_provider": {
          "anyOf": [
            {
              "enum": [
                "rapidapi",
                "apify"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Data provider to use",
          "title": "Data Provider",
          "enum": [
            "rapidapi",
            "apify"
          ],
          "x-enum-searchable": true
        }
      },
      "required": [
        "company_domain"
      ],
      "title": "SearchGoogleAdsConfig",
      "type": "object"
    },
    "SearchLinkedInAdsConfig": {
      "additionalProperties": false,
