  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "create_google_shopping_search": "#/$defs/CreateGoogleShoppingSearchConfig",
          "get_domain_keywords": "#/$defs/GetDomainKeywordsConfig",
          "get_google_shopping_status": "#/$defs/GetGoogleShoppingStatusConfig",
          "get_tiktok_ad_details": "#/$defs/GetTikTokAdDetailsConfig",
          "search_facebook_ads": "#/$defs/SearchFacebookAdsConfig",
          "search_google_ads": "#/$defs/SearchGoogleAdsConfig",
          "search_linkedin_ads": "#/$defs/SearchLinkedInAdsConfig",
          "search_linkedin_keywords": "#/$defs/SearchLinkedInKeywordsConfig",
          "search_meta_keywords": "#/$defs/SearchMetaKeywordsConfig",
          "search_tiktok_ads": "#/$defs/SearchTikTokAdsConfig"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SearchFacebookAdsConfig"
