            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Webhook URL where the data will be returned",
          "title": "Webhook Url"
        },
        "data_provider": {
          "anyOf": [
            {
              "enum": [
                "rapidapi",
                "apify"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Data provider to use",
          "title": "Data Provider",
          "enum": [
            "rapidapi",
            "apify"
          ],
          "x-enum-searchable": true
        }
      },
      "title": "SearchLinkedInAdsConfig",
      "type": "object"
    },
    "SearchLinkedInKeywordsConfig": {
      "additionalProperties": false,
      "description": "LinkedIn Keyword Search.",
      "properties": {
        "operation": {
          "const": "search_linkedin_keywords",
          "default": "search_linkedin_keywords",
          "title": "Operation",
          "type": "string",
          "ui:hidden": true
        },
        "keyword": {
          "description": "Company website",
          "minLength": 1,
          "title": "Keyword",
          "type": "string"
        },
        "country": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The 2-digit country code",
          "title": "Country"
        },
        "dateOption": {
          "anyOf": [
            {
              "enum": [
                "current-month",
                "current-year",
                "last-30-days",
                "last-year",
                "custom-date-range"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Valid options: current-month, current-year, custom-date-range, last-30-days, last-year or custom-date-range",
          "title": "Dateoption",
          "enum": [
            "current-month",
            "current-year",
            "last-30-days",
            "last-year",
            "custom-date-range"
          ],
          "x-enum-searchable": true
        },
        "startDate": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD format (e.g. 2026-01-15)",
          "title": "Startdate"
        },
        "endDate": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD format (e.g. 2026-01-15)",
          "title": "Enddate"
        },
        "continuation_token": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A token that you can use to scrape the next page",
          "title": "Continuation Token"
        }
      },
      "required": [
        "keyword"
      ],
      "title": "SearchLinkedInKeywordsConfig",
      "type": "object"
    },
