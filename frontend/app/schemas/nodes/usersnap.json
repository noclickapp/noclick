{
  "$defs": {
    "Attachment": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "contentEncoding": "base64",
          "description": "Base64 file content, at most 20 MiB decoded.",
          "title": "Content",
          "type": "string"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "mime_type": {
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        }
      },
      "required": [
        "content",
        "filename",
        "mime_type"
      ],
      "title": "Attachment",
      "type": "object"
    },
    "ClientInfo": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "screen_width": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screen Width"
        },
        "screen_height": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screen Height"
        }
      },
      "title": "ClientInfo",
      "type": "object"
    },
    "CountFeedback": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "description": "Project ID returned by List Projects; this is different from its API key.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project ID",
          "type": "string"
        },
        "operation": {
          "const": "count_feedback",
          "default": "count_feedback",
          "title": "Count Feedback",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "CountFeedback",
      "type": "object"
    },
    "CountFilteredFeedback": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "description": "Project ID returned by List Projects; this is different from its API key.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project ID",
          "type": "string"
        },
        "query": {
          "items": {
            "$ref": "#/$defs/FeedbackFilter"
          },
          "title": "Filters",
          "type": "array"
        },
        "order_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeedbackOrder"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort order"
        },
        "operation": {
          "const": "count_filtered_feedback",
          "default": "count_filtered_feedback",
          "title": "Count Filtered Feedback",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "CountFilteredFeedback",
      "type": "object"
    },
    "FeedbackFilter": {
      "additionalProperties": false,
      "properties": {
        "filter_type": {
          "enum": [
            "assignee",
            "created_at",
            "email",
            "feedback_number",
            "nps",
            "one_to_five",
            "state",
            "thumb"
          ],
          "title": "Filter Type",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "in",
            "not_in",
            "gt",
            "gte",
            "lt",
            "lte",
            "like",
            "ilike"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "filter_type",
        "operator",
        "value"
      ],
      "title": "FeedbackFilter",
      "type": "object"
    },
    "FeedbackOrder": {
      "additionalProperties": false,
      "properties": {
        "order_by_type": {
          "default": "created_at",
          "enum": [
            "created_at",
            "rating",
            "updated_at",
            "likes"
          ],
          "title": "Order By Type",
          "type": "string"
        },
        "direction": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "title": "FeedbackOrder",
      "type": "object"
    },
    "FilterFeedback": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "description": "Project ID returned by List Projects; this is different from its API key.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project ID",
          "type": "string"
        },
        "query": {
          "items": {
            "$ref": "#/$defs/FeedbackFilter"
          },
          "title": "Filters",
          "type": "array"
        },
        "order_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeedbackOrder"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort order"
        },
        "operation": {
          "const": "filter_feedback",
          "default": "filter_feedback",
          "title": "Filter Feedback",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "FilterFeedback",
      "type": "object"
    },
    "FindFeedbackByEmail": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "description": "Project ID returned by List Projects; this is different from its API key.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project ID",
          "type": "string"
        },
        "operation": {
          "const": "find_feedback_by_email",
          "default": "find_feedback_by_email",
          "title": "Find Feedback by Email",
          "type": "string"
        },
        "email": {
          "description": "Exact email match using the documented email eq filter.",
          "minLength": 1,
          "title": "Visitor email",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "email"
      ],
      "title": "FindFeedbackByEmail",
      "type": "object"
    },
    "FindFeedbackByState": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "description": "Project ID returned by List Projects; this is different from its API key.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project ID",
          "type": "string"
        },
        "operation": {
          "const": "find_feedback_by_state",
          "default": "find_feedback_by_state",
          "title": "Find Feedback by State",
          "type": "string"
        },
        "state": {
          "description": "State value using the documented state eq filter; for example done.",
          "minLength": 1,
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "state"
      ],
      "title": "FindFeedbackByState",
      "type": "object"
    },
    "GetProjectMetrics": {
      "additionalProperties": false,
      "properties": {
        "project_api_key": {
          "description": "Project api_key returned by List Projects or the widget settings; this is different from its project ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project API key",
          "type": "string"
        },
        "operation": {
          "const": "get_project_metrics",
          "default": "get_project_metrics",
          "title": "Get Project Metrics",
          "type": "string"
        }
      },
      "required": [
        "project_api_key"
      ],
      "title": "GetProjectMetrics",
      "type": "object"
    },
    "ListFeedback": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "description": "Project ID returned by List Projects; this is different from its API key.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project ID",
          "type": "string"
        },
        "operation": {
          "const": "list_feedback",
          "default": "list_feedback",
          "description": "Returns one provider page, including has_more and next when present. The pinned contract does not define continuation request parameters.",
          "title": "List Feedback",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ListFeedback",
      "type": "object"
    },
    "ListProjectAssignees": {
      "additionalProperties": false,
      "properties": {
        "project_api_key": {
          "description": "Project api_key returned by List Projects or the widget settings; this is different from its project ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project API key",
          "type": "string"
        },
        "operation": {
          "const": "list_project_assignees",
          "default": "list_project_assignees",
          "title": "List Project Assignees",
          "type": "string"
        }
      },
      "required": [
        "project_api_key"
      ],
      "title": "ListProjectAssignees",
      "type": "object"
    },
    "ListProjects": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_projects",
          "default": "list_projects",
          "title": "List Projects",
          "type": "string"
        }
      },
      "title": "ListProjects",
      "type": "object"
    },
    "SubmitFeedback": {
      "additionalProperties": false,
      "properties": {
        "project_api_key": {
          "description": "Project api_key returned by List Projects or the widget settings; this is different from its project ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Project API key",
          "type": "string"
        },
        "operation": {
          "const": "submit_feedback",
          "default": "submit_feedback",
          "title": "Submit Feedback",
          "type": "string"
        },
        "visitor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visitor email"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "assignee": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "User ID or email; omit to use the default assignee. Explicit null leaves the feedback unassigned.",
          "title": "Assignee"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use the project's scale: NPS 1\u201310; stars/smileys 1\u20135; thumbs 1 or -1.",
          "title": "Rating"
        },
        "client": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClientInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attachments": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Attachment"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attachments"
        }
      },
      "required": [
        "project_api_key"
      ],
      "title": "SubmitFeedback",
      "type": "object"
    },
    "UsersnapMcpCredential": {
      "description": "Usersnap connected through Usersnap's MCP server: agents get its tools.",
      "properties": {
        "mcp_server_url": {
          "title": "MCP server",
          "type": "string",
          "ui:hidden": true
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Token",
          "ui:hidden": true
        },
        "refresh_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Token",
          "ui:hidden": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At",
          "ui:hidden": true
        },
        "token_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type",
          "ui:hidden": true
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope",
          "ui:hidden": true
        },
        "token_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint",
          "ui:hidden": true
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id",
          "ui:hidden": true
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret",
          "ui:hidden": true
        },
        "token_endpoint_auth_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint Auth Method",
          "ui:hidden": true
        },
        "resource_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Url",
          "ui:hidden": true
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key",
          "ui:hidden": true
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account",
          "ui:hidden": true
        },
        "credential_type": {
          "const": "usersnap_mcp",
          "default": "usersnap_mcp",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        }
      },
      "required": [
        "mcp_server_url"
      ],
      "title": "Usersnap MCP",
      "type": "object",
      "x-credential-type": "mcp",
      "x-mcp-server": "https://mcp.usersnap.com/mcp",
      "x-mcp-transport": "shttp"
    },
    "UsersnapTokenCredential": {
      "properties": {
        "credential_type": {
          "const": "usersnap_api_token",
          "default": "usersnap_api_token",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_token": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "API token",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_token"
      ],
      "title": "Usersnap API Token",
      "type": "object",
      "x-credential-instructions": "Requires a Usersnap Enterprise plan with REST API access. Paste a JWT you have signed using HS256 and the JWT secret from Settings > REST API, with the generated JWT ID in the kid header. Paste the finished token, without Bearer; do not paste the signing secret. NoClick sends it only to platform.usersnap.com. See https://help.usersnap.com/reference/platform-rest-api.",
      "x-credential-url": "https://app.usersnap.com/#/settings/rest-api"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "count_feedback": "#/$defs/CountFeedback",
          "count_filtered_feedback": "#/$defs/CountFilteredFeedback",
          "filter_feedback": "#/$defs/FilterFeedback",
          "find_feedback_by_email": "#/$defs/FindFeedbackByEmail",
          "find_feedback_by_state": "#/$defs/FindFeedbackByState",
          "get_project_metrics": "#/$defs/GetProjectMetrics",
          "list_feedback": "#/$defs/ListFeedback",
          "list_project_assignees": "#/$defs/ListProjectAssignees",
          "list_projects": "#/$defs/ListProjects",
          "submit_feedback": "#/$defs/SubmitFeedback"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListProjects"
        },
        {
          "$ref": "#/$defs/GetProjectMetrics"
        },
        {
          "$ref": "#/$defs/ListProjectAssignees"
        },
        {
          "$ref": "#/$defs/SubmitFeedback"
        },
        {
          "$ref": "#/$defs/ListFeedback"
        },
        {
          "$ref": "#/$defs/CountFeedback"
        },
        {
          "$ref": "#/$defs/FilterFeedback"
        },
        {
          "$ref": "#/$defs/CountFilteredFeedback"
        },
        {
          "$ref": "#/$defs/FindFeedbackByEmail"
        },
        {
          "$ref": "#/$defs/FindFeedbackByState"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/UsersnapTokenCredential"
        },
        {
          "$ref": "#/$defs/UsersnapMcpCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)",
      "title": "Credentials"
    }
  },
  "required": [
    "config"
  ],
  "title": "Usersnap Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
