{
  "$defs": {
    "AdyenApiKeyCredential": {
      "additionalProperties": false,
      "properties": {
        "credential_type": {
          "const": "adyen_api_key",
          "default": "adyen_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Adyen API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "environment": {
          "description": "Test and live keys are separate. This connection uses fixed Management v3 endpoints.",
          "enum": [
            "test",
            "live"
          ],
          "title": "Adyen Environment",
          "type": "string"
        },
        "expected_api_credential_id": {
          "description": "Must match the protected Management /me response. This identifies a service credential, not a person.",
          "title": "Expected API Credential ID",
          "type": "string"
        },
        "company_id": {
          "description": "Restricts merchant selection to this company. A successful company read proves access, not personal ownership.",
          "title": "Authorized Company ID",
          "type": "string"
        },
        "live_url_prefix": {
          "anyOf": [
            {
              "maxLength": 63,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actual prefix issued in your Adyen Customer Area, hex part followed by a hyphen and company name. Needed only for live payment-link status.",
          "title": "Checkout Live URL Prefix"
        }
      },
      "required": [
        "api_key",
        "environment",
        "expected_api_credential_id",
        "company_id"
      ],
      "title": "Adyen API Key",
      "type": "object",
      "x-credential-url": "https://docs.adyen.com/development-resources/api-authentication"
    },
    "GetCompany": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_company",
          "default": "get_company",
          "title": "Get Connected Company Metadata",
          "type": "string",
          "x-operation-group": "Company"
        }
      },
      "title": "GetCompany",
      "type": "object"
    },
    "GetIdentity": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_identity",
          "default": "get_identity",
          "title": "Get API Credential and Company Evidence",
          "type": "string",
          "x-operation-group": "Connection"
        }
      },
      "title": "GetIdentity",
      "type": "object"
    },
    "GetMerchant": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_merchant",
          "default": "get_merchant",
          "title": "Get Company Merchant Metadata",
          "type": "string",
          "x-operation-group": "Merchants"
        },
        "merchant_id": {
          "title": "Merchant",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "merchant_id",
            "placeholder": "Select or type an ID",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "adyen_merchant"
        }
      },
      "required": [
        "merchant_id"
      ],
      "title": "GetMerchant",
      "type": "object"
    },
    "GetPaymentLinkStatus": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_payment_link_status",
          "default": "get_payment_link_status",
          "title": "Get Payment Link Status",
          "type": "string",
          "x-operation-group": "Payment Status"
        },
        "merchant_id": {
          "title": "Merchant",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "merchant_id",
            "placeholder": "Select or type an ID",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "adyen_merchant"
        },
        "link_id": {
          "description": "Reads status only, verifying the returned merchant account. Does not return the payment URL, amount, reference or shopper information.",
          "title": "Existing Payment Link ID",
          "type": "string",
          "x-resource-type": "adyen_payment_link"
        }
      },
      "required": [
        "merchant_id",
        "link_id"
      ],
      "title": "GetPaymentLinkStatus",
      "type": "object"
    },
    "GetStore": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "get_store",
          "default": "get_store",
          "title": "Get Merchant Store Metadata",
          "type": "string",
          "x-operation-group": "Stores"
        },
        "merchant_id": {
          "title": "Merchant",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "merchant_id",
            "placeholder": "Select or type an ID",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "adyen_merchant"
        },
        "store_id": {
          "title": "Store",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "depends_on": "merchant_id",
            "field_name": "store_id",
            "placeholder": "Select or type an ID",
            "searchable": true
          },
          "x-resource-type": "adyen_store"
        }
      },
      "required": [
        "merchant_id",
        "store_id"
      ],
      "title": "GetStore",
      "type": "object"
    },
    "ListMerchants": {
      "additionalProperties": false,
      "properties": {
        "page_size": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 18000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation",
          "ui:hidden": true
        },
        "operation": {
          "const": "list_merchants",
          "default": "list_merchants",
          "title": "List Connected Company Merchants",
          "type": "string",
          "x-operation-group": "Merchants"
        }
      },
      "title": "ListMerchants",
      "type": "object"
    },
    "ListStores": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "list_stores",
          "default": "list_stores",
          "title": "List Merchant Stores",
          "type": "string",
          "x-operation-group": "Stores"
        },
        "merchant_id": {
          "title": "Merchant",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "merchant_id",
            "placeholder": "Select or type an ID",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "adyen_merchant"
        },
        "page_size": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "page_token": {
          "anyOf": [
            {
              "maxLength": 18000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation",
          "ui:hidden": true
        }
      },
      "required": [
        "merchant_id"
      ],
      "title": "ListStores",
      "type": "object"
    },
    "UpdateStoreDescription": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "update_store_description",
          "default": "update_store_description",
          "title": "Update Store Description",
          "type": "string",
          "x-operation-group": "Store Management"
        },
        "merchant_id": {
          "title": "Merchant",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "field_name": "merchant_id",
            "placeholder": "Select or type an ID",
            "searchable": true,
            "auto_select_sole_option": true
          },
          "x-resource-type": "adyen_merchant"
        },
        "store_id": {
          "title": "Store",
          "type": "string",
          "x-dynamic-options": {
            "allow_custom": true,
            "depends_on": "merchant_id",
            "field_name": "store_id",
            "placeholder": "Select or type an ID",
            "searchable": true
          },
          "x-resource-type": "adyen_store"
        },
        "description": {
          "description": "Changes only the existing store description; the text is not returned in workflow outputs.",
          "maxLength": 300,
          "minLength": 1,
          "title": "New Store Description",
          "type": "string"
        },
        "confirm_store_change": {
          "const": true,
          "description": "Changes this authorized merchant's store metadata. Notifications and automation are not qualified.",
          "title": "Confirm Store Description Change",
          "type": "boolean"
        }
      },
      "required": [
        "merchant_id",
        "store_id",
        "description",
        "confirm_store_change"
      ],
      "title": "UpdateStoreDescription",
      "type": "object"
    }
  },
  "properties": {
    "config": {
      "description": "Node-specific configuration",
      "discriminator": {
        "mapping": {
          "get_company": "#/$defs/GetCompany",
          "get_identity": "#/$defs/GetIdentity",
          "get_merchant": "#/$defs/GetMerchant",
          "get_payment_link_status": "#/$defs/GetPaymentLinkStatus",
          "get_store": "#/$defs/GetStore",
          "list_merchants": "#/$defs/ListMerchants",
          "list_stores": "#/$defs/ListStores",
          "update_store_description": "#/$defs/UpdateStoreDescription"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GetIdentity"
        },
        {
          "$ref": "#/$defs/GetCompany"
        },
        {
          "$ref": "#/$defs/ListMerchants"
        },
        {
          "$ref": "#/$defs/GetMerchant"
        },
        {
          "$ref": "#/$defs/ListStores"
        },
        {
          "$ref": "#/$defs/GetStore"
        },
        {
          "$ref": "#/$defs/UpdateStoreDescription"
        },
        {
          "$ref": "#/$defs/GetPaymentLinkStatus"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdyenApiKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Adyen Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
}
