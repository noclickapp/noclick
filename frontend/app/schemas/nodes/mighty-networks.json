    "MightyNetworksAPIKeyCredential": {
      "additionalProperties": false,
      "properties": {
        "network_id": {
          "description": "Actual numeric ID of the intended Mighty Network. Bound to every request and checked against network.resourceId; this form does not accept arbitrary hosts.",
          "pattern": "^[1-9][0-9]{0,19}$",
          "title": "Network Numeric ID",
          "type": "string"
        },
        "allow_management_writes": {
          "default": false,
          "description": "Off by default. Enables private-space creation, names, collection/tag management and owned draft posts. Provider webhooks/automations may react; no notification suppression is promised for metadata writes.",
          "title": "Allow Management Writes",
          "type": "boolean"
        },
        "credential_type": {
          "const": "mighty_networks_api_key",
          "default": "mighty_networks_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Issued in Network Admin \u2192 Integrations \u2192 Mighty API. Acts as its host, holds host scopes only and never expires until revoked. Admin REST keys are a different credential. Scale or above is required by the vendor; your plan/access is unverified.",
          "title": "Mighty API Host Key",
          "type": "string",
          "ui:widget": "password"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact host scopes selected for this key, when known. Unknown stays unknown; these supplied labels are not independent provider proof.",
          "title": "Scope"
        }
      },
      "required": [
        "network_id",
        "api_key"
      ],
      "title": "Mighty Networks API Key",
      "type": "object",
      "x-credential-url": "https://docs.mightynetworks.com/api/api-keys"
    },
