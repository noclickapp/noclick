            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Day of week (0=Sunday, 6=Saturday)",
          "title": "Dayofweek"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
