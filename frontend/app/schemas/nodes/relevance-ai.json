    "TriggerAgent": {
      "description": "Send a user message to start an agent or continue a conversation; returns job metadata, not the agent's final answer.",
      "properties": {
        "operation": {
          "const": "trigger_agent",
          "default": "trigger_agent",
          "title": "Trigger Agent",
          "type": "string",
          "ui:hidden": true
        },
        "agent_id": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Agent ID",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "conversation_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Continue this conversation; omit to start a new one.",
          "title": "Conversation Id"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source-system conversation ID. By default an existing ID does not create a second conversation.",
          "title": "External Id"
        },
        "external_id_behaviour": {
          "anyOf": [
            {
              "enum": [
                "nothing",
                "extend-conversation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id Behaviour",
          "enum": [
            "nothing",
            "extend-conversation"
          ],
          "x-enum-searchable": true
        },
        "params": {
          "anyOf": [
            {
              "contentMediaType": "application/json",
              "contentSchema": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Inputs JSON",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        }
      },
      "required": [
        "agent_id",
        "message"
      ],
      "title": "TriggerAgent",
      "type": "object"
    }
