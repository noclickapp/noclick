        {
          "$ref": "#/$defs/TriggerAgent"
        },
        {
          "$ref": "#/$defs/ListConversations"
        },
        {
          "$ref": "#/$defs/ListKnowledgeSets"
        },
        {
          "$ref": "#/$defs/GetKnowledgeMetadata"
        },
        {
          "$ref": "#/$defs/ListKnowledge"
        },
        {
          "$ref": "#/$defs/AddKnowledge"
        },
        {
          "$ref": "#/$defs/DeleteKnowledge"
        }
      ],
      "title": "Config"
    },
    "credentials": {
      "anyOf": [
        {
          "$ref": "#/$defs/RelevanceAIAPIKeyCredential"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credentials for this node (optional if using environment variables)"
    }
  },
  "required": [
    "config"
  ],
  "title": "Relevance-ai Node Configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-agent-tool-provider": true
