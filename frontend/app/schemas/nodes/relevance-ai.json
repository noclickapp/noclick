{
  "$defs": {
    "AddKnowledge": {
      "description": "Add text or JSON documents to a table (published endpoint; currently unsupported by provider).",
      "properties": {
        "operation": {
          "const": "add_knowledge",
          "default": "add_knowledge",
          "title": "Add Knowledge",
          "type": "string",
          "ui:hidden": true
        },
        "knowledge_set": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Knowledge Table ID",
          "type": "string"
        },
        "data": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "items": {
              "discriminator": {
                "mapping": {
                  "document": "#/$defs/DocumentKnowledge",
                  "text": "#/$defs/TextKnowledge"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextKnowledge"
                },
                {
                  "$ref": "#/$defs/DocumentKnowledge"
                }
              ]
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "description": "Array of text or document records, e.g. [{\"type\":\"text\",\"value\":\"Company policy\"}]. Optional document_id identifies a row.",
          "title": "Documents JSON",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "chunk_and_vectorize_on_upload": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ask the provider to chunk and vectorize the uploaded records.",
          "title": "Chunk And Vectorize On Upload"
        }
      },
      "required": [
        "knowledge_set",
        "data"
      ],
      "title": "AddKnowledge",
      "type": "object"
    },
    "DeleteKnowledge": {
      "description": "Delete one knowledge row (published endpoint; currently unsupported by provider).",
      "properties": {
        "operation": {
          "const": "delete_knowledge",
          "default": "delete_knowledge",
          "title": "Delete Knowledge Row",
          "type": "string",
          "ui:hidden": true
        },
        "knowledge_set": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Knowledge Table ID",
          "type": "string"
        },
        "document_id": {
          "description": "One explicit row ID; required to avoid deleting the whole table.",
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Document ID",
          "type": "string"
        }
      },
      "required": [
        "knowledge_set",
        "document_id"
      ],
      "title": "DeleteKnowledge",
      "type": "object"
    },
    "DocumentKnowledge": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "document",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "additionalProperties": true,
          "title": "Value",
          "type": "object"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DocumentKnowledge",
      "type": "object"
    },
