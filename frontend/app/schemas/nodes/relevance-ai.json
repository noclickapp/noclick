    "RelevanceAIAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "relevance_ai_api_key",
          "default": "relevance_ai_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "project_id": {
          "description": "The project ID from your Relevance AI project settings.",
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Project ID",
          "type": "string"
        },
        "api_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "API Key",
          "type": "string",
          "ui:widget": "password"
        },
        "region": {
          "default": "au",
          "description": "Select the region of your project: Australia, United States or Europe.",
          "enum": [
            "au",
            "us",
            "eu"
          ],
          "title": "Region",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "api_key"
      ],
      "title": "Relevance AI API Key",
      "type": "object",
      "x-credential-instructions": "In your Relevance AI project settings, copy the project ID and API key, and select the project's region. Paste the key alone; NoClick sends project:key in Authorization. Use a project key with permissions for the selected operations, not an embed key. The provider officially supports triggering agents and tools; other published API endpoints are currently unsupported.",
      "x-credential-url": "https://relevanceai.com/docs/sdk/authentication"
    },
    "RunTool": {
      "description": "Run a tool once. Preserve output, status and execution errors.",
      "properties": {
        "studio_id": {
          "description": "studio_id of the tool.",
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Tool ID",
          "type": "string"
        },
        "params": {
          "contentMediaType": "application/json",
          "contentSchema": {
            "additionalProperties": true,
            "type": "object"
          },
          "default": "{}",
          "description": "JSON object keyed by the tool's input names.",
          "title": "Tool Inputs JSON",
          "type": "string",
          "ui:widget": "code_editor",
          "x-code-language": "json"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "active, draft, or a specific version ID.",
          "title": "Tool Version"
