{
  "$defs": {
    "BluepillowAPIKeyCredential": {
      "properties": {
        "credential_type": {
          "const": "bluepillow_api_key",
          "default": "bluepillow_api_key",
          "title": "Credential Type",
          "type": "string",
          "ui:hidden": true
        },
        "api_key": {
          "description": "Paste the key only, without Bearer or quotes.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "API key",
          "type": "string",
          "ui:widget": "password"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "Bluepillow API Key",
      "type": "object",
      "x-credential-instructions": "Generate an anonymous API key at b2a.bluepillow.com and paste it here. No signup or email is needed. Reuse your existing key. Keys identify a rate-limit bucket, not an account; connecting checks acceptance only.",
      "x-credential-url": "https://b2a.bluepillow.com/"
    },
    "DiscoverDestinations": {
      "additionalProperties": false,
      "description": "Discover destinations within a radius of a coordinate.",
      "properties": {
        "operation": {
          "const": "discover_destinations",
          "default": "discover_destinations",
          "title": "Operation",
          "type": "string"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "radius_km": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "title": "Radius Km",
          "type": "number"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "city",
                "neighborhood",
                "airport",
                "poi",
                "area"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type",
          "enum": [
            "city",
            "neighborhood",
            "airport",
            "poi",
            "area"
          ],
          "x-enum-searchable": true
        },
        "language": {
          "default": "en",
          "enum": [
            "en",
            "it",
            "fr",
            "de",
            "es",
            "pt",
            "nl",
            "ko",
            "pl",
            "ja"
          ],
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "DiscoverDestinations",
      "type": "object"
    },
    "GetHealth": {
      "additionalProperties": false,
      "description": "Read public service health and per-booking-site status; does not test a key.",
      "properties": {
        "operation": {
          "const": "get_health",
          "default": "get_health",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "GetHealth",
      "type": "object",
      "x-credentials-optional": true
    },
    "GetProperty": {
      "additionalProperties": false,
      "description": "Read property facts and optional review enrichments.",
      "properties": {
        "property_id": {
          "description": "Property ID from search or a decision.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Property Id",
          "type": "string"
        },
        "operation": {
          "const": "get_property",
          "default": "get_property",
          "title": "Operation",
          "type": "string"
        },
        "include": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comma-separated reviews_aggregate, reviews_sample, reviews_extended.",
          "title": "Include"
        },
        "user_country": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Country"
        },
        "language": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        }
      },
      "required": [
        "property_id"
      ],
      "title": "GetProperty",
      "type": "object"
    },
    "GetPropertyPreview": {
      "additionalProperties": false,
      "description": "Read a public static preview without pricing or availability.",
      "properties": {
        "property_id": {
          "description": "Property ID from search or a decision.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Property Id",
          "type": "string"
