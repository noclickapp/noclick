      },
      "required": [
        "property_id"
      ],
      "title": "GetPropertyPreview",
      "type": "object",
      "x-credentials-optional": true
    },
    "InitiateBooking": {
      "additionalProperties": false,
      "description": "Create a tracked booking link for the end user. This does not book or pay.",
      "properties": {
        "idempotency_key": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional UUID for replaying the same request. If omitted a UUID is generated for this execution. Keep it unchanged when retrying a booking handoff.",
          "title": "Idempotency Key"
        },
        "check_in": {
          "description": "Check-in date, YYYY-MM-DD.",
          "format": "date",
          "title": "Check In",
          "type": "string"
        },
        "check_out": {
          "description": "Check-out date, YYYY-MM-DD, after check-in.",
          "format": "date",
          "title": "Check Out",
          "type": "string"
        },
        "adults": {
          "default": 2,
          "maximum": 16,
          "minimum": 1,
          "title": "Adults",
          "type": "integer"
        },
        "children_ages": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Children Ages"
        },
        "rooms": {
          "default": 1,
          "maximum": 9,
          "minimum": 1,
          "title": "Rooms",
          "type": "integer"
        },
        "property_id": {
          "description": "Property ID from search or a decision.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Property Id",
          "type": "string"
        },
        "operation": {
          "const": "initiate_booking",
          "default": "initiate_booking",
          "title": "Operation",
          "type": "string"
        },
        "ota": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ota"
        }
      },
      "required": [
        "check_in",
        "check_out",
        "property_id"
      ],
      "title": "InitiateBooking",
      "type": "object"
    },
