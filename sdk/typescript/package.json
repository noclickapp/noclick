{
  "name": "noclick",
  "version": "0.2.5",
  "description": "NoClick SDK: users, connections, tools, humans and agents for your product, and the bridge custom interface components use",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "noclick": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embed": {
      "types": "./src/embed/index.ts",
      "import": "./dist/sdk.esm.js"
    },
    "./embed/react": {
      "types": "./src/embed/react.ts",
      "import": "./dist/sdk.esm.js"
    }
  },
  "sideEffects": [
    "./dist/sdk.esm.js",
    "./src/embed/**"
  ],
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.js",
    "test": "npm run test:client && npm run test:embed",
    "test:client": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "test:embed": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "node build.js"
  },
  "keywords": [
    "noclick",
    "agents",
    "automation",
    "sdk"
  ],
  "license": "Apache-2.0",
  "homepage": "https://noclick.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/noclickapp/noclick",
    "directory": "sdk/typescript"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~5.6.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
