{
  "name": "noclick-lint-and-format-hooks",
  "version": "1.0.0",
  "private": true,
  "description": "Git hooks for this repository. The application itself lives in frontend/ and backend/.",
  "scripts": {
    "assets:sync": "node scripts/sync-simple-icons.mjs",
    "assets:check": "node scripts/sync-simple-icons.mjs --check",
    "sucrase:build": "node scripts/build-sucrase-bundle.mjs",
    "sucrase:check": "node scripts/build-sucrase-bundle.mjs --check",
    "vendored:check": "npm run assets:check && npm run sucrase:check",
    "prepare": "husky"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "esbuild": "0.25.12",
    "husky": "^9.1.1",
    "lint-staged": "^15.2.7",
    "simple-icons": "16.12.0",
    "sucrase": "3.35.1"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "cd frontend && npx eslint --fix",
      "cd frontend && npx prettier --write"
    ]
  }
}
