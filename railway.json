{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/single-origin.Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "preDeployCommand": "python /app/docker/bootstrap.py",
    "restartPolicyType": "ALWAYS"
  }
}
