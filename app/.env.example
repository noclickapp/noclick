# The app's settings. Copy this file to .env and fill it in; never commit .env. The app reads these on its server
# only: none of them reaches the browser.

# The NoClick secret key the app acts with, in your account (create one in NoClick's developer console).
NOCLICK_API_KEY=

# The password you sign in to this app with: at least 12 characters, best random (openssl rand -base64 18).
APP_PASSWORD=

# Signs the sign-in cookie: at least 32 random characters (openssl rand -base64 48). Changing it signs everyone out.
SESSION_SECRET=

# Optional: a NoClick API other than https://api.noclick.com (https, or plain http only on this machine).
# NOCLICK_API_URL=
