{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "allowImportingTsExtensions": true,
      "noEmit": true,
      "strict": true,
      "skipLibCheck": true,
      "jsx": "react",
      "lib": ["es2020", "dom"]
    },
    "include": ["utils/**/*"],
    "exclude": ["node_modules"]
  }