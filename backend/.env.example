# NoClick backend configuration — copy to backend/.env and fill in.
# `make local` generates all of this for a local install; this file is for
# deploying yourself. Full reference: docs/self-hosting.md

# ── Required ─────────────────────────────────────────────────────────────

# Self-hosted mode: in-process event relay + scheduler instead of the
# hosted cloud services. Leave this set.
NOCLICK_LOCAL=1

# Database. Both may be the same URL; POSTGRES_URL is used for migrations
# and anything needing session state across transactions.
POSTGRES_POOLER_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project (auth). Prefer the JWKS URL — modern Supabase signs tokens
# with a rotating asymmetric key. Use SUPABASE_JWT_SECRET only if yours signs
# symmetrically.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWK_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=

# Encrypts every stored credential at rest. Generate ONCE and back it up:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this makes all saved credentials permanently unreadable.
CREDENTIALS_ENCRYPTION_KEY=

# Signs short-lived tokens for realtime workflow rooms. Any long random string.
WORKFLOW_JWT_SECRET=

# ── Serving ──────────────────────────────────────────────────────────────

PORT=8000
# Public URL the browser loads the app from. Added to the CORS allowlist, so
# the frontend's REST calls (model catalog, uploads) are accepted. Must match
# the frontend's VITE_PUBLIC_URL exactly, including port.
FRONTEND_URL=http://127.0.0.1:5173

# Public origin of THIS backend. Webhook URLs are minted as
# {WEBHOOK_URL_BASE}/webhook/{webhook_id}; must be internet-reachable for
# external services to deliver to it.
WEBHOOK_URL_BASE=http://127.0.0.1:8000
# Public base URL advertised for this instance's MCP server, including OAuth
# discovery and links shown to users. Local agent-harness tool calls use a
# loopback capability URL automatically and do not depend on this value.
MCP_BASE_URL=http://127.0.0.1:8000
# Public backend origin used when registering Discord app-event webhooks.
# Usually the same origin as WEBHOOK_URL_BASE.
APP_WEBHOOK_BASE_URL=http://127.0.0.1:8000

# ── Storage (uploads, generated media) ───────────────────────────────────
# Any S3-compatible service. Provision two private buckets named
# `workflow-resources` and `workflow-cas` (the Docker bootstrap does this).
# Supabase Storage, Cloudflare R2, MinIO and AWS S3 all work.

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=us-east-1

# Optional overrides for the in-process scheduler. With NOCLICK_LOCAL=1 the
# backend derives the loopback URL and generates a process-local secret when
# these are unset, so a bare `python backend/server.py` still runs schedules.
# CRON_SCHEDULER_URL=http://127.0.0.1:8000/local-cron
# CRON_SCHEDULER_SECRET=

# ── Models (optional) ────────────────────────────────────────────────────
# Users can connect their own keys in the UI instead. Set these to share one
# server-side key across all agents. A nonblank OPENROUTER_API_KEY also enables
# optional output-field suggestions; the backend sends a clipped node-output
# sample to OpenRouter for those suggestions (see docs/self-hosting.md).
# CLI harnesses (Claude Code, Codex, opencode, hermes, OpenClaw) use their own
# logged-in CLI — no key here.

OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Optional services ────────────────────────────────────────────────────

# Caching for OAuth state and UI state. Works without it.
REDIS_URL=
# Outbound notifications, workflow mail, and agent replies.
RESEND_API_KEY=
FROM_EMAIL=
INVITE_FROM_EMAIL=
# Inbound trigger addresses + reply-capable agent email. Leave unset to hide
# and disable both; configure your mail provider to POST to /email/inbound.
INBOUND_EMAIL_DOMAIN=
EMAIL_RELAY_SECRET=
# Telemetry. Unset = nothing is sent.
HONEYCOMB_API_KEY=
# Optional HTTPS template such as https://geo.example.test/json/{ip}; used
# only for operator-configured Slack login alerts.
GEOIP_LOOKUP_URL=
# QR-linked personal WhatsApp accounts use the external WAHooks service.
# Meta Cloud API credentials do not require this instance-wide key.
WAHOOKS_API_KEY=
# Discord channel-message triggers ("On Channel Message", "On Bot Mention")
# need a live Gateway connection, which the backend holds for this bot while
# the token is set (also settable in Settings → Self-hosted). Enable
# "Message Content Intent" on the bot in the Developer Portal to read message
# text, and configure the Discord OAuth app so users can install the bot.
DISCORD_BOT_TOKEN=

# Enables /debug/memory, which intentionally exposes thread stacks and sampled
# object referrers. Leave unset to keep the diagnostic endpoint unavailable.
# Generate a long random bearer token and send it in Authorization when needed.
# DEBUG_ENDPOINT_TOKEN=

# Allow user-configured HTTP, MCP, feed, import, and database connectors to
# reach private/LAN addresses. Off by default to prevent server-side request
# forgery — only enable on a trusted network.
# OUTBOUND_ALLOW_PRIVATE_IPS=1
# Deprecated compatibility alias: HTTP_NODE_ALLOW_PRIVATE_IPS=1

# ── Integration OAuth (optional, one block per provider you use) ──────────
# Create an OAuth app with the provider, set its redirect URI to
#   {frontend VITE_PUBLIC_URL}/api/auth/{provider}/callback
# then set the ID here and in frontend/.env (see docs/self-hosting.md).
# The backend needs the SECRET; the frontend needs the redirect URI.

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
