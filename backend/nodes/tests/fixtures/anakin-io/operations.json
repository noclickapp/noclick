{
  "source": "https://anakin.io/openapi.json",
  "version": "1.1.0",
  "operations": {
    "scrape_url": {
      "method": "POST",
      "path": "/url-scraper",
      "operation_id": "scrapeUrl",
      "config": {
        "url": "https://example.com",
        "generateJson": true
      }
    },
    "scrape_url_sync": {
      "method": "POST",
      "path": "/url-scraper/scrape",
      "operation_id": "scrapeUrlSync",
      "config": {
        "url": "https://example.com"
      }
    },
    "get_scrape_result": {
      "method": "GET",
      "path": "/url-scraper/{jobId}",
      "operation_id": "getScrapeResult",
      "config": {
        "jobId": "job-42"
      }
    },
    "search": {
      "method": "POST",
      "path": "/search",
      "operation_id": "search",
      "config": {
        "prompt": "solid-state batteries",
        "limit": 3
      }
    },
    "start_research": {
      "method": "POST",
      "path": "/agentic-search",
      "operation_id": "agenticSearch",
      "config": {
        "prompt": "Compare scraping APIs",
        "output_schema": {
          "type": "object"
        }
      }
    },
    "get_research_result": {
      "method": "GET",
      "path": "/agentic-search/{jobId}",
      "operation_id": "getAgenticSearchResult",
      "config": {
        "jobId": "job-42"
      }
    },
    "map_site": {
      "method": "POST",
      "path": "/map",
      "operation_id": "mapUrl",
      "config": {
        "url": "https://example.com",
        "search": "pricing"
      }
    },
    "get_map_result": {
      "method": "GET",
      "path": "/map/{jobId}",
      "operation_id": "getMapResult",
      "config": {
        "jobId": "job-42"
      }
    },
    "crawl_site": {
      "method": "POST",
      "path": "/crawl",
      "operation_id": "crawlSite",
      "config": {
        "url": "https://example.com",
        "maxPages": 3,
        "includePatterns": [
          "/docs/*"
        ]
      }
    },
    "get_crawl_result": {
      "method": "GET",
      "path": "/crawl/{jobId}",
      "operation_id": "getCrawlResult",
      "config": {
        "jobId": "job-42"
      }
    },
    "discover_wire_actions": {
      "method": "GET",
      "path": "/wire/resolve",
      "operation_id": "wireDiscover",
      "config": {
        "q": "top phones on walmart",
        "limit": 3
      }
    },
    "list_wire_catalogs": {
      "method": "GET",
      "path": "/wire/catalog",
      "operation_id": "listWireCatalogs",
      "config": {}
    },
    "get_wire_catalog": {
      "method": "GET",
      "path": "/wire/catalog/{slug}",
      "operation_id": "getWireCatalog",
      "config": {
        "slug": "walmart"
      }
    },
    "run_wire_action": {
      "method": "POST",
      "path": "/wire/task",
      "operation_id": "runWireAction",
      "config": {
        "action_id": "walmart.search_products",
        "params": {
          "query": "phones"
        },
        "credential_id": "credential-42"
      }
    },
    "get_wire_job": {
      "method": "GET",
      "path": "/wire/jobs/{jobId}",
      "operation_id": "getWireJobStatus",
      "config": {
        "jobId": "job-42"
      }
    },
    "list_wire_identities": {
      "method": "GET",
      "path": "/wire/identities",
      "operation_id": "listWireIdentities",
      "config": {
        "catalog_id": "walmart"
      }
    },
    "build_wire_action": {
      "method": "POST",
      "path": "/wire/build-request",
      "operation_id": "wireBuild",
      "config": {
        "website_url": "https://example.com",
        "goal": "Extract products"
      }
    },
    "create_monitor": {
      "method": "POST",
      "path": "/monitors",
      "operation_id": "createMonitor",
      "config": {
        "url": "https://example.com",
        "intervalMinutes": 30,
        "alertWebhookUrl": "https://example.com/hook"
      }
    },
    "list_monitors": {
      "method": "GET",
      "path": "/monitors",
      "operation_id": "listMonitors",
      "config": {}
    },
    "get_monitor": {
      "method": "GET",
      "path": "/monitors/{id}",
      "operation_id": "getMonitor",
      "config": {
        "id": "monitor-42"
      }
    },
    "delete_monitor": {
      "method": "DELETE",
      "path": "/monitors/{id}",
      "operation_id": "deleteMonitor",
      "config": {
        "id": "monitor-42"
      }
    },
    "get_monitor_changes": {
      "method": "GET",
      "path": "/monitors/{id}/changes",
      "operation_id": "getMonitorChanges",
      "config": {
        "id": "monitor-42"
      }
    },
    "pause_monitor": {
      "method": "POST",
      "path": "/monitors/{id}/pause",
      "operation_id": "pauseMonitor",
      "config": {
        "id": "monitor-42"
      }
    },
    "resume_monitor": {
      "method": "POST",
      "path": "/monitors/{id}/resume",
      "operation_id": "resumeMonitor",
      "config": {
        "id": "monitor-42"
      }
    },
    "run_monitor": {
      "method": "POST",
      "path": "/monitors/{id}/run",
      "operation_id": "runMonitorNow",
      "config": {
        "id": "monitor-42"
      }
    }
  }
}
