{
  "source": "https://developer.knowify.com/api-docs/v2-json",
  "version": "0.1.120",
  "schemas": {
    "ProjectOutput": {
      "type": "object",
      "properties": {
        "Id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 102345,
          "description": "Primary identifier."
        },
        "ProjectName": {
          "type": "string",
          "description": "Human-readable name of the project.",
          "example": "Acme HQ Buildout",
          "nullable": true
        },
        "ProjectNumber": {
          "type": "string",
          "description": "Customer-assigned project number.",
          "example": "2026-001",
          "nullable": true
        },
        "ProjectType": {
          "type": "string",
          "enum": [
            "Budget",
            "Real",
            null
          ],
          "description": "Determines if project is Budget or Real.",
          "nullable": true
        },
        "JobCostingMode": {
          "type": "string",
          "enum": [
            "Professional",
            "Advanced",
            "Simple",
            null
          ],
          "description": "Determines costing complexity level (Professional / Advanced / Simple).",
          "nullable": true
        },
        "BusinessState": {
          "description": "Current state of the project (Draft / Open / Closed / WaitingOnContract) (read-only). Not settable via create/update \u2014 the platform sets it on create, and the dedicated `POST /:id/close` / `POST /:id/reopen` actions manage the Closed/Open transitions (financial finalization, service-job handling).",
          "example": "Open",
          "type": "string",
          "enum": [
            "",
            "Draft",
            "WaitingOnContract",
            "Open",
            "Closed"
          ]
        },
        "ContractType": {
          "type": "string",
          "enum": [
            "Record",
            "Contract",
            "SOW",
            "Estimate",
            "AIAJob",
            "ResidentialJob",
            "ServiceQuote",
            "Maintenance",
            null
          ],
          "description": "Contract classification \u2014 drives billing + lifecycle behavior.",
          "nullable": true
        },
        "ClientId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 42,
          "description": "Associated client (null for internal projects).",
          "nullable": true
        },
        "DepartmentId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 7,
          "description": "Associated internal department (null for client projects).",
          "nullable": true
        },
        "ContractId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 9001,
          "description": "Linked finalized contract.",
          "nullable": true
        },
        "DraftContractId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 9050,
          "description": "Linked draft contract (used while WaitingOnContract).",
          "nullable": true
        },
        "ServiceTicketId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 45230,
          "description": "Service ticket that spawned this project (service jobs only).",
          "nullable": true
        },
        "OwnerId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 11,
          "description": "Internal user who owns the project.",
          "nullable": true
        },
        "TemplateId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 1862898,
          "description": "The job template (a Project with ObjectState=ProjectTemplate) this project was created from, if any.",
          "nullable": true
        },
        "Color": {
          "type": "string",
          "description": "Hex color used for calendar/board display.",
          "example": "#4d82cb",
          "nullable": true
        },
        "ProjectManager": {
          "type": "string",
          "description": "Resource ID of project manager.",
          "example": "PM-101",
          "nullable": true
        },
        "SalesLead": {
          "type": "string",
          "description": "Resource ID of sales lead.",
          "example": "PM-099",
          "nullable": true
        },
        "PWage": {
          "type": "boolean",
          "description": "Indicates if project is subject to prevailing wage.",
          "nullable": true
        },
        "Scheduled": {
          "type": "boolean",
          "description": "Whether the project is scheduled on the planner.",
          "nullable": true
        },
        "BudgetAmount": {
          "type": "number",
          "description": "Total budget allocated, in dollars.",
          "example": 425000,
          "nullable": true
        },
        "HasNoBudget": {
          "type": "boolean",
          "description": "Indicates if project has no budget set.",
          "nullable": true
        },
        "RemainingBudgetAmount": {
          "type": "number",
          "description": "Remaining budget available (read-only).",
          "nullable": true
        },
        "HasMaterials": {
          "type": "boolean",
          "description": "Indicates if project has material costs.",
          "nullable": true
        },
        "HasTime": {
          "type": "boolean",
          "description": "Indicates if project has time/labor costs.",
          "nullable": true
        },
        "LaborEstimated": {
          "type": "number",
          "description": "Estimated labor costs.",
          "nullable": true
        },
        "LaborTracked": {
          "type": "number",
          "description": "Actual tracked labor costs (read-only).",
          "nullable": true
        },
        "MaterialsEstimated": {
          "type": "number",
          "description": "Estimated materials costs.",
          "nullable": true
        },
        "MaterialsTracked": {
          "type": "number",
          "description": "Actual tracked materials costs (read-only).",
          "nullable": true
        },
        "SubsEstimated": {
          "type": "number",
          "description": "Estimated subcontractor costs.",
          "nullable": true
        },
        "SubsTracked": {
          "type": "number",
          "description": "Actual tracked subcontractor costs (read-only).",
          "nullable": true
        },
        "EquipmentEstimated": {
          "type": "number",
          "description": "Estimated equipment costs.",
          "nullable": true
        },
        "MiscEstimated": {
          "type": "number",
          "description": "Estimated miscellaneous costs.",
          "nullable": true
        },
        "LaborPrevious": {
          "type": "number",
          "description": "Previous period labor cost.",
          "nullable": true
        },
        "MaterialsPrevious": {
          "type": "number",
          "description": "Previous period materials cost.",
          "nullable": true
        },
        "SubsPrevious": {
          "type": "number",
          "description": "Previous period subcontractor cost.",
          "nullable": true
        },
        "EquipmentPrevious": {
          "type": "number",
          "description": "Previous period equipment cost.",
          "nullable": true
        },
        "MiscPrevious": {
          "type": "number",
          "description": "Previous period miscellaneous cost.",
          "nullable": true
        },
        "InvoicedPrevious": {
          "type": "number",
          "description": "Previous period invoiced amount.",
          "nullable": true
        },
        "PaymentsPrevious": {
          "type": "number",
          "description": "Previous period payments received.",
          "nullable": true
        },
        "ExpenseAccountId": {
          "type": "number",
          "description": "QuickBooks expense account ID.",
          "nullable": true
        },
        "IncomeAccountId": {
          "type": "number",
          "description": "QuickBooks income account ID.",
          "nullable": true
        },
        "ObjectState": {
          "type": "string",
          "description": "Current and operational state (lifecycle flag).",
          "example": "Active",
          "nullable": true
        },
        "DateRange": {
          "type": "object",
          "properties": {
            "StartDate": {
              "type": "string",
              "description": "Project start date (ISO-8601).",
              "example": "2026-09-06T20:54:18Z",
              "nullable": true
            },
            "FinishDate": {
              "type": "string",
              "description": "Project finish date (ISO-8601).",
              "example": "2027-03-06T20:54:18Z",
              "nullable": true
            },
            "StartTime": {
              "type": "string",
              "description": "Project start time (ISO-8601; time portion is what matters).",
              "example": "2026-11-06T08:00:00Z",
              "nullable": true
            },
            "EndTime": {
              "type": "string",
              "description": "Project end time (ISO-8601; time portion is what matters).",
              "example": "2026-11-06T17:00:00Z",
              "nullable": true
            }
          },
          "description": "Project date range.",
          "nullable": true
        },
        "Address1": {
          "type": "string",
          "example": "1 Main St",
          "description": "Project site address line 1.",
          "nullable": true
        },
        "Address2": {
          "type": "string",
          "example": "Suite 200",
          "description": "Project site address line 2.",
          "nullable": true
        },
        "City": {
          "type": "string",
          "example": "Brooklyn",
          "description": "Project site address city.",
          "nullable": true
        },
        "StateProvince": {
          "type": "string",
          "example": "NY",
          "description": "Project site address state or province.",
          "nullable": true
        },
        "Zip": {
          "type": "string",
          "example": "11201",
          "description": "Project site address ZIP or postal code.",
          "nullable": true
        },
        "Country": {
          "type": "string",
          "example": "USA",
          "description": "Project site address country.",
          "nullable": true
        },
        "Location": {
          "type": "object",
          "properties": {
            "GeoJson": {
              "description": "GeoJSON geometry of the project location.",
              "nullable": true
            }
          },
          "description": "Project location.",
          "nullable": true
        },
        "DateCreated": {
          "type": "string",
          "description": "When the project was created (ISO-8601).",
          "example": "2026-07-06T20:54:18Z",
          "nullable": true
        },
        "DateModified": {
          "type": "string",
          "description": "When the project was last modified (ISO-8601). Used by `since=` incremental sync.",
          "example": "2026-11-04T20:54:18Z",
          "nullable": true
        }
      },
      "required": [
        "Id",
        "ProjectName"
      ],
      "description": "A Project (also known as a \"Job\") \u2014 the central organizing entity in Knowify representing a unit of work for a client or internal department."
    },
    "ClientOutput": {
      "type": "object",
      "properties": {
        "Id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 102345,
          "description": "Primary identifier for the client record"
        },
        "ClientName": {
          "type": "string",
          "example": "Acme Construction LLC",
          "description": "Display name for the client, typically the full business or individual name",
          "nullable": true
        },
        "CompanyName": {
          "type": "string",
          "example": "Acme Construction LLC",
          "description": "Legal or registered company name of the client",
          "nullable": true
        },
        "ContactName": {
          "type": "string",
          "example": "Jane Doe",
          "description": "Primary contact person name for the client",
          "nullable": true
        },
        "GivenName": {
          "type": "string",
          "example": "Jane",
          "description": "First name of the client contact (used for QuickBooks sync)",
          "nullable": true
        },
        "MiddleName": {
          "type": "string",
          "description": "Middle name of the client contact (used for QuickBooks sync)",
          "nullable": true
        },
        "LastName": {
          "type": "string",
          "example": "Doe",
          "description": "Last name of the client contact (used for QuickBooks sync)",
          "nullable": true
        },
        "Email": {
          "type": "string",
          "example": "jane@acme.example",
          "description": "Primary email address for the client",
          "nullable": true
        },
        "PhoneNumber": {
          "type": "string",
          "example": "+1-555-0100",
          "description": "Primary phone number for the client",
          "nullable": true
        },
        "PhoneNumberMobile": {
          "type": "string",
          "example": "+1-555-0199",
          "description": "Mobile phone number for the client",
          "nullable": true
        },
        "Website": {
          "type": "string",
          "example": "https://www.acme.example",
          "description": "Client website URL",
          "nullable": true
        },
        "Address1": {
          "type": "string",
          "example": "1 Main St",
          "description": "Primary billing address line 1 (street address)",
          "nullable": true
        },
        "Address2": {
          "type": "string",
          "example": "Suite 200",
          "description": "Primary billing address line 2 (suite, unit, etc.)",
          "nullable": true
        },
        "City": {
          "type": "string",
          "example": "Brooklyn",
          "description": "Billing address city",
          "nullable": true
        },
        "StateProvince": {
          "type": "string",
          "example": "NY",
          "description": "Billing address state or province",
          "nullable": true
        },
        "Zip": {
          "type": "string",
          "example": "11201",
          "description": "Billing address ZIP or postal code",
          "nullable": true
        },
        "Country": {
          "type": "string",
          "example": "USA",
          "description": "Billing address country",
          "nullable": true
        },
        "BillingInstructions": {
          "type": "string",
          "description": "Special instructions or notes for billing this client",
          "nullable": true
        },
        "SameAsBilling": {
          "type": "boolean",
          "example": true,
          "description": "When true, the shipping address is the same as the billing address"
        },
        "ShippingAddress1": {
          "type": "string",
          "example": "1 Main St",
          "description": "Shipping address line 1",
          "nullable": true
        },
        "ShippingAddress2": {
          "type": "string",
          "example": "Suite 200",
          "description": "Shipping address line 2",
          "nullable": true
        },
        "ShippingCity": {
          "type": "string",
          "example": "Brooklyn",
          "description": "Shipping address city",
          "nullable": true
        },
        "ShippingStateProvince": {
          "type": "string",
          "example": "NY",
          "description": "Shipping address state or province",
          "nullable": true
        },
        "ShippingZip": {
          "type": "string",
          "example": "11201",
          "description": "Shipping address ZIP or postal code",
          "nullable": true
        },
        "ShippingCountry": {
          "type": "string",
          "example": "USA",
          "description": "Shipping address country",
          "nullable": true
        },
        "ShippingContact": {
          "type": "string",
          "example": "Jane Doe",
          "description": "Contact name for shipping purposes",
          "nullable": true
        },
        "PaymentTerms": {
          "type": "string",
          "enum": [
            "NET7",
            "NET15",
            "NET30",
            "NET45",
            "NET60",
            "NET90",
            "DueUponReceipt",
            null
          ],
          "example": "NET30",
          "description": "Default payment terms for invoices (e.g., Net 30, Due on Receipt)",
          "nullable": true
        },
        "Notes": {
          "type": "string",
          "description": "Free-form notes about the client",
          "nullable": true
        },
        "ParentId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 102345,
          "description": "References the parent client in a hierarchical relationship",
          "nullable": true
        },
        "ParentName": {
          "type": "string",
          "example": "Acme Holdings",
          "description": "Cached display name of the parent client",
          "nullable": true
        },
        "ChildrenCount": {
          "type": "number",
          "example": 0,
          "description": "Number of child clients under this parent client",
          "nullable": true
        },
        "Level": {
          "type": "number",
          "example": 0,
          "description": "Depth level in the client hierarchy (0 = top-level)",
          "nullable": true
        },
        "DefaultProjectId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 102345,
          "description": "Default project used when creating time entries or billables for this client",
          "nullable": true
        },
        "DefaultMilestoneId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 5102,
          "description": "Default milestone used when creating time entries or billables for this client",
          "nullable": true
        },
        "DefaultTaskId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 811,
          "description": "Default task used when creating time entries or billables for this client",
          "nullable": true
        },
        "DefaultIncomeService": {
          "type": "string",
          "description": "Default income service/item used for billing this client",
          "nullable": true
        },
        "IncomeAccount": {
          "type": "string",
          "description": "QuickBooks income account associated with this client",
          "nullable": true
        },
        "IncomeServiceId": {
          "type": "string",
          "description": "QuickBooks income service/item ID for this client",
          "nullable": true
        },
        "PayAccountId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 11,
          "description": "Payment account used for receiving payments from this client",
          "nullable": true
        },
        "PayCustomerId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 42,
          "description": "Payment processor customer ID for this client",
          "nullable": true
        },
        "PaymentAccount": {
          "type": "string",
          "description": "Name or identifier of the client payment account",
          "nullable": true
        },
        "PaymentAccountId": {
          "type": "string",
          "description": "ID of the payment account linked to this client",
          "nullable": true
        },
        "ProjectId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 102345,
          "description": "Associated project ID when the client is linked to a specific project",
          "nullable": true
        },
        "TaxCode": {
          "type": "string",
          "description": "Tax code applied to this client for invoice tax calculations",
          "nullable": true
        },
        "TaxRateId": {
          "type": "string",
          "description": "Tax rate applied to invoices for this client",
          "nullable": true
        },
        "QBId": {
          "type": "string",
          "description": "QuickBooks customer ID for syncing client data",
          "nullable": true
        },
        "QBParentId": {
          "type": "string",
          "description": "QuickBooks parent customer ID for hierarchical sync",
          "nullable": true
        },
        "QBTaxCodeId": {
          "type": "string",
          "description": "QuickBooks tax code ID mapped to this client",
          "nullable": true
        },
        "NeedsToBeSynced": {
          "type": "boolean",
          "example": false,
          "description": "Flag indicating the client has local changes that need to be synced to QuickBooks",
          "nullable": true
        },
        "DateLastSynced": {
          "type": "string",
          "example": "2026-11-05T20:54:18Z",
          "description": "Timestamp of the last successful sync with QuickBooks",
          "nullable": true
        },
        "SyncError": {
          "type": "boolean",
          "example": false,
          "description": "Indicates whether the last QuickBooks sync attempt resulted in an error",
          "nullable": true
        },
        "IsSample": {
          "type": "boolean",
          "example": false,
          "description": "Indicates if this is a sample/demo client created during onboarding"
        },
        "ObjectState": {
          "type": "string",
          "example": "Active",
          "nullable": true
        },
        "CanBeDeleted": {
          "type": "boolean",
          "example": true,
          "nullable": true
        },
        "IsLocked": {
          "type": "boolean",
          "example": false,
          "nullable": true
        },
        "LockedBy": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 11,
          "nullable": true
        },
        "DateLocked": {
          "type": "string",
          "nullable": true
        },
        "CreatedBy": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 11,
          "nullable": true
        },
        "ModifiedBy": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 11,
          "nullable": true
        },
        "DateCreated": {
          "type": "string",
          "example": "2026-10-06T20:54:18Z",
          "nullable": true
        },
        "DateModified": {
          "type": "string",
          "example": "2026-11-04T20:54:18Z",
          "nullable": true
        }
      },
      "required": [
        "Id",
        "SameAsBilling",
        "IsSample"
      ],
      "description": "A Client represents a customer or company that hires the contractor to perform work. Clients are the primary business relationship entity in Knowify, tying together projects, invoices, contacts, and billing. Clients support a parent/child hierarchy (e.g., a property management company with individual properties), and can be synced with QuickBooks for accounting integration."
    },
    "InvoiceOutput": {
      "type": "object",
      "properties": {
        "Id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 102345,
          "description": "Primary identifier for the invoice"
        },
        "InvoiceNumber": {
          "type": "string",
          "example": "INV-2026-0042",
          "description": "User-facing invoice number for reference and tracking",
          "nullable": true
        },
        "InvoiceDate": {
          "type": "string",
          "example": "2026-10-30T20:54:18Z",
          "description": "Date the invoice was issued",
          "nullable": true
        },
        "DueDate": {
          "type": "string",
          "example": "2026-11-29T20:54:18Z",
          "description": "Date by which payment is due, calculated from PaymentTerms",
          "nullable": true
        },
        "BusinessState": {
          "example": "Outstanding",
          "description": "Current lifecycle state of the invoice: Draft, Outstanding, or Closed",
          "type": "string",
          "enum": [
            "Draft",
            "Outstanding",
            "Closed"
          ]
        },
        "InvoicingMethod": {
          "type": "string",
          "example": "Standard",
          "description": "Billing method used (e.g., standard, AIA, progress, percentage)",
          "nullable": true
        },
        "PaymentTerms": {
          "type": "string",
          "enum": [
            "NET7",
            "NET15",
            "NET30",
            "NET45",
            "NET60",
            "NET90",
            "DueUponReceipt",
            null
          ],
          "example": "NET30",
          "description": "Payment terms defining when payment is due (NET7, NET15, NET30, NET45, NET60, NET90, DueUponReceipt)",
          "nullable": true
        },
        "ClientId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 42,
          "description": "The client this invoice is billed to"
        },
        "ProjectId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 102345,
          "description": "The project this invoice is associated with",
          "nullable": true
        },
        "ServiceTicketId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 45230,
          "description": "Associated service ticket if invoice originated from a service call",
          "nullable": true
        },
        "PaymentScheduleId": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "example": 5102,
          "description": "Associated payment schedule for recurring or milestone billing",
          "nullable": true
        },
        "StartDate": {
