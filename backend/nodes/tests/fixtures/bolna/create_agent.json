{
  "source": "https://www.bolna.ai/docs/api-reference/agent/v2/create",
  "request": {
    "agent_config": {
      "agent_name": "My First Agent",
      "agent_welcome_message": "Hi! How can I help you today?",
      "tasks": [
        {
          "task_type": "conversation",
          "toolchain": {
            "execution": "sequential",
            "pipelines": [
              [
                "transcriber",
                "llm",
                "synthesizer"
              ]
            ]
          },
          "tools_config": {
            "llm_agent": {
              "agent_type": "simple_llm_agent",
              "agent_flow_type": "streaming",
              "llm_config": {
                "provider": "openai",
                "model": "gpt-5.4-mini",
                "max_tokens": 150,
                "temperature": 1
              }
            },
            "synthesizer": {
              "provider": "elevenlabs",
              "provider_config": {
                "voice": "Angelica",
                "voice_id": "IkSv4tkouLJ6kYsQA7XD",
                "model": "eleven_turbo_v2_5"
              },
              "stream": true,
              "buffer_size": 250,
              "audio_format": "wav"
            },
            "transcriber": {
              "provider": "deepgram",
              "model": "nova-3",
              "language": "en",
              "stream": true,
              "encoding": "linear16",
              "sampling_rate": 16000,
              "endpointing": 250
            },
            "input": {
              "provider": "plivo",
              "format": "wav"
            },
            "output": {
              "provider": "plivo",
              "format": "wav"
            }
          },
          "task_config": {
            "call_terminate": 90,
            "hangup_after_silence": 10
          }
        }
      ]
    },
    "agent_prompts": {
      "task_1": {
        "system_prompt": "You are a helpful assistant. Keep replies short and friendly."
      }
    }
  },
  "response": {
    "agent_id": "123e4567-e89b-12d3-a456-426655440000",
    "state": "created",
    "version_id": "7e775357-d9d3-4c82-a7d7-b7c3346caf79"
  }
}
