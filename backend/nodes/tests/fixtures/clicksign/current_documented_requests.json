                            "default": "1",
                            "description": "Página"
                          },
                          "position": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "description": "X e Y entre 0 e 1.",
                            "items": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        },
                        "type": "object"
                      }
                    }
                  },
                  "required": [
                    "action"
                  ]
                },
