{
  "upload_document": {
    "source": "https://developers.clicksign.com/reference/api-upload-documentos.md",
    "schema": {
      "description": "Upload, modelo ou duplicação.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "default": "documents",
                  "enum": [
                    "documents"
                  ]
                },
                "attributes": {
                  "type": "object",
                  "properties": {
                    "filename": {
                      "type": "string",
                      "description": "Nome do arquivo. Extensões aceitas: pdf, doc, docx, txt, jpg, jpeg e png."
                    },
                    "content_base64": {
                      "type": "string",
                      "description": "Base64 do arquivo desejado, consulte os formatos aceitos para [Documentos](https://developers.clicksign.com/docs/documentos) O valor usa o formato `data:<mime>;base64,...`."
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Objeto com metadados utilizados nos retornos de documentos via webhooks."
                    }
                  },
                  "required": [
                    "filename",
                    "content_base64"
                  ]
                }
              }
            }
          },
          "title": "Upload"
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "default": "documents",
                  "enum": [
                    "documents"
                  ]
                },
                "attributes": {
                  "type": "object",
                  "properties": {
                    "filename": {
                      "type": "string",
                      "description": "Nome do arquivo com extensão .doc ou .docx."
                    },
                    "template": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "description": "UUID do modelo utilizado para a criação.",
                          "format": "uuid"
                        },
                        "data": {
                          "type": "object",
                          "description": "Objeto com chave e valor que alimentam o modelo."
                        }
                      },
                      "required": [
                        "key",
                        "data"
                      ]
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Objeto com metadados utilizados nos retornos de documentos via webhooks."
                    }
                  },
                  "required": [
                    "filename",
                    "template"
                  ]
                }
              }
            }
          },
          "title": "Modelo"
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "documents"
                  ]
                },
                "attributes": {
                  "type": "object",
                  "properties": {
                    "filename": {
                      "type": "string",
                      "description": "Nome do arquivo. Extensões aceitas: pdf, doc, docx, txt, jpg, jpeg e png."
                    },
                    "duplicate": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "description": "Chave UUID do documento que será duplicado"
                        }
                      },
                      "description": "A cópia não traz as assinaturas. O documento de origem é qualquer documento finalizado da conta. Disponível conforme a liberação da conta. Sem essa liberação, a API recusa a chamada.",
                      "required": [
                        "key"
                      ]
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Objeto com metadados utilizados nos retornos de documentos via webhooks."
                    }
                  },
                  "required": [
                    "filename",
                    "duplicate"
                  ]
                }
              }
            }
          },
          "title": "Duplicação"
        }
      ]
    }
  },
  "update_document": {
    "source": "https://developers.clicksign.com/reference/editar-documento.md",
    "schema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "ID do documento que deseja atualizar"
            },
            "type": {
              "type": "string",
              "default": "documents",
              "enum": [
                "documents"
              ]
            },
            "attributes": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "description": "Só é possível alterar status de documentos `running` (em progresso/ativados).",
                  "enum": [
                    "canceled",
                    "closed"
                  ]
                },
                "metadata": {
                  "type": "object",
                  "description": "Objeto com metadados utilizados nos retornos de documentos via webhooks."
                }
              }
            }
          }
        }
      }
    }
  },
