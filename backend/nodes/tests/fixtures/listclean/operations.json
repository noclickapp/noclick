      "operation": "get_upload",
      "upload_id": 1
    }
  },
  "list_lists": {
    "method": "GET",
    "path": "/lists/",
    "config": {
      "operation": "list_lists"
    }
  },
  "get_list": {
    "method": "GET",
    "path": "/lists/{list_id}",
    "config": {
      "operation": "get_list",
      "list_id": 1
    }
