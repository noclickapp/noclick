{
  "verify_email": {
    "method": "GET",
    "path": "/verify/email/{email}",
    "config": {
      "operation": "verify_email",
      "email": "test@example.com"
    }
  },
  "verify_batch": {
    "method": "POST",
    "path": "/verify/email/batch",
    "config": {
      "operation": "verify_batch",
