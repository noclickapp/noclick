{
  "provider": "Fundraise Up",
  "node_type": "automation-fundraise-up",
  "credential_type": "fundraise_up_api_key",
  "credential_fields": [
    "credential_type",
    "api_key",
    "livemode",
    "account_id",
    "check_resource"
  ],
  "operations": [
    "check_connection",
    "list_supporters",
    "get_supporter",
    "list_campaigns",
    "get_campaign",
    "list_fundraisers",
    "get_fundraiser",
    "list_designations",
    "get_designation",
    "create_designation",
    "update_designation",
    "delete_designation"
  ],
  "test_mode_operations": [
    "check_connection",
    "list_supporters",
    "get_supporter"
  ],
  "live_only": [
    "campaigns",
    "fundraisers",
    "designations"
  ],
  "list": {
    "data": "array",
    "has_more": "boolean",
    "limit": [
      1,
      100
    ],
    "cursor_direction": [
      "starting_after",
      "ending_before"
    ]
  },
  "response_status": 200,
  "identity": "reachability and chosen resource ACL only",
  "delete_contract": {
    "method": "DELETE",
    "path": "/v1/designations/{id}",
    "parameters": [
      "id"
    ],
    "response_fields": [
      "id"
    ],
    "source": "https://api.fundraiseup.com/v1/openapi.json"
  }
}
