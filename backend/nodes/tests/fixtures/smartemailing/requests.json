{
  "source": "https://app.smartemailing.cz/docs/api/v3/openapi.json",
  "description": "Request routing regression cases based on the pinned provider contract and its example values. Pagination and contact email test cases also exercise synthetic boundaries.",
  "cases": [
    {
      "operation": "get_account_info",
      "config": {
        "operation": "get_account_info"
      },
      "method": "GET",
      "path": "/account-info",
      "expected": {}
    },
    {
      "operation": "list_contacts",
      "config": {
        "operation": "list_contacts",
        "limit": 2,
        "offset": 5,
        "emailaddress": "test@example.com"
      },
      "method": "GET",
      "path": "/contacts",
      "expected": {
        "limit": "2",
        "offset": "5",
        "emailaddress": "test@example.com"
      }
    },
    {
      "operation": "get_contact",
      "config": {
        "operation": "get_contact",
        "emailaddress": "test+tag@example.com"
      },
      "method": "GET",
      "path": "/contacts/test+tag@example.com",
      "expected": {}
    },
    {
      "operation": "import_contacts",
      "config": {
        "operation": "import_contacts",
        "data": [
          {
            "emailaddress": "martin@smartemailing.cz",
            "name": "Martin",
            "contactlists": [
              {
                "id": 1,
                "status": "confirmed"
              }
            ],
            "customfields": [
              {
                "id": 8,
                "value": "2016-01-10 13:53:03"
              }
            ]
          }
        ]
      },
      "method": "POST",
      "path": "/import",
      "expected": {
        "settings": {
          "update": true,
          "preserve_unsubscribed": true,
          "skip_invalid_emails": false
        },
        "data": [
          {
            "emailaddress": "martin@smartemailing.cz",
            "name": "Martin",
            "contactlists": [
              {
                "id": 1,
                "status": "confirmed"
              }
            ],
            "customfields": [
              {
                "id": 8,
                "value": "2016-01-10 13:53:03"
              }
            ]
          }
        ]
      }
    },
    {
      "operation": "change_email_address",
      "config": {
        "operation": "change_email_address",
        "from_address": "martin@smartemailing.cz",
        "to_address": "spock@smartemailing.cz"
      },
      "method": "POST",
      "path": "/change-emailaddress",
      "expected": {
        "from": "martin@smartemailing.cz",
        "to": "spock@smartemailing.cz"
      }
    },
    {
      "operation": "list_contact_lists",
      "config": {
        "operation": "list_contact_lists"
      },
      "method": "GET",
      "path": "/contactlists",
      "expected": {
        "limit": "100",
        "offset": "0"
      }
    },
    {
      "operation": "get_contact_list",
      "config": {
        "operation": "get_contact_list",
