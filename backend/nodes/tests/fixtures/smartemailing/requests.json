        "operation": "create_contact_list",
        "name": "Internal name of this list",
        "publicname": "Going public!"
      },
      "method": "POST",
      "path": "/contactlists",
      "expected": {
        "name": "Internal name of this list",
        "publicname": "Going public!"
      }
    },
    {
      "operation": "update_contact_list",
      "config": {
        "operation": "update_contact_list",
        "id": 1,
        "name": "Changed name"
      },
      "method": "PUT",
      "path": "/contactlists/1",
      "expected": {
        "name": "Changed name"
