  "documented_contract_exception": {
    "operation": "create_contact",
    "contract": "POST /contacts requestBody.content uses */* for AddContact (object); conformance validator treats matching media as bytes and rejects the valid JSON object.",
    "documented_behavior": "VaultRE official add_contact.php json_encodes firstName/lastName, and api.php sends Content-Type: application/json. Keep the provider-documented JSON request.",
    "sources": [
      "https://docs.api.vaultre.com.au/guide.html",
      "https://github.com/VaultGroup/api-samples/blob/master/php/add_contact.php",
