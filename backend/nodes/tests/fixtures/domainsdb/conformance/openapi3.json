    "info": {
        "title": "Domains-Index API",
        "version": "1.0",
        "description": "Domains-Index database powered API"
    },
    "tags": [
        {
            "name": "default",
            "description": "Default namespace"
        },
        {
            "name": "info/",
            "description": "TLD Statistics"
        },
        {
            "name": "domains/",
            "description": "Domains Database"
        }
    ],
    "servers": [
        {
            "url": "/v1"
        }
    ],
    "components": {
        "responses": {
            "ParseError": {
                "description": "When a mask can't be parsed"
            },
            "MaskError": {
                "description": "When any error occurs on mask"
            }
        },
        "schemas": {
            "Domains": {
                "properties": {
                    "domain": {
                        "type": "string",
                        "description": "Domain name"
                    },
                    "create_date": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Domain creation date"
                    },
                    "update_date": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Domain last update date"
                    },
                    "country": {
                        "type": "string",
                        "description": "Hosting Country"
                    },
                    "isDead": {
                        "type": "string",
                        "description": "If Domain is Dead"
                    },
                    "A": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "description": "A record"
                        }
                    },
                    "NS": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "description": "NS record"
                        }
                    },
                    "CNAME": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "description": "CNAME record"
                        }
                    },
                    "MX": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/MX_records"
                        }
                    },
                    "TXT": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "description": "TXT record"
                        }
                    }
                },
                "type": "object"
            },
            "Zone_stats": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Response_Parameters"
                    },
                    {
                        "properties": {
                            "statistics": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/Zone_statistics"
                                }
                            }
                        },
                        "type": "object"
                    }
                ]
            },
            "Response_Parameters": {
                "required": [
                    "time"
                ],
                "properties": {
                    "total": {
                        "type": "integer",
                        "description": "Total days reported"
                    },
                    "time": {
                        "type": "string",
                        "description": "Time took"
                    },
                    "next_page": {
                        "type": "string",
                        "description": "Next page id"
                    }
                },
                "type": "object"
            },
            "Zone_statistics": {
                "required": [
                    "date",
                    "dec",
                    "inc",
                    "total",
                    "zone"
                ],
                "properties": {
                    "zone": {
                        "type": "string",
                        "description": "TLD name"
                    },
                    "date": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Report Date"
                    },
                    "dec": {
                        "type": "integer",
                        "description": "Increase"
                    },
                    "inc": {
                        "type": "integer",
                        "description": "Decrease"
                    },
                    "total": {
                        "type": "integer",
                        "description": "Total number of records"
                    }
                },
                "type": "object"
            },
            "Zone_info": {
                "required": [
                    "type",
                    "zone"
                ],
                "properties": {
                    "zone": {
                        "type": "string",
                        "description": "TLD name"
                    },
                    "type": {
                        "type": "string",
                        "description": "TLD type"
                    },
                    "includes": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "description": "Sub TLDs included"
                        }
                    },
                    "in_bundles": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "description": "Sub TLDs included"
                        }
                    },
                    "description": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "description": "Sub TLDs included"
                        }
                    }
                },
                "type": "object"
            },
            "API_Key_Info": {
                "properties": {
                    "success": {
                        "type": "string",
