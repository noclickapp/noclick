{
  "source": "https://docs.vendschat.com/openapi/integrations.json",
  "examples": {
    "sendIntegrationMessage": {
      "identifier_type": "phone_number",
      "identifier_value": "+15551234567",
      "channel_mode": "specific",
      "channel_id": 15,
      "message_type": "text",
      "text": "Your BloomBox order is packed and ready."
    },
    "lookupIntegrationContact": {
      "identifier_type": "phone_number",
      "identifier_value": "+15551234567"
    },
    "createIntegrationContact": {
      "name": "Alex Rivera",
      "phone_number": "+15551234567",
      "email": "alex@example.com",
      "note": "Wholesale lead from Make"
    },
    "addIntegrationContactLabels": {
      "identifier_type": "contact_id",
      "identifier_value": "1001",
      "label_ids": [
        3
      ],
      "labels": "Wholesale, VIP"
    },
    "subscribeIntegrationWebhook": {
      "url": "https://hooks.zapier.com/hooks/catch/000/xxx/",
      "events": [
        "incoming.vendschat.messages"
      ],
      "source": "zapier",
      "name": "Zapier: inbound messages",
      "payload_style": "thin"
    }
  }
}
