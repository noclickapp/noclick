    {
      "name": "Send SMS (single)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/send",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "send"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderName\": \"Mobile.SA\",\n  \"number\": \"966XXXXXXXXX\",\n  \"messageBody\": \"Your code is 4821\",\n  \"sendAtOption\": \"NOW\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Sends one SMS. The response carries the message `id` to use with the status and report endpoints.\n\n| Field | In | Type | Required | Description |\n|---|---|---|---|---|\n| `Idempotency-Key` | header | string | no | Optional. Retrying with the same key returns the first response (header `Idempotent-Replayed: true`) instead of sending again. |\n| `X-Allow-Duplicate` | header | string | no | Optional. Set to `true` to resend an identical message on purpose (skips duplicate protection for this request only). |\n| `senderName` | body | string | yes | Sender name approved for your account (see the sender names endpoint). |\n| `number` | body | string | yes | Recipient mobile number in international format, digits only (8\u201315 digits), e.g. `966XXXXXXXXX`. |\n| `messageBody` | body | string | yes | Message text, up to 1600 characters. |\n| `sendAtOption` | body | string | no | Delivery timing. `NOW` sends immediately. |"
      },
      "response": [
        {
          "name": "Accepted",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"Success\",\n  \"message\": null,\n  \"data\": {\n    \"message\": {\n      \"id\": \"8493f201-ebcc-4415-8450-18d8d8714f33\",\n      \"status\": \"pending\"\n    }\n  }\n}"
        },
        {
          "name": "Invalid request",
          "code": 400,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"Error\",\n  \"message\": \"Invalid destination number: 12 (expected 8-15 digits, international format).\",\n  \"code\": \"VALIDATION\"\n}"
        },
        {
          "name": "Balance exhausted",
          "code": 402,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"Error\",\n  \"message\": \"Insufficient balance (0). Please top up to continue sending.\",\n  \"code\": \"INSUFFICIENT_BALANCE\"\n}"
        },
        {
          "name": "Duplicate message",
          "code": 409,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"Error\",\n  \"message\": \"Duplicate request blocked: same client, destination, and message within the dedup window.\",\n  \"code\": \"DUPLICATE\"\n}"
