    {
      "name": "Sent-message archive",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/gateway/v1/messages?limit=&cursor=&from=&to=&number=&sender=&status=",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "gateway",
            "v1",
            "messages"
          ],
          "query": [
            {
              "key": "limit",
              "value": "",
              "description": "Page size, 1\u2013200 (default 50)."
            },
            {
              "key": "cursor",
              "value": "",
              "description": "nextCursor from a previous page, to continue."
            },
            {
              "key": "from",
              "value": "",
              "description": "Oldest date to include: `2026-09-01`, an ISO date-time, or epoch seconds."
            },
            {
              "key": "to",
              "value": "",
              "description": "Newest date to include (a bare date covers that whole day)."
            },
            {
              "key": "number",
              "value": "",
              "description": "A destination number, or a piece of it."
            },
            {
              "key": "sender",
              "value": "",
              "description": "Sender name."
            },
            {
              "key": "status",
              "value": "",
              "description": "`1` also returns each message's delivery status."
