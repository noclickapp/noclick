    {
      "name": "Personalized bulk send (merge fields)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/gateway/v1/send-template",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "gateway",
            "v1",
            "send-template"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderName\": \"Corbit\",\n  \"template\": \"otp\",\n  \"vars\": {\n    \"code\": \"0000\"\n  },\n  \"recipients\": [\n    {\n      \"number\": \"966XXXXXXXXX\",\n      \"vars\": {\n        \"name\": \"Ali\",\n        \"code\": \"4821\"\n      }\n    },\n    \"966XXXXXXXXX\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Sends a saved template (`template`) or inline `text` with `{{field}}` / `{{field|default}}` placeholders. Per-recipient `vars` override the shared `vars`. Recipients whose rendered text is identical are grouped into one bulk send. If any recipient is invalid the whole request is rejected and nothing is sent.\n\n| Field | In | Type | Required | Description |\n|---|---|---|---|---|\n| `Idempotency-Key` | header | string | no | Optional. Retrying with the same key returns the first response instead of sending again. |\n| `senderName` | body | string | yes | Sender name approved for your account. |\n| `template` | body | string | no | Name of a saved template (or send `text` instead). |\n| `vars` | body | object | no | Merge values shared by all recipients. |\n| `recipients` | body | array | yes | Numbers, or `{ number, vars }` objects for per-recipient values. Up to 1000 per request. |"
      },
      "response": [
        {
          "name": "Accepted (status \"Partial\" if some groups failed)",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"Success\",\n  \"message\": null,\n  \"data\": {\n    \"recipients\": 2,\n    \"groups\": 2,\n    \"accepted\": 2,\n    \"rejected\": 0,\n    \"messages\": [\n      {\n        \"numbers\": 1,\n        \"id\": \"8493f201-\u2026\",\n        \"ok\": true\n      }\n    ]\n  }\n}"
        },
        {
          "name": "Balance exhausted",
          "code": 402,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"Error\",\n  \"message\": \"Insufficient balance (0). Please top up to continue sending.\",\n  \"code\": \"INSUFFICIENT_BALANCE\"\n}"
        },
        {
          "name": "Sender name not approved",
          "code": 403,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
