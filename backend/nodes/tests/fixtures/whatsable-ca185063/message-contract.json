{
  "source": "https://api.whatsable.app/v1/openapi.json",
  "sha256": "27f30afd5cdac3bd1f97d13c699118e8e6384699f008d9ebfc99a78fcc9f5740",
  "branches": {
    "send_message": {
      "type": "object",
      "properties": {
        "to": {
          "description": "An E.164 phone (`+`, spaces, dashes optional), a Business-Scoped User ID or a WhatsApp `@username`. A new phone or ID creates a contact; a username must be known.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "conversation_id": {
          "description": "Send into this existing conversation, from its number. Exactly one of `to` and `conversation_id`.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "from": {
          "description": "The number to send from, by id or E.164 phone. Absent, the key's default number sends. Never another fallback.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "const": "template"
        },
        "template": {
          "type": "object",
          "properties": {
            "id": {
              "description": "The template id. Or send `name` and `language`.",
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "name": {
              "description": "Resolved within the sending number's WhatsApp Business Account.",
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "language": {
              "description": "Required with `name`.",
              "type": "string",
              "minLength": 2,
              "maxLength": 15
            },
            "variables": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1024
                  },
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "maxLength": 2000,
                            "format": "uri",
                            "description": "A public HTTPS link. The server downloads the file from it."
                          },
                          "filename": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 240
                          }
                        },
                        "required": [
                          "url"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "media_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "filename": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 240
                          }
                        },
                        "required": [
                          "media_id"
                        ],
                        "additionalProperties": false
                      }
                    ],
                    "description": "A media header: `{ \"url\": \"https://...\" }`, or `{ \"media_id\": \"...\" }` for a file uploaded with `POST /v1/media`."
                  }
                ]
              },
              "description": "Keyed by the template's `variables[].key`. A string for a text variable, an object for a media header. An empty or blank string counts as missing."
            }
          },
          "additionalProperties": false
        },
        "pause_ai": {
          "default": false,
          "description": "When true and the send succeeds, the AI agent stops answering this conversation, as when a person replies in the inbox. Default false.",
          "type": "boolean"
        },
        "reply_to_message_id": {
          "description": "Not accepted: a template or buttons message cannot quote a message.",
          "not": {}
        }
      },
      "required": [
        "type",
        "template"
      ],
      "additionalProperties": false
    },
    "schedule_message": {
      "type": "object",
      "properties": {
        "to": {
          "description": "An E.164 phone (`+`, spaces, dashes optional), a Business-Scoped User ID or a WhatsApp `@username`. A new phone or ID creates a contact; a username must be known.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "conversation_id": {
          "description": "Send into this existing conversation, from its number. Exactly one of `to` and `conversation_id`.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "from": {
          "description": "The number to send from, by id or E.164 phone. Absent, the key's default number sends. Never another fallback.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "const": "template"
        },
        "template": {
          "type": "object",
          "properties": {
            "id": {
              "description": "The template id. Or send `name` and `language`.",
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "name": {
              "description": "Resolved within the sending number's WhatsApp Business Account.",
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "language": {
              "description": "Required with `name`.",
              "type": "string",
              "minLength": 2,
              "maxLength": 15
            },
            "variables": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1024
                  },
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "maxLength": 2000,
                            "format": "uri",
                            "description": "A public HTTPS link. The server downloads the file from it."
                          },
                          "filename": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 240
                          }
                        },
                        "required": [
                          "url"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "media_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "filename": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 240
                          }
                        },
                        "required": [
                          "media_id"
                        ],
                        "additionalProperties": false
                      }
                    ],
                    "description": "A media header: `{ \"url\": \"https://...\" }`, or `{ \"media_id\": \"...\" }` for a file uploaded with `POST /v1/media`."
                  }
                ]
              },
              "description": "Keyed by the template's `variables[].key`. A string for a text variable, an object for a media header. An empty or blank string counts as missing."
            }
          },
          "additionalProperties": false
        },
        "send_at": {
          "type": "string",
          "format": "date-time",
          "description": "A future RFC 3339 instant with its offset, such as `2026-10-22T09:00:00-03:00`. A time without an offset is refused."
        },
        "time_zone": {
          "description": "An IANA time zone name, kept for display only. `send_at` is never read in it.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "send_if": {
          "type": "object",
          "properties": {
            "no_reply": {
              "type": "string",
              "enum": [
                "since_last_message",
                "never_replied",
                "20m",
                "45m",
                "3h",
                "6h",
                "12h",
                "24h",
                "48h",
                "72h"
              ],
              "x-open-enum": false,
              "description": "Send only if they have not replied: `since_last_message` (since our last message), `never_replied` (to any message of ours), or within `20m`\u2026`72h` of our last message. With no earlier message from us it always passes."
            },
            "labels": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "include": {
                      "minItems": 1,
                      "maxItems": 1000,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "description": "Label ids or names. Sends if the contact carries any of them."
                    }
                  },
                  "required": [
                    "include"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "exclude": {
                      "minItems": 1,
                      "maxItems": 1000,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "description": "Label ids or names. Sends if the contact carries none of them."
                    }
                  },
                  "required": [
                    "exclude"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "Exactly one of `include` and `exclude`. A name is matched ignoring case and accents; an unknown label is `404 label_not_found`."
            }
          },
          "additionalProperties": false,
          "description": "Sends only if every condition holds when it fires; otherwise it ends `suppressed`. A text also needs the 24-hour window then, so a follow-up after the window should be a template."
        }
      },
      "required": [
        "type",
        "template",
        "send_at"
      ],
      "additionalProperties": false
    }
  },
  "examples": {
    "send_message": {
      "to": "+5491155550000",
      "from": "cm2v8a1b20002qz8h9i0j1k2l",
      "type": "template",
      "template": {
        "id": "cm2v8t1a00001qz8habcd1234",
        "variables": {
          "1": "Ana",
          "2": "#1042",
          "header_image": {
            "url": "https://acme.example/box.jpg"
          },
          "button_0": "1042"
        }
      }
    },
    "schedule_message": {
      "to": "+5491155550000",
      "from": "cm2v8a1b20002qz8h9i0j1k2l",
      "type": "template",
      "template": {
        "id": "cm2v8t1a00001qz8habcd1234",
        "variables": {
          "1": "Ana",
          "2": "#1042"
        }
      },
      "send_at": "2026-10-22T09:00:00-03:00",
      "time_zone": "America/Argentina/Buenos_Aires",
      "send_if": {
        "no_reply": "since_last_message"
      }
    }
  }
}
