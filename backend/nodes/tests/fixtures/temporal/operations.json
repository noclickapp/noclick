      "project_id": "project-123"
    },
    "method": "GET",
    "path": "/cloud/namespaces",
    "operation_id": "GetNamespaces"
  },
  "get_namespace": {
    "config": {
      "operation": "get_namespace",
      "namespace": "payments.a1b2c"
