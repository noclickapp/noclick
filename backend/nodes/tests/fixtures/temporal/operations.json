    "method": "GET",
    "path": "/cloud/namespaces/payments.a1b2c",
    "operation_id": "GetNamespace"
  },
  "create_namespace": {
    "config": {
      "operation": "create_namespace",
      "spec": {
        "name": "payments",
        "retentionDays": 7,
        "replicas": [
          {
            "region": "aws-us-west-2"
          }
        ]
      }
    },
    "method": "POST",
    "path": "/cloud/namespaces",
    "operation_id": "CreateNamespace"
  },
  "delete_namespace": {
    "config": {
      "operation": "delete_namespace",
      "namespace": "payments.a1b2c",
      "resource_version": "version-1"
    },
    "method": "DELETE",
    "path": "/cloud/namespaces/payments.a1b2c",
    "operation_id": "DeleteNamespace"
  },
  "list_users": {
    "config": {
      "operation": "list_users",
      "email": "person@example.com",
      "namespace": "payments.a1b2c"
    },
    "method": "GET",
    "path": "/cloud/users",
    "operation_id": "listUsers"
  },
  "get_user": {
    "config": {
      "operation": "get_user",
      "user_id": "user-123"
    },
    "method": "GET",
    "path": "/cloud/users/user-123",
    "operation_id": "GetUser"
  },
  "create_user": {
    "config": {
      "operation": "create_user",
      "spec": {
        "email": "person@example.com",
        "access": {
          "accountAccess": {
            "role": "ROLE_READ"
          }
        }
      }
    },
    "method": "POST",
    "path": "/cloud/users",
    "operation_id": "CreateUser"
  },
  "update_user": {
    "config": {
      "operation": "update_user",
      "user_id": "user-123",
      "resource_version": "version-1",
      "spec": {
        "email": "person@example.com",
        "access": {
          "accountAccess": {
            "role": "ROLE_READ"
          },
          "namespaceAccesses": {
            "payments.a1b2c": {
              "permission": "PERMISSION_READ"
            }
          }
        }
      }
    },
    "method": "POST",
    "path": "/cloud/users/user-123",
    "operation_id": "UpdateUser"
  },
  "delete_user": {
    "config": {
      "operation": "delete_user",
      "user_id": "user-123",
      "resource_version": "version-1"
    },
    "method": "DELETE",
    "path": "/cloud/users/user-123",
    "operation_id": "DeleteUser"
  },
