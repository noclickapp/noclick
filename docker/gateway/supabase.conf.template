# Rendered by the nginx image's envsubst into conf.d/default.conf; only
# NOCLICK_* variables are substituted (NGINX_ENVSUBST_FILTER), so nginx's
# own $variables below are left alone.
server {
    listen ${NOCLICK_SUPABASE_PORT};
    # Uploads go straight to object storage against a presigned URL, so
    # nothing large passes through here.
    client_max_body_size 8m;

    # The prefix is captured and re-appended explicitly: with a variable in
    # proxy_pass, nginx does not rewrite the location prefix for you.
    location ~ ^/auth/v1/(?<auth_path>.*)$ {
        set $auth_upstream auth;
        proxy_pass http://$auth_upstream:9999/$auth_path$is_args$args;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location ~ ^/rest/v1/(?<rest_path>.*)$ {
        set $rest_upstream rest;
        proxy_pass http://$rest_upstream:3000/$rest_path$is_args$args;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location / {
        add_header Content-Type application/json;
        return 404 '{"message":"not found"}';
    }
}
